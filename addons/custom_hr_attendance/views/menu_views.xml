<odoo>

    <record id="action_my_attendance" model="ir.actions.client">
        <field name="name">Check In / Check Out</field>
        <field name="tag">custom_hr_attendance.my_attendance_action</field>
    </record>

    <!-- Patch root app-icon so clicking "Attendances" in the home-screen
         always opens Check In / Check Out and NOT the kiosk redirect. -->
    <record id="hr_attendance.menu_hr_attendance_root" model="ir.ui.menu">
        <field name="action" ref="action_my_attendance"/>
    </record>

    <!-- ====================================================
         1. Check In / Check Out
         ==================================================== -->
    <menuitem id="menu_check_in_out"
              name="Check In / Check Out"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_my_attendance"
              sequence="1"/>

    <!-- ====================================================
         2. Kiosk Mode
         ==================================================== -->
    <menuitem
            id="hr_attendance.menu_action_open_form"
            name="Kiosk Mode"
            parent="hr_attendance.menu_hr_attendance_root"
            groups="hr_attendance.group_hr_attendance_user"
            sequence="2"/>

    <!-- ====================================================
         3. Predefined Attendance
         ==================================================== -->
    <menuitem id="menu_preapproval_root"
              name="Predefined Attendance"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="3"/>

    <menuitem id="menu_preapproval_my"
              name="My Requests"
              parent="menu_preapproval_root"
              action="action_preapproval_my"
              sequence="10"/>

    <menuitem id="menu_preapproval_approve"
            name="Approve Requests"
            parent="menu_preapproval_root"
            action="action_preapproval_approve"
            groups="hr_attendance.group_hr_attendance_user,hr_attendance.group_hr_attendance_manager,custom_hr_attendance.group_hr_attendance_job_position_user,custom_hr_attendance.group_hr_attendance_it_driver_user"
            sequence="15"/>

    <!-- ====================================================
         4. Attendance Dashboard
         ==================================================== -->
    <menuitem
            id="menu_bunna_attendance_dashboard"
            name="Attendance Dashboard"
            parent="hr_attendance.menu_hr_attendance_root"
            action="hr_attendance.hr_attendance_action"
            sequence="4"
            groups="hr_attendance.group_hr_attendance_officer"/>

    <!-- ====================================================
         5. Manager Menu
              └─ Attendances                             (hr_attendance list)
              └─ Employees                               (hr.employee list)
              └─ Generate Employee Attendance Report Wizard (wizard)
              └─ Employee Attendance Details             (attendance details view)
         ==================================================== -->
    <!-- ====================================================
         5. Manager Menu (Accessible by Managers only)
              └─ Attendances                             (hr_attendance list)
              └─ Employees                               (hr.employee list)
              └─ Generate Employee Attendance Report Wizard (wizard)
              └─ Daily Employee Attendance Detail        (daily attendance details view)
         ==================================================== -->
    <menuitem
            id="hr_attendance.menu_hr_attendance_view_attendances_management"
            name="Manager"
            parent="hr_attendance.menu_hr_attendance_root"
            groups="hr_attendance.group_hr_attendance_manager"
            sequence="5"/>

    <!-- 5.1 Attendances -->
    <menuitem
            id="menu_manager_attendances"
            name="Attendances"
            parent="hr_attendance.menu_hr_attendance_view_attendances_management"
            action="hr_attendance.hr_attendance_action"
            groups="hr_attendance.group_hr_attendance_manager"
            sequence="10"/>

    <!-- 5.2 Employees -->
    <menuitem
            id="menu_manager_employees"
            name="Employees"
            parent="hr_attendance.menu_hr_attendance_view_attendances_management"
            action="hr.open_view_employee_list_my"
            groups="hr_attendance.group_hr_attendance_manager"
            sequence="20"/>

    <!-- 5.3 Generate Employee Attendance Report Wizard -->
    <menuitem
            id="menu_manager_generate_attendance_report"
            name="Generate Employee Attendance Report Wizard"
            parent="hr_attendance.menu_hr_attendance_view_attendances_management"
            groups="hr_attendance.group_hr_attendance_manager"
            action="action_manager_daily_attendance_wizard"
            sequence="30"/>

    <!-- 5.4 Daily Employee Attendance Detail -->
    <menuitem
            id="menu_manager_attendance_details"
            name="Daily Employee Attendance Detail"
            action="generated_employee_attendance_details_action"
            parent="hr_attendance.menu_hr_attendance_view_attendances_management"
            groups="hr_attendance.group_hr_attendance_manager"
            sequence="40"/>

    <!-- ====================================================
         6. Reporting Menu
              └─ Report
              └─ Generate Detail Employee Attendance Report Wizard
              └─ Employee Attendance Summary
              └─ Acknowledged Attendance Report
              └─ Predefined Attendance Report
              └─ Job Position Exception Report
              └─ Over Time Report
         ==================================================== -->

    <!-- 6.1 Report -->
    <menuitem
            id="menu_reporting_report"
            name="Report"
            parent="hr_attendance.menu_hr_attendance_reporting"
            groups="hr_attendance.group_hr_attendance_user,hr_attendance.group_hr_attendance_manager"
            action="generated_employee_attendance_details_action"
            sequence="5"/>

    <!-- 6.2 Generate Detail Employee Attendance Report Wizard -->
    <menuitem
            id="menu_generate_detail_employee_attendance_report_wizard"
            name="Generate Detail Employee Attendance Report Wizard"
            parent="hr_attendance.menu_hr_attendance_reporting"
            groups="hr_attendance.group_hr_attendance_user,hr_attendance.group_hr_attendance_manager"
            action="action_generate_detail_employee_attendance_report_wizard"
            sequence="10"/>

    <!-- 6.3 Employee Attendance Summary -->
    <menuitem
            id="menu_generated_employee_attendance_details"
            name="Employee Attendance Summary"
            action="generated_employee_attendance_details_action"
            parent="hr_attendance.menu_hr_attendance_reporting"
            groups="hr_attendance.group_hr_attendance_user,hr_attendance.group_hr_attendance_manager"
            sequence="20"/>

    <!-- 6.4 Acknowledged Attendance Report -->
    <menuitem id="menu_acknowledged_attendance_report"
              name="Acknowledged Attendance Report"
              parent="hr_attendance.menu_hr_attendance_reporting"
              action="action_acknowledged_attendance_report"
              sequence="30"
              groups="hr_attendance.group_hr_attendance_user,hr_attendance.group_hr_attendance_manager"/>

    <!-- 6.5 Predefined Attendance Report -->
    <menuitem
            id="menu_attendance_preapproval_report"
            name="Predefined Attendance Report"
            parent="hr_attendance.menu_hr_attendance_reporting"
            action="action_attendance_preapproval_report"
            sequence="40"
            groups="hr_attendance.group_hr_attendance_user,hr_attendance.group_hr_attendance_manager"/>

    <!-- 6.6 Job Position Exception Report -->
    <menuitem
            id="menu_job_position_exception_report"
            name="Job Position Exception Report"
            parent="hr_attendance.menu_hr_attendance_reporting"
            action="action_job_position_exception_report"
            sequence="50"
            groups="hr_attendance.group_hr_attendance_user,hr_attendance.group_hr_attendance_manager"/>

    <!-- 6.8 Force Checkout History (ATT-021) -->
    <menuitem
            id="menu_force_checkout_history"
            name="Force Checkout History"
            parent="hr_attendance.menu_hr_attendance_reporting"
            action="action_hr_attendance_force_checkout_history"
            sequence="70"
            groups="hr_attendance.group_hr_attendance_user,hr_attendance.group_hr_attendance_manager"/>

    <!-- 5.5 Manual Attendance Entry Wizard (ATT-016) -->
    <menuitem
            id="menu_manual_attendance_wizard"
            name="Manual Attendance Entry"
            parent="hr_attendance.menu_hr_attendance_view_attendances_management"
            action="action_hr_attendance_manual_wizard"
            sequence="50"
            groups="hr_attendance.group_hr_attendance_user,hr_attendance.group_hr_attendance_manager"/>


    <!-- ====================================================
         7. Configuration
              └─ Settings
              └─ Reasons
              └─ Job Shift
              └─ Job Position Exception
              └─ Location Based Exception
              └─ Over Time
         ==================================================== -->
    <menuitem
            id="menu_bunna_attendance_configuration"
            name="Configuration"
            parent="hr_attendance.menu_hr_attendance_root"
            sequence="99"
            groups="hr_attendance.group_hr_attendance_manager,custom_hr_attendance.group_hr_attendance_job_position_user,custom_hr_attendance.group_hr_attendance_it_driver_user"/>

    <menuitem
            id="menu_bunna_attendance_settings"
            name="Settings"
            parent="menu_bunna_attendance_configuration"
            action="action_hr_attendance_configuration"
            sequence="5"
            groups="hr_attendance.group_hr_attendance_manager"/>

    <menuitem
            id="hr_attendance_reason_menu"
            name="Reasons"
            parent="menu_bunna_attendance_configuration"
            action="hr_attendance_reason_action"
            groups="hr_attendance.group_hr_attendance_manager"
            sequence="10"/>

    <menuitem id="menu_job_shift"
            name="Job Shift"
            parent="menu_bunna_attendance_configuration"
            action="action_job_shift"
            sequence="15"
            groups="custom_hr_attendance.group_hr_attendance_job_position_user,hr_attendance.group_hr_attendance_manager"/>

    <menuitem id="menu_job_position_exception"
            name="Job Position Exception"
            parent="menu_bunna_attendance_configuration"
            action="action_job_position_exception"
            sequence="20"
            groups="custom_hr_attendance.group_hr_attendance_job_position_user,hr_attendance.group_hr_attendance_manager"/>

    <menuitem id="menu_location_based_exception"
            name="Location Based Exception"
            parent="menu_bunna_attendance_configuration"
            action="action_location_based_exception"
            sequence="25"
            groups="hr_attendance.group_hr_attendance_manager"/>

    <menuitem id="menu_over_time"
            name="Over Time"
            parent="menu_bunna_attendance_configuration"
            action="action_over_time"
            sequence="30"
            groups="custom_hr_attendance.group_hr_attendance_it_driver_user,hr_attendance.group_hr_attendance_manager"/>

</odoo>

