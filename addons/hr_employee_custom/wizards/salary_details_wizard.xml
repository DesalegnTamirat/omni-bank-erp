<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="populate_salary_information_form" model="ir.ui.view">
        <field name="name">Populate Salary Information Wizard</field>
        <field name="model">populate.salary.details</field>
        <field name="arch" type="xml">
            <form string="Salary Rules">

<!--                    <group>-->
<!--                        <field name="job_grade"/>-->
<!--                    </group>-->


                <footer>
                    <button name="populate" string="Populate" type="object" class="btn btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_salary_details_wizard" model="ir.actions.act_window">
        <field name="name">Populate Salary Information Wizard</field>
        <field name="res_model">populate.salary.details</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="populate_salary_information_form"/>
        <field name="target">new</field>
    </record>


