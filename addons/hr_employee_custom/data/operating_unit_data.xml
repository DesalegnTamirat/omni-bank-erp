<?xml version="1.0" encoding="utf-8" ?>
<!--
    Merged from the standalone 'operating_unit' module (OCA/operating-unit).
    sol_id and work_unit_type are added here because hr_employee_custom's
    hr_operating_unit.py makes both fields required on operating.unit.
    old_code / partner_id were dropped because they no longer exist on the
    model (partner_id is commented out in operating_unit.py). district,
    region and department are required by the current model.
-->
<odoo noupdate="1">
    <!-- Seed department required by operating.unit.department -->
    <record id="head_office_department" model="hr.department">
        <field name="name">Head Office</field>
    </record>

    <!-- Basic Operating Unit  -->
    <record id="main_operating_unit" model="operating.unit">
        <field name="name">Main Operating Unit</field>
        <field name="sol_id">1</field>
        <field name="work_unit_type">head_office</field>
        <field name="district">Addis Ababa</field>
        <field name="region">Addis Ababa</field>
        <field name="department" ref="head_office_department" />
    </record>
    <record model="res.users" id="base.user_root">
        <field name="default_operating_unit_id" ref="main_operating_unit" />
        <field name="operating_unit_ids" eval="[(4, ref('main_operating_unit'))]" />
    </record>
    <record model="res.users" id="base.user_admin">
        <field name="default_operating_unit_id" ref="main_operating_unit" />
        <field name="operating_unit_ids" eval="[(4, ref('main_operating_unit'))]" />
    </record>
</odoo>
