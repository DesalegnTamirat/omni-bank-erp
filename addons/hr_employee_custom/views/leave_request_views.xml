<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         leave.request  (employee-side leave request)
         ============================================================ -->
    <record id="leave_request_tree" model="ir.ui.view">
        <field name="name">Leave Request List</field>
        <field name="model">leave.request</field>
        <field name="arch" type="xml">
            <list string="Leave Requests">
                <field name="reference"/>
                <field name="requester_name"/>
                <field name="leave_reason"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="no_of_days"/>
                <field name="computed_leave"/>
                <field name="accrued"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="leave_request_form" model="ir.ui.view">
        <field name="name">Leave Request Form</field>
        <field name="model">leave.request</field>
        <field name="arch" type="xml">
            <form string="Leave Request">
                <header>
                    <button name="action_fetch_overtime" type="object" string="Fetch" class="btn-primary"/>
                    <button name="n_compute_leave" type="object" string="Compute Leave"/>
                    <button name="notification" type="object" string="Notify Manager" class="btn-primary"/>
                    <button name="check_leave_balance" type="object" string="Check Balance"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="requester_name"/>
                            <field name="delegated_name"/>
                            <field name="leave_reason"/>
                        </group>
                        <group>
                            <field name="job_grade"/>
                            <field name="job_category"/>
                            <field name="job_position"/>
                            <field name="operating_unit"/>
                            <field name="gender"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details">
                            <group>
                                <group>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="half_day"/>
                                    <field name="details"/>
                                </group>
                                <group>
                                    <field name="no_of_days" readonly="1"/>
                                    <field name="computed_leave" readonly="1"/>
                                    <field name="accrued" readonly="1"/>
                                    <field name="status" readonly="1"/>
                                </group>
                            </group>
                            <group string="Leave Balance">
                                <group>
                                    <field name="comments"/>
                                    <field name="leave_attachment_ids" widget="many2many_binary"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_leave_request" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="res_model">leave.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_leave_request"
              name="Leave Requests"
              parent="hr.menu_hr_root"
              action="action_leave_request"
              sequence="60"
              groups="base.group_user,hr.group_hr_user,hr.group_hr_manager"/>

    <!-- ============================================================
         leave.request.manager  (manager-side approval)
         ============================================================ -->
    <record id="leave_request_manager_tree" model="ir.ui.view">
        <field name="name">Leave Request Approval List</field>
        <field name="model">leave.request.manager</field>
        <field name="arch" type="xml">
            <list string="Leave Request Approvals">
                <field name="reference"/>
                <field name="requester_name"/>
                <field name="leave_reason"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="computed_leave"/>
                <field name="apr_state"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="leave_request_manager_form" model="ir.ui.view">
        <field name="name">Leave Request Approval Form</field>
        <field name="model">leave.request.manager</field>
        <field name="arch" type="xml">
            <form string="Leave Request Approval">
                <header>
                    <button name="notify" type="object" string="Notify Approvers" class="btn-primary"/>
                    <button name="approve" type="object" string="Approve"/>
                    <button name="confirm_leave" type="object" string="Confirm Leave" class="btn-primary"/>
                    <button name="reject" type="object" string="Reject" class="btn-danger"/>
                    <field name="apr_state" widget="statusbar" statusbar_visible="draft,notify,approve"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="requester_name" readonly="1"/>
                            <field name="delegated_name"/>
                            <field name="leave_reason" readonly="1"/>
                        </group>
                        <group>
                            <field name="job_grade" readonly="1"/>
                            <field name="job_category" readonly="1"/>
                            <field name="job_position" readonly="1"/>
                            <field name="operating_unit" readonly="1"/>
                            <field name="gender" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details">
                            <group>
                                <group>
                                    <field name="start_date" readonly="1"/>
                                    <field name="end_date" readonly="1"/>
                                    <field name="half_day" readonly="1"/>
                                    <field name="details"/>
                                </group>
                                <group>
                                    <field name="no_of_days" readonly="1"/>
                                    <field name="computed_leave" readonly="1"/>
                                    <field name="accrued" readonly="1"/>
                                    <field name="state" readonly="1"/>
                                </group>
                            </group>
                            <group string="Approval">
                                <group>
                                    <field name="req_appr_id"/>
                                    <field name="manager_user_id"/>
                                </group>
                                <group>
                                    <field name="comments" readonly="1"/>
                                    <field name="leave_mngr_attachment_ids" widget="many2many_binary"/>
                                </group>
                            </group>
                        </page>
                        <page string="Approval Team">
                            <field name="leave_req_manager_aprvl_id">
                                <list editable="bottom">
                                    <field name="employee_name"/>
                                    <field name="operating_unit"/>
                                    <field name="approve"/>
                                </list>
                            </field>
                        </page>
                        <page string="Leave Types">
                            <field name="LeaveTypes_details">
                                <list editable="bottom">
                                    <field name="leave_type"/>
                                    <field name="number_of_days"/>
                                    <field name="balance_days"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_leave_request_manager" model="ir.actions.act_window">
        <field name="name">Leave Request Approvals</field>
        <field name="res_model">leave.request.manager</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_leave_request_manager"
              name="Leave Request Approvals"
              parent="hr.menu_hr_root"
              action="action_leave_request_manager"
              sequence="61"
              groups="hr.group_hr_user,hr.group_hr_manager"/>

</odoo>
