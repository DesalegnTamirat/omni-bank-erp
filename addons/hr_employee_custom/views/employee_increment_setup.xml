<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="action_employee_increment_setup" model="ir.actions.act_window">
        <field name="name">Employee Increment Setup</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.increment.setup</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">create here</p>
        </field>
    </record>
    <record id="employee_increment_setup_tree" model="ir.ui.view">
        <field name="name">employee.increment.setup.tree</field>
        <field name="model">employee.increment.setup</field>
        <field name="arch" type="xml">
            <list string="Employee Increment Setup" editable="bottom">
                <!-- ACCOUNTING FISCAL YEAR MODULE NOT INSTALLED: <field name="fiscal_year"/> -->
                <field name="work_unit"/>
				<field name="pms_score_from"/>
				<field name="pms_score_to"/>
                <!--<field name="pms_ranking"/>-->
                <field name="increment_factor"/>
				<field name="disciplinary_measure"/>
				<field name="breach_count"/>
				<field name="penalty_factor"/>
				<field name="state"/>
            </list>
        </field>
    </record>



</odoo>