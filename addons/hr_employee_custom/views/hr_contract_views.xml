<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================
         ACTION: Menu → Contracts (no employee pre-filter)
    ====================================================== -->
    <record id="action_hr_contract_menu" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">hr.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first contract
            </p>
        </field>
    </record>

    <!-- ======================================================
         ACTION: Employee smart button (pre-filtered by employee)
    ====================================================== -->
    <record id="act_hr_employee_2_hr_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">hr.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'search_default_employee_id': active_id,
            'default_employee_id': active_id,
            'search_default_group_by_state': 1
        }</field>
    </record>

    <!-- ======================================================
         KANBAN VIEW
    ====================================================== -->

    <record id="hr_contract_view_kanban" model="ir.ui.view">
        <field name="name">hr.contract.kanban</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="state"/>
                <field name="kanban_state"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="wage"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div t-if="record.employee_id.value">
                                    <i class="fa fa-user me-1"/>
                                    <t t-esc="record.employee_id.value"/>
                                </div>
                                <div t-if="record.job_id.value">
                                    <i class="fa fa-briefcase me-1"/>
                                    <t t-esc="record.job_id.value"/>
                                </div>
                                <div t-if="record.department_id.value">
                                    <i class="fa fa-sitemap me-1"/>
                                    <t t-esc="record.department_id.value"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <img t-att-src="'/web/image/hr.employee/' + record.employee_id.raw_value + '/image_128'"
                                         t-if="record.employee_id.raw_value"
                                         t-att-alt="record.employee_id.value"
                                         class="oe_kanban_avatar o_image_24_cover"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================================================
         Bind our Kanban view explicitly to both actions so Odoo
         doesn't ambiguously fall back to another module's
         hr.contract Kanban view (e.g. hr_contract.hr_contract_view_kanban)
         NOTE: these must come AFTER hr_contract_view_kanban is defined above.
    ====================================================== -->
    <record id="action_hr_contract_menu_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="hr_contract_view_kanban"/>
        <field name="act_window_id" ref="action_hr_contract_menu"/>
    </record>

    <record id="act_hr_employee_2_hr_contract_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="hr_contract_view_kanban"/>
        <field name="act_window_id" ref="act_hr_employee_2_hr_contract"/>
    </record>

    <!-- ======================================================
         LIST VIEW
    ====================================================== -->
    <record id="hr_contract_view_list" model="ir.ui.view">
        <field name="name">hr.contract.list</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <list string="Employee Contracts"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'open' or state == 'probation'"
                  decoration-muted="state in ('close','cancel')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="operating_unit_id" optional="show"/>
                <field name="date_start"/>
                <field name="date_end" optional="show"/>
                <field name="wage"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'probation'"
                       decoration-success="state == 'open'"
                       decoration-danger="state == 'close'"
                       decoration-muted="state == 'cancel'"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ======================================================
         SEARCH VIEW
    ====================================================== -->
    <record id="hr_contract_view_search" model="ir.ui.view">
        <field name="name">hr.contract.search</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <search string="Search Contracts">

                <field name="name"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="operating_unit_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="resource_calendar_id"/>

                <filter string="New"       name="new"       domain="[('state','=','draft')]"/>
                <filter string="Probation" name="probation" domain="[('state','=','probation')]"/>
                <filter string="Running"   name="running"   domain="[('state','=','open')]"/>
                <filter string="Expired"   name="expired"   domain="[('state','=','close')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancel')]"/>
                <separator/>
                <filter string="Employed"
                        name="current_employee"
                        domain="[('employee_id.active','=',True)]"/>
                <filter string="Archived"
                        name="inactive"
                        domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Late Activities"
                        name="activities_overdue"
                        domain="[('activity_date_deadline','&lt;', context_today())]"/>
                <filter string="Today Activities"
                        name="activities_today"
                        domain="[('activity_date_deadline','=', context_today())]"/>
                <filter string="Future Activities"
                        name="activities_upcoming"
                        domain="[('activity_date_deadline','&gt;', context_today())]"/>

                <group>
                    <filter string="Status"
                            name="group_by_state"
                            context="{'group_by':'state'}"/>
                    <filter string="Employee"
                            name="group_employee"
                            context="{'group_by':'employee_id'}"/>
                    <filter string="Department"
                            name="group_department"
                            context="{'group_by':'department_id'}"/>
                    <filter string="Job Position"
                            name="group_job"
                            context="{'group_by':'job_id'}"/>
                    <filter string="Operating Unit"
                            name="group_operating_unit"
                            context="{'group_by':'operating_unit_id'}"/>
                    <filter string="Employee Category"
                            name="group_category"
                            context="{'group_by':'employee_category'}"/>
                </group>

            </search>
        </field>
    </record>

    <!-- ======================================================
         FORM VIEW — Odoo 14 two-column flat layout
    ====================================================== -->
    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.contract.form</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">

            <form string="Employee Contract">

                <header>
                    <button string="Start Probation"
                            name="action_start_probation"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Approve"
                            name="action_start_running"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'probation'"/>
                    <button string="Expire"
                            name="action_expire"
                            type="object"
                            invisible="state != 'open'"/>
                    <button string="Cancel"
                            name="action_cancel"
                            type="object"
                            invisible="state in ('cancel', 'close')"
                            confirm="Are you sure you want to cancel this contract?"/>
                    <button string="Reset to New"
                            name="action_reset_to_new"
                            type="object"
                            invisible="state not in ('cancel', 'close')"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,probation,open,close,cancel"/>
                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box"/>

                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="bg-danger"
                            invisible="active"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <!-- LEFT COLUMN -->
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="company_country_id" invisible="1"/>
                            <field name="employee_id"/>
                            <field name="job_category"/>
                            <field name="grade_id" readonly="1" invisible="not employee_id"/>
                            <field name="department_id"/>
                            <field name="probation_period"/>
                            <field name="probation_start_date"/>
                            <field name="probation_end_date"/>
                            <field name="job_description"/>
                            <field name="job_id"/>
                            <field name="employee_category"/>
                            <field name="type_id" string="Salary Structure"/>
                            <field name="operating_unit_id"/>
                            <field name="structure_type_id" string="Salary Structure Type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>

                        <!-- RIGHT COLUMN -->
                        <group>
                            <field name="date_start"/>
                            <field name="first_contract_date"/>
                            <field name="date_end"/>
                            <field name="notice_period"/>
                            <field name="resource_calendar_id"/>
                            <field name="hr_responsible_id"/>
                            <field name="employee_tin"/>
                            <field name="salary_account"/>
                            <field name="od_account"/>
                            <field name="pf_account"/>
                            <field name="asbeza_account"/>
                            <field name="indemnity_account"/>
                            <field name="indemnity_account_balance"/>
                            <field name="pf_contribution_balance"/>
                            <field name="cost_sharing_balance"/>
                            <field name="member_of_labour_union"/>
                            <field name="company_car_provided"/>
                            <field name="cash_indemnity_applicable"/>
                            <field name="wrapping_applicable"/>
                            <field name="pms_score"/>
                            <field name="pms_rank"/>
                            <field name="penalty_amount"/>
                            <field name="allowance_amount"/>
                        </group>
                    </group>

                    <!-- Accounting / Salary section -->
                    <group string="Accounting">
                        <group>
                            <field name="wage_type"/>
                            <field name="wage"/>
                            <field name="base_salary"/>
                            <field name="factor"/>
                        </group>
                        <group>
                            <field name="cost_sharing"/>
                            <field name="od_deduction"/>
                            <field name="asbeza_deduction"/>
                            <field name="labour_union_contribution"/>
                            <field name="housing_allowance"/>
                            <field name="transportation_allowance"/>
                            <field name="fuel_allowance"/>
                            <field name="other_allowance"/>
                            <field name="other_deductions"/>
                            <field name="other_advances"/>
                        </group>
                    </group>

                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>

    <!-- ======================================================
         MENU: Contracts under the "Employees" nav item

         The core hr_contract module is NOT installed/depended on
         (this module ships its own standalone hr.contract model),
         so we create a plain local menuitem under the native
         "Employees" payroll menu (hr.menu_hr_employee_payroll,
         from the 'hr' module) pointing at our own action.
    ====================================================== -->
    <menuitem id="menu_hr_employee_custom_contracts"
              name="Contracts"
              parent="hr.menu_hr_employee_payroll"
              action="action_hr_contract_menu"
              sequence="10"/>

    <!-- ======================================================
         MENU: Organizational Chart under the "Employees" nav item
    ====================================================== -->
    <menuitem
        id="menu_hr_org_chart_custom"
        name="Organizational Chart"
        parent="hr.menu_hr_employee_payroll"
        action="hr_org_chart.action_hr_employee_org_chart"
        sequence="11"/>

</odoo>
