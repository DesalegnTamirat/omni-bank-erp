<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>

        <record id="view_hr_training_history_list" model="ir.ui.view">
            <field name="name">hr.training.history.list</field>
            <field name="model">hr.training.history</field>
            <field name="arch" type="xml">
                <list string="Training History">
                    <field name="training_name"/>
                    <field name="training_type"/>
                    <field name="institution_name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="status"/>
                    <field name="comments"/>
                </list>
            </field>
        </record>

        <record id="view_hr_training_history_form" model="ir.ui.view">
            <field name="name">hr.training.history.form</field>
            <field name="model">hr.training.history</field>
            <field name="arch" type="xml">
                <form string="Training History">
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="training_name"/>
                            <field name="training_type"/>
                            <field name="institution_name"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="status"/>
                            <field name="comments"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_hr_training_history" model="ir.actions.act_window">
            <field name="name">Training History</field>
            <field name="res_model">hr.training.history</field>
            <field name="view_mode">list,form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>