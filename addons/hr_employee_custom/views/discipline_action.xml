    <record id="action_discipline" model="ir.actions.act_window">
        <field name="name">Disciplinary Action</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">discipline.action</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Bid Here!</p>
        </field>
    </record>

    <record id="discipline_tree_view" model="ir.ui.view">
        <field name="name">discipline.action.tree</field>
        <field name="model">discipline.action</field>
        <field name="arch" type="xml">
            <list string="Disciplinary Actions">
                <field name="employee_name" width="20%"/>
<!--                <field name="operating_unit"/>-->
<!--                <field name="position"/>-->
                <field name="breach" width="20%"/>
<!--                <field name="breach_reference"/>-->
<!--                <field name="description"/>-->
                <field name="breach_date" width="20%"/>
                <field name="breach_count" width="20%"/>
<!--                <field name="disciplinary_measure"/>-->
<!--                <field name="start_date"/>-->
<!--                <field name="end_date"/>-->
<!--                <field name="appeal_with_in"/>-->
                <field name="status" width="20%"/>
            </list>
        </field>
    </record>

    <record id="discipline_form_view" model="ir.ui.view">
        <field name="name">discipline.action.form</field>
        <field name="model">discipline.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="notify" string="Notify" invisible="state in 'notify'" type="object" class="oe_highlight"/>
                    <button name="fetch_data" string="Fetch Data" type="object" class="oe_highlight"/>
                </header>
                <sheet>
				    <div class="oe_title">
                        <h1>
                            <field name="reference" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_name"/>
                            <field name="operating_unit"/>
                            <field name="position"/>
                            <field name="wage"/>
                        </group>
                        <group>
                            <field name="breach" domain="[('category_type', '=', 'disciplinary')]"/>
                            <field name="breach_reference"/>
                            <field name="description"/>
                            <field name="breach_date"/>
                            <field name="penalty_effective_date"/>
                        </group>
                        <group>
                            <field name="breach_count"/>
                            <field name="disciplinary_measure"/>
                            <field name="salary_impact"/>
							<field name="salary_impact_percentage"/>
                            <field name="additional_fine"/>
                            <field name="fine_imposed"/>
                            <field name="additional_comments"/>
                            <field name="additional_penalty"/>


                        </group>
                        <group>
                            <!-- <field name="start_date"/> -->
                            <!-- <field name="end_date"/> -->
                            <field name="appeal_with_in"/>
                            <field name="status"/>
                        </group>

                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

</odoo>