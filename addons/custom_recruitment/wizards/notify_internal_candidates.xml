<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="notify_internal_candidates_form" model="ir.ui.view">
        <field name="name">Notify Internal Candidates Wizard</field>
        <field name="model">notify.internal.candidates</field>
        <field name="arch" type="xml">
            <form string="Notify Internal Candidates">

                    <group>
                        <field name="hr_job"/>
<!--                        <field name="fuel_rate"/>-->
                    </group>


                <footer>
                    <button name="notify_internal_candidates" string="Notify Internal Candidates" type="object" class="btn btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_notify_internal_candidates_wizard" model="ir.actions.act_window">
        <field name="name">Notify Internal Candidates Wizard</field>
        <field name="res_model">notify.internal.candidates</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="notify_internal_candidates_form"/>
        <field name="target">new</field>
    </record>

