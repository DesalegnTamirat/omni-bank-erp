<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Standalone list view -->
        <record id="view_employee_education_list" model="ir.ui.view">
            <field name="name">employee.education.list</field>
            <field name="model">employee.education</field>
            <field name="arch" type="xml">
                <list string="Employee Education">
                    <field name="employee_id"/>
                    <field name="edu_type"/>
                    <field name="qualification"/>
                    <field name="school_name"/>
                    <field name="from_date"/>
                    <field name="to_date"/>
                    <field name="grade"/>
                    <field name="CGPA"/>
                    <field name="active" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Standalone form view -->
        <record id="view_employee_education_form" model="ir.ui.view">
            <field name="name">employee.education.form</field>
            <field name="model">employee.education</field>
            <field name="arch" type="xml">
                <form string="Employee Education">
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="illiterate"/>
                                <field name="edu_type" invisible="illiterate"/>
                                <field name="qualification" invisible="illiterate"/>
                                <field name="field" invisible="illiterate"/>
                                <field name="school_name" invisible="illiterate"/>
                            </group>
                            <group>
                                <field name="from_date" invisible="illiterate"/>
                                <field name="to_date" invisible="illiterate"/>
                                <field name="grade" invisible="illiterate"/>
                                <field name="CGPA" invisible="illiterate"/>
                                <field name="education_rank"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group string="Location">
                            <group>
                                <field name="country_id"/>
                                <field name="state_id"/>
                            </group>
                            <group>
                                <field name="province"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Action + menu -->
        <record id="action_employee_education" model="ir.actions.act_window">
            <field name="name">Employee Education</field>
            <field name="res_model">employee.education</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_employee_education"
                  name="Education"
                  parent="hr.menu_human_resources_configuration"
                  action="action_employee_education"
                  sequence="50"/>

        <!-- Embed as a tab on the Employee form -->
        <record id="view_hr_employee_form_education_inherit" model="ir.ui.view">
            <field name="name">hr.employee.form.education.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Education" name="education">
                        <field name="education_ids">
                            <list editable="bottom">
                                <field name="illiterate"/>
                                <field name="edu_type" column_invisible="parent.illiterate"/>
                                <field name="qualification"/>
                                <field name="field"/>
                                <field name="school_name"/>
                                <field name="from_date"/>
                                <field name="to_date"/>
                                <field name="grade"/>
                                <field name="CGPA"/>
                                <field name="country_id"/>
                                <field name="state_id"/>
                                <field name="province"/>
                                <field name="education_rank"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>