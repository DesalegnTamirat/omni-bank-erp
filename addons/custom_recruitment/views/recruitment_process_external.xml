<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="action_employee_recruitment_external" model="ir.actions.act_window">
        <field name="name">External Recruitment Process</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.recruitment.external</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create!!</p>
        </field>
    </record>

    <record id="employee_recruitment_external_tree_view" model="ir.ui.view">
        <field name="name">employee.recruitment.external.tree</field>
        <field name="model">employee.recruitment.external</field>
        <field name="arch" type="xml">
            <list string="External Recruitment">
                <field name="vacancy_reference"/>
                <field name="recruitment_reference"/>
                <field name="job_position"/>
                <field name="job_location"/>
                <field name="vacancy_announced_on"/>
                <field name="no_of_vacancies"/>
            </list>
        </field>
    </record>

    <record id="employee_recruitment_external_form_view" model="ir.ui.view">
        <field name="name">employee.recruitment.external.form</field>
        <field name="model">employee.recruitment.external</field>
        <field name="arch" type="xml">
            <form string="External Recruitment">
                <header>
                    <field name="status" widget="statusbar"/>
<!--                    <button name="populate_criteria" string="Populate Criteria" type="object" class="oe_highlight"/>-->
                    <button name="notify" invisible="status in ['notify']" string="Notify Applicant" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vacancy_reference"/>
                            <field name="recruitment_reference"/>
                             <field name="vacancy_announced_on"/>
                            <field name="no_of_vacancies"/>
                            <field name="last_date_to_apply"/>
                            <field name="job_position"/>
                        </group>
                        <group>

                            <field name="job_location"/>
                            <field name="relevant_experience"/>
                            <field name="job_grade"/>
                            <field name="job_category"/>
                            <field name="highest_cgpa"/>
                            <field name="responsible"/>

                        </group>
                    </group>
                    <notebook>
                        <page string="Eligible Applicants">
                            <field name="eligible_emp_external">
                                <list string="Eligible Applicants" editable="bottom">
                                    <field name="applicant_name"/>
                                    <field name="select_flag"/>
                                    <field name="applicant_email"/>
                                    <field name="applicant_phone"/>
                                    <field name="date_of_birth"/>
                                    <field name="applicant_age"/>
                                    <field name="gender"/>
                                    <field name="working_status"/>
                                    <field name="current_company"/>
                                    <field name="join_immediately"/>
                                    <field name="date_of_availability"/>
                                    <field name="preferred_location"/>
									<field name="highest_cgpa"/>
                                    <field name="relevant_experience"/>
                                    <field name="supervisory_experience"/>
                                    <field name="banking_experience"/>
                                    <field name="non_banking_experience"/>
									<field name="total_experience"/>
                                    <field name="ex_bunna"/>
<!--                                    <field name="preferred_location"/>-->

                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
</odoo>