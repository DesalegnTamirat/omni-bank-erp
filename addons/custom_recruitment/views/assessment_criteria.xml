<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="assessment_criteria_form" model="ir.ui.view">
        <field name="name">assessment.criteria.form</field>
        <field name="model">assessment.criteria</field>
        <field name="arch" type="xml">
            <form string="Assessment Criteria">
                <group colspan="1">
                    <group>
                        <field name="assessment_criteria"/>
						<field name="weightage"/>
                    </group>
                    <group>
                        <field name="status"/>
                    </group>
                </group>
            </form>
        </field>
    </record>
    <record id="assessment_criteria_tree" model="ir.ui.view">
        <field name="name">assessment.criteria.tree</field>
        <field name="model">assessment.criteria</field>
        <field name="arch" type="xml">
            <list string="Assessment Criteria">
                <field name="assessment_criteria"/>
				<field name="weightage"/>
                <field name="status"/>
            </list>
        </field>
    </record>
        <record id="assessment_criteria_tree_form" model="ir.actions.act_window">
        <field name="name">Assessment Criteria</field>
        <field name="res_model">assessment.criteria</field>
        <field name="context">{}</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>