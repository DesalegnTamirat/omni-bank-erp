<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- *****************************new external recruitmnt selected candidates form(it is one of notebook) -->
	<record id="action_external_recruitment_selected_candidats" model="ir.actions.act_window">
        <field name="name">External Recruitment Selected Candidates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">external.recruitment.selected.candidates</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create!!</p>
        </field>
    </record>

    <record id="exter_recruit_select_tree_view" model="ir.ui.view">
        <field name="name">external.recruitment.selected.candidates.tree</field>
        <field name="model">external.recruitment.selected.candidates</field>
        <field name="arch" type="xml">
            <list string="External Recruitment Selected Candidates" editable="bottom">
				                    <field name="applicant_name"/>
                                    <field name="select_flag"/>
									<field name="applicant_email"/>
									<field name="preferred_location"/>
                                    <field name="written_exam_score"/>
                                    <field name="interview_score"/>
                                    <field name="weighted_score"/>
                                    <field name="selection_type"/>
                                    
                                    <field name="remarks"/>
            </list>
        </field>
    </record>
<!-- ************************************************************************************************************************ -->

    <record id="action_external_recruitment_selected" model="ir.actions.act_window">
        <field name="name">External Recruitment Process Selected</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">external.recruitment.selected</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create!!</p>
        </field>
    </record>

    <record id="external_recruitment_selected_tree_view" model="ir.ui.view">
        <field name="name">external.recruitment.selected.tree</field>
        <field name="model">external.recruitment.selected</field>
        <field name="arch" type="xml">
            <list string="External Recruitment Selected Candidates">
				<field name="vacancy_reference"/>
                <field name="job_position"/>
                <field name="vacancy_announced_on"/>
                <field name="no_of_vacancies"/>
            </list>
        </field>
    </record>

    <record id="external_recruitment_selected_form_view" model="ir.ui.view">
        <field name="name">external.recruitment.selected.form</field>
        <field name="model">external.recruitment.selected</field>
        <field name="arch" type="xml">
            <form string="External Recruitment Selected candidates">
                <header>
                    <field name="state" widget="statusbar"/>
					<button name="notify_approver" invisible="state in 'evaluate'" string="Notify Approver" type="object" class="oe_highlight"/>
                    <button name="evaluate" invisible="state in 'notify_approver'" string="Approve Selection" type="object" class="oe_highlight"/>
                    <button name="notify_approver" invisible="state in ('notify_approver', 'evaluate')" string="Notify Approver" type="object" class="oe_highlight"/>
                    <button name="evaluate" invisible="state in 'evaluate'" string="Evaluate" type="object" class="oe_highlight"/>
                    <button name="notify_written_exam" string="Notify Written Exam" type="object" class="oe_highlight"/>
                    <button name="fetch_exam_score" string="Fetch Exam Score" type="object" class="oe_highlight"/>
                    <button name="notify_interview_panel" string="Notify Interview Panel" type="object" class="oe_highlight"/>
                    <button name="notify_interview" string="Notify Interview" type="object" class="oe_highlight"/>
                    <button name="fetch_interview_score" string="Fetch Interview Score" type="object" class="oe_highlight"/>
                    <button name="compute_weighted_score" string="Compute Score" type="object" class="oe_highlight"/>
                    <button name="notify_selection" string="Notify Selection" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vacancy_reference"/>
							<!-- <field name="vacancy_announced_on"/> -->
							<!-- <field name="no_of_vacancies"/> -->
                            <field name="recruitment_reference"/>
                            <field name="written_exam_date"/>
                            <field name="exam_location"/>
                            <field name="exam_scheduled"/>
							<!-- <field name="state"/> -->
                        </group>
                        <group>
                            <field name="job_position"/>
							<!-- <field name="job_location"/> -->
                            <field name="interview_date" widget="datetime"/>
                             <field name="interview_location"/>
                            <field name="interview_scheduled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Eligible Applicants">
                            <field name="ext_rec_sel">
                                <list string="Eligible Applicants" editable="bottom">
                                    <field name="applicant_name"/>
                                    <field name="select_flag"/>
									<field name="applicant_email"/>
									<field name="preferred_location"/>
                                    <field name="written_exam_score"/>
                                    <field name="interview_score"/>
                                    <field name="weighted_score"/>
                                    <field name="selection_type"/>
                                    
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Panel Members">
                            <field name="ext_rec_panel">
                                <list string="Panel Members" editable="bottom">
                                    <field name="emp_name"/>
<!--                                    <field name="emp_position"/>-->
                                    <field name="selection_criteria"/>
                                    <field name="accepted"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <notebook>
                        <page string="Approval Members">
                            <field name="recr_exter_selected_team_id">
                                <list string="Approval Members" editable="bottom">
                                        <field name="role" width="20%"/>
                                        <field name="employee_name" width="20%"/>
                                        <field name="operating_unit" width="20%"/>
                                        <field name="status" width="20%"/>
                                        <field name="alternate_committee_member" width="20%"/>
                                        <field name="alter_operating_unit" width="20%"/>
                                        <field name="approve" width="20%"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
</odoo>