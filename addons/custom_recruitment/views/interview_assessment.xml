<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="interview_assessment_form" model="ir.ui.view">
        <field name="name">interview.assessment.form</field>
        <field name="model">interview.assessment</field>
        <field name="arch" type="xml">
            <form string="Interview Assessment">
                <group colspan="2">
                    <group>
                        <field name="recruiting_position" readonly="1"/>
                        <field name="assessor_name" readonly="1"/>
                        <field name="assessment_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="applicant_name" readonly="1"/>
                        <field name="recruitment_type" readonly="1"/>
                    </group>
                    <group>
                        <field name="assessment_criteria" readonly="1"/>
                        <field name="weightage" readonly="1"/>
                    </group>
                    <group>
                        <field name="marks_awarded"/>
                    </group>
                </group>
            </form>
        </field>
    </record>
    <record id="interview_assessment_tree" model="ir.ui.view">
        <field name="name">interview.assessment.tree</field>
        <field name="model">interview.assessment</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="1" delete="1" multi_edit="1" string="Interview Assessment">
                <field name="vacancy_reference" readonly="1"/>
                <field name="recruiting_position" readonly="1"/>
                <field name="assessor_name" readonly="1"/>
                <field name="assessment_date" readonly="1"/>
                <field name="applicant_name" readonly="1"/>
                <field name="recruitment_type" readonly="1"/>
                <field name="assessment_criteria" readonly="1"/>
				<field name="weightage" readonly="1"/>
                <field name="candidate_attendance"/>
                <field name="marks_awarded"/>
            </list>
        </field>
	</record>
	<record id="interview_assessment_search" model="ir.ui.view">
        <field name="name">interview.assessment.view.search</field>
        <field name="model">interview.assessment</field>
        <field name="arch" type="xml">
            <search string="Search Source">
                <field name="vacancy_reference"/>
                <field name="applicant_name"/>
           </search>
        </field>
	</record>
    <record id="interview_assessment_tree_form" model="ir.actions.act_window">
        <field name="name">Interview Assessment</field>
        <field name="res_model">interview.assessment</field>
        <field name="context">{}</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>