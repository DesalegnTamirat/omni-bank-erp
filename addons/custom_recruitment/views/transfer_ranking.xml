<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="transfer_committee_minutes_list_view" model="ir.ui.view">
        <field name="name">transfer.committee.minutes.list</field>
        <field name="model">transfer.committee.minutes</field>
        <field name="arch" type="xml">
            <list string="Transfer Committee Minutes">
                <field name="name"/>
                <field name="target_vacancy_id"/>
                <field name="meeting_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="transfer_committee_minutes_form_view" model="ir.ui.view">
        <field name="name">transfer.committee.minutes.form</field>
        <field name="model">transfer.committee.minutes</field>
        <field name="arch" type="xml">
            <form string="Transfer Committee Minutes">
                <header>
                    <button name="action_compute_ranking" string="Compute Ranking" type="object" class="oe_highlight" invisible="state == 'approved'"/>
                    <button name="action_approve_minutes" string="Approve Minutes" type="object" class="oe_highlight" invisible="state != 'ranked'"/>
                    <button name="%(action_report_transfer_minute)d" string="Print Minutes" type="action" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="target_vacancy_id"/>
                        <field name="meeting_date"/>
                    </group>
                    <notebook>
                        <page string="Transfer Requests Considered">
                            <field name="transfer_request_ids">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="current_job_position_id"/>
                                    <field name="request_date"/>
                                    <field name="eligibility_status"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ranked List">
                            <field name="ranking_line_ids" readonly="1">
                                <list editable="bottom">
                                    <field name="rank"/>
                                    <field name="employee_id"/>
                                    <field name="application_date_score"/>
                                    <field name="experience_score"/>
                                    <field name="service_location_score"/>
                                    <field name="pms_score"/>
                                    <field name="discipline_deduction_percent"/>
                                    <field name="final_score"/>
                                    <field name="selection_decision"/>
                                </list>
                            </field>
                        </page>
                        <page string="Selection Decision">
                            <field name="selection_decision" placeholder="Committee notes and final selection decision..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_transfer_committee_minutes" model="ir.actions.act_window">
        <field name="name">Transfer Committee Minutes</field>
        <field name="res_model">transfer.committee.minutes</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create Transfer Committee Minutes!</p>
        </field>
    </record>
</odoo>
