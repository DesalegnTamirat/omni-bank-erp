<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="recruitment_application_window_tree" model="ir.ui.view">
        <field name="name">recruitment.application.window.tree</field>
        <field name="model">recruitment.application.window</field>
        <field name="arch" type="xml">
            <list>
                <field name="vacancy_id"/>
                <field name="notification_date"/>
                <field name="closing_date"/>
                <field name="is_open"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="recruitment_application_window_form" model="ir.ui.view">
        <field name="name">recruitment.application.window.form</field>
        <field name="model">recruitment.application.window</field>
        <field name="arch" type="xml">
            <form string="Application Window">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vacancy_id"/>
                            <field name="notification_date"/>
                        </group>
                        <group>
                            <field name="closing_date"/>
                            <field name="is_open"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_recruitment_application_window" model="ir.actions.act_window">
        <field name="name">Application Windows</field>
        <field name="res_model">recruitment.application.window</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="xml">
            <p class="o_view_nocontent_smiling_face">
                No application windows found. They are created automatically when a vacancy is published.
            </p>
        </field>
    </record>
</odoo>
