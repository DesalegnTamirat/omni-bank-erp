<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hr_employee_competency_smart_buttons" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.competency</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_view_competency_assessments" type="object"
                            class="btn-link" icon="fa-clipboard-check">
                        <field name="competency_assessment_count" widget="statinfo"
                               string="Competency Assessments"/>
                    </button>
                    <button name="action_view_competency_idps" type="object"
                            class="btn-link" icon="fa-road">
                        <field name="competency_idp_count" widget="statinfo"
                               string="Development Plans (IDP)"/>
                    </button>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
