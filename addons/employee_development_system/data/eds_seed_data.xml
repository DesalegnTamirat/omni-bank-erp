<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            EDS seed data is populated progressively as later tasks land:

            Task 2  - eds.tna.priority.rule template (weights summing to 100)
            Task 5  - default training venue (demo)
            Task 8  - eds.evaluation.instrument v1 (Level 1 reaction survey)
            Task 10 - eds.certificate.rule default (80% attendance + Level 2 pass)
        -->

        <!-- Task 5: default training venue (FREDS020 demo seed) -->
        <record id="venue_default_head_office" model="eds.venue">
            <field name="name">Head Office Training Hall</field>
            <field name="location">Bunna Bank Head Office</field>
            <field name="capacity">30</field>
            <field name="facilities">Projector, whiteboard, tables &amp; chairs, catering area</field>
        </record>

        <!-- Task 2: default priority-rule weights (FREDS006) - sum 100% -->
        <record id="rule_priority_strategic" model="eds.tna.priority.rule">
            <field name="sequence">10</field>
            <field name="name">Strategic Alignment</field>
            <field name="criteria">strategic_alignment</field>
            <field name="weight">25.0</field>
            <field name="description">How closely the need aligns with bank strategy and corporate objectives.</field>
        </record>
        <record id="rule_priority_regulatory" model="eds.tna.priority.rule">
            <field name="sequence">20</field>
            <field name="name">Regulatory / Compliance Requirement</field>
            <field name="criteria">regulatory</field>
            <field name="weight">20.0</field>
            <field name="description">Mandatory NBE / regulatory / compliance driven training.</field>
        </record>
        <record id="rule_priority_gap_severity" model="eds.tna.priority.rule">
            <field name="sequence">30</field>
            <field name="name">Gap Severity</field>
            <field name="criteria">gap_severity</field>
            <field name="weight">20.0</field>
            <field name="description">Severity of the competency gap behind the need.</field>
        </record>
        <record id="rule_priority_risk" model="eds.tna.priority.rule">
            <field name="sequence">40</field>
            <field name="name">Risk Level</field>
            <field name="criteria">risk_level</field>
            <field name="weight">15.0</field>
            <field name="description">Operational / audit / reputational risk exposure if unaddressed.</field>
        </record>
        <record id="rule_priority_tom" model="eds.tna.priority.rule">
            <field name="sequence">50</field>
            <field name="name">TOM Impact</field>
            <field name="criteria">tom_impact</field>
            <field name="weight">10.0</field>
            <field name="description">Impact on the Target Operating Model and digital transformation.</field>
        </record>
        <record id="rule_priority_future" model="eds.tna.priority.rule">
            <field name="sequence">60</field>
            <field name="name">Future Capability</field>
            <field name="criteria">future_capability</field>
            <field name="weight">10.0</field>
            <field name="description">Builds capability for future roles / succession readiness.</field>
        </record>
    </data>
</odoo>
