# Copy outside the repository and replace every image with an approved digest.
ODOO_BASE_IMAGE=odoo:19.0@sha256:REPLACE_WITH_APPROVED_DIGEST
ODOO_APP_IMAGE=registry.example.com/bunna/erp:REPLACE_WITH_RELEASE_TAG
POSTGRES_IMAGE=postgres:16@sha256:REPLACE_WITH_APPROVED_DIGEST
NGINX_IMAGE=nginx:stable@sha256:REPLACE_WITH_APPROVED_DIGEST
DB_USER=odoo
# Absolute host paths to private files. Never commit their contents.
POSTGRES_PASSWORD_FILE=/secure/path/postgres_password
ODOO_CONFIG_FILE=/secure/path/odoo.conf
TLS_CERT_FILE=/secure/path/fullchain.pem
TLS_KEY_FILE=/secure/path/privkey.pem
# Keep loopback when an approved perimeter proxy fronts this stack.
HTTPS_BIND=127.0.0.1

