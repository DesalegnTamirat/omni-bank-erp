<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_planning_fiscal_year_list" model="ir.ui.view">
        <field name="name">planning.fiscal.year.list</field>
        <field name="model">planning.fiscal.year</field>
        <field name="arch" type="xml">
            <list string="Fiscal Years">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_planning_fiscal_year_form" model="ir.ui.view">
        <field name="name">planning.fiscal.year.form</field>
        <field name="model">planning.fiscal.year</field>
        <field name="arch" type="xml">
            <form string="Fiscal Year">
                <header>
                    <button string="Edit"
                            name="action_edit_fiscal_year"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Save"
                            name="action_save_fiscal_year"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="year_start"/>
                        <h1>
                            <field name="year_start" placeholder="e.g. 2023"/>
                        </h1>
                        <field name="name" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="date_start" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_planning_fiscal_year_search" model="ir.ui.view">
        <field name="name">planning.fiscal.year.search</field>
        <field name="model">planning.fiscal.year</field>
        <field name="arch" type="xml">
            <search string="Fiscal Years">
                <field name="name"/>
                <field name="year_start"/>
            </search>
        </field>
    </record>

    <record id="action_planning_fiscal_year" model="ir.actions.act_window">
        <field name="name">Fiscal Years</field>
        <field name="res_model">planning.fiscal.year</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'form_view_initial_mode': 'readonly'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a new Fiscal Year (e.g. 2023 for 2023-2024)
            </p>
        </field>
    </record>
</odoo>