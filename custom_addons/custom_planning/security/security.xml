<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Define the module category (Application) -->
    <record id="module_category_planning" model="ir.module.category">
        <field name="name">Custom Planning</field>
        <field name="description">Manage Man Power Plans and Fiscal Year configurations.</field>
        <field name="sequence">50</field>
    </record>

    <!-- 2. Define the Privilege -->
    <record id="res_groups_privilege_planning" model="res.groups.privilege">
        <field name="name">Planning</field>
        <field name="category_id" ref="module_category_planning"/>
        <field name="sequence">10</field>
    </record>

    <!-- 3. Define the Groups linked to the Privilege -->
    <record id="group_planning_user" model="res.groups">
        <field name="name">Planning User</field>
        <field name="privilege_id" ref="res_groups_privilege_planning"/>
        <field name="sequence">10</field>
        <field name="comment">Can create/edit Plan Versions and Man Power Plans, and initiate the approval workflow.</field>
    </record>

    <record id="group_planning_manager" model="res.groups">
        <field name="name">Planning Manager / Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_planning"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_planning_user'))]"/>
        <field name="comment">Can configure Fiscal Years/Plan Versions and approve or reject any Man Power Plan regardless of hierarchy.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>