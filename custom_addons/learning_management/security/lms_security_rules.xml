<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ========================================================= -->
        <!-- LMS ENROLLMENT RECORD RULES                               -->
        <!-- ========================================================= -->

        <!-- 1. Learner: View own enrollments -->
        <record id="rule_lms_enrollment_learner" model="ir.rule">
            <field name="name">Learner View Own Enrollments</field>
            <field name="model_id" ref="learning_management.model_lms_enrollment"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 2. Manager: Full enrollment management -->
        <record id="rule_lms_enrollment_manager" model="ir.rule">
            <field name="name">Manager Full Enrollment Access</field>
            <field name="model_id" ref="learning_management.model_lms_enrollment"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ========================================================= -->
        <!-- LMS COURSE RECORD RULES                                   -->
        <!-- ========================================================= -->

        <!-- 1. Learner: View published courses -->
        <record id="rule_lms_course_learner" model="ir.rule">
            <field name="name">Learner View Published Courses</field>
            <field name="model_id" ref="learning_management.model_lms_course"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <!-- An explicit enrollment remains visible if the employee changes roles.
                 Otherwise every configured audience dimension must match. -->
            <field name="domain_force">['|', ('instructor_id.user_id', '=', user.id), '&amp;', ('active', '=', True), '|', '&amp;', ('state', '=', 'archived'), ('enrollment_ids', 'any', [('user_id', '=', user.id), ('state', 'in', ('enrolled', 'in_progress', 'completed'))]), '&amp;', '&amp;', ('state', '=', 'published'), ('is_latest_version', '=', True), '|', ('enrollment_ids', 'any', [('user_id', '=', user.id)]), '&amp;', '&amp;', '|', ('target_department_ids', '=', False), ('target_department_ids', 'in', user.employee_id.department_id.ids), '|', ('target_job_ids', '=', False), ('target_job_ids', 'in', user.employee_id.job_id.ids), '|', ('target_grade_ids', '=', False), ('target_grade_ids', 'in', user.employee_id.job_id.grade.ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 2. Instructor & Manager: Manage all courses -->
        <record id="rule_lms_course_manager" model="ir.rule">
            <field name="name">Instructor and Manager Full Course Access</field>
            <field name="model_id" ref="learning_management.model_lms_course"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_instructor')), (4, ref('learning_management.group_lms_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Curriculum and assessments are only visible to assigned learners.
             The instructor rule also covers managers, who inherit that group. -->
        <record id="rule_lms_section_learner" model="ir.rule">
            <field name="name">Learner Assigned Published Course Sections</field>
            <field name="model_id" ref="learning_management.model_lms_course_section"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <field name="domain_force">['&amp;', ('course_id.active', '=', True), '&amp;', '|', ('course_id.state', '=', 'archived'), '&amp;', ('course_id.state', '=', 'published'), ('course_id.is_latest_version', '=', True), ('course_id.enrollment_ids', 'any', [('user_id', '=', user.id), ('state', 'in', ('enrolled', 'in_progress', 'completed')), '|', ('course_id.has_pre_assessment', '=', False), ('pre_assessment_passed', '=', True)])]</field>
        </record>
        <record id="rule_lms_section_instructor" model="ir.rule">
            <field name="name">Instructor All Course Sections</field>
            <field name="model_id" ref="learning_management.model_lms_course_section"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_instructor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_lms_lesson_learner" model="ir.rule">
            <field name="name">Learner Assigned Published Lessons</field>
            <field name="model_id" ref="learning_management.model_lms_lesson"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <field name="domain_force">['&amp;', ('course_id.active', '=', True), '&amp;', '|', ('course_id.state', '=', 'archived'), '&amp;', ('course_id.state', '=', 'published'), ('course_id.is_latest_version', '=', True), ('course_id.enrollment_ids', 'any', [('user_id', '=', user.id), ('state', 'in', ('enrolled', 'in_progress', 'completed')), '|', ('course_id.has_pre_assessment', '=', False), ('pre_assessment_passed', '=', True)])]</field>
        </record>
        <record id="rule_lms_lesson_instructor" model="ir.rule">
            <field name="name">Instructor All Lessons</field>
            <field name="model_id" ref="learning_management.model_lms_lesson"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_instructor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_lms_assessment_learner" model="ir.rule">
            <field name="name">Learner Published Course Assessments</field>
            <field name="model_id" ref="learning_management.model_lms_assessment"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <field name="domain_force">['&amp;', ('course_id.active', '=', True), '&amp;', '|', ('course_id.state', '=', 'archived'), '&amp;', ('course_id.state', '=', 'published'), ('course_id.is_latest_version', '=', True), ('course_id.enrollment_ids', 'any', [('user_id', '=', user.id), ('state', 'in', ('enrolled', 'in_progress', 'completed'))])]</field>
        </record>
        <record id="rule_lms_assessment_instructor" model="ir.rule">
            <field name="name">Instructor All Assessments</field>
            <field name="model_id" ref="learning_management.model_lms_assessment"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_instructor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_lms_progress_learner" model="ir.rule">
            <field name="name">Learner Own Lesson Progress</field>
            <field name="model_id" ref="learning_management.model_lms_lesson_progress"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_lms_progress_manager" model="ir.rule">
            <field name="name">Manager All Lesson Progress</field>
            <field name="model_id" ref="learning_management.model_lms_lesson_progress"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_lms_points_learner" model="ir.rule">
            <field name="name">Learner Own Learning Points</field>
            <field name="model_id" ref="learning_management.model_lms_gamification_point"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
        <record id="rule_lms_points_manager" model="ir.rule">
            <field name="name">Manager All Learning Points</field>
            <field name="model_id" ref="learning_management.model_lms_gamification_point"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ========================================================= -->
        <!-- LMS EXAM SESSION RECORD RULES                             -->
        <!-- ========================================================= -->

        <!-- Learner: View own exam attempts -->
        <record id="rule_lms_exam_session_learner" model="ir.rule">
            <field name="name">Learner View Own Exam Attempts</field>
            <field name="model_id" ref="learning_management.model_lms_exam_session"/>
