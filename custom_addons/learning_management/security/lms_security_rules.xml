<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ========================================================= -->
        <!-- LMS ENROLLMENT RECORD RULES                               -->
        <!-- ========================================================= -->

        <!-- 1. Learner: View own enrollments -->
        <record id="rule_lms_enrollment_learner" model="ir.rule">
            <field name="name">Learner View Own Enrollments</field>
            <field name="model_id" ref="learning_management.model_lms_enrollment"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 2. Manager: Full enrollment management -->
        <record id="rule_lms_enrollment_manager" model="ir.rule">
            <field name="name">Manager Full Enrollment Access</field>
            <field name="model_id" ref="learning_management.model_lms_enrollment"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ========================================================= -->
        <!-- LMS COURSE RECORD RULES                                   -->
        <!-- ========================================================= -->

        <!-- 1. Learner: View published courses -->
        <record id="rule_lms_course_learner" model="ir.rule">
            <field name="name">Learner View Published Courses</field>
            <field name="model_id" ref="learning_management.model_lms_course"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <field name="domain_force">['|', ('state', '=', 'published'), ('instructor_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 2. Instructor & Manager: Manage all courses -->
        <record id="rule_lms_course_manager" model="ir.rule">
            <field name="name">Instructor and Manager Full Course Access</field>
            <field name="model_id" ref="learning_management.model_lms_course"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_instructor')), (4, ref('learning_management.group_lms_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ========================================================= -->
        <!-- LMS EXAM SESSION RECORD RULES                             -->
        <!-- ========================================================= -->

        <!-- Learner: View own exam attempts -->
        <record id="rule_lms_exam_session_learner" model="ir.rule">
            <field name="name">Learner View Own Exam Attempts</field>
            <field name="model_id" ref="learning_management.model_lms_exam_session"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager: Full exam access -->
        <record id="rule_lms_exam_session_manager" model="ir.rule">
            <field name="name">Manager Full Exam Access</field>
            <field name="model_id" ref="learning_management.model_lms_exam_session"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ========================================================= -->
        <!-- LMS CERTIFICATE RECORD RULES                              -->
        <!-- ========================================================= -->

        <!-- Learner: View own certificates -->
        <record id="rule_lms_certificate_learner" model="ir.rule">
            <field name="name">Learner View Own Certificates</field>
            <field name="model_id" ref="learning_management.model_lms_certificate"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager: All certificates -->
        <record id="rule_lms_certificate_manager" model="ir.rule">
            <field name="name">Manager All Certificates Access</field>
            <field name="model_id" ref="learning_management.model_lms_certificate"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ========================================================= -->
        <!-- LMS QUESTION & ANSWER RECORD RULES (Fix: Exam Security)   -->
        <!-- ========================================================= -->

        <!-- 1. Learner: Only view questions in own active/assigned exam session lines -->
        <record id="rule_lms_question_learner" model="ir.rule">
            <field name="name">Learner View Own Exam Session Questions</field>
            <field name="model_id" ref="learning_management.model_lms_question"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <field name="domain_force">[('session_line_ids.session_id.employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 2. Instructor & Manager: Full Question Bank Access -->
        <record id="rule_lms_question_instructor" model="ir.rule">
            <field name="name">Instructor and Manager Full Question Access</field>
            <field name="model_id" ref="learning_management.model_lms_question"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_instructor')), (4, ref('learning_management.group_lms_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 3. Learner: Only view answer options for questions in own exam session lines -->
        <record id="rule_lms_answer_learner" model="ir.rule">
            <field name="name">Learner View Own Exam Session Answers</field>
            <field name="model_id" ref="learning_management.model_lms_question_answer"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_learner'))]"/>
            <field name="domain_force">[('question_id.session_line_ids.session_id.employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 4. Instructor & Manager: Full Answer Key Access -->
        <record id="rule_lms_answer_instructor" model="ir.rule">
            <field name="name">Instructor and Manager Full Answer Access</field>
            <field name="model_id" ref="learning_management.model_lms_question_answer"/>
            <field name="groups" eval="[(4, ref('learning_management.group_lms_instructor')), (4, ref('learning_management.group_lms_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
