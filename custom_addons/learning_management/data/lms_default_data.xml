<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ========================================================= -->
        <!-- LMS COURSE CATEGORIES                                     -->
        <!-- ========================================================= -->
        <record id="lms_cat_compliance" model="lms.category">
            <field name="name">AML/CFT &amp; Regulatory Compliance</field>
            <field name="code">LMS_COMP</field>
            <field name="description">Mandatory regulatory compliance, anti-money laundering, counter-terrorist financing, and KYC standards.</field>
            <field name="color">1</field>
        </record>

        <record id="lms_cat_credit" model="lms.category">
            <field name="name">Credit Appraisal &amp; Risk Management</field>
            <field name="code">LMS_CREDIT</field>
            <field name="description">Commercial lending, financial analysis, collateral evaluation, and debt recovery.</field>
            <field name="color">2</field>
        </record>

        <record id="lms_cat_operations" model="lms.category">
            <field name="name">Branch Banking Operations</field>
            <field name="code">LMS_OPS</field>
            <field name="description">Front-line customer service, teller cash procedures, remittance, and branch internal control.</field>
            <field name="color">3</field>
        </record>

        <record id="lms_cat_digital" model="lms.category">
            <field name="name">Digital Banking &amp; FinTech Applications</field>
            <field name="code">LMS_DIGITAL</field>
            <field name="description">Core banking system, Bunna Mobile, internet banking, POS terminals, and cyber security hygiene.</field>
            <field name="color">4</field>
        </record>

        <record id="lms_cat_leadership" model="lms.category">
            <field name="name">Leadership &amp; Professional Development</field>
            <field name="code">LMS_LEAD</field>
            <field name="description">Supervisory leadership, managerial coaching, customer empathy, and conflict resolution.</field>
            <field name="color">5</field>
        </record>

        <!-- ========================================================= -->
        <!-- DEFAULT CERTIFICATE TEMPLATE (FR-LMS-019)                 -->
        <!-- ========================================================= -->
        <record id="lms_cert_template_default" model="lms.certificate.template">
            <field name="name">Bunna Bank Standard Certificate of Achievement</field>
            <field name="header_text">CERTIFICATE OF ACHIEVEMENT</field>
            <field name="subtitle_text">BUNNA BANK S.C. E-ACADEMY</field>
            <field name="body_text"><![CDATA[
                <p style="font-size: 16px; color: #1d2b32; line-height: 1.6;">
                    This is proudly presented to certify that
                    <br/><br/>
                    <strong style="font-size: 24px; color: #541718;">${learner_name}</strong>
                    <br/><br/>
                    has successfully fulfilled all course curriculum requirements and demonstrated verified proficiency in the corporate banking training program:
                    <br/><br/>
                    <strong style="font-size: 20px; color: #1d2b32;">${course_name}</strong>
                </p>
            ]]></field>
            <field name="signatory_1_name">Chief Human Resources Officer</field>
            <field name="signatory_1_title">People Performance &amp; Development</field>
            <field name="signatory_2_name">Chief Executive Officer</field>
            <field name="signatory_2_title">Bunna Bank S.C.</field>
        </record>

        <!-- ========================================================= -->
        <!-- CRONS: CERTIFICATE EXPIRY & MONTHLY BEST SCORER           -->
        <!-- ========================================================= -->
        <record id="ir_cron_lms_check_certificate_expiry" model="ir.cron">
            <field name="name">LMS: Check Certification Validity Expiry</field>
            <field name="model_id" ref="learning_management.model_lms_certificate"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_certificate_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_lms_monthly_best_scorer" model="ir.cron">
            <field name="name">LMS: Calculate Best Scorer of the Month</field>
            <field name="model_id" ref="learning_management.model_lms_monthly_scorer"/>
            <field name="state">code</field>
            <field name="code">model.cron_calculate_monthly_winner()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">True</field>
        </record>

        <!-- FR-LMS-028: Daily Automated Notifications for Overdue / Nearing-Deadline Mandatory Courses -->
        <record id="ir_cron_lms_overdue_reminders" model="ir.cron">
            <field name="name">LMS: Send Overdue and Nearing-Deadline Mandatory Reminders</field>
            <field name="model_id" ref="learning_management.model_lms_enrollment"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_overdue_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
