<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for Courses -->
        <record id="seq_lms_course" model="ir.sequence">
            <field name="name">LMS Course Reference</field>
            <field name="code">lms.course</field>
            <field name="prefix">LMS/CRS/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Assessments -->
        <record id="seq_lms_assessment" model="ir.sequence">
            <field name="name">LMS Assessment Reference</field>
            <field name="code">lms.assessment</field>
            <field name="prefix">LMS/EXM/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Issued Certificates -->
        <record id="seq_lms_certificate" model="ir.sequence">
            <field name="name">Bunna LMS Issued Certificate</field>
            <field name="code">lms.certificate</field>
            <field name="prefix">BUNNA/CERT/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
