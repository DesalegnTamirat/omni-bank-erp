<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Best Scorer of the Month Kanban -->
        <record id="view_lms_monthly_scorer_kanban" model="ir.ui.view">
            <field name="name">lms.monthly.scorer.kanban</field>
            <field name="model">lms.monthly.scorer</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="period_date"/>
                    <field name="average_score"/>
                    <field name="courses_completed"/>
                    <field name="badge"/>
                    <field name="citation"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click p-4 rounded shadow-sm border mb-3 bg-white text-center">
                                <div class="mb-2">
                                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                        <i class="fa fa-graduation-cap me-1"/> <t t-esc="record.badge.value"/>
                                    </span>
                                </div>
                                <div class="my-3">
                                    <field name="employee_id" widget="image" options="{'preview_image': 'avatar_128', 'size': [80, 80]}" class="rounded-circle border border-warning border-3 shadow-sm mx-auto"/>
                                </div>
                                <div class="fw-bold fs-5 text-dark mb-1"><t t-esc="record.employee_id.value"/></div>
                                <div class="text-muted small mb-2"><t t-esc="record.department_id.value"/></div>
                                <div class="badge bg-success fs-6 mb-3">
                                    Average Score: <t t-esc="record.average_score.value"/>% | <t t-esc="record.courses_completed.value"/> Courses
                                </div>
                                <p class="text-muted small fst-italic px-3 mb-0"><t t-esc="record.citation.value"/></p>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Best Scorer of the Month Form View with Chatter -->
        <record id="view_lms_monthly_scorer_form" model="ir.ui.view">
            <field name="name">lms.monthly.scorer.form</field>
            <field name="model">lms.monthly.scorer</field>
            <field name="arch" type="xml">
                <form string="Monthly Best Scorer">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Learner Information">
                                <field name="employee_id" widget="many2one_avatar_employee"/>
                                <field name="department_id"/>
                                <field name="operating_unit_id"/>
                            </group>
                            <group string="Achievement Metrics">
                                <field name="period_date"/>
                                <field name="average_score"/>
                                <field name="courses_completed"/>
                                <field name="badge" widget="badge"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Citation &amp; Highlights">
                                <field name="citation" placeholder="Reason and highlights for this month's recognition..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Points Ledger List -->
        <record id="view_lms_points_ledger_list" model="ir.ui.view">
            <field name="name">lms.gamification.point.list</field>
            <field name="model">lms.gamification.point</field>
            <field name="arch" type="xml">
                <list string="Learning Gamification Ledger" create="0" delete="0">
                    <field name="date_earned"/>
                    <field name="employee_id" widget="many2one_avatar_employee"/>
                    <field name="points" string="Points" decoration-success="points > 0"/>
                    <field name="source" widget="badge"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_lms_monthly_scorer" model="ir.actions.act_window">
            <field name="name">Best Scorer of the Month (LMS)</field>
            <field name="res_model">lms.monthly.scorer</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <record id="action_lms_points_ledger" model="ir.actions.act_window">
            <field name="name">Learning Points Ledger</field>
            <field name="res_model">lms.gamification.point</field>
            <field name="view_mode">list</field>
        </record>

    </data>
</odoo>
