<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Certificates List -->
        <record id="view_lms_certificate_list" model="ir.ui.view">
            <field name="name">lms.certificate.list</field>
            <field name="model">lms.certificate</field>
            <field name="arch" type="xml">
                <list string="Issued Certificates" decoration-success="state == 'valid'" decoration-danger="state == 'expired'">
                    <field name="name" string="Certificate Number"/>
                    <field name="employee_id" widget="many2one_avatar_employee"/>
                    <field name="course_id"/>
                    <field name="department_id" optional="show"/>
                    <field name="operating_unit_id" optional="show"/>
                    <field name="issue_date"/>
                    <field name="expiry_date"/>
                    <field name="score_percentage" string="Score (%)"/>
                    <field name="verification_code" string="Security Code"/>
                    <field name="state" widget="badge" decoration-success="state == 'valid'" decoration-danger="state in ('expired', 'revoked')"/>
                </list>
            </field>
        </record>

        <!-- Certificates Form -->
        <record id="view_lms_certificate_form" model="ir.ui.view">
            <field name="name">lms.certificate.form</field>
            <field name="model">lms.certificate</field>
            <field name="arch" type="xml">
                <form string="Training Certificate">
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Valid" bg_color="text-bg-success" invisible="state != 'valid'"/>
                        <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="state != 'expired'"/>

                        <div class="oe_title">
                            <label for="name" string="Certificate Serial Number"/>
                            <h1><field name="name" readonly="1"/></h1>
                            <label for="employee_id" string="Certified Staff Member"/>
                            <h2><field name="employee_id" options="{'no_create': True}"/></h2>
                        </div>

                        <group>
                            <group string="Program &amp; Academic Merit">
                                <field name="course_id" options="{'no_create': True}"/>
                                <field name="score_percentage"/>
                                <field name="template_id" options="{'no_create': True}"/>
                            </group>
                            <group string="Issuance &amp; Validity Tracking (FR-LMS-020)">
                                <field name="issue_date"/>
                                <field name="expiry_date"/>
                                <field name="verification_code" readonly="1"/>
                                <field name="verification_url" widget="url" readonly="1"/>
                            </group>
                        </group>

                        <group string="Core HR Master Data Linkages (FR-LMS-022)">
                            <group>
                                <field name="hr_training_history_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="hr_employee_document_id" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Certificate Templates -->
        <record id="view_lms_cert_template_list" model="ir.ui.view">
            <field name="name">lms.certificate.template.list</field>
            <field name="model">lms.certificate.template</field>
            <field name="arch" type="xml">
                <list string="Certificate Templates">
                    <field name="name"/>
                    <field name="header_text"/>
                    <field name="signatory_1_name"/>
                    <field name="signatory_2_name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_lms_cert_template_form" model="ir.ui.view">
            <field name="name">lms.certificate.template.form</field>
            <field name="model">lms.certificate.template</field>
            <field name="arch" type="xml">
                <form string="Certificate Template">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Template Name"/>
                            <h1><field name="name" placeholder="e.g. Bunna Executive Certification Template"/></h1>
                        </div>
                        <group>
                            <group string="Header Text">
                                <field name="header_text"/>
                                <field name="subtitle_text"/>
                            </group>
                            <group string="Signatories">
                                <field name="signatory_1_name"/>
                                <field name="signatory_1_title"/>
                                <field name="signatory_2_name"/>
                                <field name="signatory_2_title"/>
                            </group>
                        </group>
                        <group string="Certificate Citation Body">
                            <field name="body_text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_lms_certificate_all" model="ir.actions.act_window">
            <field name="name">Issued Certificates</field>
            <field name="res_model">lms.certificate</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_lms_cert_template_all" model="ir.actions.act_window">
            <field name="name">Certificate Templates</field>
            <field name="res_model">lms.certificate.template</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
