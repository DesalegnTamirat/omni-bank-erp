<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Public Certificate Verification Page (Success) -->
        <template id="certificate_verify_success" name="Certificate Verification Success">
            <t t-call="web.layout">
                <div class="container my-5">
                    <div class="row justify-content-center">
                        <div class="col-md-8">
                            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                                <div class="card-header text-white text-center py-4" style="background-color: #541718;">
                                    <h2 class="fw-bold mb-1"><i class="fa fa-shield me-2"/>Bunna Bank Digital Certificate Verification</h2>
                                    <p class="mb-0 opacity-75">Institutional Credential Verification Service</p>
                                </div>
                                <div class="card-body p-5 text-center bg-light">
                                    <div class="mb-4">
                                        <span t-if="is_valid" class="badge bg-success fs-5 px-4 py-2 rounded-pill shadow-sm">
                                            <i class="fa fa-check-circle me-2"/>OFFICIALLY VERIFIED &amp; VALID
                                        </span>
                                        <span t-else="" class="badge bg-danger fs-5 px-4 py-2 rounded-pill shadow-sm">
                                            <i class="fa fa-exclamation-triangle me-2"/>CERTIFICATE EXPIRED OR REVOKED
                                        </span>
                                    </div>

                                    <div class="bg-white p-4 rounded-3 border shadow-sm text-start mb-4">
                                        <div class="row mb-3">
                                            <div class="col-sm-4 fw-bold text-muted">Certificate Number:</div>
                                            <div class="col-sm-8 fw-bold fs-5 text-dark"><t t-esc="cert_number"/></div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-sm-4 fw-bold text-muted">Certified Learner:</div>
                                            <div class="col-sm-8 fw-bold fs-5" style="color: #541718;"><t t-esc="learner_name"/></div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-sm-4 fw-bold text-muted">Training Program:</div>
                                            <div class="col-sm-8 fw-bold text-dark"><t t-esc="course_name"/></div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-sm-4 fw-bold text-muted">Issuance Date:</div>
                                            <div class="col-sm-8 text-dark"><t t-esc="issue_date"/></div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-sm-4 fw-bold text-muted">Validity Expiration:</div>
                                            <div class="col-sm-8 text-dark"><t t-esc="expiry_date"/></div>
                                        </div>
                                        <div class="row">
                                            <div class="col-sm-4 fw-bold text-muted">Verification Hash:</div>
                                            <div class="col-sm-8 font-monospace small text-muted"><t t-esc="cert.verification_code"/></div>
                                        </div>
                                    </div>

                                    <p class="text-muted small mb-0">
                                        This digital credential record was authenticated directly from Bunna Bank S.C. Learning Management System.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Public Certificate Verification Page (Not Found) -->
        <template id="certificate_verify_not_found" name="Certificate Not Found">
            <t t-call="web.layout">
                <div class="container my-5 text-center">
                    <div class="card shadow border-0 rounded-4 p-5 mx-auto" style="max-width: 600px;">
                        <div class="text-danger mb-3">
                            <i class="fa fa-times-circle fa-4x"/>
                        </div>
                        <h2 class="fw-bold text-danger">Invalid Certificate Hash</h2>
                        <p class="text-muted">
                            No certificate matching code <code><t t-esc="code"/></code> could be verified in the Bunna Bank LMS database.
                        </p>
                    </div>
                </div>
            </t>
        </template>

        <!-- Secure Video Player with Anti-Cheat & Dynamic Watermark Overlay -->
        <template id="lesson_video_player" name="LMS Video Lesson">
            <t t-call="web.layout">
                <t t-set="title"><t t-esc="lesson.name"/> - Bunna LMS</t>
                <link rel="stylesheet" href="/learning_management/static/src/css/lms_player.css"/>
                <main id="lmsPlayerPage"
                      class="o_lms_player_page"
                      t-att-data-lesson-id="lesson.id"
                      data-heartbeat-url="/lms/video/heartbeat"
                      t-att-data-last-position="last_position or 0"
                      t-att-data-completed="'1' if lesson_completed else '0'"
                      t-att-data-guard-seek="'1' if lesson.prevent_fast_forward else '0'">
                    <div class="container o_lms_player_inner py-4">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3 mb-3">
                            <div>
                                <div class="small text-white-50 mb-1"><t t-esc="course.name"/></div>
                                <h1 class="h3 mb-1 text-white"><t t-esc="lesson.name"/></h1>
                                <div class="small text-white-50">
                                    <t t-esc="int(lesson.duration_minutes or (lesson.video_duration_seconds // 60) or 0)"/> minute lesson
                                </div>
                            </div>
                            <a t-if="enrollment"
                               t-att-href="'/web#id=%s&amp;model=lms.enrollment&amp;view_type=form' % enrollment.id"
                               class="btn btn-outline-light o_lms_back_link">
                                <i class="fa fa-arrow-left me-2" aria-hidden="true"/>Back to my course
                            </a>
                            <a t-else=""
                               t-att-href="'/web#id=%s&amp;model=lms.course&amp;view_type=form' % course.id"
                               class="btn btn-outline-light o_lms_back_link">
                                <i class="fa fa-arrow-left me-2" aria-hidden="true"/>Back to course
                            </a>
                        </div>

                        <div class="o_lms_video_shell">
                            <video id="lmsVideoPlayer"
                                   controls="controls"
                                   controlslist="nodownload"
                                   disablepictureinpicture="disablepictureinpicture"
                                   playsinline="playsinline"
                                   preload="metadata"
                                   t-att-aria-label="'Video lesson: %s' % lesson.name">
                                <source t-att-src="stream_url"/>
                                Your browser cannot play this video.
                            </video>
                            <div id="lmsWatermarkLayer" class="o_lms_watermark_layer" aria-hidden="true">
                                <div class="o_lms_watermark"><t t-esc="user_name"/> · <t t-esc="emp_code"/></div>
                                <div class="o_lms_watermark">Bunna LMS · <t t-esc="timestamp"/></div>
                            </div>
                        </div>
                        <div class="o_lms_status_panel p-3">
                            <div class="d-flex flex-wrap gap-3 align-items-center small">
                                <span>Playback position: <strong id="lmsPlaybackPosition">0%</strong></span>
                                <span>Saved at: <strong id="lmsSavedPosition">0:00</strong></span>
                                <span t-if="lesson_completed" class="badge text-bg-success">Lesson complete</span>
                            </div>
                            <p id="lmsPlayerFeedback" class="o_lms_feedback small mb-0 mt-2" role="status" aria-live="polite">Playback resumes from your last saved position.</p>
                            <button id="lmsRetryProgress" type="button" class="btn btn-outline-light btn-sm o_lms_retry_button mt-2" hidden="hidden">Retry saving progress</button>
                        </div>

                        <div class="row g-3 mt-2">
                            <div class="col-md-7">
                                <section class="card bg-dark border-secondary text-white h-100 p-3" aria-labelledby="lmsLessonInfo">
                                    <h2 id="lmsLessonInfo" class="h5">Learning progress</h2>
                                    <p class="mb-0 text-white-50">Watch the required part of the video to complete this lesson. Progress is saved during playback. On a slow connection, pause to let the video buffer, then continue.</p>
                                </section>
                            </div>
                            <div class="col-md-5">
                                <section class="card bg-dark border-secondary text-white h-100 p-3" aria-labelledby="lmsContentNotice">
                                    <h2 id="lmsContentNotice" class="h5">Bank learning material</h2>
                                    <p class="mb-0 text-white-50">This session includes a visible learner watermark. Follow the bank's rules for sharing training material.</p>
                                </section>
                            </div>
                        </div>
                    </div>
                </main>
                <script src="/learning_management/static/src/js/lms_player.js" defer="defer"></script>
            </t>
        </template>

    </data>
</odoo>
