<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_attendance_manual_wizard_form" model="ir.ui.view">
            <field name="name">hr.attendance.manual.wizard.form</field>
            <field name="model">hr.attendance.manual.wizard</field>
            <field name="arch" type="xml">
                <form string="Manual Attendance Entry">
                    <div class="alert alert-info" role="alert">
                        <strong>Manual Attendance &amp; Duty OFF Manager Entry</strong><br/>
                        Select mode: Individual employee correction, Batch Operating Unit entry (multi-date / outage), or Duty OFF (Half-Day / Full-Day). Note: Manual entry is strictly allowed for past dates or today.
                    </div>
                    <group>
                        <field name="entry_type" widget="radio" class="oe_inline"/>
                    </group>

                    <!-- INDIVIDUAL MODE -->
                    <div class="alert alert-info py-2 px-3 mb-2" invisible="entry_type != 'individual' or not detected_shift_info">
                        <i class="fa fa-clock-o me-1"/> <strong>Applicable Shift: </strong><field name="detected_shift_info" readonly="1" class="fw-bold text-primary"/>
                    </div>
                    <group invisible="entry_type != 'individual'">
                        <group string="Employee &amp; Date">
                            <field name="employee_id" required="entry_type == 'individual'"/>
                            <field name="work_date" required="entry_type == 'individual'"/>
                            <field name="attendance_mode" placeholder="Select Action..." required="entry_type == 'individual'"/>
                        </group>
                        <group string="Timestamps (Time Only)">
                            <field name="check_in_time" widget="float_time"
                                   readonly="attendance_mode == 'check_out'"
                                   invisible="not attendance_mode"
                                   required="entry_type == 'individual' and attendance_mode in ('both', 'check_in')"/>
                            <field name="check_out_time" widget="float_time"
                                   invisible="not attendance_mode or attendance_mode == 'check_in'"
                                   required="entry_type == 'individual' and attendance_mode in ('both', 'check_out')"
                                   placeholder="e.g. 17:00 or 18:00"/>
                        </group>
                    </group>



                    <!-- BATCH OPERATING UNIT MODE -->
                    <group invisible="entry_type != 'batch'">
                        <group string="Operating Unit &amp; Date Range">
                            <field name="operating_unit_id" readonly="1"/>
                            <field name="start_date" required="entry_type == 'batch'"/>
                            <field name="end_date" required="entry_type == 'batch'"/>
                            <field name="duration_days" readonly="1"/>
                        </group>
                        <group string="Shift Configuration &amp; Overwrite Options">
                            <field name="use_employee_shifts"/>
                            <field name="overwrite_existing"/>
                            <field name="check_in_time_only" widget="float_time" invisible="use_employee_shifts"/>
                            <field name="check_out_time_only" widget="float_time" invisible="use_employee_shifts"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert" invisible="entry_type != 'batch' or not overwrite_existing">
                        <i class="fa fa-exclamation-triangle me-2"/> <strong>Overwrite Warning:</strong> Enabling 'Overwrite Existing Attendances' will replace existing attendance records for the selected employees on these dates.
                    </div>

                    <group string="Select Employees Under Management" invisible="entry_type == 'individual'">
                        <field name="employee_ids" widget="many2many_tags" placeholder="Select 2 or more employees..."/>
                    </group>

                    <!-- FINACLE EOD REST MODE -->
                    <group invisible="entry_type != 'finacle_rest'">
                        <group string="Target Date &amp; Rest Type">
                            <field name="work_date" string="Target Rest Date" required="entry_type == 'finacle_rest'"/>
                            <field name="rest_type" required="entry_type == 'finacle_rest'"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert" invisible="entry_type != 'batch' or duration_days &lt;= 3">
                        <i class="fa fa-exclamation-triangle me-2"/> <strong>Coach Approval Required:</strong> Batch requests for more than 3 days (%s days) will be submitted to your Coach / Supervisor for formal approval before attendance records are generated.
                    </div>

                    <!-- REASON & JUSTIFICATION -->
                    <group string="Reason &amp; Justification">
                        <field name="attendance_reason_ids" widget="many2many_tags"/>
                        <field name="justification" placeholder="Mandatory explanation for manual attendance entry..." widget="text" required="1"/>
                    </group>

                    <footer>
                        <button string="Create / Submit Attendance" name="action_create_manual_attendance" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_hr_attendance_manual_wizard" model="ir.actions.act_window">
            <field name="name">Manual Attendance Entry</field>
            <field name="res_model">hr.attendance.manual.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
