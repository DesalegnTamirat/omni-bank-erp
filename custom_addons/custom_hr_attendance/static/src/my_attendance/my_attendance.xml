<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="custom_hr_attendance.MyAttendance">
    <div class="o_smart_attendance_wrapper p-3 p-md-5">
        <t t-if="!state.loading">
            <t t-if="state.hasEmployee">
                    <!-- TOP HEADER BAR -->
                <div class="o_smart_header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <div>
                        <h4 class="mb-1">
                            Welcome Back, <span t-esc="state.employeeName"/> 👋
                        </h4>
                            <!-- <div class="text-muted" style="font-weight: 500;">Smart Attendance
                            Dashboard</div> -->
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="o_live_clock_pill d-inline-flex align-items-center">
                            <i class="fa fa-clock-o fa-lg me-2"/>
                            <span class="time-text me-2" t-esc="state.currentClockTime"/>
                            <span class="date-text" t-esc="state.currentClockDate"/>
                        </div>
                            <!-- Settings Gear - Admin Only -->
                        <button t-if="state.isAdmin"
                                t-on-click="toggleSettings"
                                t-attf-class="btn o_settings_gear_btn {{ state.showSettings ? 'active' : '' }}"
                                title="Attendance Settings">
                            <i class="fa fa-cog fa-lg"/>
                        </button>
                    </div>
                </div>

                    <!-- MAIN DASHBOARD CONTENT -->
                <div class="row g-4 mt-2">
                        <!-- LEFT COLUMN: HERO ACTION CARD -->
                    <div class="col-12 col-lg-5 col-xl-5">
                        <div class="o_smart_hero_card premium-card p-4 p-xl-5 h-100">
                                <!-- AVATAR CONTAINER -->
                            <div class="o_smart_avatar_wrapper">
                                <img t-if="state.employeeAvatar"
                                     t-att-src="state.employeeAvatar"
                                     class="o_smart_avatar_img"
                                     alt="Employee photo"/>
                                <div t-else="" class="o_smart_avatar_placeholder d-flex align-items-center justify-content-center bg-light text-muted">
                                    <i class="fa fa-user fa-4x"/>
                                </div>

                                <span t-attf-class="o_status_indicator_dot {{ state.checkedIn ? 'bg-success' : 'bg-secondary' }}"
                                      t-att-title="state.checkedIn ? 'Checked In' : 'Checked Out'"/>
                            </div>

                            <h4 class="mb-1" t-esc="state.employeeName"/>
                            <p class="text-muted mb-3" t-esc="state.jobTitle"/>
                            <div t-if="state.departmentName" class="dept-badge mb-4">
                                <t t-esc="state.departmentName"/>
                            </div>

                                <!-- PRIMARY CHECK IN / OUT ACTION BUTTON -->
                            <div class="w-100 d-flex justify-content-center mt-2 mb-4">
                                <t t-if="state.shiftInfo &amp;&amp; state.shiftInfo.is_day_off &amp;&amp; !state.checkedIn">
                                    <button disabled="disabled"
                                            class="btn o_smart_action_btn w-50 d-flex align-items-center justify-content-center gap-2 opacity-75"
                                            style="background: #f1f5f9 !important; color: #64748b !important; border: 1px solid #cbd5e1 !important; cursor: not-allowed;"
                                            title="Today is your scheduled Day Off. Check-in is disabled.">
                                        <i class="fa fa-coffee fa-lg text-secondary"/>
                                        <span>SCHEDULED DAY OFF</span>
                                    </button>
                                </t>
                                <t t-else="">
                                    <button t-on-click="onClickToggle"
                                            t-att-disabled="state.inProgress"
                                            t-attf-class="btn o_smart_action_btn w-50 d-flex align-items-center justify-content-center gap-2 {{ state.checkedIn ? 'o_btn_checked_in' : 'o_btn_checked_out' }}">
                                        <i t-attf-class="fa {{ state.checkedIn ? 'fa-sign-out' : 'fa-sign-in' }} fa-lg"/>
                                        <span>
                                            <t t-if="state.checkedIn">CHECK OUT</t>
                                            <t t-else="">CHECK IN</t>
                                        </span>
                                    </button>
                                </t>
                            </div>

                                <!-- ASSIGNED WORK SHIFT HEADER CARD -->
                            <div t-if="state.shiftInfo" class="premium-card o_shift_info_card w-100 p-3 p-md-4 mb-4">
                                <t t-if="state.shiftInfo.is_day_off">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="o_shift_icon_box d-flex align-items-center justify-content-center" style="background: #ecfdf5; color: #047857; width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;">
                                            <i class="fa fa-coffee fa-lg"/>
                                        </div>
                                        <div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <h5 class="fw-bold mb-0 text-dark" t-esc="state.shiftInfo.name"/>
                                                <span class="badge rounded-pill px-2.5 py-1 small" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; font-weight: 600;">
                                                    🌴 Scheduled Rest Day
                                                </span>
                                            </div>
                                            <div class="text-muted small mt-1" style="font-weight: 500;">
                                                No mandatory work shift scheduled for today (<t t-esc="state.shiftInfo.source_label"/>)
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 pb-3 border-bottom" style="border-color: rgba(0,0,0,0.06) !important;">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="o_shift_icon_box d-flex align-items-center justify-content-center">
                                                <i class="fa fa-calendar-o fa-lg text-primary"/>
                                            </div>
                                            <div>
                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                    <h5 class="fw-bold mb-0 text-dark" t-esc="state.shiftInfo.name"/>
                                                    <span t-if="state.shiftInfo.is_custom_exception" class="badge rounded-pill px-2.5 py-1 small" style="background: #e0e7ff; color: #4338ca; border: 1px solid #c7d2fe; font-weight: 600;">
                                                        <i class="fa fa-star me-1"/> Active Exception
                                                    </span>
                                                    <span t-else="" class="badge rounded-pill px-2.5 py-1 small" style="background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; font-weight: 600;">
                                                        <i class="fa fa-globe me-1"/> Default Global Shift
                                                    </span>
                                                </div>
                                                <div class="text-muted small mt-1" style="font-weight: 500;">
                                                    Schedule Window: <span class="fw-semibold text-dark" t-esc="state.shiftInfo.time_range"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div t-if="state.shiftInfo.is_night_shift" class="badge bg-dark text-warning px-3 py-2 rounded-pill d-inline-flex align-items-center gap-1">
                                            <i class="fa fa-moon-o"/> Night Shift
                                        </div>
                                    </div>

                                        <!-- SHIFT TIMINGS & LUNCH BREAK PILLS -->
                                    <div class="row g-3 mt-2">
                                        <div class="col-12 col-sm-4">
                                            <div class="shift-pill p-3 rounded-3 text-center" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                                <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.725rem; letter-spacing: 0.5px;">
                                                    <i class="fa fa-sign-in text-success me-1"/> Shift Start
                                                </div>
                                                <div class="fw-bold text-dark" style="font-size: 1.1rem;" t-esc="state.shiftInfo.start_time_str"/>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-4">
                                            <div class="shift-pill p-3 rounded-3 text-center" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                                <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.725rem; letter-spacing: 0.5px;">
                                                    <i class="fa fa-sign-out text-danger me-1"/> Shift End
                                                </div>
                                                <div class="fw-bold text-dark" style="font-size: 1.1rem;" t-esc="state.shiftInfo.end_time_str"/>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-4">
                                            <div class="shift-pill p-3 rounded-3 text-center" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                                <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.725rem; letter-spacing: 0.5px;">
                                                    <i class="fa fa-cutlery text-warning me-1"/> Lunch Break
                                                </div>
                                                <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;" t-esc="state.shiftInfo.lunch_time_str" t-att-title="state.shiftInfo.lunch_time_str"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end mt-3 pt-2 border-top" style="border-color: rgba(0,0,0,0.06) !important;">
                                        <button class="btn btn-sm btn-link text-primary text-decoration-none fw-bold p-0" t-on-click="onOpenMySchedule">
                                            <i class="fa fa-calendar me-1"/> View Full Schedule <i class="fa fa-arrow-right ms-1 small"/>
                                        </button>
                                    </div>
                                </t>
                            </div>

                                <!-- LIVE WORKED TIMER BADGE -->
                            <div class="w-100 mt-auto">
                                <t t-if="state.checkedIn">
                                    <div class="o_timer_box active-timer p-4 text-center">
                                        <div class="timer-title small fw-bold mb-2">
                                            <i class="fa fa-circle me-1 pulse-dot"/> ACTIVE SESSION TIME
                                        </div>
                                        <div class="h2 mb-1" t-esc="state.liveWorkedTimer"/>
                                        <div t-if="state.checkInTimeStr" class="text-muted small mt-2" style="font-weight: 500;">
                                            Checked in at <span class="text-dark fw-bold" t-esc="state.checkInTimeStr"/>
                                            <span t-if="state.checkInStatus"
                                                  t-attf-class="badge rounded-pill ms-2 {{ state.checkInStatus === 'Late' ? 'bg-warning text-dark' : 'bg-success text-white' }}"
                                                  t-esc="state.checkInStatus"/>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="o_timer_box p-4 text-center">
                                        <div class="text-muted small fw-bold mb-2 text-uppercase">
                                            <i class="fa fa-history me-1"/> Total Worked Today
                                        </div>
                                        <div class="h2 mb-1" t-esc="state.hoursToday"/>
                                        <div class="text-muted small mt-2" style="font-weight: 500;">Ready to start your day</div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                        <!-- RIGHT COLUMN: METRICS & DAILY BREAKDOWN -->
                    <div class="col-12 col-lg-7 col-xl-7">


                            <!-- STAT CARDS ROW -->
                        <div class="row g-4 mb-4">
                            <div class="col-12 col-md-4">
                                <div class="premium-card o_stat_card h-100">
                                    <div class="o_stat_icon icon-daily">
                                        <i class="fa fa-clock-o fa-2x"/>
                                    </div>
                                    <div>
                                        <div class="stat-label">TODAY'S WORKED HOURS</div>
                                        <div class="stat-value">
                                            <t t-esc="state.todayTotalFormatted"/>
                                        </div>
                                        <div class="stat-sub">
                                            <t t-if="state.checkedIn">Completed + live session</t>
                                            <t t-else="">Recorded today</t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="premium-card o_stat_card h-100">
                                    <div class="o_stat_icon icon-weekly">
                                        <i class="fa fa-calendar-check-o fa-2x"/>
                                    </div>
                                    <div>
                                        <div class="stat-label">THIS WEEK'S TOTAL</div>
                                        <div class="stat-value" t-esc="state.weeklyHoursFormatted"/>
                                        <div class="stat-sub">Mon - Sun accumulation</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="premium-card o_stat_card h-100">
                                    <div class="o_stat_icon icon-monthly">
                                        <i class="fa fa-calendar fa-2x"/>
                                    </div>
                                    <div>
                                        <div class="stat-label">THIS MONTH'S TOTAL</div>
                                        <div class="stat-value" t-esc="state.monthlyHoursFormatted"/>
                                        <div class="stat-sub">Monthly accumulation</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                            <!-- DAILY ATTENDANCE BREAKDOWN CHART CARD -->
                        <div class="premium-card p-4 p-xl-5">
                            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom" style="border-color: rgba(0,0,0,0.05) !important;">
                                <h5 class="fw-bold mb-0" style="color: #0f172a; font-size: 1.15rem;">
                                    <i class="fa fa-bar-chart text-primary me-2"/> Weekly Attendance Breakdown
                                </h5>
                                <span class="badge rounded-pill px-3 py-2" style="background: #f1f5f9; color: #334155; font-weight: 600; border: 1px solid #e2e8f0;">
                                    Weekly Total: <t t-esc="state.weeklyHoursFormatted"/>
                                </span>
                            </div>

                            <div class="o_daily_breakdown_list">
                                <t t-foreach="state.dailyBreakdown" t-as="day" t-key="day.day_name">
                                    <div t-attf-class="o_daily_row d-flex align-items-center gap-3 {{ day.is_today ? 'is-today' : '' }}">
                                            <!-- DAY & DATE -->
                                        <div style="width: 80px;">
                                            <div class="day-name" t-esc="day.day_name"/>
                                            <div class="day-date" t-esc="day.date_str"/>
                                        </div>

                                            <!-- PROGRESS BAR -->
                                        <div class="flex-grow-1">
                                            <div class="progress">
                                                <div t-attf-class="progress-bar {{ day.is_today ? 'bar-today' : (day.hours > 0 ? 'bar-past' : 'bar-empty') }}"
                                                     role="progressbar"
                                                     t-att-style="'width: ' + day.percentage + '%;'"
                                                     t-att-aria-valuenow="day.percentage"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100"/>
                                            </div>
                                        </div>

                                            <!-- HOURS VALUE -->
                                        <div style="width: 100px;" class="text-end hours-val">
                                            <t t-if="day.is_day_off &amp;&amp; day.hours == 0">
                                                <span class="badge rounded-pill px-2.5 py-1" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; font-size: 0.725rem; font-weight: 600;">
                                                    🌴 DAY OFF
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="day.hours_formatted"/>
                                            </t>
                                        </div>

                                            <!-- TODAY BADGE -->
                                        <div style="width: 80px;" class="text-end">
                                            <span t-if="day.is_today &amp;&amp; day.checkedIn" class="onduty-badge">On Duty</span>
                                            <span t-elif="day.is_today" class="today-badge">Today</span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="premium-card p-5 text-center mt-5 mx-auto" style="max-width: 500px;">
                    <i class="fa fa-exclamation-triangle fa-3x text-warning mb-3 d-block"/>
                    <h4 class="fw-bold text-dark mb-2">No Employee Record Found</h4>
                    <p class="text-muted">No employee record is linked to your user account. Please contact your system administrator.</p>
                </div>
            </t>
        </t>
        <t t-else="">
            <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
                <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"/>
                <div class="text-muted fw-bold fs-5">Loading Dashboard...</div>
            </div>
        </t>
            <!-- SETTINGS SLIDE-IN PANEL (Admin Only) -->
        <t t-if="state.showSettings and state.isAdmin">
            <div class="o_settings_overlay" t-on-click="toggleSettings"/>
            <div class="o_settings_panel premium-card">
                <div class="o_settings_panel_header d-flex align-items-center justify-content-between mb-4">
                    <h5 class="fw-bold mb-0" style="color: #0f172a;">
                        <i class="fa fa-cog me-2" style="color: #c17540;"/> Attendance Settings
                    </h5>
                    <button class="btn btn-sm" t-on-click="toggleSettings" style="color: #94a3b8;">
                        <i class="fa fa-times fa-lg"/>
                    </button>
                </div>

                    <!-- FEATURE TOGGLES -->
                <div class="settings-section mb-4">
                    <div class="settings-section-title">Feature Toggles</div>
                    <div class="settings-toggle-row">
                        <div class="settings-toggle-label">Check-In Time Restriction</div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="s_checkin_restrict"
                                   t-att-checked="state.settings.enable_checkin_restriction"
                                   t-on-change="onToggleCheckinRestrict"/>
                        </div>
                    </div>
                    <div class="settings-toggle-row">
                        <div class="settings-toggle-label">Check-Out Time Restriction</div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="s_checkout_restrict"
                                   t-att-checked="state.settings.enable_checkout_restriction"
                                   t-on-change="onToggleCheckoutRestrict"/>
                        </div>
                    </div>
                    <div class="settings-toggle-row">
                        <div class="settings-toggle-label">Saturday Half-Day (Head Office)</div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="s_saturday"
                                   t-att-checked="state.settings.enable_saturday_halfday"
                                   t-on-change="onToggleSaturdayHalfday"/>
                        </div>
                    </div>
                    <div class="settings-toggle-row" t-if="state.settings.enable_saturday_halfday">
                        <div class="settings-toggle-label">Saturday Half-Day (District Offices)</div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="s_saturday_district"
                                   t-att-checked="state.settings.saturday_halfday_district"
                                   t-on-change="onToggleSaturdayDistrict"/>
                        </div>
                    </div>
                    <div class="settings-toggle-row">
                        <div class="settings-toggle-label">Lunch Break Flow</div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="s_lunch"
                                   t-att-checked="state.settings.enable_lunch_break"
                                   t-on-change="onToggleLunchBreak"/>
                        </div>
                    </div>
                    <div class="settings-toggle-row">
                        <div class="settings-toggle-label">Auto Absence Detection</div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="s_absence"
                                   t-att-checked="state.settings.enable_auto_absence"
                                   t-on-change="onToggleAutoAbsence"/>
                        </div>
                    </div>
                    <div class="settings-toggle-row">
                        <div class="settings-toggle-label">ERP Access Gate</div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="s_gate"
                                   t-att-checked="state.settings.enable_checkin_gate"
                                   t-on-change="onToggleCheckinGate"/>
                        </div>
                    </div>
                </div>

                    <!-- TIME PARAMETERS -->
                <div class="settings-section mb-4">
                    <div class="settings-section-title">Shift Time Parameters</div>
                    <div class="settings-input-row">
                        <label class="settings-input-label">Morning Start</label>
                        <input type="time" class="settings-input"
                               t-att-value="state.settings.morning_time_str"
                               t-on-input="onInputMorningTime"/>
                    </div>
                    <div class="settings-input-row">
                        <label class="settings-input-label">Exit Time</label>
                        <input type="time" class="settings-input"
                               t-att-value="state.settings.exit_time_str"
                               t-on-input="onInputExitTime"/>
                    </div>
                    <div class="settings-input-row">
                        <label class="settings-input-label">Dead Time / Grace</label>
                        <input type="text" class="settings-input" placeholder="HH:MM"
                               t-att-value="state.settings.dead_time_str"
                               t-on-input="onInputDeadTime"/>
                    </div>
                    <div class="settings-input-row">
                        <label class="settings-input-label">Check-In Buffer</label>
                        <input type="text" class="settings-input" placeholder="HH:MM"
                               t-att-value="state.settings.checkin_buffer_str"
                               t-on-input="onInputCheckinBuffer"/>
                    </div>
                    <div class="settings-input-row">
                        <label class="settings-input-label">Post-Shift Grace</label>
                        <input type="text" class="settings-input" placeholder="HH:MM"
                               t-att-value="state.settings.post_shift_grace_hours_str"
                               t-on-input="onInputPostShiftGraceHours"/>
                    </div>
                    <div class="settings-input-row">
                        <label class="settings-input-label">Saturday Exit</label>
                        <input type="time" class="settings-input"
                               t-att-value="state.settings.saturday_exit_time_str"
                               t-on-input="onInputSaturdayExitTime"/>
                    </div>
                </div>

                    <!-- LUNCH BREAK PARAMETERS (CONDITIONAL) -->
                <div t-if="state.settings.enable_lunch_break" class="settings-section mb-4">
                    <div class="settings-section-title">Lunch Break Parameters</div>
                    <div class="settings-input-row">
                        <label class="settings-input-label">Lunch Start</label>
                        <input type="time" class="settings-input"
                               t-att-value="state.settings.lunch_out_time_str"
                               t-on-input="onInputLunchOutTime"/>
                    </div>
                    <div class="settings-input-row">
                        <label class="settings-input-label">Lunch Duration</label>
                        <input type="text" class="settings-input" placeholder="HH:MM"
                               t-att-value="state.settings.lunch_duration_str"
                               t-on-input="onInputLunchDuration"/>
                    </div>
                    <div class="settings-input-row">
                        <label class="settings-input-label">Lunch Grace</label>
                        <input type="text" class="settings-input" placeholder="HH:MM"
                               t-att-value="state.settings.lunch_grace_time_str"
                               t-on-input="onInputLunchGraceTime"/>
                    </div>
                </div>



                    <!-- SAVE BUTTON -->
                <button class="btn w-100 o_settings_save_btn"
                        t-att-disabled="state.settingsSaving"
                        t-on-click="saveSettings">
                    <i t-attf-class="fa {{ state.settingsSaving ? 'fa-circle-o-notch fa-spin' : 'fa-save' }} me-2"/>
                    <t t-if="state.settingsSaving">Saving...</t>
                    <t t-else="">Save Settings</t>
                </button>
            </div>
        </t>
    </div>
</t>

</templates>