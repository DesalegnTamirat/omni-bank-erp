<odoo>
        <!-- Tree View -->
    <record id="location_based_exception_view_tree" model="ir.ui.view">
        <field name="name">Location Based Exception List</field>
        <field name="model">location.based.exception</field>
        <field name="arch" type="xml">
            <list string="Location Based Exception" edit="0">
                <field name="schedule_name"/>
                <field name="operating_unit"/>
                <field name="start_time"/>
                <field name="end_time" />
                <field name="duration"/>
                <field name="time_range"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="location_based_exception_view_form" model="ir.ui.view">
        <field name="name">Location Based Exception Form</field>
        <field name="model">location.based.exception</field>
        <field name="arch" type="xml">
            <form string="Location Based Exception">
                <sheet>
                    <group>
                        <group>
                            <field name="schedule_name"/>
                            <field name="operating_unit"/>
                        </group>
                        <group>
                            <field name="start_time"  />
                            <field name="end_time"/>
                            <field name="duration"/>
                            <field name="time_range"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
     <!-- Action -->
    <record id="action_location_based_exception" model="ir.actions.act_window">
        <field name="name">Location Based Exception</field>
        <field name="res_model">location.based.exception</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
