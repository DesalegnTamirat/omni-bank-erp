<odoo>
        <!-- Tree View -->
    <record id="location_based_exception_view_tree" model="ir.ui.view">
        <field name="name">Location Based Exception List</field>
        <field name="model">location.based.exception</field>
        <field name="arch" type="xml">
            <list string="Location Based Exception" edit="0">
                <field name="schedule_name"/>
                <field name="operating_unit_ids" widget="many2many_tags" string="Locations"/>
                <field name="shift_id"/>
                <field name="start_date"/>
                <field name="end_date" placeholder="Indefinite"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time"  widget="float_time"/>
                <field name="time_range"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="location_based_exception_view_form" model="ir.ui.view">
        <field name="name">Location Based Exception Form</field>
        <field name="model">location.based.exception</field>
        <field name="arch" type="xml">
            <form string="Location Based Exception">
                <header>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state != 'cancelled'"/>
                    <button name="action_cancel" string="Cancel / Deactivate" type="object" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <group>
                        <group string="Location &amp; Shift">
                            <field name="schedule_name"/>
                            <field name="district_id" options="{'no_create': True}" placeholder="Filter locations by district (Optional)"/>
                            <field name="operating_unit_ids" widget="many2many_tags" string="Locations / Operating Units" required="1" options="{'no_create': True}" domain="[('parent_unit', '=', district_id)] if district_id else []"/>
                            <field name="allowed_shift_ids" invisible="1"/>
                            <field name="shift_id" domain="[('id', 'in', allowed_shift_ids)]" required="1"/>
                        </group>
                        <group string="Validity Boundaries">
                            <field name="start_date"/>
                            <field name="end_date" placeholder="Indefinite if left blank"/>
                        </group>
                        <group string="Timing Overview">
                            <field name="start_time" widget="float_time" readonly="1"/>
                            <field name="end_time" widget="float_time" readonly="1"/>
                            <field name="duration" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="location_based_exception_view_search" model="ir.ui.view">
        <field name="name">location.based.exception.search</field>
        <field name="model">location.based.exception</field>
        <field name="arch" type="xml">
            <search string="Search Location Based Exception">
                <field name="schedule_name"/>
                <field name="shift_id"/>
                <filter string="Active Exceptions" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Draft Exceptions" name="draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter string="District" name="group_district" context="{'group_by': 'district_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Shift Template" name="group_shift" context="{'group_by': 'shift_id'}"/>
            </search>
        </field>
    </record>

     <!-- Action -->
    <record id="action_location_based_exception" model="ir.actions.act_window">
        <field name="name">Location Based Exception</field>
        <field name="res_model">location.based.exception</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="location_based_exception_view_search"/>
    </record>

</odoo>
