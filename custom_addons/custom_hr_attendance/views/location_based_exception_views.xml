<odoo>
        <!-- Tree View -->
    <record id="location_based_exception_view_tree" model="ir.ui.view">
        <field name="name">Location Based Exception List</field>
        <field name="model">location.based.exception</field>
        <field name="arch" type="xml">
            <list string="Location Based Exception" edit="0">
                <field name="schedule_name"/>
                <field name="operating_unit_ids" widget="many2many_tags" string="Locations"/>
                <field name="shift_id"/>
                <field name="start_date"/>
                <field name="end_date" placeholder="Indefinite"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time"  widget="float_time"/>
                <field name="time_range"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="location_based_exception_view_form" model="ir.ui.view">
        <field name="name">Location Based Exception Form</field>
        <field name="model">location.based.exception</field>
        <field name="arch" type="xml">
            <form string="Location Based Exception">
                <sheet>
                    <group>
                        <group string="Location &amp; Shift">
                            <field name="schedule_name"/>
                            <field name="district_id" options="{'no_create': True}" placeholder="Filter locations by district (Optional)"/>
                            <field name="operating_unit_ids" widget="many2many_tags" string="Locations / Operating Units" required="1" options="{'no_create': True}" domain="[('parent_unit', '=', district_id)] if district_id else []"/>
                            <field name="allowed_shift_ids" invisible="1"/>
                            <field name="shift_id" domain="[('id', 'in', allowed_shift_ids)]"/>
                        </group>
                        <group string="Validity Boundaries">
                            <field name="start_date"/>
                            <field name="end_date" placeholder="Indefinite if left blank"/>
                        </group>
                        <group string="Timing Overview">
                            <field name="start_time" widget="float_time" readonly="1"/>
                            <field name="end_time" widget="float_time" readonly="1"/>
                            <field name="duration" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
     <!-- Action -->
    <record id="action_location_based_exception" model="ir.actions.act_window">
        <field name="name">Location Based Exception</field>
        <field name="res_model">location.based.exception</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
