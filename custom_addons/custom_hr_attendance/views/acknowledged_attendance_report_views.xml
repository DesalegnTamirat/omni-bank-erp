<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--  List View -->
    <record id="view_acknowledged_attendance_report_tree" model="ir.ui.view">
        <field name="name">acknowledged.attendance.report.tree</field>
        <field name="model">acknowledged.attendance.report</field>
        <field name="arch" type="xml">
            <list string="Acknowledged Attendance" decoration-warning="reason_type == 'check_in'" decoration-info="reason_type == 'check_out'">
                <field name="employee_identification" string="ID"/>
                <field name="employee_name" string="Employee"/>
                <field name="place_of_assignment" string="Branch / Unit"/>
                <field name="check_in" string="Check-In"/>
                <field name="check_out" string="Check-Out"/>
                <field name="reason_type" string="Type" widget="badge"
                       decoration-warning="reason_type == 'check_in'"
                       decoration-info="reason_type == 'check_out'"/>
                <field name="reason_name" string="Reason"/>
                <field name="acknowledged_by" string="Acknowledged By"/>
                <field name="acknowledged_date" string="Acknowledged On"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_acknowledged_attendance_report_search" model="ir.ui.view">
        <field name="name">acknowledged.attendance.report.search</field>
        <field name="model">acknowledged.attendance.report</field>
        <field name="arch" type="xml">
            <search string="Search Acknowledged Attendance">
                <field name="employee_name" string="Employee"/>
                <field name="employee_identification" string="Employee ID"/>
                <field name="place_of_assignment" string="Branch / Unit"/>
                <field name="reason_type" string="Type"/>
                <field name="acknowledged_by" string="Acknowledged By"/>

                <filter string="Check-In Acknowledged"
                        name="filter_check_in"
                        domain="[('reason_type','=','check_in')]"/>

                <filter string="Check-Out Acknowledged"
                        name="filter_check_out"
                        domain="[('reason_type','=','check_out')]"/>

                <filter string="Acknowledged Today"
                        name="filter_today"
                        domain="[('acknowledged_date','&gt;=',context_today())]"/>

                <separator/>
                <filter string="Employee"
                        name="group_by_employee"
                        context="{'group_by':'employee_name'}"/>

                <filter string="Branch / Unit"
                        name="group_by_place"
                        context="{'group_by':'place_of_assignment'}"/>

                <filter string="Acknowledged By"
                        name="group_by_acknowledged_by"
                        context="{'group_by':'acknowledged_by'}"/>

                <filter string="Date"
                        name="group_by_acknowledged_date"
                        context="{'group_by':'acknowledged_date:day'}"/>

            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_acknowledged_attendance_report" model="ir.actions.act_window">
        <field name="name">Acknowledged Attendance</field>
        <field name="res_model">acknowledged.attendance.report</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No acknowledged attendance records found.
            </p>
            <p>
                Managers can acknowledge late check-ins or early check-outs from the Attendance Dashboard.
            </p>
        </field>
    </record>

</odoo>
