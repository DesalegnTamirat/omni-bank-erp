<odoo>
    <record id="view_my_shift_schedule_tree" model="ir.ui.view">
        <field name="name">my.shift.schedule.list</field>
        <field name="model">my.shift.schedule</field>
        <field name="arch" type="xml">
            <list string="My Current Shift Schedule" create="0" delete="0" edit="0">
                <field name="schedule_name"/>
                <field name="employee_id"/>
                <field name="job_position"/>
                <field name="operating_unit_id"/>
                <field name="start_date"/>
                <field name="end_date" placeholder="Indefinite"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="time_range"/>
            </list>
        </field>
    </record>

    <record id="view_my_shift_schedule_form" model="ir.ui.view">
        <field name="name">my.shift.schedule.form</field>
        <field name="model">my.shift.schedule</field>
        <field name="arch" type="xml">
            <form string="My Current Shift Schedule" edit="0" create="0" delete="0">
                <sheet>
                    <div class="oe_title mb-3">
                        <label for="schedule_name" string="Active Shift Schedule"/>
                        <h1><field name="schedule_name" readonly="1" class="text-primary"/></h1>
                        <field name="assignment_source" widget="badge" readonly="1"
                               decoration-danger="assignment_source == 'leave'"
                               decoration-info="assignment_source == 'location'"
                               decoration-warning="assignment_source == 'job_position'"
                               decoration-success="assignment_source == 'roster'"
                               decoration-primary="assignment_source == 'default'"/>
                    </div>

                    <group>
                        <group string="Employee &amp; Location Info">
                            <field name="employee_id" readonly="1"/>
                            <field name="job_position" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="operating_unit_id" readonly="1"/>
                        </group>
                        <group string="Shift Validity &amp; Dates">
                            <field name="start_date" readonly="1"/>
                            <field name="end_date" placeholder="Indefinite / Permanent Shift" readonly="1"/>
                        </group>
                        <group string="Timing Overview">
                            <field name="start_time" widget="float_time" readonly="1"/>
                            <field name="end_time" widget="float_time" readonly="1"/>
                            <field name="duration" readonly="1"/>
                            <field name="time_range" readonly="1"/>
                        </group>
                        <group string="Lunch Break Overview">
                            <field name="has_lunch_break" readonly="1"/>
                            <field name="lunch_start_time" widget="float_time" invisible="not has_lunch_break" readonly="1"/>
                            <field name="lunch_duration" invisible="not has_lunch_break" readonly="1"/>
                            <field name="lunch_time_range" readonly="1"/>
                        </group>
                    </group>

                    <notebook invisible="assignment_source != 'roster'">
                        <page string="Weekly Roster Schedule" name="roster_schedule">
                            <field name="roster_line_ids" readonly="1">
                                <list string="Weekly Roster" decoration-info="is_today" decoration-muted="schedule_type == 'day_off'">
                                    <field name="is_today" column_invisible="1"/>
                                    <field name="date"/>
                                    <field name="day_name"/>
                                    <field name="schedule_type" widget="badge" decoration-success="schedule_type == 'shift'" decoration-warning="schedule_type == 'day_off'"/>
                                    <field name="shift_id"/>
                                    <field name="time_range"/>
                                    <field name="duration"/>
                                    <field name="lunch_time_range"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_my_shift_schedule_resolved" model="ir.actions.server">
        <field name="name">My Shift Schedule</field>
        <field name="model_id" ref="model_my_shift_schedule"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_open_my_shift()
        </field>
    </record>
</odoo>
