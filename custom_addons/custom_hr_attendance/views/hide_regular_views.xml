<odoo>

    <!-- Disable menus -->
    <record id="hr_attendance.menu_hr_attendance_settings" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Stock Configuration root: fully deactivated. custom_hr_attendance provides
         its own replacement (menu_bunna_attendance_configuration in menu_views.xml)
         covering Settings, Reasons, Job Shift, Job Position Exception,
         Location Based Exception and Over Time. Without this, both roots show up
         as two separate "Configuration" tabs in the top bar. -->
    <record id="hr_attendance.menu_hr_attendance_configuration" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- ── Menus appearing as rogue top-level app icons ── -->

    <!-- Kiosk Mode is now safely re-parented under hr_attendance.menu_hr_attendance_root
         in menu_views.xml at sequence 2. The earlier hijacking issue was caused by
         Kiosk Mode being the LOWEST-sequence child of the root (so the app icon's
         default action fell through to it). Now that Check In / Check Out exists at
         sequence 1, it is the true default entry action, so Kiosk Mode is safe to
         re-enable. -->

    <!-- Overview: already group_no_one but still shows as an app icon – fully deactivate. -->
    <record id="hr_attendance.menu_hr_attendance_overview" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>

