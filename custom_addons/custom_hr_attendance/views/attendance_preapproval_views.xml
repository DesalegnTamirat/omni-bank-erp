<odoo>
    <!-- Tree View -->
    <record id="attendance_preapproval_tree" model="ir.ui.view">
        <field name="model">attendance.preapproval</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="exception_type"/>
                <field name="date"/>
                <field name="time_range"/>
                <field name="state"/>
                <field name="approved_by"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="attendance_preapproval_form" model="ir.ui.view">
        <field name="model">attendance.preapproval</field>
        <field name="arch" type="xml">
            <form string="Predefined Attendance">
                <field name="is_manager_or_admin" invisible="1"/>
                <field name="state" invisible="1"/>
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_approve" string="Approve" type="object"
                            invisible="state != 'requested' or not is_manager_or_admin"
                            class="oe_highlight"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'requested' or not is_manager_or_admin" 
                            class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="employee_id" options="{'no_open': True, 'no_create': True}" readonly="state != 'draft' or not is_manager_or_admin"/>
                        <field name="exception_type" readonly="state != 'draft'"/>
                        <field name="approval_reason" readonly="state != 'draft'"/>
                        <field name="date" readonly="state != 'draft'"/>
                        <field name="start_time" widget="float_time" readonly="state != 'draft'"/>
                        <field name="end_time" widget="float_time" readonly="state != 'draft'"/>
                        <field name="time_range" readonly="1"/>
                        <field name="approved_by" options="{'no_open': True}" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action: My Predefined Attendance -->
    <record id="action_preapproval_my" model="ir.actions.act_window">
        <field name="name">My Predefined Attendance</field>
        <field name="res_model">attendance.preapproval</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id','=',uid)]</field>
    </record>

    <!-- Action: Approve Predefined Attendance -->
    <record id="action_preapproval_approve" model="ir.actions.act_window">
        <field name="name">Approve Predefined Attendance</field>
        <field name="res_model">attendance.preapproval</field>
        <field name="view_mode">list,form</field>
<!--        <field name="domain">[('state','in',('requested','approved','rejected'))]</field>-->
        <field name="domain">
            [('state','in',('requested','approved','rejected')),
            ('employee_id.coach_id.user_id','=',uid)]
        </field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
