<odoo>

    <record id="job_position_exception_view_tree" model="ir.ui.view">
        <field name="name">Job Position Exception List</field>
        <field name="model">job.position.exception</field>
        <field name="arch" type="xml">
            <list string="Job Position Exception" edit="0">
                <field name="employee_id"/>
                <field name="job_position"/>
                <field name="shift_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="time_range"/>
                <field name="day_off"/>
            </list>
        </field>
    </record>
    <record id="job_position_exception_view_form" model="ir.ui.view">
        <field name="name">Job Position Exception Form</field>
        <field name="model">job.position.exception</field>
        <field name="arch" type="xml">
            <form string="Job Position Exception">
                <field name="can_end_shift" invisible="1"/>
                <header>
                    <button name="notify"
                            type="object"
                            string="Notify"
                            class="oe_highlight"
                            invisible="notify_status == 'notified'"/>
                    <button name="action_end_shift"
                            type="object"
                            string="End Shift"
                            class="btn-danger"
                            confirm="Are you sure you want to end and archive this shift exception? The employee schedule will revert to default."
                            invisible="not can_end_shift"/>
                </header>

                <sheet>
                    <group>
                        <group string="Employee &amp; Shift Selection">
                            <field name="employee_id" readonly="id != False"/>
                            <field name="job_position"/>
                            <field name="allowed_shift_ids" invisible="1"/>
                            <field name="shift_id" domain="[('id', 'in', allowed_shift_ids)]"/>
                        </group>
                        <group string="Validity Boundaries">
                            <field name="start_date"/>
                            <field name="end_date" placeholder="Leave blank to hold indefinitely"/>
                            <field name="day_off"/>
                            <field name="notify_status" invisible="1"/>
                        </group>
                        <group string="Timing Overview">
                            <field name="start_time" widget="float_time" readonly="1"/>
                            <field name="end_time" widget="float_time" readonly="1"/>
                            <field name="duration" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <!-- <chatter/> -->
            </form>
        </field>
    </record>
    <!-- Define the action for Job Position -->
    <record id="action_job_position_exception" model="ir.actions.act_window">
        <field name="name">Job Position Exception</field>
        <field name="res_model">job.position.exception</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
