<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily Employee Attendance Detail List View -->
    <record id="view_daily_employee_attendance_detail_tree" model="ir.ui.view">
        <field name="name">daily.employee.attendance.detail.tree</field>
        <field name="model">daily.employee.attendance.detail</field>
        <field name="arch" type="xml">
            <list string="Daily Employee Attendance Report" editable="bottom" create="0" edit="0" delete="0">
                <field name="employee_id" column_invisible="1"/>
                <field name="employee_identification" string="Employee ID"/>
                <field name="employee_name" string="Employee Name"/>
                <field name="place_of_assignment" string="Place of Assignment"/>
                <field name="work_unit" string="Work Unit"/>
                <field name="job_title" string="Job Title"/>
                <field name="job_grade" string="Grade" optional="hide"/>
                <field name="manager_name" string="Manager Name" optional="hide"/>
                <field name="attendance_month" string="Attendance Month" optional="hide"/>
                <field name="checkin_date" string="Checkin Date"/>
                <field name="checkin_time" string="Checkin Time"/>
                <field name="checkout_time" string="Checkout Time"/>
                <field name="remarks" string="Remarks"/>
                <field name="worked_hours" string="Worked Hours" widget="float_time"/>
                <field name="payable_hours" string="Payable Hours" widget="float_time"/>
                <field name="late_time_hour" string="Late Time (Hours)" widget="float_time"/>
                <field name="early_exit_hour" string="Early Exit (Hours)" widget="float_time"/>
                <field name="over_time_hour" string="Overtime (Hours)" column_invisible="1"/>
                <field name="pre_defined" string="Pre-Defined Lateness" widget="float_time"/>
                <field name="acknowledged_lateness" string="Acknowledged Lateness" widget="float_time"/>
                <field name="pre_approved_early_checkout" string="Pre-Approved Early Checkout" widget="float_time"/>
                <field name="acknowledged_early_checkout" string="Acknowledged Early Checkout" widget="float_time"/>
                <field name="force_checkout" string="Force Checkout"/>
            </list>
        </field>
    </record>

    <!-- Daily Employee Attendance Detail Search View -->
    <record id="view_daily_employee_attendance_detail_search" model="ir.ui.view">
        <field name="name">daily.employee.attendance.detail.search</field>
        <field name="model">daily.employee.attendance.detail</field>
        <field name="arch" type="xml">
            <search string="Search Daily Attendance Detail">
                <field name="employee_identification"/>
                <field name="employee_name"/>
                <field name="work_unit"/>
                <field name="manager_name"/>
                <field name="checkin_date"/>
                <separator/>
                <filter string="Work Unit" name="group_by_work_unit" context="{'group_by':'work_unit'}"/>
                <filter string="Checkin Date" name="group_by_date" context="{'group_by':'checkin_date'}"/>
                <filter string="Manager" name="group_by_manager" context="{'group_by':'manager_name'}"/>
                <filter string="Remarks" name="group_by_remarks" context="{'group_by':'remarks'}"/>
            </search>
        </field>
    </record>

    <!-- Daily Employee Attendance Detail Window Action -->
    <record id="action_daily_employee_attendance_detail" model="ir.actions.act_window">
        <field name="name">Daily Employee Attendance Report</field>
        <field name="res_model">daily.employee.attendance.detail</field>
        <field name="view_mode">list,search</field>
        <field name="view_id" ref="view_daily_employee_attendance_detail_tree"/>
        <field name="search_view_id" ref="view_daily_employee_attendance_detail_search"/>
        <field name="domain">[('create_uid', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No daily attendance detail found for the current user.
            </p>
            <p>
                Use the "Generate Employee Attendance Report Wizard" under Manager menu to populate daily records for your subordinates.
            </p>
        </field>
    </record>
</odoo>
