<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    HR ATTENDANCE FORM VIEW -->
    <record id="hr_attendance_view_inherit_form" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="priority">500</field>
        <field name="arch" type="xml">
            <!-- Header buttons for Flag for Discipline and Approve Overtime for Payroll -->
            <sheet position="before">
                <header>
                    <button name="action_flag_for_discipline" string="Flag for Discipline" type="object" class="btn-warning"
                            invisible="flagged_for_discipline"
                            help="Flag this attendance record for HR discipline review."/>
                    <button name="action_approve_overtime_for_payroll" string="Approve Overtime for Payroll" type="object" class="btn-success"
                            invisible="over_time_hour &lt;= 0 or overtime_approved_for_payroll"
                            groups="hr_attendance.group_hr_attendance_manager"
                            help="Approve overtime and transmit payload to payroll."/>
                </header>
            </sheet>

            <!-- Smart button box for Discipline Cases -->
            <sheet position="inside">
                <div class="oe_button_box" name="button_box">
                    <button type="object" class="oe_stat_button" icon="fa-gavel"
                            invisible="discipline_case_count == 0">
                        <field name="discipline_case_count" widget="statinfo" string="Discipline Cases"/>
                    </button>
                </div>
            </sheet>

            <!-- Attendance Reason -->
            <sheet position="inside">
                <group name="reason">
                    <group>
                        <field name="attendance_reason_ids" widget="many2many_tags"/>
                        <field name="reason_type" readonly="1"/>
                        <field name="flagged_for_discipline" readonly="1"/>
                        <field name="flagged_reason" readonly="1" invisible="not flagged_for_discipline"/>
                        <field name="overtime_approved_for_payroll" readonly="1"/>
                    </group>
                </group>
            </sheet>

            <!-- Check-in related fields -->
            <xpath expr="//field[@name='check_in']" position="after">
                <field name="check_in_status" readonly="1"/>
		        <field name="late_time_hour" readonly="1" widget="float_time"/>
		        <field name="acknowledged_late" readonly="1" widget="float_time"/>
                <field name="over_time_hour" readonly="1" widget="float_time"/>
            </xpath>

            <!-- Lunch Break fields (shown between check_in and check_out group) -->
            <xpath expr="//field[@name='check_out']" position="before">
                <field name="lunch_out" readonly="1"/>
                <field name="lunch_in" readonly="1"/>
                <field name="lunch_break_hours" readonly="1" widget="float_time"/>
            </xpath>

            <!-- Check-out related fields -->
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="check_out_status" readonly="1"/>
                <field name="is_force_checkout" readonly="1"/>
		        <field name="early_exit_hour" readonly="1" widget="float_time"/>
		        <field name="acknowledged_exit" readonly="1"/>
                <field name="active" readonly="1"/>
            </xpath>

        </field>
    </record>

    <!-- HR ATTENDANCE TREE VIEW MATCHING SCREENSHOT 2 -->
    <record id="hr_attendance_view_inherit_tree" model="ir.ui.view">
        <field name="name">hr.attendance.tree.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="priority">500</field>
        <field name="arch" type="xml">
            <!-- Hide standard Odoo overtime fields in tree view -->
            <xpath expr="//field[@name='overtime_hours']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='validated_overtime_hours']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='overtime_status']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- Insert Check-in Status, Late Time Hour, Acknowledged Late, Over Time Hour right after Check In -->
            <xpath expr="//field[@name='check_in']" position="after">
                <field name="check_in_status" string="Check-in Status" readonly="1"/>
                <field name="late_time_hour" string="Late Time Hour" readonly="1" widget="float_time"/>
                <field name="acknowledged_late" string="Acknowledged Late" readonly="1" widget="float_time"/>
                <field name="over_time_hour" string="Over Time Hour" readonly="1" widget="float_time"/>
            </xpath>

            <!-- Insert Check-Out Status, Early Exit Hour, Acknowledged Exit right after Check Out -->
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="check_out_status" string="Check-Out Status" readonly="1"/>
                <field name="early_exit_hour" string="Early Exit Hour" readonly="1" widget="float_time"/>
                <field name="acknowledged_exit" string="Acknowledged Exit" readonly="1"/>
            </xpath>

            <!-- Insert Acknowledged, Reason Type, Late By right after Worked Hours -->
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="is_acknowledged" string="Acknowledged" readonly="1"/>
                <field name="reason_type" string="Reason Type" readonly="1"/>
                <field name="late_by" string="Late By" readonly="1"/>

                <!-- Configurable Optional Columns (Manager can enable/disable via column picker) -->
                <field name="attendance_reason_ids" string="Reasons" widget="many2many_tags" optional="hide"/>
                <field name="is_force_checkout" string="Force Checkout" optional="hide"/>
                <field name="flagged_for_discipline" string="Flagged for Discipline" optional="hide"/>
                <field name="flagged_reason" string="Flag Reason" optional="hide"/>
                <field name="overtime_approved_for_payroll" string="Overtime Approved for Payroll" optional="hide"/>
                <field name="check_in_ip" string="Check-in IP" optional="hide"/>
                <field name="check_in_device_info" string="Check-in Device" optional="hide"/>
                <field name="check_out_ip" string="Check-out IP" optional="hide"/>
                <field name="check_out_device_info" string="Check-out Device" optional="hide"/>
                <field name="lunch_out" string="Lunch Out" optional="hide"/>
                <field name="lunch_in" string="Lunch In" optional="hide"/>
                <field name="lunch_break_hours" string="Lunch Break Hours" optional="hide" widget="float_time"/>
            </xpath>
        </field>
    </record>
</odoo>
