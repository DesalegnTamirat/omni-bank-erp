<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    HR ATTENDANCE FORM VIEW -->
    <record id="hr_attendance_view_inherit_form" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="priority">500</field>
        <field name="arch" type="xml">
            <!-- Header buttons for Approve Overtime for Payroll -->
            <sheet position="before">
                <header>
                    <button name="action_approve_overtime_for_payroll" string="Approve Overtime for Payroll" type="object" class="btn-success"
                            invisible="over_time_hour &lt;= 0 or overtime_approved_for_payroll"
                            groups="hr_attendance.group_hr_attendance_manager"
                            help="Approve overtime and transmit payload to payroll."/>
                </header>
            </sheet>

            <!-- Work date under employee -->
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="work_date" readonly="1" string="Shift / Work Date"/>
            </xpath>

            <!-- Check-in related enhancements -->
            <xpath expr="//field[@name='check_in']" position="after">
                <field name="check_in_status" widget="badge" 
                       decoration-success="check_in_status in ('Normal', 'On-Time', 'On Time', 'Acknowledged Check-In')" 
                       decoration-warning="check_in_status == 'Late'" 
                       decoration-danger="check_in_status in ('Technical Failure', 'Window Closed (Missed)')" 
                       readonly="1"/>
                <field name="late_time_hour" widget="float_time" invisible="late_time_hour &lt;= 0" readonly="1"/>
                <field name="in_mode" widget="badge" readonly="1"/>
            </xpath>

            <!-- Check-out related enhancements -->
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="check_out_status" widget="badge" 
                       decoration-success="check_out_status in ('Normal', 'Acknowledged Check-Out')" 
                       decoration-warning="check_out_status == 'Early Check-out'" 
                       decoration-danger="check_out_status == 'Force Checkout'" 
                       invisible="not check_out" 
                       readonly="1"/>
                <field name="early_exit_hour" widget="float_time" invisible="early_exit_hour &lt;= 0" readonly="1"/>
                <field name="over_time_hour" widget="float_time" invisible="over_time_hour &lt;= 0" readonly="1"/>
                <field name="out_mode" widget="badge" invisible="not check_out" readonly="1"/>
            </xpath>

            <!-- Notebook tabs for Contextual Details -->
            <sheet position="inside">
                <notebook>
                    <!-- Tab 1: Manager Justification & Acknowledgement (Visible only if acknowledged/reasons exist) -->
                    <page string="Manager Acknowledgement" name="acknowledgement" invisible="not is_acknowledged and not attendance_reason_ids and acknowledged_late &lt;= 0 and acknowledged_exit &lt;= 0">
                        <group>
                            <group string="Justification &amp; Reasons">
                                <field name="attendance_reason_ids" widget="many2many_tags" readonly="1"/>
                                <field name="reason_type" readonly="1"/>
                                <field name="is_acknowledged" readonly="1"/>
                            </group>
                            <group string="Approved Exception Credits">
                                <field name="acknowledged_late" widget="float_time" invisible="acknowledged_late &lt;= 0" readonly="1"/>
                                <field name="acknowledged_exit" widget="float_time" invisible="acknowledged_exit &lt;= 0" readonly="1"/>
                                <field name="acknowledged_by" readonly="1"/>
                                <field name="acknowledged_date" readonly="1"/>
                            </group>
                        </group>
                    </page>

                    <!-- Tab 2: System & Audit Details -->
                    <page string="System &amp; Audit Details" name="system_audit">
                        <group>
                            <group string="Device &amp; Session Info">
                                <field name="actual_check_in" readonly="1"/>
                                <field name="is_force_checkout" readonly="1"/>
                                <field name="shift_start_float" widget="float_time" readonly="1"/>
                                <field name="shift_end_float" widget="float_time" readonly="1"/>
                            </group>
                            <group string="Payroll &amp; Technical Flags">
                                <field name="overtime_approved_for_payroll" readonly="1"/>
                                <field name="active" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

    <!-- HR ATTENDANCE TREE VIEW MATCHING SCREENSHOT 2 -->
    <record id="hr_attendance_view_inherit_tree" model="ir.ui.view">
        <field name="name">hr.attendance.tree.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="priority">500</field>
        <field name="arch" type="xml">
            <!-- Hide standard Odoo overtime fields in tree view -->
            <xpath expr="//field[@name='overtime_hours']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='validated_overtime_hours']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='overtime_status']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='check_in']" position="before">
                <field name="work_date" string="Shift Date" readonly="1" optional="show"/>
                <field name="actual_check_in" string="Actual Punch Time" readonly="1" optional="show"/>
            </xpath>

            <!-- Insert Check-in Status, Late By, Acknowledged Late, Over Time Hour right after Check In -->
            <xpath expr="//field[@name='check_in']" position="after">
                <field name="check_in_status" string="Check-in Status" readonly="1"/>
                <field name="late_time_hour" string="Late By" readonly="1" widget="float_time"/>
                <field name="acknowledged_late" string="Acknowledged Late" readonly="1" widget="float_time"/>
                <field name="over_time_hour" string="Over Time Hour" readonly="1" widget="float_time"/>
            </xpath>

            <!-- Insert Check-Out Status, Early Exit Hour, Acknowledged Exit right after Check Out -->
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="check_out_status" string="Check-Out Status" readonly="1"/>
                <field name="early_exit_hour" string="Early Exit Hour" readonly="1" widget="float_time"/>
                <field name="acknowledged_exit" string="Acknowledged Exit" readonly="1"/>
            </xpath>

            <!-- Insert Acknowledged, Reason Type right after Worked Hours -->
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="is_acknowledged" string="Acknowledged" readonly="1"/>
                <field name="reason_type" string="Reason Type" readonly="1"/>
                <field name="in_mode" string="Check-In Mode" widget="badge" optional="show"/>
                <field name="out_mode" string="Check-Out Mode" widget="badge" optional="show"/>

                <!-- Configurable Optional Columns (Manager can enable/disable via column picker) -->
                <field name="attendance_reason_ids" string="Reasons" widget="many2many_tags" optional="hide"/>
                <field name="is_force_checkout" string="Force Checkout" optional="hide"/>
                <field name="overtime_approved_for_payroll" string="Overtime Approved for Payroll" optional="hide"/>
                <field name="check_in_ip" string="Check-in IP" optional="hide"/>
                <field name="check_in_device_info" string="Check-in Device" optional="hide"/>
                <field name="check_out_ip" string="Check-out IP" optional="hide"/>
                <field name="check_out_device_info" string="Check-out Device" optional="hide"/>
                <field name="lunch_out" string="Lunch Out" optional="hide"/>
                <field name="lunch_in" string="Lunch In" optional="hide"/>
                <field name="lunch_break_hours" string="Lunch Break Hours" optional="hide" widget="float_time"/>
            </xpath>
        </field>
    </record>
</odoo>

