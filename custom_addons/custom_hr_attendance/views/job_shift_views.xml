<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="job_shift_view_tree" model="ir.ui.view">
        <field name="name">job.shift.tree</field>
        <field name="model">job.shift</field>
        <field name="arch" type="xml">
            <list string="Job Shifts">
                <field name="name"/>
                <field name="code"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="is_night_shift"/>
                <field name="has_lunch_break"/>
                <field name="applies_to_branches"/>
                <field name="time_range"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="job_shift_view_form" model="ir.ui.view">
        <field name="name">job.shift.form</field>
        <field name="model">job.shift</field>
        <field name="arch" type="xml">
            <form string="Job Shift">
                <sheet>
                    <group>
                        <group string="Shift Details">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="is_night_shift"/>
                            <field name="time_range" readonly="1"/>
                        </group>
                        <group string="Shift Lunch Break">
                            <field name="has_lunch_break"/>
                            <field name="lunch_start_time" widget="float_time" invisible="not has_lunch_break" required="has_lunch_break"/>
                            <field name="lunch_duration" invisible="not has_lunch_break" required="has_lunch_break"/>
                        </group>
                    </group>

                    <group string="Applicability Scope (Where Shift Can Be Assigned)">
                        <group>
                            <field name="applies_to_branches"/>
                        </group>
                        <group>
                            <field name="department_ids" widget="many2many_tags" placeholder="Select Departments..."/>
                            <field name="allowed_operating_unit_ids" invisible="1"/>
                            <field name="operating_unit_ids" widget="many2many_tags" placeholder="Select Operating Units..." domain="[('id', 'in', allowed_operating_unit_ids)]"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_job_shift" model="ir.actions.act_window">
        <field name="name">Job Shift Definition</field>
        <field name="res_model">job.shift</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
