<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="job_shift_view_tree" model="ir.ui.view">
        <field name="name">job.shift.tree</field>
        <field name="model">job.shift</field>
        <field name="arch" type="xml">
            <list string="Job Shifts">
                <field name="name"/>
                <field name="code"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="is_night_shift"/>
                <field name="time_range"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="job_shift_view_form" model="ir.ui.view">
        <field name="name">job.shift.form</field>
        <field name="model">job.shift</field>
        <field name="arch" type="xml">
            <form string="Job Shift">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>

                    <group>
                        <field name="start_time" widget="float_time"/>
                        <field name="end_time" widget="float_time"/>
                        <field name="is_night_shift"/>
                    </group>

                    <group>
                        <field name="time_range" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_job_shift" model="ir.actions.act_window">
        <field name="name">Job Shift Definition</field>
        <field name="res_model">job.shift</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
