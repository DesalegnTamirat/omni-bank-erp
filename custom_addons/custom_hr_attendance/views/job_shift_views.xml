<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="job_shift_view_tree" model="ir.ui.view">
        <field name="name">job.shift.tree</field>
        <field name="model">job.shift</field>
        <field name="arch" type="xml">
            <list string="Job Shifts">
                <field name="name"/>
                <field name="code"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="is_night_shift"/>
                <field name="has_lunch_break"/>
                <field name="scope_type"/>
                <field name="time_range"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="job_shift_view_form" model="ir.ui.view">
        <field name="name">job.shift.form</field>
        <field name="model">job.shift</field>
        <field name="arch" type="xml">
            <form string="Job Shift">
                <sheet>
                    <div class="oe_title mb-3">
                        <label for="code" string="Shift Code"/>
                        <h2>
                            <field name="code" readonly="1" placeholder="Auto-generated on Shift Name"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Shift Details">
                            <field name="name"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="is_night_shift" invisible="not ((end_time &lt;= start_time and (start_time &gt; 0 or end_time &gt; 0)) or start_time &gt;= 20.0 or (start_time &gt; 0 and start_time &lt; 6.0) or end_time &gt; 20.0 or (end_time &gt; 0 and end_time &lt;= 6.0))"/>
                            <field name="time_range" readonly="1"/>
                        </group>
                        <group string="Shift Lunch Break">
                            <field name="has_lunch_break"/>
                            <field name="lunch_start_time" widget="float_time" invisible="not has_lunch_break" required="has_lunch_break"/>
                            <field name="lunch_duration" invisible="not has_lunch_break" required="has_lunch_break"/>
                        </group>
                    </group>

                    <group string="Applicability Scope (Where Shift Can Be Assigned)">
                        <group>
                            <field name="scope_type" widget="radio"/>
                            <field name="applies_to_branches" invisible="1"/>
                        </group>
                        <group invisible="scope_type != 'specific'">
                            <field name="department_ids" widget="many2many_tags" 
                                   placeholder="Select Departments..."
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="allowed_operating_unit_ids" invisible="1"/>
                            <field name="operating_unit_ids" widget="many2many_tags" 
                                   placeholder="Select Operating Units..." 
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('id', 'in', allowed_operating_unit_ids)]"/>
                        </group>
                    </group>
                    <div class="alert alert-info py-2 px-3 mt-1 mb-2" role="alert" invisible="not scope_description">
                        <field name="scope_description" readonly="1" nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_job_shift" model="ir.actions.act_window">
        <field name="name">Job Shift Definition</field>
        <field name="res_model">job.shift</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
