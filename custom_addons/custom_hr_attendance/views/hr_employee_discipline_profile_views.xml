<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW -->
    <record id="view_hr_employee_discipline_profile_form" model="ir.ui.view">
        <field name="name">hr.employee.discipline.profile.form</field>
        <field name="model">hr.employee.discipline.profile</field>
        <field name="arch" type="xml">
            <form string="Employee Attendance Discipline Profile" create="0" delete="0" class="o_chatter_position_bottom">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Rolling Violation Counters">
                            <field name="late_count_rolling" readonly="1"/>
                            <field name="force_checkout_count_rolling" readonly="1"/>
                            <field name="missing_lunch_tap_count_rolling" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_hr_employee_discipline_profile_tree" model="ir.ui.view">
        <field name="name">hr.employee.discipline.profile.list</field>
        <field name="model">hr.employee.discipline.profile</field>
        <field name="arch" type="xml">
            <list string="Attendance Discipline Profiles" create="0" delete="0" sample="1">
                <field name="employee_id"/>
                <field name="late_count_rolling" widget="badge" decoration-warning="late_count_rolling &gt; 0"/>
                <field name="force_checkout_count_rolling" widget="badge" decoration-danger="force_checkout_count_rolling &gt; 0"/>
                <field name="missing_lunch_tap_count_rolling" widget="badge" decoration-info="missing_lunch_tap_count_rolling &gt; 0"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_hr_employee_discipline_profile_search" model="ir.ui.view">
        <field name="name">hr.employee.discipline.profile.search</field>
        <field name="model">hr.employee.discipline.profile</field>
        <field name="arch" type="xml">
            <search string="Search Discipline Profiles">
                <field name="employee_id"/>
                <filter string="Has Late Violations" name="has_late" domain="[('late_count_rolling', '&gt;', 0)]"/>
                <filter string="Has Force Checkouts" name="has_force" domain="[('force_checkout_count_rolling', '&gt;', 0)]"/>
                <filter string="Has Missing Lunch Taps" name="has_lunch" domain="[('missing_lunch_tap_count_rolling', '&gt;', 0)]"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_hr_employee_discipline_profile" model="ir.actions.act_window">
        <field name="name">Discipline Counters &amp; Profiles</field>
        <field name="res_model">hr.employee.discipline.profile</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', '|', ('late_count_rolling', '&gt;', 0), ('force_checkout_count_rolling', '&gt;', 0), ('missing_lunch_tap_count_rolling', '&gt;', 0)]</field>
        <field name="context">{'create': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Discipline Profiles Found
            </p>
            <p>
                Attendance discipline counters for employees will automatically appear here as check-in violations occur.
            </p>
        </field>
    </record>
</odoo>
