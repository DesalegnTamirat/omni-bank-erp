<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <!-- Add fields to the settings form and restrict global settings -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.custom.hr.attendance</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='kiosk_mode_setting_container']" position="before">

                        <!-- ========================================= -->
                        <!-- BLOCK 1: Attendance Features             -->
                        <!-- ========================================= -->
                        <block title="Attendance Features" name="custom_attendance_feature_toggles">
                            <setting string="Check-in Time Restriction"
                                     help="Enforce morning check-in time window. When OFF, employees can check in at any time.">
                                <field name="enable_checkin_restriction"/>
                            </setting>
                            <setting string="Check-out Time Restriction"
                                     help="Enforce shift-end check-out time restriction. When OFF, employees can check out freely.">
                                <field name="enable_checkout_restriction"/>
                            </setting>
                            <setting string="Saturday Half-Day (Head Office)"
                                     help="Apply reduced exit time on Saturdays for Head Office employees.">
                                <field name="enable_saturday_halfday"/>
                            </setting>
                            <setting string="Lunch Break"
                                     help="Enable Lunch-Out / Back-from-Lunch flow. Worked hours will exclude actual lunch break duration.">
                                <field name="enable_lunch_break"/>
                            </setting>
                            <setting string="Automatic Absence Detection"
                                     help="Enable automatic detection of unexcused absences">
                                <field name="enable_auto_absence"/>
                            </setting>
                            <setting string="IP Address Tracking"
                                     help="Track IP address of device used when employee checks in and checks out.">
                                <field name="enable_ip_tracking"/>
                            </setting>
                            <setting string="ERP Access Gate (Requires Check-In)"
                                     help="When enabled, employees must be checked in to access ERP modules.">
                                <field name="enable_checkin_gate"/>
                            </setting>
                            <setting string="Overtime Payroll Payout Policy"
                                     help="When OFF (Default), extra shift work is compensated via Duty OFF. When ON, overtime hours are exported for payroll payout.">
                                <field name="enable_overtime_payroll"/>
                            </setting>
                        </block>


                        <!-- ========================================= -->
                        <!-- BLOCK 1.5: Configurable HR Regulations     -->
                        <!-- ========================================= -->
                        <block title="HR &amp; Discipline Regulations" name="custom_hr_regulations_settings">
                            <setting string="Absence Escalation Triggers" help="Thresholds that auto-trigger draft discipline cases">
                                <div>
                                    <label for="attendance_unexcused_consecutive_threshold" string="Consecutive Days: "/>
                                    <field name="attendance_unexcused_consecutive_threshold" class="oe_inline"/>
                                    <span class="ms-2">days</span>
                                    <br/>
                                    <label for="attendance_unexcused_monthly_threshold" string="Monthly Cumulative: "/>
                                    <field name="attendance_unexcused_monthly_threshold" class="oe_inline"/>
                                    <span class="ms-2">days</span>
                                </div>
                            </setting>
                            <setting string="Managerial Staff Penalties (Daily Wage Units)" help="Daily wage deduction per warning step">
                                <div>
                                    <label for="discipline_managerial_warning1_days" string="1st Warning: "/>
                                    <field name="discipline_managerial_warning1_days" class="oe_inline"/> day(s)
                                    <label for="discipline_managerial_warning2_days" string=" | 2nd Warning: "/>
                                    <field name="discipline_managerial_warning2_days" class="oe_inline"/> day(s)
                                    <label for="discipline_managerial_warning3_days" string=" | 3rd Warning: "/>
                                    <field name="discipline_managerial_warning3_days" class="oe_inline"/> day(s)
                                </div>
                            </setting>
                            <setting string="Non-Managerial Staff Penalties (% Basic Salary)" help="Monthly basic salary percentage per warning step">
                                <div>
                                    <label for="discipline_non_managerial_warning1_pct" string="1st Warning: "/>
                                    <field name="discipline_non_managerial_warning1_pct" class="oe_inline"/>%
                                    <label for="discipline_non_managerial_warning2_pct" string=" | 2nd Warning: "/>
                                    <field name="discipline_non_managerial_warning2_pct" class="oe_inline"/>%
                                    <label for="discipline_non_managerial_warning3_pct" string=" | 3rd Warning: "/>
                                    <field name="discipline_non_managerial_warning3_pct" class="oe_inline"/>%
                                </div>
                            </setting>
                            <setting string="Appeal Deadline Window" help="Working days allowed to lodge an appeal">
                                <div>
                                    <field name="discipline_appeal_window_days" class="oe_inline"/>
                                    <span class="ms-2">working days</span>
                                </div>
                            </setting>
                        </block>

                        <!-- ========================================= -->
                        <!-- BLOCK 2: Attendance Time Settings         -->
                        <!-- ========================================= -->
                        <block title="Attendance Time Settings" name="custom_attendance_time_settings">
                            <setting string="Morning Check-in Time"
                                     help="The standard morning check-in time (24h format)"
                                     invisible="not enable_checkin_restriction">
                                <field name="morning_time" widget="float_time"/>
                            </setting>
                            <setting string="Check-in Buffer (Hours)"
                                     help="How early (in hours) employees are allowed to check in before shift start"
                                     invisible="not enable_checkin_restriction">
                                <field name="checkin_buffer" widget="float_time"/>
                            </setting>
                            <setting string="Dead Time (Grace Period, Hours)"
                                     help="Grace period in hours around check-in/out times before marking as late"
                                     invisible="not enable_checkin_restriction">
                                <field name="dead_time" widget="float_time"/>
                            </setting>
                            <setting string="Exit Time"
                                     help="The standard exit/check-out time (24h format)"
                                     invisible="not enable_checkout_restriction">
                                <field name="exit_time" widget="float_time"/>
                            </setting>
                            <setting string="Saturday Head Office Exit Time"
                                     help="Default exit time on Saturdays for Head Office staff (e.g., 12.00 for 12:00 PM Noon)"
                                     invisible="not enable_saturday_halfday">
                                <field name="saturday_exit_time" widget="float_time"/>
                            </setting>
                            <setting string="Force Checkout Threshold (Hours)"
                                     help="Hours after check-in before automatic force checkout is performed">
                                <field name="force_checkout_hours" widget="float_time"/>
                            </setting>
                        </block>

                        <!-- ========================================= -->
                        <!-- BLOCK 3: Lunch Break Settings             -->
                        <!-- ========================================= -->
                        <block title="Lunch Break Settings" name="custom_lunch_break_settings"
                               invisible="not enable_lunch_break">
                            <setting string="Lunch Break Start Time"
                                     help="Time when lunch break starts (24h format, e.g., 12.00 for noon)">
                                <field name="lunch_out_time" widget="float_time"/>
                            </setting>
                            <setting string="Lunch Break Duration (Hours)"
                                     help="Duration of the lunch break (e.g., 1.0 = 1 hour, 0.5 = 30 minutes)">
                                <field name="lunch_duration" widget="float_time"/>
                            </setting>
                            <setting string="Lunch Grace Time (Hours)"
                                     help="Allowed tolerance before/after the lunch window (e.g., 0.25 = ±15 min)">
                                <field name="lunch_grace_time" widget="float_time"/>
                            </setting>
                        </block>

                        <!-- ========================================= -->
                        <!-- BLOCK 4: Discipline Integration Thresholds -->
                        <!-- ========================================= -->
                        <block title="Discipline Integration Thresholds" name="custom_discipline_thresholds">
                            <setting string="Cumulative Late Hours Threshold (Hours)"
                                     help="Total cumulative late hours within the rolling evaluation window that triggers an automatic discipline case.">
                                <field name="lateness_hours_violation_threshold" widget="float_time"/>
                            </setting>
                            <setting string="Lateness Evaluation Window (Months)"
                                     help="Rolling evaluation window in months over which cumulative late hours are aggregated (e.g., 3 months).">
                                <field name="lateness_eval_window_months"/>
                            </setting>
                            <setting string="Force Checkout Violation Threshold (Occurrences)"
                                     help="Number of force checkouts that triggers an automatic discipline case.">
                                <field name="force_checkout_violation_threshold"/>
                            </setting>
                        </block>

                        <!-- ========================================= -->
                        <!-- BLOCK 5: Warning Validity Periods (Art. 10.3) -->
                        <!-- ========================================= -->
                        <block title="Bank Regulation Warning Validity (Art. 10.3)" name="custom_warning_validity">
                            <setting string="1st Written Warning Validity (Months)"
                                     help="First written warning will be valid for 3 months (Art. 10.3.1).">
                                <field name="warning_1_validity_months"/>
                            </setting>
                            <setting string="2nd Written Warning Validity (Months)"
                                     help="Second written warning will be valid for 6 months (Art. 10.3.2).">
                                <field name="warning_2_validity_months"/>
                            </setting>
                            <setting string="Final Written Warning Validity (Months)"
                                     help="Final written warning will be valid for 1 year (Art. 10.3.3).">
                                <field name="warning_3_validity_months"/>
                            </setting>
                        </block>
                </xpath>

                <!-- Hide Standard Odoo Kiosk Settings and Overtime blocks, keep Modes visible at bottom -->
                <xpath expr="//block[.//field[@name='attendance_barcode_source']]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//block[@name='overtime_settings']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Restrict non-attendance setting categories on left sidebar to System Admins only -->
                <xpath expr="//app[@name='general_settings']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
                <xpath expr="//app[@name='calendar']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
                <xpath expr="//app[@name='website']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
                <xpath expr="//app[@name='hr']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
                <xpath expr="//app[@name='hr_recruitment']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </xpath>
            </field>
        </record>

        <!-- Action to open settings -->
        <record id="action_hr_attendance_configuration" model="ir.actions.act_window">
            <field name="name">Attendance Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module': 'hr_attendance', 'bin_size': False}</field>
        </record>


    </data>
</odoo>
