<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--        Tree View-->
    <record id="view_attendance_preapproval_tree" model="ir.ui.view">
        <field name="name">attendance.preapproval.report.tree</field>
        <field name="model">attendance.preapproval.report</field>
        <field name="arch" type="xml">
            <list string="Predefined Attendance Report" decoration-info="status == 'requested'" decoration-success="status == 'approved'" decoration-danger="status == 'refused'">
                <field name="employee_identification" string="Employee ID"/>
                <field name="employee_name" string="Employee Name"/>
                <field name="place_of_assignment" string="Place of Assignment"/>
                <field name="work_unit" string="Work Unit"/>	
                <field name="shift_name" string="Shift Name"/>
                <field name="exception_type" string="Exception Type"/>
                <field name="approval_reason" string="Approval Reason"/>
                <field name="date" string="Date"/>
                <field name="start_time" widget="float_time" string="Start Time"/>
                <field name="end_time" widget="float_time" string="End Time"/>
                <field name="duration" widget="float_time" string="Duration"/>
                <field name="status" widget="badge" decoration-info="status == 'requested'" decoration-success="status == 'approved'" decoration-danger="status == 'refused'"/>
                <field name="request_date" string="Requested On"/>
                <field name="approved_by" string="Approved By"/>
            </list>
        </field>
    </record>

    <!--Search View-->
    <record id="view_attendance_preapproval_search" model="ir.ui.view">
        <field name="name">attendance.preapproval.report.search</field>
        <field name="model">attendance.preapproval.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_identification"/>
                <field name="employee_name"/>
                <field name="place_of_assignment"/>
                <field name="exception_type"/>

                <separator/>
                <filter string="Employee Name"
                        name="group_by_employee_name"
                        context="{'group_by':'employee_name'}"/>
                <filter string="Place of Assignment"
                        name="group_by_place_of_assignment"
                        context="{'group_by':'place_of_assignment'}"/>
                <filter string="Exception Type"
                        name="group_by_exception_type"
                        context="{'group_by':'exception_type'}"/>
                <filter string="Date"
                        name="group_by_date"
                        context="{'group_by':'date'}"/>
            
            </search>
        </field>
    </record>

    <!--    Action-->
    <record id="action_attendance_preapproval_report" model="ir.actions.act_window">
        <field name="name">PreDefined Attendance Report</field>
        <field name="res_model">attendance.preapproval.report</field>
        <field name="view_mode">list,search</field>
    </record>


</odoo>
