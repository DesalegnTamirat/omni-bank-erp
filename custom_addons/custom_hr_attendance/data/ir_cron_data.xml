<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Shift-Aware Auto Checkout Cron: runs daily at 23:15 (Addis Ababa time / 20:15 UTC).
            Executes the native PostgreSQL stored function auto_checkout_all_employees()
            on the dedicated DB server with 0ms network latency.
        -->
        <record id="ir_cron_automatic_force_checkout" model="ir.cron">
            <field name="name">Attendance: Daily Shift-Aware Auto Checkout (23:15)</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_automatic_force_checkout()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2024-01-01 20:15:00</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            Absence Detection Cron: scheduled at 09:30 AM (Addis Ababa time / 06:30 UTC) daily.
            Executes the native PostgreSQL stored function detect_daily_employee_absences()
            on the dedicated DB server to create payroll payload deductions.
        -->
        <record id="ir_cron_automatic_absence_detection" model="ir.cron">
            <field name="name">Attendance: Daily Morning Absence Detection (09:30 AM)</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_automatic_absence_detection()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2024-01-01 06:30:00</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            Job Abandonment Cron: scheduled at 03:00 AM (Addis Ababa time / 00:00 UTC) daily off-peak.
            Executes the native PostgreSQL stored function detect_job_abandonment_cases()
            to flag employees absent 3+ consecutive days and create discipline cases.
        -->
        <record id="ir_cron_job_abandonment_detection" model="ir.cron">
            <field name="name">Attendance: Daily Job Abandonment Detection (03:00 AM)</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_job_abandonment_detection()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2024-01-01 00:00:00</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            FR-Missing Check-In / Check-Out Notification Cron: scheduled at 17:30 PM (Addis Ababa time / 14:30 UTC) daily.
            Runs at shift end to notify employees of missing check-in/out without impacting peak hours.
        -->
        <record id="ir_cron_notify_missing_attendance" model="ir.cron">
            <field name="name">Attendance: End-of-Day Missing Attendance Reminders (17:30 PM)</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_notify_missing_attendance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2024-01-01 14:30:00</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Deactivate redundant standard Odoo core crons -->
        <record id="hr_attendance.hr_attendance_check_out_cron" model="ir.cron">
            <field name="active" eval="False"/>
        </record>
        <record id="hr_attendance.hr_attendance_absence_cron" model="ir.cron">
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
