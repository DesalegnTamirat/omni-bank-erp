<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Shift-Aware Auto Checkout Cron: runs once a day at midnight (21:00 UTC = 00:00 Midnight EAT).
            Executes process_automated_force_checkouts() to auto-checkout employees whose shifts have ended.
            Does NOT force checkout employees whose shifts are still active across midnight (e.g. Night Shifts).
        -->
        <record id="ir_cron_automatic_force_checkout" model="ir.cron">
            <field name="name">Attendance: Daily Midnight Auto Checkout</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_automatic_force_checkout()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 21:00:00')"/>
            <field name="active" eval="True"/>
        </record>

        <!--
            Absence Detection: Evaluated dynamically on-demand with zero-cron overhead.
        -->
        <record id="ir_cron_automatic_absence_detection" model="ir.cron">
            <field name="name">Attendance: Daily Morning Absence Detection (On-Demand)</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_automatic_absence_detection()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2024-01-01 06:30:00</field>
            <field name="active" eval="False"/>
        </record>

        <!--
            Job Abandonment: Handled via Discipline Management.
        -->
        <record id="ir_cron_job_abandonment_detection" model="ir.cron">
            <field name="name">Attendance: Daily Job Abandonment Detection (Discipline Scoped)</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_job_abandonment_detection()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2024-01-01 00:00:00</field>
            <field name="active" eval="False"/>
        </record>

        <!--
            Missing Check-In / Check-Out Notification Cron: scheduled at 17:30 PM (Addis Ababa time / 14:30 UTC) daily.
            Runs at shift end to notify employees of missing check-in/out without impacting peak hours.
        -->
        <record id="ir_cron_notify_missing_attendance" model="ir.cron">
            <field name="name">Attendance: End-of-Day Missing Attendance Reminders (17:30 PM)</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_notify_missing_attendance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2024-01-01 14:30:00</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Deactivate redundant standard Odoo core crons -->
        <record id="hr_attendance.hr_attendance_check_out_cron" model="ir.cron">
            <field name="active" eval="False"/>
        </record>
        <record id="hr_attendance.hr_attendance_absence_cron" model="ir.cron">
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
