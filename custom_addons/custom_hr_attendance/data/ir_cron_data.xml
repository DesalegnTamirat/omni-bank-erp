<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Force Checkout Cron: runs every 4 hours off-peak.
            Single-pass indexed SQL UPDATE; safe to run frequently because
            it only touches open records (check_out IS NULL) older than the threshold.
        -->
        <record id="ir_cron_automatic_force_checkout" model="ir.cron">
            <field name="name">Attendance: Off-Peak Automatic Force Checkout</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_automatic_force_checkout()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            Absence Detection Cron: scheduled at 09:30 AM daily.
            Now also creates payroll payload and signals discipline module.
            Runs strictly AFTER the 08:00–08:15 peak check-in window closes to
            prevent any cron table-scan from contending with live check-in traffic.
            nextcall is set to 09:30 as the first execution anchor.
        -->
        <record id="ir_cron_automatic_absence_detection" model="ir.cron">
            <field name="name">Attendance: Daily Automatic Absence Detection</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_automatic_absence_detection()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2024-01-01 06:30:00</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            Job Abandonment Cron.
            Detects employees absent for 3+ consecutive working days with no approved leave.
            Runs daily at 03:00 AM server time (off-peak, well before business hours).
            Creates a discipline case automatically when triggered.
        -->
        <record id="ir_cron_job_abandonment_detection" model="ir.cron">
            <field name="name">Attendance: Daily Job Abandonment Detection</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_job_abandonment_detection()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=3, minute=0, second=0)"/>
            <field name="active" eval="True"/>
        </record>
        <!--
            FR-Missing Check-In / Check-Out Notification Cron.
            Runs every 30 minutes during business hours to notify employees of missing check-in/out.
        -->
        <record id="ir_cron_notify_missing_attendance" model="ir.cron">
            <field name="name">Attendance: Missing Check-In / Check-Out Notification (FR-)</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_notify_missing_attendance()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
