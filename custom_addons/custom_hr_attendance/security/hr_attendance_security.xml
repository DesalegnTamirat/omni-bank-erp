<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Remove empty placeholder option from Attendance privilege -->
    <record id="hr_attendance.res_groups_privilege_attendances" model="res.groups.privilege">
        <field name="placeholder" eval="False"/>
    </record>

    <!-- Manual Attendance (Basic Attendance Check-In / Check-Out permission) -->
    <record id="group_hr_attendance_manual_user" model="res.groups">
        <field name="name">Manual Attendance</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Make Manual Attendance implied by Internal User (base.group_user) so it is default for all users -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('custom_hr_attendance.group_hr_attendance_manual_user'))]"/>
    </record>

    <!-- Rename Officer: Manage all attendances -> Manager: Manage all attendances & Grant Export Access -->
    <record id="hr_attendance.group_hr_attendance_user" model="res.groups">
        <field name="name">Manager: Manage all attendances</field>
        <field name="implied_ids" eval="[(4, ref('base.group_allow_export'))]"/>
    </record>

    <!-- Job Position Manager (Manager + Job Position Exceptions & Job Shifts) -->
    <record id="group_hr_attendance_job_position_user" model="res.groups">
        <field name="name">Job Position Manager</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="implied_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
    </record>

    <!-- IT and Driver Manager (Manager + Over Time) -->
    <record id="group_hr_attendance_it_driver_user" model="res.groups">
        <field name="name">IT and Driver Manager</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="implied_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
    </record>

    <!-- Requirement 4: Privacy - Regular Employee: Own Attendance Only -->
    <record id="rule_attendance_employee_own_privacy" model="ir.rule">
        <field name="name">Employee Own Attendance Privacy Rule</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Requirement 4: Manager / Coach: Team Attendance Access -->
    <record id="rule_attendance_manager_team_access" model="ir.rule">
        <field name="name">Manager Team Attendance Access Rule</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">['|', '|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id), ('employee_id.coach_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

</odoo>
