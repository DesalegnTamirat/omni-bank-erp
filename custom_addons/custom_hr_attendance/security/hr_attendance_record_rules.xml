<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================
         1. HR Employee Hierarchy Access Rules
         ==================================================== -->
    <record id="hr_employee_rule_manager_hierarchy" model="ir.rule">
        <field name="name">HR Employee: Manager Subordinate Hierarchy (Write Control)</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">['|', '|', '|', '|', '|', '|', ('user_id', '=', user.id), ('parent_id.user_id', '=', user.id), ('attendance_manager_id', '=', user.id), ('id', 'child_of', user.employee_id.id), ('id', '=', user.employee_id.coach_id.id), ('id', '=', user.employee_id.parent_id.id), ('default_operating_unit_id', '=', user.employee_id.default_operating_unit_id.id)]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>


    <record id="hr_employee_rule_read_attendance_user" model="ir.rule">
        <field name="name">HR Employee: Coached and Managed Subordinates Only</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[('id', 'in', user.env['hr.employee']._get_delegation_visible_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>





