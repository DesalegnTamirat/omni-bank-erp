<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ===============================================================
             ACCESS RULES SUMMARY
             ─────────────────────────────────────────────────────────────
             TIER 1 – User (group_hr_employee_user):
               domain = self | coached | subordinates
               perm   = read only (or limited write for own requests)

             TIER 2 – Officer (hr.group_hr_user):
               domain = [(1,'=',1)]  →  ALL records bank-wide
               perm   = read + write + create  (NO delete)

             TIER 3 – Administrator (hr.group_hr_manager):
               domain = [(1,'=',1)]  →  ALL records bank-wide
               perm   = read + write + create + DELETE (full)
        ================================================================ -->

        <!-- ===============================================================
             1. HR EMPLOYEE (Core Directory & Profile)
        ================================================================ -->
        <record id="rule_hr_employee_user" model="ir.rule">
            <field name="name">Hr Employee: User - Self, Coached and Subordinates</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="groups" eval="[(4, ref('hr_employee_custom.group_hr_employee_user'))]"/>
            <field name="domain_force">[('id', 'in', user.env['hr.employee']._get_delegation_visible_employee_ids())]
            </field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

