<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Record Rule for Employees: ESS Users see only their own Insurance Notifications -->
        <record id="rule_hr_insurance_notification_employee" model="ir.rule">
            <field name="name">Employee ESS Insurance Notification Rule</field>
            <field name="model_id" ref="model_hr_insurance_notification"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Record Rule for POMD / HR Officers: Full access to all Insurance Notifications -->
        <record id="rule_hr_insurance_notification_officer" model="ir.rule">
            <field name="name">POMD / HR Officer Insurance Notification Rule</field>
            <field name="model_id" ref="model_hr_insurance_notification"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr.group_hr_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Record Rule for Employees: ESS Users see only their own Insurance Records -->
        <record id="rule_hr_insurance_record_employee" model="ir.rule">
            <field name="name">Employee ESS Insurance Record Rule</field>
            <field name="model_id" ref="model_hr_insurance_record"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule for POMD / HR Officers: Full access to all Insurance Records -->
        <record id="rule_hr_insurance_record_officer" model="ir.rule">
            <field name="name">POMD / HR Officer Insurance Record Rule</field>
            <field name="model_id" ref="model_hr_insurance_record"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr.group_hr_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
