<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Central Security Rule: Internal Users can strictly and only read their OWN notifications -->
        <record id="rule_mail_notification_strict_personal_read" model="ir.rule">
            <field name="name">mail.notification: internal users read own notifications only</field>
            <field name="model_id" ref="mail.model_mail_notification"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('res_partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
