<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="1">
        <!-- Module Category -->
        <record id="module_category_employee_service_request" model="ir.module.category">
            <field name="name">Employee Service Request</field>
            <field name="description">Manage employee service requests and approvals.</field>
            <field name="sequence">20</field>
        </record>

        <!-- Privilege (Odoo 19: groups belong to a privilege, which belongs to the category) -->
        <record id="privilege_employee_service_request" model="res.groups.privilege">
            <field name="name">Employee Service Request</field>
            <field name="category_id" ref="module_category_employee_service_request"/>
        </record>

        <!-- Groups -->
        <record id="group_service_request_officer" model="res.groups">
            <field name="name">Officer</field>
            <field name="privilege_id" ref="privilege_employee_service_request"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="group_service_request_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_employee_service_request"/>
            <field name="implied_ids" eval="[Command.link(ref('group_service_request_officer'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="rule_service_request_officer_own" model="ir.rule">
            <field name="name">Service Request: Officer sees own records</field>
            <field name="model_id" ref="model_employee_service_request"/>
            <field name="groups" eval="[(4, ref('group_service_request_officer'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_service_request_manager_all" model="ir.rule">
            <field name="name">Service Request: Manager sees all records</field>
            <field name="model_id" ref="model_employee_service_request"/>
            <field name="groups" eval="[(4, ref('group_service_request_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>