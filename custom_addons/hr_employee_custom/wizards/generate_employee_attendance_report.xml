<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="generate_employee_attendance_report_form" model="ir.ui.view">
        <field name="name">Generate Employee Attendance Report</field>
        <field name="model">generate.employee.attendance.report</field>
        <field name="arch" type="xml">
            <form string="Employee Attendance">
                    <group>
                       <field name="date_from"/>
                       <field name="date_to"/>
                    </group>


                <footer>
                    <button name="generate" string="Generate" type="object" class="btn btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_generate_employee_attendance_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate Employee Attendance Report Wizard</field>
        <field name="res_model">generate.employee.attendance.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="generate_employee_attendance_report_form"/>
        <field name="target">new</field>
    </record>

     <menuitem id="menu_generate_employee_attendance_report_wizard" name="Generate Employee Attendance Report Wizard" parent="hr_attendance.menu_hr_attendance_manage_attendances" action="action_generate_employee_attendance_report_wizard" sequence="105"/>

</odoo>