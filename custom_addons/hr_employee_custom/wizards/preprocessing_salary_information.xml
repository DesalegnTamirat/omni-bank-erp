<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="Preprocessing_salary_information_form" model="ir.ui.view">
        <field name="name">Preprocessing Salary Information Wizard</field>
        <field name="model">preprocessing.salary.information</field>
        <field name="arch" type="xml">
            <form string="Salary Rules">

                    <group>
                        <!-- <field name="hr_period"/> commented: hr.period model missing -->
                        <field name="fuel_rate"/>
                    </group>


                <footer>
                    <button name="call_pre_process_payroll" string="Populate" type="object" class="btn btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_Preprocessing_salary_details_wizard" model="ir.actions.act_window">
        <field name="name">Preprocessing Salary Information Wizard</field>
        <field name="res_model">preprocessing.salary.information</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="Preprocessing_salary_information_form"/>
        <field name="target">new</field>
    </record>

