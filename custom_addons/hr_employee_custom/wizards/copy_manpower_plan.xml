<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="copy_manpower_plan_form" model="ir.ui.view">
        <field name="name">Copy Manpower PLan Wizard</field>
        <field name="model">copy.manpower.plan</field>
        <field name="arch" type="xml">
            <form string="Salary Rules">

                    <group>
<!--                        <field name="plan_version"/>-->
<!--                        <field name="fuel_rate"/>-->
                    </group>


                <footer>
                    <button name="copy_manpower_plan" string="Copy Current Plan" type="object" class="btn btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_copy_manpower_plan_wizard" model="ir.actions.act_window">
        <field name="name">Copy Manpower PLan Wizard</field>
        <field name="res_model">copy.manpower.plan</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="copy_manpower_plan_form"/>
        <field name="target">new</field>
    </record>

     <menuitem id="menu_copy_manpower_plan_wizard" name="Copy Manpower Plan Wizard" parent="hr_employee_custom.menu_hr_payroll_community_wizards_stub" action="action_copy_manpower_plan_wizard"/>

</odoo>