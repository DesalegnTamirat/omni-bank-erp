<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="net_salary_payment_form" model="ir.ui.view">
        <field name="name">Net Salary Payment Wizard</field>
        <field name="model">net.salary.payment</field>
        <field name="arch" type="xml">
            <form string="Salary Rules">

                     <group>
                        <!-- <field name="hr_period"/> commented: hr.period model missing -->
                    </group>

                <footer>
                    <button name="net_salary_payment" string="Net Salary Payment" type="object" class="btn btn-primary"/>
<!--                    <button name="process_api" string="Process Net Pay API" type="object" class="btn btn-primary" model="call.api"/>-->
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_net_salary_paymen_wizard" model="ir.actions.act_window">
        <field name="name">Net Salary Payment Wizard</field>
        <field name="res_model">net.salary.payment</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="net_salary_payment_form"/>
        <field name="target">new</field>
    </record>


    <menuitem id="menu_net_salary_paymen_wizard" name="Net Salary Payment Wizard" parent="hr_employee_custom.menu_hr_payroll_community_wizards_stub" action="action_net_salary_paymen_wizard"/>

</odoo>