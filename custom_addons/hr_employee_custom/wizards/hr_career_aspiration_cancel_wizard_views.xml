<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Career Aspiration Cancel Wizard View -->
        <record id="view_career_aspiration_cancel_wizard_form" model="ir.ui.view">
            <field name="name">hr.career.aspiration.cancel.wizard.form</field>
            <field name="model">hr.career.aspiration.cancel.wizard</field>
            <field name="arch" type="xml">
                <form string="Cancel Career Aspiration">
                    <sheet>
                        <div class="alert alert-warning mb-3" role="alert">
                            <div class="d-flex align-items-center mb-1">
                                <i class="fa fa-exclamation-triangle fa-lg me-2 text-warning"/>
                                <strong class="fs-6">You are about to cancel this Career Aspiration</strong>
                            </div>
                            <div class="mt-1 ms-4 small text-muted">
                                This action will permanently cancel the aspiration. The employee will be notified.
                                Please provide a clear and documented justification.
                            </div>
                        </div>

                        <group string="Aspiration Details">
                            <field name="aspiration_id" readonly="1"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="target_job_id" readonly="1"/>
                        </group>

                        <group string="Cancellation Details">
                            <field name="cancel_reason" required="1"/>
                            <field name="cancel_justification" required="1"
                                   placeholder="Provide a clear and detailed justification for cancelling this career aspiration..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm_cancel" string="Confirm Cancellation"
                                type="object" class="btn-danger"/>
                        <button string="Discard" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_career_aspiration_cancel_wizard" model="ir.actions.act_window">
            <field name="name">Cancel Career Aspiration</field>
            <field name="res_model">hr.career.aspiration.cancel.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
