<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_service_request_rejection_wizard_form" model="ir.ui.view">
        <field name="name">service.request.rejection.wizard.form</field>
        <field name="model">service.request.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Service Request">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Please type why this request is being rejected..." required="1"/>
                </group>
                <footer>
                    <button string="Reject Request" name="action_confirm_rejection" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>