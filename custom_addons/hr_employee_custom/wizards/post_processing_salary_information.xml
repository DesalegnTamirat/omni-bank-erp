<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="post_process_salary_information_form" model="ir.ui.view">
        <field name="name">Post Process Salary Information Wizard</field>
        <field name="model">post.processing.salary.information</field>
        <field name="arch" type="xml">
            <form string="Salary Rules">

                    <group>
                        <!-- <field name="hr_period"/> commented: hr.period model missing -->
                    </group>


                <footer>
                    <button name="call_post_process_payroll" string="Populate" type="object" class="btn btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_post_process_salary_information_form_wizard" model="ir.actions.act_window">
        <field name="name">Post Process Salary Information Wizard</field>
        <field name="res_model">post.processing.salary.information</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="post_process_salary_information_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_post_process_salary_information_form_wizards" name="Post Process Salary Information Wizard" parent="hr_employee_custom.menu_hr_payroll_community_wizards_stub" action="action_post_process_salary_information_form_wizard"/>
</odoo>