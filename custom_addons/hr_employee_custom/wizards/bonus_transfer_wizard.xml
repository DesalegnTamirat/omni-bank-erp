<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="net_bonus_transfer_form" model="ir.ui.view">
        <field name="name">Bonus Transfer Wizard</field>
        <field name="model">bonus.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Salary Rules">
<!--                     <group>-->
<!--                        <field name="hr_period"/>-->
<!--                    </group>-->
                <footer>
                    <button name="bonus_transfer" string="Bonus Transfer" type="object" class="btn btn-primary"/>
<!--                    <button name="process_api" string="Process Net Pay API" type="object" class="btn btn-primary" model="call.api"/>-->
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_bonus_transfer_wizard" model="ir.actions.act_window">
        <field name="name">Bonus Transfer Wizard</field>
        <field name="res_model">bonus.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="net_bonus_transfer_form"/>
        <field name="target">new</field>
    </record>


    <!-- Menu item commented out: payroll module not currently installed.
    <menuitem id="menu_bonus_transfer_wizard" name="Bonus Transfer Wizard" parent="hr_employee_custom.menu_hr_payroll_community_wizards_stub" action="action_bonus_transfer_wizard"/>
    -->

</odoo>