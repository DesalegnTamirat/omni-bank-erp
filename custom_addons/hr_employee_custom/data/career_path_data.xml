<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- =====================================================
             SEED DATA: Standard Career Tracks for Bunna Bank
        ====================================================== -->

        <record id="track_managerial" model="hr.career.track">
            <field name="name">Managerial / Leadership Track</field>
            <field name="track_type">managerial</field>
            <field name="sequence">10</field>
            <field name="description">
                Career track for employees aspiring to management and leadership roles.
                Covers Branch Managers, Department Directors, and C-Suite positions.
            </field>
        </record>

        <record id="track_technical" model="hr.career.track">
            <field name="name">Technical / Professional Track</field>
            <field name="track_type">technical</field>
            <field name="sequence">20</field>
            <field name="description">
                Career track for employees who want to deepen technical expertise
                in areas such as IT, Finance, Risk, Compliance, and Banking Operations.
            </field>
        </record>

        <record id="track_value_stream" model="hr.career.track">
            <field name="name">Value-Stream / Operational Track</field>
            <field name="track_type">value_stream</field>
            <field name="sequence">30</field>
            <field name="description">
                Career track for employees in core banking operations such as
                Customer Service, Trade Finance, Treasury, and Retail Banking.
            </field>
        </record>

    </data>
</odoo>
