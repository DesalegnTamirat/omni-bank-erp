<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ─── Form View ─────────────────────────────────────────────── -->
    <record id="part_time_employment_form_view" model="ir.ui.view">
        <field name="name">part.time.employment.form</field>
        <field name="model">part.time.employment</field>
        <field name="arch" type="xml">
            <form string="Part Time Employment">
                <header>
                    <button name="approve" string="Approve" type="object" class="btn-primary" invisible="state == 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="employee_name"/>
                            <field name="address"/>
                        </group>
                        <group>
                            <field name="Job_title"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="other_info"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── List View ─────────────────────────────────────────────── -->
    <record id="part_time_employment_list_view" model="ir.ui.view">
        <field name="name">part.time.employment.list</field>
        <field name="model">part.time.employment</field>
        <field name="arch" type="xml">
            <list string="Part Time Employment">
                <field name="employee_id"/>
                <field name="employee_name"/>
                <field name="address"/>
                <field name="Job_title"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="other_info"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ─── Action ────────────────────────────────────────────────── -->
    <record id="part_time_employment_action" model="ir.actions.act_window">
        <field name="name">Part Time Employment</field>
        <field name="res_model">part.time.employment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>