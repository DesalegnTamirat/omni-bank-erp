<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>

        <!-- Inherit employee form to add Pension Information tab -->
        <record id="view_hr_employee_pension_inherit" model="ir.ui.view">
            <field name="name">hr.employee.pension.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="priority">110</field>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='more_nested_lists']" position="before">
                    <page string="Pension Information" name="pension_information">
                        <group>
                            <group>
                                <field name="pension_fund"/>
                                <field name="pension_reference"/>
                                <field name="pension_start_date"/>
                            </group>
                            <group>
                                <field name="pension_employee_percentage"/>
                                <field name="pension_employer_percentage"/>
                            </group>
                        </group>
                        <group>
                            <field name="pension_notes" nolabel="1"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>