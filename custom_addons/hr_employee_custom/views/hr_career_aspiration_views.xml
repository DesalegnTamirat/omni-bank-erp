<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =====================================================
             CAREER ASPIRATION - LIST VIEW
        ====================================================== -->
        <record id="view_career_aspiration_list" model="ir.ui.view">
            <field name="name">hr.career.aspiration.list</field>
            <field name="model">hr.career.aspiration</field>
            <field name="arch" type="xml">
                <list decoration-muted="state in ('withdrawn','achieved')">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="current_job_id" optional="show"/>
                    <field name="target_job_id"/>
                    <field name="career_interest_type" optional="hide"/>
                    <field name="target_timeframe" optional="hide"/>
                    <field name="submission_date"/>
                    <field name="manager_id" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'approved'"
                           decoration-info="state == 'submitted'"
                           decoration-danger="state == 'cancelled'"
                           decoration-muted="state in ('withdrawn','achieved')"/>
                </list>
            </field>
        </record>

        <!-- =====================================================
             CAREER ASPIRATION - FORM VIEW (Main Gap Analysis UI)
        ====================================================== -->
        <!-- =====================================================
             CAREER ASPIRATION - FORM VIEW (Main Gap Analysis UI)
        ====================================================== -->
        <record id="view_career_aspiration_form" model="ir.ui.view">
            <field name="name">hr.career.aspiration.form</field>
            <field name="model">hr.career.aspiration</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <!-- Employee actions -->
                        <button name="action_submit" string="Submit for Review"
                                type="object" class="oe_highlight"
                                invisible="state != 'draft' or not is_owner"/>
                        <button name="action_withdraw" string="Withdraw"
                                type="object"
                                invisible="state in ('withdrawn','achieved','draft') or not is_owner"/>

                        <!-- Manager actions -->
                        <button name="action_approve" string="Approve Aspiration"
                                type="object" class="oe_highlight"
                                invisible="state != 'submitted' or not is_manager_user"
                                groups="hr_employee_custom.group_career_path_manager"/>
                        <button name="action_cancel_aspiration" string="Cancel"
                                type="object" class="btn-secondary"
                                invisible="state != 'submitted' or not is_manager_user"
                                groups="hr_employee_custom.group_career_path_manager"/>
                        <button name="action_mark_achieved" string="Mark as Achieved"
                                type="object" class="btn-success"
                                invisible="state != 'approved' or not is_manager_user"
                                groups="hr_employee_custom.group_career_path_admin"/>

                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,approved"/>
                    </header>

                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <widget name="web_ribbon" title="Achieved" bg_color="text-bg-success" invisible="state != 'achieved' or not active"/>
                        <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled' or not active"/>
                        <field name="is_owner" invisible="1"/>
                        <field name="is_manager_user" invisible="1"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_idp" type="object" class="oe_stat_button" icon="fa-tasks">
                                <field name="idp_count" widget="statinfo" string="IDP Plans"/>
                            </button>
                        </div>

                        <!-- Reference and Header Title -->
                        <div class="alert alert-danger mb-3" role="alert" invisible="state != 'cancelled'">
                            <div class="d-flex align-items-center mb-1">
                                <i class="fa fa-times-circle fa-lg me-2 text-danger"/>
                                <strong class="fs-6">Career Aspiration Cancelled</strong>
                            </div>
                            <div class="mt-2 ms-4">
                                <div><b>Reason: </b><field name="cancel_reason" readonly="1" class="d-inline"/></div>
                                <div class="mt-1"><b>Justification: </b><field name="cancel_justification" readonly="1" class="d-inline"/></div>
                                <div class="text-muted mt-1 small">
                                    Cancelled by <field name="cancel_by_user_id" readonly="1" class="d-inline"/> on <field name="cancel_date" readonly="1" class="d-inline"/>.
                                </div>
                            </div>
                        </div>

                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>

                        <!-- Core Fields Section: Current Role vs. Target Aspiration -->
                        <group>
                            <group string="Current Employee Profile">
                                <field name="employee_id" readonly="state != 'draft' and not is_manager_user"/>
                                <field name="current_job_id"/>
                                <field name="current_department_id"/>
                                <field name="current_grade_id"/>
                            </group>
                            <group string="Target Career Aspiration">
                                <field name="target_job_id" readonly="state != 'draft' and not is_manager_user" options="{'no_create': True}"/>
                            </group>
                        </group>

                        <group string="Review &amp; Governance Details">
                            <group>
                                <field name="submission_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="manager_id" readonly="1" string="Reviewing Manager"/>
                            </group>
                        </group>

                        <notebook>

                            <!-- ===== TAB 1: ROLE PREREQUISITES ===== -->
                            <page string="Role Prerequisites" name="prerequisites">
                                <div class="text-muted mb-3">
                                    <i class="fa fa-info-circle me-1" title="Info"/>
                                    Comparison between current credentials and target position benchmarks to guide your Individual Career Development Plan (ICDP).
                                </div>
                                <group>
                                    <!-- Experience & Service -->
                                    <group string="Experience &amp; Tenure">
                                        <field name="current_tenure_years" string="Current Service (Years)"/>
                                        <field name="required_tenure_years" string="Required Service (Years)"/>
                                        <field name="tenure_gap" string="Experience Gap (Years)" invisible="tenure_gap &lt;= 0"/>
                                    </group>

                                    <!-- Performance Benchmark -->
                                    <group string="Performance (PMS Rating)">
                                        <field name="latest_pms_score" string="Latest PMS Rating"/>
                                        <field name="required_pms_score" string="Benchmark Required PMS"/>
                                    </group>
                                </group>

                                <group string="Education &amp; Qualifications" invisible="not required_qualification and not employee_qualification">
                                    <group>
                                        <field name="employee_qualification" string="Recorded Education"/>
                                    </group>
                                    <group>
                                        <field name="required_qualification" string="Target Required Education"/>
                                    </group>
                                </group>
                            </page>

                            <!-- ===== TAB 2: CAREER MOTIVATION & GOALS ===== -->
                            <page string="Career Motivation &amp; Goals" name="notes">
                                <group>
                                    <field name="notes" string="Career Motivation &amp; Goals" required="1"
                                           placeholder="Describe why you are interested in this target role, your professional goals, and key achievements you want to highlight..."/>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- =====================================================
             CAREER ASPIRATION - SEARCH VIEW
        ====================================================== -->
        <record id="view_career_aspiration_search" model="ir.ui.view">
            <field name="name">hr.career.aspiration.search</field>
            <field name="model">hr.career.aspiration</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="employee_id"/>
                                        <field name="target_job_id"/>
                    <filter string="My Aspirations" name="my_aspirations"
                            domain="[('employee_id.user_id', '=', uid)]"/>
                    <filter string="My Team" name="my_team"
                            domain="[('employee_id.parent_id.user_id', '=', uid)]"/>
                    <filter string="Active" name="active"
                            domain="[('state', 'in', ['submitted','approved'])]"/>
                    <filter string="Eligible" name="eligible"
                            domain="[('overall_eligible', '=', 'eligible')]"/>
                    <filter string="Pending Review" name="pending_review"
                            domain="[('state', '=', 'submitted')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <group name="group_by">
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Target Role" name="group_target" context="{'group_by': 'target_job_id'}"/>
                        <filter string="Time Horizon" name="group_timeframe" context="{'group_by': 'target_timeframe'}"/>
                        <filter string="Aspiration Track" name="group_track" context="{'group_by': 'career_interest_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- =====================================================
             CAREER ASPIRATION - KANBAN VIEW
        ====================================================== -->
        <record id="view_career_aspiration_kanban" model="ir.ui.view">
            <field name="name">hr.career.aspiration.kanban</field>
            <field name="model">hr.career.aspiration</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="target_job_id"/>
                    <field name="career_interest_type"/>
                    <field name="target_timeframe"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="employee_id"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body mt-2">
                                    <div>
                                        <i class="fa fa-bullseye text-primary me-1" title="Target"/><b>Target: </b><field name="target_job_id"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- =====================================================
             ACTIONS
        ====================================================== -->
        <record id="action_career_aspiration_all" model="ir.actions.act_window">
            <field name="name">All Career Aspirations</field>
            <field name="res_model">hr.career.aspiration</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="view_career_aspiration_search"/>
            <field name="context">{'search_default_active': 1, 'create': False, 'edit': False}</field>
        </record>

        <record id="action_my_career_aspiration" model="ir.actions.act_window">
            <field name="name">My Aspirations</field>
            <field name="res_model">hr.career.aspiration</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('employee_id.user_id', '=', uid)]</field>
            <field name="context">{'search_default_my_aspirations': 1}</field>
            <field name="search_view_id" ref="view_career_aspiration_search"/>
        </record>

        <record id="action_team_career_aspiration" model="ir.actions.act_window">
            <field name="name">My Team Career Paths</field>
            <field name="res_model">hr.career.aspiration</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">['|', ('employee_id.parent_id.user_id', '=', uid), ('employee_id.coach_id.user_id', '=', uid)]</field>
            <field name="context">{'search_default_my_team': 1, 'create': False}</field>
            <field name="search_view_id" ref="view_career_aspiration_search"/>
        </record>


    <!-- Read-only List View for Aspiration (Team / All) -->
    <record id="view_career_aspiration_list_readonly" model="ir.ui.view">
        <field name="name">hr.career.aspiration.list.readonly</field>
        <field name="model">hr.career.aspiration</field>
        <field name="inherit_id" ref="hr_employee_custom.view_career_aspiration_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">0</attribute>
            </list>
        </field>
    </record>

    <!-- Read-only Form View for Aspiration (Team / All) -->
    <record id="view_career_aspiration_form_readonly" model="ir.ui.view">
        <field name="name">hr.career.aspiration.form.readonly</field>
        <field name="model">hr.career.aspiration</field>
        <field name="inherit_id" ref="hr_employee_custom.view_career_aspiration_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="create">0</attribute>
            </form>
            <xpath expr="//button[@name='action_submit']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_withdraw']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Read-only Kanban View for Aspiration (Team / All) -->
    <record id="view_career_aspiration_kanban_readonly" model="ir.ui.view">
        <field name="name">hr.career.aspiration.kanban.readonly</field>
        <field name="model">hr.career.aspiration</field>
        <field name="inherit_id" ref="hr_employee_custom.view_career_aspiration_kanban"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="create">0</attribute>
            </kanban>
        </field>
    </record>

    <!-- Bindings for Team Aspiration -->
    <record id="action_team_career_aspiration_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_career_aspiration_list_readonly"/>
        <field name="act_window_id" ref="hr_employee_custom.action_team_career_aspiration"/>
    </record>
    <record id="action_team_career_aspiration_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_career_aspiration_kanban_readonly"/>
        <field name="act_window_id" ref="hr_employee_custom.action_team_career_aspiration"/>
    </record>
    <record id="action_team_career_aspiration_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_career_aspiration_form_readonly"/>
        <field name="act_window_id" ref="hr_employee_custom.action_team_career_aspiration"/>
    </record>

    <!-- Bindings for All Aspiration -->
    <record id="action_career_aspiration_all_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_career_aspiration_list_readonly"/>
        <field name="act_window_id" ref="hr_employee_custom.action_career_aspiration_all"/>
    </record>
    <record id="action_career_aspiration_all_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_career_aspiration_kanban_readonly"/>
        <field name="act_window_id" ref="hr_employee_custom.action_career_aspiration_all"/>
    </record>
    <record id="action_career_aspiration_all_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_career_aspiration_form_readonly"/>
        <field name="act_window_id" ref="hr_employee_custom.action_career_aspiration_all"/>
    </record>

    </data>
</odoo>



