<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- ── Form View ── -->
    <record id="bonus_penalty_form" model="ir.ui.view">
        <field name="name">bonus.penalty.form</field>
        <field name="model">bonus.penalty</field>
        <field name="arch" type="xml">
            <form string="Bonus Penalty">
                <sheet>
                    <group>
                        <group>
                            <field name="disciplinary_measure"/>
                            <field name="penalty_factor"/>
                        </group>
                        <group>
                            <!-- 'type="checkbox"' replaced with widget="boolean_toggle" (Odoo 17+) -->
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── List View ── -->
    <record id="bonus_penalty_tree" model="ir.ui.view">
        <field name="name">bonus.penalty.list</field>
        <field name="model">bonus.penalty</field>
        <field name="arch" type="xml">
            <!-- 'tree' renamed to 'list' in Odoo 17+ -->
            <list string="Bonus Penalty">
                <field name="disciplinary_measure"/>
                <field name="penalty_factor"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ── Window Action ── -->
    <record id="action_bonus_penalty" model="ir.actions.act_window">
        <field name="name">Bonus Penalty</field>
        <field name="res_model">bonus.penalty</field>
        <field name="context">{}</field>
        <!-- 'tree' renamed to 'list' in Odoo 17+ -->
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Bonus Penalty records found. Create one!
            </p>
        </field>
    </record>

</odoo>