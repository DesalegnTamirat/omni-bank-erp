<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>

        <record id="view_hr_job_history_list" model="ir.ui.view">
            <field name="name">hr.job.history.list</field>
            <field name="model">hr.job.history</field>
            <field name="arch" type="xml">
                <list string="Job History">
                    <field name="employee_id"/>
                    <field name="job_history_start_date"/>
                    <field name="job_history_end_date"/>
                    <field name="reason_for_change"/>
                    <field name="from_operating_unit_id"/>
                    <field name="to_operating_unit_id"/>
                    <field name="from_department_id"/>
                    <field name="to_department_id"/>
                    <field name="from_grade_id"/>
                    <field name="to_grade_id"/>
                    <field name="from_job_id"/>
                    <field name="to_job_id"/>
                    <field name="old_wage"/>
                    <field name="new_wage"/>
                    <field name="is_current"/>
                </list>
            </field>
        </record>

        <record id="view_hr_job_history_form" model="ir.ui.view">
            <field name="name">hr.job.history.form</field>
            <field name="model">hr.job.history</field>
            <field name="arch" type="xml">
                <form string="Job History">
                    <sheet>
                        <group>
                            <group string="Employee Information &amp; Status">
                                <field name="employee_id"/>
                                <field name="job_history_start_date"/>
                                <field name="job_history_end_date"/>
                                <field name="reason_for_change"/>
                                <field name="is_current"/>
                            </group>
                            <group string="Operating Unit Transition">
                                <field name="from_operating_unit_id"/>
                                <field name="to_operating_unit_id"/>
                            </group>
                        </group>
                        <group>
                            <group string="Department, Grade &amp; Position Transition">
                                <field name="from_department_id"/>
                                <field name="to_department_id"/>
                                <field name="from_grade_id"/>
                                <field name="to_grade_id"/>
                                <field name="from_job_id"/>
                                <field name="to_job_id"/>
                            </group>
                            <group string="Wage / Compensation Transition">
                                <field name="currency_id" invisible="1"/>
                                <field name="old_wage"/>
                                <field name="new_wage"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_job_history" model="ir.actions.act_window">
            <field name="name">Job History</field>
            <field name="res_model">hr.job.history</field>
            <field name="view_mode">list,form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>