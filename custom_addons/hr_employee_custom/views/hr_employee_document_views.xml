<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>


        <record id="hr_document_type_form_view" model="ir.ui.view">
            <field name="name">hr.document.type.form</field>
            <field name="model">hr.document.type</field>
            <field name="arch" type="xml">
                <form string="Document Type">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"   string="Document Type"/>
                                <field name="code"   string="Code"/>
                                <field name="active" string="Active"/>
                            </group>
                            <group>
                                <field name="description"
                                       string="Description"
                                       placeholder="Optional description…"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List view for hr.document.type -->
        <record id="hr_document_type_list_view" model="ir.ui.view">
            <field name="name">hr.document.type.list</field>
            <field name="model">hr.document.type</field>
            <field name="arch" type="xml">
                <list string="Document Types">
                    <field name="name"        string="Document Type"/>
                    <field name="code"        string="Code"/>
                    <field name="description" string="Description"/>
                    <field name="active"      string="Active"/>
                </list>
            </field>
        </record>

        <!-- Window action for hr.document.type -->
        <record id="act_hr_document_type" model="ir.actions.act_window">
            <field name="name">Document Types</field>
            <field name="res_model">hr.document.type</field>
            <field name="view_mode">list,form</field>
        </record>


        <record id="hr_employee_document_form_view" model="ir.ui.view">
            <field name="name">hr.employee.document.form</field>
            <field name="model">hr.employee.document</field>
            <field name="arch" type="xml">
                <form string="Employee Document">
                    <sheet>
                        <group col="2">
                            <!-- Left column -->
                            <group>
                                <field name="name"             string="Document Number"/>
                                <field name="document_name"    string="Document Name"/>
                                <field name="employee_ref"     string="Employee"/>
                                <field name="document_type_id" string="Document Type"
                                       options="{'no_open': False, 'no_create': False}"/>
                            </group>
                            <!-- Right column -->
                            <group>
                                <field name="issue_date"        string="Issue Date"/>
                                <field name="expiry_date"       string="Expiry Date"/>
                                <field name="notification_type" string="Notification Type"/>
                                <field name="before_days"       string="Days"/>
                            </group>
                        </group>

                        <!-- Attachment — binary widget serves the file with the correct
                             Content-Type so PDFs open inline and images preview in browser.
                             The base64 data is stored directly in the DB column. -->
                        <group string="Attachment">
                            <field name="attachment_filename" invisible="1"/>
                            <field name="attachment"
                                   widget="binary"
                                   filename="attachment_filename"
                                   string="Attachment"
                                   colspan="2"/>
                        </group>

                        <notebook>
                            <page string="Description" name="description_tab">
                                <field name="description"
                                       placeholder="Enter additional notes or description…"
                                       nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="hr_employee_document_list_view" model="ir.ui.view">
            <field name="name">hr.employee.document.list</field>
            <field name="model">hr.employee.document</field>
            <field name="arch" type="xml">
                <list string="Employee Documents">
                    <field name="name"             string="Document Number"/>
                    <field name="employee_ref"     string="Employee"/>
                    <field name="document_type_id" string="Document Type"/>
                    <field name="expiry_date"      string="Expiry Date"/>
                    <field name="attachment_filename" string="File" optional="show"/>
                </list>
            </field>
        </record>

        <!-- ============================================================
             EMPLOYEE DOCUMENT — Search View (Odoo 19 compatible)
        ============================================================ -->
        <record id="hr_employee_document_search_view" model="ir.ui.view">
            <field name="name">hr.employee.document.search</field>
            <field name="model">hr.employee.document</field>
            <field name="arch" type="xml">
                <search string="Search Documents">
                    <field name="name"             string="Document Number"/>
                    <field name="employee_ref"     string="Employee"/>
                    <field name="document_type_id" string="Document Type"/>
                    <separator/>
                    <filter name="group_employee"
                            string="Employee"
                            context="{'group_by': 'employee_ref'}"/>
                    <filter name="group_document_type"
                            string="Document Type"
                            context="{'group_by': 'document_type_id'}"/>
                </search>
            </field>
        </record>

        <!-- ============================================================
             WINDOW ACTION — smart button (filtered to active employee)
        ============================================================ -->
        <record id="act_hr_employee_2_documents" model="ir.actions.act_window">
            <field name="name">Documents</field>
            <field name="res_model">hr.employee.document</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('employee_ref', '=', active_id)]</field>
            <field name="context">{
                'search_default_employee_ref': active_id,
                'default_employee_ref': active_id
            }</field>
        </record>

        <!-- ============================================================
             WINDOW ACTION — general menu action (all documents)
        ============================================================ -->
        <record id="action_hr_employee_document_all" model="ir.actions.act_window">
            <field name="name">Documents</field>
            <field name="res_model">hr.employee.document</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
        </record>

        <!-- ============================================================
             INJECT SMART BUTTON — after "In Contract Since" button
        ============================================================ -->
        <record id="hr_employee_document_smart_button" model="ir.ui.view">
            <field name="name">hr.employee.document.smart.button</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr_employee_custom.view_hr_employee_master_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='%(hr_employee_custom.act_hr_employee_2_hr_contract)d']"
                       position="after">
                    <field name="document_count" invisible="1"/>
                    <button name="%(hr_employee_custom.act_hr_employee_2_documents)d"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            type="action"
                            context="{'search_default_employee_ref': id,
                                      'default_employee_ref': id}">
                        <div class="o_stat_info">
                            <span class="o_stat_value">
                                <field name="document_count"/>
                            </span>
                            <span class="o_stat_text">Documents</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
