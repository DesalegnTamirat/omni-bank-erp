<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_hr_employee_change_history_tree" model="ir.ui.view">
        <field name="name">hr.employee.change.history.list</field>
        <field name="model">hr.employee.change.history</field>
        <field name="arch" type="xml">
            <list string="Master Data Change Audit Log" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="applied_date"/>
                <field name="employee_id"/>
                <field name="field_description"/>
                <field name="old_value" decoration-danger="1"/>
                <field name="new_value" decoration-success="1"/>
                <field name="change_type"/>
                <field name="applied_by_id"/>
                <field name="change_request_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_employee_change_history_form" model="ir.ui.view">
        <field name="name">hr.employee.change.history.form</field>
        <field name="model">hr.employee.change.history</field>
        <field name="arch" type="xml">
            <form string="Audit Log Entry" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Employee &amp; Timing">
                            <field name="employee_id"/>
                            <field name="applied_date"/>
                            <field name="applied_by_id"/>
                            <field name="change_request_id"/>
                        </group>
                        <group string="Field Change Details">
                            <field name="field_description"/>
                            <field name="field_name"/>
                            <field name="change_type"/>
                        </group>
                    </group>
                    <group string="Values Comparison">
                        <group string="Original Value (Old)">
                            <field name="old_value" nolabel="1"/>
                        </group>
                        <group string="Updated Value (New)">
                            <field name="new_value" nolabel="1"/>
                        </group>
                    </group>
                    <group string="Audit Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_employee_change_history_search" model="ir.ui.view">
        <field name="name">hr.employee.change.history.search</field>
        <field name="model">hr.employee.change.history</field>
        <field name="arch" type="xml">
            <search string="Search Audit Log">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="field_description"/>
                <field name="applied_by_id"/>
                <filter string="Name Changes" name="type_name" domain="[('change_type', '=', 'name')]"/>
                <filter string="Marital Changes" name="type_marital" domain="[('change_type', '=', 'marital')]"/>
                <filter string="Education Changes" name="type_education" domain="[('change_type', '=', 'education')]"/>
                <separator/>
                <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Change Type" name="group_type" context="{'group_by': 'change_type'}"/>
                <filter string="Applied Date" name="group_date" context="{'group_by': 'applied_date:day'}"/>
                <filter string="Applied By" name="group_user" context="{'group_by': 'applied_by_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_employee_change_history" model="ir.actions.act_window">
        <field name="name">Master Data Change Audit Log</field>
        <field name="res_model">hr.employee.change.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_employee_change_history_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No audit log entries found. Complete master data changes will be automatically recorded here.
            </p>
        </field>
    </record>
</odoo>
