<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_hr_employee_change_request_tree" model="ir.ui.view">
        <field name="name">hr.employee.change.request.list</field>
        <field name="model">hr.employee.change.request</field>
        <field name="arch" type="xml">
            <list string="Master Data Change Requests" sample="1">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="requested_by_id"/>
                <field name="request_date"/>
                <field name="attachment_count" string="Docs"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('submitted', 'under_review')"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_employee_change_request_form" model="ir.ui.view">
        <field name="name">hr.employee.change.request.form</field>
        <field name="model">hr.employee.change.request</field>
        <field name="arch" type="xml">
            <form string="Master Data Change Request">
                <header>
                    <button name="action_submit" string="Submit Request" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_review" string="Mark as Reviewed" type="object" class="btn-secondary"
                            invisible="state != 'submitted'" groups="hr.group_hr_user,hr.group_hr_manager"/>
                    <button name="action_approve" string="Approve &amp; Update Employee" type="object" class="btn-success"
                            invisible="state not in ('submitted', 'under_review')" groups="hr.group_hr_user,hr.group_hr_manager"/>
                    <button name="action_reject" string="Reject Request" type="object" class="btn-danger"
                            invisible="state not in ('submitted', 'under_review')" groups="hr.group_hr_user,hr.group_hr_manager"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-link"
                            invisible="state not in ('rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-warning text-center fw-bold" role="alert" invisible="not requires_attachment_notice">
                        <i class="fa fa-exclamation-triangle me-2" title="Warning"/>
                        <field name="requires_attachment_notice" readonly="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Request Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Employee Information">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="job_id"/>
                            <field name="department_id"/>
                        </group>
                        <group string="Audit &amp; Request Tracking">
                            <field name="requested_by_id"/>
                            <field name="request_date"/>
                            <field name="reviewed_by_id" invisible="not reviewed_by_id"/>
                            <field name="review_date" invisible="not review_date"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approval_date" invisible="not approval_date"/>
                            <field name="rejected_by_id" invisible="not rejected_by_id"/>
                            <field name="rejection_date" invisible="not rejection_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requested Field Changes" name="changes">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="field_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="field_description"/>
                                    <field name="old_value" readonly="1"/>
                                    <field name="is_selection" column_invisible="1"/>
                                    <field name="new_value" invisible="is_selection" placeholder="Enter new value..."/>
                                    <field name="new_value_selection" invisible="not is_selection" string="New Requested Value"/>
                                    <field name="change_type"/>
                                    <field name="requires_attachment" widget="boolean_toggle" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Supporting Documents" name="attachments">
                            <p class="text-muted">
                                Upload legal proof or supporting evidence (e.g. Legal Name Change document, Marriage/Divorce certificate, Degree certificate) required for approval.
                            </p>
                            <field name="attachment_ids" widget="many2many_binary" readonly="state in ('approved', 'rejected')"/>
                        </page>
                        <page string="Rejection Info" name="rejection" invisible="state != 'rejected' and not rejection_reason">
                            <group>
                                <field name="rejection_reason" readonly="state in ('approved', 'rejected')" placeholder="State reason for rejecting request..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_employee_change_request_search" model="ir.ui.view">
        <field name="name">hr.employee.change.request.search</field>
        <field name="model">hr.employee.change.request</field>
        <field name="arch" type="xml">
            <search string="Search Change Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="requested_by_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Under Review" name="under_review" domain="[('state', '=', 'under_review')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Requester" name="group_requester" context="{'group_by': 'requested_by_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_employee_change_request" model="ir.actions.act_window">
        <field name="name">Master Data Change Requests</field>
        <field name="res_model">hr.employee.change.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_employee_change_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Submit a new Employee Master Data Change Request.
            </p>
            <p>
                Request updates to employee fields such as Name, Marital Status, Phone, Address, or Education with supporting document attachments.
            </p>
        </field>
    </record>
</odoo>
