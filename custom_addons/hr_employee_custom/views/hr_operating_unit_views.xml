<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- ═══════════════════════════════════════════
         OPERATING UNIT — Form view
    ════════════════════════════════════════════ -->
    <record id="view_hr_operating_unit_form" model="ir.ui.view">
        <field name="name">operating.unit.hr.form</field>
        <field name="model">operating.unit</field>
        <field name="arch" type="xml">
            <form string="Operating Unit">
                <header>
                    <button name="action_save_operating_unit" string="Save" type="object" class="btn-primary" save="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Addis Ababa Branch" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="sol_id" placeholder="e.g. 1001" required="1"/>
                            <field name="code" placeholder="e.g. 10001"/>
                            <field name="manager_id" placeholder="Manager Name"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="branch_grade"/>
                            <field name="region"/>
                        </group>
                        <group>
                            <field name="work_unit_type" required="1"/>
                            <field name="department"/>
                            <field name="parent_unit"/>
                            <field name="latitude"/>
                            <field name="longitude"/>

                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="hardship_allowance"/>
                        </group>
                        <group>
<!--                            <field name="company_id" context="{'res_partner_search_mode': 'customer'}"/>-->
                            <field name="company_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Job Positions &amp; Establishment" name="job_positions">
                            <field name="job_position_ids" context="{'default_operating_unit_id': id}">
                                <list editable="bottom"
                                      delete="0"
                                      decoration-danger="vacant_position_count &gt; 0"
                                      decoration-success="vacant_position_count == 0"
                                      decoration-info="vacant_position_count &lt; 0"
                                      decoration-muted="not active">
                                    <field name="job_position_id" string="Job Position"/>
                                    <field name="job_grade_id" string="Grade" optional="show"/>
                                    <field name="active" widget="boolean_toggle" string="Active" optional="hide"/>
                                    <field name="total_headcount" string="Total Headcount" sum="Total Headcount" readonly="1" class="fw-bold"/>
                                    <field name="baseline_count" string="Baseline Count" sum="Total Baseline" readonly="1"
                                           help="Auto-computed from active employees with an open or probation contract."/>
                                    <field name="approved_plan_count" string="Approved Plan" sum="Total Approved Plan"/>
                                    <field name="active_employee_count"
                                           string="Active Employees"
                                           sum="Total Active"
                                           readonly="1"
                                           class="fw-bold"/>
                                    <field name="vacant_position_count"
                                           string="Vacant Posts"
                                           sum="Total Vacant"
                                           readonly="1"
                                           class="fw-bold text-danger"/>
                                    <field name="lateral_count" string="Lateral" readonly="1" optional="show"/>
                                    <field name="replacement_count" string="Replacement" readonly="1" optional="show"/>
                                    <field name="promotion_count" string="Promotion" readonly="1" optional="show"/>
                                    <field name="resignation_count" string="Resignation" readonly="1" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════
         OPERATING UNIT — List view
    ════════════════════════════════════════════ -->
    <record id="view_hr_operating_unit_list" model="ir.ui.view">
        <field name="name">operating.unit.hr.list</field>
        <field name="model">operating.unit</field>
        <field name="arch" type="xml">
            <list string="Operating Units" decoration-muted="not active" delete="0">
                <field name="sol_id" string="Sol ID"/>
                <field name="name" string="Name"/>
                <field name="code" string="Code"/>
                <field name="manager_id" placeholder="Manager Name" optional="show"/>
                <field name="latitude" optional="show"/>
                <field name="longitude" optional="show"/>
                <field name="district"/>
                <field name="region"/>
                <field name="work_unit_type" string="Type" widget="badge"/>
                <field name="parent_unit" string="Parent Unit" optional="show"/>
                <field name="branch_grade" string="Grade" optional="show"/>
                <field name="hardship_allowance" string="Hardship %" optional="show"/>
                <field name="active" string="Active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════
         OPERATING UNIT — Search view
    ════════════════════════════════════════════ -->
    <record id="view_hr_operating_unit_search" model="ir.ui.view">
        <field name="name">operating.unit.hr.search</field>
        <field name="model">operating.unit</field>
        <field name="arch" type="xml">
            <search string="Search Operating Units">
                <field name="name" string="Name"/>
                <field name="sol_id" string="Sol ID"/>
                <field name="code" string="Code"/>
                <field name="manager_id" string="Manager"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="district"/>
                <field name="region"/>
                <field name="work_unit_type" string="Work Unit Type"/>
                <field name="parent_unit" string="Parent Unit"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_by_work_unit_type" string="Work Unit Type"
                        context="{'group_by': 'work_unit_type'}"/>
                <filter name="group_by_parent" string="Parent Unit" context="{'group_by': 'parent_unit'}"/>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════
         OPERATING UNIT — Action
    ════════════════════════════════════════════ -->
    <record id="action_hr_operating_unit" model="ir.actions.act_window">
        <field name="name">Operating Units</field>
        <field name="res_model">operating.unit</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ═══════════════════════════════════════════
         OPERATING UNIT JOB POSITION — Form view
    ════════════════════════════════════════════ -->
    <record id="view_operating_unit_job_position_form" model="ir.ui.view">
        <field name="name">operating.unit.job.position.form</field>
        <field name="model">operating.unit.job.position</field>
        <field name="arch" type="xml">
            <form string="Job Position Establishment">
                <header>
                    <button name="action_create_vacancy"
                            string="Create Vacancy"
                            type="object"
                            class="oe_highlight btn-primary"
                            icon="fa-plus-circle"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vacancies"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-briefcase">
                            <field name="vacancy_count" widget="statinfo" string="Vacancies"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="job_position_id" class="oe_edit_only" string="Job Position"/>
                        <h1>
                            <field name="job_position_id" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="operating_unit_id" readonly="1" class="text-muted"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Establishment &amp; Grade">
                            <field name="job_grade_id" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Headcount &amp; Vacancy Status">
                            <field name="baseline_count" readonly="1"/>
                            <field name="approved_plan_count" readonly="1"/>
                            <field name="plan_fulfillment_promotion" readonly="1"/>
                            <field name="plan_fulfillment_lateral" readonly="1"/>
                            <field name="plan_fulfillment_external" readonly="1"/>
                            <field name="total_headcount" readonly="1" class="fw-bold"/>
                            <field name="active_employee_count" readonly="1" class="fw-bold"/>
                            <field name="vacant_position_count" readonly="1" class="fw-bold text-danger"/>
                        </group>
                    </group>
                    <group string="Staff Movements / Lifecycle">
                        <group>
                            <field name="lateral_count" readonly="1"/>
                            <field name="replacement_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="promotion_count" readonly="1"/>
                            <field name="resignation_count" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════
         OPERATING UNIT JOB POSITION — List view
    ════════════════════════════════════════════ -->
    <record id="view_operating_unit_job_position_list" model="ir.ui.view">
        <field name="name">operating.unit.job.position.list</field>
        <field name="model">operating.unit.job.position</field>
        <field name="arch" type="xml">
            <list string="Vacant Positions (Staffing Gaps)"
                  decoration-danger="vacant_position_count &gt; 0"
                  decoration-success="vacant_position_count == 0"
                  decoration-info="vacant_position_count &lt; 0"
                  decoration-muted="not active">
                <field name="operating_unit_id" string="Work Unit"/>
                <field name="job_position_id" string="Job Position"/>
                <field name="job_grade_id" string="Job Grade" optional="show"/>
                <field name="baseline_count" string="Baseline Count" optional="show"/>
                <field name="approved_plan_count" string="Approved Plan Count" optional="show"/>
                <field name="total_headcount" string="Total Headcount" class="fw-bold"/>
                <field name="active_employee_count" string="Active Employees" class="fw-bold"/>
                <field name="vacant_position_count" string="Vacant Positions" class="fw-bold text-danger"/>
                <button name="action_create_vacancy"
                        string="Create Vacancy"
                        type="object"
                        icon="fa-plus-circle"
                        class="btn-primary btn-sm"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════
         OPERATING UNIT JOB POSITION — Search view
    ════════════════════════════════════════════ -->
    <record id="view_operating_unit_job_position_search" model="ir.ui.view">
        <field name="name">operating.unit.job.position.search</field>
        <field name="model">operating.unit.job.position</field>
        <field name="arch" type="xml">
            <search string="Search Operating Unit Job Positions">
                <field name="job_position_id" string="Job Position"/>
                <field name="operating_unit_id" string="Work Unit"/>
                <field name="job_grade_id" string="Job Grade"/>
                <separator/>
                <filter name="filter_vacant" string="Vacant Positions" domain="[('vacant_position_count', '&gt;', 0)]"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_by_operating_unit" string="Work Unit" context="{'group_by': 'operating_unit_id'}"/>
                <filter name="group_by_job_position" string="Job Position" context="{'group_by': 'job_position_id'}"/>
                <filter name="group_by_job_grade" string="Job Grade" context="{'group_by': 'job_grade_id'}"/>
            </search>
        </field>
    </record>

</odoo>