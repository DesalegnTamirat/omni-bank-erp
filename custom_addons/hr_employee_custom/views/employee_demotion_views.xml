<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ─── Form View ─────────────────────────────────────────────── -->
    <record id="employee_demotion_form_view" model="ir.ui.view">
        <field name="name">employee.demotion.form</field>
        <field name="model">employee.demotion</field>
        <field name="arch" type="xml">
            <form string="Employee Demotion">
                <header>
                    <button name="populate_benefits" string="Populate Benefits" type="object" class="btn-primary" invisible="state in ('populate_benefits', 'populate_payout', 'approve')"/>
                    <button name="populate_payout" string="Populate Payouts" type="object" class="btn-primary" invisible="state in ('draft', 'populate_payout', 'approve')"/>
                    <button name="approve" string="Approve" type="object" class="btn-primary" invisible="state in ('draft', 'populate_benefits', 'approve')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,populate_benefits,populate_payout,approve"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ref_num"/>
                            <field name="employee_name"/>
                            <field name="current_work_unit"/>
                            <field name="job_position"/>
                            <field name="job_grade"/>
                        </group>
                        <group>
                            <field name="new_job_title"/>
                            <field name="new_job_grade"/>
                            <field name="new_work_unit"/>
                            <field name="change_date"/>
                            <field name="reason"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="job_history_start_date"/>
                            <field name="job_history_end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Salary Detail Changes">
                            <field name="salary_det_demotion">
                                <list string="Demotion Employee Salary Details" editable="bottom">
                                    <!-- PAYROLL MODULE NOT INSTALLED: <field name="salary_rule"/> -->
                                    <field name="value"/>
                                    <field name="end_date"/>
                                    <field name="revised_value"/>
                                    <field name="start_date"/>
                                    <field name="total_value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── List View ─────────────────────────────────────────────── -->
    <record id="employee_demotion_list_view" model="ir.ui.view">
        <field name="name">employee.demotion.list</field>
        <field name="model">employee.demotion</field>
        <field name="arch" type="xml">
            <list string="Employee Demotion">
                <field name="ref_num"/>
                <field name="employee_name"/>
                <field name="job_name"/>
                <field name="job_grade"/>
                <field name="new_job_title"/>
                <field name="change_date"/>
                <field name="reason"/>
                <field name="status"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ─── Action ────────────────────────────────────────────────── -->
    <record id="employee_demotion_action" model="ir.actions.act_window">
        <field name="name">Employee Demotion</field>
        <field name="res_model">employee.demotion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>