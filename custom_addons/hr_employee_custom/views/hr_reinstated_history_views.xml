<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>

        <record id="view_hr_reinstated_history_list" model="ir.ui.view">
            <field name="name">hr.reinstated.history.list</field>
            <field name="model">hr.reinstated.history</field>
            <field name="arch" type="xml">
                <list string="Re instated History">
                    <field name="new_job_grade_id"/>
                    <field name="job_title"/>
                    <field name="new_salary"/>
                    <field name="date"/>
                </list>
            </field>
        </record>

        <record id="view_hr_reinstated_history_form" model="ir.ui.view">
            <field name="name">hr.reinstated.history.form</field>
            <field name="model">hr.reinstated.history</field>
            <field name="arch" type="xml">
                <form string="Re instated History">
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="new_job_grade_id"/>
                            <field name="job_title"/>
                        </group>
                        <group>
                            <field name="new_salary"/>
                            <field name="date"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_hr_reinstated_history" model="ir.actions.act_window">
            <field name="name">Re instated History</field>
            <field name="res_model">hr.reinstated.history</field>
            <field name="view_mode">list,form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>