<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="supplementary_role_form" model="ir.ui.view">
        <field name="name">supplementary.role.form</field>
        <field name="model">supplementary.role</field>
        <field name="arch" type="xml">
            <form string="Supplementary Role">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,approved"/>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_under_review" string="Under Review" type="object" class="oe_highlight" invisible="state != 'submitted' or not can_review_or_approve"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'under_review' or not can_review_or_approve"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state not in ('submitted', 'under_review') or not can_review_or_approve"/>
                    <button name="action_print_acting_letter" string="Print Acting Letter" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                </header>
                <sheet>
                    <field name="is_managerial" invisible="1"/>
                    <field name="can_review_or_approve" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="reference" required="1"/>
                        </h1>
                    </div>
                    <group colspan="4">
                        <group name="Acting Role" string="Acting Role">
                            <field name="allowed_operating_unit_ids" invisible="1"/>
                            <field name="requesting_operating_unit" domain="[('id', 'in', allowed_operating_unit_ids)]" readonly="state != 'draft'"/>
                            <field name="acting_position" readonly="state != 'draft'" required="1"/>
                            <field name="acting_employee" readonly="state != 'draft'" required="1"/>
                            <field name="job_grade1" readonly="1"/>
                            <field name="job_category1" readonly="1"/>
                            <field name="is_managerial" readonly="1" string="Is Managerial Position"/>
                            <field name="acting_reason" readonly="state != 'draft'"/>
                        </group>
                        <group name="Existing Role" string="Existing Role">
                            <field name="employee_name" readonly="1" force_save="1"/>
                            <field name="employee_id" invisible="1"/>
                            <field name="current_job_position" readonly="1" force_save="1"/>
                            <field name="current_work_unit" readonly="1" force_save="1"/>
                            <field name="job_grade" readonly="1" force_save="1"/>
                            <field name="job_category" readonly="1" force_save="1"/>
                        </group>
                        <group name="Dates" string="Assignment Duration">
                            <field name="start_date" readonly="state != 'draft'" required="1"/>
                            <field name="payment_date_start" readonly="1" force_save="1"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                            <field name="revoked_date" invisible="not revoked_date"/>
                        </group>
                    </group> 
                </sheet>
            </form>
        </field>
    </record>

    <record id="supplementary_role_tree" model="ir.ui.view">
        <field name="name">supplementary.role.tree</field>
        <field name="model">supplementary.role</field>
        <field name="arch" type="xml">
            <list string="Supplementary Role">
                <field name="reference"/>
                <field name="employee_name"/>
                <field name="acting_position"/>
                <field name="is_managerial" string="Managerial"/>
                <field name="acting_reason"/>
                <field name="start_date"/>
                <field name="payment_date_start"/>
                <field name="end_date"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-warning="state == 'under_review'" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="employee_supplementary_role_tree" model="ir.actions.act_window">
        <field name="name">Supplementary Role</field>
        <field name="res_model">supplementary.role</field>
        <field name="context">{}</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Supplementary Role menu is accessed under 'Employee Service' (menu_supplementary_role_list in menu.xml).
         Header root menu is deactivated as requested. -->
    <record id="supplementary_role_menu" model="ir.ui.menu">
        <field name="name">Supplementary Role</field>
        <field name="parent_id" ref="hr.menu_hr_root"/>
        <field name="action" ref="employee_supplementary_role_tree"/>
        <field name="sequence">20</field>
        <field name="active" eval="False"/>
    </record>
</odoo>