<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="action_payroll_adjustment_form" model="ir.actions.act_window">
        <field name="name">Payroll Adjustment Form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.payroll.adjustments</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">create!</p>
        </field>
    </record>

    <record id="payroll_adjustment_tree_view" model="ir.ui.view">
        <field name="name">hr.payroll.adjustments.tree</field>
        <field name="model">hr.payroll.adjustments</field>
        <field name="arch" type="xml">
            <list string="Payroll Adjustment Form">
                <field name="particulars"/>
                            <field name="transaction_date"/>
                            <!-- <field name="payroll_period"/> commented: hr.period model missing -->
                            <field name="status"/>
            </list>
        </field>
    </record>
    <record id="payroll_adjustment_form_view" model="ir.ui.view">
        <field name="name">hr.payroll.adjustments.form</field>
        <field name="model">hr.payroll.adjustments</field>
        <field name="arch" type="xml">
            <form string="Payroll Adjustment Form">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="notify" invisible="state in ('notify', 'approve')" string="Notify" type="object" class="oe_highlight"/>
                    <button name="evaluate" invisible="state in 'approve'" string="Evaluate" type="object" class="oe_highlight"/>
                    <button name="upload_data" invisible="state in 'upload_data'" string="Upload Data" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                     <div class="oe_title">
                        <h1>
                            <field name="reference" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="particulars"/>
                            <field name="transaction_date"/>
                        </group>
                        <group>
                            <!-- <field name="payroll_period"/> commented: hr.period model missing -->
                            <field name="status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Adjustment Details">
                            <field name="adj_det_id">
                                <list editable="bottom">
                                    <field name="employee_id" width="20%"/>
									<field name="adjustment_nature" width="20%"/>
									<!-- PAYROLL MODULE NOT INSTALLED: <field name="adjustment_type" width="20%"/> -->
									<field name="bank_account" width="20%"/>
                                    <field name="adjustment_amount" width="20%"/>
                                    <field name="adjustment_comments" width="20%"/>
                                </list>
                            </field>
                        </page>
                </notebook>
                 <notebook>
                        <page string="Payroll Adjustment Approval Members">
                            <field name="payroll_del_id">
                                <list editable="bottom">
                                        <field name="role" width="20%"/>
                                        <field name="employee_name" width="20%"/>
                                        <field name="operating_unit" width="20%"/>
                                        <field name="status" width="20%"/>
                                        <field name="alternate_committee_member" width="20%"/>
                                        <field name="alter_operating_unit" width="20%"/>
                                        <field name="approve" width="20%"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
                            </form>
        </field>
    </record>
    <menuitem id="menu_payroll_adjustment" name="Payroll Adjustment" parent="hr.menu_human_resources_configuration" action="action_payroll_adjustment_form" sequence="50"/>
</odoo>