<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Action: Employee Service Request -->
    <record id="action_employee_service_request" model="ir.actions.act_window">
        <field name="name">Employee Service Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.service.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new Employee Service Request!</p>
        </field>
    </record>

    <!-- List View: Employee Service Request -->
    <record id="emp_service_request_tree_view" model="ir.ui.view">
        <field name="name">employee.service.request.list</field>
        <field name="model">employee.service.request</field>
        <field name="arch" type="xml">
            <list string="Employee Service Request">
                <field name="reference"/>
                <field name="employee_id"/>
                <field name="letter_name"/>
                <field name="employee_work_unit"/>
                <field name="sr_date"/>
                <field name="status" widget="badge" decoration-success="status == 'completed'" decoration-info="status in ('submitted', 'in_progress')" decoration-danger="status == 'rejected'" decoration-muted="status == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Form View: Employee Service Request -->
    <record id="emp_service_request_form_view" model="ir.ui.view">
        <field name="name">employee.service.request.form</field>
        <field name="model">employee.service.request</field>
        <field name="arch" type="xml">
            <form string="Employee Service Request">
                <header>
                    <button name="action_fetch_employee_data" string="Refresh Data" type="object" class="btn btn-secondary" invisible="status != 'draft'"/>
                    <button name="notify" string="Submit" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_accept" string="Accept" type="object" class="oe_highlight" groups="hr_employee_custom.group_service_request_manager" invisible="status != 'submitted'"/>
                    <button name="action_complete" string="Complete" type="object" class="oe_highlight" groups="hr_employee_custom.group_service_request_manager" invisible="status != 'in_progress'"/>
                    <button name="action_reject_wizard" string="Reject" type="object" groups="hr_employee_custom.group_service_request_manager" invisible="status not in ('submitted', 'in_progress')"/>
                    <button name="action_print_support_letter" string="Print Support Letter" type="object" class="oe_highlight" invisible="letter_name != 'Support Letter' or status != 'completed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,submitted,in_progress,completed,rejected" options="{'fold_field': 'status'}" class="oe_highlight" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="reference"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="letter_name" required="1" readonly="status != 'draft'"/>
                            <field name="sr_category" invisible="1"/>
                            <field name="sr_type" invisible="1"/>
                        </group>
                        <group>
                            <field name="authorizing_office" readonly="1"/>
                            <field name="sr_date" readonly="1"/>
                            <field name="sr_comments" readonly="status != 'draft'"/>
                        </group>
                    </group>
                    <group string="Employee Information">
                        <group>
                            <field name="employee_id"/>
                            <field name="employee_manager"/>
                            <field name="manager_user_id" invisible="1"/>
                            <field name="employee_work_unit"/>
                            <field name="employee_position"/>
                        </group>
                        <group>
                            <field name="employee_grade"/>
                            <field name="employee_category"/>
                            <field name="employee_gender"/>
                            <field name="employee_mail"/>
                            <field name="employee_phone"/>
                        </group>
                    </group>
                    <group string="Guarantee Letter Details" invisible="letter_name != 'Guarantee Letter'">
                        <group>
                            <field name="name_of_the_external_person" required="letter_name == 'Guarantee Letter'" readonly="status != 'draft'"/>
                            <field name="name_of_the_organization" required="letter_name == 'Guarantee Letter'" readonly="status != 'draft'"/>
                            <field name="organization_address" required="letter_name == 'Guarantee Letter'" readonly="status != 'draft'"/>
                            <field name="organization_email_address" readonly="status != 'draft'"/>
                            <field name="pobox" readonly="status != 'draft'"/>
                        </group>
                        <group>
                            <field name="sub_city" readonly="status != 'draft'"/>
                            <field name="woreda" readonly="status != 'draft'"/>
                            <field name="kebele" readonly="status != 'draft'"/>
                            <field name="phone_number" readonly="status != 'draft'"/>
                        </group>
                        <group colspan="2" invisible="status != 'completed'">
                            <separator string="Guarantee Execution Details" colspan="2"/>
                            <field name="ref_num" readonly="1"/>
                            <field name="type_guarantee" readonly="1"/>
                            <field name="effective_date" readonly="1"/>
                            <field name="guarantee_amount" readonly="1"/>
                        </group>
                    </group>
                    <group string="Support Letter Details" invisible="letter_name != 'Support Letter'">
                        <group>
                            <field name="organization_name" required="letter_name == 'Support Letter'" readonly="status != 'draft'"/>
                            <field name="support_purpose" required="letter_name == 'Support Letter'" readonly="status != 'draft'"/>
                            <field name="letter_language" required="letter_name == 'Support Letter'" readonly="status != 'draft'"/>
                            <field name="hire_date" readonly="status != 'draft'"/>
                            <field name="job_position" readonly="status != 'draft'"/>
                        </group>
                        <group>
                            <field name="permanent_emp" readonly="status != 'draft'"/>
                            <field name="include_salary" readonly="status != 'draft'"/>
                            <field name="salary" invisible="not include_salary" readonly="1" force_save="1"/>
                            <field name="salary_in_words" invisible="not include_salary" readonly="1" force_save="1"/>
                        </group>
                        <group colspan="2">
                            <field name="support" placeholder="Enter any specific purpose details, travel destination, university name, or additional remarks to include in the letter..." readonly="status != 'draft'"/>
                        </group>
                    </group>
                    
                    <!-- Rejection banner + reason -->
                    <div class="alert alert-danger text-center font-weight-bold" role="alert" invisible="status != 'rejected'">
                        This Request has been Rejected.
                    </div>
                    <group invisible="status != 'rejected'">
                        <field name="rejection_reason" required="status == 'rejected'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
