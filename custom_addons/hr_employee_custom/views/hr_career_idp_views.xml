<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- hr.career.idp Form View -->
    <record id="view_hr_career_idp_form" model="ir.ui.view">
        <field name="name">hr.career.idp.form</field>
        <field name="model">hr.career.idp</field>
        <field name="arch" type="xml">
            <form string="Individual Career Development Plan (ICDP)">
                <header>
                    <!-- Employee actions -->
                    <button name="action_submit" string="Submit to Manager" type="object" class="oe_highlight" invisible="state != 'draft' or not is_owner"/>
                    <button name="action_request_extension_wizard" string="Ask Date Extension" type="object" class="btn-outline-primary" invisible="state != 'active' or not is_owner"/>
                    <!-- Manager/HR actions -->
                    <button name="action_activate" string="Approve &amp; Activate" type="object" class="oe_highlight" invisible="state != 'submitted' or not is_manager_user" groups="hr_employee_custom.group_career_path_manager"/>
                    <button name="action_approve_extension" string="Approve Extension" type="object" class="oe_highlight btn-success" invisible="state != 'extension_requested' or not is_manager_user" groups="hr_employee_custom.group_career_path_manager"/>
                    <button name="action_reject_extension_wizard" string="Decline Extension" type="object" class="btn-danger" invisible="state != 'extension_requested' or not is_manager_user" groups="hr_employee_custom.group_career_path_manager"/>
                    <button name="action_complete" string="Mark as Completed" type="object" class="oe_highlight" invisible="state != 'active' or not is_manager_user" groups="hr_employee_custom.group_career_path_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('completed', 'cancelled') or not is_manager_user" groups="hr_employee_custom.group_career_path_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,active,completed"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="is_succession_idp" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="is_owner" invisible="1"/>
                    <field name="is_manager_user" invisible="1"/>
                    <!-- Alert Banner when Date Extension is Requested -->
                    <div class="alert alert-warning d-flex align-items-center mb-3" role="alert" invisible="state != 'extension_requested'">
                        <i class="fa fa-clock-o fa-2x me-3 text-warning"/>
                        <div>
                            <strong>Completion Date Extension Requested:</strong>
                            A completion date extension to <field name="proposed_completion_date" class="fw-bold d-inline" readonly="1"/> was requested on <field name="extension_request_date" class="d-inline" readonly="1"/>.
                            <br/>
                            <strong>Justification:</strong> <field name="extension_reason" class="d-inline fst-italic" readonly="1"/>
                        </div>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft' or not is_owner"/>
                            <field name="target_job_id" string="Current Role" readonly="1" force_save="1"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="start_date" required="1" readonly="state != 'draft' or not is_owner"/>
                            <field name="target_completion_date" required="state == 'draft'" readonly="state != 'draft' or not is_owner"/>
                            <field name="extension_count" string="Extensions Granted" invisible="extension_count == 0" readonly="1"/>
                        </group>
                    </group>

                    <!-- ========================================================= -->
                    <!-- TOP SECTION: COMMITMENT & REVIEW (ABOVE TABS)               -->
                    <!-- ========================================================= -->
                    <group>
                        <!-- Employee Commitment: Editable only by Employee in draft/submitted, readonly for manager -->
                        <group string="Employee Commitment">
                            <field name="employee_commitment" string="Commitment Statement"
                                   readonly="state not in ('draft', 'submitted') or not is_owner"
                                   placeholder="Employee statement: I commit to actively pursuing the developmental interventions set out in this plan, dedicating the necessary time and effort to close my competency gaps..."/>
                            <field name="employee_commitment_date" string="Commitment Date" readonly="1" invisible="not employee_commitment_date"/>
                        </group>

                        <!-- Supervisor Review & Feedback: ONLY displayed for Manager during review, or displayed readonly for employee once manager has provided feedback -->
                        <group string="Supervisor Review &amp; Feedback" invisible="not is_manager_user and not supervisor_feedback">
                            <field name="supervisor_feedback" string="Supervisor Feedback"
                                   required="is_manager_user and state == 'submitted'"
                                   readonly="not is_manager_user or state in ('completed', 'cancelled')"
                                   placeholder="Reviewing manager's assessment of progress, coaching support notes, and development feedback..."/>
                            <field name="supervisor_feedback_date" string="Review Date"
                                   readonly="not is_manager_user or state in ('completed', 'cancelled')"
                                   invisible="not supervisor_feedback_date and not is_manager_user"/>
                        </group>
                    </group>

                    <!-- ========================================================= -->
                    <!-- NOTEBOOK: ACTIVITIES (TAB 1) & GAP ANALYSIS (TAB 2)        -->
                    <!-- ========================================================= -->
                    <notebook>
                        <!-- TAB 1: DEVELOPMENT ACTIVITIES (PRIMARY WORKSPACE) -->
                        <page string="Development Activities" name="activities">
                            <field name="line_ids" required="state != 'draft'">
                                <form string="Development Activity">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="gap_competency_ids" invisible="1"/>
                                                <field name="is_manager" invisible="1"/>
                                                <field name="competency_id" string="Goal / Competency" options="{'no_create': True}" domain="[('id', 'in', gap_competency_ids)]"/>
                                                <field name="activity_type" string="Development Method"/>
                                                <field name="name" string="Activity" placeholder="e.g. Complete Advanced Credit Risk Workshop"/>
                                            </group>
                                            <group>
                                                <field name="target_outcome" string="Target" placeholder="e.g. Score 85%+, Certification"/>
                                                <field name="target_date" string="Timeline" required="1"/>
                                                <field name="resource_support" string="Resource / Support" placeholder="e.g. LMS Access, Senior Mentor, Budget"/>
                                                <field name="status" string="Progress / Status" widget="badge" decoration-info="status == 'in_progress'" decoration-success="status == 'completed'"/>
                                                <field name="completion_date" invisible="status != 'completed'"/>
                                            </group>
                                        </group>
                                        <group string="Commitment &amp; Reflection">
                                            <field name="employee_commitment" string="Employee Commitment" placeholder="Employee's personal commitment and reflection on this activity..."/>
                                        </group>
                                        <!-- Supervisor evaluation in line: ONLY visible for Manager or if feedback already exists -->
                                        <group string="Supervisor Evaluation &amp; Feedback" invisible="not is_manager and not supervisor_feedback">
                                            <field name="idp_state" invisible="1"/>
                                            <field name="supervisor_feedback" readonly="not is_manager or idp_state in ('completed', 'cancelled')" placeholder="Manager's evaluation and milestone feedback..."/>
                                        </group>
                                    </sheet>
                                </form>
                                <list string="Development Activities" editable="bottom">
                                    <field name="gap_competency_ids" column_invisible="1"/>
                                    <field name="is_manager" column_invisible="1"/>
                                    <field name="competency_id" string="Goal / Competency" options="{'no_create': True}" domain="[('id', 'in', gap_competency_ids)]"/>
                                    <field name="activity_type" string="Development Method"/>
                                    <field name="name" string="Activity" placeholder="e.g. Complete Advanced Credit Risk Workshop"/>
                                    <field name="target_outcome" string="Target" placeholder="e.g. Score 85%+, Certification"/>
                                    <field name="target_date" string="Timeline" required="1"/>
                                    <field name="resource_support" string="Resource / Support" placeholder="e.g. LMS Access, Senior Mentor, Budget"/>
                                    <field name="status" string="Progress / Status" widget="badge" decoration-info="status == 'in_progress'" decoration-success="status == 'completed'"/>
                                    <field name="supervisor_feedback" string="Supervisor Feedback" optional="show" readonly="not is_manager"/>
                                </list>
                            </field>
                        </page>

                        <!-- TAB 2: COMPETENCY GAP ANALYSIS (REFERENCE) -->
                        <page string="Competency Gap Analysis" name="overview">
                            <div class="text-muted mb-2">
                                <i class="fa fa-info-circle me-1" title="Info"/>
                                Required competency benchmark specifications for <field name="target_job_id" class="fw-bold d-inline" readonly="1"/>.
                            </div>
                            <group>
                                <field name="competency_gap_html" nolabel="1"/>
                            </group>
                            <button name="action_generate_gaps" string="Refresh Gap Analysis &amp; Suggest Activities" type="object" class="btn-secondary mt-2" invisible="state not in ('draft', 'submitted')"/>
                        </page>

                        <!-- TAB 3: EXTENSION HISTORY (AUDIT TRAIL) -->
                        <page string="Extension History" name="extension_history" invisible="extension_count == 0 and state != 'extension_requested'">
                            <field name="extension_history_ids" readonly="1">
                                <list string="Extension History">
                                    <field name="approval_date" string="Date Approved"/>
                                    <field name="previous_date" string="Previous Target Date"/>
                                    <field name="new_date" string="New Target Date"/>
                                    <field name="days_added" string="Days Extended"/>
                                    <field name="reason" string="Justification"/>
                                    <field name="requested_by_id" string="Requested By"/>
                                    <field name="approved_by_id" string="Approved By"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- hr.career.idp List View -->
    <record id="view_hr_career_idp_list" model="ir.ui.view">
        <field name="name">hr.career.idp.list</field>
        <field name="model">hr.career.idp</field>
        <field name="arch" type="xml">
            <list string="Career Development Plans" decoration-muted="state == 'cancelled'" decoration-success="state == 'completed'" decoration-warning="state == 'extension_requested'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="target_job_id" string="Current Role"/>
                <field name="start_date"/>
                <field name="target_completion_date" optional="show"/>
                <field name="extension_count" string="Extensions" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'active'" decoration-warning="state == 'extension_requested'" decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <!-- hr.career.idp Search View -->
    <record id="view_hr_career_idp_search" model="ir.ui.view">
        <field name="name">hr.career.idp.search</field>
        <field name="model">hr.career.idp</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="target_job_id" string="Current Role"/>
                <field name="manager_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Active / In Progress" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Extension Requested" name="extension_requested" domain="[('state', '=', 'extension_requested')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="Succession IDP" name="filter_succession_idp" domain="[('is_succession_idp', '=', True)]"/>
                <filter string="Career IDP" name="filter_career_idp" domain="[('is_succession_idp', '=', False)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Employee" name="group_emp" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Current Role" name="group_target" context="{'group_by': 'target_job_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 1. My IDPs -->
    <record id="action_my_career_idp" model="ir.actions.act_window">
        <field name="name">My Development Plans</field>
        <field name="res_model">hr.career.idp</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Development Plans found.</p>
        </field>
    </record>

    <!-- 2. Team IDPs (Manager Review & Approval) -->
    <record id="action_team_career_idp" model="ir.actions.act_window">
        <field name="name">Team Development Plans</field>
        <field name="res_model">hr.career.idp</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('employee_id.parent_id.user_id', '=', uid), ('employee_id.coach_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Team Development Plans found.</p>
        </field>
    </record>

    <!-- 3. All IDPs (Admin) -->
    <record id="action_all_career_idp" model="ir.actions.act_window">
        <field name="name">All Development Plans</field>
        <field name="res_model">hr.career.idp</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Development Plans found.</p>
        </field>
    </record>


    <!-- Read-only List View for IDP (Team / All) -->
    <record id="view_hr_career_idp_list_readonly" model="ir.ui.view">
        <field name="name">hr.career.idp.list.readonly</field>
        <field name="model">hr.career.idp</field>
        <field name="inherit_id" ref="hr_employee_custom.view_hr_career_idp_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">0</attribute>
            </list>
        </field>
    </record>

    <!-- Read-only Form View for IDP (Team / All) -->
    <record id="view_hr_career_idp_form_readonly" model="ir.ui.view">
        <field name="name">hr.career.idp.form.readonly</field>
        <field name="model">hr.career.idp</field>
        <field name="inherit_id" ref="hr_employee_custom.view_hr_career_idp_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="create">0</attribute>
            </form>
            <xpath expr="//button[@name='action_submit']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_request_extension_wizard']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Bindings for Team IDP -->
    <record id="action_team_career_idp_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_hr_career_idp_list_readonly"/>
        <field name="act_window_id" ref="hr_employee_custom.action_team_career_idp"/>
    </record>
    <record id="action_team_career_idp_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_career_idp_form_readonly"/>
        <field name="act_window_id" ref="hr_employee_custom.action_team_career_idp"/>
    </record>

    <!-- Bindings for All IDP -->
    <record id="action_all_career_idp_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_hr_career_idp_list_readonly"/>
        <field name="act_window_id" ref="hr_employee_custom.action_all_career_idp"/>
    </record>
    <record id="action_all_career_idp_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_career_idp_form_readonly"/>
        <field name="act_window_id" ref="hr_employee_custom.action_all_career_idp"/>
    </record>

</odoo>
