<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="class_classifications_form" model="ir.ui.view">
        <field name="name">class_classification.form</field>
        <field name="model">class.classification</field>
        <field name="arch" type="xml">
            <form string="Class Classification">
                <group colspan="2">
                    <group>
                        <field name="classification_name"/>
                        <field name="classification_code"/>
                    </group>
                    <group>
                        <field name="active" type="checkbox"/>
                    </group>


                </group>

            </form>
        </field>
    </record>
    <record id="class_classifications_tree" model="ir.ui.view">
        <field name="name">class_classification.list</field>
        <field name="model">class.classification</field>
        <field name="arch" type="xml">
            <list string="Class Classification">
                <field name="classification_name"/>
                <field name="classification_code"/>
                <field name="active" type="checkbox"/>

            </list>
        </field>
    </record>
        <record id="class_classifications_form_tree" model="ir.actions.act_window">
        <field name="name">Class Classification</field>
        <field name="res_model">class.classification</field>
        <field name="context">{}</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>