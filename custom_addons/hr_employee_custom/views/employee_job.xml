<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="employee_jobs_form" model="ir.ui.view">
        <field name="name">employee.job.form</field>
        <field name="model">employee.job</field>
        <field name="arch" type="xml">
            <form string="Job Grade">
                <group colspan="2">
                    <group>
                        <field name="job_code"/>
                        <field name="job_name"/>
                    </group>
                    <group>
                        <field name="job_category"/>
                        <field name="status" type="checkbox"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>


                </group>
                 <group>
                    <notebook>
                        <page string="Eligible Grades">

                <field name="grade_multi_record">
                       <list editable="bottom">
                            <field name="grade_code" invisible="parent_grade == True"/>
                            <field name="parent_grade"/>
                            <field name="start_date"/>
                            <field name="end_date"/>

                        </list>

                    </field>
			</page>
                    </notebook>
                </group>
            </form>
        </field>
    </record>
    <record id="employee_jobs_tree" model="ir.ui.view">
        <field name="name">employee.job.form</field>
        <field name="model">employee.job</field>
        <field name="arch" type="xml">
            <list string="Job Grade">
                <field name="job_code"/>
                <field name="job_name"/>
                <field name="job_category"/>
                <field name="start_date"/>
                <field name="end_date"/>
                 <field name="status" type="checkbox"/>
<!--                <field name="active"  invisible="inactive == True"/>-->
<!--                <field name="inactive"  invisible="active == True"/>-->
            </list>
        </field>
    </record>
        <record id="employee_jobs_form_tree" model="ir.actions.act_window">
        <field name="name">Job Details</field>
        <field name="res_model">employee.job</field>
        <field name="context">{}</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>