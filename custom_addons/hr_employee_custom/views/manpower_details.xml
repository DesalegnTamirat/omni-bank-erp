<?xml version='1.0' encoding='UTF-8'?>
<odoo>

        <record model="ir.ui.view" id="manpower_plan_ou_jobs_tree">
            <field name="name">Manpower Plan Ou Jobs</field>
            <field name="model">manpower.plan.ou.jobs</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <header>
                      <button name="save" string="Confirm" type="object" class="oe_highlight"/>
                   </header>
                    <field name="work_unit2"/>
                    <!-- <field name="department2"/> commented: 'account.analytic.account' model missing (accounting module not installed) -->
                     <field name="position"/>
                    <field name="job_name"/>

                    <field name="grade"/>
                    <field name="july"/>
                    <field name="august"/>
                    <field name="september"/>
                    <field name="october"/>
                    <field name="november"/>
                    <field name="december"/>
                    <field name="january"/>
                    <field name="february"/>
                    <field name="march"/>
                    <field name="april"/>
                    <field name="may"/>
                    <field name="june"/>
                    <field name="total"/>
                </list>
            </field>
        </record>
        <record id="procurement_plan_details_form_tree" model="ir.actions.act_window">
        <field name="name">Manpower Plan Ou Jobs</field>
        <field name="res_model">manpower.plan.ou.jobs</field>
        <field name="context">{}</field>
        <field name="view_mode">list</field>
    </record>
</odoo>