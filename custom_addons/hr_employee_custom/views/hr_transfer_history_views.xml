<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>

        <record id="view_hr_employee_transfer_history_list" model="ir.ui.view">
            <field name="name">hr.employee.transfer.history.list</field>
            <field name="model">hr.employee.transfer.history</field>
            <field name="arch" type="xml">
                <list string="Transfer History">
                    <field name="employee_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="transfer_reason"/>
                    <field name="from_operating_unit_id"/>
                    <field name="from_department_id"/>
                    <field name="from_job_id"/>
                    <field name="from_grade_id"/>
                    <field name="to_operating_unit_id"/>
                    <field name="to_department_id"/>
                    <field name="to_job_id"/>
                    <field name="to_grade_id"/>
                    <field name="is_current"/>
                </list>
            </field>
        </record>

        <record id="view_hr_employee_transfer_history_form" model="ir.ui.view">
            <field name="name">hr.employee.transfer.history.form</field>
            <field name="model">hr.employee.transfer.history</field>
            <field name="arch" type="xml">
                <form string="Transfer History">
                    <sheet>
                        <group>
                            <group string="Transfer Information &amp; Status">
                                <field name="employee_id"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="transfer_reason"/>
                                <field name="is_current"/>
                            </group>
                        </group>
                        <group>
                            <group string="From (Previous State)">
                                <field name="from_operating_unit_id"/>
                                <field name="from_department_id"/>
                                <field name="from_job_id"/>
                                <field name="from_grade_id"/>
                            </group>
                            <group string="To (New State)">
                                <field name="to_operating_unit_id"/>
                                <field name="to_department_id"/>
                                <field name="to_job_id"/>
                                <field name="to_grade_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_employee_transfer_history" model="ir.actions.act_window">
            <field name="name">Transfer History</field>
            <field name="res_model">hr.employee.transfer.history</field>
            <field name="view_mode">list,form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>