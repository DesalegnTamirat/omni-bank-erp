<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>

        <!-- Search View for hr.employee.transfer.history -->
        <record id="view_hr_employee_transfer_history_search" model="ir.ui.view">
            <field name="name">hr.employee.transfer.history.search</field>
            <field name="model">hr.employee.transfer.history</field>
            <field name="arch" type="xml">
                <search string="Search Transfer History">
                    <field name="employee_id" filter_domain="['|', ('employee_id', '=', self), ('employee_id.name', 'ilike', self)]"/>
                    <field name="from_operating_unit_id"/>
                    <field name="to_operating_unit_id"/>
                    <field name="from_department_id"/>
                    <field name="to_department_id"/>
                    <field name="from_job_id"/>
                    <field name="to_job_id"/>
                    <field name="reason_for_movement"/>
                    <field name="transfer_reason"/>
                    <separator/>
                    <filter name="current_transfer" string="Current Transfer" domain="[('is_current', '=', True)]"/>
                    <separator/>
                    <filter name="bank_initiated" string="Bank-Initiated" domain="[('transfer_initiation_type', '=', 'bank_initiated')]"/>
                    <filter name="self_initiated" string="Self-Initiated" domain="[('transfer_initiation_type', '=', 'self_initiated')]"/>
                    <group>
                        <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                        <filter name="group_movement" string="Reason for Movement" context="{'group_by': 'reason_for_movement'}"/>
                        <filter name="group_init_type" string="Initiation Type" context="{'group_by': 'transfer_initiation_type'}"/>
                        <filter name="group_to_ou" string="Operating Unit" context="{'group_by': 'to_operating_unit_id'}"/>
                        <filter name="group_to_dept" string="Department" context="{'group_by': 'to_department_id'}"/>
                        <filter name="group_start_date" string="Start Date" context="{'group_by': 'start_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- List View for hr.employee.transfer.history -->
        <record id="view_hr_employee_transfer_history_list" model="ir.ui.view">
            <field name="name">hr.employee.transfer.history.list</field>
            <field name="model">hr.employee.transfer.history</field>
            <field name="arch" type="xml">
                <list string="Transfer History" default_order="start_date desc, id desc">
                    <field name="employee_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="duration"/>
                    <field name="transfer_reason"/>
                    <field name="reason_for_movement" widget="badge" decoration-warning="reason_for_movement in ['transfer', 'lateral_transfer']"/>
                    <field name="transfer_initiation_type"/>
                    <field name="from_operating_unit_id"/>
                    <field name="from_department_id"/>
                    <field name="from_job_id"/>
                    <field name="from_grade_id"/>
                    <field name="to_operating_unit_id"/>
                    <field name="to_department_id"/>
                    <field name="to_job_id"/>
                    <field name="to_grade_id"/>
                    <field name="is_current" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Form View for hr.employee.transfer.history -->
        <record id="view_hr_employee_transfer_history_form" model="ir.ui.view">
            <field name="name">hr.employee.transfer.history.form</field>
            <field name="model">hr.employee.transfer.history</field>
            <field name="arch" type="xml">
                <form string="Transfer History">
                    <sheet>
                        <group>
                            <group string="Transfer Information &amp; Status">
                                <field name="employee_id" required="1"/>
                                <field name="date"/>
                                <field name="start_date" required="1"/>
                                <field name="end_date"/>
                                <field name="duration" readonly="1"/>
                                <field name="transfer_reason"/>
                                <field name="reason_for_movement"/>
                                <field name="transfer_initiation_type"/>
                                <field name="is_current" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="From (Previous State)">
                                <field name="from_operating_unit_id"/>
                                <field name="from_department_id"/>
                                <field name="from_job_id"/>
                                <field name="from_grade_id"/>
                            </group>
                            <group string="To (New State)">
                                <field name="to_operating_unit_id"/>
                                <field name="to_department_id"/>
                                <field name="to_job_id"/>
                                <field name="to_grade_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Window Action for hr.employee.transfer.history -->
        <record id="action_hr_employee_transfer_history" model="ir.actions.act_window">
            <field name="name">Transfer History</field>
            <field name="res_model">hr.employee.transfer.history</field>
            <field name="view_mode">list,form</field>
            <field name="target">current</field>
            <field name="search_view_id" ref="view_hr_employee_transfer_history_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Transfer History entry
                </p>
                <p>
                    Record employee branch transfers, work unit changes, and lateral reassignments.
                </p>
            </field>
        </record>

    </data>
</odoo>
