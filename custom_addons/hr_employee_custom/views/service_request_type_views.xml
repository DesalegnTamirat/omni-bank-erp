<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Action: Service Request Type -->
    <record id="action_service_request_type" model="ir.actions.act_window">
        <field name="name">Service Request Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">service.request.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new Service Request Type!</p>
        </field>
    </record>

    <!-- List View: Service Request Type -->
    <record id="service_request_type_list_view" model="ir.ui.view">
        <field name="name">service.request.type.list</field>
        <field name="model">service.request.type</field>
        <field name="arch" type="xml">
            <list string="Service Request Type" editable="bottom">
                <field name="sr_type"/>
                <field name="sr_category"/>
                <field name="sr_prefix"/>
                <field name="authorizing_office"/>
                <field name="authorizer"/>
                <field name="status"/>
            </list>
        </field>
    </record>
</odoo>