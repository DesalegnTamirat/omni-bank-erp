<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>

        <record id="view_hr_salary_history_list" model="ir.ui.view">
            <field name="name">hr.salary.history.list</field>
            <field name="model">hr.salary.history</field>
            <field name="arch" type="xml">
                <list string="Salary History">
                    <field name="updated_on"/>
                    <field name="salary_element"/>
                    <field name="current_value"/>
                    <field name="old_value"/>
                </list>
            </field>
        </record>

        <record id="view_hr_salary_history_form" model="ir.ui.view">
            <field name="name">hr.salary.history.form</field>
            <field name="model">hr.salary.history</field>
            <field name="arch" type="xml">
                <form string="Salary History">
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="updated_on"/>
                            <field name="salary_element"/>
                        </group>
                        <group>
                            <field name="current_value"/>
                            <field name="old_value"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_hr_salary_history" model="ir.actions.act_window">
            <field name="name">Salary History</field>
            <field name="res_model">hr.salary.history</field>
            <field name="view_mode">list,form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>