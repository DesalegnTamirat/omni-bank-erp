<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- LIST VIEW -->
        <record id="view_hr_employee_delegation_list" model="ir.ui.view">
            <field name="name">hr.employee.delegation.list</field>
            <field name="model">hr.employee.delegation</field>
            <field name="arch" type="xml">
                <list string="Manager Delegations">
                    <field name="name"/>
                    <field name="employee_id" string="Manager / Delegator"/>
                    <field name="manager_job_id" string="Manager Position"/>
                    <field name="delegate_id" string="Delegated Staff"/>
                    <field name="delegate_job_id" string="Delegate Position"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="absence_reason"/>
                    <field name="is_active_delegation" widget="boolean" string="Active Today"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'submitted'" decoration-danger="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_hr_employee_delegation_form" model="ir.ui.view">
            <field name="name">hr.employee.delegation.form</field>
            <field name="model">hr.employee.delegation</field>
            <field name="arch" type="xml">
                <form string="Manager Employee Delegation">
                    <header>
                        <button name="action_submit" string="Submit Delegation" type="object" class="btn-primary" invisible="state != 'draft' or not is_manager_coach"/>
                        <button name="action_cancel_delegation" string="Cancel Delegation" type="object" class="btn-secondary" invisible="state == 'cancelled'"/>
                        <button name="action_delete_draft" string="Delete Draft" type="object" class="btn-outline-danger" invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,cancelled"/>
                    </header>
                    <sheet>
                        <div class="alert alert-warning mb-3" role="alert" invisible="is_manager_coach">
                            <strong>Notice:</strong> You are not currently listed as a direct coach or manager of any staff members. Only managerial employees with reporting staff can create or submit delegation requests.
                        </div>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_delegated_approvals" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="state != 'submitted'">
                                <field name="delegated_approval_count" widget="statinfo" string="Pending Approvals"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Delegation Reference"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Manager / Delegator Information">
                                <field name="employee_id" readonly="1" force_save="1"/>
                                <field name="manager_job_id"/>
                                <field name="manager_department_id"/>
                                <field name="absence_reason" readonly="state != 'draft'"/>
                                <field name="is_manager_coach" invisible="1"/>
                            </group>
                            <group string="Delegation Schedule &amp; Period">
                                <field name="start_date" readonly="state != 'draft'"/>
                                <field name="end_date" readonly="state != 'draft'"/>
                                <field name="is_active_delegation" readonly="1" widget="boolean"/>
                                <field name="leave_request_id" invisible="not leave_request_id" readonly="1"/>
                            </group>
                        </group>
                        <group string="Delegate Selection">
                            <group>
                                <field name="include_sub_level_staff" readonly="state != 'draft'"/>
                                <field name="direct_coach_ids" invisible="1"/>
                                <field name="filter_coach_id" readonly="state != 'draft'" invisible="not include_sub_level_staff"/>
                                <field name="allowed_delegate_ids" invisible="1"/>
                            </group>
                            <group>
                                <field name="delegate_id" readonly="state != 'draft'"/>
                                <field name="delegate_job_id"/>
                                <field name="delegate_coach_name" invisible="not include_sub_level_staff"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Employees to Notify" name="stakeholders_page">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <p class="text-muted mb-0">
                                        These employees and supervisors will be notified automatically via email, in-app activity, and Discuss direct messages upon submission.
                                    </p>
                                    <button name="action_reset_default_recipients" string="Reset to Default Recipients" type="object" class="btn btn-sm btn-outline-secondary" invisible="state != 'draft'"/>
                                </div>
                                <field name="stakeholder_ids" readonly="state != 'draft'">
                                    <list editable="bottom" create="false" delete="true">
                                        <field name="name" string="Employee Name" readonly="1"/>
                                        <field name="work_email" string="Work Email" readonly="1"/>
                                        <field name="department_name" string="Department" readonly="1"/>
                                        <field name="job_name" string="Job Position" readonly="1"/>
                                        <field name="category" string="Role / Category" readonly="1"/>
                                    </list>
                                </field>
                                <field name="notification_recipient_ids" invisible="1"/>
                            </page>
                            <page string="Cancellation Details" name="cancellation_page" invisible="state != 'cancelled'">
                                <group>
                                    <group>
                                        <field name="cancellation_date" readonly="1"/>
                                        <field name="cancelled_by_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="cancellation_reason" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_hr_employee_delegation_search" model="ir.ui.view">
            <field name="name">hr.employee.delegation.search</field>
            <field name="model">hr.employee.delegation</field>
            <field name="arch" type="xml">
                <search string="Search Delegations">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="delegate_id"/>
                    <field name="absence_reason"/>
                    <separator/>
                    <filter string="Active Today" name="filter_active" domain="[('is_active_delegation', '=', True)]"/>
                    <filter string="My Delegations" name="filter_my_delegations" domain="[('employee_id.user_id', '=', uid)]"/>
                    <filter string="Delegated to Me" name="filter_delegated_to_me" domain="[('delegate_id.user_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Submitted" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                    <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <separator/>
                    <filter string="Manager / Delegator" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Delegated Staff" name="group_delegate" context="{'group_by': 'delegate_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Start Date" name="group_start_date" context="{'group_by': 'start_date'}"/>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_hr_employee_delegation" model="ir.actions.act_window">
            <field name="name">Manager Delegations</field>
            <field name="res_model">hr.employee.delegation</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hr_employee_delegation_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Managerial Employee Delegation
                </p>
                <p>
                    Delegate managerial authorities, approvals, and subordinate oversight to direct or qualified staff members during missions, training, or leave.
                </p>
            </field>
        </record>

    </data>
</odoo>
