<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ═══════════════════════════════════════════
         EMPLOYEE GRADE — Form View
    ════════════════════════════════════════════ -->
    <record id="view_hr_employee_grade_form" model="ir.ui.view">
        <field name="name">employee.grade.form</field>
        <field name="model">employee.grade</field>
        <field name="arch" type="xml">
            <form string="Employee Grade" delete="false">
                <header>
                    <button name="action_save_grade" string="Save Grade" type="object" class="btn-primary" save="1"/>
                    <button name="action_archive_grade" string="Archive" type="object" class="btn-danger"
                            invisible="not id"
                            confirm="Are you sure you want to archive this Employee Grade?"/>
                </header>
                <sheet>
                    <group colspan="4">
                        <group>
                            <field name="grade_code"/>
                            <field name="grade_name"/>
                            <field name="category" can_create="false" can_write="false"/>
                        </group>
                        <group>
                            <field name="base_salary"/>
                            <field name="salary_factor"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Increments">
                            <field name="increment_id">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="amount_1"/>
                                    <field name="amount_2"/>
                                    <field name="amount_3"/>
                                    <field name="amount_4"/>
                                    <field name="amount_5"/>
                                    <field name="amount_6"/>
                                    <field name="amount_7"/>
                                    <field name="amount_8"/>
                                    <field name="amount_9"/>
                                    <field name="amount_10"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════
         EMPLOYEE GRADE — List View
    ════════════════════════════════════════════ -->
    <record id="view_hr_employee_grade_list" model="ir.ui.view">
        <field name="name">employee.grade.list</field>
        <field name="model">employee.grade</field>
        <field name="arch" type="xml">
            <list string="Job Grade" delete="false">
                <field name="grade_code"/>
                <field name="grade_name"/>
                <field name="category" can_create="false" can_write="false"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════
         EMPLOYEE GRADE — Configuration Menu
    ════════════════════════════════════════════ -->

    <record id="employee_grade_tree_action" model="ir.actions.act_window">
        <field name="name">Job Grade Details</field>
        <field name="res_model">employee.grade</field>
        <field name="context">{}</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>