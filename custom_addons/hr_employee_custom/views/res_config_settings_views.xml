<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_hr_ldap" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.ldap</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="module_auth_ldap" position="inside">
                <div class="mt8" invisible="not module_auth_ldap">
                    <button type="action" name="%(hr_employee_custom.action_ldap_installer)d" string="LDAP Server" icon="oi-arrow-right" class="btn-link"/>
                </div>
            </setting>
        </field>
    </record>
</odoo>
