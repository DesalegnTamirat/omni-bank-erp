<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="service_award_form" model="ir.ui.view">
        <field name="name">Service.Award.form</field>
        <field name="model">service.award</field>
        <field name="arch" type="xml">
            <form string="Service Award">
                <group colspan="2">
                    <group>
                        <field name="award_name"/>
                        <field name="award_type"/>
                    </group>

                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                      <group>
                        <field name="elegible_period_of_service"/>


                    </group>

                </group>
            </form>
        </field>
    </record>
    <record id="service_award_tree" model="ir.ui.view">
        <field name="name">Service.Award.form</field>
        <field name="model">service.award</field>
        <field name="arch" type="xml">
            <list string="Service Award">
                <field name="award_name"/>
                <field name="award_type"/>
                <field name="elegible_period_of_service"/>
                <field name="start_date"/>
                <field name="end_date"/>


            </list>
        </field>
    </record>
        <record id="employee_service_award_tree" model="ir.actions.act_window">
        <field name="name">Service Award Details</field>
        <field name="res_model">service.award</field>
        <field name="context">{}</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>