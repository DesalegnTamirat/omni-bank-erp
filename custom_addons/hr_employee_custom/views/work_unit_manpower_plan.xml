<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="manpower_plan_form" model="ir.ui.view">
        <field name="name">Work Unit manpower Plan</field>
        <field name="model">manpower.plan.ou</field>
        <field name="arch" type="xml">
            <form string="Work Unit Manpower Plan">
                <header>
				<field name="approve_status" widget="statusbar"/>
				<button name="initiate_approval" invisible="approve_status in ['initiated', 'approved', 'rejected']" string="Initiate Approval" type="object" class="oe_highlight"/>
                    <button name="approve" invisible="approve_status in ['draft', 'approved', 'rejected']" string="Approve" type="object" class="oe_highlight"/>
                    <button name="reject" invisible="approve_status in ['draft', 'approved', 'rejected']" string="Reject" type="object" class="oe_highlight"/>
				<button name="populate_ou_values" string="Populate Values" type="object" class="oe_highlight"/>
                  <button name="confirm" invisible="status in ['confirmed']" string="Confirm" type="object" class="oe_highlight"/>
				  
               </header>
                <group colspan="2">
                    <group>
                        <field name="work_unit"/>
						<field name="reporting_unit"/>
						<field name="plan_version"/>
                        <!-- <field name="department2"/> -->
                    </group>
                    <group>
                        
                        <field name="plan_version_detail" invisible="1"/>
						<field name="fiscal_year" readonly="1"/>
						<field name="plan_start_date" readonly="1"/>
                        <field name="plan_end_date" readonly="1"/>
                    </group>
                    

                    <group>
                         <field name="status" readonly="1"/>
						 
                         <field name="populated_status" invisible="1"/>
                    </group>
                     <!-- <group> -->
                         
<!--                         <button name="populate_item"  string="Populate Positions" type="object" class="oe_highlight"/>-->
<!--                         <button name="populate_item"  invisible="populated_status in [&apos;populated&apos;]" string="Populate Positions" type="object" class="oe_highlight"/>-->
                     <!-- </group> -->

                </group>
                 <group>
                    <notebook>
                        <page string="Requirements">

                <field name="manpower_plan_id" readonly="status == 'confirmed'">
                       <list editable="bottom">
                            <field name="work_unit2" invisible="1"/>
                            <field name="plan_version" invisible="1"/>
                            <field name="position" width="20%"/>                           
                            <field name="grade" width="20%"/>
                            <field name="category" width="20%"/>
                            <field name="plan_start_date" invisible="1"/>
                            <field name="plan_end_date" invisible="1"/>
                            <field name="status" invisible="1"/>
                            <field name="july" width="20%"/>
                            <field name="august" width="20%"/>
                            <field name="september" width="20%"/>
                            <field name="october" width="20%"/>
                            <field name="november" width="20%"/>
                            <field name="december" width="20%"/>
                            <field name="january" width="20%"/>
                            <field name="february" width="20%"/>
                            <field name="march" width="20%"/>
                            <field name="april" width="20%"/>
                            <field name="may" width="20%"/>
                            <field name="june" width="20%"/>
                            <field name="total" width="20%"/>
                           <field name="position_cost" width="20%"/>
                             <field name="estimated_cost" width="20%"/>
                        </list>

                    </field>
			</page>
			<page string="Financial implications">

                <field name="fin_imp_id">
                       <list editable="bottom">
              
                            <field name="position" width="20%"/>                           
                            <field name="grade" width="20%"/>
                            <field name="category" width="20%"/>
                            
                            <field name="july" width="20%"/>
                            <field name="august" width="20%"/>
                            <field name="september" width="20%"/>
                            <field name="october" width="20%"/>
                            <field name="november" width="20%"/>
                            <field name="december" width="20%"/>
                            <field name="january" width="20%"/>
                            <field name="february" width="20%"/>
                            <field name="march" width="20%"/>
                            <field name="april" width="20%"/>
                            <field name="may" width="20%"/>
                            <field name="june" width="20%"/>
                            <field name="total" width="20%"/>
                           <!-- <field name="position_cost" width="20%"/> -->
                             <!-- <field name="estimated_cost" width="20%"/> -->
                        </list>

                    </field>
			</page>
                    </notebook>
                </group>
            </form>
        </field>
    </record>
    <record id="manpower_plan_tree" model="ir.ui.view">
        <field name="name">Work Unit Manpower Plan</field>
        <field name="model">manpower.plan.ou</field>
        <field name="arch" type="xml">
            <list string="Work Unit Manpower Plan">
                <field name="work_unit"/>
                <!-- <field name="department2"/> -->
                <field name="plan_version"/>
                <field name="plan_start_date"/>
                <field name="plan_end_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="manpower_plan_form_tree" model="ir.actions.act_window">
        <field name="name">Work Unit Manpower Plan</field>
        <field name="res_model">manpower.plan.ou</field>
        <field name="context">{}</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>