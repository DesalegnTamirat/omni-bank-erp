<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="transfer_form" model="ir.ui.view">
        <field name="name">Transform.Form</field>
        <field name="model">transfer.form</field>
        <field name="arch" type="xml">
            <form string="Transfer Form">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="populate" invisible="state in ('populate', 'approve', 'authorize')" string="Populate" type="object" class="oe_highlight"/>
                    <button name="approve" invisible="state in ('draft', 'populate')" string="Transfer" type="object" class="oe_highlight"/>
                    <button name="notify" invisible="status_del in ('notify', 'evaluate')" string="Notify" type="object" class="oe_highlight"/>
                    <button name="evaluate" invisible="status_del == 'evaluate'" string="Evaluate" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="ref_num" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="transfer_initiated_by"/>
                            <field name="priority_transfer"/>
                            <field name="sr_ref"/>
                            <field name="status_del" invisible="1"/>
                        </group>
                    </group>
                    <group colspan="2">
                        <group>
                            <field name="employee_name"/>
                            <field name="operating_unit"/>
                            <field name="department"/>
                            <field name="job_position"/>
                            <field name="job_grade"/>
                            <field name="job_category" invisible="1"/>
                            <field name="employee_category" invisible="1"/>
                            <field name="contract_start_date"/>
                            <field name="gender"/>
                            <field name="active_phone_num"/>
                            <field name="active_email_id"/>
                            <field name="transfer_requested_date"/>
                        </group>
                        <group>
                            <field name="requested_operating_unit"/>
                            <field name="location_preference_2"/>
                            <field name="location_preference_3"/>
                            <field name="reason_for_transfer"/>
                            <field name="department1" invisible="1"/>
                            <field name="job_grade1" readonly="1"/>
                            <field name="job_category1" readonly="1" invisible="1"/>
                            <field name="employee_category1" invisible="1"/>
                            <field name="pms_score"/>
                            <field name="service_in_the_bank"/>
                            <field name="period_since_last_promotion"/>
                            <field name="period_since_last_transfer"/>
                            <field name="period_since_final_written_warning"/>
                        </group>
                    </group>
                    <group colspan="2">
                        <group>
                            <field name="assigned_operating_unit"/>
                            <field name="job_title"/>
                            <field name="releiving_date"/>
                            <field name="new_reporting_manager"/>
                        </group>
                        <group>
                            <field name="responsible"/>
                            <field name="reporting_date"/>
                            <field name="hardship_allowance"/>
                            <field name="approved_date"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group>
                        <field name="doc_attachment_id8" widget="many2many_binary" class="oe_inline"/>
                    </group>
                    <notebook>
                        <page string="Transfer Form Approval Members">
                            <field name="transform_del_id">
                                <list editable="bottom">
                                    <field name="role" width="20%"/>
                                    <field name="employee_name" width="20%"/>
                                    <field name="operating_unit" width="20%"/>
                                    <field name="status" width="20%"/>
                                    <field name="alternate_committee_member" width="20%"/>
                                    <field name="alter_operating_unit" width="20%"/>
                                    <field name="approve" width="20%"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="cc_workunits" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="transfer_form_list" model="ir.ui.view">
        <field name="name">Transfer.Form.list</field>
        <field name="model">transfer.form</field>
        <field name="arch" type="xml">
            <list string="Transfer Form">
                <field name="ref_num"/>
                <field name="employee_name"/>
                <field name="operating_unit"/>
                <field name="department"/>
                <field name="job_position"/>
                <field name="job_grade"/>
                <field name="requested_operating_unit"/>
                <field name="department1"/>
                <field name="job_title"/>
                <field name="job_grade1"/>
                <field name="transfer_requested_date"/>
                <field name="reason_for_transfer"/>
                <field name="service_in_the_bank" string="Bank Service"/>
                <field name="pms_score"/>
                <field name="period_since_last_promotion" string="Last Promotion"/>
                <field name="period_since_last_transfer" string="Last Transfer"/>
                <field name="period_since_final_written_warning" string="Last Written Warning"/>
                <field name="responsible"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="employee_transfer_form_tree" model="ir.actions.act_window">
        <field name="name">Transfer Form</field>
        <field name="res_model">transfer.form</field>
        <field name="context">{}</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>