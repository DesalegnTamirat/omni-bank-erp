<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="employee_category_form" model="ir.ui.view">
        <field name="name">employee.category.form</field>
        <field name="model">employee.category</field>
        <field name="arch" type="xml">
            <form string="Employee Category">
                <sheet>
                    <group>
                        <field name="category_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="employee_category_list" model="ir.ui.view">
        <field name="name">employee.category.list</field>
        <field name="model">employee.category</field>
        <field name="arch" type="xml">
            <list string="Employee Category">
                <field name="category_name"/>
            </list>
        </field>
    </record>

    <record id="employee_category" model="ir.actions.act_window">
        <field name="name">Employee Category</field>
        <field name="res_model">employee.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>