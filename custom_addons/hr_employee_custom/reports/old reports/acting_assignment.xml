<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_acting_assignment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- <t t-call="web.external_layout"> -->
                    <div class="page">
                        <div class="row mt32">
                            <div class="col-8">

                            </div>
                            <div class="col-4" style="float:left;">
                                <strong>Date.:</strong>
                                <span t-esc="datetime.date.today()"/>
                                <br/>
                                <strong>Ref. No.</strong>
                                <span t-field="o.reference"/>
                                <br/>
                                <br/>
                            </div>
                        </div>
                        <div class="row mt32">

                            <div class="col-12">
                                <strong>ID.No.:</strong>
                                <span t-field="o.employee_id"/>
                                <br/>
                                <strong>
                                    <span t-field="o.employee_name"/>
                                </strong>
                                <br/>

                                <strong>
                                    <span t-field="o.current_work_unit"/>
                                </strong>
                                <br/>
                                <br/>

                                <strong>Dear<span t-field="o.employee_name"/>,
                                </strong>
                            </div>
                        </div>


                        <h6 class="text-center">
                            <strong>
                                <u>Re: -Acting Assignment</u>
                            </strong>
                        </h6>
                        <br/>


                        <p>This is to inform you that you are assigned as
                            <strong>
                                <span t-field="o.current_job_position"/>
                            </strong>
                            at Mehal Meda Branch effective from
                            <strong>
                                <span t-field="o.start_date"/>
                            </strong>
                            .
                        </p>
                        <!--                        <t t-if="o.depreciation_line_ids">-->
                        <br/>
                        <p>I am confident that you will exert utmost effort to discharge your responsibilities attached
                            to this acting assignment.
                        </p>
                        <br/>


                    </div>
                    <div>
                        <div class="row mt32">
                            <br/>
                            <div class="col-6">
                                <p>Sincerely yours,</p>
                                <br/>
                                <br/>


                                <strong>CC:</strong>
                                <ul>
                                    <li>Debre Berhan Area Office</li>
                                    <li>IT Security Management Directorate</li>
                                    <li>Mehal Meda Branch</li>
                                    <li>Bunna Bank S.C</li>
                                </ul>

                                <!--                                <span t-field="o.resignation_type" />-->
                                <br/>
                            </div>

                        </div>

                    </div>

                <!-- </t> -->
            </t>
        </t>
    </template>
</odoo>
