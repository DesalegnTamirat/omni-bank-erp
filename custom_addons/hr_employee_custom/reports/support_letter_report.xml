<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Report Action for Support Letter ─────────────────────────────── -->
    <record id="action_report_support_letter" model="ir.actions.report">
        <field name="name">Support Letter</field>
        <field name="model">employee.service.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_employee_custom.report_support_letter</field>
        <field name="report_file">hr_employee_custom.report_support_letter</field>
        <field name="print_report_name">'Support Letter - ' + (object.reference or object.employee_id.name or '')</field>
        <field name="paperformat_id" ref="paperformat_employee_experience_letter"/>
    </record>

    <!-- ── QWeb Template matching Bunna Bank Experience Letter Standard ──── -->
    <template id="report_support_letter">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <!-- Helper variables -->
                    <t t-set="salutation" t-value="o.get_support_letter_salutation()"/>
                    <t t-set="pronouns" t-value="o.get_support_letter_pronouns()"/>
                    <t t-set="ref_no" t-value="o.reference or ''"/>
                    <t t-set="start_date" t-value="o.get_support_letter_hire_date_str()"/>
                    <t t-set="salary_info" t-value="o.get_support_letter_salary_info()"/>
                    <t t-set="signatory" t-value="o.get_support_letter_signatory_name()"/>
                    <t t-set="signatory_title" t-value="o.get_support_letter_signatory_title()"/>
                    <t t-set="sig_stamp_b64" t-value="o.get_support_letter_signature_stamp()"/>
                    <t t-set="sig_data" t-value="o.get_support_letter_signature_data()"/>
                    <t t-set="logo_uri" t-value="o.get_experience_letter_logo_data_uri()"/>
                    <t t-set="is_amharic" t-value="o.letter_language == 'am'"/>

                    <style type="text/css">
                        @page {
                            size: A4 portrait;
                            margin: 0;
                        }
                        html, body, body.container, body.o_body_pdf, .container, .container-fluid, .article {
                            margin: 0 !important;
                            padding: 0 !important;
                            width: 100% !important;
                            max-width: 100% !important;
                            min-width: 100% !important;
                            height: 100% !important;
                        }
                        .page {
                            margin: 0 !important;
                            padding: 0 !important;
                            width: 100% !important;
                        }
                        .header-table, .header-table tr, .header-table td,
                        .footer-layout-table, .footer-layout-table tr, .footer-layout-table td,
                        .footer-contact-table, .footer-contact-table tr, .footer-contact-table td {
                            border: none !important;
                            border-top: none !important;
                            border-bottom: none !important;
                            border-left: none !important;
                            border-right: none !important;
                            outline: none !important;
                            box-shadow: none !important;
                        }
                        .footer-fixed {
                            position: fixed;
                            bottom: 27pt;
                            left: 0px;
                            right: 0px;
                            width: 100%;
                            margin: 0;
                            padding: 0;
                            border: none !important;
                        }
                        <t t-out="o.get_barlow_font_faces()"/>
                    </style>

                    <div class="page" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" style="font-family: 'Barlow Medium', 'Barlow', Arial, sans-serif; color: #000000; font-size: 11.5pt; line-height: 1.45; width: 100%;">

                        <!-- Official Bunna Bank Letterhead Header Banner (Exact match to Experience Letter) -->
                        <div style="padding-top: 26pt; margin-bottom: 24pt; width: 100%; border: 0 !important;">
                            <table class="header-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0; padding: 0;">
                                <tr style="border: 0 !important;">
                                    <td style="width: 155px; vertical-align: middle; text-align: left; padding: 0 0 0 24px; margin: 0; border: 0 !important;">
                                        <img t-att-src="logo_uri" style="width: 130px; height: auto; display: block; object-fit: contain;" alt="Bunna Bank Logo"/>
                                    </td>
                                    <td style="vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <!-- Official Bunna Bank Coffee Brown Header Bar (#6d382d) -->
                                        <div style="background-color: #6d382d; height: 28px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Body Content Container (25.4mm = 1 inch left & right margins) -->
                        <div style="padding-left: 25.4mm; padding-right: 25.4mm;">

                            <!-- Date and Reference Number (Right Positioned, Left-Aligned Content) -->
                            <div style="text-align: right; margin-top: 4px; margin-bottom: 18px;">
                                <div style="display: inline-block; text-align: left; font-size: 11pt; line-height: 1.4; color: #000000;">
                                    <t t-if="is_amharic">
                                        <div><strong>ቀን: </strong><t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/></div>
                                        <div><strong>ቁጥር: </strong><t t-esc="ref_no"/></div>
                                    </t>
                                    <t t-else="">
                                        <div><strong>Date: </strong><t t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y')"/></div>
                                        <div><strong>Ref. No: </strong><t t-esc="ref_no"/></div>
                                    </t>
                                </div>
                            </div>

                            <!-- English Letter Content -->
                            <t t-if="not is_amharic">
                                <!-- Recipient / Subject -->
                                <t t-if="o.organization_name and o.organization_name.strip() and o.organization_name.strip().lower() != 'to whom it may concern'">
                                    <div style="margin-bottom: 16px; font-size: 11.5pt; line-height: 1.4;">
                                        <div><strong>To: <t t-esc="o.organization_name"/></strong></div>
                                        <div>Addis Ababa, Ethiopia</div>
                                    </div>
                                    <div style="text-align: center; margin-top: 14px; margin-bottom: 18px;">
                                        <span style="font-size: 13pt; font-weight: bold; text-decoration: underline; color: #000000;">
                                            Subject: Letter of Support
                                        </span>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div style="text-align: center; margin-top: 16px; margin-bottom: 22px;">
                                        <span style="font-size: 13pt; font-weight: bold; text-decoration: underline; color: #000000;">
                                            TO WHOM IT MAY CONCERN
                                        </span>
                                    </div>
                                </t>

                                <!-- Opening Paragraph -->
                                <p style="margin-bottom: 12px; text-align: justify; font-size: 11.5pt; line-height: 1.45; color: #000000;">
                                    This is to certify that <strong style="font-weight: bold;"><t t-esc="salutation"/> <t t-esc="o.employee_id.name or ''"/></strong><t t-esc="' '"/>is a permanent employee of Bunna Bank S.C. since <strong style="font-weight: bold;"><t t-esc="start_date"/></strong>, currently serving as <strong style="font-weight: bold;"><t t-esc="o.job_position or (o.employee_id.job_id and o.employee_id.job_id.name) or ''"/></strong> in our <t t-esc="o.employee_work_unit or 'Bank'"/>.
                                </p>

                                <!-- Purpose Paragraph -->
                                <p style="margin-bottom: 12px; text-align: justify; font-size: 11.5pt; line-height: 1.45; color: #000000;">
                                    <t t-if="o.support_purpose == 'visa'">
                                        This letter of support is issued upon <t t-esc="pronouns['poss']"/> request to facilitate <t t-esc="pronouns['poss']"/> visa and travel application. We confirm that <t t-esc="pronouns['subj_lower']"/> has maintained active employment status with the Bank, and <t t-esc="pronouns['subj_lower']"/> is expected to resume official duties upon conclusion of the trip.
                                    </t>
                                    <t t-elif="o.support_purpose == 'financial'">
                                        This letter of support is issued upon <t t-esc="pronouns['poss']"/> request in support of <t t-esc="pronouns['poss']"/> application for banking and financial services.
                                    </t>
                                    <t t-elif="o.support_purpose == 'academic'">
                                        This letter of support is issued upon <t t-esc="pronouns['poss']"/> request to facilitate <t t-esc="pronouns['poss']"/> admission / academic application.
                                    </t>
                                    <t t-elif="o.support_purpose == 'government'">
                                        This letter of support is issued upon <t t-esc="pronouns['poss']"/> request for presentation to relevant administrative and governmental authorities.
                                    </t>
                                    <t t-else="">
                                        This letter of support is issued upon <t t-esc="pronouns['poss']"/> request to facilitate <t t-esc="pronouns['poss']"/> personal administrative matters.
                                    </t>
                                </p>

                                <!-- Remarks / Additional Custom Support Details (if specified) -->
                                <t t-if="o.support">
                                    <p style="margin-bottom: 12px; text-align: justify; font-size: 11.5pt; line-height: 1.45; color: #000000;">
                                        <t t-esc="o.support"/>
                                    </p>
                                </t>

                                <!-- Salary Statement (if include_salary is True) -->
                                <t t-if="o.include_salary and o.salary &gt; 0">
                                    <p style="margin-bottom: 12px; text-align: justify; font-size: 11.5pt; line-height: 1.45; color: #000000;">
                                        <t t-esc="pronouns['subj']"/> is drawing a monthly gross salary of Birr <strong style="font-weight: bold;"><t t-esc="salary_info['figure']"/> ( <t t-esc="salary_info['words']"/> )</strong> along with other company benefits entitled to the position.
                                    </p>
                                </t>

                                <!-- Recommendation & Diligence Statement -->
                                <p style="margin-bottom: 12px; text-align: justify; font-size: 11.5pt; line-height: 1.45; color: #000000;">
                                    During <t t-esc="pronouns['poss']"/> tenure with our Bank, <t t-esc="pronouns['subj_lower']"/> has exhibited diligent performance, integrity, and disciplined conduct. Any assistance accorded to <t t-esc="pronouns['obj']"/> would be highly appreciated.
                                </p>

                                <!-- Release Disclaimer -->
                                <p style="margin-bottom: 14px; text-align: justify; font-size: 11.5pt; line-height: 1.45; color: #000000;">
                                    This letter is issued upon the request of the employee without any liability or financial commitment on the part of Bunna Bank S.C., and does not serve as an employment release.
                                </p>

                                <!-- Sign-off Block -->
                                <div style="margin-top: 14px; margin-bottom: 12px; font-size: 11.5pt; line-height: 1.35; color: #000000;">
                                    <div style="margin-bottom: 3px;">Sincerely yours,</div>
                                    <t t-if="sig_data.get('has_split')">
                                        <div style="margin-bottom: 8px;">
                                            <table style="border: none; border-collapse: collapse; margin-top: 4px; margin-bottom: 6px; padding: 0;">
                                                <tr style="border: none; background: transparent;">
                                                    <t t-if="sig_data.get('stamp_position') == 'left'">
                                                        <td style="border: none; padding: 0 16px 0 0; vertical-align: middle;">
                                                            <img t-if="sig_data.get('stamp_b64')" t-att-src="sig_data.get('stamp_b64')" alt="Official Rubber Stamp" style="width: 105px; height: 105px; object-fit: contain; display: block;"/>
                                                        </td>
                                                        <td style="border: none; padding: 0; vertical-align: middle;">
                                                            <img t-if="sig_data.get('signature_b64')" t-att-src="sig_data.get('signature_b64')" alt="Handwritten Signature" style="max-height: 75px; max-width: 220px; object-fit: contain; display: block;"/>
                                                        </td>
                                                    </t>
                                                    <t t-else="">
                                                        <td style="border: none; padding: 0 16px 0 0; vertical-align: middle;">
                                                            <img t-if="sig_data.get('signature_b64')" t-att-src="sig_data.get('signature_b64')" alt="Handwritten Signature" style="max-height: 75px; max-width: 220px; object-fit: contain; display: block;"/>
                                                        </td>
                                                        <td style="border: none; padding: 0; vertical-align: middle;">
                                                            <img t-if="sig_data.get('stamp_b64')" t-att-src="sig_data.get('stamp_b64')" alt="Official Rubber Stamp" style="width: 105px; height: 105px; object-fit: contain; display: block;"/>
                                                        </td>
                                                    </t>
                                                </tr>
                                            </table>
                                        </div>
                                    </t>
                                    <t t-elif="sig_data.get('legacy_b64') or sig_stamp_b64">
                                        <div style="margin-bottom: 10px;">
                                            <img t-att-src="sig_data.get('legacy_b64') or sig_stamp_b64" alt="Signature &amp; Stamp" style="width: 250px; height: auto; max-height: 155px; object-fit: contain; display: block; margin-top: 4px; margin-bottom: 6px;"/>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div style="height: 45px;"></div>
                                    </t>
                                    <div style="font-weight: bold; margin-bottom: 4px;"><t t-esc="sig_data.get('signatory_name') or signatory"/></div>
                                    <div><t t-esc="sig_data.get('signatory_title') or signatory_title"/></div>
                                    <div><t t-esc="sig_data.get('signatory_company') or 'Bunna Bank S.C.'"/></div>
                                </div>
                            </t>

                            <!-- Amharic Letter Content -->
                            <t t-if="is_amharic">
                                <!-- Recipient / Subject -->
                                <t t-if="o.organization_name and o.organization_name.strip() and o.organization_name.strip().lower() != 'to whom it may concern'">
                                    <div style="margin-bottom: 16px; font-size: 11.5pt; line-height: 1.4;">
                                        <div><strong>ለ፡ <t t-esc="o.organization_name"/></strong></div>
                                        <div>አዲስ አበባ</div>
                                    </div>
                                    <div style="text-align: center; margin-top: 14px; margin-bottom: 18px;">
                                        <span style="font-size: 13pt; font-weight: bold; text-decoration: underline; color: #000000;">
                                            ጉዳዩ፡ የድጋፍ ደብዳቤ ስለመስጠት
                                        </span>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div style="text-align: center; margin-top: 16px; margin-bottom: 22px;">
                                        <span style="font-size: 13pt; font-weight: bold; text-decoration: underline; color: #000000;">
                                            ለሚመለከተው ሁሉ
                                        </span>
                                    </div>
                                </t>

                                <!-- Opening Paragraph -->
                                <p style="margin-bottom: 12px; text-align: justify; font-size: 11.5pt; line-height: 1.45; color: #000000;">
                                    <strong style="font-weight: bold;"><t t-esc="salutation"/> <t t-esc="o.employee_id.name or ''"/></strong><t t-esc="' '"/>ከ <strong style="font-weight: bold;"><t t-esc="start_date"/></strong> ጀምሮ በቡና ባንክ አ.ማ ውስጥ በ <strong style="font-weight: bold;"><t t-esc="o.job_position or (o.employee_id.job_id and o.employee_id.job_id.name) or ''"/></strong> የሥራ መደብ ላይ በቋሚነት ተቀጥረው በማገልገል ላይ የሚገኙ ታማኝ ሠራተኛችን መሆናቸውን እናረጋግጣለን።
                                </p>

                                <!-- Purpose Paragraph -->
                                <p style="margin-bottom: 12px; text-align: justify; font-size: 11.5pt; line-height: 1.45; color: #000000;">
                                    <t t-if="o.support_purpose == 'visa'">
                                        ይህ የድጋፍ ደብዳቤ የተሰጠው ሠራተኛው ለሚያደርጉት የውጭ አገር ጉዞ የቪዛ ማመልከቻ እንዲገለገሉበት ተብሎ ሲሆን፣ ከጉዟቸው መልስ ወደ መደበኛ የሥራ ኃላፊነታቸው እንደሚመለሱ እናረጋግጣለን።
                                    </t>
                                    <t t-elif="o.support_purpose == 'financial'">
                                        ይህ የድጋፍ ደብዳቤ የተሰጠው ሠራተኛው ላቀረቡት የፋይናንስ/የብድር አገልግሎት ማመልከቻ ድጋፍ እንዲሆን ተብሎ ነው።
                                    </t>
                                    <t t-elif="o.support_purpose == 'academic'">
                                        ይህ የድጋፍ ደብዳቤ የተሰጠው ሠራተኛው ለትምህርት ማመልከቻቸው እንዲገለገሉበት ተብሎ ነው።
                                    </t>
                                    <t t-elif="o.support_purpose == 'government'">
                                        ይህ የድጋፍ ደብዳቤ የተሰጠው ሠራተኛው ለሚመለከተው የመንግሥት ወይም አስተዳደራዊ መሥሪያ ቤት እንዲያቀርቡት ተብሎ ነው።
                                    </t>
                                    <t t-else="">
                                        ይህ የድጋፍ ደብዳቤ የተሰጠው ሠራተኛው በጠየቁት መሠረት ለግል ጉዳያቸው እንዲገለገሉበት ተብሎ ነው።
                                    </t>
                                </p>

                                <!-- Remarks / Additional Custom Support Details (if specified) -->
                                <t t-if="o.support">
                                    <p style="margin-bottom: 12px; text-align: justify; font-size: 11.5pt; line-height: 1.45; color: #000000;">
                                        <t t-esc="o.support"/>
                                    </p>
                                </t>

                                <!-- Salary Statement (if include_salary is True) -->
                                <t t-if="o.include_salary and o.salary &gt; 0">
                                    <p style="margin-bottom: 12px; text-align: justify; font-size: 11.5pt; line-height: 1.45; color: #000000;">
                                        በአሁኑ ወቅት የወር ጠቅላላ ደመወዛቸው ብር <strong style="font-weight: bold;"><t t-esc="salary_info['figure']"/> ( <t t-esc="salary_info['words_am']"/> )</strong> ሲሆን በተጨማሪም ለሥራ መደቡ የተፈቀዱ ሌሎች ጥቅማጥቅሞች አሏቸው።
                                    </p>
                                </t>

                                <!-- Recommendation & Diligence Statement -->
                                <p style="margin-bottom: 12px; text-align: justify; font-size: 11.5pt; line-height: 1.45; color: #000000;">
                                    በቆይታቸውም የተሰጣቸውን የሥራ ኃላፊነት በታማኝነት እና በትጋት ሲያከናውኑ የቆዩ መሆናቸውን እየገለጽን ለሚያደርጉላቸው ድጋፍ በቅድሚያ እናመሰግናለን።
                                </p>

                                <!-- Release Disclaimer -->
                                <p style="margin-bottom: 14px; text-align: justify; font-size: 11.5pt; line-height: 1.45; color: #000000;">
                                    ይህ ደብዳቤ በሠራተኛው ጥያቄ መሠረት የተሰጠ ሲሆን፣ ለባንኩ ምንም ዓይነት የገንዘብም ሆነ የዋስትና ግዴታ እንደማይፈጥር እና ከሥራ እንደመልቀቂያ እንደማያገለግል እንገልጻለን።
                                </p>

                                <!-- Sign-off Block -->
                                <div style="margin-top: 14px; margin-bottom: 12px; font-size: 11.5pt; line-height: 1.35; color: #000000;">
                                    <div style="margin-bottom: 3px;">ከሰላምታ ጋር፣</div>
                                    <t t-if="sig_data.get('has_split')">
                                        <div style="margin-bottom: 8px;">
                                            <table style="border: none; border-collapse: collapse; margin-top: 4px; margin-bottom: 6px; padding: 0;">
                                                <tr style="border: none; background: transparent;">
                                                    <t t-if="sig_data.get('stamp_position') == 'left'">
                                                        <td style="border: none; padding: 0 16px 0 0; vertical-align: middle;">
                                                            <img t-if="sig_data.get('stamp_b64')" t-att-src="sig_data.get('stamp_b64')" alt="Official Rubber Stamp" style="width: 105px; height: 105px; object-fit: contain; display: block;"/>
                                                        </td>
                                                        <td style="border: none; padding: 0; vertical-align: middle;">
                                                            <img t-if="sig_data.get('signature_b64')" t-att-src="sig_data.get('signature_b64')" alt="Handwritten Signature" style="max-height: 75px; max-width: 220px; object-fit: contain; display: block;"/>
                                                        </td>
                                                    </t>
                                                    <t t-else="">
                                                        <td style="border: none; padding: 0 16px 0 0; vertical-align: middle;">
                                                            <img t-if="sig_data.get('signature_b64')" t-att-src="sig_data.get('signature_b64')" alt="Handwritten Signature" style="max-height: 75px; max-width: 220px; object-fit: contain; display: block;"/>
                                                        </td>
