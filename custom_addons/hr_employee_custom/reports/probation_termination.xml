<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_probation_revocation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <style type="text/css">
                        @page {
                            size: A4 portrait;
                            margin: 0;
                        }
                        html, body, body.container, body.o_body_pdf, .container, .container-fluid, .article {
                            margin: 0 !important;
                            padding: 0 !important;
                            width: 100% !important;
                            max-width: 100% !important;
                            min-width: 100% !important;
                            height: 100% !important;
                        }
                        .page {
                            margin: 0 !important;
                            padding: 0 !important;
                            width: 100% !important;
                        }
                        .header-table, .header-table tr, .header-table td,
                        .footer-layout-table, .footer-layout-table tr, .footer-layout-table td,
                        .footer-contact-table, .footer-contact-table tr, .footer-contact-table td {
                            border: none !important;
                            border-top: none !important;
                            border-bottom: none !important;
                            border-left: none !important;
                            border-right: none !important;
                            outline: none !important;
                            box-shadow: none !important;
                        }
                        .footer-fixed {
                            position: fixed;
                            bottom: 27pt;
                            left: 0px;
                            right: 0px;
                            width: 100%;
                            margin: 0;
                            padding: 0;
                            border: none !important;
                        }
                        <t t-out="o.get_barlow_font_faces()"/>
                    </style>

                    <div class="page" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" style="font-family: 'Barlow Medium', 'Barlow', Arial, sans-serif !important; color: #000000; font-size: 11pt; line-height: 1.45; width: 100%;">

                        <!-- Official Bunna Bank Letterhead Header Banner (Unstretched logo, full-bleed coffee brown bar #6d382d, zero borders) -->
                        <div style="padding-top: 26pt; margin-bottom: 20pt; width: 100%; border: 0 !important;">
                            <table class="header-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0; padding: 0;">
                                <tr style="border: 0 !important;">
                                    <td style="width: 155px; vertical-align: middle; text-align: left; padding: 0 0 0 24px; margin: 0; border: 0 !important;">
                                        <img t-att-src="o.get_experience_letter_logo_data_uri()" style="width: 130px; height: auto; display: block; object-fit: contain;" alt="Bunna Bank S.C."/>
                                    </td>
                                    <td style="vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <!-- Official Bunna Bank Coffee Brown Header Bar (#6d382d) -->
                                        <div style="background-color: #6d382d; height: 28px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Body Content Container (25.4mm = 1 inch left & right margins) -->
                        <div style="padding-left: 25.4mm; padding-right: 25.4mm;">

                            <!-- Date & Reference Numbers Header (Right Positioned, Left-Aligned Content, Clean borderless div) -->
                            <div style="text-align: right; margin-top: 0; margin-bottom: 14pt;">
                                <div style="display: inline-block; text-align: left; font-size: 11pt; line-height: 1.35; color: #000000;">
                                    <div><strong>Date: </strong><span t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y')"/></div>
                                    <div><strong>Ref. No: </strong><span t-esc="o.name or ''"/></div>
                                </div>
                            </div>

                            <!-- Recipient Block -->
                            <div style="margin-bottom: 12pt; font-size: 11.5pt; line-height: 1.35;">
                                <div><strong><span t-esc="o.employee_id.name if o.employee_id else ''"/></strong></div>
                                <div><strong>Bunna Bank S.C</strong></div>
                                <div><strong style="text-decoration: underline;">Addis Ababa</strong></div>
                            </div>

                            <!-- Salutation -->
                            <div style="margin-bottom: 12pt; font-size: 11.5pt;">
                                <strong>Dear <span t-esc="o.employee_id.name if o.employee_id else ''"/>,</strong>
                            </div>

                            <!-- Subject -->
                            <div style="text-align: center; margin-top: 10pt; margin-bottom: 16pt;">
                                <span style="font-size: 12pt; font-weight: bold; text-decoration: underline; color: #000000;">
                                    Subject: - Termination of Probationary Employment
                                </span>
                            </div>

                            <!-- Body Paragraphs -->
                            <div style="text-align: justify; font-size: 11pt; line-height: 1.5;">
                                <p style="margin-bottom: 10pt; text-align: justify;">
                                    It is to be recalled that the Bank has employed you on <strong><span t-field="o.date_start"/></strong> as <strong><span t-esc="o.job_id.name if o.job_id else ''"/></strong> for a probation period of <strong><span t-esc="o.probation_period"/></strong> working days.
                                </p>

                                <p style="margin-bottom: 10pt; text-align: justify;">
                                    Following regular reviews, your performance, unfortunately, has not reached a satisfactory standard during your probationary period. Your probationary period ends on <strong><span t-field="o.probation_end_date"/></strong> and it has been decided to terminate your employment at this point.
                                </p>

                                <p style="margin-bottom: 10pt; text-align: justify;">
                                    Before leaving the organisation you must ensure that you return all company property (e.g. books, laptop, phone, security pass).
                                </p>

                                <p style="margin-bottom: 10pt; text-align: justify;">
                                    It is an unfortunate outcome, but I do wish you every success in the future.
                                </p>
                            </div>

                            <!-- Sign-off Block with Authorized Signature & Official Stamp -->
                            <div style="font-size: 11pt; line-height: 1.35; margin-top: 14pt; margin-bottom: 10pt; page-break-inside: avoid;">
                                <div style="margin-bottom: 3px;">Sincerely yours,</div>
                                <t t-set="letter_sig_name" t-value="o.get_letter_signatory_name('permanent_letter')"/>
                                <t t-set="letter_sig_title" t-value="o.get_letter_signatory_title('permanent_letter')"/>
                                <t t-set="letter_sig_b64" t-value="o.get_letter_signature_stamp('permanent_letter')"/>
                                <t t-if="letter_sig_b64">
                                    <div style="margin-bottom: 6px;">
                                        <img t-att-src="letter_sig_b64" alt="Authorized Signature &amp; Stamp" style="width: 250px; height: auto; max-height: 155px; object-fit: contain; display: block; margin-top: 4px; margin-bottom: 6px;"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div style="height: 35px;"></div>
                                </t>
                                <div t-if="letter_sig_name"><strong><t t-esc="letter_sig_name"/></strong></div>
                                <div><strong><t t-esc="letter_sig_title"/></strong></div>
                                <div><strong>Bunna Bank S.C.</strong></div>
                            </div>

                            <!-- CC Block -->
                            <div style="font-size: 9.5pt; line-height: 1.3; margin-top: 10pt; page-break-inside: avoid;">
                                <div><strong>CC:</strong></div>
                                <div style="padding-left: 15px;">
                                    <div>Finance Directorate</div>
                                    <div>Talent Management Directorate</div>
                                    <div style="font-weight: bold; text-decoration: underline; margin-top: 1px;">Bunna Bank S.C</div>
                                </div>
                            </div>

                        </div>

                        <!-- Official Bunna Bank Letterhead Footer (Exact parity with Experience Letter, zero borders, pinned to bottom) -->
                        <div class="footer-fixed">
                            <table class="footer-layout-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0; padding: 0;">
                                <tr style="border: 0 !important;">
                                    <!-- Left Olive Green Accent Bar (Bleeds to 0px left edge) -->
                                    <td style="width: 15%; vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <div style="background-color: #253315; height: 26px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                    <!-- Center Contact Info Table (Centered between the two bars) -->
                                    <td style="width: 70%; vertical-align: middle; padding: 0 18px; margin: 0; text-align: center; border: 0 !important;">
                                        <table class="footer-contact-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0 auto; font-size: 8pt; color: #6d382d; line-height: 1.4;">
                                            <tr style="border: 0 !important;">
                                                <td style="width: 34%; text-align: left; padding: 1px 0; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Tel</strong> +251 111 580 861 | 62
                                                </td>
                                                <td style="width: 36%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Email</strong> info@bunnabanksc.com
                                                </td>
                                                <td style="width: 30%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">P.O.Box</strong> 1743 code 1110
                                                </td>
                                            </tr>
                                            <tr style="border: 0 !important;">
                                                <td style="width: 34%; text-align: left; padding: 1px 0; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Fax</strong> +251 111 580 832 | 76
                                                </td>
                                                <td style="width: 36%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Website</strong> www.bunnabanksc.com
                                                </td>
                                                <td style="width: 30%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    Addis Ababa | Ethiopia
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <!-- Right Olive Green Accent Bar (Bleeds to 100% right edge) -->
                                    <td style="width: 15%; vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <div style="background-color: #253315; height: 26px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
