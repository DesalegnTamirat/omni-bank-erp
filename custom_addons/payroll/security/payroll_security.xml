<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_payroll" model="ir.module.category">
            <field name="name">Payroll Management</field>
            <field name="description">Enterprise Payroll Processing and Compensation Management.</field>
            <field name="sequence">25</field>
        </record>

        <!-- Privilege Definition (Odoo 19 ACL Framework) -->
        <record id="res_groups_privilege_payroll" model="res.groups.privilege">
            <field name="name">Payroll Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="payroll.module_category_payroll"/>
        </record>

        <!-- User / HR Accountant (Initiator) -->
        <record id="group_payroll_user" model="res.groups">
            <field name="name">Officer / HR Accountant</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="payroll.res_groups_privilege_payroll"/>
            <field name="comment">Can create and compute payslips, run simulations, and initiate payruns.</field>
        </record>

        <!-- Verifier / Senior Payroll Controller -->
        <record id="group_payroll_verifier" model="res.groups">
            <field name="name">Senior Payroll Controller</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="payroll.res_groups_privilege_payroll"/>
            <field name="implied_ids" eval="[(4, ref('payroll.group_payroll_user'))]"/>
            <field name="comment">Can verify payroll runs, evaluate variance and exception reports.</field>
        </record>

        <!-- Manager / People Service & Reward Division Manager -->
        <record id="group_payroll_manager" model="res.groups">
            <field name="name">Division Manager / Approver</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="payroll.res_groups_privilege_payroll"/>
            <field name="implied_ids" eval="[(4, ref('payroll.group_payroll_verifier'))]"/>
            <field name="comment">Has full authority to grant final approval, authorize cutoff overrides, and trigger GL posting/CBS exports.</field>
        </record>

        <!-- Auditor / Read-Only Inspection -->
        <record id="group_payroll_auditor" model="res.groups">
            <field name="name">Payroll Auditor (Read Only)</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="payroll.res_groups_privilege_payroll"/>
            <field name="comment">Read-only access to all payroll records, change logs, and statutory audit trails.</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Multi-Company Rule -->
        <record id="rule_hr_payslip_company" model="ir.rule">
            <field name="name">HR Payslip Multi-Company</field>
            <field name="model_id" ref="model_hr_payslip"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_hr_payslip_run_company" model="ir.rule">
            <field name="name">HR Payslip Run Multi-Company</field>
            <field name="model_id" ref="model_hr_payslip_run"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Employee Self-Service Rule: View Own Payslip -->
        <record id="rule_hr_payslip_employee" model="ir.rule">
            <field name="name">Employee View Own Payslip</field>
            <field name="model_id" ref="model_hr_payslip"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', 'in', ['done', 'paid'])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Payroll Officer/Manager/Auditor: Access all payslips in company -->
        <record id="rule_hr_payslip_officer" model="ir.rule">
            <field name="name">Payroll Officer All Payslips</field>
            <field name="model_id" ref="model_hr_payslip"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('payroll.group_payroll_user')), (4, ref('payroll.group_payroll_auditor'))]"/>
        </record>
    </data>
</odoo>
