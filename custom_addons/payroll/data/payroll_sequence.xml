<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Payslip Reference -->
        <record id="seq_hr_payslip" model="ir.sequence">
            <field name="name">HR Payslip Sequence</field>
            <field name="code">hr.payslip</field>
            <field name="prefix">SLIP/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Payslip Run / Payrun Batch -->
        <record id="seq_hr_payslip_run" model="ir.sequence">
            <field name="name">HR Payslip Batch Run Sequence</field>
            <field name="code">hr.payslip.run</field>
            <field name="prefix">PAYRUN/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Payroll Period -->
        <record id="seq_hr_payroll_period" model="ir.sequence">
            <field name="name">HR Payroll Period Sequence</field>
            <field name="code">hr.payroll.period</field>
            <field name="prefix">PERIOD/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Cut-Off Override Requests -->
        <record id="seq_hr_payroll_cutoff_override" model="ir.sequence">
            <field name="name">Payroll Cutoff Override Sequence</field>
            <field name="code">hr.payroll.cutoff.override</field>
            <field name="prefix">OVR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Retroactive Calculation -->
        <record id="seq_hr_payroll_retroactive" model="ir.sequence">
            <field name="name">Payroll Retroactive Adjustment Sequence</field>
            <field name="code">hr.payroll.retroactive</field>
            <field name="prefix">RETRO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Payment Batch -->
        <record id="seq_payroll_payment_batch" model="ir.sequence">
            <field name="name">Payroll Payment Batch Sequence</field>
            <field name="code">payroll.payment.batch</field>
            <field name="prefix">PAYBATCH/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
