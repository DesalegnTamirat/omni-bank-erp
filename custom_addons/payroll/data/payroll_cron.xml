<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Automated Payroll Cut-Off Date Lock Enforcement Schedule -->
        <record id="ir_cron_payroll_cutoff_enforcer" model="ir.cron">
            <field name="name">Payroll: Enforce Monthly Cut-Off Locks</field>
            <field name="model_id" ref="model_hr_payroll_period"/>
            <field name="state">code</field>
            <field name="code">model._cron_enforce_cutoff_locks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Managerial Acting Allowance Duration & Policy Monitor Schedule -->
        <record id="ir_cron_acting_allowance_monitor" model="ir.cron">
            <field name="name">Payroll: Monitor Acting Assignment Durations</field>
            <field name="model_id" ref="model_hr_acting_assignment"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_acting_durations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Periodic Synchronizer for Attendance Overtime and Disciplinary Penalties -->
        <record id="ir_cron_ingest_pending_payloads" model="ir.cron">
            <field name="name">Payroll: Ingest External ERP Payloads</field>
            <field name="model_id" ref="model_hr_payslip"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_pending_erp_payloads()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Automated Pre-Flight Anomaly Diagnostics and Exception Scanner Schedule -->
        <record id="ir_cron_payroll_exception_scanner" model="ir.cron">
            <field name="name">Payroll: Pre-Flight Exception Scanner</field>
            <field name="model_id" ref="model_hr_payroll_exception"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_exception_scanner()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
