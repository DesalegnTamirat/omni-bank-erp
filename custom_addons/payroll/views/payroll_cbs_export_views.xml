<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payroll_payment_batch_tree" model="ir.ui.view">
        <field name="name">payroll.payment.batch.list</field>
        <field name="model">payroll.payment.batch</field>
        <field name="arch" type="xml">
            <list string="CBS Payment Batches">
                <field name="number"/>
                <field name="name"/>
                <field name="payrun_id"/>
                <field name="payment_date"/>
                <field name="export_format"/>
                <field name="total_count"/>
                <field name="total_amount" decoration-bf="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'generated'" decoration-success="state in ['transmitted', 'reconciled']"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_payment_batch_form" model="ir.ui.view">
        <field name="name">payroll.payment.batch.form</field>
        <field name="model">payroll.payment.batch</field>
        <field name="arch" type="xml">
            <form string="CBS Direct Credit Payment Batch">
                <header>
                    <button name="action_generate_export_file" string="Generate Payment File" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_transmitted" string="Transmit to CBS" type="object" class="btn-success" invisible="state != 'generated'" groups="payroll.group_payroll_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,transmitted,reconciled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <h3><field name="number"/></h3>
                    </div>
                    <group>
                        <group string="Batch Parameters">
                            <field name="payrun_id" options="{'no_create': True}"/>
                            <field name="payment_date"/>
                            <field name="export_format"/>
                        </group>
                        <group string="Aggregates &amp; Generated File">
                            <field name="total_count"/>
                            <field name="total_amount" decoration-bf="1"/>
                            <field name="export_file" filename="export_filename" widget="binary"/>
                            <field name="export_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Beneficiary Instructions" name="lines">
                            <field name="line_ids">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="beneficiary_name"/>
                                    <field name="bank_account_number"/>
                                    <field name="amount" decoration-bf="1"/>
                                    <field name="narrative"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_payroll_payment_batch" model="ir.actions.act_window">
        <field name="name">CBS Payment Batches</field>
        <field name="res_model">payroll.payment.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
