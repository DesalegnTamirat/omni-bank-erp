<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_exception_tree" model="ir.ui.view">
        <field name="name">hr.payroll.exception.list</field>
        <field name="model">hr.payroll.exception</field>
        <field name="arch" type="xml">
            <list string="Payroll Exceptions &amp; Variances">
                <field name="create_date" string="Detected At"/>
                <field name="employee_id"/>
                <field name="payslip_id"/>
                <field name="exception_type"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'" decoration-info="severity == 'info'"/>
                <field name="previous_net"/>
                <field name="current_net"/>
                <field name="variance_percentage"/>
                <field name="is_resolved" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_payroll_exception_form" model="ir.ui.view">
        <field name="name">hr.payroll.exception.form</field>
        <field name="model">hr.payroll.exception</field>
        <field name="arch" type="xml">
            <form string="Payroll Anomaly Diagnostic">
                <header>
                    <button name="action_mark_resolved" string="Acknowledge &amp; Resolve" type="object" class="btn-success" invisible="is_resolved"/>
                </header>
                <sheet>
                    <group>
                        <group string="Affected Subject">
                            <field name="employee_id"/>
                            <field name="payslip_id"/>
                            <field name="payrun_id"/>
                        </group>
                        <group string="Anomaly Classification">
                            <field name="exception_type"/>
                            <field name="severity"/>
                            <field name="is_resolved"/>
                            <field name="resolved_by" invisible="not is_resolved"/>
                        </group>
                    </group>
                    <group string="Variance Analysis" invisible="exception_type != 'high_variance'">
                        <group>
                            <field name="previous_net"/>
                            <field name="current_net"/>
                        </group>
                        <group>
                            <field name="variance_percentage"/>
                        </group>
                    </group>
                    <group string="Detailed Findings">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Resolution Rationale" invisible="not is_resolved">
                        <field name="resolution_note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_exception" model="ir.actions.act_window">
        <field name="name">Diagnostic Exceptions</field>
        <field name="res_model">hr.payroll.exception</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
