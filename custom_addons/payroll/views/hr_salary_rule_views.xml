<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Salary Rule Category Views -->
    <record id="view_hr_salary_rule_category_tree" model="ir.ui.view">
        <field name="name">hr.salary.rule.category.list</field>
        <field name="model">hr.salary.rule.category</field>
        <field name="arch" type="xml">
            <list string="Salary Rule Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_salary_rule_category_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.category.form</field>
        <field name="model">hr.salary.rule.category</field>
        <field name="arch" type="xml">
            <form string="Salary Rule Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Category notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_salary_rule_category" model="ir.actions.act_window">
        <field name="name">Salary Rule Categories</field>
        <field name="res_model">hr.salary.rule.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Salary Rule Views -->
    <record id="view_hr_salary_rule_tree" model="ir.ui.view">
        <field name="name">hr.salary.rule.list</field>
        <field name="model">hr.salary.rule</field>
        <field name="arch" type="xml">
            <list string="Salary Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="structure_id"/>
                <field name="amount_select"/>
                <field name="appears_on_payslip" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_salary_rule_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.form</field>
        <field name="model">hr.salary.rule</field>
        <field name="arch" type="xml">
            <form string="Salary Calculation Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Rule Identification">
                            <field name="code"/>
                            <field name="category_id"/>
                            <field name="structure_id"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Display &amp; Visibility">
                            <field name="appears_on_payslip"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conditions" name="conditions">
                            <group>
                                <field name="condition_select"/>
                                <field name="condition_range" invisible="condition_select != 'range'"/>
                                <field name="condition_range_min" invisible="condition_select != 'range'"/>
                                <field name="condition_range_max" invisible="condition_select != 'range'"/>
                            </group>
                            <group string="Python Condition Expression" invisible="condition_select != 'python'">
                                <field name="condition_python" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Computation" name="computation">
                            <group>
                                <field name="amount_select"/>
                                <field name="amount_fix" invisible="amount_select != 'fix'"/>
                                <field name="amount_percentage" invisible="amount_select != 'percentage'"/>
                                <field name="amount_percentage_base" invisible="amount_select != 'percentage'"/>
                            </group>
                            <group string="Python Code Script" invisible="amount_select != 'code'">
                                <field name="amount_python_compute" nolabel="1" widget="ace" options="{'mode': 'python'}"/>
                            </group>
                        </page>
                        <page string="Policy Reference &amp; Notes" name="notes">
                            <field name="note" placeholder="Enter bank policy or statutory proclamation references..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_salary_rule" model="ir.actions.act_window">
        <field name="name">Salary Rules</field>
        <field name="res_model">hr.salary.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
