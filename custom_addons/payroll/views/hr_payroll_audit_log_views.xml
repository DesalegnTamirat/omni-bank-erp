<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_audit_log_tree" model="ir.ui.view">
        <field name="name">hr.payroll.audit.log.list</field>
        <field name="model">hr.payroll.audit.log</field>
        <field name="arch" type="xml">
            <list string="Payroll Transaction Audit Ledger" create="0" delete="0">
                <field name="timestamp"/>
                <field name="event_type" widget="badge"/>
                <field name="employee_id"/>
                <field name="initiator_id"/>
                <field name="approver_id"/>
                <field name="new_value"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_hr_payroll_audit_log_form" model="ir.ui.view">
        <field name="name">hr.payroll.audit.log.form</field>
        <field name="model">hr.payroll.audit.log</field>
        <field name="arch" type="xml">
            <form string="Payroll Audit Log Record" create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group string="Event Metadata">
                            <field name="timestamp"/>
                            <field name="event_type"/>
                            <field name="model_name"/>
                            <field name="res_id"/>
                        </group>
                        <group string="Subjects &amp; Actors">
                            <field name="employee_id"/>
                            <field name="initiator_id"/>
                            <field name="approver_id"/>
                        </group>
                    </group>
                    <group string="Value Differential">
                        <field name="previous_value"/>
                        <field name="new_value"/>
                    </group>
                    <group string="Audit Narrative">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Change Logs</field>
        <field name="res_model">hr.payroll.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
