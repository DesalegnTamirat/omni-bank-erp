<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_segment_tree" model="ir.ui.view">
        <field name="name">hr.payslip.segment.list</field>
        <field name="model">hr.payslip.segment</field>
        <field name="arch" type="xml">
            <list string="Proration Segments">
                <field name="payslip_id"/>
                <field name="name"/>
                <field name="segment_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days_count"/>
                <field name="proration_factor"/>
                <field name="prorated_basic_salary"/>
                <field name="prorated_hardship_allowance"/>
                <field name="total_prorated_earnings" decoration-bf="1"/>
            </list>
        </field>
    </record>

    <record id="action_hr_payslip_segment" model="ir.actions.act_window">
        <field name="name">Proration Segments</field>
        <field name="res_model">hr.payslip.segment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
