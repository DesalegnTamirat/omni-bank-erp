<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_tree" model="ir.ui.view">
        <field name="name">hr.payslip.list</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <list string="Employee Payslips">
                <field name="number"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="basic_wage"/>
                <field name="hardship_wage"/>
                <field name="gross_wage"/>
                <field name="income_tax"/>
                <field name="pension_ee"/>
                <field name="net_wage" decoration-bf="1"/>
                <field name="has_critical_exceptions" widget="boolean" string="Blocker"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'verify'" decoration-success="state in ['done', 'paid']" decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">hr.payslip.form</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <form string="Employee Payslip">
                <header>
                    <button string="Compute Sheet" name="compute_sheet" type="object" class="btn-primary" invisible="state not in ['draft', 'verify']"/>
                    <button string="Submit for Verification" name="action_payslip_verify" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                    <button string="Final Approval &amp; Commit" name="action_payslip_done" type="object" class="btn-success" invisible="state != 'verify'" groups="payroll.group_payroll_manager"/>
                    <button string="Cancel Payslip" name="action_payslip_cancel" type="object" class="btn-danger" invisible="state not in ['draft', 'verify']"/>
                    <button string="Set to Draft" name="action_payslip_draft" type="object" invisible="state not in ['cancel', 'verify']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verify,done,paid"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not has_critical_exceptions">
                        <strong>Critical Diagnostics Warning:</strong> This payslip has unresolved critical exceptions that block final commitment. Check the <strong>Diagnostics &amp; Exceptions</strong> tab.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <h3><field name="number"/></h3>
                    </div>
                    <group>
                        <group string="Employee &amp; Structure">
                            <field name="employee_id"/>
                            <field name="contract_id"/>
                            <field name="struct_id"/>
                            <field name="operating_unit_id"/>
                        </group>
                        <group string="Period &amp; Banking">
                            <field name="period_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="bank_account"/>
                            <field name="employee_tin"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="has_critical_exceptions" invisible="1"/>
                        </group>
                    </group>

                    <!-- Summary Cards -->
                    <div class="row my-3">
                        <div class="col-3">
                            <div class="card text-center bg-light p-2 border">
                                <small class="text-muted">Basic Salary</small>
                                <h4 class="mb-0">ETB <field name="basic_wage" readonly="1"/></h4>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="card text-center bg-light p-2 border">
                                <small class="text-muted">Gross Earnings</small>
                                <h4 class="mb-0 text-primary">ETB <field name="gross_wage" readonly="1"/></h4>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="card text-center bg-light p-2 border">
                                <small class="text-muted">Tax &amp; Deductions</small>
                                <h4 class="mb-0 text-danger">ETB <field name="income_tax" readonly="1"/></h4>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="card text-center bg-light p-2 border">
                                <small class="text-muted">Net Disbursement</small>
                                <h4 class="mb-0 text-success font-weight-bold">ETB <field name="net_wage" readonly="1"/></h4>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Salary Computation" name="salary_computation">
                            <field name="line_ids" readonly="1">
                                <list decoration-info="category_id == %(payroll.cat_basic)d" decoration-success="category_id == %(payroll.cat_net)d" decoration-danger="category_id in [%(payroll.cat_stat_ded)d, %(payroll.cat_other_ded)d]">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="quantity"/>
                                    <field name="rate"/>
                                    <field name="amount"/>
                                    <field name="total" decoration-bf="1"/>
                                    <field name="appears_on_payslip" widget="boolean"/>
                                </list>
                            </field>
                        </page>

                        <page string="Mid-Month Proration Segments (FR-PAY-002)" name="segments">
                            <field name="segment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="segment_type"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="days_count"/>
                                    <field name="proration_factor"/>
                                    <field name="hardship_percentage"/>
                                    <field name="prorated_basic_salary"/>
                                    <field name="prorated_hardship_allowance"/>
                                    <field name="total_prorated_earnings" decoration-bf="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Variable Inputs &amp; Adjustments" name="inputs">
                            <field name="input_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="amount"/>
                                    <field name="input_type"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>

                        <page string="Diagnostics &amp; Exceptions (FR-PAY-036)" name="exceptions">
                            <field name="exception_ids" readonly="1">
                                <list decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'" decoration-info="severity == 'info'">
                                    <field name="exception_type"/>
                                    <field name="severity"/>
                                    <field name="previous_net"/>
                                    <field name="current_net"/>
                                    <field name="variance_percentage"/>
                                    <field name="description"/>
                                    <field name="is_resolved" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>

                        <page string="Accounting &amp; Remarks" name="notes">
                            <group>
                                <field name="payslip_run_id" readonly="1"/>
                                <field name="notes" placeholder="Additional audit notes or explanations..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_payslip" model="ir.actions.act_window">
        <field name="name">Employee Payslips</field>
        <field name="res_model">hr.payslip</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
