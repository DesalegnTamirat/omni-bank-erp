<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_automatic_scorecard_notify_wizard_form" model="ir.ui.view">
        <field name="name">automatic.scorecard.notify.wizard.form</field>
        <field name="model">automatic.scorecard.notify.wizard</field>
        <field name="arch" type="xml">
            <form string="Automatic Scorecard Notify">
                <group>
                    <field name="planning_name" options="{'no_create': True}"/>
                    <field name="appraisal_period"/>
                    <field name="fiscal_year" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_populate" string="Populate"  type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id ="action_automatic_scorecard_notify_wizard" model="ir.actions.act_window">
        <field name="name">Automatic Scorecard Notify</field>
        <field name="res_model">automatic.scorecard.notify.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

