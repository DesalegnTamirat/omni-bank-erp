<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_performance_job_objective_list" model="ir.ui.view">
        <field name="name">performance.job.objective.list</field>
        <field name="model">performance.job.objective</field>
        <field name="arch" type="xml">
            <list string="Job Position KPIs">
                <field name="operating_unit_id"/>
                <field name="job_id"/>
                <field name="perspective_id"/>
                <field name="parent_objective_id"/>
                <field name="name"/>
                <field name="total_weight" sum="Total Weight"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_performance_job_objective_form" model="ir.ui.view">
        <field name="name">performance.job.objective.form</field>
        <field name="model">performance.job.objective</field>
        <field name="arch" type="xml">
            <form string="Key Performance Indicator">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Enhance Internal Control Capability"/>
                        </h1>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body" style="border-left: 4px solid #1d2b32; background-color:#f4f6f8; padding: 14px 18px;">
                                    <h6 class="mb-3 font-weight-bold" style="color:#1d2b32;">
                                        <i class="fa fa-briefcase me-2"/>Position &amp; Work Unit
                                    </h6>
                                    <group>
                                        <field name="operating_unit_id" string="Work Unit" options="{'no_create': True}" required="1"/>
                                        <field name="job_id" string="Job Position" options="{'no_create': True}" required="1"/>
                                        <field name="active"/>
                                    </group>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body" style="border-left: 4px solid #c17540; background-color:#fbf3ee; padding: 14px 18px;">
                                    <h6 class="mb-3 font-weight-bold" style="color:#c17540;">
                                        <i class="fa fa-sitemap me-2"/>Cascaded From (Work Unit)
                                    </h6>
                                    <group>
                                        <field name="parent_measure_id" string="Work Unit KPI" options="{'no_create': True}" required="1"/>
                                        <field name="parent_objective_id" string="Strategic Objective" readonly="1"/>
                                        <field name="perspective_id" string="Perspective" readonly="1"/>
                                    </group>
                                </div>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Measurements" name="measures_page">
                            <field name="measure_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="weight" string="Weight %" sum="Total Weight"/>
                                    <field name="target_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_performance_job_objective_search" model="ir.ui.view">
        <field name="name">performance.job.objective.search</field>
        <field name="model">performance.job.objective</field>
        <field name="arch" type="xml">
            <search string="Search Job Position KPIs">
                <field name="name"/>
                <field name="operating_unit_id"/>
                <field name="job_id"/>
                <field name="parent_objective_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Work Unit" name="group_unit" context="{'group_by': 'operating_unit_id'}"/>
                    <filter string="Job Position" name="group_job" context="{'group_by': 'job_id'}"/>
                    <filter string="Perspective" name="group_perspective" context="{'group_by': 'perspective_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_performance_job_objective_kanban" model="ir.ui.view">
        <field name="name">performance.job.objective.kanban</field>
        <field name="model">performance.job.objective</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    default_group_by="operating_unit_id"
                    group_create="false"
                    quick_create="false">
                <field name="job_id"/>
                <field name="parent_objective_id"/>
                <field name="perspective_id"/>
                <field name="name"/>
                <field name="measure_count"/>
                <field name="total_weight"/>
                <templates>
                    <t t-name="card">
                        <t t-set="p_color" t-value="
                            record.perspective_id.value == 'Financial' and '#425727'
                            or record.perspective_id.value == 'Stakeholder' and '#c17540'
                            or record.perspective_id.value == 'Learning &amp; Growth' and '#726732'
                            or '#1d2b32'"/>
                        <t t-set="p_bg" t-value="
                            record.perspective_id.value == 'Financial' and '#eef2ea'
                            or record.perspective_id.value == 'Stakeholder' and '#faf0e8'
                            or record.perspective_id.value == 'Learning &amp; Growth' and '#f3f1ea'
                            or '#eceef0'"/>
                        <div class="card-body rounded-3 shadow-sm mb-1"
                             t-attf-style="background-color:{{p_bg}}; border-left: 5px solid {{p_color}}; padding: 12px 14px;">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="o_kanban_record_title" style="font-size: 14px;">
                                    <field name="name"/>
                                </strong>
                                <span t-if="record.perspective_id.value" class="badge ms-2"
                                      t-attf-style="background-color:{{p_color}}; color:#fff; font-weight: 500; white-space: nowrap;">
                                    <field name="perspective_id"/>
                                </span>
                            </div>
                            <div class="text-muted small mt-2">
                                <i class="fa fa-briefcase me-1"/>
                                <field name="job_id"/>
                            </div>
                            <div class="text-muted small" t-if="record.parent_objective_id.value">
                                <i class="fa fa-arrow-up me-1"/>
                                Cascaded from: <field name="parent_objective_id"/>
                            </div>
                            <div class="mt-2 d-flex flex-wrap gap-2">
                                <span t-if="record.measure_count.value == 0" class="badge rounded-pill"
                                      style="background-color:#c62828; color:#fff; font-weight: 500;">
                                    <i class="fa fa-exclamation-triangle me-1"/>
                                    No Measurements
                                </span>
                                <span t-else="" class="badge rounded-pill" style="background-color:#fff; color:#333; border:1px solid #ddd; font-weight: 400;">
                                    <i class="fa fa-bullseye me-1"/>
                                    <field name="measure_count"/> Measurement(s)
                                </span>
                                <span class="badge rounded-pill"
                                      t-attf-style="background-color:#fff; font-weight: 500; border:1px solid {{record.total_weight.value == 100 and '#425727' or '#c17540'}}; color:{{record.total_weight.value == 100 and '#425727' or '#c17540'}};">
                                    <i class="fa fa-percent me-1"/>
                                    <field name="total_weight"/>%
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_performance_job_objective" model="ir.actions.act_window">
        <field name="name">Job Position KPIs</field>
        <field name="res_model">performance.job.objective</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_performance_job_objective_search"/>
    </record>

</odoo>