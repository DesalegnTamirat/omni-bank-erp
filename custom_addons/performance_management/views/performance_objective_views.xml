<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_performance_objective_list" model="ir.ui.view">
        <field name="name">performance.objective.list</field>
        <field name="model">performance.objective</field>
        <field name="arch" type="xml">
            <list string="Strategic Objectives"
                  decoration-muted="not active">
                <field name="employee_id"/>
                <field name="employee_operating_unit_id" string="Operating Unit"/>
                <field name="perspective_id"/>
                <field name="name"/>
                <field name="parent_objective_id" optional="show"/>
                <field name="coach_id" optional="hide"/>
                <field name="active" invisible="1" optional="show"/>

            </list>
        </field>
    </record>
    <record id="view_performance_objective_search" model="ir.ui.view">
        <field name="name">performance.objective.search</field>
        <field name="model">performance.objective</field>
        <field name="arch" type="xml">
            <search string="Search Strategic Objectives">
                <field name="name"/>
                <field name="employee_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Active" name="active_only" domain="[('active', '=', True)]"/>
                <group name="group_by">
                    <filter string="Perspective" name="group_perspective" context="{'group_by': 'perspective_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_performance_objective_form" model="ir.ui.view">
        <field name="name">performance.objective.form</field>
        <field name="model">performance.objective</field>
        <field name="arch" type="xml">
            <form string="Strategic Objective">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Increase Revenue"/>
                        </h1>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body" style="border-left: 4px solid #425727; background-color:#f4f6f2;">
                                    <h6 class="mb-3" style="color:#425727;">
                                        <i class="fa fa-user-circle me-2"/>Ownership
                                    </h6>
                                    <group>
                                        <field name="employee_id"/>
                                        <field name="employee_operating_unit_id" readonly="1"/>
                                        <field name="coach_id" readonly="1"/>
                                        <field name="coach_operating_unit_id" readonly="1"/>
                                    </group>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body" style="border-left: 4px solid #c17540; background-color:#fbf3ee;">
                                    <h6 class="mb-3" style="color:#c17540;">
                                        <i class="fa fa-sitemap me-2"/>Cascade Configuration
                                    </h6>
                                    <group>
                                        <field name="parent_objective_id" options="{'no_create': True}"/>
                                        <field name="perspective_id" options="{'no_create': True}"/>
                                        <field name="active"/>
                                    </group>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-body" style="border-left: 4px solid #1d2b32; background-color:#f2f4f5;">
                            <h6 class="mb-3" style="color:#1d2b32;">
                                <i class="fa fa-bullseye me-2"/>Measures (KPIs)
                            </h6>
                            <field name="measure_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="kpi"/>
                                    <field name="weight" string="Weight %" sum="Total Weight" required="1"/>
                                    <field name="target_type"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_performance_objective_kanban" model="ir.ui.view">
        <field name="name">performance.objective.kanban</field>
        <field name="model">performance.objective</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    default_group_by="employee_operating_unit_id"
                    group_create="false"
                    quick_create="false">
                <field name="employee_id"/>
                <field name="employee_operating_unit_id"/>
                <field name="coach_id"/>
                <field name="perspective_id"/>
                <field name="name"/>
                <field name="parent_objective_id"/>
                <field name="measure_count"/>
                <field name="total_weight"/>
                <field name="unit_total_weight"/>
                <templates>
                    <t t-name="card">
                        <t t-set="p_color" t-value="
                            record.perspective_id.value == 'Financial' and '#425727'
                            or record.perspective_id.value == 'Stakeholder' and '#c17540'
                            or record.perspective_id.value == 'Learning &amp; Growth' and '#726732'
                            or '#1d2b32'"/>
                        <t t-set="p_bg" t-value="
                            record.perspective_id.value == 'Financial' and '#eef2ea'
                            or record.perspective_id.value == 'Stakeholder' and '#faf0e8'
                            or record.perspective_id.value == 'Learning &amp; Growth' and '#f3f1ea'
                            or '#eceef0'"/>
                        <div class="card-body rounded-3 shadow-sm mb-1"
                             t-attf-style="background-color:{{p_bg}}; border-left: 5px solid {{p_color}}; padding: 12px 14px;">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="o_kanban_record_title" style="font-size: 14px;">
                                    <field name="name"/>
                                </strong>
                                <span t-if="record.perspective_id.value" class="badge ms-2"
                                      t-attf-style="background-color:{{p_color}}; color:#fff; font-weight: 500; white-space: nowrap;">
                                    <field name="perspective_id"/>
                                </span>
                            </div>
                            <div class="d-flex align-items-center text-muted small mt-2" t-if="record.parent_objective_id.value">
                                <i class="fa fa-arrow-up me-1"/>
                                Cascaded from: <field name="parent_objective_id"/>
                            </div>
                            <div class="d-flex align-items-center text-muted small mt-2">
                                <i class="fa fa-user-circle me-1"/>
                                <field name="employee_id"/>
                            </div>
                            <div class="d-flex align-items-center text-muted small" t-if="record.coach_id.value">
                                <i class="fa fa-graduation-cap me-1"/>
                                <field name="coach_id"/>
                            </div>
                            <div class="mt-2 d-flex flex-wrap gap-2">
                                <span t-if="record.measure_count.value == 0" class="badge rounded-pill"
                                      style="background-color:#c62828; color:#fff; font-weight: 500;">
                                    <i class="fa fa-exclamation-triangle me-1"/>
                                    No Measures
                                </span>
                                <span t-else="" class="badge rounded-pill" style="background-color:#fff; color:#333; border:1px solid #ddd; font-weight: 400;">
                                    <i class="fa fa-bullseye me-1"/>
                                    <field name="measure_count"/> Measure(s)
                                </span>
                                <span class="badge rounded-pill"
                                      t-attf-style="background-color:#fff; font-weight: 500; border:1px solid {{record.total_weight.value == 100 and '#425727' or '#c17540'}}; color:{{record.total_weight.value == 100 and '#425727' or '#c17540'}};">
                                    <i class="fa fa-percent me-1"/>
                                    <field name="total_weight"/>% Objective
                                </span>
                                <span class="badge rounded-pill"
                                      t-attf-style="background-color:{{record.unit_total_weight.value == 100 and '#2e7d32' or '#c62828'}}; color:#fff; font-weight: 500;">
                                    <i class="fa fa-building me-1"/>
                                    <field name="unit_total_weight"/>% Unit Total
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_performance_objective" model="ir.actions.act_window">
        <field name="name">Performance Objective</field>
        <field name="res_model">performance.objective</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>