<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client Action for Executive Performance Dashboard -->
    <record id="action_performance_dashboard" model="ir.actions.client">
        <field name="name">Executive Performance Dashboard</field>
        <field name="tag">performance_dashboard_client_action</field>
        <field name="target">current</field>
    </record>

    <!-- Top-Level Dashboard Menu -->
    <menuitem id="menu_performance_dashboard"
              name="Dashboard"
              parent="menu_performance_management_root"
              action="action_performance_dashboard"
              groups="performance_management.group_performance_manager,performance_management.group_performance_planning,performance_management.group_performance_hr,performance_management.group_performance_admin"
              sequence="1"/>

</odoo>
