              name="Appraisal Period"
              parent="menu_scorecard_config"
              action= "action_appraisal_period"
              sequence="20"/>
    <menuitem id="menu_config_fiscal_year"
              name="Fiscal Years"
              parent="menu_scorecard_config"
              action="action_performance_fiscal_year"
              sequence="30"/>

    <menuitem id="menu_config_perspective"
              name="Perspectives"
              parent="menu_scorecard_config"
              action="action_performance_perspective"
              sequence="40"/>

    <menuitem id="menu_config_strategic_objective"
              name="Strategic Objectives"
              parent="menu_scorecard_config"
              action="action_performance_objective"
              sequence="50"/>
    <menuitem id="menu_performance_measure"
              name="Performance Measure"
              parent="menu_scorecard_config"
              action="action_performance_measure"
              sequence="60"/>
    <menuitem id="menu_tier3_job_objective"
          name="Job Position Measures"
          parent="menu_scorecard_config"
          action="action_performance_job_objective"
          sequence="70"/>
    <menuitem id="menu_job_measure_bulk"
          name="Job KPI Bulk Entry"
          parent="menu_configuration"
          action="action_performance_job_measure_bulk"
          sequence="80"/>
    <!-- Appraisal Configurations-->
    <menuitem id="menu_appraisal_config"
              name="Appraisal Configurations"
              parent="menu_configuration"
              sequence="10"/>
    <menuitem id="menu_config_pms_ranking"
              name="PMS Ranking"
              parent= "menu_appraisal_config"
              action="action_performance_pms_ranking"
