    <!-- Fiscal Year -->
    <record id="view_performance_fiscal_year_list" model="ir.ui.view">
        <field name="name">performance.fiscal.year.list</field>
        <field name="model">performance.fiscal.year</field>
        <field name="arch" type="xml">
        <list string="Fiscal Years">
            <field name="name"/>
            <field name="date_start"/>
            <field name="date_end"/>
        </list>
    </field>
    </record>

    <!-- Form View for Fiscal Year -->
    <record id="view_fiscal_year_form" model="ir.ui.view">
        <field name="name">fiscal.year.form</field>
        <field name="model">performance.fiscal.year</field>
        <field name="arch" type="xml">
           <form string="Fiscal Year">
              <sheet>
                  <group name="main_data" string=" Fiscal Year Information">
                        <group name="left_group" string="Details">
                            <field name="name" string="Fiscal Year" />
                            <field name="company_id" string="Company"/>
                            <field name="active" string="Active"/>
                        </group>
                        <group name="right_group" string="Period">
                            <field name="date_start" string="Start Date" required="1"/>
                            <field name="date_end" string="End Date" required="1"/>

                        </group>
                    </group>
                    <notebook>
                        <page string="Fiscal Year" name="fiscal_year_lines">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="appraisal_period"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                 </sheet>
           </form>
        </field>

    </record>

     <record id="action_performance_fiscal_year" model="ir.actions.act_window">
        <field name="name">Fiscal Years</field>
        <field name="res_model">performance.fiscal.year</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_performance_pms_ranking_list" model="ir.ui.view">
        <field name="name">pms.ranking.list</field>
        <field name="model">pms.ranking</field>
        <field name="arch" type="xml">
            <list string="Pms Ranking" editable="bottom">
                <field name="score_from"/>
                <field name="score_to"/>
                <field name="ranking" widget="badge"
                       decoration-success="ranking == 'outstanding'"
                       decoration-info="ranking == 'excellent'"
                       decoration-warning="ranking == 'satisfactory'"
                       decoration-danger="ranking == 'unsatisfactory'"/>
            </list>
        </field>
    </record>

    <record id="action_performance_pms_ranking" model="ir.actions.act_window">
        <field name="name">PMS Ranking</field>
        <field name="res_model">pms.ranking</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Performance Measure -->
    <record id="view_performance_measure_list" model="ir.ui.view">
        <field name="name">performance.measure.list</field>
        <field name="model">performance.measure</field>
        <field name="arch" type="xml">
            <list string="Performance Measures">
                <field name="objective_id"/>
                <field name="perspective_id"/>
                <field name="name"/>
                <field name="kpi"/>
                <field name="weight" string="Weight %" sum="Total Weight"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_performance_measure_form" model="ir.ui.view">
        <field name="name">performance.measure.form</field>
        <field name="model">performance.measure</field>
        <field name="arch" type="xml">
            <form string="Performance Measure">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Amount of total revenue generated"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="objective_id" options="{'no_create': True}"/>
                            <field name="perspective_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="weight" widget="percentage"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_performance_measure_search" model="ir.ui.view">
        <field name="name">performance.measure.search</field>
        <field name="model">performance.measure</field>
        <field name="arch" type="xml">
            <search string="Search Performance Measures">
                <field name="name"/>
                <field name="objective_id"/>
                <field name="perspective_id"/>
                <group name="group_by">
                    <filter string="Perspective" name="group_perspective" context="{'group_by': 'perspective_id'}"/>
                    <filter string="Strategic Objective" name="group_objective" context="{'group_by': 'objective_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_performance_measure" model="ir.actions.act_window">
        <field name="name">Performance Measures</field>
        <field name="res_model">performance.measure</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_performance_measure_search"/>
    </record>

   <record id="view_appraisal_period_list" model="ir.ui.view">
        <field name="name">appraisal.period.list</field>
        <field name="model">appraisal.period</field>
        <field name="arch" type="xml">
        <list string="Appraisal Periods" editable="bottom">
            <field name="name"/>
            <field name="code"/>
            <field name="active"/>
        </list>
    </field>
    </record>
    <record id="view_appraisal_period_form" model="ir.ui.view">
        <field name="name">appraisal.period.form</field>
        <field name="model">appraisal.period</field>
        <field name="arch" type="xml">
            <form string="Appraisal Period">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. First Quarter"/>
                        </h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_appraisal_period" model="ir.actions.act_window">
        <field name="name">Appraisal Periods</field>
        <field name="res_model">appraisal.period</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus Performance Configuration -->
    <!-- Scorecard Configurations-->
    <menuitem id="menu_scorecard_config"
              name="Score Card Configurations"
              parent="menu_configuration"
              sequence="10"/>
