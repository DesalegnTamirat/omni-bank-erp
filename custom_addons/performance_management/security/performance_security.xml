<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- MODULE CATEGORY                                            -->
    <!-- ========================================================== -->

    <record id="module_category_performance_management" model="ir.module.category">
        <field name="name">Performance Management</field>
        <field name="description">
            Manage scorecards, objectives, measures, and appraisals with multi-tier role access.
        </field>
        <field name="sequence">25</field>
    </record>


    <!-- ========================================================== -->
    <!-- GROUP PRIVILEGE                                             -->
    <!-- ========================================================== -->

    <record id="res_groups_privilege_performance" model="res.groups.privilege">
        <field name="name">Performance Management</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="module_category_performance_management"/>
    </record>




    <record id="group_performance_user" model="res.groups">
        <field name="name">Employee / User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_performance"/>
    </record>


    <!-- ========================================================== -->
    <!-- MANAGER                                                      -->
    <!-- ========================================================== -->

    <record id="group_performance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_performance"/>

        <!-- Manager automatically inherits Employee / User -->
        <field name="implied_ids"
               eval="[(4, ref('group_performance_user'))]"/>
    </record>


    <!-- ========================================================== -->
    <!-- PLANNING ROLE - TIER 2                                      -->
    <!-- ========================================================== -->

    <record id="group_performance_planning" model="res.groups">
        <field name="name">Planning Role (Tier 2)</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_performance"/>

        <!-- Planning automatically inherits Manager -->
        <field name="implied_ids"
               eval="[(4, ref('group_performance_manager'))]"/>
    </record>


    <!-- ========================================================== -->
    <!-- HR ROLE - TIER 3                                            -->
    <!-- ========================================================== -->

    <record id="group_performance_hr" model="res.groups">
        <field name="name">HR Role (Tier 3)</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_performance"/>

        <!-- HR automatically inherits Manager -->
        <field name="implied_ids"
               eval="[(4, ref('group_performance_manager'))]"/>
    </record>


    <!-- ========================================================== -->
    <!-- ADMINISTRATOR                                                -->
    <!-- ========================================================== -->

    <record id="group_performance_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_performance"/>

        <!-- Administrator automatically inherits Planning and HR -->
        <field name="implied_ids"
               eval="[
                   (4, ref('group_performance_planning')),
                   (4, ref('group_performance_hr'))
               ]"/>
    </record>


    <!-- ========================================================== -->
    <!-- INTERNAL USERS DEFAULT ACCESS                               -->
    <!-- Every internal user automatically gets Employee/User role   -->
    <!-- ========================================================== -->

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids"
               eval="[(4, ref('group_performance_user'))]"/>
    </record>

    <record id="base.default_user_group" model="res.groups">
        <field name="implied_ids"
               eval="[(4, ref('group_performance_user'))]"/>
    </record>


    <!-- ========================================================== -->
    <!-- SYSTEM ADMINISTRATORS                                       -->
    <!-- ========================================================== -->

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids"
               eval="[(4, ref('group_performance_admin'))]"/>
    </record>

    <record id="base.group_erp_manager" model="res.groups">
        <field name="implied_ids"
               eval="[(4, ref('group_performance_admin'))]"/>
    </record>


    <!-- ========================================================== -->
    <!-- RECORD RULES: TIER 2 SCORECARD & APPRAISAL                  -->
    <!-- ========================================================== -->

    <!-- Tier 2 Scorecard: Employee -->
    <record id="rule_t2_scorecard_user" model="ir.rule">
        <field name="name">Tier 2 Scorecard: Employee (Notified+)</field>
        <field name="model_id" ref="model_t2_scorecard"/>
        <field name="domain_force">
            ['&amp;', '|', '|', ('employee_id.user_id', '=', user.id), ('employee_id', '=', user.employee_id.id), ('employee_id', 'in', user.employee_ids.ids), ('state', '!=', 'draft')]
        </field>
        <field name="groups"
               eval="[(4, ref('group_performance_user'))]"/>
    </record>


    <!-- Tier 2 Scorecard: Manager -->
    <record id="rule_t2_scorecard_manager" model="ir.rule">
        <field name="name">Tier 2 Scorecard: Manager</field>
        <field name="model_id" ref="model_t2_scorecard"/>
        <field name="domain_force">
            ['|', '|', '|', '|',
                ('manager_id.user_id', '=', user.id),
                ('manager_id', '=', user.employee_id.id),
                ('employee_id.coach_id.user_id', '=', user.id),
                ('employee_id.user_id', '=', user.id),
                ('employee_id', 'in', user.employee_ids.ids)
            ]
        </field>
        <field name="groups"
               eval="[(4, ref('group_performance_manager'))]"/>
    </record>


    <!-- Tier 2 Scorecard: Planning & Admin -->
    <record id="rule_t2_scorecard_planning_admin" model="ir.rule">
        <field name="name">Tier 2 Scorecard: Planning &amp; Admin (All)</field>
        <field name="model_id" ref="model_t2_scorecard"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups"
               eval="[
                   (4, ref('group_performance_planning')),
                   (4, ref('group_performance_admin'))
               ]"/>
    </record>


