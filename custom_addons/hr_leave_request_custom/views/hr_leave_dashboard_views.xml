<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Time Off Dashboard - landing page (balances + quick actions)
         ============================================================ -->
    <record id="view_hr_leave_dashboard_form" model="ir.ui.view">
        <field name="name">hr.leave.dashboard.form</field>
        <field name="model">hr.leave.dashboard</field>
        <field name="arch" type="xml">
            <form string="Time Off Dashboard" create="false" edit="false" delete="false">
                <sheet>
                    <div class="d-flex align-items-center justify-content-between flex-wrap mb-3">
                        <h1 class="mb-0">Time Off Dashboard</h1>
                        <div class="d-flex gap-2">
                            <button name="action_new_request" type="object"
                                    string="New Request" class="btn-primary"/>
                            <button name="action_open_my_requests" type="object"
                                    string="My Requests" class="btn-secondary"/>
                            <button name="action_refresh" type="object"
                                    string="Refresh" class="btn-secondary" icon="fa-refresh"/>
                        </div>
                    </div>

                    <field name="employee_id" invisible="1"/>

                    <div class="row g-3">
                        <!-- Accrued Leave Balance -->
                        <div class="col-md-6 col-12">
                            <div class="card text-center p-3 h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #fdf5f5 0%, #f7e6e6 100%); border-left: 5px solid #541718 !important; border-radius: 10px;">
                                <span class="small text-uppercase fw-bold" style="color: #541718;">Accrued Leave Balance</span>
                                <field name="accrued_leave_balance"
                                       class="display-5 fw-bold"
                                       style="color: #541718;"
                                       nolabel="1" readonly="1"/>
                                <span class="small text-muted">days available</span>
                            </div>
                        </div>

                        <!-- Scheduled Leave Balance -->
                        <div class="col-md-6 col-12">
                            <div class="card text-center p-3 h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #fefaf6 0%, #faede2 100%); border-left: 5px solid #c17540 !important; border-radius: 10px;">
                                <span class="small text-uppercase fw-bold" style="color: #8f4a1c;">Scheduled Leave Balance</span>
                                <field name="scheduled_leave_balance"
                                       class="display-5 fw-bold"
                                       style="color: #c17540;"
                                       nolabel="1" readonly="1"/>
                                <span class="small text-muted">days planned</span>
                            </div>
                        </div>

                        <!-- Daily Accrual & Cap Status Card -->
                        <div class="col-12">
                            <div class="card p-3 border shadow-sm rounded-3" style="background: #fafafa;">
                                <div class="row align-items-center">
                                    <div class="col-md-4 col-12 mb-2 mb-md-0 border-end">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa fa-line-chart fa-2x" style="color: #541718;"/>
                                            <div>
                                                <div class="small text-muted text-uppercase fw-bold">Daily Accrual Rate</div>
                                                <div class="h5 fw-bold mb-0" style="color: #541718;">
                                                    +<field name="daily_accrual_rate" readonly="1"/> days/day
                                                </div>
                                                <div class="small text-muted">
                                                    Annual: <field name="annual_entitlement" readonly="1"/> days/yr
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-12 mb-2 mb-md-0 border-end">
                                        <div class="small text-muted text-uppercase fw-bold">Maximum Carryover Cap</div>
                                        <div class="h5 fw-bold mb-0">
                                            <field name="total_leave_balance" readonly="1"/> / <field name="max_carryover_cap" readonly="1"/> days
                                        </div>
                                        <div class="small text-muted">
                                            Room left: <field name="remaining_to_cap" readonly="1"/> days (<field name="cap_percentage" readonly="1"/>%)
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-12 text-md-center">
                                        <div class="small text-muted text-uppercase fw-bold mb-1">Accrual Status</div>
                                        <field name="accrual_status" widget="badge"
                                               decoration-success="accrual_status == 'active'"
                                               decoration-warning="accrual_status == 'near_cap'"
                                               decoration-danger="accrual_status == 'capped'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_leave_dashboard" model="ir.actions.act_window">
        <field name="name">Time Off Dashboard</field>
        <field name="res_model">hr.leave.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_leave_dashboard_form"/>
        <field name="target">main</field>
    </record>

    <!-- ============================================================
         Make the dashboard the landing page for the Time Off app.
         NOTE: verify "hr_holidays.menu_hr_holidays_root" is the correct
         xmlid in your installed hr_holidays version (Settings > Technical
         > Menu Items, search "Time Off", take the top-level/root entry -
         the one with no parent). It has been stable under this name
         across recent Odoo versions, but if module install fails with a
         "External ID not found" error on this record, replace the ref
         below with the id you find there.
         ============================================================ -->
    <!-- Route root menu to the standard Time Off calendar dashboard action (which embeds our custom balances + calendar) -->
    <record id="hr_holidays.menu_hr_holidays_root" model="ir.ui.menu">
        <field name="action" ref="hr_holidays.hr_leave_action_new_request"/>
    </record>

</odoo>
