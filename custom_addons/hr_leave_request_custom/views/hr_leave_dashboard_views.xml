<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Time Off Dashboard - landing page (balances + quick actions)
         ============================================================ -->
    <record id="view_hr_leave_dashboard_form" model="ir.ui.view">
        <field name="name">hr.leave.dashboard.form</field>
        <field name="model">hr.leave.dashboard</field>
        <field name="arch" type="xml">
            <form string="Time Off Dashboard" create="false" edit="false" delete="false">
                <sheet>
                    <div class="d-flex align-items-center justify-content-between flex-wrap mb-3">
                        <h1 class="mb-0">Time Off Dashboard</h1>
                        <div class="d-flex gap-2">
                            <button name="action_new_request" type="object"
                                    string="New Request" class="btn-primary"/>
                            <button name="action_open_my_requests" type="object"
                                    string="My Requests" class="btn-secondary"/>
                            <button name="action_refresh" type="object"
                                    string="Refresh" class="btn-secondary" icon="fa-refresh"/>
                        </div>
                    </div>

                    <field name="employee_id" invisible="1"/>

                    <div class="row g-3">
                        <!-- Accrued Leave Balance -->
                        <div class="col-md-6 col-12">
                            <div class="card text-center p-4 h-100 border-0 shadow-sm">
                                <span class="text-muted small text-uppercase">Accrued Leave Balance</span>
                                <field name="accrued_leave_balance"
                                       class="display-4 fw-bold text-primary"
                                       nolabel="1" readonly="1"/>
                                <span class="text-muted small">days</span>
                            </div>
                        </div>

                        <!-- Scheduled Leave Balance -->
                        <div class="col-md-6 col-12">
                            <div class="card text-center p-4 h-100 border-0 shadow-sm">
                                <span class="text-muted small text-uppercase">Scheduled Leave Balance</span>
                                <field name="scheduled_leave_balance"
                                       class="display-4 fw-bold text-info"
                                       nolabel="1" readonly="1"/>
                                <span class="text-muted small">days</span>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_leave_dashboard" model="ir.actions.act_window">
        <field name="name">Time Off Dashboard</field>
        <field name="res_model">hr.leave.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_leave_dashboard_form"/>
        <field name="target">main</field>
    </record>

    <!-- ============================================================
         Make the dashboard the landing page for the Time Off app.
         NOTE: verify "hr_holidays.menu_hr_holidays_root" is the correct
         xmlid in your installed hr_holidays version (Settings > Technical
         > Menu Items, search "Time Off", take the top-level/root entry -
         the one with no parent). It has been stable under this name
         across recent Odoo versions, but if module install fails with a
         "External ID not found" error on this record, replace the ref
         below with the id you find there.
         ============================================================ -->
    <record id="hr_holidays.menu_hr_holidays_root" model="ir.ui.menu">
        <field name="action" ref="action_hr_leave_dashboard"/>
    </record>

</odoo>
