<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_request_custom_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'hr_holidays', 'bin_size': False}</field>
    </record>

    <menuitem id="hr_leave_request_custom_config_settings_menu" name="Settings"
        parent="hr_holidays.menu_hr_holidays_configuration" sequence="0" action="hr_leave_request_custom_config_settings_action" groups="hr_holidays.group_hr_holidays_manager"/>

    <record id="res_config_settings_view_form_inherit_leave_accrual" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.leave.accrual</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Time Off" string="Time Off" name="hr_holidays" groups="hr_holidays.group_hr_holidays_manager">
                    <block title="Custom Accrual Policy Configuration" name="leave_accrual_policy_settings">
                        <setting id="policy_opening_date_setting" string="Policy Opening Date" help="Cutoff date for opening balance load and leaves taken tracking.">
                            <field name="leave_accrual_policy_opening_date"/>
                        </setting>
                        <setting id="base_entitlement_setting" string="Base Annual Leave Entitlement" help="Starting leave entitlement for Year 0 of service (e.g. 16 days).">
                            <field name="leave_accrual_base_entitlement"/>
                        </setting>
                        <setting id="managerial_cap_setting" string="Managerial Carryover Cap" help="Max carryover cap years for Managerial staff.">
                            <field name="leave_accrual_managerial_cap_years"/>
                            <span class="text-muted ms-2">years</span>
                        </setting>
                        <setting id="non_managerial_cap_setting" string="Non-Managerial Carryover Cap" help="Max carryover cap years for Non-Managerial staff.">
                            <field name="leave_accrual_non_managerial_cap_years"/>
                            <span class="text-muted ms-2">years</span>
                        </setting>
                        <setting id="opening_balance_name_setting" string="Opening Balance Load Identifier" help="Allocation description name used to load initial opening balances.">
                            <field name="leave_accrual_opening_balance_name"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
