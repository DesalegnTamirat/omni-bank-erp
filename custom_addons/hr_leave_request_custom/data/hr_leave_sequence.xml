<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Sequence for hr.leave.leave_reference : LR-000001, LR-000002, ... -->
    <record id="seq_hr_leave_reference" model="ir.sequence">
        <field name="name">Leave Request Reference</field>
        <field name="code">hr.leave.reference</field>
        <field name="prefix">LR-</field>
        <field name="padding">6</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <!-- no_gap guarantees true sequential numbers (safe for low/medium
             volume like leave requests); switch to 'standard' if you ever
             see lock contention under heavy concurrent submissions. -->
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
