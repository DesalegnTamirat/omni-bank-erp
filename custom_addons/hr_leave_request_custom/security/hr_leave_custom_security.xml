<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Odoo 19 replaced res.groups.category_id with res.groups.privilege_id,
             pointing to a res.groups.privilege record (which itself still holds
             category_id -> ir.module.category). A privilege record is required
             before it can be referenced by a group. -->
        <record id="privilege_hr_leave_suspense" model="res.groups.privilege">
            <field name="name">Suspense Leave</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
        </record>

        <!-- Dedicated HR group for the Suspense Leave workflow.
             Kept separate from hr_holidays.group_hr_holidays_manager /
             group_hr_holidays_user (Time Off app admin) and from
             hr.group_hr_manager (general HR/Employee records admin),
             since none of those necessarily match who should be allowed
             to request Suspense Leave on behalf of another employee. -->
        <record id="group_hr_leave_suspense_hr" model="res.groups">
            <field name="name">HR (Suspense Leave)</field>
            <field name="privilege_id" ref="privilege_hr_leave_suspense"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Users in this group can request Suspense Leave on behalf of any employee (the Employee field is unlocked for them on that leave type).</field>
        </record>

    </data>
</odoo>