<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">


    <record id="cron_exam_grading_sla_watchdog" model="ir.cron">
        <field name="name">Assessment System: 3-Day Manual Grading SLA Watchdog</field>
        <field name="model_id" ref="model_exam_grading_task"/>
        <field name="state">code</field>
        <field name="code">model.check_overdue_grading_tasks_cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_assessment_publication_expiry" model="ir.cron">
        <field name="name">Assessment System: Result Publication Auto-Expiry</field>
        <field name="model_id" ref="model_assessment_result_publication"/>
        <field name="state">code</field>
        <field name="code">model.check_expired_publications_cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
