    </record>
    <record id="weight_line_ext_mgr_exam" model="assessment.weight.profile.line">
        <field name="profile_id" ref="weight_profile_external_managerial"/>
        <field name="sequence">10</field>
        <field name="component">exam</field>
        <field name="weight_percentage">50.0</field>
        <field name="minimum_pass_score">50.0</field>
    </record>
    <record id="weight_line_ext_mgr_interview" model="assessment.weight.profile.line">
