<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View: Weight Profile -->
    <record id="view_assessment_weight_profile_form" model="ir.ui.view">
        <field name="name">assessment.weight.profile.form</field>
        <field name="model">assessment.weight.profile</field>
        <field name="arch" type="xml">
            <form string="Assessment Weight Distribution Profile">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Profile Name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="candidate_type"/>
                            <field name="role_level"/>
                        </group>
                        <group>
                            <field name="total_weight" widget="float" digits="[16,2]"/>
                            <div class="alert alert-info py-2" role="alert">
                                <b>Policy Rule:</b> Component weights must sum to exactly <b>100.0%</b> .
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assessment Components &amp; Weights">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="component"/>
                                    <field name="weight_percentage"/>
                                    <field name="minimum_pass_score"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View: Weight Profile -->
    <record id="view_assessment_weight_profile_tree" model="ir.ui.view">
        <field name="name">assessment.weight.profile.list</field>
        <field name="model">assessment.weight.profile</field>
        <field name="arch" type="xml">
            <list string="Weight Distribution Profiles">
                <field name="name"/>
                <field name="candidate_type"/>
                <field name="role_level"/>
                <field name="total_weight" widget="float" digits="[16,2]" decoration-success="total_weight == 100" decoration-danger="total_weight != 100"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Action: Weight Profiles -->
    <record id="action_assessment_weight_profiles" model="ir.actions.act_window">
        <field name="name">Weight Distribution Profiles</field>
        <field name="res_model">assessment.weight.profile</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
