<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rate Sheet Form View -->
    <record id="view_interview_rate_sheet_form" model="ir.ui.view">
        <field name="name">interview.rate.sheet.form</field>
        <field name="model">interview.rate.sheet</field>
        <field name="arch" type="xml">
            <form string="Interview Rate Sheet Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Rate Sheet Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Senior People and Culture Officer Rate Sheet"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="recruiting_position_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="total_max_marks" class="oe_subtotal_footer_separator" widget="statinfo" string="Total Maximum Marks"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Area of Assessment &amp; Criteria" name="criteria">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Area of Assessment / Criterion"/>
                                    <field name="max_marks" string="Max Marks"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Rate Sheet List View -->
    <record id="view_interview_rate_sheet_list" model="ir.ui.view">
        <field name="name">interview.rate.sheet.list</field>
        <field name="model">interview.rate.sheet</field>
        <field name="arch" type="xml">
            <list string="Interview Rate Sheets">
                <field name="name"/>
                <field name="recruiting_position_id"/>
                <field name="total_max_marks"/>
            </list>
        </field>
    </record>

    <!-- Rate Sheet Action -->
    <record id="action_interview_rate_sheet" model="ir.actions.act_window">
        <field name="name">Interview Rate Sheets</field>
        <field name="res_model">interview.rate.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Interview Rate Sheet configuration!
            </p>
            <p>
                Define areas of assessment, criteria categories, maximum marks, and scoring guidelines for candidate interview evaluation.
            </p>
        </field>
    </record>
</odoo>
