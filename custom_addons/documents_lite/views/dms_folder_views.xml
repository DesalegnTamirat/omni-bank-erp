<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dms_folder_view_form" model="ir.ui.view">
        <field name="name">dms.folder.form</field>
        <field name="model">dms.folder</field>
        <field name="arch" type="xml">
            <form delete="0">
                <header>
                    <button name="action_disable" type="object" string="Disable" invisible="not id or not active"
                            confirm="Disable this folder? Every sub-folder and document inside it will be disabled too."/>
                    <button name="action_enable" type="object" string="Enable" class="btn-primary" invisible="not id or active"
                            confirm="Enable this folder? Sub-folders and documents it disabled will be enabled again."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_documents" type="object" class="oe_stat_button" icon="fa-folder-open">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Disabled" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="name" placeholder="e.g. Contracts"/>
                            <field name="parent_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Access" name="access">
                            <p class="text-muted">
                                Without any rule below (and none on the parent folders) every internal user can read and write here.
                                Add a rule to restrict the folder: only the listed users, groups, departments, operating units and operating unit managers (and administrators) get in.
                                Each line targets one of them. A department also covers its sub-departments.
                            </p>
                            <group><field name="inherit_access"/></group>
                            <field name="access_ids" nolabel="1">
                                <list editable="bottom">
                                    <!-- Each line targets exactly one thing: once one is picked the others lock
                                         (client side, no server call). Clear it to pick another kind. -->
                                    <field name="user_id" placeholder="User..." domain="[('share', '=', False)]"
                                           readonly="group_id or department_id or operating_unit_id or manager_unit_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="group_id" placeholder="Group..."
                                           readonly="user_id or department_id or operating_unit_id or manager_unit_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="department_id" placeholder="Department..."
                                           readonly="user_id or group_id or operating_unit_id or manager_unit_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="operating_unit_id" placeholder="Operating unit..."
                                           readonly="user_id or group_id or department_id or manager_unit_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="manager_unit_id" placeholder="Manager of operating unit..."
                                           readonly="user_id or group_id or department_id or operating_unit_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="manager_name" optional="show"/>
                                    <field name="permission"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="What belongs in this folder?"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dms_folder_view_list" model="ir.ui.view">
        <field name="name">dms.folder.list</field>
        <field name="model">dms.folder</field>
        <field name="arch" type="xml">
            <list delete="0" decoration-muted="not active">
                <header>
                    <button name="action_disable" type="object" string="Disable" groups="documents_lite.group_dms_manager"
                            confirm="Disable the selected folders? Every sub-folder and document inside them will be disabled too."/>
                    <button name="action_enable" type="object" string="Enable" groups="documents_lite.group_dms_manager"
                            confirm="Enable the selected folders? Sub-folders and documents they disabled will be enabled again."/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="display_name" string="Folder"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="restricted" widget="boolean" string="Restricted"/>
                <field name="document_count"/>
                <field name="status" widget="badge" decoration-success="status == 'enabled'"
                       decoration-danger="status == 'disabled'"/>
                <field name="active" column_invisible="1"/>
                <button name="action_disable" type="object" icon="fa-ban" title="Disable" invisible="not active" groups="documents_lite.group_dms_manager"
                        confirm="Disable this folder? Every sub-folder and document inside it will be disabled too."/>
                <button name="action_enable" type="object" icon="fa-check-circle" title="Enable" invisible="active" groups="documents_lite.group_dms_manager"
                        confirm="Enable this folder? Sub-folders and documents it disabled will be enabled again."/>
            </list>
        </field>
    </record>

    <record id="dms_folder_view_search" model="ir.ui.view">
        <field name="name">dms.folder.search</field>
        <field name="model">dms.folder</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="restricted" string="Restricted" domain="[('restricted', '=', True)]"/>
                <filter name="enabled" string="Enabled" domain="[('active', '=', True)]"/>
                <filter name="disabled" string="Disabled" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_parent" string="Parent" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dms_folder_action" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">dms.folder</field>
        <field name="view_mode">list,form</field>
        <!-- active_test off so Admins can see disabled folders; the Enabled filter is on by default. -->
        <field name="context">{'active_test': False, 'search_default_enabled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first folder</p>
            <p>Folders keep documents together and decide who can read or write them.</p>
        </field>
    </record>

    <record id="dms_tag_view_list" model="ir.ui.view">
        <field name="name">dms.tag.list</field>
        <field name="model">dms.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom" delete="0" decoration-muted="not active">
                <header>
                    <button name="action_disable" type="object" string="Disable" groups="documents_lite.group_dms_manager"
                            confirm="Disable the selected tags? They disappear from the tag pickers and filters."/>
                    <button name="action_enable" type="object" string="Enable" groups="documents_lite.group_dms_manager"/>
                </header>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="status" widget="badge" decoration-success="status == 'enabled'"
                       decoration-danger="status == 'disabled'" readonly="1"/>
                <field name="active" column_invisible="1"/>
                <button name="action_disable" type="object" icon="fa-ban" title="Disable" invisible="not active or not id" groups="documents_lite.group_dms_manager"
                        confirm="Disable this tag? It disappears from the tag pickers and filters."/>
                <button name="action_enable" type="object" icon="fa-check-circle" title="Enable" invisible="active or not id" groups="documents_lite.group_dms_manager"/>
            </list>
        </field>
    </record>

    <record id="dms_tag_view_search" model="ir.ui.view">
        <field name="name">dms.tag.search</field>
        <field name="model">dms.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="enabled" string="Enabled" domain="[('active', '=', True)]"/>
                <filter name="disabled" string="Disabled" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dms_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">dms.tag</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="dms_tag_view_search"/>
        <field name="context">{'active_test': False, 'search_default_enabled': 1}</field>
    </record>
</odoo>
