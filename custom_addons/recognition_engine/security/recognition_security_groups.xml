<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_recognition" model="ir.module.category">
            <field name="name">Unified Recognition and Gamification</field>
            <field name="description">Gamification, point ledger, and monthly recognition honors across Bunna Bank.</field>
            <field name="sequence">55</field>
        </record>

        <record id="res_groups_privilege_recognition" model="res.groups.privilege">
            <field name="name">Recognition and Gamification</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_recognition"/>
        </record>

        <record id="group_recognition_user" model="res.groups">
            <field name="name">Employee / Participant</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_recognition"/>
        </record>

        <record id="group_recognition_manager" model="res.groups">
            <field name="name">Recognition and HR Officer</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_recognition"/>
            <field name="implied_ids" eval="[(4, ref('group_recognition_user'))]"/>
        </record>

        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_recognition_user'))]"/>
        </record>
    </data>
</odoo>
