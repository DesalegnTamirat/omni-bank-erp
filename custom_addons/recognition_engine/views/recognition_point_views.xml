<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_recognition_point_tree" model="ir.ui.view">
        <field name="name">recognition.point.list</field>
        <field name="model">recognition.point</field>
        <field name="arch" type="xml">
            <list string="Gamification Points Ledger" create="false">
                <field name="date_earned"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="source_module" widget="badge" decoration-info="source_module == 'kms'" decoration-success="source_module == 'lms'"/>
                <field name="source_action"/>
                <field name="points" sum="Total Points"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_recognition_point_search" model="ir.ui.view">
        <field name="name">recognition.point.search</field>
        <field name="model">recognition.point</field>
        <field name="arch" type="xml">
            <search string="Search Points">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="source_module"/>
                <filter string="KMS Points" name="kms_points" domain="[('source_module', '=', 'kms')]"/>
                <filter string="LMS Points" name="lms_points" domain="[('source_module', '=', 'lms')]"/>
                <separator/>
                <group>
                    <filter string="Source Module" name="group_by_module" context="{'group_by': 'source_module'}"/>
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date_earned'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_recognition_points" model="ir.actions.act_window">
        <field name="name">Points Ledger</field>
        <field name="res_model">recognition.point</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_recognition_point_search"/>
    </record>
</odoo>
