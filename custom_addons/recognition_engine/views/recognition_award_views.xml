<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_recognition_monthly_award_tree" model="ir.ui.view">
        <field name="name">recognition.monthly.award.list</field>
        <field name="model">recognition.monthly.award</field>
        <field name="arch" type="xml">
            <list string="Monthly Recognition Awards">
                <field name="period_date"/>
                <field name="award_type" widget="badge" decoration-info="award_type == 'best_contributor'" decoration-success="award_type == 'best_learner'"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="badge" widget="badge" decoration-warning="badge == 'gold'"/>
                <field name="points_total"/>
            </list>
        </field>
    </record>

    <record id="view_recognition_monthly_award_kanban" model="ir.ui.view">
        <field name="name">recognition.monthly.award.kanban</field>
        <field name="model">recognition.monthly.award</field>
        <field name="arch" type="xml">
            <kanban string="Recognition Honors" class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3" style="border-top: 4px solid #541718;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-secondary" t-out="record.award_type.value"/>
                                <span class="badge bg-warning text-dark" t-out="record.badge.value"/>
                            </div>
                            <h4 class="text-primary font-weight-bold" style="color: #541718 !important;">
                                <field name="employee_id"/>
                            </h4>
                            <div class="text-muted mb-2">
                                <field name="department_id"/>
                            </div>
                            <div class="d-flex justify-content-between text-muted small border-top pt-2">
                                <span>Period: <field name="period_date"/></span>
                                <span class="font-weight-bold text-success">Points: <field name="points_total"/></span>
                            </div>
                            <div class="mt-2 small text-dark fst-italic">
                                <field name="citation"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_recognition_monthly_award_form" model="ir.ui.view">
        <field name="name">recognition.monthly.award.form</field>
        <field name="model">recognition.monthly.award</field>
        <field name="arch" type="xml">
            <form string="Monthly Recognition Award">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="award_type"/>
                            <field name="period_date"/>
                            <field name="employee_id"/>
                            <field name="badge"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="branch_name"/>
                            <field name="points_total"/>
                            <field name="average_score" invisible="award_type != 'best_learner'"/>
                            <field name="courses_completed" invisible="award_type != 'best_learner'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Citation &amp; Highlights">
                            <field name="citation" placeholder="Enter recognition citation and reasons for honor..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_recognition_monthly_awards" model="ir.actions.act_window">
        <field name="name">Monthly Honors &amp; Awards</field>
        <field name="res_model">recognition.monthly.award</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
