<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Main Report Template Document: Recruitment Letter Format -->
        <template id="report_disciplinary_warning_letter_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" style="font-family: 'Times New Roman', Times, serif; color: #111111; font-size: 13.5px; line-height: 1.6; padding: 15px 35px; position: relative;">

                        <!-- Official Header: Full Bunna Logo + Brown Accent Bar -->
                        <table style="width: 100%; margin-bottom: 22px; border-collapse: collapse;">
                            <tr>
                                <td style="width: 32%; vertical-align: middle;">
                                    <img t-att-src="'data:image/png;base64,%s' % o.get_official_bunna_logo_base64()" style="max-height: 95px; max-width: 180px; height: auto;" alt="Bunna Bank S.C."/>
                                </td>
                                <td style="width: 68%; vertical-align: middle; padding-left: 15px;">
                                    <div style="background-color: #9C7D73; height: 26px; width: 100%; border-radius: 2px;"></div>
                                </td>
                            </tr>
                        </table>

                        <!-- Date & Reference Numbers -->
                        <table style="width: 100%; margin-bottom: 20px; border-collapse: collapse;">
                            <tr>
                                <td style="width: 55%;"></td>
                                <td style="width: 45%; font-size: 13.5px; line-height: 1.6; text-align: left; padding-left: 20px;">
                                    <div>
                                        <strong>Date: </strong>
                                        <span t-esc="o.final_decision_date.strftime('%B %d, %Y') if o.final_decision_date else (context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y'))"/>
                                    </div>
                                    <div>
                                        <strong>Ref. No: </strong>
                                        <span t-esc="o.name or ''"/>
                                    </div>
                                    <div>
                                        <strong>ID No: </strong>
                                        <span t-esc="o.employee_id.identification_id or o.employee_id.barcode or ''"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Recipient Block -->
                        <div class="mb-3" style="font-size: 14px; line-height: 1.4;">
                            <div>
                                <strong><span t-esc="o.get_salutation_label()"/> </strong>
                                <span style="text-decoration: underline; font-weight: bold;" t-esc="o.employee_id.name if o.employee_id else '____________________'"/>
                            </div>
                            <div t-if="o.job_id">
                                <strong><span t-esc="o.job_id.name"/></strong>
                            </div>
                            <div t-if="o.department_id">
                                <strong><span t-esc="o.department_id.name"/></strong>
                            </div>
                            <div><strong>Bunna Bank S.C.</strong></div>
                            <div><u><strong><span t-esc="o.work_location_id.name if o.work_location_id else 'Addis Ababa'"/></strong></u></div>
                        </div>

                        <!-- Salutation -->
                        <div class="mb-3" style="font-size: 14px;">
                            Dear <span t-esc="o.get_salutation_title_and_first_name()"/>,
                        </div>

                        <!-- Subject -->
                        <div class="text-center my-3">
                            <span style="font-size: 15px; font-weight: bold;">
                                <t t-if="o.case_action_track == 'direct_enforce'">
                                    Subject: – <u>Official Disciplinary Warning Notice</u>
                                </t>
                                <t t-else="">
                                    Subject: – <u>Official Disciplinary Sanction &amp; Decision Notice</u>
                                </t>
                            </span>
                        </div>

                        <!-- Body Content -->
                        <div style="text-align: justify; font-size: 13.5px; line-height: 1.65;">
                            
                            <!-- Paragraph 1: Misconduct & Legal Finding -->
                            <p style="margin-bottom: 14px;">
                                This is to formally notify you that following the review of the disciplinary incident which occurred on 
                                <strong><span t-esc="o.incident_date.strftime('%B %d, %Y') if o.incident_date else 'the incident date'"/></strong> 
                                regarding 
                                <strong>
                                    <t t-if="o.legal_article_display">
                                        <span t-esc="o.legal_article_display"/>
                                    </t>
                                    <t t-elif="o.offense_id">
                                        <span t-esc="o.offense_id.name"/>
                                    </t>
                                    <t t-else="">
                                        applicable bank regulations
                                    </t>
                                </strong>, 
                                the Bank has formally established the following facts of misconduct:
                            </p>

                            <!-- Statement of Facts Indented Block -->
                            <div style="background-color: #f9f9f9; border-left: 3px solid #9C7D73; padding: 8px 12px; margin-bottom: 14px; font-style: italic;">
                                <span t-esc="o.description or 'Misconduct details recorded on file.'"/>
                            </div>

                            <!-- Paragraph 2: Sanction & Payroll Month -->
                            <p style="margin-bottom: 14px;">
                                In accordance with the Governing Disciplinary Policy and Regulations of Bunna Bank S.C., 
                                <t t-if="o.case_action_track == 'direct_enforce'">
                                    your reporting coach / line management has enforced a 
                                </t>
                                <t t-else="">
                                    the Disciplinary Authority has resolved to enforce a 
                                </t>
                                <strong><span t-esc="o.get_sanction_display_text()"/></strong> against you
                                <t t-if="o.payroll_month">
                                    effective for the payroll period of <strong><span t-esc="o.payroll_month"/></strong>
                                </t>.
                            </p>

                            <!-- Paragraph 3: Corrective Obligation & Caution on Repeated Breaches -->
                            <p style="margin-bottom: 14px;">
                                Please be reminded that this notice constitutes an official disciplinary record placed in your personnel file. 
                                Management expects you to strictly abide by the Bank's Code of Conduct, policies, and operational procedures in all future assignments. 
                                You are expressly cautioned that any recurrent breach or repetition of similar disciplinary infractions shall attract escalated punitive measures, up to and including termination of contract / separation under Article 33 of the Disciplinary Regulation.
                            </p>

                            <!-- Paragraph 4: Statutory 10-Calendar-Day Appeal Notice -->
                            <p style="margin-bottom: 20px;">
                                Pursuant to the Bank's Disciplinary Policy, you have the right to lodge a formal written appeal against this decision within 
                                <strong>ten (10) calendar days</strong> from the receipt date of this notice 
                                <t t-if="o.appeal_deadline">
                                    (Statutory Appeal Deadline: <strong><span t-esc="o.appeal_deadline.strftime('%B %d, %Y')"/></strong>)
                                </t>. 
                                Any appeal submitted after the expiration of the statutory 10-day period shall not be entertained.
                            </p>

                            <p class="mt-3">
                                Sincerely yours,
                            </p>
                        </div>

                        <!-- Sign-off Block with Authorized Signatory -->
                        <div class="mt-2 mb-4" style="font-size: 13.5px; line-height: 1.5;">
                            <div style="height: 40px;"></div>
                            <div><strong><span t-esc="o.get_signatory_name()"/></strong></div>
                            <div><strong><span t-esc="o.get_signatory_title()"/></strong></div>
                            <div><strong><span t-esc="o.get_signatory_company()"/></strong></div>
                        </div>

                        <!-- Employee Acknowledgment & Receipt Line -->
                        <div class="mt-3 pt-2" style="border-top: 1px dashed #aaaaaa; font-size: 12px; line-height: 1.4;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td style="width: 65%;">
                                        <strong>Employee Acknowledgment &amp; Receipt:</strong> ___________________________________
                                    </td>
                                    <td style="width: 35%; text-align: right;">
                                        <strong>Date of Receipt:</strong> ____________________
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- CC Block -->
                        <div class="mt-3" style="font-size: 12px; line-height: 1.5;">
                            <div><strong>CC: -</strong></div>
                            <ul style="list-style-type: disc; margin-left: 20px; padding-left: 0; margin-top: 4px;">
                                <t t-foreach="o.get_discipline_letter_cc_lines()" t-as="cc_line">
                                    <li><span t-esc="cc_line"/></li>
                                </t>
                                <li><u><strong>Bunna Bank S.C</strong></u></li>
                            </ul>
                        </div>

                        <!-- Official Footer: Standard Bunna Bank Letterhead Footer -->
                        <div class="footer" style="border-top: 1px solid #7d8285; padding-top: 8px; margin-top: 25px; font-size: 10px; color: #555555;">
                            <table style="width: 100%; border-collapse: collapse; text-align: center; vertical-align: middle;">
                                <tr>
                                    <td style="width: 5%;"><div style="background-color: #8C948D; height: 18px; width: 100%; border-radius: 2px;"></div></td>
                                    <td style="width: 32%; font-size: 10px; line-height: 1.4;">
                                        <div><strong>Tel</strong> +251 111 580 861 | 62</div>
                                        <div><strong>Fax</strong> +251 111 580 832 | 76</div>
                                    </td>
                                    <td style="width: 29%; font-size: 10px; line-height: 1.4;">
                                        <div><strong>Email</strong> info@bunnabanksc.com</div>
                                        <div><strong>Website</strong> www.bunnabanksc.com</div>
                                    </td>
                                    <td style="width: 29%; font-size: 10px; line-height: 1.4;">
                                        <div><strong>P.O.Box</strong> 1743 code 1110</div>
                                        <div>Addis Ababa | Ethiopia</div>
                                    </td>
                                    <td style="width: 5%;"><div style="background-color: #8C948D; height: 18px; width: 100%; border-radius: 2px;"></div></td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>
