<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record id="view_discipline_committee_meeting_tree" model="ir.ui.view">
            <field name="name">discipline.committee.meeting.list</field>
            <field name="model">discipline.committee.meeting</field>
            <field name="arch" type="xml">
                <list decoration-info="state == 'draft'"
                      decoration-warning="state in ('scheduled', 'chair_review')"
                      decoration-primary="state == 'in_progress'"
                      decoration-success="state == 'completed'">
                    <field name="name"/>
                    <field name="case_id"/>
                    <field name="employee_id"/>
                    <field name="offense_id"/>
                    <field name="meeting_date"/>
                    <field name="location"/>
                    <field name="present_members_count" string="Present Members"/>
                    <field name="is_quorum_met" widget="boolean" optional="show"/>
                    <field name="recommended_penalty_type" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state in ('scheduled', 'chair_review')"
                           decoration-primary="state == 'in_progress'"
                           decoration-success="state == 'completed'"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_discipline_committee_meeting_form" model="ir.ui.view">
            <field name="name">discipline.committee.meeting.form</field>
            <field name="model">discipline.committee.meeting</field>
            <field name="arch" type="xml">
                <form string="Disciplinary Committee Hearing">
                    <header>
                        <!-- Mandate check flags -->
                        <field name="can_begin_hearing" invisible="1"/>
                        <field name="can_schedule_hearing" invisible="1"/>
                        <field name="can_submit_to_chair" invisible="1"/>
                        <field name="can_submit_to_ceo" invisible="1"/>
                        <field name="can_return_to_secretary" invisible="1"/>

                        <!-- Step 1: Draft / Planning -> Notify Panel (Secretary Mandate Only) -->
                        <button name="action_confirm_schedule_and_send_summons" 
                                string="Notify Panel" 
                                type="object" 
                                class="oe_highlight btn-primary"
                                invisible="state != 'draft' or not can_schedule_hearing"
                                groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_admin"/>

                        <!-- Step 2: Scheduled -> Start Hearing (Chairman Mandate Only), Reschedule (Secretary Mandate Only) -->
                        <button name="action_begin_hearing_session" 
                                string="Start Hearing" 
                                type="object" 
                                class="oe_highlight btn-success"
                                invisible="state != 'scheduled' or not can_begin_hearing"
                                groups="discipline_management.group_discipline_cpco,discipline_management.group_discipline_admin"/>

                        <button name="action_reset_to_draft" 
                                string="Reschedule" 
                                type="object" 
                                class="btn-warning"
                                invisible="state != 'scheduled' or not can_schedule_hearing"
                                groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_admin"/>

                        <!-- Step 3: Hearing In Progress -> Submit to Chair (Secretary Mandate Only) -->
                        <button name="action_submit_to_chairman"
                                string="Submit to Chair"
                                type="object"
                                class="oe_highlight btn-primary"
                                invisible="state != 'in_progress' or not can_submit_to_chair"
                                groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_admin"
                                confirm="Are you sure you want to conclude minute recording and submit proceedings to the Committee Chair Man for review?"/>

                        <!-- Step 4: Chairman Review -> Enforce & Notify CEO / Submit to CEO / Return (Chairman Mandate Only) -->
                        <button name="action_chair_enforce_and_notify_ceo"
                                string="Enforce Decision &amp; Notify CEO"
                                type="object"
                                class="oe_highlight btn-success"
                                invisible="state != 'chair_review' or not can_submit_to_ceo"
                                groups="discipline_management.group_discipline_cpco,discipline_management.group_discipline_admin"
                                confirm="Are you sure you want to officially approve and enforce this Disciplinary Committee resolution and notify the CEO?"/>

                        <button name="action_submit_to_ceo"
                                string="Submit to CEO"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'chair_review' or not can_submit_to_ceo"
                                groups="discipline_management.group_discipline_cpco,discipline_management.group_discipline_admin"
                                confirm="Are you sure you want to endorse and officially submit this recommendation to the CEO for final approval and enforcement?"/>

                        <button name="action_return_to_secretary"
                                string="Return"
                                type="object"
                                class="btn-outline-danger"
                                invisible="state != 'chair_review' or not can_return_to_secretary"
                                groups="discipline_management.group_discipline_cpco,discipline_management.group_discipline_admin"
                                confirm="Return hearing proceedings to the Committee Secretary for revision?"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,chair_review,completed"/>
                    </header>
                    <sheet>
                        <field name="total_expected_members" invisible="1"/>
                        <field name="present_members_count" invisible="1"/>
                        <field name="required_quorum_percentage" invisible="1"/>
                        <field name="is_quorum_met" invisible="1"/>
                        <field name="is_rescheduled" invisible="1"/>
                        <field name="is_meeting_day_reached" invisible="1"/>

                        <field name="is_case_enforced" invisible="1"/>
                        <field name="is_case_readonly" invisible="1"/>

                        <widget name="web_ribbon" title="Quorum Met" bg_color="text-bg-success" invisible="state in ('draft', 'scheduled') or not is_quorum_met"/>
                        <widget name="web_ribbon" title="Enforced" bg_color="text-bg-success" invisible="state != 'completed' or not is_case_enforced"/>
                        <widget name="web_ribbon" title="Submitted to CEO" bg_color="text-bg-primary" invisible="state != 'completed' or is_case_enforced"/>

                        <div class="oe_title">
                            <label for="name" string="Hearing Reference"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <!-- Lifecycle Context Banners -->
                        <div class="alert alert-warning d-flex align-items-center mb-3" role="status" invisible="state != 'draft' or is_rescheduled">
                            <i class="fa fa-calendar-plus-o fa-2x me-3 text-warning" title="Planning Hearing"/>
                            <div>
                                <h5 class="mb-1 font-weight-bold">Hearing Planning &amp; Summons Preparation</h5>
                                <p class="mb-0">Enter the scheduled date, hearing conference room, and verify designated panel officers below. Click <strong>Notify Committee</strong> to officially summon the panel.</p>
                            </div>
                        </div>

                        <div class="alert alert-warning d-flex align-items-center mb-3" role="status" invisible="state != 'draft' or not is_rescheduled">
                            <i class="fa fa-refresh fa-2x me-3 text-warning" title="Rescheduled Hearing"/>
                            <div>
                                <h5 class="mb-1 font-weight-bold">Hearing Session Postponed for Rescheduling</h5>
                                <p class="mb-0">Update the Meeting Date and Hearing Room below, then click <strong>Notify Committee</strong> to dispatch the revised summons to all panel members.</p>
                            </div>
                        </div>

                        <div class="alert alert-info d-flex align-items-center mb-3" role="status" invisible="state != 'scheduled' or is_meeting_day_reached">
                            <i class="fa fa-calendar-check-o fa-2x me-3 text-info" title="Hearing Scheduled"/>
                            <div>
                                <h5 class="mb-1 font-weight-bold">Hearing Scheduled — Official Summons Dispatched</h5>
                                <p class="mb-0">This hearing is scheduled for <strong><field name="meeting_date" readonly="1"/></strong>. The <strong>Committee Chair Man</strong> may commence proceedings on or after the scheduled meeting date.</p>
                            </div>
                        </div>

                        <div class="alert alert-success d-flex align-items-center mb-3" role="status" invisible="state != 'scheduled' or not is_meeting_day_reached">
                            <i class="fa fa-gavel fa-2x me-3 text-success" title="Hearing Day Reached"/>
                            <div>
                                <h5 class="mb-1 font-weight-bold">Scheduled Hearing Day Reached</h5>
                                <p class="mb-0">Today is the scheduled hearing day. The <strong>Committee Chair Man</strong> may now click <strong>Start Hearing</strong> to call the panel to order and open the deliberation minutes.</p>
                            </div>
                        </div>

                        <div class="alert alert-primary d-flex align-items-center mb-3" role="status" invisible="state != 'in_progress'">
                            <i class="fa fa-pencil-square-o fa-2x me-3 text-primary" title="Hearing In Progress"/>
                            <div>
                                <h5 class="mb-1 font-weight-bold">Hearing In Session — Live Deliberations</h5>
                                <p class="mb-0">The <strong>Committee Secretary</strong> selects the recommended disciplinary measure and uploads the official signed meeting minutes PDF. When finalized, click <strong>Submit to Chair</strong>.</p>
                            </div>
                        </div>

                        <div class="alert alert-warning d-flex align-items-center mb-3" role="status" invisible="state != 'chair_review'">
                            <i class="fa fa-user-circle-o fa-2x me-3 text-warning" title="Pending Chairman Review"/>
                            <div>
                                <h5 class="mb-1 font-weight-bold">Hearing Concluded by Secretary — Pending Chairman Review</h5>
                                <p class="mb-0">The <strong>Committee Chair Man</strong> reviews the prescribed disciplinary measure and signed meeting minutes PDF, then clicks <strong>Submit to CEO</strong> (or <strong>Return</strong> if adjustments are required).</p>
                            </div>
                        </div>

                        <!-- Top Card 1: Case & Misconduct Summary -->
                        <group string="Case &amp; Misconduct Summary">
                            <group>
                                <field name="case_id" 
                                       readonly="id or state != 'draft' or is_case_readonly"
                                       domain="['&amp;', ('state', '=', 'committee_review'), '|', ('id', '=', case_id), '&amp;', ('has_active_committee_meeting', '=', False), ('has_completed_committee_meeting', '=', False)]"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                <field name="employee_id" readonly="1" options="{'no_open': True}"/>
                                <field name="job_id" readonly="1" options="{'no_open': True}"/>
                                <field name="department_id" readonly="1" options="{'no_open': True}"/>
                                <field name="staff_category" readonly="1"/>
                            </group>
                            <group>
                                <field name="offense_id" readonly="1"/>
                                <field name="severity_level" readonly="1"/>
                                <field name="incident_date" readonly="1"/>
                                <field name="investigation_id" readonly="1" invisible="not investigation_id"/>
                                <field name="investigation_outcome" readonly="1" invisible="not investigation_id"/>
                            </group>
                        </group>

                        <!-- Top Card 2: Hearing Logistics & Statutory Panel Officers -->
                        <group string="Hearing Logistics &amp; Statutory Panel Officers">
                            <group string="Hearing Logistics &amp; In-Person Venue">
                                <field name="meeting_date" readonly="state != 'draft'"/>
                                <field name="location" string="Hearing Room / In-Person Venue" readonly="state != 'draft'" placeholder="e.g. Main Boardroom / HR Conference Hall"/>
                                <field name="employee_statement_file" filename="employee_statement_filename" 
                                       string="Employee Written Defense / Statement"
                                       readonly="state == 'completed'"/>
                                <field name="employee_statement_filename" invisible="1"/>
                            </group>
                            <group string="Designated Panel Officers (Summoned)">
                                <field name="committee_chair_id" readonly="1" options="{'no_open': True}"/>
                                <field name="pomd_secretary_id" readonly="1" options="{'no_open': True}"/>
                                <field name="legal_director_id" readonly="1" options="{'no_open': True}"/>
                                <field name="respective_director_id" readonly="1" options="{'no_open': True}"/>
                                <field name="include_labour_union" readonly="state != 'draft'"/>
                                <field name="labour_union_rep_id" invisible="not include_labour_union" readonly="1" options="{'no_open': True}"/>
                            </group>
                        </group>

                        <notebook>
                            <!-- Unified Clean Page: Hearing Minutes & Committee Recommended Verdict -->
                            <page string="Hearing Session &amp; Committee Verdict" name="hearing_verdict" invisible="state in ('draft', 'scheduled')">
                                <!-- Group 1: Official Signed Meeting Minutes -->
                                <group string="Official Hearing Minutes &amp; Quorum Confirmation">
                                    <field name="signed_minutes_file" filename="signed_minutes_filename" 
                                           readonly="state in ('chair_review', 'completed')" 
                                           required="state == 'in_progress'"
                                           help="Upload the official scanned meeting minutes containing physical signatures of all attending panel members."/>
                                    <field name="signed_minutes_filename" invisible="1"/>
                                </group>

                                <!-- Group 2: Committee Recommended Disciplinary Measure -->
                                <group string="Committee Prescribed Disciplinary Measure">
                                    <group>
                                        <field name="recommended_penalty_type" widget="radio" readonly="state == 'completed'"/>
                                        <field name="recommended_warning_validity_days" readonly="state == 'completed'"
                                               invisible="recommended_penalty_type not in ('verbal_warning', 'first_warning_penalty', 'second_warning_penalty', 'final_warning_penalty')"/>
                                    </group>
                                    <group>
                                        <field name="recommended_penalty_percentage" readonly="state == 'completed'"
                                               invisible="staff_category == 'managerial' or recommended_penalty_type in ('verbal_warning', 'exonerate', 'dismissal')"/>
                                        <field name="recommended_fine_days" readonly="state == 'completed'"
                                               invisible="staff_category == 'non_managerial' or recommended_penalty_type in ('verbal_warning', 'exonerate', 'dismissal')"/>
                                        
                                        <!-- Demotion: Strictly Managerial Only -->
                                        <separator string="Managerial Auxiliary Sanction" invisible="staff_category != 'managerial' or recommended_penalty_type in ('dismissal', 'exonerate')"/>
                                        <field name="is_demotion_recommended" widget="boolean_toggle" readonly="state == 'completed'"
                                               invisible="staff_category != 'managerial' or recommended_penalty_type in ('dismissal', 'exonerate')"/>
                                        <div class="text-muted small" invisible="not is_demotion_recommended or staff_category != 'managerial' or recommended_penalty_type in ('dismissal', 'exonerate')">
                                            <i class="fa fa-info-circle text-info" title="Managerial Demotion Note"/> Demotion is recommended in addition to the warning measure above. Upon enforcement, an Employee Demotion draft record will be automatically created in Employee Service for HR placement.
                                        </div>
                                    </group>
                                </group>

                                <!-- Group 3: Chairperson Endorsement & Digital Sign-off (CPCO Chairperson & Admin Mandate Only) -->
                                <group string="Chairperson Endorsement &amp; Digital Sign-off"
                                       invisible="state not in ('chair_review', 'completed')"
                                       groups="discipline_management.group_discipline_cpco,discipline_management.group_discipline_admin">
                                    <group>
                                        <field name="chairman_review_notes" string="Chairperson Remarks / Endorsement Notes" readonly="state == 'completed'" placeholder="Optional: Chairperson notes, directives, or remarks..."/>
                                    </group>
                                    <group string="Digital Sign-off">
                                        <field name="chair_signature" widget="signature" string="Chairperson Digital Signature" readonly="state == 'completed'" help="Draw your digital signature on the canvas, or click 'Load My Saved Signature' to populate your profile signature."/>
                                        <div class="mt-2" invisible="state == 'completed'">
                                            <button name="action_load_saved_signature" string="Load My Saved Signature" type="object" class="btn btn-outline-primary btn-sm" icon="fa-download"/>
                                        </div>
                                        <div class="text-muted small mt-1" invisible="state != 'completed'">
                                            <span invisible="not chair_signature"><i class="fa fa-lock text-success me-1"/> Chairperson digital signature verified and sealed upon enforcement.</span>
                                        </div>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_discipline_committee_meeting" model="ir.actions.act_window">
            <field name="name">Disciplinary Committee Meetings</field>
            <field name="res_model">discipline.committee.meeting</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Committee Meetings Scheduled
                </p>
                <p>
                    Schedule formal hearing sessions, verify panel quorum, capture employee defense and deliberations, and submit recommended disciplinary measures.
                </p>
            </field>
        </record>
    </data>
</odoo>
