<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_discipline_committee_meeting_tree" model="ir.ui.view">
            <field name="name">discipline.committee.meeting.list</field>
            <field name="model">discipline.committee.meeting</field>
            <field name="arch" type="xml">
                <list decoration-success="state == 'completed'" decoration-warning="state == 'signing'">
                    <field name="name"/>
                    <field name="case_id"/>
                    <field name="employee_id"/>
                    <field name="meeting_date"/>
                    <field name="chair_id"/>
                    <field name="secretary_id"/>
                    <field name="signed_signatures_count" string="Signed Count"/>
                    <field name="total_signatures_count" string="Total Required"/>
                    <field name="all_signed" widget="boolean"/>
                    <field name="is_quorum_met" widget="boolean"/>
                    <field name="decided_punishment_type"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_discipline_committee_meeting_form" model="ir.ui.view">
            <field name="name">discipline.committee.meeting.form</field>
            <field name="model">discipline.committee.meeting</field>
            <field name="arch" type="xml">
                <form string="Disciplinary Committee Meeting">
                    <header>
                        <!-- Phase 1: Secretary schedules meeting -->
                        <button name="action_schedule_and_notify" string="Schedule &amp; Notify Members" type="object" class="oe_highlight"
                                invisible="state != 'scheduling'"/>

                        <!-- Phase 2: Start Meeting / Hearing -->
                        <button name="action_start_meeting" string="Start Deliberation" type="object" class="btn-primary"
                                invisible="state != 'scheduled'"/>

                        <!-- Phase 3: Secretary initiates vote/signature collection -->
                        <button name="action_request_signatures" string="Collect Votes / Send for Signatures" type="object" class="btn-warning"
                                invisible="state != 'in_progress'"/>

                        <!-- Member Action: Sign Minute via Signature Widget Popup -->
                        <button name="action_member_sign_popup" string="Sign Minute" type="object" class="btn-success" icon="fa-pencil"
                                invisible="not can_current_user_sign"/>

                        <!-- Phase 4: Finalize & Enforce Decision -->
                        <button name="action_finalize_and_enforce" string="Finalize &amp; Enforce Decision" type="object" class="btn-success"
                                invisible="state != 'signing' or not all_signed"/>

                        <field name="state" widget="statusbar" statusbar_visible="scheduling,scheduled,in_progress,signing,completed"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Finalized &amp; Enforced" bg_color="text-bg-success" invisible="state != 'completed'"/>
                        <widget name="web_ribbon" title="All Signed" bg_color="text-bg-primary" invisible="not all_signed or state == 'completed'"/>
                        <widget name="web_ribbon" title="Quorum Met" bg_color="text-bg-info" invisible="not is_quorum_met or state == 'completed'"/>

                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <!-- Phase Guidance Banners (Bunna Bank Brand Styled) -->
                        <div class="alert alert-info shadow-sm" style="border-left: 5px solid #1d2b32; background-color: #f3f6f8; color: #1d2b32; border-radius: 6px;" role="alert" invisible="state != 'scheduling'">
                            <strong>Secretary Scheduling Phase:</strong> Set the scheduled date, time, location, and link. Case details and punishments are locked until the hearing starts.
                        </div>
                        <div class="alert alert-warning shadow-sm" style="border-left: 5px solid #c17540; background-color: #fffbf7; color: #9e5b2e; border-radius: 6px;" role="alert" invisible="state != 'in_progress'">
                            <strong>Hearing &amp; Deliberation:</strong> Secretary records minutes and adjusts punishments below. Unilateral direct decision is disabled; digital signatures must be collected.
                        </div>
                        <div class="alert alert-success shadow-sm" style="border-left: 5px solid #425727; background-color: #f4f6f5; color: #425727; border-radius: 6px;" role="alert" invisible="state != 'signing'">
                            <strong>Signing Phase:</strong> Committee members must review official minutes and provide digital signatures using the signature pad.
                        </div>

                        <group>
                            <group string="Hearing Schedule &amp; Case">
                                <field name="is_current_user_secretary" invisible="1"/>
                                <field name="is_current_user_member" invisible="1"/>
                                <field name="can_current_user_sign" invisible="1"/>
                                <field name="case_id" readonly="state != 'scheduling'"/>
                                <field name="employee_id" readonly="1"/>
                                <field name="department_id" readonly="1"/>
                                <field name="meeting_date" readonly="state not in ('scheduling', 'scheduled')"/>
                                <field name="meeting_end_time" readonly="state not in ('scheduling', 'scheduled')"/>
                                <field name="location" readonly="state not in ('scheduling', 'scheduled')"/>
                                <field name="virtual_meeting_link" readonly="state not in ('scheduling', 'scheduled')"/>
                            </group>
                            <group string="Statutory Committee Members (FR-DIS-015)">
                                <field name="chair_id" readonly="1"/>
                                <field name="director_member_id" readonly="1"/>
                                <field name="legal_member_id" readonly="1"/>
                                <field name="secretary_id" readonly="1"/>
                                <field name="is_quorum_met" widget="boolean"/>
                                <field name="all_signed" widget="boolean"/>
                            </group>
                        </group>

                        <group string="Punishment Deliberation &amp; Adjustments (Secretary Only during Session)">
                            <group>
                                <field name="decided_punishment_type" readonly="state != 'in_progress'"/>
                                <field name="decided_penalty_percentage" readonly="state != 'in_progress'"/>
                                <field name="decided_fine_days" readonly="state != 'in_progress'"/>
                            </group>
                            <group>
                                <field name="new_job_id" invisible="decided_punishment_type != 'demotion'" readonly="state != 'in_progress'"/>
                                <field name="new_grade_id" invisible="decided_punishment_type != 'demotion'" readonly="state != 'in_progress'"/>
                                <field name="final_recommendation" readonly="state != 'in_progress'"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Official Meeting Minutes &amp; Deliberation">
                                <group>
                                    <field name="agenda" placeholder="Hearing agenda..." readonly="state not in ('scheduling', 'scheduled', 'in_progress')"/>
                                    <field name="meeting_minutes" placeholder="Record official discussion, employee defense, witness testimony, and findings..." readonly="state not in ('in_progress')"/>
                                    <field name="minute_filename" invisible="1"/>
                                    <field name="minute_document" filename="minute_filename" readonly="1" invisible="not minute_document"/>
                                </group>
                            </page>
                            <page string="Member Digital Signatures (FR-DIS-020)">
                                <field name="signature_line_ids" readonly="1">
                                    <list string="Signatures">
                                        <field name="sign_sequence" string="Seq"/>
                                        <field name="role_description" string="Committee Role"/>
                                        <field name="member_id" string="Member Name"/>
                                        <field name="is_signed" widget="boolean"/>
                                        <field name="signed_date"/>
                                        <field name="signature" widget="image" options="{'size': [150, 50]}"/>
                                        <field name="comments"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Digital Signature Popup Form -->
        <record id="view_discipline_committee_signature_form" model="ir.ui.view">
            <field name="name">discipline.committee.signature.form</field>
            <field name="model">discipline.committee.signature</field>
            <field name="arch" type="xml">
                <form string="Digital Signature Submission">
                    <sheet>
                        <field name="is_locked_pending_prior_signoff" invisible="1"/>
                        <div class="alert alert-warning shadow-sm" role="alert" invisible="not is_locked_pending_prior_signoff">
                            <strong>Locked:</strong> As Chairperson (CPCO), your final-approval signature is
                            disabled until the Immediate Director has signed first (FR-DIS-020.3).
                        </div>
                        <group>
                            <group>
                                <field name="meeting_id" readonly="1"/>
                                <field name="member_id" readonly="1"/>
                                <field name="role_description" readonly="1"/>
                            </group>
                            <group>
                                <field name="sign_sequence" readonly="1"/>
                                <field name="is_signed" readonly="1"/>
                                <field name="signed_date" readonly="1"/>
                            </group>
                        </group>
                        <group string="Deliberation Remarks &amp; Justification">
                            <field name="comments" placeholder="Provide any comments or concurrence notes..." readonly="is_locked_pending_prior_signoff"/>
                        </group>
                        <group string="Sign using Signature Pad">
                            <field name="signature" widget="signature" readonly="is_locked_pending_prior_signoff"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_save_signature" string="Confirm &amp; Submit Signature" type="object" class="btn-success"
                                invisible="is_locked_pending_prior_signoff"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_discipline_committee_meeting" model="ir.actions.act_window">
            <field name="name">Disciplinary Committee Meetings</field>
            <field name="res_model">discipline.committee.meeting</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
