<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_discipline_appeal_tree" model="ir.ui.view">
            <field name="name">discipline.appeal.list</field>
            <field name="model">discipline.appeal</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="case_id"/>
                    <field name="employee_id"/>
                    <field name="submission_date"/>
                    <field name="decision_outcome"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_discipline_appeal_form" model="ir.ui.view">
            <field name="name">discipline.appeal.form</field>
            <field name="model">discipline.appeal</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_start_review" string="Start Appeal Review" type="object" class="btn-info"
                                invisible="state != 'submitted'"
                                groups="discipline_management.group_discipline_director,discipline_management.group_discipline_pomd,discipline_management.group_discipline_cpco,discipline_management.group_discipline_ceo,discipline_management.group_discipline_admin"/>
                        <button name="action_render_decision" string="Render Final Decision" type="object" class="btn-success"
                                invisible="state != 'under_review'"
                                groups="discipline_management.group_discipline_director,discipline_management.group_discipline_pomd,discipline_management.group_discipline_cpco,discipline_management.group_discipline_ceo,discipline_management.group_discipline_admin"/>
                        <button name="action_create_second_appeal" string="Submit 2nd Level Appeal" type="object" class="btn-warning"
                                invisible="not can_submit_second_appeal"
                                help="Submit a 2nd level appeal to the next designated higher authority."/>
                        <field name="state" widget="statusbar" statusbar_visible="submitted,under_review,decided"/>
                    </header>
                    <sheet>
                        <field name="can_submit_second_appeal" invisible="1"/>
                        <field name="is_appeal_reviewer_or_admin" invisible="1"/>
                        <field name="is_appellant_employee" invisible="1"/>
                        <group>
                            <group string="Appeal Information &amp; Stage">
                                <field name="name" readonly="1"/>
                                <field name="case_id" readonly="state != 'submitted'"/>
                                <field name="employee_id" readonly="1"/>
                                <field name="appeal_level" readonly="1"/>
                                <field name="parent_appeal_id" invisible="appeal_level == 'first'" readonly="1"/>
                                <field name="case_origin_type" readonly="1"/>
                                <field name="appeal_target_authority" readonly="1"/>
                            </group>
                            <group string="Appeal Submission &amp; Authority">
                                <field name="submission_date" readonly="state != 'submitted'"/>
                                <field name="is_submitted_on_behalf"
                                       groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_admin"
                                       invisible="not is_submitted_on_behalf and not is_appeal_reviewer_or_admin"
                                       readonly="state != 'submitted'"/>
                                <field name="submitted_by_id"
                                       groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_admin"
                                       invisible="not is_submitted_on_behalf"
                                       readonly="1"/>
                                <field name="reviewer_id" invisible="state == 'submitted'" readonly="1"/>
                                <field name="review_date" invisible="state == 'submitted'" readonly="1"/>
                                <field name="supporting_document" filename="document_filename"
                                       readonly="state != 'submitted' or (not is_appellant_employee and not is_submitted_on_behalf)"/>
                                <field name="document_filename" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Appeal Grounds">
                                <field name="appeal_grounds" readonly="state != 'submitted' or (not is_appellant_employee and not is_submitted_on_behalf)" placeholder="Explain grounds for appeal, new evidence, or mitigating circumstances..."/>
                            </page>
                            <page string="Decision Outcome &amp; Revised Actions" invisible="state == 'submitted'">
                                <group>
                                    <field name="decision_outcome" readonly="state != 'under_review' or not is_appeal_reviewer_or_admin"/>
                                    <field name="revised_punishment_type" readonly="state != 'under_review' or not is_appeal_reviewer_or_admin"/>
                                    <field name="revised_penalty_percentage" readonly="state != 'under_review' or not is_appeal_reviewer_or_admin"/>
                                    <field name="revised_fine_days" readonly="state != 'under_review' or not is_appeal_reviewer_or_admin"/>
                                    <field name="appeal_decision_notes" readonly="state != 'under_review' or not is_appeal_reviewer_or_admin" placeholder="Appeal authority justification for upholding, overturning, or reducing penalty..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_discipline_appeal" model="ir.actions.act_window">
            <field name="name">Appeals &amp; Reviews</field>
            <field name="res_model">discipline.appeal</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
