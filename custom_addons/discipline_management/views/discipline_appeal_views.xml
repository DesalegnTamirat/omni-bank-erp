<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_discipline_appeal_tree" model="ir.ui.view">
            <field name="name">discipline.appeal.list</field>
            <field name="model">discipline.appeal</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="case_id"/>
                    <field name="employee_id"/>
                    <field name="submission_date"/>
                    <field name="decision_outcome"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_discipline_appeal_form" model="ir.ui.view">
            <field name="name">discipline.appeal.form</field>
            <field name="model">discipline.appeal</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="can_review" invisible="1"/>
                        <button name="action_start_review" string="Start Appeal Review" type="object" class="btn-info" invisible="state != 'submitted' or not can_review"/>
                        <button name="action_render_decision" string="Render Final Decision" type="object" class="btn-success" invisible="state != 'under_review' or not can_review"/>
                        <field name="state" widget="statusbar" statusbar_visible="submitted,under_review,decided"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Original Case Information">
                                <field name="name"/>
                                <field name="case_id" domain="[('employee_id.user_id', '=', uid), ('state', 'in', ['enforced', 'closed'])] if not can_review else [('state', 'in', ['enforced', 'closed'])]" readonly="state != 'submitted'"/>
                                <field name="employee_id"/>
                                <field name="original_offense_id"/>
                                <field name="original_decision_date"/>
                            </group>
                            <group string="Appeal Submission">
                                <field name="submission_date" readonly="state != 'submitted'"/>
                                <field name="reviewer_id" readonly="not can_review"/>
                                <field name="review_date" readonly="not can_review"/>
                                <field name="supporting_document" filename="document_filename" readonly="state != 'submitted'"/>
                                <field name="document_filename" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Appeal Grounds">
                                <field name="appeal_grounds" placeholder="Explain grounds for appeal, new evidence, or mitigating circumstances..." readonly="state != 'submitted'"/>
                            </page>
                            <page string="Decision Outcome &amp; Revised Actions" invisible="not can_review and state != 'decided'">
                                <group>
                                    <field name="decision_outcome" readonly="not can_review"/>
                                    <field name="revised_punishment_type" readonly="not can_review"/>
                                    <field name="revised_penalty_percentage" readonly="not can_review"/>
                                    <field name="appeal_decision_notes" placeholder="Board justification for upholding, overturning, or reducing penalty..." readonly="not can_review"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_discipline_appeal" model="ir.actions.act_window">
            <field name="name">Appeals &amp; Reviews</field>
            <field name="res_model">discipline.appeal</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
