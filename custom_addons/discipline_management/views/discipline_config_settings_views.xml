<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_discipline" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.discipline</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="70"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Discipline" string="Discipline" name="discipline_management" groups="discipline_management.group_discipline_admin">
                        <block title="Disciplinary Governance &amp; Appeal Settings" id="discipline_governance_settings">
                            <setting id="discipline_appeal_setting" string="Appeal Submission Window" help="Working days allowed for employee appeal submission.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="discipline_appeal_window_days" class="col-lg-4 o_light_label"/>
                                        <field name="discipline_appeal_window_days" class="col-lg-3"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="discipline_suspension_setting" string="Precautionary Suspension Limit" help="Maximum duration in days for precautionary suspension.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="discipline_max_suspension_days" class="col-lg-4 o_light_label"/>
                                        <field name="discipline_max_suspension_days" class="col-lg-3"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="discipline_investigation_setting" string="Audit Investigation Target Window" help="Standard investigation completion SLA in working days for internal audit inquiries.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="discipline_investigation_target_days" class="col-lg-4 o_light_label"/>
                                        <field name="discipline_investigation_target_days" class="col-lg-3"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="discipline_coach_authority_setting" string="Coach Enforcement Authority Limit" help="Maximum disciplinary sanction a Direct Coach or Line Manager can directly initiate and enforce without committee referral.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="discipline_coach_max_punishment" class="col-lg-4 o_light_label"/>
                                        <field name="discipline_coach_max_punishment" class="col-lg-4"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="discipline_email_notifications_setting" string="External Email Notifications" help="Dispatch external SMTP emails for formal disciplinary notices, directives, and chatter updates. Keep disabled on development/demo environments without an active mail server.">
                                <field name="discipline_enable_email_notifications"/>
                            </setting>
                        </block>

                        <block title="Attendance &amp; Absence Escalation Rules" id="discipline_attendance_rules">
                            <setting id="enable_attendance_discipline_cases_setting" string="Automated Attendance Disciplinary Cases" help="Enable background scanning and automated disciplinary case generation for unpunched shifts and excessive lateness. Keep disabled on test and demo databases.">
                                <field name="enable_attendance_discipline_cases"/>
                            </setting>
                            <setting id="lateness_setting" string="Cumulative Late Time Threshold (Minutes)" help="Total cumulative late duration in minutes across evaluation period triggering minor discipline case.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="attendance_late_minutes_threshold" class="col-lg-5 o_light_label"/>
                                        <field name="attendance_late_minutes_threshold" class="col-lg-3"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="absence_warning_setting" string="Consecutive Absence: Final Warning" help="Consecutive unexcused absence days triggering Level 2 Final Warning.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="absence_warning_consecutive_days" class="col-lg-5 o_light_label"/>
                                        <field name="absence_warning_consecutive_days" class="col-lg-3"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="absence_dismissal_setting" string="Consecutive Absence: Dismissal" help="Consecutive unexcused absence days triggering Critical Misconduct / Dismissal.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="absence_dismissal_consecutive_days" class="col-lg-5 o_light_label"/>
                                        <field name="absence_dismissal_consecutive_days" class="col-lg-3"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="absence_cumulative_setting" string="Cumulative Absence: Warning" help="Cumulative unexcused absence days within rolling period triggering minor warning.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="absence_cumulative_days_threshold" class="col-lg-5 o_light_label"/>
                                        <field name="absence_cumulative_days_threshold" class="col-lg-3"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="force_checkout_setting" string="Forced Check-Out Discipline Configuration" help="Optionally treat repeated force check-outs as disciplinary misconduct.">
                                <field name="enable_force_checkout_discipline"/>
                                <div class="content-group" invisible="not enable_force_checkout_discipline">
                                    <div class="row mt16">
                                        <label for="attendance_force_checkout_threshold" class="col-lg-5 o_light_label"/>
                                        <field name="attendance_force_checkout_threshold" class="col-lg-3"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="rolling_window_setting" string="Attendance Rolling Evaluation Window" help="Rolling period in days for threshold evaluations.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="attendance_rolling_days" class="col-lg-5 o_light_label"/>
                                        <field name="attendance_rolling_days" class="col-lg-3"/>
                                    </div>
                                </div>
                            </setting>
                        </block>

                        <block title="Disciplinary Committee Master Roles &amp; Union Configuration" id="discipline_committee_master_roles">
                            <setting id="discipline_cpco_setting" string="Disciplinary Committee Chair (CPCO)" help="Designated CPCO user for Committee Chairmanship and Managerial Suspension approval.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="discipline_cpco_user_id" class="col-lg-5 o_light_label"/>
                                        <field name="discipline_cpco_user_id" class="col-lg-7"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="discipline_secretary_setting" string="Committee Secretary (POMD Director)" help="Designated People Operations Director for Committee Secretary and minute taking.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="discipline_secretary_user_id" class="col-lg-5 o_light_label"/>
                                        <field name="discipline_secretary_user_id" class="col-lg-7"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="discipline_legal_setting" string="Legal Directorate Member" help="Designated Legal Directorate representative on the Disciplinary Committee.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="discipline_legal_user_id" class="col-lg-5 o_light_label"/>
                                        <field name="discipline_legal_user_id" class="col-lg-7"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="discipline_union_setting" string="Labour Union Representative" help="Designated Labour Union representative included in all Disciplinary Committee meetings.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="discipline_union_user_id" class="col-lg-5 o_light_label"/>
                                        <field name="discipline_union_user_id" class="col-lg-7"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="discipline_audit_setting" string="Internal Audit Directorate Director" help="Designated Audit Director for bank-wide audit investigations and reporting.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="discipline_audit_user_id" class="col-lg-5 o_light_label"/>
                                        <field name="discipline_audit_user_id" class="col-lg-7"/>
                                    </div>
                                </div>
                            </setting>
                        </block>
                        <block title="Official Notice Letter &amp; Branding Settings" id="discipline_branding_settings">
                            <setting id="discipline_notice_language_setting" string="Default Notice Letter Language" help="Official standard language for disciplinary warning letters and notice memos across the bank.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="discipline_notice_language" class="col-lg-5 o_light_label"/>
                                        <field name="discipline_notice_language" class="col-lg-4"/>
                                    </div>
                                </div>
                            </setting>
                            <setting id="discipline_bank_stamp_setting" string="Official Circular Bank Stamp" help="Upload the official circular Bunna Bank seal once. It will be automatically stamped onto all formal warning and decision letters across the bank.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="discipline_bank_stamp" class="col-lg-4 o_light_label"/>
                                        <field name="discipline_bank_stamp" widget="image" class="col-lg-4" style="max-width: 140px;"/>
                                    </div>
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="action_discipline_config_settings" model="ir.actions.act_window">
            <field name="name">Discipline Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module' : 'discipline_management', 'bin_size': False}</field>
        </record>

        <!-- Executive Assistant & Secretary Mapping in User Form -->
        <record id="view_users_form_discipline_inherit" model="ir.ui.view">
            <field name="name">res.users.form.discipline.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Discipline Governance" groups="discipline_management.group_discipline_admin,base.group_erp_manager,discipline_management.group_discipline_secretary">
                        <group>
                            <group string="Executive Assistant Mapping">
                                <field name="discipline_assigned_executive_id" string="Assigned Executive Principal"/>
                            </group>
                            <group string="Saved Digital Signature">
                                <field name="discipline_digital_signature" widget="image"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
