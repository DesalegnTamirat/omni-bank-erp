<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Root Menu -->
        <menuitem id="menu_discipline_root"
                  name="Discipline &amp; Governance"
                  web_icon="discipline_management,static/description/icon.png"
                  groups="discipline_management.group_discipline_user"
                  sequence="75"/>

        <!-- Executive & HR Dashboard (Adaptive for Employees and Officers) -->
        <menuitem id="menu_discipline_dashboard"
                  name="Dashboard"
                  parent="menu_discipline_root"
                  action="action_discipline_dashboard"
                  sequence="5"/>

        <!-- Main Operations Submenus -->
        <menuitem id="menu_discipline_cases"
                  name="Disciplinary Cases"
                  parent="menu_discipline_root"
                  action="action_discipline_case"
                  sequence="10"/>

        <record id="menu_discipline_investigations" model="ir.ui.menu">
            <field name="name">Investigations</field>
            <field name="parent_id" ref="menu_discipline_root"/>
            <field name="action" ref="action_discipline_investigation"/>
            <field name="sequence">20</field>
            <field name="group_ids" eval="[(6, 0, [ref('discipline_management.group_discipline_auditor'), ref('discipline_management.group_discipline_admin')])]"/>
        </record>

        <record id="menu_discipline_committees" model="ir.ui.menu">
            <field name="name">Committee Meetings</field>
            <field name="parent_id" ref="menu_discipline_root"/>
            <field name="action" ref="action_discipline_committee_meeting"/>
            <field name="sequence">30</field>
            <field name="group_ids" eval="[(6, 0, [ref('discipline_management.group_discipline_committee_secretary'), ref('discipline_management.group_discipline_cpco'), ref('discipline_management.group_discipline_admin')])]"/>
        </record>

        <record id="menu_discipline_suspensions" model="ir.ui.menu">
            <field name="name">Suspensions</field>
            <field name="parent_id" ref="menu_discipline_root"/>
            <field name="action" ref="action_discipline_suspension"/>
            <field name="sequence">40</field>
            <field name="group_ids" eval="[(6, 0, [ref('discipline_management.group_discipline_pomd'), ref('discipline_management.group_discipline_cpco'), ref('discipline_management.group_discipline_ceo'), ref('discipline_management.group_discipline_auditor'), ref('discipline_management.group_discipline_admin')])]"/>
        </record>

        <record id="menu_discipline_appeals" model="ir.ui.menu">
            <field name="name">Appeals &amp; Reviews</field>
            <field name="parent_id" ref="menu_discipline_root"/>
            <field name="action" ref="action_discipline_appeal"/>
            <field name="sequence">50</field>
        </record>

        <!-- Configuration Menu: Strictly restricted to HR Administrator (hidden from managers, directors, etc.) -->
        <record id="menu_discipline_config" model="ir.ui.menu">
            <field name="name">Configuration</field>
            <field name="parent_id" ref="menu_discipline_root"/>
            <field name="sequence">100</field>
            <field name="group_ids" eval="[(6, 0, [ref('discipline_management.group_discipline_admin')])]"/>
        </record>

        <record id="menu_discipline_severity_levels" model="ir.ui.menu">
            <field name="name">Severity Levels</field>
            <field name="parent_id" ref="menu_discipline_config"/>
            <field name="action" ref="action_discipline_severity_level"/>
            <field name="sequence">5</field>
            <field name="group_ids" eval="[(6, 0, [ref('discipline_management.group_discipline_admin')])]"/>
        </record>

        <record id="menu_discipline_offenses" model="ir.ui.menu">
            <field name="name">Offense Rules &amp; Penalties</field>
            <field name="parent_id" ref="menu_discipline_config"/>
            <field name="action" ref="action_discipline_offense"/>
            <field name="sequence">10</field>
            <field name="group_ids" eval="[(6, 0, [ref('discipline_management.group_discipline_admin')])]"/>
        </record>

        <record id="menu_discipline_offense_categories" model="ir.ui.menu">
            <field name="name">Offense Categories</field>
            <field name="parent_id" ref="menu_discipline_config"/>
            <field name="action" ref="action_discipline_offense_category"/>
            <field name="sequence">20</field>
            <field name="group_ids" eval="[(6, 0, [ref('discipline_management.group_discipline_admin')])]"/>
        </record>

        <record id="menu_discipline_policy_versions" model="ir.ui.menu">
            <field name="name">Policy Versions</field>
            <field name="parent_id" ref="menu_discipline_config"/>
            <field name="action" ref="action_discipline_policy_version"/>
            <field name="sequence">30</field>
            <field name="group_ids" eval="[(6, 0, [ref('discipline_management.group_discipline_admin')])]"/>
        </record>

    </data>
</odoo>
