<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Root Menu (Landing Page & Main Action directly loads Dashboard) -->
        <menuitem id="menu_discipline_root"
                  name="Discipline"
                  action="action_discipline_dashboard"
                  web_icon="discipline_management,static/description/icon.png"
                  groups="discipline_management.group_discipline_user"
                  sequence="75"/>

        <!-- 1. Operations / Cases Group -->
        <menuitem id="menu_discipline_operations_root"
                  name="Discipline Operations"
                  parent="menu_discipline_root"
                  sequence="10"/>

        
        <menuitem id="menu_discipline_case_followup"
                  name="Case Tracking &amp; Expiration Follow-up"
                  parent="menu_discipline_operations_root"
                  action="action_discipline_case_followup"
                  groups="discipline_management.group_discipline_secretary,discipline_management.group_discipline_pomd,discipline_management.group_discipline_cpco,discipline_management.group_discipline_ceo,discipline_management.group_discipline_admin"
                  sequence="10"/>

        <menuitem id="menu_discipline_cases"
                  name="Disciplinary Cases"
                  parent="menu_discipline_operations_root"
                  action="action_discipline_case_menu"
                  sequence="1"/>

        <menuitem id="menu_discipline_attendance_cases"
                  name="Attendance Cases"
                  parent="menu_discipline_operations_root"
                  action="action_discipline_attendance_case"
                  groups="discipline_management.group_discipline_user"
                  sequence="2"/>

        <menuitem id="menu_discipline_suspensions"
                  name="Suspensions"
                  parent="menu_discipline_operations_root"
                  action="action_discipline_suspension"
                  groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_cpco,discipline_management.group_discipline_admin"
                  sequence="3"/>

        <menuitem id="menu_discipline_appeals"
                  name="Appeals &amp; Reviews"
                  parent="menu_discipline_operations_root"
                  action="action_discipline_appeal"
                  sequence="4"/>

        <menuitem id="menu_discipline_payroll_penalties"
                  name="Payroll Deductions"
                  parent="menu_discipline_operations_root"
                  action="action_discipline_payroll_penalty"
                  groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_admin"
                  sequence="5"/>

        <menuitem id="menu_discipline_attendance_scan"
                  name="Scan Attendance Violations"
                  parent="menu_discipline_operations_root"
                  action="action_discipline_attendance_scan_wizard"
                  groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_admin"
                  sequence="6"/>

        <record id="menu_discipline_attendance_scan" model="ir.ui.menu">
            <field name="group_ids" eval="[(6, 0, [ref('discipline_management.group_discipline_pomd'), ref('discipline_management.group_discipline_admin')])]"/>
        </record>

        <!-- 3. Hearings & Investigations Group -->
        <menuitem id="menu_discipline_hearings_root"
                  name="Hearings &amp; Investigations"
                  parent="menu_discipline_root"
                  groups="discipline_management.group_discipline_user"
                  sequence="20"/>

        <menuitem id="menu_discipline_investigations"
                  name="Investigations"
                  parent="menu_discipline_hearings_root"
                  action="action_discipline_investigation"
                  groups="discipline_management.group_discipline_ceo,discipline_management.group_discipline_cpco,discipline_management.group_discipline_auditor,discipline_management.group_discipline_pomd,discipline_management.group_discipline_legal,discipline_management.group_discipline_admin"
                  sequence="1"/>

        <menuitem id="menu_discipline_committees"
                  name="Committee Meetings"
                  parent="menu_discipline_hearings_root"
                  action="action_discipline_committee_meeting"
                  groups="discipline_management.group_discipline_user"
                  sequence="2"/>

        <!-- 4. Regulatory Catalog (Offenses, Articles, Categories) -->
        <menuitem id="menu_discipline_reference_root"
                  name="Regulatory Catalog"
                  parent="menu_discipline_root"
                  sequence="30"/>

        <menuitem id="menu_discipline_offenses_ref"
                  name="Offense Classifications &amp; Rules"
                  parent="menu_discipline_reference_root"
                  action="action_discipline_offense"
                  sequence="1"/>

        <menuitem id="menu_discipline_articles_ref"
                  name="Regulatory Articles"
                  parent="menu_discipline_reference_root"
                  action="action_discipline_article"
                  sequence="2"/>

        <menuitem id="menu_discipline_offense_categories"
                  name="Offense Categories"
                  parent="menu_discipline_reference_root"
                  action="action_discipline_offense_category"
                  sequence="3"/>

        <!-- Server Action & Menu for Turnkey Regulation Synchronization -->
        <record id="action_sync_bunna_regulation_server" model="ir.actions.server">
            <field name="name">Sync &amp; Repair Regulation Catalog</field>
            <field name="model_id" ref="model_discipline_offense"/>
            <field name="state">code</field>
            <field name="code">action = model.action_sync_bunna_regulation_catalog()</field>
        </record>

        <menuitem id="menu_discipline_sync_catalog"
                  name="Sync &amp; Repair Regulation"
                  parent="menu_discipline_reference_root"
                  action="action_sync_bunna_regulation_server"
                  groups="discipline_management.group_discipline_admin"
                  sequence="10"/>

        <!-- 5. Configuration Menu Group (Admin Settings & Engine Parameters) -->
        <menuitem id="menu_discipline_config"
                  name="Configuration"
                  parent="menu_discipline_root"
                  groups="discipline_management.group_discipline_admin"
                  sequence="100"/>

        <menuitem id="menu_discipline_settings"
                  name="Settings"
                  parent="menu_discipline_config"
                  action="action_discipline_config_settings"
                  groups="discipline_management.group_discipline_admin"
                  sequence="1"/>

        <menuitem id="menu_discipline_severity_levels"
                  name="Severity Levels"
                  parent="menu_discipline_config"
                  action="action_discipline_severity_level"
                  groups="discipline_management.group_discipline_admin"
                  sequence="2"/>

        <menuitem id="menu_discipline_policy_versions_ref"
                  name="Regulation Documents &amp; Policies"
                  parent="menu_discipline_config"
                  action="action_discipline_policy_version"
                  groups="discipline_management.group_discipline_admin"
                  active="False"
                  sequence="99"/>

    </data>
</odoo>
