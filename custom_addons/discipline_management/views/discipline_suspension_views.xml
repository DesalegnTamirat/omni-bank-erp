<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_discipline_suspension_tree" model="ir.ui.view">
            <field name="name">discipline.suspension.list</field>
            <field name="model">discipline.suspension</field>
            <field name="arch" type="xml">
                <list decoration-danger="working_days_count > 25">
                    <field name="name"/>
                    <field name="case_id"/>
                    <field name="employee_id"/>
                    <field name="suspension_type"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="working_days_count"/>
                    <field name="days_remaining"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_discipline_suspension_form" model="ir.ui.view">
            <field name="name">discipline.suspension.form</field>
            <field name="model">discipline.suspension</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_activate_suspension" string="Activate Suspension" type="object" class="btn-warning" invisible="state != 'draft'"/>
                        <button name="action_reinstate_employee" string="Reinstate Employee" type="object" class="btn-success" invisible="state not in ('active', 'extended')"/>
                        <!-- DIS-2: Convert active/extended suspension to dismissal (Admin only) -->
                        <button name="action_convert_to_dismissal" string="Convert to Dismissal" type="object" class="btn-danger"
                                invisible="state not in ('active', 'extended')"
                                groups="discipline_management.group_discipline_admin"
                                confirm="This will convert the suspension into a DISMISSAL. The employee will be permanently separated. Proceed?"
                                help="FR-DIS-030: Escalate this suspension to a full dismissal action."/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,active,completed,converted_dismissal"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Suspension Details">
                                <field name="name"/>
                                <field name="case_id"/>
                                <field name="employee_id"/>
                                <field name="department_id"/>
                            </group>
                            <group string="Type &amp; Duration Rules">
                                <field name="suspension_type"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="working_days_count"/>
                                <field name="days_remaining"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Reason &amp; Conditions">
                                <field name="reason" placeholder="Detailed reason for suspension pending investigation..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_discipline_suspension" model="ir.actions.act_window">
            <field name="name">Suspension Requests</field>
            <field name="res_model">discipline.suspension</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
