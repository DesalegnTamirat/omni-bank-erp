<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_discipline_investigation_tree" model="ir.ui.view">
            <field name="name">discipline.investigation.list</field>
            <field name="model">discipline.investigation</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="case_id"/>
                    <field name="employee_id"/>
                    <field name="investigator_id"/>
                    <field name="investigation_date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_discipline_investigation_form" model="ir.ui.view">
            <field name="name">discipline.investigation.form</field>
            <field name="model">discipline.investigation</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_submit_findings" string="Submit Findings" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_accept_findings" string="Accept Findings" type="object" class="btn-success" invisible="state != 'submitted'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Case Reference">
                                <field name="name"/>
                                <field name="case_id"/>
                                <field name="employee_id"/>
                            </group>
                            <group string="Investigator Details">
                                <field name="investigator_id"/>
                                <field name="investigation_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Findings &amp; Recommendations">
                                <group>
                                    <field name="summary_findings" placeholder="Detail investigation findings..."/>
                                    <field name="witness_statements" placeholder="Enter witness statements and notes..."/>
                                    <field name="investigator_recommendation" placeholder="Investigator recommended action..."/>
                                </group>
                            </page>
                            <page string="Evidence Attachments">
                                <group>
                                    <field name="report_file" filename="report_filename"/>
                                    <field name="report_filename" invisible="1"/>
                                    <field name="evidence_file" filename="evidence_filename"/>
                                    <field name="evidence_filename" invisible="1"/>
                                    <field name="statement_file" filename="statement_filename"/>
                                    <field name="statement_filename" invisible="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_discipline_investigation" model="ir.actions.act_window">
            <field name="name">Investigations &amp; Findings</field>
            <field name="res_model">discipline.investigation</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
