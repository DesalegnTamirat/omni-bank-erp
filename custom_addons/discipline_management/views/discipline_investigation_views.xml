<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_discipline_investigation_tree" model="ir.ui.view">
            <field name="name">discipline.investigation.list</field>
            <field name="model">discipline.investigation</field>
            <field name="arch" type="xml">
                <list decoration-info="state == 'draft'"
                      decoration-warning="state in ('assigned', 'submitted_ceo', 'forwarded_cpco')"
                      decoration-success="state == 'approved'">
                    <field name="name"/>
                    <field name="case_id"/>
                    <field name="employee_id"/>
                    <field name="director_id"/>
                    <field name="finding_outcome"/>
                    <field name="financial_loss_amount" optional="hide"/>
                    <field name="investigation_date"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state in ('assigned', 'submitted_ceo', 'forwarded_cpco')"
                           decoration-success="state == 'approved'"/>
                </list>
            </field>
        </record>

        <record id="view_discipline_investigation_form" model="ir.ui.view">
            <field name="name">discipline.investigation.form</field>
            <field name="model">discipline.investigation</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <!-- Stage 1: Kickoff Formal Audit Investigation -->
                        <button name="action_start_investigation"
                                string="Start Investigation"
                                type="object"
                                class="oe_highlight btn-primary"
                                invisible="state != 'draft'"
                                groups="discipline_management.group_discipline_auditor,discipline_management.group_discipline_admin"/>

                        <!-- Stage 2: Audit Director Concludes & Submits Exclusively to CEO -->
                        <button name="action_audit_complete_and_submit_to_ceo"
                                string="Submit"
                                type="object"
                                class="oe_highlight btn-success"
                                invisible="state != 'assigned'"
                                groups="discipline_management.group_discipline_auditor,discipline_management.group_discipline_admin"/>

                        <!-- Stage 3: CEO Forwards to Disciplinary Committee Chairman (CPCO) -->
                        <button name="action_ceo_forward_case_to_committee_chair"
                                string="Forward to Committee"
                                type="object"
                                class="oe_highlight btn-primary"
                                invisible="not can_ceo_forward_case"/>

                        <!-- Stage 4: CPCO Forwards to Committee Secretary (POMD) for Committee Scheduling -->
                        <button name="action_cpco_forward_case_to_secretary"
                                string="Forward to Secretary"
                                type="object"
                                class="oe_highlight btn-primary"
                                invisible="not can_cpco_forward_case"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,assigned,submitted_ceo,forwarded_cpco,approved"/>
                    </header>
                    <sheet>
                        <field name="can_ceo_forward_case" invisible="1"/>
                        <field name="can_cpco_forward_case" invisible="1"/>
                        <div class="alert alert-info d-flex align-items-center mb-3" role="status" invisible="state != 'draft'">
                            <i class="fa fa-info-circle fa-2x me-3 text-info" title="Investigation Notice"/>
                            <div>
                                <h5 class="mb-1 font-weight-bold">Referral Received — Investigation Pending Kickoff</h5>
                                <p class="mb-0">This disciplinary case has been referred to the Internal Audit Directorate. Review the terms of reference and allegations below, then click <strong>Start Investigation</strong> to begin confidential inquiry.</p>
                            </div>
                        </div>
                        <group>
                            <group string="Case &amp; Allegation Summary">
                                <field name="name" readonly="1"/>
                                <field name="case_id" readonly="1"/>
                                <field name="employee_id" readonly="1" options="{'no_open': True}"/>
                                <field name="offense_id" readonly="1"/>
                                <field name="investigation_date" readonly="state != 'draft'"/>
                            </group>
                            <group string="Audit Directorate &amp; Financial Scope">
                                <field name="director_id" readonly="1"/>
                                <field name="target_completion_date" readonly="1"/>
                                <field name="is_cash_shortage" invisible="1"/>
                                <field name="financial_loss_amount"
                                       invisible="not is_cash_shortage"
                                       readonly="state not in ('draft', 'assigned')"/>
                                <field name="loss_resolution_status"
                                       invisible="not is_cash_shortage or financial_loss_amount == 0"
                                       readonly="state not in ('draft', 'assigned')"/>
                            </group>
                        </group>
                        <notebook>
                            <!-- Tab 1: Referral & Terms of Reference -->
                            <page string="Referral &amp; Terms of Reference" name="referral_terms">
                                <separator string="Initiator Incident Facts &amp; Description"/>
                                <field name="case_description" class="w-100 mb-3" style="min-height: 80px; width: 100%;" readonly="1"/>
                                
                                <div invisible="not chief_review_notes">
                                    <separator string="Executive Remark (Respective Chief Officer)"/>
                                    <field name="chief_review_notes" class="w-100 mb-3" style="min-height: 80px; width: 100%;" readonly="1"/>
                                </div>

                                <div invisible="not ceo_assignment_notes">
                                    <separator string="CEO Directive &amp; Investigation Mandate"/>
                                    <field name="ceo_assignment_notes" class="w-100 mb-3" style="min-height: 80px; width: 100%;" readonly="1"/>
                                </div>
                            </page>

                            <!-- Tab 2: Findings & Report (Consolidated with Documents) -->
                            <page string="Findings &amp; Report" name="findings_report" invisible="state == 'draft'">
                                <group>
                                    <field name="finding_outcome" string="Audit Conclusion"
                                           readonly="state not in ('draft', 'assigned')"/>
                                </group>

                                <separator string="Audit Findings (Optional)"/>
                                <field name="summary_findings" widget="html" class="w-100 mb-3" style="min-height: 140px; width: 100%;"
                                       readonly="state not in ('draft', 'assigned')"
                                       placeholder="Optional: Summarize established audit findings, verified records, transactions, and policies breached..."/>

                                <separator string="Recommendations (Optional)"/>
                                <field name="investigator_recommendation" widget="html" class="w-100 mb-3" style="min-height: 120px; width: 100%;"
                                       readonly="state not in ('draft', 'assigned')"
                                       placeholder="Optional: Detail recommended disciplinary sanctions and internal control remediation..."/>

                                <!-- Liable Personnel Matrix (Full Width - Not Shrunk) -->
                                <div invisible="finding_outcome != 'substantiated'" class="mt-3 mb-3">
                                    <separator string="Liable Personnel Matrix"/>
                                    <field name="liable_employee_ids" class="w-100" readonly="state not in ('draft', 'assigned')">
                                        <list editable="bottom">
                                            <field name="employee_id" options="{'no_open': True}"/>
                                            <field name="role_in_incident"/>
                                            <field name="degree_of_liability"/>
                                            <field name="recommended_action"/>
                                        </list>
                                    </field>
                                </div>

                                <!-- Consolidated Documents & Evidence -->
                                <separator string="Investigation Report &amp; Documents"/>
                                <group>
                                    <group string="Official Report">
                                        <field name="report_file" filename="report_filename"
                                               string="Signed Audit Report (PDF)"
                                               readonly="state not in ('draft', 'assigned')"/>
                                        <field name="report_filename" invisible="1"/>
                                    </group>
                                    <group string="Supporting Attachments">
                                        <field name="evidence_file" filename="evidence_filename"
                                               string="Supporting Evidence File"
                                               readonly="state not in ('draft', 'assigned')"/>
                                        <field name="evidence_filename" invisible="1"/>
                                        <field name="statement_file" filename="statement_filename"
                                               string="Witness Statements Document"
                                               readonly="state not in ('draft', 'assigned')"/>
                                        <field name="statement_filename" invisible="1"/>
                                    </group>
                                </group>

                                <group string="Initial Case Incident Evidence (Reference)" invisible="not initial_case_attachment">
                                    <field name="initial_case_attachment" filename="initial_case_attachment_filename"
                                           string="Incident Evidence from Case Initiator" readonly="1"/>
                                    <field name="initial_case_attachment_filename" invisible="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_discipline_investigation" model="ir.actions.act_window">
            <field name="name">Investigations &amp; Findings</field>
            <field name="res_model">discipline.investigation</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>

