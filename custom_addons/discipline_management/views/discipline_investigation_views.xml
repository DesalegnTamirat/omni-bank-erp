<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_discipline_investigation_tree" model="ir.ui.view">
            <field name="name">discipline.investigation.list</field>
            <field name="model">discipline.investigation</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="case_id"/>
                    <field name="employee_id"/>
                    <field name="investigator_id"/>
                    <field name="finding_outcome"/>
                    <field name="investigation_date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_discipline_investigation_form" model="ir.ui.view">
            <field name="name">discipline.investigation.form</field>
            <field name="model">discipline.investigation</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_announce_findings" string="Announce Investigation Findings" type="object" class="oe_highlight"
                                invisible="state != 'draft'"
                                groups="discipline_management.group_discipline_auditor,discipline_management.group_discipline_admin"/>
                        <button name="action_accept_findings" string="Accept &amp; Sign-off Findings" type="object" class="btn-success"
                                invisible="state != 'submitted'"
                                groups="discipline_management.group_discipline_director,discipline_management.group_discipline_admin"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Case Reference">
                                <field name="name" readonly="1"/>
                                <field name="title"/>
                                <field name="case_id" readonly="1"/>
                                <field name="employee_id" readonly="1"/>
                                <field name="finding_outcome" widget="radio" options="{'horizontal': true}"/>
                            </group>
                            <group string="Investigator &amp; Financial Loss Details">
                                <field name="investigator_id" readonly="state in ('submitted', 'approved')"/>
                                <field name="investigation_date"/>
                                <field name="financial_loss_amount"/>
                                <field name="loss_resolution_status"/>
                                <field name="offense_id" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <!-- Tab 1: Findings & Scope -->
                            <page string="1. Findings &amp; Scope">
                                <group string="Introduction &amp; Mandate">
                                    <field name="introduction" placeholder="Describe the background, mandate, initiation circumstances, and commencement of investigation..."/>
                                </group>
                                <group string="Scope &amp; Limitations">
                                    <field name="scope_limitations" placeholder="Specify boundaries, timeframes, systems/branches audited, constraints faced during investigation..."/>
                                </group>
                                <group string="Investigation Findings (Facts Established)">
                                    <field name="summary_findings" placeholder="Detail all facts established during the investigation, timelines, and audit evidence..."/>
                                </group>
                                <group string="Recommendations &amp; Proposed Actions">
                                    <field name="investigator_recommendation" placeholder="Investigator recommended action, disciplinary sanction, and system control improvements..."/>
                                </group>
                            </page>

                            <!-- Tab 2: Liable Personnel & Policies -->
                            <page string="2. Liable Personnel &amp; Policies">
                                <group string="Specific Policy Articles Violated">
                                    <field name="applicable_policy" placeholder="e.g. HR Policy Section 4.2 – Attendance Violations"/>
                                    <field name="policy_clause"/>
                                    <field name="policy_violation_references" placeholder="Detail specific policy articles, procedural codes, and circular clauses violated..."/>
                                </group>
                                <group string="Liable Personnel List">
                                    <field name="liable_employee_ids">
                                        <list editable="bottom">
                                            <field name="employee_id"/>
                                            <field name="role_in_incident"/>
                                            <field name="degree_of_liability"/>
                                            <field name="recommended_action"/>
                                        </list>
                                    </field>
                                </group>
                            </page>

                            <!-- Tab 3: Evidence & Management Sign-off -->
                            <page string="3. Evidence &amp; Management Sign-off">
                                <group string="Witness Statements &amp; Chain of Custody">
                                    <field name="witness_statements" placeholder="Enter witness statements and interview notes..."/>
                                    <field name="evidence_description" placeholder="Evidence collected, chain of custody, CCTV references..."/>
                                </group>
                                <group string="Evidence Attachments">
                                    <group>
                                        <field name="report_file" filename="report_filename"/>
                                        <field name="report_filename" invisible="1"/>
                                        <field name="statement_file" filename="statement_filename"/>
                                        <field name="statement_filename" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="evidence_file" filename="evidence_filename"/>
                                        <field name="evidence_filename" invisible="1"/>
                                    </group>
                                </group>
                                <group string="Management Review Sign-off">
                                    <group>
                                        <field name="reviewed_by_id"/>
                                        <field name="management_review_date"/>
                                    </group>
                                    <group>
                                        <field name="management_review_notes" placeholder="Management review notes and approval remarks..."/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_discipline_investigation" model="ir.actions.act_window">
            <field name="name">Investigations &amp; Findings</field>
            <field name="res_model">discipline.investigation</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>

