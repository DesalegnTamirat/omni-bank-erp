<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_discipline_payroll_penalty_tree" model="ir.ui.view">
            <field name="name">discipline.payroll.penalty.list</field>
            <field name="model">discipline.payroll.penalty</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="case_id"/>
                    <field name="employee_id"/>
                    <field name="penalty_percentage"/>
                    <field name="calculated_amount"/>
                    <field name="effective_date"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_discipline_payroll_penalty_form" model="ir.ui.view">
            <field name="name">discipline.payroll.penalty.form</field>
            <field name="model">discipline.payroll.penalty</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_transmit_to_payroll" string="Transmit to Payroll" type="object" class="oe_highlight" invisible="state != 'pending'"/>
                        <button name="action_mark_deducted" string="Mark as Deducted" type="object" class="btn-success" invisible="state != 'transferred'"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,transferred,deducted"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Penalty &amp; Case">
                                <field name="name"/>
                                <field name="case_id"/>
                                <field name="employee_id"/>
                            </group>
                            <group string="Deduction Amounts &amp; Dates">
                                <field name="penalty_percentage"/>
                                <field name="calculated_amount"/>
                                <field name="effective_date"/>
                                <field name="payslip_reference"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Integration Notes">
                                <field name="notes" placeholder="Integration log notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_discipline_payroll_penalty" model="ir.actions.act_window">
            <field name="name">Payroll Penalty Deductions</field>
            <field name="res_model">discipline.payroll.penalty</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
