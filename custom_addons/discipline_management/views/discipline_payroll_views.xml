<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_discipline_payroll_penalty_tree" model="ir.ui.view">
            <field name="name">discipline.payroll.penalty.list</field>
            <field name="model">discipline.payroll.penalty</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="transaction_type" widget="badge"
                           decoration-danger="transaction_type == 'deduction'"
                           decoration-success="transaction_type == 'refund'"/>
                    <field name="case_id" optional="show"/>
                    <field name="attendance_case_id" optional="show"/>
                    <field name="employee_id"/>
                    <field name="penalty_type"/>
                    <field name="penalty_percentage"/>
                    <field name="suspension_days"/>
                    <field name="daily_rate"/>
                    <field name="calculated_amount"/>
                    <field name="payroll_month"/>
                    <field name="effective_date"/>
                    <field name="is_appeal_held" widget="boolean_toggle" readonly="1" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-warning="state == 'pending'"
                           decoration-info="state == 'transferred'"
                           decoration-danger="state == 'deducted'"
                           decoration-success="state == 'reimbursed'"
                           decoration-muted="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <record id="view_discipline_payroll_penalty_form" model="ir.ui.view">
            <field name="name">discipline.payroll.penalty.form</field>
            <field name="model">discipline.payroll.penalty</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_transmit_to_payroll" string="Transmit to Payroll" type="object" class="oe_highlight"
                                invisible="state != 'pending'"
                                groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_admin,base.group_system"/>
                        <button name="action_mark_deducted" string="Mark as Deducted" type="object" class="btn-success"
                                invisible="state != 'transferred' or transaction_type == 'refund'"
                                groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_admin,base.group_system"/>
                        <button name="action_mark_reimbursed" string="Mark as Reimbursed in Payslip" type="object" class="btn-success"
                                invisible="state != 'transferred' or transaction_type != 'refund'"
                                groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_admin,base.group_system"/>
                        <!-- Cancel button -->
                        <button name="action_cancel" string="Cancel / Waive" type="object" class="btn-danger"
                                invisible="state in ('deducted', 'reimbursed', 'cancelled')"
                                groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_admin,base.group_system"
                                confirm="Cancel this payroll transaction?"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,transferred,deducted,reimbursed"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Appeal Hold" bg_color="text-bg-warning" invisible="not is_appeal_held"/>
                        <field name="is_appeal_window_active" invisible="1"/>
                        <group>
                            <group string="Penalty &amp; Case">
                                <field name="name" readonly="1"/>
                                <field name="transaction_type"/>
                                <field name="case_id" invisible="not case_id and attendance_case_id"/>
                                <field name="attendance_case_id" invisible="not attendance_case_id and case_id"/>
                                <field name="employee_id"/>
                                <field name="parent_penalty_id" invisible="transaction_type != 'refund'"/>
                                <field name="appeal_id" invisible="transaction_type != 'refund'"/>
                            </group>
                            <!-- Penalty type selector -->
                            <group string="Calculation Type">
                                <field name="penalty_type"/>
                                <field name="refund_amount" invisible="transaction_type != 'refund'"/>
                                <field name="penalty_percentage" invisible="penalty_type != 'percentage' or transaction_type == 'refund'"/>
                                <field name="suspension_id" invisible="penalty_type != 'suspension_without_pay'"/>
                                <field name="suspension_days" invisible="penalty_type != 'suspension_without_pay'"/>
                                <field name="managerial_days" invisible="penalty_type != 'managerial'"/>
                                <field name="daily_rate" readonly="1"
                                       invisible="penalty_type not in ('suspension_without_pay', 'managerial')"/>
                            </group>
                        </group>
                        <group>
                            <group string="Amounts &amp; Payroll Dates">
                                <field name="calculated_amount" readonly="1"/>
                                <field name="is_appeal_held" readonly="1"/>
                                <field name="payroll_month" string="Target Payroll Month"/>
                                <field name="effective_date"/>
                                <field name="payslip_reference"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Integration Notes">
                                <field name="notes" placeholder="Integration log notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_discipline_payroll_penalty" model="ir.actions.act_window">
            <field name="name">Payroll Penalty Deductions &amp; Reimbursements</field>
            <field name="res_model">discipline.payroll.penalty</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
