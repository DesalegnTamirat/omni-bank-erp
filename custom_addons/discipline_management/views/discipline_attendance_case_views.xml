<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================================= -->
        <!-- 1. WIZARD VIEW: Leave Adjustment, Coach Exoneration & Batch HR Refusal   -->
        <!-- ========================================================================= -->
        <record id="view_discipline_attendance_action_wizard_form" model="ir.ui.view">
            <field name="name">discipline.attendance.action.wizard.form</field>
            <field name="model">discipline.attendance.action.wizard</field>
            <field name="arch" type="xml">
                <form string="Attendance Case Action">
                    <field name="action_type" invisible="1"/>
                    <field name="case_count" invisible="1"/>
                    <field name="employee_id" invisible="1"/>

                    <div class="alert alert-info mb-3" role="alert" invisible="action_type != 'adjust_leave'">
                        <strong><i class="fa fa-calendar-check-o me-2" title="Leave Adjustment"/>Convert / Adjust Unexcused Absence by Leave:</strong>
                        Before enforcement, the employee (or Coach / Director / POMD) can cover the absent days with an approved or newly submitted Time Off request.
                        If all absent days are covered, the case closes automatically with zero penalty.
                    </div>
                    <div class="alert alert-success mb-3" role="alert" invisible="action_type != 'coach_exonerate'">
                        <strong><i class="fa fa-check-circle me-2" title="Exoneration"/>Direct Coach Acknowledgment / Exoneration:</strong>
                        Record a valid operational justification (e.g., authorized field duty, biometric outage, emergency permission) to close the selected attendance case(s) with zero penalty.
                    </div>
                    <div class="alert alert-danger mb-3" role="alert" invisible="action_type != 'hr_refuse'">
                        <strong><i class="fa fa-ban me-2" title="Refusal"/>HR / POMD Refusal (Individual or Batch):</strong>
                        Refusing the selected attendance case(s) will reject the disciplinary action and automatically cancel any pending payroll deduction.
                    </div>

                    <group>
                        <group invisible="action_type != 'adjust_leave'">
                            <field name="leave_mode" widget="radio"/>
                            <field name="leave_id"
                                   invisible="leave_mode != 'existing'"
                                   required="action_type == 'adjust_leave' and leave_mode == 'existing'"
                                   options="{'no_create': True}"/>
                            <field name="holiday_status_id"
                                   invisible="leave_mode != 'create_new'"
                                   required="action_type == 'adjust_leave' and leave_mode == 'create_new'"
                                   options="{'no_create': True}"/>
                            <field name="leave_date_from"
                                   invisible="leave_mode == 'existing'"
                                   required="action_type == 'adjust_leave' and leave_mode != 'existing'"/>
                            <field name="leave_date_to"
                                   invisible="leave_mode == 'existing'"
                                   required="action_type == 'adjust_leave' and leave_mode != 'existing'"/>
                        </group>
                        <group>
                            <field name="attendance_case_ids" widget="many2many_tags" readonly="1"/>
                            <field name="reason_notes"
                                   placeholder="Enter detailed justification, leave reference, or HR refusal reason..."/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_confirm"
                                string="Confirm &amp; Apply"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- ========================================================================= -->
        <!-- 2. LIST VIEW: Dedicated Attendance Disciplinary Cases                     -->
        <!-- ========================================================================= -->
        <record id="view_discipline_attendance_case_list" model="ir.ui.view">
            <field name="name">discipline.attendance.case.list</field>
            <field name="model">discipline.attendance.case</field>
            <field name="arch" type="xml">
                <list string="Attendance Disciplinary Cases"
                      decoration-danger="violation_type == 'absence_dismissal' and state in ('director_review', 'pomd_review')"
                      decoration-warning="state == 'coach_review'"
                      decoration-success="state in ('leave_adjusted', 'exonerated')"
                      decoration-info="state == 'enforced'"
                      decoration-muted="state == 'hr_refused'">
                    <header>
                        <button name="action_coach_enforce"
                                string="Batch Enforce (Coach)"
                                type="object"
                                class="btn-primary"/>
                        <button name="action_open_exonerate_wizard"
                                string="Batch Exonerate / Acknowledge"
                                type="object"
                                class="btn-secondary"/>
                        <button name="action_open_hr_refuse_wizard"
                                string="Batch Refuse (HR)"
                                type="object"
                                class="btn-danger"
                                groups="discipline_management.group_discipline_pomd,discipline_management.group_discipline_cpco,discipline_management.group_discipline_ceo,discipline_management.group_discipline_admin"/>
                    </header>
                    <field name="name"/>
                    <field name="incident_date"/>
                    <field name="employee_id"/>
                    <field name="operating_unit_id" optional="show"/>
                    <field name="department_id"/>
                    <field name="job_id" optional="hide"/>
                    <field name="staff_category_display" string="Employment Category" optional="show"/>
                    <field name="violation_type" widget="badge"
                           decoration-danger="violation_type == 'absence_dismissal'"
                           decoration-warning="violation_type == 'absence_prolonged'"
                           decoration-info="violation_type in ('absence_minor', 'late', 'force_checkout')"/>
                    <field name="is_shift_worker" optional="show"/>
                    <field name="absent_days_count" optional="show"/>
                    <field name="max_consecutive_days" optional="show"/>
                    <field name="late_minutes_total" optional="show"/>
                    <field name="punishment_type" optional="show"/>
                    <field name="coach_id" optional="show"/>
                    <field name="director_id" optional="hide"/>
                    <field name="deduction_status" widget="badge" optional="show"
                           decoration-warning="deduction_status == 'scheduled'"
                           decoration-info="deduction_status == 'transferred'"
                           decoration-danger="deduction_status == 'deducted'"
                           decoration-muted="deduction_status in ('not_applicable', 'cancelled')"/>
                    <field name="state" widget="badge"
                           decoration-warning="state in ('coach_review', 'director_review')"
                           decoration-danger="state == 'pomd_review'"
                           decoration-success="state in ('leave_adjusted', 'exonerated')"
                           decoration-info="state == 'enforced'"
                           decoration-muted="state == 'hr_refused'"/>
                </list>
            </field>
        </record>

        <!-- ========================================================================= -->
        <!-- 3. FORM VIEW: Dedicated Attendance Disciplinary Case                      -->
        <!-- ========================================================================= -->
        <record id="view_discipline_attendance_case_form" model="ir.ui.view">
            <field name="name">discipline.attendance.case.form</field>
            <field name="model">discipline.attendance.case</field>
            <field name="arch" type="xml">
                <form string="Attendance Disciplinary Case">
                    <header>
                        <!-- Direct Coach Actions (Minor / Prolonged Track) -->
                        <button name="action_coach_enforce"
                                string="Enforce Penalty (Coach)"
                                type="object"
                                class="btn-primary"
                                invisible="not can_coach_act or violation_type == 'absence_dismissal'"
                                confirm="Enforce this attendance disciplinary sanction and schedule any applicable salary penalty?"/>
                        <button name="action_open_exonerate_wizard"
                                string="Acknowledge / Exonerate"
                                type="object"
                                class="btn-info"
                                invisible="not can_coach_act"/>

                        <!-- Pre-Enforcement Leave Conversion (Available to Employee, Coach, Director, POMD before enforcement) -->
                        <button name="action_open_leave_adjustment_wizard"
                                string="Adjust / Convert Absence to Leave"
                                type="object"
                                class="btn-success"
                                invisible="not can_adjust_by_leave"
                                help="Convert absent days into approved/submitted Time Off (Leave) prior to enforcement."/>
                        <button name="action_recheck_leave_coverage"
                                string="Re-Verify Leave Coverage"
                                type="object"
                                class="btn-secondary"
                                invisible="not can_adjust_by_leave"
                                help="Re-scan employee Time Off records to check if absent dates are now covered by approved leave."/>

                        <!-- Dismissal Absence (>= 5 Consecutive Working Days): Director -> POMD -->
                        <button name="action_director_send_to_pomd"
                                string="Send to POMD for Dismissal Enforcement"
                                type="object"
                                class="btn-warning"
                                invisible="not can_director_act"
                                confirm="Forward this ≥5 consecutive days unexcused absence case to POMD for dismissal enforcement?"/>
                        <button name="action_pomd_enforce_dismissal"
                                string="Enforce Dismissal &amp; Separation (POMD)"
                                type="object"
                                class="btn-danger"
                                invisible="not can_pomd_enforce"
                                confirm="Enforce summary dismissal for ≥5 consecutive unexcused working days? This will archive the employee and deactivate system access."/>

                        <!-- HR / POMD Refusal -->
                        <button name="action_open_hr_refuse_wizard"
                                string="Refuse Case (HR)"
                                type="object"
                                class="btn-danger"
                                invisible="not can_hr_refuse"/>

                        <field name="state" widget="statusbar"
                               statusbar_visible="coach_review,director_review,pomd_review,enforced,leave_adjusted,exonerated"/>
                    </header>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <field name="is_managerial" invisible="1"/>
                        <field name="staff_category" invisible="1"/>
                        <field name="is_case_employee" invisible="1"/>
                        <field name="is_case_coach" invisible="1"/>
                        <field name="is_case_director" invisible="1"/>
                        <field name="is_pomd_or_admin" invisible="1"/>
                        <field name="can_adjust_by_leave" invisible="1"/>
                        <field name="can_coach_act" invisible="1"/>
                        <field name="can_director_act" invisible="1"/>
                        <field name="can_pomd_enforce" invisible="1"/>
                        <field name="can_hr_refuse" invisible="1"/>
                        <field name="payroll_penalty_count" invisible="1"/>

                        <widget name="web_ribbon" title="Adjusted by Leave" bg_color="text-bg-success" invisible="state != 'leave_adjusted'"/>
                        <widget name="web_ribbon" title="Exonerated" bg_color="text-bg-success" invisible="state != 'exonerated'"/>
                        <widget name="web_ribbon" title="Enforced" bg_color="text-bg-primary" invisible="state != 'enforced'"/>
                        <widget name="web_ribbon" title="Refused by HR" bg_color="text-bg-danger" invisible="state != 'hr_refused'"/>

                        <div class="oe_button_box" name="button_box">
                            <button type="object"
                                    name="action_view_payroll_penalties"
                                    class="oe_stat_button"
                                    icon="fa-money"
                                    invisible="payroll_penalty_count == 0">
                                <field name="payroll_penalty_count" widget="statinfo" string="Payroll Penalties"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <!-- Guidance Banners -->
                        <div class="alert alert-danger d-flex align-items-center mb-3" role="alert"
                             invisible="violation_type != 'absence_dismissal' or state not in ('director_review', 'pomd_review')">
                            <i class="fa fa-exclamation-triangle fa-2x me-3 text-danger" title="Dismissal Absence Warning"/>
                            <div>
                                <h5 class="mb-1 font-weight-bold">Dismissal Absence (≥ 5 Consecutive Working Days) — Pre-Enforcement Leave Window Active</h5>
                                <p class="mb-0">
                                    This employee has <strong><field name="max_consecutive_days" readonly="1" class="d-inline"/> consecutive unexcused working days</strong>.
                                    The <strong>Directorate Director</strong> is notified and forwards to <strong>POMD</strong> for dismissal enforcement.
                                    <strong>Before POMD enforces</strong>, the employee (or Coach/Director) may click <strong>Adjust / Convert Absence to Leave</strong> if the absence is covered by valid leave.
                                </p>
                            </div>
                        </div>

                        <group>
                            <group string="Employee &amp; Shift Schedule Profile">
                                <field name="employee_id" readonly="state != 'draft'"/>
                                <field name="operating_unit_id" readonly="1" options="{'no_open': True}"/>
                                <field name="department_id" readonly="1"/>
                                <field name="job_id" readonly="1"/>
                                <field name="staff_category_display" string="Employment Category" readonly="1"/>
                                <field name="is_shift_worker" readonly="1"/>
                                <field name="shift_schedule_summary" readonly="1"/>
                                <field name="coach_id" readonly="state in ('enforced', 'leave_adjusted', 'exonerated', 'hr_refused')"/>
                                <field name="director_id" readonly="state in ('enforced', 'leave_adjusted', 'exonerated', 'hr_refused')"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>

                            <group string="Attendance Breach &amp; Sanction Details">
                                <field name="violation_type" readonly="state != 'draft'"/>
                                <field name="incident_date" readonly="state in ('enforced', 'leave_adjusted', 'exonerated', 'hr_refused')"/>
                                <field name="date_from" readonly="state != 'draft'"/>
                                <field name="date_to" readonly="state != 'draft'"/>
                                <field name="absent_dates_summary" invisible="violation_type in ('late', 'force_checkout')" readonly="1"/>
                                <field name="absent_days_count" invisible="violation_type in ('late', 'force_checkout')" readonly="1"/>
                                <field name="max_consecutive_days" invisible="violation_type in ('late', 'force_checkout')" readonly="1"/>
                                <field name="late_minutes_total" invisible="violation_type != 'late'" readonly="1"/>
                                <field name="late_occurrences_count" invisible="violation_type != 'late'" readonly="1"/>
                                <field name="force_checkout_count" invisible="violation_type != 'force_checkout'" readonly="1"/>
                                <field name="offense_id" readonly="1"/>
                                <field name="severity_level_id" readonly="1"/>
                                <field name="occurrence_count" readonly="1"/>
                                <field name="punishment_type" readonly="state in ('enforced', 'leave_adjusted', 'exonerated', 'hr_refused')"/>
                                <field name="penalty_percentage" invisible="staff_category == 'managerial' or violation_type == 'absence_dismissal'" readonly="1"/>
                                <field name="fine_days" invisible="staff_category != 'managerial' or violation_type == 'absence_dismissal'" readonly="1"/>
                                <field name="deduction_status" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Violation Details &amp; Leave / Justification">
                                <group>
                                    <group string="Leave Adjustment &amp; Coach Justification">
                                        <field name="leave_id" readonly="1"/>
                                        <field name="covered_leave_days" readonly="1"/>
                                        <field name="remaining_unexcused_days" readonly="1"/>
                                        <field name="justification_reason" readonly="state in ('enforced', 'hr_refused')"/>
                                        <field name="exonerated_by_id" invisible="not exonerated_by_id"/>
                                        <field name="exonerated_date" invisible="not exonerated_date"/>
                                    </group>
                                    <group string="Enforcement &amp; HR Refusal Audit">
                                        <field name="enforced_by_id" invisible="not enforced_by_id"/>
                                        <field name="enforced_date" invisible="not enforced_date"/>
                                        <field name="hr_refusal_reason" invisible="not hr_refusal_reason" readonly="1"/>
                                        <field name="refused_by_id" invisible="not refused_by_id"/>
                                        <field name="refused_date" invisible="not refused_date"/>
                                    </group>
                                </group>
                                <separator string="Detailed System Scan Summary"/>
                                <field name="description" readonly="state in ('enforced', 'leave_adjusted', 'exonerated', 'hr_refused')"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ========================================================================= -->
        <!-- 4. SEARCH VIEW & WINDOW ACTION                                            -->
        <!-- ========================================================================= -->
        <record id="view_discipline_attendance_case_search" model="ir.ui.view">
            <field name="name">discipline.attendance.case.search</field>
            <field name="model">discipline.attendance.case</field>
            <field name="arch" type="xml">
                <search string="Search Attendance Disciplinary Cases">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="operating_unit_id"/>
                    <field name="coach_id"/>
                    <field name="director_id"/>
                    <filter name="filter_coach_review" string="Pending Coach Action" domain="[('state', '=', 'coach_review')]"/>
                    <filter name="filter_director_review" string="Pending Director Review (≥5 Days)" domain="[('state', '=', 'director_review')]"/>
                    <filter name="filter_pomd_review" string="Pending POMD Dismissal Enforcement" domain="[('state', '=', 'pomd_review')]"/>
                    <separator/>
                    <filter name="filter_shift_workers" string="Shift / Sunday Roster Workers" domain="[('is_shift_worker', '=', True)]"/>
                    <filter name="filter_dismissal_absence" string="Dismissal Absences (≥5 Days)" domain="[('violation_type', '=', 'absence_dismissal')]"/>
                    <separator/>
                    <filter name="filter_leave_adjusted" string="Adjusted by Leave" domain="[('state', '=', 'leave_adjusted')]"/>
                    <filter name="filter_exonerated" string="Exonerated by Coach" domain="[('state', '=', 'exonerated')]"/>
                    <filter name="filter_enforced" string="Enforced" domain="[('state', '=', 'enforced')]"/>
                    <filter name="filter_hr_refused" string="Refused by HR" domain="[('state', '=', 'hr_refused')]"/>
                    <group>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Violation Type" name="group_by_vtype" context="{'group_by': 'violation_type'}"/>
                        <filter string="Department" name="group_by_dept" context="{'group_by': 'department_id'}"/>
                        <filter string="Direct Coach" name="group_by_coach" context="{'group_by': 'coach_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_discipline_attendance_case" model="ir.actions.act_window">
            <field name="name">Attendance Disciplinary Cases</field>
            <field name="res_model">discipline.attendance.case</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'discipline_scope': True}</field>
            <field name="search_view_id" ref="view_discipline_attendance_case_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Attendance Disciplinary Cases Found
                </p>
                <p>
                    Attendance and absence violations are scanned automatically every night at 01:30 AM (considering Mon–Sat and Sunday shift schedules) or via <strong>Scan Attendance Violations</strong>.
                </p>
            </field>
        </record>

        <!-- Multi-Select Action Menu Bindings for Batch Operations -->
        <record id="action_server_batch_hr_refuse_attendance_cases" model="ir.actions.server">
            <field name="name">Batch Refuse Attendance Cases (HR)</field>
            <field name="model_id" ref="discipline_management.model_discipline_attendance_case"/>
            <field name="binding_model_id" ref="discipline_management.model_discipline_attendance_case"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = records.action_open_hr_refuse_wizard()</field>
        </record>

        <record id="action_server_batch_coach_exonerate_attendance_cases" model="ir.actions.server">
            <field name="name">Batch Acknowledge / Exonerate (Coach)</field>
            <field name="model_id" ref="discipline_management.model_discipline_attendance_case"/>
            <field name="binding_model_id" ref="discipline_management.model_discipline_attendance_case"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = records.action_open_exonerate_wizard()</field>
        </record>

    </data>
</odoo>
