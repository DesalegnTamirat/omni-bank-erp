            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">['|', '|', '|', '|',
                ('employee_id.user_id', '=', user.id),
                ('current_stage_authority_user_id', '=', user.discipline_effective_boss_id.id or 0),
                ('director_id', '=', user.discipline_effective_boss_id.id or 0),
                ('chief_id', '=', user.discipline_effective_boss_id.id or 0),
                ('approver_id', '=', user.discipline_effective_boss_id.id or 0)]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_secretary'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_discipline_attendance_case_secretary_followup" model="ir.rule">
            <field name="name">Discipline Secretary Assigned Boss Attendance Cases Follow-up</field>
            <field name="model_id" ref="discipline_management.model_discipline_attendance_case"/>
