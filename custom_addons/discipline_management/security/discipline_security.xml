<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_discipline_management" model="ir.module.category">
            <field name="name">Discipline Management</field>
            <field name="description">Discipline Management System Access Control</field>
            <field name="sequence">25</field>
        </record>

        <!-- Privilege (Odoo 19: groups are organised under a privilege, not directly under a category) -->
        <record id="res_groups_privilege_discipline" model="res.groups.privilege">
            <field name="name">Discipline Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="discipline_management.module_category_discipline_management"/>
        </record>

        <!-- Group 1: Employee / User (Default for All Internal Users) -->
        <!-- ========================================================================= -->
        <!-- CORE HIERARCHICAL DISCIPLINE ROLES (Rendered in User Form Dropdown)       -->
        <!-- Pure groups: User/Employee, POMD Officer, POMD Director, CPCO, CEO, Admin -->
        <!-- ========================================================================= -->

        <!-- Tier 1: Employee / User (Default for All Internal Users) -->
        <record id="group_discipline_user" model="res.groups">
            <field name="name">User / Employee</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="comment">Default user access: view own disciplinary cases, submit appeals, view self-initiated cases, and participate in cases dynamically across the managerial/coaching hierarchy.</field>
        </record>

        <!-- Automatically imply group_discipline_user for all Internal and Default Users -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
        </record>

        <record id="base.default_user_group" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
        </record>

        <!-- Tier 2: POMD Officer (Operations) -->
        <record id="group_discipline_pomd" model="res.groups">
            <field name="name">POMD Officer</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="comment">People Operations Management Officer: Adjust configurations, refuse, manage documents, policies, reports, case preparation, and operational business support.</field>
        </record>

        <!-- Tier 3: POMD Director (Committee Secretary) -->
        <record id="group_discipline_pomd_director" model="res.groups">
            <field name="name">POMD Director</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_pomd'))]"/>
            <field name="comment">People Operations Management Directorate Director: Disciplinary Committee Secretary, hearing coordination, official minutes recording, notices, and suspension administration.</field>
        </record>

        <!-- Tier 4: Chief People Officer (CPCO / Committee Chairman) -->
        <record id="group_discipline_cpco" model="res.groups">
            <field name="name">CPCO</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_pomd_director'))]"/>
            <field name="comment">Chief People &amp; Culture Officer: Disciplinary Committee Chairperson, managerial suspension authority, and executive appeal review.</field>
        </record>

        <!-- Tier 5: Chief Executive Officer (CEO) -->
        <record id="group_discipline_ceo" model="res.groups">
            <field name="name">CEO</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_cpco'))]"/>
            <field name="comment">Chief Executive Officer: Ultimate bank executive authority, sanction enforcement, and final 4th level appeal review.</field>
        </record>

        <!-- Tier 6: HR Administrator (Full System Configuration & Control) -->
        <record id="group_discipline_admin" model="res.groups">
            <field name="name">HR Administrator</field>
            <field name="sequence">60</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_ceo'))]"/>
            <field name="comment">Full access to discipline configuration, policy versioning, offense catalog, penalty rules, statutory tables, and case revocations.</field>
        </record>

        <!-- ========================================================================= -->
        <!-- DYNAMIC / TECHNICAL ROLES (Hierarchy & Configuration-based)               -->
        <!-- Excluded from UI dropdown (privilege_id = False) to keep dropdown pure    -->
        <!-- ========================================================================= -->

        <record id="group_discipline_manager" model="res.groups">
            <field name="name">Line Manager / Coach (Dynamic)</field>
            <field name="sequence">15</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="comment">Dynamic hierarchy role: Managerial enforcement evaluated dynamically via coach_id / parent_id.</field>
        </record>

        <record id="group_discipline_director" model="res.groups">
            <field name="name">Directorate Director (Dynamic)</field>
            <field name="sequence">22</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="comment">Dynamic hierarchy role: Directorate enforcement and Level 1 appeal review evaluated dynamically via coach_id / parent_id.</field>
        </record>

        <record id="group_discipline_chief" model="res.groups">
            <field name="name">Chief Officer (Dynamic)</field>
            <field name="sequence">35</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="comment">Dynamic hierarchy role: Division executive oversight and Level 2 appeal review evaluated dynamically via coach_id / parent_id.</field>
        </record>

        <record id="group_discipline_auditor" model="res.groups">
            <field name="name">Internal Audit Directorate</field>
            <field name="sequence">70</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="comment">Audit investigations and direct submission of cases to the CEO. Configured in Settings.</field>
        </record>

        <record id="group_discipline_legal" model="res.groups">
            <field name="name">Legal Directorate</field>
            <field name="sequence">75</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="comment">Designated Disciplinary Committee Member for legal review and statutory compliance. Configured in Settings.</field>
        </record>

        <!-- Executive Assistants & Directorate Secretaries (Follow-up & Expiration Prevention) -->
        <record id="group_discipline_secretary" model="res.groups">
            <field name="name">Follow-up / Secretary</field>
            <field name="sequence">15</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="comment">Executive Assistants and Directorate Secretaries (CEO, Audit, CPCO, POMD, Chiefs): Monitor disciplinary case progress, SLA timelines, and statutory prescription deadlines to prevent case expiration.</field>
        </record>

    </data>

    <!-- Record Rules -->
    <data noupdate="0">

        <!-- Universal Employee & Supervisor Rule: View own, self-created, and subordinate cases across hierarchy -->
        <record id="rule_discipline_case_employee" model="ir.rule">
            <field name="name">Employee and Supervisor Disciplinary Cases</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                ('employee_id.user_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('reported_by_id.user_id', '=', user.id),
                ('director_id', '=', user.id),
                ('chief_id', '=', user.id),
                ('reviewer_id', '=', user.id),
                ('employee_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('employee_id.coach_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('reported_by_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('reported_by_id.coach_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('employee_id.coach_id.user_id', '=', user.id),
                ('employee_id.coach_id.coach_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.parent_id.parent_id.user_id', '=', user.id),
                ('reported_by_id.coach_id.user_id', '=', user.id),
                ('reported_by_id.coach_id.coach_id.user_id', '=', user.id),
                ('reported_by_id.parent_id.user_id', '=', user.id),
                ('reported_by_id.parent_id.parent_id.user_id', '=', user.id),
                ('department_id.manager_id.user_id', '=', user.id),
                ('department_id', 'child_of', user.employee_id.department_id.id if (user.employee_id and user.employee_id.department_id and user.employee_id.department_id.manager_id.id == user.employee_id.id) else -1),
                ('employee_id.department_id', 'child_of', user.employee_id.department_id.id if (user.employee_id and user.employee_id.department_id and user.employee_id.department_id.manager_id.id == user.employee_id.id) else -1)
            ]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Governance Roles: View all cases -->
        <record id="rule_discipline_case_governance_all" model="ir.rule">
            <field name="name">Governance Roles All Disciplinary Cases</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [
                ref('discipline_management.group_discipline_auditor'),
                ref('discipline_management.group_discipline_legal'),
                ref('discipline_management.group_discipline_pomd'),
                ref('discipline_management.group_discipline_pomd_director'),
                ref('discipline_management.group_discipline_cpco'),
                ref('discipline_management.group_discipline_ceo'),
                ref('discipline_management.group_discipline_admin'),
            ])]"/>
        </record>

        <!-- Multi-Company Rule -->
        <record id="rule_discipline_case_multi_company" model="ir.rule">
            <field name="name">Disciplinary Case Multi Company</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Appeal Record Rules: View own, supervised, and subordinate appeals across hierarchy -->
        <record id="rule_discipline_appeal_employee" model="ir.rule">
            <field name="name">Employee and Supervisor Disciplinary Appeals</field>
            <field name="model_id" ref="discipline_management.model_discipline_appeal"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                ('employee_id.user_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('reviewer_id', '=', user.id),
                ('designated_reviewer_id', '=', user.id),
                ('case_id.director_id', '=', user.id),
                ('case_id.chief_id', '=', user.id),
                ('case_id.reported_by_id.user_id', '=', user.id),
                ('employee_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('employee_id.coach_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('case_id.employee_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('case_id.employee_id.coach_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('case_id.reported_by_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('case_id.reported_by_id.coach_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('employee_id.coach_id.user_id', '=', user.id),
                ('employee_id.coach_id.coach_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.parent_id.parent_id.user_id', '=', user.id),
                ('case_id.reported_by_id.coach_id.user_id', '=', user.id),
                ('case_id.reported_by_id.coach_id.coach_id.user_id', '=', user.id),
                ('case_id.reported_by_id.parent_id.user_id', '=', user.id),
                ('case_id.reported_by_id.parent_id.parent_id.user_id', '=', user.id),
                ('case_id.department_id.manager_id.user_id', '=', user.id),
                ('case_id.department_id', 'child_of', user.employee_id.department_id.id if (user.employee_id and user.employee_id.department_id and user.employee_id.department_id.manager_id.id == user.employee_id.id) else -1),
                ('employee_id.department_id', 'child_of', user.employee_id.department_id.id if (user.employee_id and user.employee_id.department_id and user.employee_id.department_id.manager_id.id == user.employee_id.id) else -1)
            ]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Governance Roles: View all appeals -->
        <record id="rule_discipline_appeal_governance_all" model="ir.rule">
            <field name="name">Governance Roles All Appeals</field>
            <field name="model_id" ref="discipline_management.model_discipline_appeal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [
                ref('discipline_management.group_discipline_auditor'),
                ref('discipline_management.group_discipline_legal'),
                ref('discipline_management.group_discipline_pomd'),
                ref('discipline_management.group_discipline_pomd_director'),
                ref('discipline_management.group_discipline_cpco'),
                ref('discipline_management.group_discipline_ceo'),
                ref('discipline_management.group_discipline_admin'),
            ])]"/>
        </record>

        <!-- Appeal Multi-Company Rule -->
        <record id="rule_discipline_appeal_multi_company" model="ir.rule">
            <field name="name">Disciplinary Appeal Multi Company</field>
            <field name="model_id" ref="discipline_management.model_discipline_appeal"/>
            <field name="domain_force">['|', ('case_id.company_id', '=', False), ('case_id.company_id', 'in', company_ids)]</field>
        </record>

        <!-- Payroll Penalty Record Rules: Employee sees own penalty, Supervisor sees subordinates, Governance sees all -->
        <record id="rule_discipline_payroll_penalty_employee" model="ir.rule">
            <field name="name">Employee and Supervisor Payroll Penalties</field>
            <field name="model_id" ref="discipline_management.model_discipline_payroll_penalty"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|', '|', '|', '|',
                ('employee_id.user_id', '=', user.id),
                ('case_id.employee_id.user_id', '=', user.id),
                ('case_id.director_id', '=', user.id),
                ('case_id.chief_id', '=', user.id),
                ('case_id.reported_by_id.user_id', '=', user.id),
                ('employee_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('employee_id.coach_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('case_id.employee_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('case_id.reported_by_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('employee_id.coach_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_discipline_payroll_penalty_governance" model="ir.rule">
            <field name="name">Governance All Payroll Penalties</field>
            <field name="model_id" ref="discipline_management.model_discipline_payroll_penalty"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [
                ref('discipline_management.group_discipline_pomd'),
                ref('discipline_management.group_discipline_pomd_director'),
                ref('discipline_management.group_discipline_cpco'),
                ref('discipline_management.group_discipline_ceo'),
                ref('discipline_management.group_discipline_admin'),
            ])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_discipline_payroll_penalty_multi_company" model="ir.rule">
            <field name="name">Disciplinary Payroll Penalty Multi Company</field>
            <field name="model_id" ref="discipline_management.model_discipline_payroll_penalty"/>
            <field name="domain_force">['|', ('case_id.company_id', '=', False), ('case_id.company_id', 'in', company_ids)]</field>
        </record>

        <!-- ========================================================================= -->
        <!-- PRECAUTIONARY SUSPENSION RECORD RULES (Segregation of Duties)             -->
        <!-- ========================================================================= -->

        <!-- Suspension Employee & Supervisor Rule: View own and subordinate suspensions -->
        <record id="rule_discipline_suspension_employee" model="ir.rule">
            <field name="name">Employee and Supervisor Disciplinary Suspensions</field>
            <field name="model_id" ref="discipline_management.model_discipline_suspension"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                ('employee_id.user_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('case_id.director_id', '=', user.id),
                ('case_id.chief_id', '=', user.id),
                ('case_id.reported_by_id.user_id', '=', user.id),
                ('case_id.employee_id.user_id', '=', user.id),
                ('employee_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('employee_id.coach_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('case_id.employee_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('case_id.employee_id.coach_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('case_id.reported_by_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('case_id.reported_by_id.coach_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('employee_id.coach_id.user_id', '=', user.id),
                ('employee_id.coach_id.coach_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.parent_id.parent_id.user_id', '=', user.id),
                ('case_id.reported_by_id.coach_id.user_id', '=', user.id),
                ('case_id.reported_by_id.parent_id.user_id', '=', user.id),
                ('case_id.department_id.manager_id.user_id', '=', user.id),
                ('case_id.department_id', 'child_of', user.employee_id.department_id.id if (user.employee_id and user.employee_id.department_id and user.employee_id.department_id.manager_id.id == user.employee_id.id) else -1)
            ]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Governance Roles: Full access to all suspensions across bank -->
        <record id="rule_discipline_suspension_governance_all" model="ir.rule">
            <field name="name">Governance Roles All Disciplinary Suspensions</field>
            <field name="model_id" ref="discipline_management.model_discipline_suspension"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [
                ref('discipline_management.group_discipline_auditor'),
                ref('discipline_management.group_discipline_legal'),
                ref('discipline_management.group_discipline_pomd'),
                ref('discipline_management.group_discipline_pomd_director'),
                ref('discipline_management.group_discipline_cpco'),
                ref('discipline_management.group_discipline_ceo'),
                ref('discipline_management.group_discipline_admin'),
            ])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Multi-Company Rule for Suspensions -->
        <record id="rule_discipline_suspension_multi_company" model="ir.rule">
            <field name="name">Disciplinary Suspension Multi Company</field>
            <field name="model_id" ref="discipline_management.model_discipline_suspension"/>
            <field name="domain_force">['|', ('case_id.company_id', '=', False), ('case_id.company_id', 'in', company_ids)]</field>
        </record>


        <!-- ========================================================================= -->
        <!-- STAGE-GATED AUDIT INVESTIGATION RECORD RULES (Auditor -> CEO -> CPCO -> POMD) -->
        <!-- ========================================================================= -->

        <!-- 1. Auditor & HR Admin: Full access at all stages -->
        <record id="rule_discipline_investigation_auditor_admin" model="ir.rule">
            <field name="name">Investigation: Auditor &amp; HR Admin Full Access</field>
            <field name="model_id" ref="discipline_management.model_discipline_investigation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [
                ref('discipline_management.group_discipline_auditor'),
                ref('discipline_management.group_discipline_admin'),
            ])]"/>
        </record>

        <!-- 2. CEO: Access once submitted by Auditor (submitted_ceo, forwarded_cpco, approved) -->
        <record id="rule_discipline_investigation_ceo" model="ir.rule">
            <field name="name">Investigation: CEO Access After Audit Submission</field>
            <field name="model_id" ref="discipline_management.model_discipline_investigation"/>
            <field name="domain_force">[('state', 'in', ['submitted_ceo', 'forwarded_cpco', 'approved'])]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_ceo'))]"/>
        </record>

        <!-- 3. CPCO: Access ONLY after CEO forwards to CPCO (forwarded_cpco, approved) -->
        <record id="rule_discipline_investigation_cpco" model="ir.rule">
            <field name="name">Investigation: CPCO Access After CEO Forwards</field>
            <field name="model_id" ref="discipline_management.model_discipline_investigation"/>
            <field name="domain_force">[('state', 'in', ['forwarded_cpco', 'approved'])]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_cpco'))]"/>
        </record>

        <!-- 4. POMD & Legal: Access ONLY after CPCO forwards to POMD (approved) -->
        <record id="rule_discipline_investigation_pomd_legal" model="ir.rule">
            <field name="name">Investigation: POMD &amp; Legal Access After CPCO Release</field>
            <field name="model_id" ref="discipline_management.model_discipline_investigation"/>
            <field name="domain_force">[('state', '=', 'approved')]</field>
            <field name="groups" eval="[(6, 0, [
                ref('discipline_management.group_discipline_pomd'),
                ref('discipline_management.group_discipline_pomd_director'),
                ref('discipline_management.group_discipline_legal'),
            ])]"/>
        </record>

        <!-- 5. User / Employee / Manager: Strictly hidden from Subject Employee & Line Managers; only designated Committee Panel Members can read when approved -->
        <record id="rule_discipline_investigation_user_panel" model="ir.rule">
            <field name="name">Investigation: Committee Panel Read Only (Hidden from Subject Employee &amp; Non-Panel Managers)</field>
            <field name="model_id" ref="discipline_management.model_discipline_investigation"/>
            <field name="domain_force">['&amp;', '&amp;',
                ('state', '=', 'approved'),
                ('employee_id.user_id', '!=', user.id),
                '|',
                ('case_id.committee_meeting_ids.member_ids', 'in', [user.id]),
                ('case_id.committee_meeting_ids.respective_director_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ========================================================================= -->
        <!-- DISCIPLINARY COMMITTEE MEETING RECORD RULES (Confidential Deliberations) -->
        <!-- ========================================================================= -->

        <!-- 1. Governance Roles (CEO, CPCO, POMD, Legal, Auditor, HR Admin): Full access -->
        <record id="rule_discipline_committee_meeting_governance" model="ir.rule">
            <field name="name">Committee Meeting: Governance Roles Access</field>
            <field name="model_id" ref="discipline_management.model_discipline_committee_meeting"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [
                ref('discipline_management.group_discipline_ceo'),
                ref('discipline_management.group_discipline_cpco'),
                ref('discipline_management.group_discipline_pomd'),
                ref('discipline_management.group_discipline_pomd_director'),
                ref('discipline_management.group_discipline_legal'),
                ref('discipline_management.group_discipline_auditor'),
                ref('discipline_management.group_discipline_admin'),
            ])]"/>
        </record>

        <!-- 2. User / Manager: Only designated Committee Panel Members (Never Subject Employee) -->
        <record id="rule_discipline_committee_meeting_panel_member" model="ir.rule">
            <field name="name">Committee Meeting: Designated Panel Members Only (Hidden from Subject Employee)</field>
            <field name="model_id" ref="discipline_management.model_discipline_committee_meeting"/>
            <field name="domain_force">['&amp;',
                ('employee_id.user_id', '!=', user.id),
                '|', '|', '|', '|', '|',
                ('member_ids', 'in', [user.id]),
                ('committee_chair_id', '=', user.id),
                ('pomd_secretary_id', '=', user.id),
                ('legal_director_id', '=', user.id),
                ('respective_director_id', '=', user.id),
                ('labour_union_rep_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ========================================================================= -->
        <!-- DEDICATED ATTENDANCE DISCIPLINARY CASE RECORD RULES                       -->
        <!-- ========================================================================= -->
        <record id="rule_discipline_attendance_case_employee_supervisor" model="ir.rule">
            <field name="name">Attendance Case: Employee, Coach &amp; Director Access</field>
            <field name="model_id" ref="discipline_management.model_discipline_attendance_case"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                ('employee_id.user_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('coach_id', '=', user.id),
                ('director_id', '=', user.id),
                ('employee_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('employee_id.coach_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('employee_id.coach_id.user_id', '=', user.id),
                ('employee_id.coach_id.coach_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.parent_id.parent_id.user_id', '=', user.id),
                ('department_id.manager_id.user_id', '=', user.id),
                ('department_id', 'child_of', user.employee_id.department_id.id if (user.employee_id and user.employee_id.department_id and user.employee_id.department_id.manager_id.id == user.employee_id.id) else -1)
            ]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_discipline_attendance_case_governance" model="ir.rule">
            <field name="name">Attendance Case: Governance &amp; HR Full Access</field>
            <field name="model_id" ref="discipline_management.model_discipline_attendance_case"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [
                ref('discipline_management.group_discipline_auditor'),
                ref('discipline_management.group_discipline_legal'),
                ref('discipline_management.group_discipline_pomd'),
                ref('discipline_management.group_discipline_pomd_director'),
                ref('discipline_management.group_discipline_cpco'),
                ref('discipline_management.group_discipline_ceo'),
                ref('discipline_management.group_discipline_admin'),
            ])]"/>
        </record>

        <!-- ========================================================================= -->
        <!-- EXECUTIVE SECRETARY & FOLLOW-UP RECORD RULES (Read-Only Case Tracking)     -->
