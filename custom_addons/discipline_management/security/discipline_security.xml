<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_discipline_management" model="ir.module.category">
            <field name="name">Discipline Management</field>
            <field name="description">Discipline Management System Access Control</field>
            <field name="sequence">25</field>
        </record>

        <!-- Privilege (Odoo 19: groups are organised under a privilege, not directly under a category) -->
        <record id="res_groups_privilege_discipline" model="res.groups.privilege">
            <field name="name">Discipline Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="discipline_management.module_category_discipline_management"/>
        </record>

        <!-- Group 1: Employee / User (Default for All Internal Users) -->
        <record id="group_discipline_user" model="res.groups">
            <field name="name">User / Employee</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="comment">Default user access: view own disciplinary cases, submit appeals, view self-initiated cases, and enforce discipline on subordinates dynamically.</field>
        </record>

        <!-- Automatically imply group_discipline_user for all Internal Users -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
        </record>

        <!-- Group 2: Internal Audit Directorate -->
        <record id="group_discipline_auditor" model="res.groups">
            <field name="name">Internal Audit Directorate</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="comment">Bank-wide case initiation, audit investigations, and direct submission of cases to the CEO.</field>
        </record>

        <!-- Group 3: Legal Directorate -->
        <record id="group_discipline_legal" model="res.groups">
            <field name="name">Legal Directorate</field>
            <field name="sequence">25</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="comment">Designated Disciplinary Committee Member for legal review, statutory compliance, and voting.</field>
        </record>

        <!-- Group 4: POMD (People Operations Management Directorate) -->
        <record id="group_discipline_pomd" model="res.groups">
            <field name="name">People Operations Management Directorate (POMD)</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="comment">Disciplinary Committee Secretary, minute recording, hearing coordination, and non-managerial suspension execution.</field>
        </record>

        <!-- Group 5: Chief People Officer (CPCO) -->
        <record id="group_discipline_cpco" model="res.groups">
            <field name="name">Chief People Officer (CPCO)</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_pomd'))]"/>
            <field name="comment">Permanent Disciplinary Committee Chairperson, Managerial suspension approval authority, and 2nd Level Appeal reviewer for manager cases.</field>
        </record>

        <!-- Group 6: Chief Executive Officer (CEO) -->
        <record id="group_discipline_ceo" model="res.groups">
            <field name="name">Chief Executive Officer (CEO)</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_cpco'))]"/>
            <field name="comment">Ultimate bank authority for Level 1 dismissal approvals, audit referrals, receiving audit reports, forwarding cases to committee, and final appeal review.</field>
        </record>

        <!-- Group 7: HR Administrator -->
        <record id="group_discipline_admin" model="res.groups">
            <field name="name">HR Administrator</field>
            <field name="sequence">60</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_pomd'))]"/>
            <field name="comment">Full access to discipline configuration, policy versioning, offense catalog, penalty rules, statutory tables, and case revocations.</field>
        </record>

    </data>

    <!-- Record Rules -->
    <data noupdate="0">

        <!-- Universal Employee & Supervisor Rule: View own, self-created, and subordinate cases -->
        <!-- Universal Employee & Supervisor Rule: View own, self-created, and subordinate cases across hierarchy -->
        <record id="rule_discipline_case_employee" model="ir.rule">
            <field name="name">Employee and Supervisor Disciplinary Cases</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                ('employee_id.user_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('reported_by_id.user_id', '=', user.id),
                ('director_id', '=', user.id),
                ('chief_id', '=', user.id),
                ('reviewer_id', '=', user.id),
                ('employee_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('reported_by_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('employee_id.coach_id.user_id', '=', user.id),
                ('employee_id.coach_id.coach_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.parent_id.parent_id.user_id', '=', user.id),
                ('reported_by_id.coach_id.user_id', '=', user.id),
                ('reported_by_id.coach_id.coach_id.user_id', '=', user.id),
                ('reported_by_id.parent_id.user_id', '=', user.id),
                ('reported_by_id.parent_id.parent_id.user_id', '=', user.id),
                ('department_id.manager_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Governance & Directorate Roles: View all cases -->
        <record id="rule_discipline_case_governance_all" model="ir.rule">
            <field name="name">Governance Roles All Disciplinary Cases</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [
                ref('discipline_management.group_discipline_auditor'),
                ref('discipline_management.group_discipline_legal'),
                ref('discipline_management.group_discipline_pomd'),
                ref('discipline_management.group_discipline_cpco'),
                ref('discipline_management.group_discipline_ceo'),
                ref('discipline_management.group_discipline_admin'),
            ])]"/>
        </record>

        <!-- Multi-Company Rule -->
        <record id="rule_discipline_case_multi_company" model="ir.rule">
            <field name="name">Disciplinary Case Multi Company</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Appeal Record Rules: View own, supervised, and subordinate appeals across hierarchy -->
        <record id="rule_discipline_appeal_employee" model="ir.rule">
            <field name="name">Employee and Supervisor Disciplinary Appeals</field>
            <field name="model_id" ref="discipline_management.model_discipline_appeal"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                ('employee_id.user_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('reviewer_id', '=', user.id),
                ('employee_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('case_id.director_id', '=', user.id),
                ('case_id.chief_id', '=', user.id),
                ('case_id.reported_by_id.user_id', '=', user.id),
                ('case_id.reported_by_id', 'child_of', user.employee_id.id if user.employee_id else -1),
                ('employee_id.coach_id.user_id', '=', user.id),
                ('employee_id.coach_id.coach_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.parent_id.parent_id.user_id', '=', user.id),
                ('case_id.reported_by_id.coach_id.user_id', '=', user.id),
                ('case_id.reported_by_id.coach_id.coach_id.user_id', '=', user.id),
                ('case_id.reported_by_id.parent_id.user_id', '=', user.id),
                ('case_id.reported_by_id.parent_id.parent_id.user_id', '=', user.id),
                ('case_id.department_id.manager_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Governance Roles: View all appeals -->
        <record id="rule_discipline_appeal_governance_all" model="ir.rule">
            <field name="name">Governance Roles All Appeals</field>
            <field name="model_id" ref="discipline_management.model_discipline_appeal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [
                ref('discipline_management.group_discipline_auditor'),
                ref('discipline_management.group_discipline_legal'),
                ref('discipline_management.group_discipline_pomd'),
                ref('discipline_management.group_discipline_cpco'),
                ref('discipline_management.group_discipline_ceo'),
                ref('discipline_management.group_discipline_admin'),
            ])]"/>
        </record>

        <!-- Bank-wide Employee Read Access for Discipline Governance Roles -->
        <record id="rule_discipline_hr_employee_read" model="ir.rule">
            <field name="name">Discipline: Bank-wide Employee Read Access</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="groups" eval="[(6, 0, [
                ref('discipline_management.group_discipline_auditor'),
                ref('discipline_management.group_discipline_pomd'),
                ref('discipline_management.group_discipline_legal'),
                ref('discipline_management.group_discipline_cpco'),
                ref('discipline_management.group_discipline_ceo'),
                ref('discipline_management.group_discipline_admin'),
            ])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
