<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_discipline_management" model="ir.module.category">
            <field name="name">Discipline Management</field>
            <field name="description">Discipline Management System Access Control</field>
            <field name="sequence">25</field>
        </record>

        <!-- Privilege (Odoo 19: groups are organised under a privilege, not directly under a category) -->
        <record id="res_groups_privilege_discipline" model="res.groups.privilege">
            <field name="name">Discipline Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="discipline_management.module_category_discipline_management"/>
        </record>

        <!-- Group: Employee / User -->
        <record id="group_discipline_user" model="res.groups">
            <field name="name">User / Employee</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="comment">Can view own disciplinary cases and submit appeals.</field>
        </record>

        <!-- Group: Officer / Investigator -->
        <record id="group_discipline_officer" model="res.groups">
            <field name="name">Officer / Auditor</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="comment">Can record investigation findings, evidence, and initiate cases.</field>
        </record>

        <!-- Group: Audit Directorate (FR-DIS-013/014/026) -->
        <record id="group_discipline_auditor" model="res.groups">
            <field name="name">Audit Directorate</field>
            <field name="sequence">25</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_officer'))]"/>
            <field name="comment">Conducts investigations, records findings, submits to the Disciplinary Committee, and initiates/requests approval of suspensions per FR-DIS-026.</field>
        </record>

        <!-- Group: Manager / Approver -->
        <record id="group_discipline_manager" model="res.groups">
            <field name="name">Manager / Line Manager</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_officer'))]"/>
            <field name="comment">Can initiate cases, review, decide minor/moderate cases, or escalate to Director.</field>
        </record>

        <!-- Group: Directorate Director -->
        <record id="group_discipline_director" model="res.groups">
            <field name="name">Director / Directorate Director</field>
            <field name="sequence">32</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_manager'))]"/>
            <field name="comment">Can review escalated cases, decide &amp; enforce non-dismissals, or escalate to Chief.</field>
        </record>

        <!-- Group: Chief Officer -->
        <record id="group_discipline_chief" model="res.groups">
            <field name="name">Chief / Executive Chief Officer</field>
            <field name="sequence">35</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_director'))]"/>
            <field name="comment">Can decide &amp; enforce non-dismissals, forward to CEO, or forward directly to Audit (with CEO notification).</field>
        </record>

        <!-- Group: People Operations Management Directorate (POMD) -->
        <record id="group_discipline_pomd" model="res.groups">
            <field name="name">People Operations Management Directorate (POMD)</field>
            <field name="sequence">33</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_director'))]"/>
            <field name="comment">Handles and approves suspensions for non-managerial employees per BRD.</field>
        </record>

        <!-- Group: Disciplinary Committee Secretary -->
        <record id="group_discipline_committee_secretary" model="res.groups">
            <field name="name">Disciplinary Committee Secretary</field>
            <field name="sequence">38</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_director'))]"/>
            <field name="comment">Schedules committee meetings, records minutes, and initiates vote collection.</field>
        </record>

        <!-- Group: HR Administrator (Senior Authority) -->
        <record id="group_discipline_admin" model="res.groups">
            <field name="name">HR Administrator</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_chief')), (4, ref('discipline_management.group_discipline_committee_secretary')), (4, ref('discipline_management.group_discipline_pomd'))]"/>
            <field name="comment">Full access to discipline configuration, policies, level 1 dismissal approvals, and case revocations.</field>
        </record>

        <!-- Group: Chief People Officer (CPCO) -->
        <record id="group_discipline_cpco" model="res.groups">
            <field name="name">Chief People Officer (CPCO)</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_admin'))]"/>
            <field name="comment">Disciplinary Committee Chair and final approval authority for non-executive cases.</field>
        </record>

        <!-- Group: Chief Executive Officer (CEO) -->
        <record id="group_discipline_ceo" model="res.groups">
            <field name="name">Chief Executive Officer (CEO)</field>
            <field name="sequence">60</field>
            <field name="privilege_id" ref="discipline_management.res_groups_privilege_discipline"/>
            <field name="implied_ids" eval="[(4, ref('discipline_management.group_discipline_cpco'))]"/>
            <field name="comment">Executive authority receiving Chief/Audit escalations and approving executive dismissals.</field>
        </record>

    </data>

    <!-- Record Rules -->
    <data noupdate="0">

        <!-- Employee: view cases only if part of it -->
        <record id="rule_discipline_case_employee" model="ir.rule">
            <field name="name">Employee Disciplinary Cases (Part of Case Only)</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">['|', '|', ('employee_id.user_id', '=', user.id), ('reported_by_id.user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager Cases: Own Team & Subordinates Only -->
        <record id="rule_discipline_case_manager_team" model="ir.rule">
            <field name="name">Manager Cases (Own Team &amp; Subordinates)</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">['|', '|', '|', '|', '|',
                ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.coach_id.user_id', '=', user.id),
                ('manager_id', '=', user.id),
                ('current_handler_user_id', '=', user.id),
                ('reported_by_id.user_id', '=', user.id),
                ('create_uid', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Director Cases: Directorate & Delegated Hierarchy -->
        <record id="rule_discipline_case_director_dept" model="ir.rule">
            <field name="name">Director Cases (Directorate &amp; Department)</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">['|', '|', '|',
                ('employee_id.department_id.manager_id.user_id', '=', user.id),
                ('director_id', '=', user.id),
                ('current_handler_user_id', '=', user.id),
                ('create_uid', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_director'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Chief Cases: Division / Respective Offices -->
        <record id="rule_discipline_case_chief" model="ir.rule">
            <field name="name">Chief Cases (Division &amp; Assigned)</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">['|', ('chief_id', '=', user.id), ('current_handler_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_chief'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Senior Authorities & Audit: All Cases Across Bank -->
        <record id="rule_discipline_case_senior_all" model="ir.rule">
            <field name="name">Senior Authorities &amp; Audit All Cases</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_admin')), (4, ref('discipline_management.group_discipline_auditor')), (4, ref('discipline_management.group_discipline_cpco')), (4, ref('discipline_management.group_discipline_ceo'))]"/>
        </record>

        <!-- Appeal Rules -->
        <record id="rule_discipline_appeal_employee" model="ir.rule">
            <field name="name">Employee Own Appeals</field>
            <field name="model_id" ref="discipline_management.model_discipline_appeal"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_discipline_appeal_officer_all" model="ir.rule">
            <field name="name">Manager and Above All Appeals</field>
            <field name="model_id" ref="discipline_management.model_discipline_appeal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_manager'))]"/>
        </record>

        <!-- Investigation Rules: Decided cases only for employees -->
        <record id="rule_discipline_investigation_employee" model="ir.rule">
            <field name="name">Employee Decided Case Investigations Only</field>
            <field name="model_id" ref="discipline_management.model_discipline_investigation"/>
            <field name="domain_force">[('case_id.employee_id.user_id', '=', user.id), ('case_id.state', 'in', ['enforced', 'appealed', 'closed', 'revoked'])]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_discipline_investigation_auditor_all" model="ir.rule">
            <field name="name">Audit and Admin All Investigations</field>
            <field name="model_id" ref="discipline_management.model_discipline_investigation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_auditor')), (4, ref('discipline_management.group_discipline_admin'))]"/>
        </record>

        <!-- Committee Meeting Rules: Secretary, CPCO, Admin -->
        <record id="rule_discipline_committee_meeting_authorized" model="ir.rule">
            <field name="name">Committee Authorized Roles Meetings</field>
            <field name="model_id" ref="discipline_management.model_discipline_committee_meeting"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_committee_secretary')), (4, ref('discipline_management.group_discipline_cpco')), (4, ref('discipline_management.group_discipline_admin'))]"/>
        </record>

        <!-- Suspension Rules: Authorized Authorities Only -->
        <record id="rule_discipline_suspension_authorized" model="ir.rule">
            <field name="name">Suspension Authorized Authorities</field>
            <field name="model_id" ref="discipline_management.model_discipline_suspension"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_pomd')), (4, ref('discipline_management.group_discipline_cpco')), (4, ref('discipline_management.group_discipline_ceo')), (4, ref('discipline_management.group_discipline_auditor')), (4, ref('discipline_management.group_discipline_admin'))]"/>
        </record>

        <!-- Multi-Company Rule -->
        <record id="rule_discipline_case_multi_company" model="ir.rule">
            <field name="name">Disciplinary Case Multi Company</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
