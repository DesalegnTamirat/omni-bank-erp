            <field name="domain_force">['|',
                ('employee_id.user_id', '=', user.id),
                ('case_id.current_stage_authority_user_id', '=', user.discipline_effective_boss_id.id or 0)]</field>
            <field name="groups" eval="[(4, ref('discipline_management.group_discipline_secretary'))]"/>
            <field name="perm_read" eval="True"/>
