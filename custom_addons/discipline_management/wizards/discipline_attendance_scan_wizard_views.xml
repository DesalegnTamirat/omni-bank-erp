<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Attendance & Absence Scan Wizard Form (HR Only, Bank-Wide) -->
        <record id="view_discipline_attendance_scan_wizard_form" model="ir.ui.view">
            <field name="name">discipline.attendance.scan.wizard.form</field>
            <field name="model">discipline.attendance.scan.wizard</field>
            <field name="arch" type="xml">
                <form string="Scan Attendance Violations">
                    <group>
                        <field name="skip_existing_active_cases" invisible="1"/>
                        <field name="period_preset" widget="radio"/>
                        <field name="date_from" readonly="period_preset != 'custom'" force_save="1"/>
                        <field name="date_to" readonly="period_preset != 'custom'" force_save="1"/>
                    </group>

                    <footer>
                        <button name="action_scan_and_initiate" 
                                string="Scan &amp; Initiate Disciplinary Cases" 
                                type="object" 
                                class="btn-primary"
                                icon="fa-bolt"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action to open wizard -->
        <record id="action_discipline_attendance_scan_wizard" model="ir.actions.act_window">
            <field name="name">Scan Attendance Violations</field>
            <field name="res_model">discipline.attendance.scan.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
