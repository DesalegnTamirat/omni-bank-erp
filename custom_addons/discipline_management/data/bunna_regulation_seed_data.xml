            <field name="staff_category">non_managerial</field>
            <field name="severity_level_id" ref="severity_level_1"/>
            <field name="statutory_text">አንቀጽ 33.8፡ አንድ ሠራተኛ ከዚህ በታች ከተዘረዘሩት ከባድ ጥፋቶች አንዱን ከፈጸመ ያለምንም ቅድመ ማስጠንቀቂያና የሥራ ስንብት ክፍያ ከስራ ይሰናበታል።</field>
        </record>

        <record id="offense_cba_33_8_1_a" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_8"/>
            <field name="sub_article_code">33.8.1(ሀ)</field>
            <field name="name">የባንኩን ገንዘብ ወይም ንብረት መመዝበር ወይም መስረቅ (Embezzlement or Theft of Funds)</field>
            <field name="category_id" ref="cat_fraud"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">የባንኩን ወይም የደንበኛን ገንዘብ፣ ሰነድ ወይም ንብረት መመዝበር፣ መስረቅ ወይም ለራስ/ለሌላ ጥቅም ማዋል/ማዛወር።</field>
        </record>

        <record id="offense_cba_33_8_1_b" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_8"/>
            <field name="sub_article_code">33.8.1(ለ)</field>
            <field name="name">የሀሰት ሰነድ ወይም መረጃ ማዘጋጀት፣ መጠቀም ወይም ማቅረብ (Forgery &amp; Fraudulent Documents)</field>
            <field name="category_id" ref="cat_fraud"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">የሀሰት ፊርማ፣ ቫውቸር፣ ቼክ፣ ዲክላሬሽን ወይም ማንኛውንም ሀሰተኛ ሰነድ ማዘጋጀት፣ መቀየር ወይም መጠቀም።</field>
        </record>

        <record id="offense_cba_33_8_1_c" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_8"/>
            <field name="sub_article_code">33.8.1(ሐ)</field>
            <field name="name">ጉቦ ወይም ያልተገባ ጥቅም መጠየቅ፣ መቀበል ወይም መስጠት (Bribery &amp; Graft)</field>
            <field name="category_id" ref="cat_fraud"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">ከደንበኛ ወይም ከማንኛውም አካል አገልግሎት ለመስጠት ጉቦ፣ ኮሚሽን ወይም ማንኛውንም ያልተገባ ስጦታ መጠየቅ ወይም መቀበል።</field>
        </record>

        <record id="offense_cba_33_8_1_d" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_8"/>
            <field name="sub_article_code">33.8.1(መ)</field>
            <field name="name">የባንኩን ሲስተም፣ የይለፍ ቃል ወይም ሚስጥር አሳልፎ መስጠት (Core Banking Credential Breach)</field>
            <field name="category_id" ref="cat_fraud"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">የኮር ባንኪንግ ሲስተም የይለፍ ቃል፣ የኦዲት ሎግ፣ የቮልት ወይም ሴፍ ሚስጥራዊ ቁልፍ ለሌላ ሰው አሳልፎ መስጠት ወይም ማጥቃት።</field>
        </record>

        <record id="offense_cba_33_8_1_e" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_8"/>
            <field name="sub_article_code">33.8.1(ሠ)</field>
            <field name="name">የፆታ ትንኮሳ ወይም አስገድዶ መድፈር መፈጸም (Sexual Harassment / Assault)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">በሥራ ባልደረባ ወይም ደንበኛ ላይ የፆታ ትንኮሳ፣ ማስገደድ ወይም አስነዋሪ ወሲባዊ ጥቃት መፈጸም።</field>
        </record>


        <!-- ARTICLE 33.9: ከጥሬ ገንዘብ ልዩነት ጋር በተያያዘ ቅጣት የሚያሰጡ ጥፋቶች (Cash Shortages) -->
        <record id="art_cba_33_9" model="discipline.article">
            <field name="article_number">Article 33.9</field>
            <field name="name">ከጥሬ ገንዘብ ልዩነት (ጉድለት) ጋር በተያያዘ ቅጣት የሚያሰጡ ጥፋቶች (Cash Shortage Misconduct)</field>
            <field name="policy_version_id" ref="policy_cba_ch8"/>
            <field name="staff_category">non_managerial</field>
            <field name="severity_level_id" ref="severity_level_5"/>
            <field name="statutory_text">አንቀጽ 33.9፡ ከጥሬ ገንዘብ አያያዝና አከፋፈል ጋር በተገናኘ የተጣሰ የባንኩ የውስጥ የአሰራር መመሪያ መኖሩ ሲረጋገጥ በተለይ በቆጠራ ስህተት ለሚከሰት የጥሬ ገንዘብ ልዩነት (ጉድለት) ከገንዘብ ጋር በተገናኘ የስራ መደብ ላይ ተመድበው የሚሰሩ ሰራተኞች ያጋጠመውን የገንዘብ ጉድለት ከመተካት በተጨማሪ በገንዘብ መጠኑና በድግግሞሹ መሰረት የዲሲፕሊን ቅጣት እርምጃ ይወሰድባቸዋል።</field>
        </record>

        <record id="offense_cba_33_9_cash_shortage" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_9"/>
            <field name="sub_article_code">33.9</field>
            <field name="name">የጥሬ ገንዘብ ጉድለት ወይም የቆጠራ ልዩነት መፍጠር (Cash Shortage / Difference Misconduct)</field>
            <field name="category_id" ref="cat_property"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">article_override</field>
            <field name="full_clause_text">በጥሬ ገንዘብ አያያዝና ክፍያ ሂደት ውስጥ በቸልተኝነት ወይም በቆጠራ ስህተት የገንዘብ ጉድለት ማድረስ (በአንቀጽ 33.9 የጥሬ ገንዘብ ልዩነት ሰንጠረዥ መሰረት የሚወሰን)።</field>
        </record>


