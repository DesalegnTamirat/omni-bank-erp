            <field name="sub_article_code">33.7.1(ለ)</field>
            <field name="name">በባንኩ ግቢ በስካር ወይም አደንዛዥ እፅ ተጽእኖ ስር መገኘት (Intoxication / Substance Abuse)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">በባንኩ የስራ ሰዓት ወይም ግቢ ውስጥ በስካር፣ አደንዛዥ እፅ ወይም ጫት ተጽእኖ ስር ሆኖ መገኘት።</field>
        </record>

        <record id="offense_cba_33_7_1_c" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_7"/>
            <field name="sub_article_code">33.7.1(ሐ)</field>
            <field name="name">የስራ ባልደረባ ወይም የበላይ ኃላፊን መደብደብ ወይም ማዋረድ (Physical Assault at Workplace)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">በባንኩ ቅጥር ጊቢ ወይም ስራ በሚከናወንበት ወቅት በስራ ባልደረባ ወይም የበላይ ኃላፊ ላይ አካላዊ ጥቃት መፈጸም ወይም ለመደብደብ መሞከር።</field>
        </record>


        <!-- ARTICLE 33.8: ያለማስጠንቀቂያ ከስራ የሚያሰናብቱ ከባድ ጥፋቶች (Dismissal Offenses) -->
        <record id="art_cba_33_8" model="discipline.article">
            <field name="article_number">Article 33.8</field>
