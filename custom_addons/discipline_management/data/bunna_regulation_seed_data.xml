        <!-- ======================================================== -->
        <!-- 1. POLICY VERSION DOCUMENTS                              -->
        <!-- ======================================================== -->

        <!-- Non-Managerial: CBA Chapter 8 -->
        <record id="policy_cba_ch8" model="discipline.policy.version">
            <field name="name">Bunna Bank Collective Bargaining Agreement (የህብረት ስምምነት)</field>
            <field name="version_number">CBA-CH8-2024</field>
            <field name="staff_category">non_managerial</field>
            <field name="chapter_reference">ምዕራፍ ስምንት - የስነ ስርዓት(ዲሲፕሊን) እርምጃ</field>
            <field name="effective_date">2024-01-01</field>
            <field name="state">active</field>
            <field name="description">የቡና ባንክ አ.ማ እና የቡና ባንክ የሰራተኞች መሰረታዊ ማህበር የህብረት ስምምነት ምዕራፍ ስምንት የስነ-ስርዓት ድንጋጌዎች (አንቀጽ 33.1 - 33.13)።</field>
        </record>

        <!-- Managerial: Chapter X Policy -->
        <record id="policy_managerial_ch10" model="discipline.policy.version">
            <field name="name">Bunna Bank Managerial Staff Discipline Policy</field>
            <field name="version_number">MGR-CH10-2024</field>
            <field name="staff_category">managerial</field>
            <field name="chapter_reference">Chapter X - Disciplinary Measures for Managerial Staff</field>
            <field name="effective_date">2024-01-01</field>
            <field name="state">active</field>
            <field name="description">Human Resource Management Policy Chapter X: Disciplinary Rules, Penalties, and Dismissal Clauses for Managerial and Supervisory Staff (Articles 10.1 - 10.9).</field>
        </record>


        <!-- ======================================================== -->
        <!-- 2. OFFENSE CATEGORIES                                    -->
        <!-- ======================================================== -->

        <record id="cat_attendance" model="discipline.offense.category">
            <field name="name">Attendance &amp; Punctuality Misconduct</field>
            <field name="code">ATT</field>
            <field name="description">Latecoming, leaving office without permission, absence without good cause.</field>
        </record>

        <record id="cat_conduct" model="discipline.offense.category">
            <field name="name">General Conduct &amp; Professional Ethics</field>
            <field name="code">CND</field>
            <field name="description">Personal hygiene, attire, insubordination, evaluation refusal, workplace demeanor.</field>
        </record>

        <record id="cat_property" model="discipline.offense.category">
            <field name="name">Bank Property &amp; Operational Negligence</field>
            <field name="code">PRP</field>
            <field name="description">Negligent property damage, failure to report accidents, unauthorized property utilization.</field>
        </record>

        <record id="cat_supervisory" model="discipline.offense.category">
            <field name="name">Supervisory &amp; Managerial Control Failures</field>
            <field name="code">SUP</field>
            <field name="description">Lack of supervision, operational override breaches, failure to implement audit findings.</field>
        </record>

        <record id="cat_fraud" model="discipline.offense.category">
            <field name="name">Fraud, Corruption &amp; Gross Breach of Trust</field>
            <field name="code">FRD</field>
            <field name="description">Embezzlement, bribery, forgery, core banking security breach, conflict of interest.</field>
        </record>


        <!-- ======================================================== -->
        <!-- 3. NON-MANAGERIAL ARTICLES & OFFENSES (CBA CHAPTER 8)    -->
        <!-- ======================================================== -->

        <!-- ARTICLE 33.4: የቃል ማስጠንቀቂያ (Verbal Warning) -->
        <record id="art_cba_33_4" model="discipline.article">
            <field name="article_number">Article 33.4</field>
            <field name="name">የቃል ማስጠንቀቂያ እርምጃ የሚያስከትሉ ጥፋቶች (Verbal Warning Offenses)</field>
            <field name="policy_version_id" ref="policy_cba_ch8"/>
            <field name="staff_category">non_managerial</field>
            <field name="severity_level_id" ref="severity_level_5"/>
            <field name="statutory_text">አንቀጽ 33.4፡ አንድ ሠራተኛ ከዚህ በታች ከተዘረዘሩት ጥፋቶች አንዱን ወይም ተቀራራቢውን ፈጽሞ ከተገኘ እንደ ጥፋቱ ክብደትና ሁኔታ የቃል ማስጠንቀቂያ ይሰጠዋል።</field>
        </record>

        <record id="offense_cba_33_4_1_a" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_4"/>
            <field name="sub_article_code">33.4.1(ሀ)</field>
            <field name="name">በሥራ ቦታ ላይ ተገቢ ያልሆነ አለባበስ መልበስ (Inappropriate Attire)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">በሥራ ቦታ ላይ የባንኩን የስራ ባህሪና ክብር የማይመጥን ተገቢ ያልሆነ አለባበስ ለብሶ መገኘት።</field>
        </record>

        <record id="offense_cba_33_4_1_b" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_4"/>
            <field name="sub_article_code">33.4.1(ለ)</field>
            <field name="name">ተገቢ ባልሆነ ሁኔታ ተገኝቶ ሲገሰጽ ተገቢ ያልሆነ ፀባይ ማሳየት (Improper Demeanor Upon Admonition)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">ተገቢ ባልሆነ ሁኔታ ተገኝቶ በቅርብ ኃላፊው ወይም በክትትል አካላት ሲገሰጽ ተገቢ ያልሆነ ፀባይ ማሳየት።</field>
        </record>

        <record id="offense_cba_33_4_1_c" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_4"/>
            <field name="sub_article_code">33.4.1(ሐ)</field>
            <field name="name">የስራ ባልደረባን ማስቀየም ወይም መሳደብ (Offending or Insulting Colleagues)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">በስራ ቦታ ላይ የስራ ባልደረባን ማስቀየም፣ ማዋረድ ወይም መሳደብ።</field>
        </record>

        <record id="offense_cba_33_4_1_d" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_4"/>
            <field name="sub_article_code">33.4.1(መ)</field>
            <field name="name">በሥራ ሰዓት ድምጽ በማሰማት ወይም ስልክ በመጠቀም ለሥራ መሰናክል መፍጠር (Workplace Disturbance)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">በሥራ ሰዓት ከፍተኛ ድምጽ በማሰማት፣ ቪዲዮ/ሙዚቃ በመክፈት ወይም ሞባይል ስልክ ያለአግባብ በመጠቀም ለሥራና ለደንበኞች መሰናክል መፍጠር።</field>
        </record>

        <record id="offense_cba_33_4_1_e" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_4"/>
            <field name="sub_article_code">33.4.1(ሠ)</field>
            <field name="name">ለደንበኞች ያልተገባ ወይም አስነዋሪ ቃል መጠቀም (Improper Language with Customers)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">ለባንኩ ደንበኞች ያልተገባ፣ ያልተከበረ ወይም አስነዋሪ ቃል መጠቀም።</field>
        </record>


        <!-- ARTICLE 33.5: የመጀመሪያ የጽሁፍ ማስጠንቀቂያና የደመወዝ ቅጣት (First Written Warning) -->
        <record id="art_cba_33_5" model="discipline.article">
            <field name="article_number">Article 33.5</field>
            <field name="name">የመጀመሪያ የጽሁፍ ማስጠንቀቂያና የደመወዝ ቅጣት የሚያስከትሉ ጥፋቶች (First Written Warning &amp; Fine Offenses)</field>
            <field name="policy_version_id" ref="policy_cba_ch8"/>
            <field name="staff_category">non_managerial</field>
            <field name="severity_level_id" ref="severity_level_4"/>
            <field name="statutory_text">አንቀጽ 33.5፡ አንድ ሠራተኛ ከዚህ በታች ከተዘረዘሩት ጥፋቶች አንዱን ወይም ተቀራራቢውን ፈጽሞ ከተገኘ የመጀመሪያ የጽሁፍ ማስጠንቀቂያና የ1 ቀን ደመወዝ ቅጣት ይሰጠዋል።</field>
        </record>

        <record id="offense_cba_33_5_1_a" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_5"/>
            <field name="sub_article_code">33.5.1(ሀ)</field>
            <field name="name">የቃል ማስጠንቀቂያ ከተሰጠ በኋላ ጥፋት መድገም (Repetition After Verbal Warning)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">የቃል ማስጠንቀቂያ ከተሰጠበት ቀን ጀምሮ ባለው 1 ወር ጊዜ ውስጥ ተመሳሳይ ወይም ሌላ የቃል ማስጠንቀቂያ ጥፋት መድገም።</field>
        </record>

        <record id="offense_cba_33_5_1_b" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_5"/>
            <field name="sub_article_code">33.5.1(ለ)</field>
            <field name="name">ከሥራ ሰዓት ውጭ ያለፈቃድ በባንኩ ህንጻ ውስጥ መገኘት (Unauthorized Presence Outside Hours)</field>
            <field name="category_id" ref="cat_attendance"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">ከሥራ ሰዓት ውጭ ያለበላይ ኃላፊ ፈቃድ በባንኩ ቢሮ ወይም ህንጻ ውስጥ መገኘት።</field>
        </record>

        <record id="offense_cba_33_5_1_c" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_5"/>
            <field name="sub_article_code">33.5.1(ሐ)</field>
            <field name="name">የባንኩን መታወቂያ ካርድ አለማድረግ ወይም ለሌላ አሳልፎ መስጠት (Misuse of Employee ID)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">በባንኩ ግቢ ውስጥ የስራ መታወቂያ ካርድ አለማድረግ ወይም ለሌላ ሶስተኛ ወገን አሳልፎ መስጠት።</field>
        </record>

        <record id="offense_cba_33_5_1_d" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_5"/>
            <field name="sub_article_code">33.5.1(መ)</field>
            <field name="name">በስራ ሰዓት ያለፈቃድ ከስራ ገበታ ውጪ መገኘት (Away From Workstation Without Permission)</field>
            <field name="category_id" ref="cat_attendance"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">በስራ ሰዓት ያለቅርብ ኃላፊ ፈቃድ ከስራ ገበታ ርቆ መገኘት ወይም ቢሮን ጥሎ መሄድ።</field>
        </record>

        <record id="offense_cba_33_5_1_e" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_5"/>
            <field name="sub_article_code">33.5.1(ሠ)</field>
            <field name="name">የተሰጠውን መመሪያ ወይም ደንብ በቸልተኝነት አለማክበር (Negligent Disregard of Directives)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">የባንኩን መመሪያዎች፣ ሰርኩላሮች ወይም የቅርብ ኃላፊ ህጋዊ የስራ መመሪያ በቸልተኝነት አለማክበር።</field>
        </record>


        <!-- ARTICLE 33.6: የሁለተኛ የጽሁፍ ማስጠንቀቂያና የደመወዝ ቅጣት (Second Written Warning) -->
        <record id="art_cba_33_6" model="discipline.article">
            <field name="article_number">Article 33.6</field>
            <field name="name">የሁለተኛ የጽሁፍ ማስጠንቀቂያና የደመወዝ ቅጣት የሚያስከትሉ ጥፋቶች (Second Written Warning &amp; Fine Offenses)</field>
            <field name="policy_version_id" ref="policy_cba_ch8"/>
            <field name="staff_category">non_managerial</field>
            <field name="severity_level_id" ref="severity_level_3"/>
            <field name="statutory_text">አንቀጽ 33.6፡ አንድ ሠራተኛ ከዚህ በታች ከተዘረዘሩት ጥፋቶች አንዱን ወይም ተቀራራቢውን ፈጽሞ ከተገኘ የሁለተኛ የጽሁፍ ማስጠንቀቂያና የ3 ቀናት ደመወዝ ቅጣት ይሰጠዋል።</field>
        </record>

        <record id="offense_cba_33_6_1_a" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_6"/>
            <field name="sub_article_code">33.6.1(ሀ)</field>
            <field name="name">የመጀመሪያ የጽሁፍ ማስጠንቀቂያ ከተሰጠ በኋላ ጥፋት መድገም (Repetition After 1st Written Warning)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">የመጀመሪያ የጽሁፍ ማስጠንቀቂያ ከተሰጠበት ቀን ጀምሮ ባለው 3 ወራት ጊዜ ውስጥ ጥፋት መድገም።</field>
        </record>

        <record id="offense_cba_33_6_1_b" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_6"/>
            <field name="sub_article_code">33.6.1(ለ)</field>
            <field name="name">ለደንበኞች ሆን ተብሎ የተዛባ መረጃ መስጠት (Intentionally Misleading Customers)</field>
            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">ለደንበኞች ሆን ተብሎ የተዛባ፣ ያልተሟላ ወይም ሀሰተኛ መረጃ በመስጠት ቅሬታ መፍጠር።</field>
        </record>

        <record id="offense_cba_33_6_1_c" model="discipline.offense">
            <field name="article_id" ref="art_cba_33_6"/>
            <field name="sub_article_code">33.6.1(ሐ)</field>
