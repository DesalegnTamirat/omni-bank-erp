            <field name="category_id" ref="cat_conduct"/>
            <field name="staff_category">non_managerial</field>
            <field name="penalty_mode">level_default</field>
            <field name="full_clause_text">የሁለተኛ የጽሁፍ ማስጠንቀቂያ ከተሰጠበት ቀን ጀምሮ ባለው 6 ወራት ጊዜ ውስጥ ጥፋት መድገም።</field>
        </record>

        <record id="offense_cba_33_7_1_b" model="discipline.offense">
