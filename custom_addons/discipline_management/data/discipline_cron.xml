<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Check SLA Timelines and Escalate Breached Cases -->
        <!-- DIS-11: nextcall pinned to 02:00 server-time (off-peak) -->
        <record id="ir_cron_discipline_case_sla_check" model="ir.cron">
            <field name="name">Discipline Management: SLA Timeline Check &amp; Escalation</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_sla_escalations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=2, minute=0, second=0)"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Check Suspension Expiry Timelines -->
        <!-- DIS-11: pinned to 02:15 to stagger execution -->
        <record id="ir_cron_discipline_suspension_expiry_check" model="ir.cron">
            <field name="name">Discipline Management: Suspension Expiry Notification</field>
            <field name="model_id" ref="discipline_management.model_discipline_suspension"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_suspension_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=2, minute=15, second=0)"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Check Appeal Submission Windows -->
        <!-- DIS-11: pinned to 02:30 to stagger execution -->
        <record id="ir_cron_discipline_appeal_window_check" model="ir.cron">
            <field name="name">Discipline Management: Appeal Submission Window Enforcement</field>
            <field name="model_id" ref="discipline_management.model_discipline_case"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_appeal_window_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=2, minute=30, second=0)"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
