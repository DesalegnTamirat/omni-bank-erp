<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Offense Categories -->
        <record id="offense_cat_attendance" model="discipline.offense.category">
            <field name="name">Attendance &amp; Punctuality Misconduct</field>
            <field name="code">ATT</field>
            <field name="description">Unexcused absences, tardiness, job abandonment, falsification of attendance records.</field>
        </record>

        <record id="offense_cat_conduct" model="discipline.offense.category">
            <field name="name">Professional Conduct &amp; Ethics</field>
            <field name="code">ETH</field>
            <field name="description">Insubordination, harassment, breach of confidentiality, conflict of interest, workplace violence.</field>
        </record>

        <record id="offense_cat_financial" model="discipline.offense.category">
            <field name="name">Financial &amp; Operational Irregularity</field>
            <field name="code">FIN</field>
            <field name="description">Fraud, embezzlement, unauthorized transactions, cash shortage, negligence causing bank financial loss.</field>
        </record>

        <!-- Standard Offense Levels -->
        <record id="offense_level_1_dismissal" model="discipline.offense">
            <field name="name">Level 1: Critical Misconduct (Dismissal)</field>
            <field name="category_id" ref="offense_cat_financial"/>
            <field name="severity_level">level_1</field>
            <field name="punishment_type">dismissal</field>
            <field name="penalty_percentage">0.0</field>
            <field name="approval_authority">executive</field>
            <field name="description">Critical offense resulting in immediate employee separation, total system access revocation, and legal referral if applicable.</field>
        </record>

        <record id="offense_level_2_final_warning" model="discipline.offense">
            <field name="name">Level 2: Very High Misconduct (Final Written Warning + 20% Penalty)</field>
            <field name="category_id" ref="offense_cat_conduct"/>
            <field name="severity_level">level_2</field>
            <field name="punishment_type">final_warning_penalty</field>
            <field name="penalty_percentage">20.0</field>
            <field name="approval_authority">hr_manager</field>
            <field name="description">Severe misconduct resulting in Final Written Warning and 20% monthly salary penalty deduction.</field>
        </record>

        <record id="offense_level_3_second_warning" model="discipline.offense">
            <field name="name">Level 3: High Misconduct (Second Written Warning + 10% Penalty)</field>
            <field name="category_id" ref="offense_cat_conduct"/>
            <field name="severity_level">level_3</field>
            <field name="punishment_type">second_warning_penalty</field>
            <field name="penalty_percentage">10.0</field>
            <field name="approval_authority">hr_manager</field>
            <field name="description">High misconduct resulting in Second Written Warning and 10% monthly salary penalty deduction.</field>
        </record>

        <record id="offense_level_4_first_warning" model="discipline.offense">
            <field name="name">Level 4: Moderate Misconduct (First Written Warning + 5% Penalty)</field>
            <field name="category_id" ref="offense_cat_attendance"/>
            <field name="severity_level">level_4</field>
            <field name="punishment_type">first_warning_penalty</field>
            <field name="penalty_percentage">5.0</field>
            <field name="approval_authority">direct_manager</field>
            <field name="description">Moderate misconduct resulting in First Written Warning and 5% monthly salary penalty deduction.</field>
        </record>

        <record id="offense_level_5_verbal_warning" model="discipline.offense">
            <field name="name">Level 5: Minor Misconduct (Recorded Verbal Warning)</field>
            <field name="category_id" ref="offense_cat_attendance"/>
            <field name="severity_level">level_5</field>
            <field name="punishment_type">verbal_warning</field>
            <field name="penalty_percentage">0.0</field>
            <field name="approval_authority">direct_manager</field>
            <field name="description">Minor offense resulting in recorded formal verbal warning without financial penalty.</field>
        </record>
    </data>
</odoo>
