<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="severity_level_1" model="discipline.severity.level">
            <field name="name">Level 1 (Critical - Dismissal)</field>
            <field name="code">level_1</field>
            <field name="sequence">1</field>
            <field name="is_dismissal">1</field>
            <field name="default_punishment_type">dismissal</field>
            <field name="default_penalty_percentage">0.0</field>
            <field name="default_approval_authority">executive</field>
            <field name="description">Critical gross misconduct entailing immediate dismissal or separation under Bank Regulation Art 10.1.7 and 10.5.</field>
        </record>

        <record id="severity_level_2" model="discipline.severity.level">
            <field name="name">Level 2 (Very High - Final Written Warning + 20% Penalty)</field>
            <field name="code">level_2</field>
            <field name="sequence">2</field>
            <field name="is_dismissal">0</field>
            <field name="default_punishment_type">final_warning_penalty</field>
            <field name="default_penalty_percentage">20.0</field>
            <field name="default_approval_authority">hr_manager</field>
            <field name="description">Very high severity breach entailing final written warning and up to 20% salary penalty under Bank Regulation Art 10.4.</field>
        </record>

        <record id="severity_level_3" model="discipline.severity.level">
            <field name="name">Level 3 (High - Second Written Warning + 10% Penalty)</field>
            <field name="code">level_3</field>
            <field name="sequence">3</field>
            <field name="is_dismissal">0</field>
            <field name="default_punishment_type">second_warning_penalty</field>
            <field name="default_penalty_percentage">10.0</field>
            <field name="default_approval_authority">hr_manager</field>
            <field name="description">High severity breach entailing second written warning and up to 10% salary penalty under Bank Regulation Art 10.4.</field>
        </record>

        <record id="severity_level_4" model="discipline.severity.level">
            <field name="name">Level 4 (Moderate - First Written Warning + 5% Penalty)</field>
            <field name="code">level_4</field>
            <field name="sequence">4</field>
            <field name="is_dismissal">0</field>
            <field name="default_punishment_type">first_warning_penalty</field>
            <field name="default_penalty_percentage">5.0</field>
            <field name="default_approval_authority">direct_manager</field>
            <field name="description">Moderate breach entailing first written warning and 5% salary penalty under Bank Regulation Art 10.4.</field>
        </record>

        <record id="severity_level_5" model="discipline.severity.level">
            <field name="name">Level 5 (Minor - Recorded Verbal Warning)</field>
            <field name="code">level_5</field>
            <field name="sequence">5</field>
            <field name="is_dismissal">0</field>
            <field name="default_punishment_type">verbal_warning</field>
            <field name="default_penalty_percentage">0.0</field>
            <field name="default_approval_authority">direct_manager</field>
            <field name="description">Minor breach entailing recorded oral/verbal warning under Bank Regulation Art 10.4.</field>
        </record>
    </data>
</odoo>
