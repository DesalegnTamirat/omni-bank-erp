            <field name="default_managerial_fine_days">3.0</field>
            <field name="default_reset_window_months">12</field>
            <field name="active_duration_days">365</field>
            <field name="default_approval_authority">direct_manager</field>
            <field name="description">Very high severity breach entailing final written warning + 20% salary penalty (Non-Managerial) or 3 days wage deduction (Managerial).</field>
        </record>

        <record id="severity_level_3" model="discipline.severity.level">
