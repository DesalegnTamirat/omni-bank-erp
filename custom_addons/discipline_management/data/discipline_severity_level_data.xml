            <field name="default_approval_authority">direct_manager</field>
            <field name="description">High severity breach entailing second written warning + 10% salary penalty (Non-Managerial) or 2 days wage deduction (Managerial).</field>
        </record>

        <record id="severity_level_4" model="discipline.severity.level">
