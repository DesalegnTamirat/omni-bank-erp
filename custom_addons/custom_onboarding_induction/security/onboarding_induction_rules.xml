<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================ -->
        <!-- RECORD RULES: Corporate Induction Plans (hr.induction.plan) -->
        <!-- ============================================================ -->

        <!-- 1. Employee / Coach: See only own records or coachee records -->
        <record id="rule_hr_induction_plan_user" model="ir.rule">
            <field name="name">Corporate Induction: Employee / Coach (Own Records)</field>
            <field name="model_id" ref="model_hr_induction_plan"/>
            <field name="groups" eval="[(4, ref('group_onboarding_induction_user'))]"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id', 'in', user.employee_ids.ids),
                ('employee_id.coach_id.user_id', '=', user.id),
                ('employee_id.coach_id', 'in', user.employee_ids.ids),
                ('supervisor_id.user_id', '=', user.id),
                ('supervisor_id', 'in', user.employee_ids.ids),
                ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- 2. Officer & Administrator: Full Access to all induction records -->
        <record id="rule_hr_induction_plan_officer_admin" model="ir.rule">
            <field name="name">Corporate Induction: Officer &amp; Administrator (All Records)</field>
            <field name="model_id" ref="model_hr_induction_plan"/>
            <field name="groups" eval="[(4, ref('group_onboarding_induction_officer')), (4, ref('group_onboarding_induction_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

