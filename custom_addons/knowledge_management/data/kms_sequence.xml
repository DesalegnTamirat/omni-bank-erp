<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for Governed Documents -->
        <record id="seq_kms_document" model="ir.sequence">
            <field name="name">KMS Governed Document Reference</field>
            <field name="code">kms.document</field>
            <field name="prefix">KMS/DOC/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Lessons Learned -->
        <record id="seq_kms_lesson_learned" model="ir.sequence">
            <field name="name">KMS Lesson Learned Reference</field>
            <field name="code">kms.lesson.learned</field>
            <field name="prefix">KMS/LL/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
