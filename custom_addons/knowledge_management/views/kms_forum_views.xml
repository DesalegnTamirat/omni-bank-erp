<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================= -->
        <!-- FORUM TOPICS LIST VIEW                                    -->
        <!-- ========================================================= -->
        <record id="view_kms_forum_topic_list" model="ir.ui.view">
            <field name="name">kms.forum.topic.list</field>
            <field name="model">kms.forum.topic</field>
            <field name="arch" type="xml">
                <list string="Knowledge Questions &amp; Discussions" decoration-success="is_solved">
                    <field name="name" string="Question / Topic"/>
                    <field name="category_id"/>
                    <field name="cop_id" optional="show"/>
                    <field name="author_id" widget="many2one_avatar_employee"/>
                    <field name="post_count" string="Replies"/>
                    <field name="upvote_count" string="Upvotes"/>
                    <field name="is_solved" string="Answered" widget="boolean_toggle"/>
                    <field name="state" widget="badge" decoration-success="state == 'solved'" decoration-info="state == 'open'" decoration-muted="state == 'closed'"/>
                </list>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- FORUM TOPIC FORM VIEW                                     -->
        <!-- ========================================================= -->
        <record id="view_kms_forum_topic_form" model="ir.ui.view">
            <field name="name">kms.forum.topic.form</field>
            <field name="model">kms.forum.topic</field>
            <field name="arch" type="xml">
                <form string="Knowledge Topic / Question">
                    <header>
                        <button name="action_upvote" string="Upvote Question (+1)" type="object" class="btn-outline-primary" icon="fa-thumbs-up"/>
                        <button name="action_close" string="Close Discussion" type="object" class="btn-secondary" invisible="state == 'closed'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Solved" bg_color="text-bg-success" invisible="not is_solved"/>
                        <div class="oe_title">
                            <label for="name" string="Question / Topic Title"/>
                            <h1><field name="name" placeholder="e.g. How do we treat collateral valuation overrides under latest directive?"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="category_id" options="{'no_create': True}"/>
                                <field name="cop_id" options="{'no_create': True}"/>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </group>
                            <group>
                                <field name="author_id" widget="many2one_avatar_employee"/>
                                <field name="upvote_count" readonly="1"/>
                                <field name="is_pinned"/>
                            </group>
                        </group>
                        <group string="Question Description &amp; Details">
                            <field name="content"/>
                        </group>
                        <notebook>
                            <page string="Answers &amp; Solutions">
                                <field name="post_ids">
                                    <list>
                                        <field name="author_id" widget="many2one_avatar_employee"/>
                                        <field name="create_date" string="Date"/>
                                        <field name="upvote_count" string="Upvotes"/>
                                        <field name="is_accepted" widget="badge" decoration-success="is_accepted"/>
                                        <button name="action_accept_solution" string="Mark as Solution" type="object" icon="fa-check" invisible="is_accepted"/>
                                        <button name="action_upvote" string="Upvote" type="object" icon="fa-thumbs-up"/>
                                    </list>
                                    <form string="Answer / Reply">
                                        <sheet>
                                            <group>
                                                <field name="author_id" widget="many2one_avatar_employee"/>
                                                <field name="is_accepted" readonly="1"/>
                                                <field name="upvote_count" readonly="1"/>
                                            </group>
                                            <field name="content" placeholder="Type your detailed answer or insight here..."/>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- ACTIONS                                                   -->
        <!-- ========================================================= -->
        <record id="action_kms_forum_topic_all" model="ir.actions.act_window">
            <field name="name">Q&amp;A Knowledge Exchange</field>
            <field name="res_model">kms.forum.topic</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
