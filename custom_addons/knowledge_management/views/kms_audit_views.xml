<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================= -->
        <!-- AUDIT LOG LIST VIEW                                       -->
        <!-- ========================================================= -->
        <record id="view_kms_audit_log_list" model="ir.ui.view">
            <field name="name">kms.audit.log.list</field>
            <field name="model">kms.audit.log</field>
            <field name="arch" type="xml">
                <list string="Activity Audit Logs" create="0" delete="0" edit="0">
                    <field name="create_date" string="Timestamp"/>
                    <field name="action" widget="badge" decoration-danger="action == 'access_denied'" decoration-info="action == 'view'" decoration-success="action == 'download'" decoration-warning="action in ('modify', 'upload', 'archive')"/>
                    <field name="user_id"/>
                    <field name="employee_id" widget="many2one_avatar_employee"/>
                    <field name="department_id" optional="show"/>
                    <field name="operating_unit_id" optional="show"/>
                    <field name="resource_type" widget="badge"/>
                    <field name="resource_name"/>
                    <field name="details"/>
                </list>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- AUDIT LOG SEARCH VIEW                                     -->
        <!-- ========================================================= -->
        <record id="view_kms_audit_log_search" model="ir.ui.view">
            <field name="name">kms.audit.log.search</field>
            <field name="model">kms.audit.log</field>
            <field name="arch" type="xml">
                <search string="Search Audit Trail">
                    <field name="user_id"/>
                    <field name="employee_id"/>
                    <field name="resource_name"/>
                    <field name="action"/>
                    <filter name="filter_downloads" string="Downloads Only" domain="[('action', '=', 'download')]"/>
                    <filter name="filter_access_denied" string="Denied Access Events" domain="[('action', '=', 'access_denied')]"/>
                    <separator/>
                    <group>
                        <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                        <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                        <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- ACTIONS                                                   -->
        <!-- ========================================================= -->
        <record id="action_kms_audit_log_all" model="ir.actions.act_window">
            <field name="name">Audit &amp; Compliance Activity Trail</field>
            <field name="res_model">kms.audit.log</field>
            <field name="view_mode">list</field>
            <field name="search_view_id" ref="view_kms_audit_log_search"/>
        </record>

    </data>
</odoo>
