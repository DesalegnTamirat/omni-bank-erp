<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_knowledge_management" model="ir.module.category">
            <field name="name">Knowledge Management</field>
            <field name="description">Bunna Bank Knowledge Management System (KMS) Access Control</field>
            <field name="sequence">27</field>
        </record>

        <!-- Privilege -->
        <record id="res_groups_privilege_kms" model="res.groups.privilege">
            <field name="name">Knowledge Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="knowledge_management.module_category_knowledge_management"/>
        </record>

        <!-- 1. Group: Employee / User (Default for all internal users) -->
        <record id="group_kms_employee" model="res.groups">
            <field name="name">User / Employee</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="knowledge_management.res_groups_privilege_kms"/>
            <field name="comment">Can view approved policies/SOPs, browse digital library, participate in CoP discussions, and search expert directory.</field>
        </record>

        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_kms_employee'))]"/>
        </record>

        <!-- 2. Group: SME / Contributor -->
        <record id="group_kms_contributor" model="res.groups">
            <field name="name">SME / Knowledge Contributor</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="knowledge_management.res_groups_privilege_kms"/>
            <field name="implied_ids" eval="[(4, ref('knowledge_management.group_kms_employee'))]"/>
            <field name="comment">Can draft new policies/SOPs, author lessons learned, deliver tacit capture sessions, and curate digital library assets.</field>
        </record>

        <!-- 3. Group: Department Reviewer / Approver -->
        <record id="group_kms_reviewer" model="res.groups">
            <field name="name">Reviewer / Approver</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="knowledge_management.res_groups_privilege_kms"/>
            <field name="implied_ids" eval="[(4, ref('knowledge_management.group_kms_contributor'))]"/>
            <field name="comment">Can review and approve department policies, SOPs, and validate lessons learned.</field>
        </record>

        <!-- 4. Group: KMS Administrator / Knowledge Officer -->
        <record id="group_kms_manager" model="res.groups">
            <field name="name">KMS Administrator / Officer</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="knowledge_management.res_groups_privilege_kms"/>
            <field name="implied_ids" eval="[(4, ref('knowledge_management.group_kms_reviewer'))]"/>
            <field name="comment">Full administrative oversight: taxonomy management, version overrides, audit reporting, and security configuration.</field>
        </record>

        <!-- 5. Group: Internal Audit & Compliance Reviewer -->
        <record id="group_kms_auditor" model="res.groups">
            <field name="name">Auditor / Compliance Officer</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="knowledge_management.res_groups_privilege_kms"/>
            <field name="implied_ids" eval="[(4, ref('knowledge_management.group_kms_employee'))]"/>
            <field name="comment">Compliance audit view: read-only access to all active and archived documents, changelogs, and immutable audit logs.</field>
        </record>

    </data>
</odoo>
