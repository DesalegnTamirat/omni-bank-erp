<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ========================================================= -->
        <!-- KMS DOCUMENT RECORD RULES                                 -->
        <!-- ========================================================= -->

        <!-- 1. Employee: Can view approved documents based on classification hierarchy -->
        <!--
            Intended Boolean Structure:
            classification in ('public', 'internal')
            OR (classification = 'confidential' AND (department_id = False OR department_id = user.employee_id.department_id.id))
            OR (classification = 'restricted' AND authorized_employee_ids.user_id = user.id)
        -->
        <record id="rule_kms_document_employee_read" model="ir.rule">
            <field name="name">Employee View Documents by Classification</field>
            <field name="model_id" ref="knowledge_management.model_kms_document"/>
            <field name="groups" eval="[(4, ref('knowledge_management.group_kms_employee'))]"/>
            <field name="domain_force">['|',
    ('classification', 'in', ['public', 'internal']),
    '|',
        '&amp;',
            ('classification', '=', 'confidential'),
            '|',
                ('department_id', '=', False),
                ('department_id', '=', user.employee_id.department_id.id),
        '&amp;',
            ('classification', '=', 'restricted'),
            ('authorized_employee_ids.user_id', '=', user.id)
]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 2. Contributor: Can create and edit own draft documents -->
        <record id="rule_kms_document_contributor_write" model="ir.rule">
            <field name="name">Contributor Manage Own Draft Documents</field>
            <field name="model_id" ref="knowledge_management.model_kms_document"/>
            <field name="groups" eval="[(4, ref('knowledge_management.group_kms_contributor'))]"/>
            <field name="domain_force">[('owner_id.user_id', '=', user.id), ('state', 'in', ['draft', 'review'])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 3. Reviewer: Can review department documents -->
        <record id="rule_kms_document_reviewer" model="ir.rule">
            <field name="name">Reviewer Manage Department Documents</field>
            <field name="model_id" ref="knowledge_management.model_kms_document"/>
            <field name="groups" eval="[(4, ref('knowledge_management.group_kms_reviewer'))]"/>
            <field name="domain_force">['|', ('department_id', '=', False), ('department_id', '=', user.employee_id.department_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 4. Manager: Full global document access -->
        <record id="rule_kms_document_manager" model="ir.rule">
            <field name="name">KMS Manager Full Document Access</field>
            <field name="model_id" ref="knowledge_management.model_kms_document"/>
            <field name="groups" eval="[(4, ref('knowledge_management.group_kms_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 5. Auditor: Read-only access to all documents -->
        <record id="rule_kms_document_auditor" model="ir.rule">
            <field name="name">Auditor All Documents Read-Only</field>
            <field name="model_id" ref="knowledge_management.model_kms_document"/>
            <field name="groups" eval="[(4, ref('knowledge_management.group_kms_auditor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ========================================================= -->
        <!-- KMS AUDIT LOG RECORD RULES                                -->
        <!-- ========================================================= -->

        <!-- Employee: Can view only own audit trail -->
        <record id="rule_kms_audit_log_employee" model="ir.rule">
            <field name="name">Employee View Own Audit Logs</field>
            <field name="model_id" ref="knowledge_management.model_kms_audit_log"/>
            <field name="groups" eval="[(4, ref('knowledge_management.group_kms_employee'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager & Auditor: Can view all audit records -->
        <record id="rule_kms_audit_log_admin_auditor" model="ir.rule">
            <field name="name">Admin and Auditor All Audit Logs</field>
            <field name="model_id" ref="knowledge_management.model_kms_audit_log"/>
            <field name="groups" eval="[(4, ref('knowledge_management.group_kms_manager')), (4, ref('knowledge_management.group_kms_auditor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
