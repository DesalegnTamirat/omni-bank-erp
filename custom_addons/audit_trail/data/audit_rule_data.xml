<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Default audit rules for the most critical models.
            Admins can add more from Audit > Configuration > Audit Rules.
        -->

        <!-- Users & Access -->
        <record id="rule_res_users" model="audit.rule">
            <field name="name">Users</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="log_create">True</field>
            <field name="log_write">True</field>
            <field name="log_unlink">True</field>
        </record>

        <record id="rule_res_groups" model="audit.rule">
            <field name="name">Security Groups</field>
            <field name="model_id" ref="base.model_res_groups"/>
            <field name="log_create">True</field>
            <field name="log_write">True</field>
            <field name="log_unlink">True</field>
        </record>

        <!-- Partners / Contacts -->
        <record id="rule_res_partner" model="audit.rule">
            <field name="name">Partners / Contacts</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="log_create">True</field>
            <field name="log_write">True</field>
            <field name="log_unlink">True</field>
        </record>

        <!-- Company -->
        <record id="rule_res_company" model="audit.rule">
            <field name="name">Companies</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="log_create">True</field>
            <field name="log_write">True</field>
            <field name="log_unlink">False</field>
        </record>

    </data>
</odoo>
