<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client action that loads the OWL dashboard -->
    <record id="action_audit_dashboard_client" model="ir.actions.client">
        <field name="name">Audit Dashboard</field>
        <field name="tag">audit_trail.audit_dashboard</field>
    </record>

    <!-- Standard list action for detailed log view -->
    <record id="action_audit_log_dashboard" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">audit.log</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_audit_log_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No audit logs found.</p>
            <p>Logs appear here once audit rules are active and users perform actions.</p>
        </field>
    </record>

    <!-- Pivot view -->
    <record id="view_audit_log_pivot" model="ir.ui.view">
        <field name="name">audit.log.pivot</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <pivot string="Audit Summary">
                <field name="module"    type="row"/>
                <field name="operation" type="col"/>
                <field name="id"        type="measure" string="Count"/>
            </pivot>
        </field>
    </record>

    <!-- Graph view -->
    <record id="view_audit_log_graph" model="ir.ui.view">
        <field name="name">audit.log.graph</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <graph string="Audit Activity" type="bar" stacked="True">
                <field name="create_date" type="row" interval="day"/>
                <field name="operation"   type="col"/>
            </graph>
        </field>
    </record>

    <!-- Search view with today filter -->
    <record id="view_audit_log_search" model="ir.ui.view">
        <field name="name">audit.log.search</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <search string="Search Audit Logs">
                <field name="user_name"/>
                <field name="module"/>
                <field name="res_name"   string="Record Name"/>
                <field name="operation"/>
                <separator/>
                <filter name="today"
                        string="Today"
                        domain="[('create_date','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="this_week"
                        string="This week"
                        domain="[('create_date','&gt;=', (context_today()-datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month"
                        string="This month"
                        domain="[('create_date','&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter name="filter_create" string="Creates" domain="[('operation','=','create')]"/>
                <filter name="filter_write"  string="Updates" domain="[('operation','=','write')]"/>
                <filter name="filter_unlink" string="Deletes" domain="[('operation','=','unlink')]"/>
                <separator/>
                <filter name="group_by_module"    string="Module"    context="{'group_by':'module'}"/>
                <filter name="group_by_model"     string="Model"     context="{'group_by':'model_description'}"/>
                <filter name="group_by_operation" string="Operation" context="{'group_by':'operation'}"/>
                <filter name="group_by_user"      string="User"      context="{'group_by':'user_id'}"/>
                <filter name="group_by_date"      string="Date"      context="{'group_by':'create_date:day'}"/>
            </search>
        </field>
    </record>

    <!-- NOTE: No menuitem records here — all menus are defined in audit_menu.xml -->

</odoo>