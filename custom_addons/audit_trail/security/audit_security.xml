<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_audit" model="ir.module.category">
            <field name="name">Audit Trail</field>
            <field name="sequence">100</field>
        </record>

        <record id="privilege_audit_access" model="res.groups.privilege">
            <field name="name">Audit Access</field>
            <field name="category_id" ref="module_category_audit"/>
        </record>

        <record id="group_audit_user" model="res.groups">
            <field name="name">Audit / Viewer</field>
            <field name="privilege_id" ref="privilege_audit_access"/>
        </record>

        <record id="group_audit_manager" model="res.groups">
            <field name="name">Audit / Manager</field>
            <field name="privilege_id" ref="privilege_audit_access"/>
            <field name="implied_ids" eval="[(4, ref('group_audit_user'))]"/>
        </record>
    </data>
</odoo>




