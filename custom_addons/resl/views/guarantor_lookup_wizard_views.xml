<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_resl_guarantor_lookup" model="ir.actions.act_window">
            <field name="name">Find Guarantor</field>
            <field name="res_model">resl.guarantor.lookup</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="view_resl_guarantor_lookup_form" model="ir.ui.view">
            <field name="name">resl.guarantor.lookup.form</field>
            <field name="model">resl.guarantor.lookup</field>
            <field name="arch" type="xml">
                <form string="Find Employee as Guarantor">
                    <sheet>
                        <div class="alert alert-warning d-flex align-items-center" role="alert"
                            invisible="not notice">
                            <i class="fa fa-users me-2" title="Guarantors"/>
                            <span><field name="notice" readonly="1" nolabel="1" class="d-inline"/></span>
                        </div>
                        <group>
                            <field name="loan_id" invisible="1"/>
                            <field name="loan_created_here" invisible="1"/>
                            <field name="pre_agreed" invisible="1"/>
                            <field name="borrower_id" invisible="1"/>
                            <!-- Picking an employee here adds him/her to the list
                                 below straight away (onchange). Nothing is saved:
                                 the request only becomes a draft when the requester
                                 clicks Save or "Select as Guarantor". -->
                            <field name="employee_id" string="Select Employee"
                                placeholder="Select an employee..."
                                domain="[('active', '=', True), ('id', '!=', borrower_id)]"
                                context="{'resl_sudo_search': True}"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        </group>
                        <separator string="Guarantors" colspan="2"/>
                        <!-- Technical fields (kept so the selected guarantors are
                             loaded and sent back to the server). -->
                        <field name="line_ids" invisible="1">
                            <list>
                                <field name="name"/>
                                <field name="job_title"/>
                                <field name="eligibility_note"/>
                            </list>
                        </field>
                        <!-- ONE table: guarantor(s) already selected first, then the
                             candidate picked above on the next row, with its own
                             Select as Guarantor button on that same line. -->
                        <div class="o_list_renderer" invisible="not sel1_name and not employee_id">
                            <table class="o_list_table table table-sm w-100">
                                <thead>
                                    <tr>
                                        <th>Employee Name</th>
                                        <th>Job Title</th>
                                        <th>Eligible</th>
                                        <th>Status / Reason</th>
                                        <th/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="table-success fw-bold" invisible="not sel1_name">
                                        <td><field name="sel1_name" nolabel="1" readonly="1"/></td>
                                        <td><field name="sel1_job_title" nolabel="1" readonly="1"/></td>
                                        <td/>
                                        <td><field name="sel1_note" nolabel="1" readonly="1"/></td>
                                        <td/>
                                    </tr>
                                    <tr class="table-success fw-bold" invisible="not sel2_name">
                                        <td><field name="sel2_name" nolabel="1" readonly="1"/></td>
                                        <td><field name="sel2_job_title" nolabel="1" readonly="1"/></td>
                                        <td/>
                                        <td><field name="sel2_note" nolabel="1" readonly="1"/></td>
                                        <td/>
                                    </tr>
                                    <tr invisible="not employee_id">
                                        <td><field name="cand_name" nolabel="1" readonly="1"
                                            decoration-success="cand_is_eligible"
                                            decoration-danger="not cand_is_eligible"/></td>
                                        <td><field name="cand_job_title" nolabel="1" readonly="1"
                                            decoration-success="cand_is_eligible"
                                            decoration-danger="not cand_is_eligible"/></td>
                                        <td><field name="cand_is_eligible" nolabel="1" readonly="1"/></td>
                                        <td><field name="cand_note" nolabel="1" readonly="1"
                                            decoration-success="cand_is_eligible"
                                            decoration-danger="not cand_is_eligible"/></td>
                                        <td class="text-end">
                                            <button name="action_select_guarantor" type="object"
                                                string="Select as Guarantor" class="btn-primary"
                                                invisible="not cand_is_eligible"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <footer>
                            <button name="action_clear" type="object"
                                string="Clear" class="btn-default"/>
                            <button name="action_close" type="object" string="Close" class="btn-secondary"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_resl_guarantor_lookup_line_tree" model="ir.ui.view">
            <field name="name">resl.guarantor.lookup.line.list</field>
            <field name="model">resl.guarantor.lookup.line</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="job_title"/>
                    <button name="action_select" type="object" string="Select"/>
                </list>
            </field>
        </record>

    </data>
</odoo>