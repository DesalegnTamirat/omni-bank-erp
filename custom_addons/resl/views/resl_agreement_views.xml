<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agreement buttons / banners on the loan form.
         Guarantor : accepts/rejects first, then agrees as the guarantor.
         Requester : agrees as the borrower after all guarantors accepted + agreed.
         Approver  : signs before approving.
         Everyone else with access can open the agreement to read it. -->
    <record id="view_resl_loan_form_agreement" model="ir.ui.view">
        <field name="name">resl.loan.form.agreement</field>
        <field name="model">resl.loan</field>
        <field name="inherit_id" ref="resl.view_resl_loan_form"/>
        <field name="arch" type="xml">

            <!-- Hidden fields for the buttons below and for the Find Guarantor widget -->
            <xpath expr="//field[@name='is_employee_user']" position="after">
                <field name="agr_borrower_complete" invisible="1"/>
                <field name="agr_can_open" invisible="1"/>
                <field name="agr_role" invisible="1"/>
                <field name="agr_todo" invisible="1"/>
                <field name="agr_view_pending" invisible="1"/>
                <field name="agr_pre_agreed" invisible="1"/>
                <field name="agr_can_print" invisible="1"/>
            </xpath>

            <!-- The "Nominate Replacement Guarantor" header button is not used -->
            <xpath expr="//button[@name='action_nominate_replacement']" position="replace"/>

            <!-- Guarantor: Accept / Reject are available immediately; the agreement is agreed AFTER accepting -->

            <!-- Next-step banners -->
            <xpath expr="//header" position="after">
                <div class="alert alert-danger d-flex align-items-center justify-content-between my-2" role="alert"
                     invisible="not agr_view_pending">
                    <div>
                        <i class="fa fa-file-text-o me-2" style="font-size:1.2rem;"/>
                        <strong>Review required:</strong> open and read the <strong>Loan Agreement</strong>
                        before you request or do the disbursement.
                    </div>
                    <button name="action_open_agreement" type="object" string="Open Agreement"
                            class="btn btn-danger btn-sm fw-bold" icon="fa-file-text-o"/>
                </div>
                <!-- New, unsaved request: nothing is saved until Save is pressed
                     or a guarantor is selected. The borrower agrees from the
                     "Agreement (Borrower)" button, which creates nothing. -->
                <div class="alert alert-info my-2" role="alert"
                     invisible="agr_role != 'requester' or agr_todo or status != 'draft'">
                    <i class="fa fa-info-circle me-2"/>
                    Use <strong>Find Guarantor</strong> to select your guarantor. The guarantor must
                    <strong>accept</strong> and agree the agreement first; you will be notified, then agree it as the borrower.
                </div>
                <div class="alert alert-warning d-flex align-items-center justify-content-between my-2" role="alert"
                     invisible="agr_role != 'requester' or not agr_todo or not agr_can_open">
                    <div>
                        <i class="fa fa-pencil-square-o me-2" style="font-size:1.2rem;"/>
                        <strong>Your guarantor(s) have accepted.</strong> Open the <strong>Loan Agreement (Borrower)</strong> and press
                        <strong>Agree and continue</strong>, then submit to the manager.
                    </div>
                    <button name="action_open_agreement" type="object" string="Agreement (Borrower)"
                            class="btn btn-warning btn-sm fw-bold" icon="fa-pencil-square-o"/>
                </div>
                <div class="alert alert-warning d-flex align-items-center justify-content-between my-2" role="alert"
                     invisible="agr_role != 'guarantor' or not agr_todo">
                    <div>
                        <i class="fa fa-pencil-square-o me-2" style="font-size:1.2rem;"/>
                        <strong>Next step:</strong> you accepted this guarantee. Open the agreement and press
                        <strong>Agree and continue</strong> as the guarantor. The requestor is then notified.
                    </div>
                    <button name="action_open_agreement" type="object" string="Agreement (Guarantor)"
                            class="btn btn-warning btn-sm fw-bold" icon="fa-pencil-square-o"/>
                </div>
            </xpath>

            <!-- "Replace Guarantor" must not show for a guarantor (guarantor page) -->
            <xpath expr="(//button[@name='action_request_replacement'])[1]" position="attributes">
                <attribute name="invisible">agr_role == 'guarantor' or not has_replaceable_guarantor or not employee_active or not is_eligible or not is_employee_user or status not in ('draft','guarantor_pending','manager_review')</attribute>
            </xpath>
            <xpath expr="(//button[@name='action_request_replacement'])[2]" position="attributes">
                <attribute name="invisible">agr_role == 'guarantor' or not has_replaceable_guarantor or not can_ho_replace or (is_employee_user and employee_active and is_eligible and status in ('draft','guarantor_pending','manager_review')) or (is_employee_user and status not in ('draft','guarantor_pending','manager_review'))</attribute>
            </xpath>

            <!-- Header buttons -->
            <xpath expr="//button[@name='action_submit_manager']" position="before">
                <!-- New, unsaved request: agree as the borrower without saving anything -->
                <widget name="resl_agreement_new_button" groups="base.group_user"/>
                <!-- Approvers / admin: print the agreement -->
                <button name="action_print_agreement" type="object"
                    string="Print Agreement" icon="fa-print" class="btn-secondary"
                    groups="base.group_user"
                    invisible="not agr_can_print"/>
                <button name="action_open_agreement" type="object"
                    string="Agreement (Borrower)" icon="fa-pencil-square-o" class="btn-primary"
                    groups="base.group_user"
                    invisible="agr_role != 'requester' or not agr_todo or not agr_can_open"/>
                <button name="action_open_agreement" type="object"
                    string="Agreement (Guarantor)" icon="fa-pencil-square-o" class="btn-primary"
                    groups="base.group_user"
                    invisible="agr_role != 'guarantor' or not agr_todo"/>
                <button name="action_open_agreement" type="object"
                    string="Agreement (Approver)" icon="fa-pencil-square-o" class="btn-primary"
                    groups="base.group_user"
                    invisible="agr_role != 'approver' or not agr_todo"/>
                <button name="action_open_agreement" type="object"
                    string="Agreement" icon="fa-file-text-o" class="btn-secondary"
                    groups="base.group_user"
                    invisible="not agr_can_open or agr_todo"/>
            </xpath>
        </field>
    </record>

    <data noupdate="1">
    <record id="param_resl_agreement_required" model="ir.config_parameter">
        <field name="key">resl.agreement_required</field>
        <field name="value">1</field>
    </record>
    </data>
</odoo>