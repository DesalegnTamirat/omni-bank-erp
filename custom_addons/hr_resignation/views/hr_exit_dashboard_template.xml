<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hr_resignation.custom_exit_dashboard_template">
        &lt;!DOCTYPE html&gt;
        <html lang="en">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
            <title>Exit Interview Analytics &amp; Report</title>
            <style>
            :root{--bg:#f4f6f8;--card:#fff;--ink:#14212b;--mut:#5d6b78;--line:#e2e7ec;--acc:#0f766e;--acc2:#b45309;--soft:#e6f3f1;
            --c1:#b91c1c;--c2:#ea580c;--c3:#ca8a04;--c4:#65a30d;--c5:#15803d;--pos:#15803d;--neu:#94a3b8;--neg:#b91c1c;
            box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
            @media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e161d;--card:#16212b;--ink:#e8eef3;--mut:#93a3b1;--line:#263442;--acc:#2dd4bf;--acc2:#fbbf24;--soft:#12302e}}
            :root[data-theme="dark"]{--bg:#0e161d;--card:#16212b;--ink:#e8eef3;--mut:#93a3b1;--line:#263442;--acc:#2dd4bf;--acc2:#fbbf24;--soft:#12302e}
            html{scroll-padding-top:env(safe-area-inset-top,0px)}
            *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
            .top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--card);border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:10px 20px}
            .top h1{font-size:16px;margin:0 auto 0 0}.tabs{display:flex;gap:4px;background:var(--bg);padding:3px;border-radius:9px}
            .tabs button,.btn{font:inherit;border:0;background:none;color:var(--mut);padding:7px 14px;border-radius:7px;cursor:pointer;font-weight:600}
            .tabs button.on{background:var(--card);color:var(--acc);box-shadow:0 1px 3px #0002}
            .btn{background:var(--acc);color:#fff}
            main{max-width:1180px;margin:0 auto;padding:18px 20px 40px}
            .filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px;align-items:center}
            .filters select{font:inherit;background:var(--card);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:6px 10px}
            .lock{margin-left:auto;font-size:12px;color:var(--mut);background:var(--soft);padding:5px 10px;border-radius:99px}
            .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px}
            .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin-bottom:14px}
            .card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}
            .card h3{margin:0 0 2px;font-size:14px}.tag{font-size:11px;color:var(--acc);font-weight:700;letter-spacing:.04em;text-transform:uppercase}
            .sub{color:var(--mut);font-size:12px;margin:0 0 12px}.w2{grid-column:span 2}@media(max-width:720px){.w2{grid-column:auto}}
            .kpi b{display:block;font-size:26px}.kpi span{color:var(--mut);font-size:12px}.up{color:var(--pos)}.dn{color:var(--neg)}
            .br{display:grid;grid-template-columns:38% 1fr 40px;gap:8px;align-items:center;margin:6px 0;font-size:13px}
            .br i{height:9px;background:var(--line);border-radius:9px;overflow:hidden}.br b{display:block;height:100%;background:var(--acc)}
            .br.a b{background:var(--acc2)}.br em{font-style:normal;text-align:right;color:var(--mut)}
            .donut{display:flex;gap:16px;align-items:center;flex-wrap:wrap}.ring{width:120px;height:120px;border-radius:50%;flex:none;-webkit-mask:radial-gradient(circle 38px,#0000 98%,#000);mask:radial-gradient(circle 38px,#0000 98%,#000)}
            .lg div{display:flex;gap:6px;align-items:center;font-size:12px;margin:3px 0}.lg s{width:10px;height:10px;border-radius:3px;display:inline-block}
            .lk{display:grid;grid-template-columns:34% 1fr 34px;gap:8px;align-items:center;margin:8px 0;font-size:13px}
            .st{display:flex;height:14px;border-radius:5px;overflow:hidden}.st u{display:block}
            .yn{display:grid;grid-template-columns:1fr 130px 40px;gap:8px;align-items:center;margin:8px 0}.yn i{display:flex;height:9px;border-radius:9px;overflow:hidden;background:var(--neg)}.yn b{background:var(--pos)}
            table{border-collapse:collapse;width:100%;font-size:12px}th{font-weight:600;color:var(--mut);text-align:center;padding:4px}td{padding:3px}td:first-child{text-align:left;font-size:13px}
            td.h{text-align:center;color:#fff;font-weight:700;border:2px solid var(--card);border-radius:6px}
            .chips{display:flex;flex-wrap:wrap;gap:6px}.chips span{background:var(--soft);color:var(--acc);border-radius:99px;padding:3px 10px;font-size:12px}
            .chips span small{color:var(--mut);margin-left:4px}
            .q{border-left:3px solid var(--acc2);padding:2px 10px;margin:8px 0;color:var(--mut);font-style:italic;font-size:13px}
            svg text{fill:var(--mut);font-size:10px}
            /* ---------- report ---------- */
            .paper{background:#fff;color:#111;max-width:794px;margin:0 auto;padding:36px 40px;border:1px solid #ccd;border-radius:4px;box-shadow:0 4px 20px #0002}
            .paper h1{font-size:20px;margin:0}.paper h2{font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:#0f766e;border-bottom:2px solid #0f766e;padding-bottom:3px;margin:20px 0 8px}
            .rh{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid #ccd;padding-bottom:12px}
            .rh small{color:#555}.stamp{border:1.5px solid #b91c1c;color:#b91c1c;padding:3px 8px;font-size:10px;font-weight:700;border-radius:4px;letter-spacing:.06em}
            .meta{display:grid;grid-template-columns:repeat(4,1fr);gap:8px 14px;margin:12px 0}.meta div{font-size:12px}.meta span{display:block;color:#666;font-size:10px;text-transform:uppercase}
            .qq{margin:10px 0;break-inside:avoid;font-size:12.5px}.qq p{margin:0 0 4px;font-weight:600}.qq p em{font-style:normal;font-weight:400;color:#777;font-size:10px;margin-left:6px;border:1px solid #ccd;border-radius:4px;padding:0 5px}
            .opt{display:inline-flex;align-items:center;gap:5px;margin:2px 12px 2px 0}.opt s{width:12px;height:12px;border:1.5px solid #555;border-radius:50%;display:inline-block}.opt.sq s{border-radius:3px}.opt.on s{background:#0f766e;border-color:#0f766e;box-shadow:inset 0 0 0 2px #fff}.opt.on{font-weight:700}
            .opt.sq.on s{box-shadow:none}
            .scale{display:flex;gap:6px;align-items:center}.scale s{width:22px;height:22px;border-radius:50%;border:1.5px solid #aaa;display:inline-grid;place-items:center;font-size:10px;color:#777}.scale s.on{background:#0f766e;color:#fff;border-color:#0f766e;font-weight:700}
            .paper table th,.paper table td{border:1px solid #dde;padding:4px 6px;font-size:11px;color:#111}.paper table th{background:#f1f5f7}.paper td.c{text-align:center}
            .ans{border:1px solid #ccd;background:#fafbfc;border-radius:5px;padding:8px 10px;min-height:34px;font-size:12px}
            .sig{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:30px}.sig div{border-top:1px solid #333;padding-top:4px;font-size:11px;color:#555}
            .foot{margin-top:20px;font-size:10px;color:#777;border-top:1px solid #ccd;padding-top:6px;display:flex;justify-content:space-between}
            .hide{display:none}.tb{display:flex;gap:10px;align-items:center;max-width:794px;margin:0 auto 12px}.tb select{font:inherit;background:var(--card);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:7px 10px}.tb .btn{margin-left:auto}.lt tr.r{cursor:pointer}.lt tr.r:hover td{background:var(--soft)}.lt th{text-align:left;padding:8px;border-bottom:1px solid var(--line)}.lt td{padding:10px 8px;border-bottom:1px solid var(--line);text-align:left}.pill{padding:2px 9px;border-radius:99px;font-size:11px;font-weight:600}.pill.y{background:#fde8e8;color:#b91c1c}.pill.n{background:var(--soft);color:var(--acc)}.ic{font:inherit;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:8px;padding:5px 10px;cursor:pointer}.ic:hover{border-color:var(--acc);color:var(--acc)}
            @media print{@page{size:A4;margin:14mm}:root{--bg:#fff}body{background:#fff}.top,.filters,.noprint{display:none!important}main{padding:0;max-width:none}
            .paper{border:0;box-shadow:none;padding:0;max-width:none}#dash,#list{display:none!important}}
            </style>
        </head>
        <body>
            <div class="top"><h1>Exit Interview · POMD</h1>
            <div class="tabs"><button class="on" data-v="dash">Analytics dashboard</button><button data-v="list">Interviews</button><button data-v="rep">Employee report</button></div></div>
            <main>
            <!-- ============ DASHBOARD ============ -->
            <section id="dash">
            <div class="filters"><select><option>Last 12 months</option><option>Q3 2026</option><option>Custom…</option></select>
            <select><option>All business units</option><option>Retail Banking</option><option>Credit</option><option>IT</option><option>Finance</option></select>
            <select><option>All districts</option></select><select><option>All branches</option></select><select><option>All positions</option></select><select><option>All separation types</option><option>Resignation</option><option>Retirement</option></select>
            <span class="lock">🔒 Anonymized · min. 5 responses per segment</span></div>
            <div class="kpis" id="kpis"></div>
            <div class="grid" id="cards"></div>
            </section>
            <!-- ============ REPORT ============ -->
            <section id="list" class="hide"></section>
            <section id="rep" class="hide"></section>
            </main>
            <script t-raw="script_data"/>
        </body>
        </html>
    </template>
</odoo>