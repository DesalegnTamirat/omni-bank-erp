<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_settlement_view_form" model="ir.ui.view">
        <field name="name">hr.resignation.settlement.form</field>
        <field name="model">hr.resignation.settlement</field>
        <field name="arch" type="xml">
            <form string="Final Settlement">
                <header>
                    <field name="is_hr_manager" invisible="1"/>
                    
                    <!-- Button for HR Officer / POMD Officer -->
                    <button string="Submit to HR Manager" type="object" name="action_confirm_settlement"
                            class="oe_highlight" invisible="state != 'draft' or is_hr_manager"
                            groups="hr.group_hr_user,hr_resignation.group_pomd_officer"/>
                            
                    <!-- Button for HR Manager -->
                    <button string="Confirm" type="object" name="action_confirm_settlement"
                            class="oe_highlight" invisible="state != 'draft' or not is_hr_manager"
                            groups="hr_resignation.group_resignation_hr_manager,base.group_system"/>
                    <button string="Confirm" type="object" name="action_approve_settlement"
                            class="oe_highlight" invisible="state != 'waiting_approval'"
                            groups="hr_resignation.group_resignation_hr_manager,base.group_system"/>
                    <button string="Pay" type="object" name="action_mark_paid"
                            class="oe_highlight" invisible="state != 'confirmed'"
                            groups="hr.group_hr_user,hr_resignation.group_pomd_officer,hr_resignation.group_resignation_hr_manager,base.group_system"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting_approval,confirmed,paid"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="APPROVED" bg_color="text-bg-success" invisible="state != 'confirmed'"/>
                    <widget name="web_ribbon" title="PAID" bg_color="text-bg-success" invisible="state != 'paid'"/>

                    <div class="oe_title">
                        <h1><field name="employee_id" readonly="1" options="{'no_open': True}"/></h1>
                        <h2><field name="separation_reason" readonly="1"/></h2>
                    </div>

                    <!-- Green Banner similar to screenshot -->
                    <div class="alert alert-success text-center mb-4" role="alert" style="font-size: 1.25rem; font-weight: bold; background-color: #d1e7dd; color: #0f5132;">
                        Final Settlement to be Paid: $ <field name="net_payment" readonly="1" nolabel="1"/>
                    </div>
                    
                    <group>
                        <group string="SERVICE CONTEXT">
                            <field name="service_years" readonly="1"/>
                            <field name="employment_type" readonly="1"/>
                            <field name="settlement_authorized" readonly="1" widget="boolean_toggle"/>
                        </group>
                        <group string="SALARY PARAMETERS">
                            <field name="basic_salary" readonly="state != 'draft'"/>
                            <field name="worked_days_final_month" readonly="state != 'draft'"/>
                            <field name="total_days_in_month" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="ELIGIBILITY &amp; CALCULATIONS">
                            <field name="severance_eligible" readonly="1" widget="badge" decoration-success="severance_eligible == 'yes'" decoration-danger="severance_eligible == 'no'"/>
                            <field name="pf_eligible" readonly="1" widget="badge" decoration-success="pf_eligible == 'yes'" decoration-danger="pf_eligible == 'no'"/>
                            <field name="years_for_severance" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <!-- Empty group to balance columns -->
                        </group>
                    </group>

                    <!-- Audit Information -->
                    <group string="Audit Information">
                        <group>
                            <field name="processed_by_id"/>
                            <field name="processed_date"/>
                            <field name="paid_by_id"/>
                            <field name="paid_date"/>
                        </group>
                        <group>
                            <field name="confirmed_by_id"/>
                            <field name="confirmed_date"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Full Final Settlement -->
                        <page string="Full Final Settlement">
                            <div class="mb-3">
                            <button string="Generate Standard Lines" type="object" name="action_generate_lines"
                                    class="btn-secondary" invisible="state == 'paid'"
                                    groups="hr.group_hr_user,hr_resignation.group_pomd_officer,hr_resignation.group_resignation_hr_manager,base.group_system"/>
                            </div>
                            
                            <field name="line_ids" nolabel="1" readonly="state == 'paid'">
                                <list editable="bottom" create="1" edit="1" delete="1">
                                    <control>
                                        <create name="add_line_control" string="Add a line"/>
                                    </control>
                                    <field name="name" string="Description"/>
                                    <field name="line_type" string="Type"/>
                                    <field name="is_taxable" string="Taxable?" widget="boolean"/>
                                    <field name="amount" string="Amount" sum="Total"/>
                                    <field name="notes" string="Notes"/>
                                </list>
                            </field>
                            
                            <group class="mt-4" col="12">
                                <group colspan="8">
                                    <!-- Empty space on left -->
                                </group>
                                <group colspan="4" class="text-end">
                                    <field name="taxable_gross" string="Taxable Gross:" readonly="1" class="text-info"/>
                                    <field name="total_earnings" string="Total Earnings:" readonly="1"/>
                                    <field name="total_deductions_taxes" string="Total Deductions &amp; Taxes:" readonly="1" class="text-danger"/>
                                    <field name="net_payment" string="Net Payment:" class="fs-3 fw-bold" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 2: Eligibility Assessment -->
                        <page string="Eligibility Assessment">
                            <group>
                                <field name="severance_eligible" readonly="1"/>
                                <field name="pf_eligible" readonly="1"/>
                                <field name="service_years" readonly="1" string="Years for Severance"/>
                                <field name="notice_period_accepted" readonly="1"/>
                                <field name="liability" readonly="1" invisible="notice_period_accepted != 'no'"/>
                            </group>
                        </page>

                        <!-- Tab 3: HR Notes -->
                        <page string="HR Notes">
                            <field name="notes" placeholder="Additional HR notes..." readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
