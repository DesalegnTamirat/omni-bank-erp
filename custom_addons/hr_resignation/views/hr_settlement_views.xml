<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_settlement_view_form" model="ir.ui.view">
        <field name="name">hr.resignation.settlement.form</field>
        <field name="model">hr.resignation.settlement</field>
        <field name="arch" type="xml">
            <form string="Final Settlement">
                <header>
                    <field name="is_hr_manager" invisible="1"/>
                    <field name="is_processed" invisible="1"/>

                    <!-- Step 1: POMD clicks this FIRST. Hidden once already processed. -->
                    <button string="Process Settlement" type="object" name="action_generate_lines"
                            class="oe_highlight" invisible="state != 'draft' or is_processed"
                            groups="hr_resignation.group_pomd_officer,base.group_system"/>

                    <!-- Recalculate: re-runs generate lines when already processed -->
                    <button string="Recalculate" type="object" name="action_generate_lines"
                            class="btn-secondary" invisible="state != 'draft' or not is_processed"
                            groups="hr_resignation.group_pomd_officer,base.group_system"/>

                    <!-- Step 2: POMD Officer submits to Auditor -->
                    <button string="Submit for Audit" type="object" name="action_confirm_settlement"
                            class="oe_highlight" invisible="state != 'draft' or not is_processed"
                            groups="hr_resignation.group_pomd_officer,base.group_system"/>

                    <!-- Step 3: Auditor checks lines and submits for payment -->
                    <button string="Confirm &amp; Send for Payment" type="object" name="action_audit_confirm"
                            class="oe_highlight" invisible="state != 'waiting_audit'"
                            groups="hr_resignation.group_resignation_auditor,base.group_system"/>
                    <button string="Return for Revision" type="object" name="action_open_return_wizard"
                            class="btn-secondary" invisible="state != 'waiting_audit'"
                            groups="hr_resignation.group_resignation_auditor,base.group_system"/>

                    <!-- Step 4: HR Manager checks & pays directly -->
                    <button string="Pay" type="object" name="action_mark_paid"
                            class="oe_highlight" invisible="state != 'waiting_payment'"
                            groups="hr_resignation.group_resignation_hr_manager,base.group_system"/>

                    <!-- Reset to Draft: allows regenerating lines -->
                    <button string="Reset to Draft" type="object" name="action_set_draft"
                            class="btn-secondary"
                            invisible="state == 'draft' or state == 'paid'"
                            groups="hr_resignation.group_resignation_hr_manager,base.group_system"/>

                    <!-- Reset to Draft when in draft but already processed (to clear lines) -->
                    <button string="Reset Lines" type="object" name="action_reset_lines"
                            class="btn-secondary" invisible="state != 'draft' or not is_processed"
                            groups="hr_resignation.group_pomd_officer,hr_resignation.group_resignation_hr_manager,base.group_system"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting_audit,waiting_payment,paid"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="PAID" bg_color="text-bg-success" invisible="state != 'paid'"/>

                    <div class="oe_title">
                        <h1><field name="employee_id" readonly="1" options="{'no_open': True}"/></h1>
                        <h2><field name="separation_reason" readonly="1"/></h2>
                    </div>

                    <!-- Green Banner similar to screenshot -->
                    <div class="alert alert-success text-center mb-4" role="alert" style="font-size: 1.25rem; font-weight: bold; background-color: #d1e7dd; color: #0f5132;">
                        Final Settlement to be Paid: $ <field name="net_payment" readonly="1" nolabel="1"/>
                    </div>
                    
                    <group>
                        <group string="SERVICE CONTEXT">
                            <field name="related_release_date" invisible="1"/>
                            <field name="settlement_date" string="Release Date" readonly="state != 'draft'" required="1"/>
                            <field name="date_change_justification" 
                                   invisible="settlement_date == False or settlement_date == related_release_date" 
                                   required="settlement_date != False and settlement_date != related_release_date" 
                                   readonly="state != 'draft'"/>
                            <field name="service_years" readonly="1"/>
                            <field name="employment_type" readonly="1"/>
                            <field name="settlement_authorized" readonly="1" widget="boolean_toggle"/>
                        </group>
                        <group string="SALARY PARAMETERS">
                            <field name="basic_salary" readonly="state != 'draft'"/>
                            <field name="worked_days_final_month" readonly="state != 'draft'"
                                   help="Auto-filled from release date. You can edit this if needed."/>
                        </group>
                    </group>
                    <group>
                        <group string="ELIGIBILITY &amp; CALCULATIONS">
                            <field name="severance_eligible" readonly="1" widget="badge" decoration-success="severance_eligible == 'yes'" decoration-danger="severance_eligible == 'no'"/>
                            <field name="pf_eligible" readonly="1" widget="badge" decoration-success="pf_eligible == 'yes'" decoration-danger="pf_eligible == 'no'"/>
                            <field name="years_for_severance" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <!-- Empty group to balance columns -->
                        </group>
                    </group>

                    <!-- Audit Information -->
                    <group string="Audit Information">
                        <group>
                            <field name="processed_by_id"/>
                            <field name="processed_date"/>
                            <field name="paid_by_id"/>
                            <field name="paid_date"/>
                        </group>
                        <group>
                            <field name="confirmed_by_id"/>
                            <field name="confirmed_date"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Full Final Settlement -->
                        <page string="Full Final Settlement">

                            <!-- Placeholder shown BEFORE Process Settlement is clicked -->
                            <div class="alert alert-warning text-center mt-4" role="alert" invisible="is_processed">
                                <h4>Settlement Not Yet Processed</h4>
                                <p>Click the <strong>"Process Settlement"</strong> button above to calculate the settlement amounts.</p>
                            </div>

                            <!-- Lines only visible AFTER Process Settlement is clicked -->
                            <field name="line_ids" nolabel="1" readonly="state != 'draft'" invisible="not is_processed">
                                <list editable="bottom">
                                    <field name="name" string="Description"/>
                                    <field name="line_type" string="Type"/>
                                    <field name="is_taxable" string="Taxable?" widget="boolean"/>
                                    <field name="amount" string="Amount" sum="Total"/>
                                    <field name="notes" string="Notes"/>
                                </list>
                            </field>

                            <!-- Totals only visible AFTER Process Settlement is clicked -->
                            <group class="mt-4" col="12" invisible="not is_processed">
                                <group colspan="8">
                                    <!-- Empty space on left -->
                                </group>
                                <group colspan="4" class="text-end">
                                    <field name="taxable_gross" string="Taxable Gross:" readonly="1" class="text-info"/>
                                    <field name="total_earnings" string="Total Earnings:" readonly="1"/>
                                    <field name="total_deductions_taxes" string="Total Deductions &amp; Taxes:" readonly="1" class="text-danger"/>
                                    <field name="net_payment" string="Net Payment:" class="fs-3 fw-bold" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 2: Eligibility Assessment -->
                        <page string="Eligibility Assessment">
                            <group>
                                <field name="severance_eligible" readonly="1"/>
                                <field name="pf_eligible" readonly="1"/>
                                <field name="service_years" readonly="1" string="Years for Severance"/>
                                <field name="notice_period_accepted" readonly="1"/>
                                <field name="liability" readonly="1" invisible="notice_period_accepted != 'no'"/>
                            </group>
                        </page>

                        <!-- Tab 3: HR Notes -->
                        <page string="HR Notes">
                            <field name="notes" placeholder="Additional HR notes..." readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_settlement" model="ir.actions.act_window">
        <field name="name">Settlements</field>
        <field name="res_model">hr.resignation.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No settlements found. Process a settlement from a cleared resignation.
            </p>
        </field>
    </record>
</odoo>
