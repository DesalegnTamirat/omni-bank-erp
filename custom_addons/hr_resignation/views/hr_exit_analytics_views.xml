<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_exit_analytics_view_pivot" model="ir.ui.view">
        <field name="name">hr.exit.analytics.pivot</field>
        <field name="model">hr.exit.analytics</field>
        <field name="arch" type="xml">
            <pivot string="Exit Interview Analytics" sample="1">
                <field name="question_name" type="row"/>
                <field name="answer" type="row"/>
                <field name="department_id" type="col"/>
                <field name="count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="hr_exit_analytics_view_graph" model="ir.ui.view">
        <field name="name">hr.exit.analytics.graph</field>
        <field name="model">hr.exit.analytics</field>
        <field name="arch" type="xml">
            <graph string="Exit Interview Analytics" type="bar" sample="1">
                <field name="question_name"/>
                <field name="answer"/>
                <field name="count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="hr_exit_analytics_view_tree" model="ir.ui.view">
        <field name="name">hr.exit.analytics.list</field>
        <field name="model">hr.exit.analytics</field>
        <field name="arch" type="xml">
            <list string="Exit Interview Analytics" create="false" edit="false" delete="false">
                <field name="department_id"/>
                <field name="resignation_type_id"/>
                <field name="question_name"/>
                <field name="question_type"/>
                <field name="answer"/>
                <field name="count" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="hr_exit_analytics_view_search" model="ir.ui.view">
        <field name="name">hr.exit.analytics.search</field>
        <field name="model">hr.exit.analytics</field>
        <field name="arch" type="xml">
            <search>
                <field name="department_id"/>
                <field name="question_name"/>
                <field name="resignation_type_id"/>
                <group>
                    <filter string="Department" name="group_department" context="{'group_by':'department_id'}"/>
                    <filter string="Separation Type" name="group_separation_type" context="{'group_by':'resignation_type_id'}"/>
                    <filter string="Question" name="group_question" context="{'group_by':'question_name'}"/>
                    <filter string="Answer" name="group_answer" context="{'group_by':'answer'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_exit_analytics" model="ir.actions.act_window">
        <field name="name">Exit Interview Analytics</field>
        <field name="res_model">hr.exit.analytics</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No exit interview data available yet.
            </p>
            <p>
                As employees complete exit interviews, their responses will appear here anonymously for analysis.
            </p>
        </field>
    </record>
</odoo>
