<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <menuitem id="menu_hr_resignation_root"
              name="Resignation"
              groups="base.group_user"
              sequence="45"
              web_icon="hr_resignation,static/description/icon.png"/>

    <menuitem id="menu_hr_resignation_dashboard"
              name="Dashboard"
              parent="menu_hr_resignation_root"
              action="action_hr_resignation_dashboard"
              groups="hr_resignation.group_pomd_officer,hr_resignation.group_resignation_auditor,hr_resignation.group_resignation_hr_manager,hr_resignation.group_resignation_admin"
              sequence="5"/>

    <menuitem id="menu_hr_resignation_my"
              name="Resignation Request"
              parent="menu_hr_resignation_root"
              action="action_hr_resignation_my"
              groups="base.group_user"
              sequence="10"/>

    <!--
        "My Team's Resignations":
        Accessible to internal users at model level, but dynamically blacklisted
        and hidden via _load_menus_blacklist in ir_ui_menu.py for any employee
        who is not an active coach or direct manager of other employees.
    -->
    <menuitem id="menu_hr_resignation_team_restricted"
              name="My Team's Resignations"
              parent="menu_hr_resignation_root"
              action="action_hr_resignation_team"
              groups="base.group_user"
              sequence="15"/>

    <record id="menu_hr_resignation_team_restricted" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <!--
        ONLY shown to users whose privilege is exactly "Clearance Officer".
        Points to the dedicated clearance task action which opens
        hr.resignation.clearance directly — showing only lines where
        the logged-in user is the responsible user.
        POMD officers and HR use "All Resignation Requests" instead.
    -->
    <menuitem id="menu_hr_resignation_clearance_tasks"
              name="My Clearance Tasks"
              parent="menu_hr_resignation_root"
              action="hr_resignation.action_my_clearance_tasks"
              sequence="12"/>

    <record id="menu_hr_resignation_clearance_tasks" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('hr_resignation.group_clearance_officer')])]"/>
    </record>


    <!-- Removed per user request
    <menuitem id="menu_hr_resignation_settlement_all"
              name="Final Settlements"
              parent="menu_hr_resignation_root"
              action="action_hr_settlement"
              groups="hr_resignation.group_pomd_officer,hr_resignation.group_resignation_hr_manager,hr_resignation.group_resignation_auditor"
              sequence="15"/>
    -->

    <menuitem id="menu_hr_resignation_all"

              name="All Resignation Requests"
              parent="menu_hr_resignation_root"
              action="action_hr_resignation_all"
              groups="hr_resignation.group_resignation_hr_manager,hr_resignation.group_pomd_officer,hr_resignation.group_resignation_auditor,base.group_system"
              sequence="12"/>


    <menuitem id="menu_hr_resignation_reporting"
              name="Reporting"
              parent="menu_hr_resignation_root"
              groups="hr_resignation.group_resignation_hr_manager,hr_resignation.group_pomd_officer,hr_resignation.group_resignation_admin"
              sequence="80"/>

    <menuitem id="menu_hr_exit_analytics"
              name="Exit Interview Analytics"
              parent="menu_hr_resignation_reporting"
              action="action_exit_interview_dashboard"
              groups="hr_resignation.group_resignation_hr_manager,hr_resignation.group_pomd_officer,hr_resignation.group_resignation_admin"
              sequence="10"/>

    <menuitem id="menu_hr_resignation_excel_report"
              name="Resignation Report"
              parent="menu_hr_resignation_reporting"
              action="action_hr_resignation_report_wizard"
              groups="hr_resignation.group_resignation_hr_manager,hr_resignation.group_pomd_officer,hr_resignation.group_resignation_admin"
              sequence="20"/>

    <!-- ── Configuration ──────────────────────────────────────────────── -->
    <menuitem id="menu_hr_resignation_config"
              name="Configuration"
              parent="menu_hr_resignation_root"
              groups="hr_resignation.group_pomd_officer,hr_resignation.group_resignation_auditor,hr_resignation.group_resignation_hr_manager,hr_resignation.group_resignation_admin"
              sequence="90"/>

    <menuitem id="menu_separation_type"
              name="Separation Types"
              parent="menu_hr_resignation_config"
              action="action_separation_type"
              sequence="5"/>

    <menuitem id="menu_clearance_template"
              name="Clearance Work Units"
              parent="menu_hr_resignation_config"
              action="action_clearance_template"
              sequence="10"/>

    <menuitem id="menu_hr_exit_interview_template"
              name="Exit Interview Templates"
              parent="menu_hr_resignation_config"
              action="action_hr_exit_interview_template"
              sequence="40"/>

    <menuitem id="menu_hr_resignation_tax_bracket"
              name="Tax Brackets"
              parent="menu_hr_resignation_config"
              action="action_hr_resignation_tax_bracket"
              sequence="50"/>

    <menuitem id="menu_resignation_certificate_config"
              name="Certificate Settings"
              parent="menu_hr_resignation_config"
              action="action_resignation_certificate_config"
              groups="hr_resignation.group_resignation_hr_manager,hr_resignation.group_resignation_admin,base.group_system"
              sequence="60"/>

</odoo>
