<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_exit_interview_template" name="Exit Interview">
        <t t-call="web.frontend_layout">
            <div id="wrap" class="container mt-5 mb-5 o_portal_wrap">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white border-0 mt-3">
                                <h2 class="text-center text-primary mb-0">Exit Interview Questionnaire</h2>
                                <p class="text-center text-muted mt-2">Employee: <t t-esc="interview.employee_id.name"/></p>
                            </div>
                            <div class="card-body px-5 pb-5">
                                <t t-if="interview.state == 'done'">
                                    <div class="alert alert-success">
                                        This exit interview has already been submitted and is locked.
                                    </div>
                                </t>
                                
                                <form t-attf-action="/exit_interview/#{interview.id}" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    
                                    <t t-set="all_lines" t-value="interview.line_ids"/>
                                    <t t-set="sections" t-value="[]"/>
                                    <t t-foreach="all_lines" t-as="l">
                                        <t t-if="l.section not in sections">
                                            <t t-set="sections" t-value="sections + [l.section]"/>
                                        </t>
                                    </t>
                                    
                                    <t t-foreach="sections" t-as="section">
                                        <div class="card mb-5 shadow-sm border-0 rounded-lg">
                                            <t t-if="section">
                                                <div class="card-header bg-light border-bottom py-3">
                                                    <h4 class="mb-0 text-primary fw-bold" style="letter-spacing: 0.5px;"><t t-esc="section"/></h4>
                                                </div>
                                            </t>
                                            <div class="card-body px-4 pt-4 pb-1">
                                                <t t-foreach="all_lines.filtered(lambda l: l.section == section)" t-as="line">
                                                    <div class="mb-4 pb-4 border-bottom">
                                                        <h5 class="mb-3" style="line-height: 1.4;">
                                                            <span class="text-muted me-2" style="font-size: 0.9em;"><t t-esc="line.sequence"/>.</span>
                                                            <t t-esc="line.question_name"/>
                                                            <t t-if="line.question_type in ['rating', 'satisfaction', 'agreement', 'boolean', 'boolean_agree', 'custom', 'text']">
                                                                <span class="text-danger">*</span>
                                                            </t>
                                                        </h5>
                                                        
                                                        <div class="ms-4">
                                                            <t t-if="line.question_type == 'text'">
                                                                <textarea class="form-control bg-light" t-att-name="'question_%s' % line.id" rows="3" t-att-disabled="interview.state == 'done'" required="required" placeholder="Type your response here..."><t t-esc="line.text_value"/></textarea>
                                                            </t>
                                                            
                                                            <t t-if="line.question_type == 'rating'">
                                                                <t t-foreach="dict(line._fields['rating_value'].selection).items()" t-as="option">
                                                                    <div class="form-check mb-2 custom-radio">
                                                                        <input class="form-check-input" type="radio" t-att-name="'question_%s' % line.id" t-att-id="'radio_%s_%s' % (line.id, option[0])" t-att-value="option[0]" t-att-checked="line.rating_value == option[0]" t-att-disabled="interview.state == 'done'" required="required"/>
                                                                        <label class="form-check-label ms-2" t-att-for="'radio_%s_%s' % (line.id, option[0])">
                                                                            <t t-esc="option[1]"/>
                                                                        </label>
                                                                    </div>
                                                                </t>
                                                            </t>
                                                            
                                                            <t t-if="line.question_type == 'satisfaction'">
                                                                <t t-foreach="dict(line._fields['satisfaction_value'].selection).items()" t-as="option">
                                                                    <div class="form-check mb-2 custom-radio">
                                                                        <input class="form-check-input" type="radio" t-att-name="'question_%s' % line.id" t-att-id="'radio_%s_%s' % (line.id, option[0])" t-att-value="option[0]" t-att-checked="line.satisfaction_value == option[0]" t-att-disabled="interview.state == 'done'" required="required"/>
                                                                        <label class="form-check-label ms-2" t-att-for="'radio_%s_%s' % (line.id, option[0])">
                                                                            <t t-esc="option[1]"/>
                                                                        </label>
                                                                    </div>
                                                                </t>
                                                            </t>
                                                            
                                                            <t t-if="line.question_type == 'agreement'">
                                                                <t t-foreach="dict(line._fields['agreement_value'].selection).items()" t-as="option">
                                                                    <div class="form-check mb-2 custom-radio">
                                                                        <input class="form-check-input" type="radio" t-att-name="'question_%s' % line.id" t-att-id="'radio_%s_%s' % (line.id, option[0])" t-att-value="option[0]" t-att-checked="line.agreement_value == option[0]" t-att-disabled="interview.state == 'done'" required="required"/>
                                                                        <label class="form-check-label ms-2" t-att-for="'radio_%s_%s' % (line.id, option[0])">
                                                                            <t t-esc="option[1]"/>
                                                                        </label>
                                                                    </div>
                                                                </t>
                                                            </t>
                                                            
                                                            <t t-if="line.question_type == 'boolean'">
                                                                <t t-foreach="dict(line._fields['boolean_value'].selection).items()" t-as="option">
                                                                    <div class="form-check mb-2 custom-radio">
                                                                        <input class="form-check-input" type="radio" t-att-name="'question_%s' % line.id" t-att-id="'radio_%s_%s' % (line.id, option[0])" t-att-value="option[0]" t-att-checked="line.boolean_value == option[0]" t-att-disabled="interview.state == 'done'" required="required"/>
                                                                        <label class="form-check-label ms-2" t-att-for="'radio_%s_%s' % (line.id, option[0])">
                                                                            <t t-esc="option[1]"/>
                                                                        </label>
                                                                    </div>
                                                                </t>
                                                            </t>
                                                            
                                                            <t t-if="line.question_type == 'boolean_agree'">
                                                                <t t-foreach="dict(line._fields['boolean_agree_value'].selection).items()" t-as="option">
                                                                    <div class="form-check mb-2 custom-radio">
                                                                        <input class="form-check-input" type="radio" t-att-name="'question_%s' % line.id" t-att-id="'radio_%s_%s' % (line.id, option[0])" t-att-value="option[0]" t-att-checked="line.boolean_agree_value == option[0]" t-att-disabled="interview.state == 'done'" required="required"/>
                                                                        <label class="form-check-label ms-2" t-att-for="'radio_%s_%s' % (line.id, option[0])">
                                                                            <t t-esc="option[1]"/>
                                                                        </label>
                                                                    </div>
                                                                </t>
                                                            </t>
                                                            
                                                            <t t-if="line.question_type == 'custom'">
                                                                <t t-foreach="line.question_id.option_ids" t-as="option">
                                                                    <div class="form-check mb-2 custom-radio">
                                                                        <input class="form-check-input" type="radio" t-att-name="'question_%s' % line.id" t-att-id="'radio_%s_%s' % (line.id, option.id)" t-att-value="option.id" t-att-checked="line.choice_id.id == option.id" t-att-disabled="interview.state == 'done'" required="required"/>
                                                                        <label class="form-check-label ms-2" t-att-for="'radio_%s_%s' % (line.id, option.id)">
                                                                            <t t-esc="option.name"/>
                                                                        </label>
                                                                    </div>
                                                                </t>
                                                            </t>
                                                            
                                                            <t t-if="line.question_type == 'checkbox'">
                                                                <t t-foreach="line.question_id.option_ids" t-as="option">
                                                                    <div class="form-check mb-2 custom-checkbox">
                                                                        <input class="form-check-input" type="checkbox" t-att-name="'question_%s' % line.id" t-att-id="'check_%s_%s' % (line.id, option.id)" t-att-value="option.id" t-att-checked="option.id in line.choice_ids.ids" t-att-disabled="interview.state == 'done'"/>
                                                                        <label class="form-check-label ms-2" t-att-for="'check_%s_%s' % (line.id, option.id)">
                                                                            <t t-esc="option.name"/>
                                                                        </label>
                                                                    </div>
                                                                </t>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </t>
                                    
                                    <div class="text-center mt-4">
                                        <t t-if="interview.state != 'done'">
                                            <button type="submit" name="save_draft" value="1" class="btn btn-outline-primary btn-lg mr-2">Save Draft</button>
                                            <button type="submit" name="submit_interview" value="1" class="btn btn-primary btn-lg">Submit Final Answer</button>
                                        </t>
                                        <t t-else="">
                                            <a href="/my" class="btn btn-secondary btn-lg">Back to Portal</a>
                                        </t>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    
    <template id="portal_exit_interview_success" name="Exit Interview Submitted">
        <t t-call="web.frontend_layout">
            <div id="wrap" class="container mt-5 mb-5 o_portal_wrap text-center">
                <div class="row justify-content-center">
                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0 py-5">
                            <i class="fa fa-check-circle text-success" style="font-size: 5rem;"></i>
                            <h2 class="mt-4">Thank You!</h2>
                            <p class="text-muted mt-2">Your exit interview has been submitted successfully.</p>
                            <div class="mt-4">
                                <a href="/web" class="btn btn-primary">Go to Dashboard</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>