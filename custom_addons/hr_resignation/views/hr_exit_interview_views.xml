<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         TEMPLATE — FORM
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="hr_exit_interview_template_view_form" model="ir.ui.view">
        <field name="name">hr.exit.interview.template.form</field>
        <field name="model">hr.exit.interview.template</field>
        <field name="arch" type="xml">
            <form string="Exit Interview Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Template Name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Standard Exit Interview"/>
                        </h1>
                    </div>

                    <group>
                        <field name="active" widget="boolean_toggle"/>
                    </group>

                    <notebook>
                        <page string="Questions Configuration" name="questions_config">
                            <p class="text-muted" style="font-size:0.88em; margin-bottom: 15px;">
                                Manage the questions that will be generated for employees using this exit interview template. 
                                Drag and drop using the handles on the left to change their order.
                            </p>
                            <field name="question_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="section" string="Section" optional="show"/>
                                    <field name="name" string="Question Text" style="width:40%;"/>
                                    <field name="question_type" string="Type"/>
                                    <field name="option_ids" widget="many2many_tags"
                                           string="Options"
                                           invisible="question_type not in ['custom','checkbox']"
                                           optional="show"/>
                                </list>
                            </field>

                            <div class="alert alert-info mt-3" role="alert" style="font-size:0.88em;">
                                <i class="fa fa-info-circle me-2"/>
                                <strong>Type reference:</strong>
                                <strong>Rating</strong> = Excellent / Good / Fair / Poor &#160;
                                <strong>Satisfaction</strong> = Very Satisfied to Very Dissatisfied &#160;
                                <strong>Agreement</strong> = Strongly Agree to Strongly Disagree &#160;
                                <strong>Yes/No</strong> = Yes / No &#160;
                                <strong>Agree/Disagree</strong> = Agree / Disagree &#160;
                                <strong>Custom/Multiple</strong> = open question row to define options
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         TEMPLATE — LIST
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="hr_exit_interview_template_view_list" model="ir.ui.view">
        <field name="name">hr.exit.interview.template.list</field>
        <field name="model">hr.exit.interview.template</field>
        <field name="arch" type="xml">
            <list string="Exit Interview Templates">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         TEMPLATE QUESTION — FORM
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="hr_exit_interview_question_view_form" model="ir.ui.view">
        <field name="name">hr.exit.interview.question.form</field>
        <field name="model">hr.exit.interview.question</field>
        <field name="arch" type="xml">
            <form string="Exit Interview Question">
                <sheet>
                    <group>
                        <field name="name" string="Question Text"/>
                        <field name="section" string="Section"/>
                        <field name="question_type" string="Type"/>
                        <field name="sequence" invisible="1"/>
                    </group>
                    <notebook invisible="question_type not in ['custom','checkbox']">
                        <page string="Options" name="options">
                            <p class="text-muted" style="font-size:0.88em; margin-bottom:10px;">
                                Define the choices the employee can select. Drag to reorder.
                            </p>
                            <field name="option_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Option Text"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_exit_interview_template" model="ir.actions.act_window">
        <field name="name">Exit Interview Templates</field>
        <field name="res_model">hr.exit.interview.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Exit Interview Template.
            </p>
            <p>
                Templates define the question labels used during the exit
                interview. Each Separation Type can reference its own template.
            </p>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════
         INTERVIEW LINE — FORM (comfort editing popup)
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="hr_exit_interview_line_view_form" model="ir.ui.view">
        <field name="name">hr.exit.interview.line.form</field>
        <field name="model">hr.exit.interview.line</field>
        <field name="arch" type="xml">
            <form string="Response">
                <sheet>
                    <div class="oe_title mb-3">
                        <label for="question_name" string="Question"/>
                        <h3>
                            <field name="question_name" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <field name="question_id" invisible="1"/>
                        <field name="question_type" invisible="1"/>
                        <field name="rating_value"
                               invisible="question_type != 'rating'"
                               required="question_type == 'rating'"
                               widget="radio" options="{'horizontal': true}"/>
                        <field name="satisfaction_value"
                               invisible="question_type != 'satisfaction'"
                               required="question_type == 'satisfaction'"
                               widget="radio" options="{'horizontal': true}"/>
                        <field name="agreement_value"
                               invisible="question_type != 'agreement'"
                               required="question_type == 'agreement'"
                               widget="radio" options="{'horizontal': true}"/>
                        <field name="boolean_value"
                               invisible="question_type != 'boolean'"
                               required="question_type == 'boolean'"
                               widget="radio" options="{'horizontal': true}"/>
                        <field name="boolean_agree_value"
                               invisible="question_type != 'boolean_agree'"
                               required="question_type == 'boolean_agree'"
                               widget="radio" options="{'horizontal': true}"/>
                        <field name="choice_id"
                               invisible="question_type != 'custom'"
                               required="question_type == 'custom'"
                               widget="radio"/>
                        <field name="choice_ids"
                               invisible="question_type != 'checkbox'"
                               required="question_type == 'checkbox'"
                               widget="many2many_checkboxes"/>
                    </group>
                    <group string="Response" invisible="question_type != 'text'">
                        <field name="text_value" nolabel="1"
                               placeholder="Type your response here..."
                               required="question_type == 'text'"
                               class="w-100"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════
         INTERVIEW — FORM
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="hr_exit_interview_view_form" model="ir.ui.view">
        <field name="name">hr.exit.interview.form</field>
        <field name="model">hr.exit.interview</field>
        <field name="arch" type="xml">
            <form string="Exit Interview Questionnaire">
                <header>

                    <button string="Submit Interview"
                            type="object" name="action_submit"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>

                <sheet>
                    <!-- Employee title -->
                    <div class="oe_title mb-0">
                        <label for="employee_id" string="Employee"/>
                        <h2>
                            <field name="employee_id" readonly="1"
                                   options="{'no_open': True}"/>
                        </h2>
                    </div>

                    <!-- Interview Details -->
                    <group>
                        <group string="INTERVIEW DETAILS">
                            <field name="interview_date" readonly="1"/>
                            <field name="interviewer_id" readonly="1" options="{'no_open': True}"/>
                        </group>

                    </group>

                    <div class="o_horizontal_separator mt-4 mb-2">
                        <span class="fw-bold text-uppercase"
                              style="font-size:0.82em;letter-spacing:.05em;color:#212529;">
                            Exit Interview Responses
                        </span>
                    </div>



                    <field name="line_ids" nolabel="1" readonly="state == 'done'">
                        <list create="0" delete="0">
                            <field name="sequence" widget="handle" invisible="1"/>
                            <field name="question_id" column_invisible="True"/>
                            <field name="question_type" column_invisible="True"/>
                            <field name="question_name" string="Questions (Click to Answer)" style="font-weight:600;" readonly="1" force_save="1"/>
                        </list>
                    </field>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         INTERVIEW — LIST
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="hr_exit_interview_view_list" model="ir.ui.view">
        <field name="name">hr.exit.interview.list</field>
        <field name="model">hr.exit.interview</field>
        <field name="arch" type="xml">
            <list string="Exit Interviews"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'draft'">
                <field name="employee_id"/>
                <field name="template_id"    string="Template"/>
                <field name="interview_date" string="Date"/>
                <field name="interviewer_id" string="Conducted By" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Exit Interview action -->
    <record id="action_hr_exit_interview" model="ir.actions.act_window">
        <field name="name">Exit Interviews</field>
        <field name="res_model">hr.exit.interview</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No exit interviews yet.</p>
            <p>Exit interviews are created automatically when an employee's
               last day is confirmed.</p>
        </field>
    </record>

</odoo>
