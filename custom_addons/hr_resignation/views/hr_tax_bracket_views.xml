<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_resignation_tax_bracket_tree" model="ir.ui.view">
        <field name="name">hr.resignation.tax.bracket.tree</field>
        <field name="model">hr.resignation.tax.bracket</field>
        <field name="arch" type="xml">
            <list string="Tax Brackets">
                <field name="name"/>
                <field name="min_amount"/>
                <field name="max_amount"/>
                <field name="tax_rate"/>
                <field name="deduction"/>
            </list>
        </field>
    </record>

    <record id="view_hr_resignation_tax_bracket_form" model="ir.ui.view">
        <field name="name">hr.resignation.tax.bracket.form</field>
        <field name="model">hr.resignation.tax.bracket</field>
        <field name="arch" type="xml">
            <form string="Tax Bracket">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g., Level 1: 0 - 2000"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="min_amount"/>
                            <field name="max_amount"/>
                        </group>
                        <group>
                            <field name="tax_rate"/>
                            <field name="deduction"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_resignation_tax_bracket" model="ir.actions.act_window">
        <field name="name">Tax Brackets</field>
        <field name="res_model">hr.resignation.tax.bracket</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Tax Bracket
            </p>
            <p>
                Configure the income tax brackets for severance logic.
            </p>
        </field>
    </record>
</odoo>
