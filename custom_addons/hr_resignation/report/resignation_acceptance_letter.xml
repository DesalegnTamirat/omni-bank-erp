<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Report Action for Resignation Acceptance Letter (Branches dynamically based on notice_period_accepted) -->
    <record id="action_report_resignation_acceptance" model="ir.actions.report">
        <field name="name">Resignation Acceptance Letter</field>
        <field name="model">hr.resignation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_resignation.report_resignation_acceptance</field>
        <field name="report_file">hr_resignation.report_resignation_acceptance</field>
        <field name="print_report_name">('Notification of Termination - ' if object.notice_period_accepted == 'no' else 'Resignation Acceptance - ') + object.employee_id.name</field>
        <field name="binding_model_id" ref="model_hr_resignation"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_certificate_of_release"/>
    </record>

    <!-- Dedicated Report Action for Notification of Termination Memo -->
    <record id="action_report_notification_of_termination" model="ir.actions.report">
        <field name="name">Notification of Termination</field>
        <field name="model">hr.resignation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_resignation.report_notification_of_termination</field>
        <field name="report_file">hr_resignation.report_notification_of_termination</field>
        <field name="print_report_name">'Notification of Termination - ' + object.employee_id.name</field>
        <field name="binding_model_id" ref="model_hr_resignation"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_certificate_of_release"/>
    </record>

    <!-- Master Dispatcher Template -->
    <template id="report_resignation_acceptance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-if="doc.notice_period_accepted == 'no'">
                    <t t-call="hr_resignation.report_notification_of_termination_document"/>
                </t>
                <t t-else="">
                    <t t-call="hr_resignation.report_resignation_acceptance_document"/>
                </t>
            </t>
        </t>
    </template>

    <!-- Dedicated Standalone Notification of Termination Template -->
    <template id="report_notification_of_termination">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="hr_resignation.report_notification_of_termination_document"/>
            </t>
        </t>
    </template>

    <!-- Standard Acceptance Letter Document (For notice_period_accepted == 'yes') -->
    <template id="report_resignation_acceptance_document">
        <t t-call="web.basic_layout">
            <t t-set="data" t-value="doc._get_acceptance_data()"/>

            <style type="text/css">
                @page {
                    size: A4 portrait;
                    margin: 0;
                }
                html, body, body.container, body.o_body_pdf, .container, .container-fluid, .article {
                    margin: 0 !important;
                    padding: 0 !important;
                    width: 100% !important;
                    max-width: 100% !important;
                    min-width: 100% !important;
                    height: 100% !important;
                }
                .page {
                    margin: 0 !important;
                    padding: 0 !important;
                    width: 100% !important;
                }
                .header-table, .header-table tr, .header-table td,
                .footer-layout-table, .footer-layout-table tr, .footer-layout-table td,
                .footer-contact-table, .footer-contact-table tr, .footer-contact-table td {
                    border: none !important;
                    border-top: none !important;
                    border-bottom: none !important;
                    border-left: none !important;
                    border-right: none !important;
                    outline: none !important;
                    box-shadow: none !important;
                }
                .footer-fixed {
                    position: fixed;
                    bottom: 27pt;
                    left: 0px;
                    right: 0px;
                    width: 100%;
                    margin: 0;
                    padding: 0;
                    border: none !important;
                }
                <t t-out="data.get('barlow_font_faces', '')"/>
            </style>

            <div class="page" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id" style="font-family: 'Barlow Medium', 'Barlow', Arial, sans-serif; color: #000000; font-size: 11pt; line-height: 1.4; width: 100%;">

                <!-- Official Bunna Bank Letterhead Header Banner -->
                <div style="padding-top: 26pt; margin-bottom: 24pt; width: 100%; border: 0 !important;">
                    <table class="header-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0; padding: 0;">
                        <tr style="border: 0 !important;">
                            <td style="width: 155px; vertical-align: middle; text-align: left; padding: 0 0 0 24px; margin: 0; border: 0 !important;">
                                <t t-if="data.get('company_logo')">
                                    <img t-att-src="data['company_logo']" style="width: 130px; height: auto; display: block; object-fit: contain;" alt="Bunna Bank Logo"/>
                                </t>
                                <t t-else="">
                                    <img src="/hr_resignation/static/src/img/bunna_logo.png" style="width: 130px; height: auto; display: block; object-fit: contain;" alt="Bunna Bank Logo"/>
                                </t>
                            </td>
                            <td style="vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                <!-- Official Bunna Bank Coffee Brown Header Bar (#6d382d) -->
                                <div style="background-color: #6d382d; height: 28px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Body Content Container (Exactly 25.4mm = 1 inch / 72pt left & right margins) -->
                <div style="padding-left: 25.4mm; padding-right: 25.4mm;">

                    <!-- Date and Reference Number (Right Aligned) -->
                    <div style="text-align: right; margin-top: 2px; margin-bottom: 16px;">
                        <div style="display: inline-block; text-align: left; font-size: 11pt; line-height: 1.35; color: #000000;">
                            <div><t t-out="data.get('letter_date')"/></div>
                            <div>Ref. No: <t t-out="data.get('ref_no')"/></div>
                        </div>
                    </div>

                    <!-- Recipient Block -->
                    <div style="margin-bottom: 12px; font-size: 11pt; line-height: 1.35; color: #000000;">
                        <div style="font-weight: bold;"><t t-out="data.get('name_full')"/></div>
                        <div style="text-decoration: underline;"><t t-out="'Addis Ababa' if (not data.get('city') or 'brisbane' in str(data.get('city', '')).lower()) else data.get('city')"/></div>
                    </div>

                    <!-- Salutation -->
                    <div style="font-weight: bold; margin-bottom: 10px; font-size: 11pt; color: #000000;">
                        Dear <t t-out="data.get('salutation_name')"/>,
                    </div>

                    <!-- Paragraph 1: Reference and Approval -->
                    <p style="margin-bottom: 10px; text-align: justify; font-size: 11pt; line-height: 1.4; color: #000000;">
                        This refers to your request for resignation dated <strong style="font-weight: bold;"><t t-out="data.get('application_date_str')"/></strong>. Accordingly, the Bank has accepted and approved the termination of your employment, which commenced on <strong style="font-weight: bold;"><t t-out="data.get('joined_date_str')"/></strong> in accordance with the labor law, effective <strong style="font-weight: bold;"><t t-out="data.get('effective_date_str')"/></strong>.
                    </p>

                    <!-- Paragraph 2: Handover and Clearance -->
                    <p style="margin-bottom: 10px; text-align: justify; font-size: 11pt; line-height: 1.4; color: #000000;">
                        You are advised to hand over all pending duties, files, and Bank properties to the person designated by your branch (work unit) and obtain clearance from the People Operation Management Directorate.
                    </p>

                    <!-- Paragraph 3: Loans & Advances and IT Deactivation -->
                    <p style="margin-bottom: 10px; text-align: justify; font-size: 11pt; line-height: 1.4; color: #000000;">
                        By copy of this letter, the Credit Relationship Management Directorate is advised to follow up on the settlement of any outstanding loans and advances, if any. Similarly, the IT Security Management Directorate is advised to deactivate system access accordingly.
                    </p>

                    <!-- Paragraph 4: RSSA Notice -->
                    <p style="margin-bottom: 10px; text-align: justify; font-size: 11pt; line-height: 1.4; color: #000000;">
                        Kindly note that any outstanding interest-free Revolving Staff Salary Advance (RSSA) must be settled upon resignation. If not settled, it will be changed to a higher interest rate effective from the final resignation date, in accordance with the Bankâ€™s policy.
                    </p>

                    <!-- Important Notice: Not a Certificate of Release -->
                    <div style="margin-top: 8px; margin-bottom: 12px; padding: 6px 10px; border: 1px solid #c0392b; background-color: #fdf2f2; font-size: 8.5pt; line-height: 1.35; color: #962d22; text-align: justify;">
                        <strong>IMPORTANT NOTICE:</strong> This letter serves as administrative notice of resignation acceptance only and is <strong>NOT</strong> a Certificate of Release or Clearance Certificate. Formal release, work experience certificate, and terminal settlement shall only be granted upon 100% completion of digital clearance, asset handover, and total loan settlement.
                    </div>

                    <!-- Paragraph 5: Appreciation -->
                    <p style="margin-bottom: 12px; text-align: justify; font-size: 11pt; line-height: 1.4; color: #000000;">
                        Thank you for your contributions during your tenure with us, and we wish you all the best in your future endeavors.
                    </p>

                    <!-- Signatory Block -->
                    <div style="margin-top: 8px; margin-bottom: 10px; font-size: 11pt; line-height: 1.35; color: #000000;">
                        <div style="margin-bottom: 14px;">Sincerely Yours</div>

                        <!-- Media Area: Signature and Stamp -->
                        <t t-if="data.get('signature_uri') and data.get('stamp_uri')">
                            <div style="position: relative; height: 85px; min-width: 250px; margin-bottom: 8px;">
                                <img t-att-src="data['signature_uri']" style="position: absolute; left: 0; bottom: 0; max-height: 78px; max-width: 180px; object-fit: contain; z-index: 1;" alt="Authorized Signature"/>
                                <img t-att-src="data['stamp_uri']" style="position: absolute; left: 110px; bottom: 0; max-height: 85px; max-width: 90px; object-fit: contain; z-index: 2; opacity: 0.90;" alt="Official Stamp"/>
                            </div>
                        </t>
                        <t t-elif="data.get('signature_uri')">
                            <div style="margin-bottom: 8px;">
                                <img t-att-src="data['signature_uri']" style="max-height: 78px; max-width: 180px; object-fit: contain; display: block;" alt="Authorized Signature"/>
                            </div>
                        </t>
                        <t t-elif="data.get('stamp_uri')">
                            <div style="margin-bottom: 8px;">
                                <img t-att-src="data['stamp_uri']" style="max-height: 85px; max-width: 90px; object-fit: contain; display: block;" alt="Official Stamp"/>
                            </div>
                        </t>
                        <t t-else="">
                            <!-- Clean manual wet-ink signature clearance -->
                            <div style="height: 80px;"></div>
                        </t>

                        <div style="font-weight: bold; margin-top: 6px; margin-bottom: 3px;"><t t-out="data.get('signatory_name')"/></div>
                        <div><t t-out="data.get('signatory_title')"/></div>
                    </div>

                    <!-- CC: Distribution Block -->
                    <div style="margin-top: 10px; font-size: 9.5pt; line-height: 1.3; color: #000000;">
                        <div style="font-weight: bold; text-decoration: underline; margin-bottom: 3px;">CC: -</div>
                        <div style="padding-left: 2px;">
                            <t t-foreach="data.get('cc_list', [])" t-as="cc_item">
                                <div style="margin-bottom: 2px; vertical-align: middle;">
                                    <svg style="width: 9px; height: 9px; vertical-align: -0.5px; margin-right: 5px;" viewBox="0 0 24 24">
                                        <path d="M2,3 L22,12 L2,21 L7,12 Z" fill="#000000"/>
                                    </svg>
                                    <span style="font-weight: bold;"><t t-out="cc_item"/></span>
                                </div>
                            </t>
                        </div>
                    </div>

                </div>

                <!-- Bunna Bank Letterhead Official Footer (Pinned to bottom) -->
                <div class="footer-fixed">
                    <table class="footer-layout-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0; padding: 0;">
                        <tr style="border: 0 !important;">
                            <!-- Left Olive Green Accent Bar -->
                            <td style="width: 15%; vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                <div style="background-color: #253315; height: 26px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                            </td>
                            <!-- Center Contact Info Table -->
                            <td style="width: 70%; vertical-align: middle; padding: 0 18px; margin: 0; text-align: center; border: 0 !important;">
                                <table class="footer-contact-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0 auto; font-size: 8pt; color: #6d382d; line-height: 1.4;">
                                    <tr style="border: 0 !important;">
                                        <td style="width: 34%; text-align: left; padding: 1px 0; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                            <strong style="font-weight: bold;">Tel</strong> +251 111 580 861 | 62
                                        </td>
                                        <td style="width: 36%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                            <strong style="font-weight: bold;">Email</strong> info@bunnabanksc.com
                                        </td>
                                        <td style="width: 30%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                            <strong style="font-weight: bold;">P.O.Box</strong> 1743 code 1110
                                        </td>
                                    </tr>
                                    <tr style="border: 0 !important;">
                                        <td style="width: 34%; text-align: left; padding: 1px 0; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                            <strong style="font-weight: bold;">Fax</strong> +251 111 580 832 | 76
                                        </td>
                                        <td style="width: 36%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                            <strong style="font-weight: bold;">Website</strong> www.bunnabanksc.com
                                        </td>
                                        <td style="width: 30%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                            Addis Ababa | Ethiopia
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <!-- Right Olive Green Accent Bar -->
                            <td style="width: 15%; vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                <div style="background-color: #253315; height: 26px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                            </td>
                        </tr>
                    </table>
                </div>

            </div>
        </t>
    </template>

    <!-- Notification of Termination Memo Document (For notice_period_accepted == 'no') -->
    <template id="report_notification_of_termination_document">
        <t t-call="web.basic_layout">
            <t t-set="data" t-value="doc._get_termination_notification_data()"/>

            <style type="text/css">
                @page {
                    size: A4 portrait;
                    margin: 0;
                }
                html, body, body.container, body.o_body_pdf, .container, .container-fluid, .article {
                    margin: 0 !important;
                    padding: 0 !important;
                    width: 100% !important;
                    max-width: 100% !important;
                    min-width: 100% !important;
                    height: 100% !important;
                }
                .page {
                    margin: 0 !important;
                    padding: 0 !important;
                    width: 100% !important;
                }
                .footer-fixed-memo {
                    position: fixed;
                    bottom: 24pt;
                    left: 25.4mm;
                    right: 25.4mm;
                    width: auto;
                    margin: 0;
                    padding: 0;
                }
                .amharic-footer-text {
                    font-family: Ebrima, Nyala, Arial, sans-serif !important;
                    font-weight: bold;
                    font-size: 13pt;
                    color: #833c0b;
                }
                <t t-out="data.get('barlow_font_faces', '')"/>
            </style>

            <div class="page" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id" style="font-family: 'Barlow Medium', 'Barlow', Arial, sans-serif; color: #000000; font-size: 11pt; line-height: 1.45; width: 100%;">

                <div style="padding-top: 26pt; padding-left: 25.4mm; padding-right: 25.4mm;">

                    <!-- Memo Header: Logo on left, POMD-Internal Memo on right -->
                    <table border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; border: none; margin: 0; padding: 0;">
                        <tr style="border: none;">
                            <td style="width: 50%; vertical-align: bottom; text-align: left; padding: 0; border: none;">
                                <t t-if="data.get('company_logo')">
                                    <img t-att-src="data['company_logo']" style="width: 135px; height: auto; display: block; object-fit: contain;" alt="Bunna Bank Logo"/>
                                </t>
                                <t t-else="">
                                    <img src="/hr_resignation/static/src/img/bunna_logo.png" style="width: 135px; height: auto; display: block; object-fit: contain;" alt="Bunna Bank Logo"/>
                                </t>
                            </td>
                            <td style="width: 50%; vertical-align: bottom; text-align: right; padding: 0 0 4px 0; border: none;">
                                <span style="font-family: 'Barlow', Arial, sans-serif; font-size: 14pt; font-weight: bold; color: #000000; letter-spacing: 0.2px;">POMD-Internal Memo</span>
                            </td>
                        </tr>
                    </table>

                    <!-- Double divider lines (Thin top line, thick bottom line) -->
                    <div style="border-top: 1px solid #000000; border-bottom: 2.5px solid #000000; height: 3px; margin-top: 8px; margin-bottom: 16px; width: 100%;"></div>

                    <!-- Metadata Table: To, Cc, From, Ref, Date, Subject -->
                    <table border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 11.5pt; font-family: 'Barlow', Arial, sans-serif; color: #000000; line-height: 1.45; border: none;">
                        <tr style="border: none;">
                            <td style="width: 80px; font-weight: bold; vertical-align: top; padding: 2px 0; border: none;">To:</td>
                            <td style="vertical-align: top; padding: 2px 0; border: none;"><t t-out="data.get('to_recipient', 'People Performance and Development Directorate')"/></td>
                        </tr>
                        <t t-if="data.get('cc_list')">
                            <tr style="border: none;">
                                <td style="font-weight: bold; vertical-align: top; padding: 2px 0; border: none;">Cc:</td>
                                <td style="vertical-align: top; padding: 2px 0; border: none;">
                                    <t t-foreach="data.get('cc_list')" t-as="cc_item">
                                        <div><t t-out="cc_item"/></div>
                                    </t>
                                </td>
                            </tr>
                        </t>
                        <tr style="border: none;">
                            <td style="font-weight: bold; vertical-align: top; padding: 2px 0; border: none;">From:</td>
                            <td style="vertical-align: top; padding: 2px 0; border: none;"><t t-out="data.get('from_sender', 'People Operation Management Directorate')"/></td>
                        </tr>
                        <tr style="border: none;">
                            <td style="font-weight: bold; vertical-align: top; padding: 2px 0; border: none;">Ref:</td>
                            <td style="vertical-align: top; padding: 2px 0; border: none;"><t t-out="data.get('ref_no')"/></td>
                        </tr>
                        <tr style="border: none;">
                            <td style="font-weight: bold; vertical-align: top; padding: 2px 0; border: none;">Date:</td>
                            <td style="vertical-align: top; padding: 2px 0; border: none;"><t t-out="data.get('letter_date')"/></td>
                        </tr>
                        <tr style="border: none;">
                            <td style="font-weight: bold; vertical-align: top; padding: 6px 0 2px 0; border: none;">Subject:</td>
                            <td style="vertical-align: top; padding: 6px 0 2px 0; border: none;">
                                <span style="font-weight: bold; text-decoration: underline;">Notification of Termination</span>
                            </td>
                        </tr>
                    </table>

                    <!-- Body Paragraphs -->
                    <div style="font-size: 11pt; line-height: 1.48; text-align: justify; color: #000000; font-family: 'Barlow', Arial, sans-serif;">
                        <p style="margin-bottom: 12px;">
                            <t t-out="data.get('prefix', 'Ato')"/> <t t-out="doc.employee_id.name"/> ID.No.<t t-out="data.get('employee_id_no')"/> who had been serving the bank from <t t-out="data.get('joined_date_str')"/> at <t t-out="data.get('work_place')"/> has resigned from the bank from effective <t t-out="data.get('effective_date_str')"/> due to <t t-out="data.get('separation_reason', 'resignation')"/>.
                        </p>
                        <p style="margin-bottom: 12px;">
                            Accordingly, Credit Relationship Management Directorate is also advised to follow up the adjustment of the interest rate and settlement of unsettled loans and advances (if any). IT Security Directorate is advised to deactivate the user access (if any) accordingly.
                        </p>
                        <p style="margin-bottom: 14px;">
                            Kindly note that any outstanding interest-free Revolving Staff Salary Advance (RSSA) must be settled upon resignation. If not settled, it will be changed to a higher interest rate effective from the final resignation date, in accordance with the Bankâ€™s policy.
                        </p>

                        <div style="margin-top: 18px; margin-bottom: 14px;">
                            Regards
                        </div>

                        <!-- Media Area: Signature and Stamp -->
                        <t t-if="data.get('signature_uri') and data.get('stamp_uri')">
                            <div style="position: relative; height: 85px; min-width: 250px; margin-bottom: 6px; margin-top: 4px;">
                                <img t-att-src="data['signature_uri']" style="position: absolute; left: 0; bottom: 0; max-height: 78px; max-width: 180px; object-fit: contain; z-index: 1;" alt="Authorized Signature"/>
                                <img t-att-src="data['stamp_uri']" style="position: absolute; left: 110px; bottom: 0; max-height: 85px; max-width: 90px; object-fit: contain; z-index: 2; opacity: 0.90;" alt="Official Stamp"/>
                            </div>
                        </t>
                        <t t-elif="data.get('signature_uri')">
                            <div style="margin-bottom: 6px; margin-top: 4px;">
                                <img t-att-src="data['signature_uri']" style="max-height: 78px; max-width: 180px; object-fit: contain; display: block;" alt="Authorized Signature"/>
                            </div>
                        </t>
                        <t t-elif="data.get('stamp_uri')">
                            <div style="margin-bottom: 6px; margin-top: 4px;">
                                <img t-att-src="data['stamp_uri']" style="max-height: 85px; max-width: 90px; object-fit: contain; display: block;" alt="Official Stamp"/>
                            </div>
                        </t>
                        <t t-else="">
                            <div style="height: 80px;"></div>
                        </t>

                        <div style="font-weight: bold; margin-top: 6px; margin-bottom: 2px;"><t t-out="data.get('signatory_name', '')"/></div>
                        <div><t t-out="data.get('signatory_title', 'People Operation Management Directorate')"/></div>
                    </div>

                </div>

                <!-- Footer (Pinned to bottom): BANK OF THE VISIONARIES! / á‹¨á‰£áˆˆáˆ«á‹•á‹®á‰½ á‰£áŠ•áŠ­! -->
                <div class="footer-fixed-memo">
                    <div style="border-top: 2px solid #000000; margin-bottom: 6px; width: 100%;"></div>
                    <table border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; border: none !important;">
                        <tr style="border: none !important;">
                            <td style="text-align: left; vertical-align: middle; padding: 0; border: none !important;">
                                <span style="font-family: Arial, sans-serif; font-weight: bold; font-size: 13pt; color: #833c0b; letter-spacing: 0.3px;">BANK OF THE VISIONARIES!</span>
                            </td>
                            <td style="text-align: right; vertical-align: middle; padding: 0; border: none !important;">
                                <span class="amharic-footer-text">á‹¨á‰£áˆˆáˆ«á‹•á‹®á‰½ á‰£áŠ•áŠ­!</span>
                            </td>
                        </tr>
                    </table>
                </div>

            </div>
        </t>
    </template>

</odoo>
