<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report Action -->
    <record id="action_report_exit_interview" model="ir.actions.report">
        <field name="name">Exit Interview</field>
        <field name="model">hr.exit.interview</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_resignation.report_exit_interview</field>
        <field name="report_file">hr_resignation.report_exit_interview</field>
        <field name="print_report_name">'Exit_Interview_%s' % (object.employee_id.name.replace(' ','_'))</field>
        <field name="binding_model_id" ref="model_hr_exit_interview"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report Template -->
    <template id="report_exit_interview">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
                        <div class="oe_structure"/>
                        
                        <div class="text-center" style="margin-bottom: 30px; padding-bottom: 10px; border-bottom: 2px solid #0f766e;">
                            <h2 style="color: #0f766e; font-weight: bold;">Exit Interview Report</h2>
                            <p class="text-muted" style="font-size: 14px;">Strictly Confidential</p>
                        </div>
                        
                        <table class="table table-sm table-borderless" style="margin-bottom: 30px; font-size: 14px;">
                            <tbody>
                                <tr>
                                    <td style="width: 25%; color: #555;"><strong>Employee Name:</strong></td>
                                    <td style="width: 25%;"><strong><span t-field="o.employee_id.name"/></strong></td>
                                    <td style="width: 25%; color: #555;"><strong>Interview Date:</strong></td>
                                    <td style="width: 25%;"><span t-field="o.interview_date" t-options='{"widget": "date"}'/></td>
                                </tr>
                                <tr>
                                    <td style="color: #555;"><strong>Job Title:</strong></td>
                                    <td><span t-field="o.employee_id.job_title"/></td>
                                    <td style="color: #555;"><strong>Conducted By:</strong></td>
                                    <td><span t-field="o.interviewer_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="color: #555;"><strong>Department:</strong></td>
                                    <td><span t-field="o.employee_id.department_id.name"/></td>
                                    <td style="color: #555;"><strong>Status:</strong></td>
                                    <td>
                                        <span t-if="o.state == 'draft'" class="badge" style="background-color: #94a3b8; color: white; padding: 3px 8px; border-radius: 4px;">Draft</span>
                                        <span t-if="o.state == 'done'" class="badge" style="background-color: #15803d; color: white; padding: 3px 8px; border-radius: 4px;">Completed</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color: #555;"><strong>Manager:</strong></td>
                                    <td><span t-field="o.employee_id.parent_id.name"/></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 style="color: #0f766e; font-size: 18px; border-bottom: 1px solid #ccc; padding-bottom: 8px; margin-bottom: 20px;">
                            Interview Responses
                        </h4>
                        
                        <table class="table table-sm table-bordered" style="width: 100%; font-size: 13px; border-collapse: collapse;">
                            <thead>
                                <tr style="background-color: #f4f6f8; color: #333;">
                                    <th style="width: 5%; text-align: center; border: 1px solid #ddd; padding: 10px;">#</th>
                                    <th style="width: 45%; border: 1px solid #ddd; padding: 10px;">Question</th>
                                    <th style="width: 50%; border: 1px solid #ddd; padding: 10px;">Response</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td style="text-align: center; vertical-align: top; border: 1px solid #ddd; padding: 10px;">
                                            <span t-esc="line_index + 1"/>
                                        </td>
                                        <td style="vertical-align: top; border: 1px solid #ddd; padding: 10px; font-weight: 500; color: #1f2937;">
                                            <span t-field="line.question_name"/>
                                        </td>
                                        <td style="vertical-align: top; border: 1px solid #ddd; padding: 10px; color: #4b5563;">
                                            <span t-if="line.answer" t-field="line.answer"/>
                                            <span t-else="" style="color: #9ca3af; font-style: italic;">No answer provided</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div t-if="not o.line_ids" class="alert alert-info" style="margin-top: 20px;">
                            No response lines found for this interview.
                        </div>

                        <div style="margin-top: 50px; page-break-inside: avoid;">
                            <table style="width: 100%;">
                                <tr>
                                    <td style="width: 50%; padding: 20px 0;">
                                        <div style="border-top: 1px solid #333; width: 80%; padding-top: 5px;">
                                            <strong>Interviewer Signature</strong><br/>
                                            <span class="text-muted" style="font-size: 11px;">Date: _________________</span>
                                        </div>
                                    </td>
                                    <td style="width: 50%; padding: 20px 0;">
                                        <div style="border-top: 1px solid #333; width: 80%; padding-top: 5px;">
                                            <strong>Employee Signature</strong><br/>
                                            <span class="text-muted" style="font-size: 11px;">Date: _________________</span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
