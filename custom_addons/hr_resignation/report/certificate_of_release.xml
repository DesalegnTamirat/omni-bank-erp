<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Custom Zero-Margin Paperformat for Full-Bleed Header and Footer (A4 Matching Experience Letter) -->
    <record id="paperformat_certificate_of_release" model="report.paperformat">
        <field name="name">Certificate of Release Paperformat</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_certificate_of_release" model="ir.actions.report">
        <field name="name">Certificate of Release</field>
        <field name="model">hr.resignation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_resignation.report_certificate_of_release</field>
        <field name="report_file">hr_resignation.report_certificate_of_release</field>
        <field name="print_report_name">'Certificate of Release - ' + object.employee_id.name</field>
        <field name="binding_model_id" ref="model_hr_resignation"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_certificate_of_release"/>
    </record>

    <!-- QWeb Template matching Experience Letter Design & Typography -->
    <template id="report_certificate_of_release">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-set="cert" t-value="doc._get_certificate_data()"/>

                    <style type="text/css">
                        @page {
                            size: A4 portrait;
                            margin: 0;
                        }
                        html, body, body.container, body.o_body_pdf, .container, .container-fluid, .article {
                            margin: 0 !important;
                            padding: 0 !important;
                            width: 100% !important;
                            max-width: 100% !important;
                            min-width: 100% !important;
                            height: 100% !important;
                        }
                        .page {
                            margin: 0 !important;
                            padding: 0 !important;
                            width: 100% !important;
                        }
                        .header-table, .header-table tr, .header-table td,
                        .footer-layout-table, .footer-layout-table tr, .footer-layout-table td,
                        .footer-contact-table, .footer-contact-table tr, .footer-contact-table td {
                            border: none !important;
                            border-top: none !important;
                            border-bottom: none !important;
                            border-left: none !important;
                            border-right: none !important;
                            outline: none !important;
                            box-shadow: none !important;
                        }
                        .footer-fixed {
                            position: fixed;
                            bottom: 27pt;
                            left: 0px;
                            right: 0px;
                            width: 100%;
                            margin: 0;
                            padding: 0;
                            border: none !important;
                        }
                        <t t-out="cert.get('barlow_font_faces', '')"/>
                    </style>

                    <div class="page" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id" style="font-family: 'Barlow Medium', 'Barlow', Arial, sans-serif; color: #000000; font-size: 12pt; line-height: 1.45; width: 100%;">

                        <!-- Official Bunna Bank Letterhead Header Banner -->
                        <div style="padding-top: 26pt; margin-bottom: 32pt; width: 100%; border: 0 !important;">
                            <table class="header-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0; padding: 0;">
                                <tr style="border: 0 !important;">
                                    <td style="width: 155px; vertical-align: middle; text-align: left; padding: 0 0 0 24px; margin: 0; border: 0 !important;">
                                        <t t-if="cert.get('company_logo')">
                                            <img t-att-src="cert['company_logo']" style="width: 130px; height: auto; display: block; object-fit: contain;" alt="Bunna Bank Logo"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/hr_resignation/static/src/img/bunna_logo.png" style="width: 130px; height: auto; display: block; object-fit: contain;" alt="Bunna Bank Logo"/>
                                        </t>
                                    </td>
                                    <td style="vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <!-- Official Bunna Bank Coffee Brown Header Bar (#6d382d) -->
                                        <div style="background-color: #6d382d; height: 28px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Body Content Container (Exactly 25.4mm = 1 inch / 72pt left & right margins) -->
                        <div style="padding-left: 25.4mm; padding-right: 25.4mm;">

                            <!-- Date and Reference Number -->
                            <div style="text-align: right; margin-top: 4px; margin-bottom: 20px;">
                                <div style="display: inline-block; text-align: left; font-size: 12pt; line-height: 1.4; color: #000000;">
                                    <div>Date: <t t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/></div>
                                    <div>Ref.No: <t t-out="doc.name"/></div>
                                </div>
                            </div>

                            <!-- Title: Centered, Bold, Underlined, 15pt font -->
                            <div style="text-align: center; margin-top: 18px; margin-bottom: 20px;">
                                <span style="font-size: 15pt; font-weight: bold; text-decoration: underline; color: #000000;">Certificate of Release</span>
                            </div>

                            <!-- Paragraph 1: Employment Certification -->
                            <p style="margin-bottom: 12px; text-align: justify; font-size: 12pt; line-height: 1.45; color: #000000;">
                                This is to certify that <strong style="font-weight: bold;"><t t-out="cert['name_full']"/></strong> had been a permanent employee of Bunna Bank S.C. since <strong style="font-weight: bold;"><t t-out="cert['hire_date']"/></strong> Until <t t-out="cert['pronoun_pos']"/> resignation from the Bank effective <strong style="font-weight: bold;"><t t-out="cert['release_date']"/></strong>.
                            </p>

                            <!-- Paragraph 2: Capacities Intro -->
                            <p style="margin-bottom: 12px; text-align: justify; font-size: 12pt; line-height: 1.45; color: #000000;">
                                During <t t-out="cert['pronoun_pos']"/> stay, that <strong style="font-weight: bold;"><t t-out="cert['name_full']"/></strong> had been serving the Bank in the following capacities;
                            </p>

                            <!-- Capacities List (Matching Reference Document Arrow List Style) -->
                            <div style="margin-top: 6px; margin-bottom: 14px; padding-left: 28px;">
                                <table style="width: 100%; border-collapse: collapse; border: none !important;">
                                    <t t-if="cert.get('job_history_items')">
                                        <t t-foreach="cert['job_history_items']" t-as="jh">
                                            <tr style="border: none !important;">
                                                <td style="width: 24px; vertical-align: top; padding: 3px 0; border: none !important;">
                                                    <svg style="width: 13px; height: 13px; vertical-align: -1px;" viewBox="0 0 24 24">
                                                        <path d="M2,3 L22,12 L2,21 L7,12 Z" fill="#000000"/>
                                                    </svg>
                                                </td>
                                                <td style="vertical-align: top; padding: 3px 0; border: none !important; font-size: 12pt; line-height: 1.45; color: #000000;">
                                                    <t t-out="jh.get('job_name')"/> from <t t-out="jh.get('start_date')"/> - <t t-out="jh.get('end_date')"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <tr style="border: none !important;">
                                            <td style="width: 24px; vertical-align: top; padding: 3px 0; border: none !important;">
                                                <svg style="width: 13px; height: 13px; vertical-align: -1px;" viewBox="0 0 24 24">
                                                    <path d="M2,3 L22,12 L2,21 L7,12 Z" fill="#000000"/>
                                                </svg>
                                            </td>
                                            <td style="vertical-align: top; padding: 3px 0; border: none !important; font-size: 12pt; line-height: 1.45; color: #000000;">
                                                <t t-out="doc.employee_id.job_id.name or doc.employee_id.job_title or ''"/> from <t t-out="cert['hire_date']"/> - <t t-out="cert['release_date']"/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </div>

                            <!-- Paragraph 3: Salary and Tax -->
                            <p style="margin-bottom: 12px; text-align: justify; font-size: 12pt; line-height: 1.45; color: #000000;">
                                <t t-out="cert['pronoun_sub_cap']"/> was lastly earning a basic monthly salary of Birr <strong style="font-weight: bold;"><t t-out="'{:,.2f}'.format(doc.basic_salary)"/> (<t t-out="cert['salary_words']"/>)</strong>. Income tax was also regularly collected from <t t-out="cert['pronoun_pos']"/> monthly salary and duly paid to the concerned government office.
                            </p>

                            <!-- Paragraph 4 & 5: Departure and Wishes -->
                            <p style="margin-bottom: 12px; text-align: justify; font-size: 12pt; line-height: 1.45; color: #000000;">
                                <strong style="font-weight: bold;"><t t-out="cert['name_full']"/></strong> left the Bank on <t t-out="cert['pronoun_pos']"/> own will.
                            </p>
                            <p style="margin-bottom: 14px; text-align: justify; font-size: 12pt; line-height: 1.45; color: #000000;">
                                We wish <t t-out="cert['pronoun_obj']"/> all the best in <t t-out="cert['pronoun_pos']"/> future endeavors.
                            </p>

                            <!-- Sign-off Block -->
                            <div style="margin-top: 10px; margin-bottom: 12px; font-size: 12pt; line-height: 1.35; color: #000000;">
                                <div style="margin-bottom: 14px;">Sincerely yours,</div>

                                <!-- Media Area: Signature and Stamp -->
                                <t t-if="cert.get('signature_uri') and cert.get('stamp_uri')">
                                    <div style="position: relative; height: 88px; min-width: 250px; margin-bottom: 8px;">
                                        <img t-att-src="cert['signature_uri']" style="position: absolute; left: 0; bottom: 0; max-height: 80px; max-width: 190px; object-fit: contain; z-index: 1;" alt="Authorized Signature"/>
                                        <img t-att-src="cert['stamp_uri']" style="position: absolute; left: 120px; bottom: 0; max-height: 88px; max-width: 95px; object-fit: contain; z-index: 2; opacity: 0.90;" alt="Official Stamp"/>
                                    </div>
                                </t>
                                <t t-elif="cert.get('signature_uri')">
                                    <div style="margin-bottom: 8px;">
                                        <img t-att-src="cert['signature_uri']" style="max-height: 80px; max-width: 190px; object-fit: contain; display: block;" alt="Authorized Signature"/>
                                    </div>
                                </t>
                                <t t-elif="cert.get('stamp_uri')">
                                    <div style="margin-bottom: 8px;">
                                        <img t-att-src="cert['stamp_uri']" style="max-height: 88px; max-width: 95px; object-fit: contain; display: block;" alt="Official Stamp"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <!-- Clean manual wet-ink signature clearance without any underline -->
                                    <div style="height: 80px;"></div>
                                </t>
                                <div style="font-weight: bold; margin-top: 6px; margin-bottom: 4px;"><t t-out="cert.get('signatory_name')"/></div>
                                <div><t t-out="cert.get('signatory_title')"/></div>
                                </div>
                                </div>

                        <!-- Bunna Bank Letterhead Official Footer (Pinned to bottom) -->
                        <div class="footer-fixed">
                            <table class="footer-layout-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0; padding: 0;">
                                <tr style="border: 0 !important;">
                                    <!-- Left Olive Green Accent Bar -->
                                    <td style="width: 15%; vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <div style="background-color: #253315; height: 26px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                    <!-- Center Contact Info Table -->
                                    <td style="width: 70%; vertical-align: middle; padding: 0 18px; margin: 0; text-align: center; border: 0 !important;">
                                        <table class="footer-contact-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0 auto; font-size: 8pt; color: #6d382d; line-height: 1.4;">
                                            <tr style="border: 0 !important;">
                                                <td style="width: 34%; text-align: left; padding: 1px 0; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Tel</strong> +251 111 580 861 | 62
                                                </td>
                                                <td style="width: 36%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Email</strong> info@bunnabanksc.com
                                                </td>
                                                <td style="width: 30%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">P.O.Box</strong> 1743 code 1110
                                                </td>
                                            </tr>
                                            <tr style="border: 0 !important;">
                                                <td style="width: 34%; text-align: left; padding: 1px 0; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Fax</strong> +251 111 580 832 | 76
                                                </td>
                                                <td style="width: 36%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Website</strong> www.bunnabanksc.com
                                                </td>
                                                <td style="width: 30%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    Addis Ababa | Ethiopia
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <!-- Right Olive Green Accent Bar -->
                                    <td style="width: 15%; vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <div style="background-color: #253315; height: 26px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>