<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_resignation.Dashboard">
        <div class="o_resignation_dashboard">
            <!-- Header matching Succession & Talent Dashboard style -->
            <div class="o_succ_header">
                <h1>Resignation Dashboard</h1>
                <p>Employee Separation &amp; Clearance Overview</p>
            </div>

            <!-- KPI Cards Row 1 -->
            <div class="row o_succ_kpi_row mb-3">
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="o_succ_kpi_card o_card_primary" t-on-click="onKpiClick" data-domain="all" style="cursor: pointer;">
                        <div class="o_kpi_icon"><i class="fa fa-folder-open-o"/></div>
                        <div class="o_kpi_info">
                            <h3><t t-esc="state.stats.total_requests || 0"/></h3>
                            <span>Total Requests</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="o_succ_kpi_card o_card_warning" t-on-click="onKpiClick" data-domain="draft" style="cursor: pointer;">
                        <div class="o_kpi_icon"><i class="fa fa-pencil"/></div>
                        <div class="o_kpi_info">
                            <h3><t t-esc="state.stats.draft_requests || 0"/></h3>
                            <span>Draft / Submitted</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="o_succ_kpi_card o_card_success" t-on-click="onKpiClick" data-domain="approved" style="cursor: pointer;">
                        <div class="o_kpi_icon"><i class="fa fa-user-md"/></div>
                        <div class="o_kpi_info">
                            <h3><t t-esc="state.stats.approved || 0"/></h3>
                            <span>HR Approved</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="o_succ_kpi_card" style="border-left-color: #726732; cursor: pointer;" t-on-click="onKpiClick" data-domain="clearance_in_progress">
                        <div class="o_kpi_icon" style="color: #726732;"><i class="fa fa-hourglass-half"/></div>
                        <div class="o_kpi_info">
                            <h3><t t-esc="state.stats.clearance_in_progress || 0"/></h3>
                            <span>Clearance In Progress</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- KPI Cards Row 2 -->
            <div class="row o_succ_kpi_row mb-4">
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="o_succ_kpi_card" style="border-left-color: #1e2917; cursor: pointer;" t-on-click="onKpiClick" data-domain="settlement_in_progress">
                        <div class="o_kpi_icon" style="color: #1e2917;"><i class="fa fa-calculator"/></div>
                        <div class="o_kpi_info">
                            <h3><t t-esc="state.stats.settlement_in_progress || 0"/></h3>
                            <span>Settlement In Progress</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="o_succ_kpi_card o_card_warning" t-on-click="onKpiClick" data-domain="waiting_payment" style="cursor: pointer;">
                        <div class="o_kpi_icon"><i class="fa fa-credit-card"/></div>
                        <div class="o_kpi_info">
                            <h3><t t-esc="state.stats.waiting_payment || 0"/></h3>
                            <span>Waiting Payment</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="o_succ_kpi_card o_card_success" t-on-click="onKpiClick" data-domain="completed" style="cursor: pointer;">
                        <div class="o_kpi_icon"><i class="fa fa-check-circle"/></div>
                        <div class="o_kpi_info">
                            <h3><t t-esc="state.stats.completed_requests || 0"/></h3>
                            <span>Completed</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="o_succ_kpi_card o_card_danger" t-on-click="onKpiClick" data-domain="overdue" style="cursor: pointer;">
                        <div class="o_kpi_icon"><i class="fa fa-exclamation-triangle"/></div>
                        <div class="o_kpi_info">
                            <h3><t t-esc="state.stats.overdue_clearances || 0"/></h3>
                            <span>Overdue Clearance</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Row -->
            <div class="row g-4 mb-4">
                <!-- Resignations By Type (Pie / Donut) -->
                <div class="col-12 col-lg-5">
                    <div class="o_succ_panel h-100">
                        <h4><i class="fa fa-pie-chart me-2"/> Resignations By Type</h4>
                        <div style="height: 310px; position: relative;">
                            <t t-if="!state.charts.pie or !state.charts.pie.data or state.charts.pie.data.length == 0">
                                <div class="h-100 d-flex align-items-center justify-content-center text-muted">No Data Available</div>
                            </t>
                            <canvas t-ref="pieChartCanvas"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Resignations By Department (Bar) -->
                <div class="col-12 col-lg-7">
                    <div class="o_succ_panel h-100">
                        <h4><i class="fa fa-bar-chart me-2"/> Resignations By Department</h4>
                        <div style="height: 310px; position: relative;">
                            <t t-if="!state.charts.bar or !state.charts.bar.data or state.charts.bar.data.length == 0">
                                <div class="h-100 d-flex align-items-center justify-content-center text-muted">No Data Available</div>
                            </t>
                            <canvas t-ref="barChartCanvas"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>