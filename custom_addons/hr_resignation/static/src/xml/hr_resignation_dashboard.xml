<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_resignation.Dashboard" owl="1">
        <div class="o_resignation_dashboard pb-5" style="background-color: #f8f9fa; min-height: 100vh;">
            <!-- Header -->
            <div class="o_resignation_header d-flex justify-content-between align-items-center bg-white p-4 mb-4 shadow-sm rounded-bottom-4" style="border-bottom: 2px solid #e9ecef;">
                <h2 class="m-0 font-weight-bold text-dark fs-3">Resignation Dashboard</h2>
            </div>

            <div class="container-fluid px-4">
                <!-- Section 1: Key Metrics -->
                <h6 class="text-uppercase fw-bold text-muted mb-3 fs-7 letter-spacing-1">Key Metrics</h6>
                <div class="mb-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.5rem;">
                    
                    <!-- Total Requests -->
                    <div>
                        <div t-on-click="() => this.openResignations('all')" class="o_stat_card card shadow-sm border-0 h-100 white-card p-2" style="background: #fff; border-radius: 0.75rem;">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h2 class="fw-bolder m-0 display-6 text-dark" t-esc="state.stats.total_requests || 0"/>
                                        <div class="text-muted fw-bold mt-1 fs-6" style="white-space: nowrap;">Total Requests</div>
                                    </div>
                                    <div class="icon-circle icon-light-purple shadow-sm" style="width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; background-color: #e5eadb; color: #425727;">
                                        <i class="fa fa-folder-open-o"/>
                                    </div>
                                </div>
                                <div class="trend-indicator text-muted fs-7 fw-bold" style="padding-top: 0.5rem; border-top: 1px solid #f3f4f6; margin-top: 0.5rem;">
                                    <i class="fa fa-users me-1"/> All Time
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Draft / Submitted -->
                    <div>
                        <div t-on-click="() => this.openResignations('draft')" class="o_stat_card card shadow-sm border-0 h-100 white-card p-2" style="background: #fff; border-radius: 0.75rem;">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h2 class="fw-bolder m-0 display-6 text-dark" t-esc="state.stats.draft_requests || 0"/>
                                        <div class="text-muted fw-bold mt-1 fs-6" style="white-space: nowrap;">Draft / Submitted</div>
                                    </div>
                                    <div class="icon-circle icon-light-blue shadow-sm" style="width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; background-color: #f8ebe3; color: #c17540;">
                                        <i class="fa fa-pencil"/>
                                    </div>
                                </div>
                                <div class="trend-indicator text-muted fs-7 fw-bold" style="padding-top: 0.5rem; border-top: 1px solid #f3f4f6; margin-top: 0.5rem;">
                                    <i class="fa fa-clock-o me-1"/> Pending Action
                                </div>
                            </div>
                        </div>
                    </div>



                    <!-- HR Approved -->
                    <div>
                        <div t-on-click="() => this.openResignations('hr_approved')" class="o_stat_card card shadow-sm border-0 h-100 white-card p-2" style="background: #fff; border-radius: 0.75rem;">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h2 class="fw-bolder m-0 display-6 text-dark" t-esc="state.stats.hr_approved || 0"/>
                                        <div class="text-muted fw-bold mt-1 fs-6" style="white-space: nowrap;">HR Approved</div>
                                    </div>
                                    <div class="icon-circle shadow-sm" style="width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; background-color: #ead3d4; color: #541718;">
                                        <i class="fa fa-user-md"/>
                                    </div>
                                </div>
                                <div class="trend-indicator text-danger fs-7 fw-bold" style="padding-top: 0.5rem; border-top: 1px solid #f3f4f6; margin-top: 0.5rem;">
                                    <i class="fa fa-arrow-right me-1"/> To Clearance
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Clearance In Progress -->
                    <div>
                        <div t-on-click="() => this.openResignations('clearing')" class="o_stat_card card shadow-sm border-0 h-100 white-card p-2" style="background: #fff; border-radius: 0.75rem;">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h2 class="fw-bolder m-0 display-6 text-dark" t-esc="state.stats.clearance_in_progress || 0"/>
                                        <div class="text-muted fw-bold mt-1 fs-6" style="white-space: nowrap;">Clearing</div>
                                    </div>
                                    <div class="icon-circle shadow-sm" style="width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; background-color: #e5eadb; color: #425727;">
                                        <i class="fa fa-tasks"/>
                                    </div>
                                </div>
                                <div class="trend-indicator text-warning fs-7 fw-bold" style="padding-top: 0.5rem; border-top: 1px solid #f3f4f6; margin-top: 0.5rem;">
                                    <i class="fa fa-refresh me-1"/> In Progress
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Completed -->
                    <div>
                        <div t-on-click="() => this.openResignations('completed')" class="o_stat_card card shadow-sm border-0 h-100 white-card p-2" style="background: #fff; border-radius: 0.75rem;">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h2 class="fw-bolder m-0 display-6 text-dark" t-esc="state.stats.completed_requests || 0"/>
                                        <div class="text-muted fw-bold mt-1 fs-6" style="white-space: nowrap;">Completed</div>
                                    </div>
                                    <div class="icon-circle shadow-sm" style="width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; background-color: #e8f5e9; color: #2e7d32;">
                                        <i class="fa fa-check"/>
                                    </div>
                                </div>
                                <div class="trend-indicator text-success fs-7 fw-bold" style="padding-top: 0.5rem; border-top: 1px solid #f3f4f6; margin-top: 0.5rem;">
                                    <i class="fa fa-check-circle me-1"/> Fully Settled
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Overdue Clearances -->
                    <div>
                        <div t-on-click="() => this.openResignations('overdue')" class="o_stat_card card shadow-sm border-0 h-100 white-card p-2" style="background: #fff; border-radius: 0.75rem;">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h2 class="fw-bolder m-0 display-6 text-dark" t-esc="state.stats.overdue_clearances || 0"/>
                                        <div class="text-muted fw-bold mt-1 fs-6" style="white-space: nowrap;">Overdue Clearance</div>
                                    </div>
                                    <div class="icon-circle shadow-sm" style="width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; background-color: #fee2e2; color: #b91c1c;">
                                        <i class="fa fa-exclamation"/>
                                    </div>
                                </div>
                                <div class="trend-indicator text-danger fs-7 fw-bold" style="padding-top: 0.5rem; border-top: 1px solid #f3f4f6; margin-top: 0.5rem;">
                                    <i class="fa fa-warning me-1"/> Needs Action
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-5">
                    <!-- Resignations By Type (Pie) -->
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 h-100 white-card p-3" style="background: #fff; border-radius: 0.75rem;">
                            <div class="card-body">
                                <h6 class="text-uppercase fw-bold text-muted mb-4 fs-7 letter-spacing-1">Resignations By Type</h6>
                                <div style="height: 250px; position: relative;">
                                    <t t-if="state.charts.pie and state.charts.pie.data.length == 0">
                                        <div class="h-100 d-flex align-items-center justify-content-center text-muted">No Data Available</div>
                                    </t>
                                    <canvas t-ref="pieChartCanvas"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Resignations By Department (Bar) -->
                    <div class="col-md-8">
                        <div class="card shadow-sm border-0 h-100 white-card p-3" style="background: #fff; border-radius: 0.75rem;">
                            <div class="card-body">
                                <h6 class="text-uppercase fw-bold text-muted mb-4 fs-7 letter-spacing-1">Resignations By Department</h6>
                                <div style="height: 250px; position: relative;">
                                    <t t-if="state.charts.bar and state.charts.bar.data.length == 0">
                                        <div class="h-100 d-flex align-items-center justify-content-center text-muted">No Data Available</div>
                                    </t>
                                    <canvas t-ref="barChartCanvas"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </t>
</templates>
