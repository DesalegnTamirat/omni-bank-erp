<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Main Tax Rule -->
        <record id="default_ethiopian_tax_rule" model="hr.tax.rule">
            <field name="name">Standard Ethiopian Income Tax</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Tax Brackets -->
        <record id="tax_bracket_1" model="hr.tax.bracket">
            <field name="tax_rule_id" ref="default_ethiopian_tax_rule"/>
            <field name="sequence">10</field>
            <field name="min_amount">0.0</field>
            <field name="max_amount">2000.0</field>
            <field name="rate">0.0</field>
            <field name="addback_amount">0.0</field>
        </record>

        <record id="tax_bracket_2" model="hr.tax.bracket">
            <field name="tax_rule_id" ref="default_ethiopian_tax_rule"/>
            <field name="sequence">20</field>
            <field name="min_amount">2001.0</field>
            <field name="max_amount">4000.0</field>
            <field name="rate">15.0</field>
            <field name="addback_amount">300.0</field>
        </record>

        <record id="tax_bracket_3" model="hr.tax.bracket">
            <field name="tax_rule_id" ref="default_ethiopian_tax_rule"/>
            <field name="sequence">30</field>
            <field name="min_amount">4001.0</field>
            <field name="max_amount">7000.0</field>
            <field name="rate">20.0</field>
            <field name="addback_amount">500.0</field>
        </record>

        <record id="tax_bracket_4" model="hr.tax.bracket">
            <field name="tax_rule_id" ref="default_ethiopian_tax_rule"/>
            <field name="sequence">40</field>
            <field name="min_amount">7001.0</field>
            <field name="max_amount">10000.0</field>
            <field name="rate">25.0</field>
            <field name="addback_amount">850.0</field>
        </record>

        <record id="tax_bracket_5" model="hr.tax.bracket">
            <field name="tax_rule_id" ref="default_ethiopian_tax_rule"/>
            <field name="sequence">50</field>
            <field name="min_amount">10001.0</field>
            <field name="max_amount">14000.0</field>
            <field name="rate">30.0</field>
            <field name="addback_amount">1350.0</field>
        </record>

        <record id="tax_bracket_6" model="hr.tax.bracket">
            <field name="tax_rule_id" ref="default_ethiopian_tax_rule"/>
            <field name="sequence">60</field>
            <field name="min_amount">14001.0</field>
            <field name="max_amount">0.0</field> <!-- 0.0 means infinity based on model logic -->
            <field name="rate">35.0</field>
            <field name="addback_amount">2050.0</field>
        </record>
    </data>
</odoo>
