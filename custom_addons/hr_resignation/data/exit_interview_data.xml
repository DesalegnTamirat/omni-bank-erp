        <record id="q17" model="hr.exit.interview.question">
            <field name="template_id" ref="default_exit_interview_template"/>
            <field name="sequence">17</field>
            <field name="section">SECTION E: Pay and Recognition</field>
            <field name="name">My pay was fair compared to similar roles outside the bank</field>
