            <field name="template_id" ref="default_exit_interview_template"/>
            <field name="sequence">11</field>
            <field name="section">SECTION D: COMPANY CULTURE &amp; WORK ENVIRONMENT</field>
            <field name="name">I experienced RESPECT at work</field>
            <field name="question_type">custom</field>
