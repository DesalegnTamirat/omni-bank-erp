        <record id="q11_o1" model="hr.exit.interview.question.option"><field name="question_id" ref="q11"/><field name="name">1 - Strongly Disagree</field></record>
        <record id="q11_o2" model="hr.exit.interview.question.option"><field name="question_id" ref="q11"/><field name="name">2 - Disagree</field></record>
        <record id="q11_o3" model="hr.exit.interview.question.option"><field name="question_id" ref="q11"/><field name="name">3 - Neutral</field></record>
