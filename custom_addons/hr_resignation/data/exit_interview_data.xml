            <field name="template_id" ref="default_exit_interview_template"/>
            <field name="sequence">14</field>
            <field name="section">SECTION D: COMPANY CULTURE &amp; WORK ENVIRONMENT</field>
            <field name="name">High performance (WINNING) was supported</field>
            <field name="question_type">custom</field>
        </record>
        <record id="q14_o1" model="hr.exit.interview.question.option"><field name="question_id" ref="q14"/><field name="name">1 - Strongly Disagree</field></record>
        <record id="q14_o2" model="hr.exit.interview.question.option"><field name="question_id" ref="q14"/><field name="name">2 - Disagree</field></record>
