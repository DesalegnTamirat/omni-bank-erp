        <record id="q10" model="hr.exit.interview.question">
            <field name="template_id" ref="default_exit_interview_template"/>
            <field name="sequence">10</field>
            <field name="section">SECTION C: MANAGEMENT &amp; SUPERVISION</field>
            <field name="name">What should your manager improve?</field>
            <field name="question_type">text</field>
        </record>

