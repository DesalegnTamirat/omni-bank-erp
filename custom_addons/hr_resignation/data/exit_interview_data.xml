<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Keep the template creation in noupdate="1" to avoid overwriting user edits to the default template name/active status -->
    <data noupdate="1">
        <record id="default_exit_interview_template" model="hr.exit.interview.template">
            <field name="name">Standard Exit Interview</field>
            <field name="active" eval="True"/>
        </record>
    </data>

    <!-- Always load/update default questions for the standard template -->
    <data>
        <!-- Section A: Reason for Leaving -->
        <record id="q1" model="hr.exit.interview.question">
            <field name="template_id" ref="default_exit_interview_template"/>
            <field name="sequence">1</field>
            <field name="section">SECTION A: Reason for Leaving</field>
            <field name="name">What is the MAIN reason you are leaving? (select all that apply)</field>
            <field name="question_type">checkbox</field>
        </record>
        <record id="q1_o1" model="hr.exit.interview.question.option"><field name="question_id" ref="q1"/><field name="name">Better pay elsewhere</field></record>
        <record id="q1_o2" model="hr.exit.interview.question.option"><field name="question_id" ref="q1"/><field name="name">Better career growth</field></record>
        <record id="q1_o3" model="hr.exit.interview.question.option"><field name="question_id" ref="q1"/><field name="name">Relationship with manager/Supervisor</field></record>
        <record id="q1_o4" model="hr.exit.interview.question.option"><field name="question_id" ref="q1"/><field name="name">Workload /Work stress</field></record>
        <record id="q1_o5" model="hr.exit.interview.question.option"><field name="question_id" ref="q1"/><field name="name">Work-life balance</field></record>
        <record id="q1_o6" model="hr.exit.interview.question.option"><field name="question_id" ref="q1"/><field name="name">Relationship with peer/Team dynamics</field></record>
        <record id="q1_o7" model="hr.exit.interview.question.option"><field name="question_id" ref="q1"/><field name="name">Lack of recognition or feedback</field></record>
        <record id="q1_o8" model="hr.exit.interview.question.option"><field name="question_id" ref="q1"/><field name="name">Role dissatisfaction</field></record>
        <record id="q1_o9" model="hr.exit.interview.question.option"><field name="question_id" ref="q1"/><field name="name">Company Culture/ Values misalignment</field></record>
        <record id="q1_o10" model="hr.exit.interview.question.option"><field name="question_id" ref="q1"/><field name="name">Other</field></record>

        <record id="q2" model="hr.exit.interview.question">
            <field name="template_id" ref="default_exit_interview_template"/>
            <field name="sequence">2</field>
            <field name="section">SECTION A: Reason for Leaving</field>
            <field name="name">Did you raise any concerns with your manager or HR prior to deciding to leave?</field>
            <field name="question_type">boolean</field>
        </record>

        <record id="q3" model="hr.exit.interview.question">
            <field name="template_id" ref="default_exit_interview_template"/>
            <field name="sequence">3</field>
            <field name="section">SECTION A: Reason for Leaving</field>
            <field name="name">Is there anything the company could have done differently to retain you?</field>
            <field name="question_type">text</field>
        </record>

        <!-- Section B -->
        <record id="q4" model="hr.exit.interview.question">
            <field name="template_id" ref="default_exit_interview_template"/>
            <field name="sequence">4</field>
            <field name="section">SECTION B: JOB ROLE &amp; RESPONSIBILITIES</field>
            <field name="name">Were your job responsibilities clearly defined when you joined?</field>
            <field name="question_type">custom</field>
        </record>
        <record id="q4_o1" model="hr.exit.interview.question.option"><field name="question_id" ref="q4"/><field name="sequence">1</field><field name="name">Yes</field></record>
        <record id="q4_o2" model="hr.exit.interview.question.option"><field name="question_id" ref="q4"/><field name="sequence">2</field><field name="name">No</field></record>
        <record id="q4_o3" model="hr.exit.interview.question.option"><field name="question_id" ref="q4"/><field name="sequence">3</field><field name="name">Somewhat</field></record>

        <record id="q5" model="hr.exit.interview.question">
            <field name="template_id" ref="default_exit_interview_template"/>
            <field name="sequence">5</field>
            <field name="section">SECTION B: JOB ROLE &amp; RESPONSIBILITIES</field>
            <field name="name">Was your workload reasonable and manageable?</field>
            <field name="question_type">custom</field>
        </record>
        <record id="q5_o1" model="hr.exit.interview.question.option"><field name="question_id" ref="q5"/><field name="sequence">1</field><field name="name">Always</field></record>
        <record id="q5_o2" model="hr.exit.interview.question.option"><field name="question_id" ref="q5"/><field name="sequence">2</field><field name="name">Usually</field></record>
        <record id="q5_o3" model="hr.exit.interview.question.option"><field name="question_id" ref="q5"/><field name="sequence">3</field><field name="name">Sometimes</field></record>
        <record id="q5_o4" model="hr.exit.interview.question.option"><field name="question_id" ref="q5"/><field name="sequence">4</field><field name="name">Rarely</field></record>
        <record id="q5_o5" model="hr.exit.interview.question.option"><field name="question_id" ref="q5"/><field name="sequence">5</field><field name="name">Never</field></record>

        <record id="q6" model="hr.exit.interview.question">
            <field name="template_id" ref="default_exit_interview_template"/>
            <field name="sequence">6</field>
            <field name="section">SECTION B: JOB ROLE &amp; RESPONSIBILITIES</field>
            <field name="name">Did you feel adequately trained and equipped with the tools/resources to succeed?</field>
            <field name="question_type">custom</field>
        </record>
        <record id="q6_o1" model="hr.exit.interview.question.option"><field name="question_id" ref="q6"/><field name="sequence">1</field><field name="name">Yes</field></record>
        <record id="q6_o2" model="hr.exit.interview.question.option"><field name="question_id" ref="q6"/><field name="sequence">2</field><field name="name">No</field></record>
        <record id="q6_o3" model="hr.exit.interview.question.option"><field name="question_id" ref="q6"/><field name="sequence">3</field><field name="name">Partially</field></record>

        <!-- Section C -->
