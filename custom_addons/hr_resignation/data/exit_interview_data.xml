            <field name="template_id" ref="default_exit_interview_template"/>
            <field name="sequence">7</field>
            <field name="section">SECTION C: MANAGEMENT &amp; SUPERVISION</field>
            <field name="name">How would you describe your relationship with your direct manager?</field>
