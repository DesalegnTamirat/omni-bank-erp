<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_clearance_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.clearance.reject.wizard.form</field>
        <field name="model">hr.clearance.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Clearance">
                <field name="clearance_line_id" invisible="1"/>
                <group>
                    <field name="rejection_reason" nolabel="1"
                           placeholder="Explain why this clearance line is being rejected..."/>
                </group>
                <footer>
                    <button string="Confirm Rejection" type="object"
                            name="action_confirm_reject"
                            class="btn-danger"
                            confirm="This will reject the clearance line. Continue?"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>