<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════
         SECURITY GROUPS

         Privilege ladder (mutually exclusive selection in UI):
           No Access → Manager → Clearance Officer → POMD Officer
                     → HR Manager → Administrator

         The implied_ids chain grants cumulative permissions upward.

         Menu visibility uses MARKER groups (group_menu_*) that are
         assigned to exactly the target privilege level and are NOT
         inherited by higher levels. This lets us show "My Team's
         Resignations" ONLY to Managers and "My Clearance Tasks" ONLY
         to Clearance Officers, regardless of the implied hierarchy.
    ════════════════════════════════════════════════════════════════ -->

    <record model="ir.module.category" id="module_category_hr_resignation">
        <field name="name">Resignation and Clearance</field>
        <field name="description">Access levels for the Resignation and Clearance process.</field>
        <field name="sequence">15</field>
    </record>

    <record model="res.groups.privilege" id="privilege_hr_resignation">
        <field name="name">Resignation Access</field>
        <field name="category_id" ref="module_category_hr_resignation"/>
    </record>

    <!-- Make all employees (Internal Users) automatically get Resignation User rights -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ── Privilege levels ───────────────────────────────────────── -->

    <!-- User: base user who can submit and track their own requests -->
    <record id="group_resignation_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_hr_resignation"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
        ]"/>
    </record>

    <!-- Manager: only base_user + hr_manager. No higher groups implied. -->
    <record id="group_resignation_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_hr_resignation"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
        ]"/>
    </record>

    <!-- Clearance Officer: stands alone — does NOT imply group_resignation_manager.
         Record rules and model access give the necessary permissions directly. -->
    <record id="group_clearance_officer" model="res.groups">
        <field name="name">Clearance Officer</field>
        <field name="privilege_id" ref="privilege_hr_resignation"/>
        <field name="implied_ids" eval="[
            (3, ref('hr_resignation.group_resignation_manager')),
            (4, ref('base.group_user')),
        ]"/>
    </record>

    <!-- POMD Officer: stands alone — does NOT imply group_clearance_officer. -->
    <record id="group_pomd_officer" model="res.groups">
        <field name="name">POMD Officer</field>
        <field name="privilege_id" ref="privilege_hr_resignation"/>
        <field name="implied_ids" eval="[
            (3, ref('hr_resignation.group_resignation_manager')),
            (3, ref('hr_resignation.group_clearance_officer')),
            (4, ref('base.group_user')),
            (4, ref('hr.group_hr_manager')),
        ]"/>
    </record>

    <record id="group_resignation_hr_manager" model="res.groups">
        <field name="name">HR Manager</field>
        <field name="privilege_id" ref="privilege_hr_resignation"/>
        <field name="implied_ids" eval="[
            (3, ref('hr_resignation.group_resignation_manager')),
            (3, ref('hr_resignation.group_clearance_officer')),
            (3, ref('hr_resignation.group_pomd_officer')),
            (4, ref('base.group_user')),
            (4, ref('hr.group_hr_manager')),
        ]"/>
    </record>

    <record id="group_resignation_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_hr_resignation"/>
        <field name="implied_ids" eval="[
            (3, ref('hr_resignation.group_resignation_manager')),
            (3, ref('hr_resignation.group_clearance_officer')),
            (3, ref('hr_resignation.group_pomd_officer')),
            (4, ref('hr_resignation.group_resignation_hr_manager')), 
            (4, ref('base.group_system'))
        ]"/>
    </record>

    <!-- ── Marker groups (NOT part of the privilege ladder) ──────────
         No longer needed — privileges are now non-hierarchical so each
         group is mutually exclusive and can be used directly on menus.
    ─────────────────────────────────────────────────────────────── -->


    <!-- ════════════════════════════════════════════════════════════════
         RECORD RULES — hr.resignation

         Visibility strategy by state:
         ┌─────────────────────┬──────────┬─────────┬──────┬──────┐
         │ State               │ Employee │ Manager │ POMD │  HR  │
         ├─────────────────────┼──────────┼─────────┼──────┼──────┤
         │ draft               │    ✓     │         │      │      │
         │ submitted           │    ✓     │    ✓    │      │      │
         │ manager_reviewed /  │    ✓     │    ✓    │  ✓   │  ✓   │
         │   manager_rejected  │          │         │      │      │
         │ hr_approved → done  │    ✓     │    ✓    │  ✓   │  ✓   │
         └─────────────────────┴──────────┴─────────┴──────┴──────┘

         Key rule: while state = 'submitted', ONLY the direct manager
         (manager_id.user_id) can see the record. HR and POMD are
         excluded until the manager acts (approves or rejects).

         Rules on different groups are evaluated independently with OR
         between groups, so keeping employee and manager rules on
         separate groups prevents accidental cross-visibility.
    ════════════════════════════════════════════════════════════════ -->

    <!-- Employees see only their own requests -->
    <record id="hr_resignation_rule_employee" model="ir.rule">
        <field name="name">Resignation: Employee sees own records</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Clearance Officers see hr.resignation records where they are
        the responsible user on at least one clearance line.
        This gives them access to the parent resignation form so they
        can reach the "Separation check list" tab and clear/reject.
        Placed on group_clearance_officer (NOT base.group_user) so it
        evaluates independently from the employee rule.
    -->
    <record id="hr_resignation_rule_clearance_officer" model="ir.rule">
        <field name="name">Resignation: Clearance Officer sees assigned resignations</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <field name="domain_force">[('clearance_line_ids.responsible_user', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_clearance_officer'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Managers see their direct reports' requests at ALL states.
        Placed on group_resignation_manager (not base.group_user) so it
        does NOT OR-merge with the employee rule above.
        manager_id is a stored compute so this domain is always reliable.
    -->
    <record id="hr_resignation_rule_manager" model="ir.rule">
        <field name="name">Resignation: Manager sees team requests and managed clearance</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <field name="domain_force">['|', ('manager_id.user_id', '=', user.id), ('clearance_line_ids.work_unit_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_resignation_manager'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        POMD Officers see ALL records regardless of state.
        They need full visibility across the entire workflow —
        including 'submitted' cases — so they can monitor and step in
        if a manager is delayed.
    -->
    <record id="hr_resignation_rule_pomd" model="ir.rule">
        <field name="name">Resignation: POMD sees all records</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_pomd_officer'))]"/>
    </record>

    <!--
        HR Manager sees ALL records (any state except submitted, per existing rule)
        AND also sees their direct reports at ALL states including submitted —
        so they can monitor their own team without waiting for manager action.
    -->
    <record id="hr_resignation_rule_hr_manager_team" model="ir.rule">
        <field name="name">Resignation: HR Manager sees own direct reports at all states</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <field name="domain_force">[('manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_resignation_hr_manager'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- HR Manager sees all non-draft records -->
    <record id="hr_resignation_rule_hr" model="ir.rule">
        <field name="name">Resignation: HR sees post-draft records</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation"/>
        <!-- Previously excluded 'submitted' because manager did it first. Now HR does it first. -->
        <field name="domain_force">[('state', '!=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_resignation_hr_manager'))]"/>
    </record>


    <!-- ════════════════════════════════════════════════════════════════
         RECORD RULES — hr.resignation.clearance (runtime lines)
    ════════════════════════════════════════════════════════════════ -->

    <!-- Employee sees their own clearance lines -->
    <record id="hr_clearance_rule_employee" model="ir.rule">
        <field name="name">Clearance Line: Employee sees own</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance"/>
        <field name="domain_force">[('resignation_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_clearance_rule_unit_manager" model="ir.rule">
        <field name="name">Clearance Line: Unit Manager sees lines they manage</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance"/>
        <field name="domain_force">[('work_unit_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Manager sees clearance lines for their team OR lines they need to approve as work unit manager -->
    <record id="hr_clearance_rule_manager" model="ir.rule">
        <field name="name">Clearance Line: Manager sees team's lines OR lines they manage</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance"/>
        <field name="domain_force">['|', ('resignation_id.manager_id.user_id', '=', user.id), ('work_unit_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_resignation_manager'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Clearance Officers: see only lines where they are the responsible user.
        This is the primary rule — the action domain also filters to pending/rejected
        but the record rule ensures they can never read other users' lines.
    -->
    <record id="hr_clearance_rule_responsible" model="ir.rule">
        <field name="name">Clearance Line: Officer sees own assigned lines</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance"/>
        <field name="domain_force">[('responsible_user', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_clearance_officer'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- POMD Officers see all clearance lines -->
    <record id="hr_clearance_rule_pomd" model="ir.rule">
        <field name="name">Clearance Line: POMD sees all lines</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_pomd_officer'))]"/>
    </record>

    <!-- HR sees all clearance lines -->
    <record id="hr_clearance_rule_hr" model="ir.rule">
        <field name="name">Clearance Line: HR sees all lines</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>


    <!-- ════════════════════════════════════════════════════════════════
         RECORD RULES — hr.resignation.clearance.template (config)
    ════════════════════════════════════════════════════════════════ -->

    <!--
        Template configuration is restricted to POMD and HR.
        Regular Clearance Officers have read-only access.
    -->
    <record id="hr_clearance_template_rule_officer" model="ir.rule">
        <field name="name">Clearance Template: Officer read-only</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance_template"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_clearance_officer'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_clearance_template_rule_pomd" model="ir.rule">
        <field name="name">Clearance Template: POMD full access</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance_template"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_pomd_officer'))]"/>
    </record>

    <record id="hr_clearance_template_rule_hr" model="ir.rule">
        <field name="name">Clearance Template: HR full access</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance_template"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>


    <!-- ════════════════════════════════════════════════════════════════
         RECORD RULES — hr.resignation.clearance.line.item (sub-tasks)
    ════════════════════════════════════════════════════════════════ -->

    <!-- Employee sees their own clearance line items -->
    <record id="hr_clearance_item_rule_employee" model="ir.rule">
        <field name="name">Clearance Item: Employee sees own</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance_line_item"/>
        <field name="domain_force">[('clearance_line_id.resignation_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_clearance_item_rule_manager" model="ir.rule">
        <field name="name">Clearance Item: Manager sees team's items OR items they manage</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance_line_item"/>
        <field name="domain_force">['|', ('clearance_line_id.resignation_id.manager_id.user_id', '=', user.id), ('clearance_line_id.work_unit_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_resignation_manager'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Clearance Officers see only items belonging to their own lines.
        Uses a subquery via the parent line's responsible_user.
    -->
    <record id="hr_clearance_item_rule_officer" model="ir.rule">
        <field name="name">Clearance Item: Officer sees own line items</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance_line_item"/>
        <field name="domain_force">[
            ('clearance_line_id.responsible_user', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_clearance_officer'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- POMD and HR see all sub-items -->
    <record id="hr_clearance_item_rule_pomd" model="ir.rule">
        <field name="name">Clearance Item: POMD sees all</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance_line_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_pomd_officer'))]"/>
    </record>

    <record id="hr_clearance_item_rule_hr" model="ir.rule">
        <field name="name">Clearance Item: HR sees all</field>
        <field name="model_id" ref="hr_resignation.model_hr_resignation_clearance_line_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>



    <!-- ════════════════════════════════════════════════════════════════
         RECORD RULES — hr.exit.interview
    ════════════════════════════════════════════════════════════════ -->

    <!-- Employee sees their own exit interviews -->
    <record id="hr_exit_interview_rule_employee" model="ir.rule">
        <field name="name">Exit Interview: Employee sees own</field>
        <field name="model_id" ref="hr_resignation.model_hr_exit_interview"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- POMD and HR Manager see all exit interviews -->
    <record id="hr_exit_interview_rule_pomd" model="ir.rule">
        <field name="name">Exit Interview: POMD sees all</field>
        <field name="model_id" ref="hr_resignation.model_hr_exit_interview"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_resignation.group_pomd_officer'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>



    <record id="hr_exit_interview_rule_hr" model="ir.rule">
        <field name="name">Exit Interview: HR sees all</field>
        <field name="model_id" ref="hr_resignation.model_hr_exit_interview"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
