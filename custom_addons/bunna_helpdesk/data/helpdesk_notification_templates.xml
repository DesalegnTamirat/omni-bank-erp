                                                <td align="right" valign="middle">
                                                    <span style="background-color:#198754;color:#ffffff;padding:5px 14px;border-radius:20px;font-size:11px;font-weight:bold;letter-spacing:0.5px;text-transform:uppercase;display:inline-block;">
                                                        COMPLETED
