<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- ── Acceptance Email Template ──────────────────────────────────────── -->
        <record id="email_template_service_request_accepted" model="mail.template">
            <field name="name">Service Request Acceptance</field>
            <field name="model_id" ref="bunna_helpdesk.model_helpdesk_ticket" />
            <field name="email_from">{{ object.company_id.partner_id.email or 'support@bunnabanksc.com' }}</field>
            <field name="email_to">{{ object.partner_email or object.partner_id.email or '' }}</field>
            <field name="subject">Bunna Bank: Service Request {{ object.number }} Accepted</field>
            <field name="auto_delete" eval="False" />
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f4f6f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;padding:25px 0;">
                    <tr>
                        <td align="center">
                            <table border="0" cellpadding="0" cellspacing="0" width="600" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                                <!-- HEADER -->
                                <tr>
                                    <td style="background:linear-gradient(135deg, #541718 0%, #3a0d0e 60%, #1d2b32 100%);background-color:#541718;padding:20px 24px;border-bottom:3px solid #c17540;">
                                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                            <tr>
                                                <td align="left" valign="middle">
                                                    <span style="color:#ffffff;font-size:18px;font-weight:bold;letter-spacing:0.5px;display:block;">BUNNA BANK S.C.</span>
                                                    <span style="color:#f3d7c5;font-size:11px;display:block;margin-top:2px;">Bank of the Visionaries • Contact Center: 8501</span>
                                                </td>
                                                <td align="right" valign="middle">
                                                    <span style="background-color:#c17540;color:#ffffff;padding:5px 14px;border-radius:20px;font-size:11px;font-weight:bold;letter-spacing:0.5px;text-transform:uppercase;display:inline-block;">
                                                        ACCEPTED
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <!-- BODY -->
                                <tr>
                                    <td style="padding:28px 24px;font-size:14px;color:#1D2B32;line-height:1.6;">
                                        <p style="margin-top:0;margin-bottom:14px;font-size:15px;">
                                            Dear <strong style="color:#0f172a;"><t t-out="object.partner_id.name or object.partner_name or 'Customer'" /></strong>,
                                        </p>
                                        <p style="margin-bottom:16px;">
                                            Your service request <strong style="color:#541718;"><t t-out="object.number or ''" /></strong> has been <strong style="color:#c17540;">accepted</strong> and is currently being processed by our support team.
                                        </p>
                                        <p style="margin-bottom:20px;color:#475569;">
                                            We will keep you informed as progress is made on your ticket. Below are the details of your request for your reference:
                                        </p>

                                        <!-- DETAILS TABLE -->
                                        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:22px;border:1px solid #e2e8f0;border-radius:6px;overflow:hidden;">
                                            <tr>
                                                <td style="padding:10px 14px;background:#fafaf9;width:35%;font-weight:600;color:#64748b;font-size:12px;border-bottom:1px solid #e2e8f0;">Ticket Number</td>
                                                <td style="padding:10px 14px;font-weight:bold;color:#541718;font-size:13px;border-bottom:1px solid #e2e8f0;"><t t-out="object.number or ''" /></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:10px 14px;background:#fafaf9;font-weight:600;color:#64748b;font-size:12px;border-bottom:1px solid #e2e8f0;">Subject</td>
                                                <td style="padding:10px 14px;color:#1e293b;font-size:13px;border-bottom:1px solid #e2e8f0;"><t t-out="object.name or ''" /></td>
                                            </tr>
                                            <tr t-if="object.service_id">
                                                <td style="padding:10px 14px;background:#fafaf9;font-weight:600;color:#64748b;font-size:12px;border-bottom:1px solid #e2e8f0;">Product / Service</td>
                                                <td style="padding:10px 14px;color:#1e293b;font-size:13px;border-bottom:1px solid #e2e8f0;"><t t-out="object.service_id.name" /></td>
                                            </tr>
                                            <tr t-if="object.service_family_id or object.category_id">
                                                <td style="padding:10px 14px;background:#fafaf9;font-weight:600;color:#64748b;font-size:12px;border-bottom:1px solid #e2e8f0;">Service Category</td>
                                                <td style="padding:10px 14px;color:#1e293b;font-size:13px;border-bottom:1px solid #e2e8f0;"><t t-out="object.service_family_id.name or object.category_id.name" /></td>
                                            </tr>
                                            <tr t-if="object.service_sub_category_id">
                                                <td style="padding:10px 14px;background:#fafaf9;font-weight:600;color:#64748b;font-size:12px;border-bottom:1px solid #e2e8f0;">Request Type</td>
                                                <td style="padding:10px 14px;color:#1e293b;font-size:13px;border-bottom:1px solid #e2e8f0;"><t t-out="object.service_sub_category_id.name" /></td>
                                            </tr>
                                            <tr t-if="object.account_number">
                                                <td style="padding:10px 14px;background:#fafaf9;font-weight:600;color:#64748b;font-size:12px;border-bottom:1px solid #e2e8f0;">Account Number</td>
                                                <td style="padding:10px 14px;color:#1e293b;font-size:13px;border-bottom:1px solid #e2e8f0;"><t t-out="object.account_number" /></td>
                                            </tr>
                                            <tr t-if="object.team_id">
                                                <td style="padding:10px 14px;background:#fafaf9;font-weight:600;color:#64748b;font-size:12px;border-bottom:1px solid #e2e8f0;">Assigned Team</td>
                                                <td style="padding:10px 14px;color:#1e293b;font-size:13px;border-bottom:1px solid #e2e8f0;"><t t-out="object.team_id.name" /></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:10px 14px;background:#fafaf9;font-weight:600;color:#64748b;font-size:12px;border-bottom:1px solid #e2e8f0;">Current Status</td>
                                                <td style="padding:10px 14px;font-weight:600;color:#c17540;font-size:13px;border-bottom:1px solid #e2e8f0;"><t t-out="object.stage_id.name or 'In Progress'" /></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:10px 14px;background:#fafaf9;font-weight:600;color:#64748b;font-size:12px;">Submitted On</td>
                                                <td style="padding:10px 14px;color:#1e293b;font-size:13px;"><t t-out="format_datetime(object.create_date, tz=object.partner_id.tz or user.tz, dt_format='medium') if object.create_date else ''" /></td>
                                            </tr>
                                        </table>

                                        <!-- SIGNATURE -->
                                        <p style="margin-top:24px;margin-bottom:4px;color:#334155;">Best regards,</p>
                                        <p style="margin:0;font-weight:bold;color:#541718;font-size:15px;">Bunna Bank S.C.</p>
                                        <p style="margin-top:4px;margin-bottom:0;font-size:12px;color:#64748b;line-height:1.5;">
                                            Customer Contact Center: <strong style="color:#541718;">+251-111-580861,Head Office,8501, Contact center</strong><br/>
                                            Email: <a href="mailto:ContactCenter@bunnabanksc.com" style="color:#c17540;text-decoration:none;">support@bunnabanksc.com</a> | Website: <a href="https://www.bunnabanksc.com" style="color:#c17540;text-decoration:none;">www.bunnabanksc.com</a>
                                        </p>
                                    </td>
                                </tr>
                                <!-- FOOTER NOTICE -->
                                <tr>
                                    <td style="background-color:#f8fafc;padding:12px 24px;border-top:1px solid #e2e8f0;text-align:center;font-size:11px;color:#94a3b8;">
                                        This is an automated notification from Bunna Bank S.C. Helpdesk System. Please do not reply directly to this email.
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </field>
        </record>

        <!-- ── Completion Email Template ──────────────────────────────────────── -->
        <record id="email_template_service_request_completed" model="mail.template">
            <field name="name">Service Request Completion</field>
            <field name="model_id" ref="bunna_helpdesk.model_helpdesk_ticket" />
            <field name="email_from">{{ object.company_id.partner_id.email or 'support@bunnabanksc.com' }}</field>
            <field name="email_to">{{ object.partner_email or object.partner_id.email or '' }}</field>
            <field name="subject">Bunna Bank: Service Request {{ object.number }} Completed</field>
            <field name="auto_delete" eval="False" />
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f4f6f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;padding:25px 0;">
                    <tr>
                        <td align="center">
                            <table border="0" cellpadding="0" cellspacing="0" width="600" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                                <!-- HEADER -->
                                <tr>
                                    <td style="background:linear-gradient(135deg, #541718 0%, #3a0d0e 60%, #1d2b32 100%);background-color:#541718;padding:20px 24px;border-bottom:3px solid #198754;">
                                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                            <tr>
                                                <td align="left" valign="middle">
                                                    <span style="color:#ffffff;font-size:18px;font-weight:bold;letter-spacing:0.5px;display:block;">BUNNA BANK S.C.</span>
                                                    <span style="color:#f3d7c5;font-size:11px;display:block;margin-top:2px;">Bank of the Visionaries • Contact Center: 8501</span>
