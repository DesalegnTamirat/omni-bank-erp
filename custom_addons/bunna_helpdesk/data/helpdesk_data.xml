<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <data noupdate="0">
        <!--Email template -->
        <record id="assignment_email_template" model="mail.template">
            <field name="name">Ticket Assignment</field>
            <field name="model_id" ref="model_helpdesk_ticket" />
            <field name="email_from">{{object.company_id.partner_id.email or 'support@bunnabanksc.com'}}</field>
            <field
                name="email_cc"
            >{{not object.partner_id and object.partner_email or ''}},</field>
            <field
                name="subject"
            >Bunna Bank: Ticket Assignment (Ref {{object.number or 'n/a' }})</field>
            <field name="partner_to">{{object.partner_id.id}}</field>
            <field name="auto_delete" eval="False" />
            <field name="lang">{{object.partner_id.lang}}</field>
            <field name="body_html" type="html">
                <table
                    border="0"
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    bgcolor="#f4f6f8"
                    style="padding: 25px; background-color: #f4f6f8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;"
                >
                    <tbody>
                        <!-- HEADER -->
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table
                                    width="590"
                                    border="0"
                                    cellpadding="0"
                                    cellspacing="0"
                                    bgcolor="#541718"
                                    style="min-width: 590px; background: linear-gradient(135deg, #541718 0%, #3a0d0e 60%, #1d2b32 100%); background-color: #541718; border-bottom: 3px solid #c17540; border-radius: 6px 6px 0 0; padding: 18px 24px; border-collapse: separate;"
                                >
                                    <tr>
                                        <td valign="middle" align="left">
                                            <table border="0" cellpadding="0" cellspacing="0">
                                                <tr>
                                                    <td valign="middle" style="padding-right: 12px;">
                                                        <img
                                                            src="/bunna_helpdesk/static/src/img/bunna_logo.png"
                                                            style="height: 44px; width: auto; background-color: #ffffff; padding: 3px 8px; border-radius: 6px; display: block;"
                                                            alt="Bunna Bank Logo"
                                                        />
                                                    </td>
                                                    <td valign="middle">
                                                        <span style="color: #ffffff; font-size: 17px; font-weight: bold; letter-spacing: 0.5px; display: block;">BUNNA BANK</span>
                                                        <span style="color: #f3d7c5; font-size: 11px; display: block;">Contact Center &amp; Support Hub</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                        <td valign="middle" align="right">
                                            <span style="background-color: #c17540; color: #ffffff; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;">
                                                ASSIGNED
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <!-- CONTENT -->
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table
                                    width="590"
                                    border="0"
                                    cellpadding="0"
                                    cellspacing="0"
                                    bgcolor="#ffffff"
                                    style="min-width: 590px; background-color: #ffffff; padding: 30px 28px; border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; border-collapse: separate;"
                                >
                                    <tbody>
                                        <tr>
                                            <td valign="top" style="font-size: 14px; line-height: 1.6; color: #334155;">
                                                <p style="margin-top: 0; margin-bottom: 16px; font-size: 15px;">
                                                    Hello <strong style="color: #0f172a;"><t t-out="object.user_id.name or 'Officer'" /></strong>,
                                                </p>
                                                <p style="margin-bottom: 16px;">
                                                    Support ticket <strong style="color: #541718;"><t t-out="object.number" /> — "<t t-out="object.name" />"</strong> has been assigned to you for investigation and resolution.
                                                </p>
                                                <table style="width: 100%; border-collapse: collapse; margin: 20px 0; background-color: #fafaf9; border: 1px solid #e7e5e4; border-radius: 6px;">
                                                    <tr>
                                                        <td style="padding: 10px 14px; font-size: 12px; color: #78716c; border-bottom: 1px solid #e7e5e4; width: 35%;">Ticket Reference:</td>
                                                        <td style="padding: 10px 14px; font-size: 13px; font-weight: bold; color: #541718; border-bottom: 1px solid #e7e5e4;"><t t-out="object.number" /></td>
                                                    </tr>
                                                    <tr t-if="object.partner_id">
                                                        <td style="padding: 10px 14px; font-size: 12px; color: #78716c; border-bottom: 1px solid #e7e5e4;">Customer Name:</td>
                                                        <td style="padding: 10px 14px; font-size: 13px; font-weight: 600; color: #1D2B32; border-bottom: 1px solid #e7e5e4;"><t t-out="object.partner_id.name" /></td>
                                                    </tr>
                                                    <tr t-if="object.team_id">
                                                        <td style="padding: 10px 14px; font-size: 12px; color: #78716c; border-bottom: 1px solid #e7e5e4;">Assigned Team:</td>
                                                        <td style="padding: 10px 14px; font-size: 13px; color: #1D2B32; border-bottom: 1px solid #e7e5e4;"><t t-out="object.team_id.name" /></td>
                                                    </tr>
                                                    <tr t-if="object.operation_id">
                                                        <td style="padding: 10px 14px; font-size: 12px; color: #78716c;">Operation / Case:</td>
                                                        <td style="padding: 10px 14px; font-size: 13px; color: #1D2B32;"><t t-out="object.operation_id.name" /></td>
                                                    </tr>
                                                </table>
                                                <p style="margin-bottom: 0; color: #1D2B32; font-weight: 500;">
                                                    Please attend to this case within the allocated SLA / OLA target window.
                                                </p>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                        <!-- FOOTER -->
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table
                                    width="590"
                                    border="0"
                                    cellpadding="0"
                                    cellspacing="0"
                                    bgcolor="#541718"
                                    style="min-width: 590px; background-color: #541718; border-top: 3px solid #c17540; border-radius: 0 0 6px 6px; padding: 18px 24px; border-collapse: separate;"
                                >
                                    <tr>
                                        <td valign="middle" align="left" style="color: #ffffff; font-size: 12px;">
                                            <span style="font-weight: bold; color: #f3d7c5;">📞 Hotline:</span> 8501 / +251 11 158 0861
                                        </td>
                                        <td valign="middle" align="center" style="color: #ffffff; font-size: 12px;">
                                            <span style="font-weight: bold; color: #f3d7c5;">✉️ Email:</span> support@bunnabanksc.com
                                        </td>
                                        <td valign="middle" align="right" style="color: #ffffff; font-size: 12px;">
                                            <span style="font-weight: bold; color: #f3d7c5;">🌐 Web:</span> www.bunnabanksc.com
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" align="center" style="color: #f3d7c5; font-size: 11px; padding-top: 10px; border-top: 1px solid rgba(193, 117, 64, 0.4); margin-top: 8px;">
                                            Bunna Bank S.C. | Bank of the Visionaries | Addis Ababa, Ethiopia
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </field>
        </record>
