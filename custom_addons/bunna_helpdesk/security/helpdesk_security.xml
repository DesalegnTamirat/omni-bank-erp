<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_helpdesk_category" model="ir.module.category">
            <field name="name">Helpdesk</field>
            <field name="description">Helps you handle your helpdesk security and hierarchical roles.</field>
            <field name="sequence">9</field>
        </record>

        <!-- Privilege definition for Odoo 19 -->
        <record model="res.groups.privilege" id="res_groups_privilege_helpdesk">
            <field name="name">Helpdesk</field>
            <field name="sequence">9</field>
            <field name="category_id" ref="module_helpdesk_category"/>
        </record>

        <!-- Base Underlying Access Groups -->
        <record id="group_helpdesk_user_own" model="res.groups">
            <field name="name">User: Personal tickets</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>
        <record id="group_helpdesk_user_team" model="res.groups">
            <field name="name">User: Team tickets</field>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_user_own'))]" />
        </record>
        <record id="group_helpdesk_user" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_user_team')), (4, ref('analytic.group_analytic_accounting'))]" />
        </record>

        <!-- Base Tier 1 Contact Center Agent -->
        <record id="group_helpdesk_contact_center" model="res.groups">
            <field name="name">Contact Center Agent (Base)</field>
            <field name="privilege_id" eval="False" />
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_user_own')), (4, ref('group_helpdesk_user_team')), (4, ref('group_helpdesk_user'))]" />
        </record>

        <!-- ── Bunna Helpdesk Journey Access Rights (Inside Helpdesk Privilege Selection) ── -->
        <!-- 1. Contact Center Front Line -->
        <record id="group_helpdesk_contact_center_front_line" model="res.groups">
            <field name="name">Contact Center Front Line</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk" />
            <field name="sequence">1</field>
            <field name="implied_ids" eval="[
                (6, 0, [
                    ref('group_helpdesk_contact_center'),
                    ref('group_helpdesk_user_own'),
                    ref('group_helpdesk_user')
                ])
            ]" />
        </record>

        <!-- 2. Front line (Team) / Specialist -->
        <record id="group_helpdesk_front_line" model="res.groups">
            <field name="name">Front line (Team) / Specialist</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk" />
            <field name="sequence">2</field>
            <field name="implied_ids" eval="[
                (4, ref('group_helpdesk_contact_center')),
                (4, ref('group_helpdesk_user_team')),
                (4, ref('group_helpdesk_user'))
            ]" />
        </record>

        <!-- 3. Contact Center Backline -->
        <record id="group_helpdesk_contact_center_back_line" model="res.groups">
            <field name="name">Contact Center Backline</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk" />
            <field name="sequence">3</field>
            <field name="implied_ids" eval="[
                (4, ref('group_helpdesk_contact_center_front_line')),
                (4, ref('group_helpdesk_user'))
            ]" />
        </record>

        <!-- 4. Back line (Team) / Senior Specialist -->
        <record id="group_helpdesk_back_line" model="res.groups">
            <field name="name">Back line (Team) / Senior Specialist</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk" />
            <field name="sequence">4</field>
            <field name="implied_ids" eval="[
                (4, ref('group_helpdesk_front_line')),
                (4, ref('group_helpdesk_user'))
            ]" />
        </record>

        <!-- 5. Contact Center Team Leader -->
        <record id="group_helpdesk_contact_center_team_leader" model="res.groups">
            <field name="name">Contact Center Team Leader</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk" />
            <field name="sequence">5</field>
            <field name="implied_ids" eval="[
                (4, ref('group_helpdesk_contact_center_back_line'))
            ]" />
        </record>

        <!-- 6. Team Leader / Supervisor -->
        <record id="group_helpdesk_team_leader" model="res.groups">
            <field name="name">Team Leader / Supervisor</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk" />
            <field name="sequence">6</field>
            <field name="implied_ids" eval="[
                (4, ref('group_helpdesk_back_line'))
            ]" />
        </record>

        <!-- 7. Contact Center Director -->
        <record id="group_helpdesk_contact_center_director" model="res.groups">
            <field name="name">Contact Center Director</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk" />
            <field name="sequence">7</field>
            <field name="implied_ids" eval="[
                (4, ref('group_helpdesk_contact_center_team_leader'))
            ]" />
        </record>

        <!-- 8. Directorate Director -->
        <record id="group_helpdesk_director" model="res.groups">
            <field name="name">Directorate Director</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk" />
            <field name="sequence">8</field>
            <field name="implied_ids" eval="[
                (4, ref('group_helpdesk_team_leader'))
            ]" />
        </record>

        <!-- 9. Deputy Chief / Executive -->
        <record id="group_helpdesk_executive" model="res.groups">
            <field name="name">Deputy Chief / Executive</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk" />
            <field name="sequence">9</field>
            <field name="implied_ids" eval="[
                (4, ref('group_helpdesk_director')),
                (4, ref('group_helpdesk_contact_center_director'))
            ]" />
        </record>
        <record id="group_helpdesk_deputy_chief" model="res.groups">
            <field name="name">Deputy Chief</field>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_executive'))]" />
        </record>

        <!-- 10. Chief (CIDO / C-Level Officer) -->
        <record id="group_helpdesk_chief" model="res.groups">
            <field name="name">Chief (C-Level Officer)</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk" />
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_deputy_chief'))]" />
        </record>

        <!-- 11. Chief Executive Officer (CEO) -->
        <record id="group_helpdesk_ceo" model="res.groups">
            <field name="name">Chief Executive Officer (CEO)</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk" />
            <field name="sequence">11</field>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_chief'))]" />
        </record>

        <!-- 12. Helpdesk Administrator (Combines all Helpdesk Privileges & Full Access) -->
        <record id="group_helpdesk_manager" model="res.groups">
            <field name="name">Helpdesk Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk" />
            <field name="sequence">12</field>
            <field name="implied_ids" eval="[
                (4, ref('group_helpdesk_ceo')),
                (4, ref('group_helpdesk_chief')),
                (4, ref('group_helpdesk_deputy_chief')),
                (4, ref('group_helpdesk_executive')),
                (4, ref('group_helpdesk_contact_center_director')),
                (4, ref('group_helpdesk_director')),
                (4, ref('group_helpdesk_contact_center_team_leader')),
                (4, ref('group_helpdesk_team_leader')),
                (4, ref('group_helpdesk_contact_center_back_line')),
                (4, ref('group_helpdesk_back_line')),
                (4, ref('group_helpdesk_contact_center_front_line')),
                (4, ref('group_helpdesk_front_line')),
                (4, ref('group_helpdesk_contact_center')),
                (4, ref('group_helpdesk_user')),
                (4, ref('group_helpdesk_user_team')),
                (4, ref('group_helpdesk_user_own')),
                (4, ref('analytic.group_analytic_accounting'))
            ]" />
            <field
                name="user_ids"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>

        <record id="helpdesk_ticket_personal_rule" model="ir.rule">
            <field name="name">Personal Tickets</field>
            <field ref="model_helpdesk_ticket" name="model_id" />
            <field
                name="domain_force"
            >['|', '|', '|', '|',
                ('user_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('contact_center_agent_id.user_id', '=', user.id),
                ('escalated_to_user_id', '=', user.id),
                ('escalated_to_level_3_user_id', '=', user.id)
            ]</field>
            <field name="perm_create" eval="False" />
            <field name="groups" eval="[(4, ref('group_helpdesk_user_own'))]" />
        </record>
        <record id="helpdesk_ticket_team_rule" model="ir.rule">
            <field name="name">Team Tickets: Operating Unit &amp; Assigned</field>
            <field ref="model_helpdesk_ticket" name="model_id" />
            <field
                name="domain_force"
            >['|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                ('operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('parent_operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('directorate_operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('team_id.operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('escalated_to_team_id.operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('escalated_to_level_3_team_id.operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('escalation_history_ids.current_operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('user_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('contact_center_agent_id.user_id', '=', user.id),
                ('escalated_to_user_id', '=', user.id),
                ('escalated_to_level_3_user_id', '=', user.id)
            ]</field>
            <field name="perm_create" eval="False" />
            <field name="groups" eval="[(4, ref('group_helpdesk_user_team'))]" />
        </record>
        <record id="helpdesk_ticket_user_rule" model="ir.rule">
            <field name="name">Helpdesk User: Operating Unit &amp; Assigned Tickets</field>
            <field ref="model_helpdesk_ticket" name="model_id" />
            <field
                name="domain_force"
            >['|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                ('operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('parent_operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('directorate_operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('team_id.operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('escalated_to_team_id.operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('escalated_to_level_3_team_id.operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('escalation_history_ids.current_operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('user_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('contact_center_agent_id.user_id', '=', user.id),
                ('escalated_to_user_id', '=', user.id),
                ('escalated_to_level_3_user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_user'))]" />
        </record>
        <record id="helpdesk_ticket_director_rule" model="ir.rule">
            <field name="name">Helpdesk Director: Directorate &amp; Subordinate Operating Units</field>
            <field ref="model_helpdesk_ticket" name="model_id" />
            <field
                name="domain_force"
            >['|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                ('operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('parent_operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('directorate_operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('team_id.operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('escalated_to_team_id.operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('escalated_to_level_3_team_id.operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('escalation_history_ids.current_operating_unit_id', 'in', user._get_helpdesk_operating_unit_ids()),
                ('user_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('contact_center_agent_id.user_id', '=', user.id),
                ('escalated_to_user_id', '=', user.id),
                ('escalated_to_level_3_user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_director'))]" />
        </record>
        <record id="helpdesk_ticket_contact_center_all_rule" model="ir.rule">
            <field name="name">Helpdesk Contact Center: All Tickets</field>
            <field ref="model_helpdesk_ticket" name="model_id" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (6, 0, [
                    ref('group_helpdesk_contact_center_back_line'),
                    ref('group_helpdesk_contact_center_team_leader'),
                    ref('group_helpdesk_contact_center_director')
                ])
            ]" />
        </record>
        <record id="helpdesk_ticket_executive_rule" model="ir.rule">
            <field name="name">Helpdesk Executive / Chief / CEO: All Tickets</field>
            <field ref="model_helpdesk_ticket" name="model_id" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('group_helpdesk_executive')),
                (4, ref('group_helpdesk_deputy_chief')),
                (4, ref('group_helpdesk_chief')),
                (4, ref('group_helpdesk_ceo'))
            ]" />
        </record>
        <record id="helpdesk_ticket_manager_rule" model="ir.rule">
            <field name="name">Helpdesk Administrator: All Tickets</field>
            <field ref="model_helpdesk_ticket" name="model_id" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]" />
        </record>
        <!-- Company Rules -->
        <record id="helpdesk_ticket_comp_rule" model="ir.rule">
            <field name="name">Helpdesk Ticket Company Rule</field>
            <field name="model_id" ref="model_helpdesk_ticket" />
            <field name="global" eval="True" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="helpdesk_ticket_category_comp_rule" model="ir.rule">
            <field name="name">Helpdesk Category Company Rule</field>
            <field name="model_id" ref="model_helpdesk_ticket_category" />
            <field name="global" eval="True" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="helpdesk_ticket_channel_comp_rule" model="ir.rule">
            <field name="name">Helpdesk Channel Company Rule</field>
            <field name="model_id" ref="model_helpdesk_ticket_channel" />
            <field name="global" eval="True" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="helpdesk_ticket_stage_comp_rule" model="ir.rule">
            <field name="name">Helpdesk Stage Company Rule</field>
            <field name="model_id" ref="model_helpdesk_ticket_stage" />
            <field name="global" eval="True" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="helpdesk_ticket_tag_comp_rule" model="ir.rule">
            <field name="name">Helpdesk Tag Company Rule</field>
            <field name="model_id" ref="model_helpdesk_ticket_tag" />
            <field name="global" eval="True" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="helpdesk_ticket_team_comp_rule" model="ir.rule">
            <field name="name">Helpdesk Team Company Rule</field>
            <field name="model_id" ref="model_helpdesk_ticket_team" />
            <field name="global" eval="True" />
            <field
                name="domain_force"
            >[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <!-- Portal: only see teams with visibility='portal' -->
        <record id="helpdesk_ticket_team_portal_rule" model="ir.rule">
            <field name="name">Helpdesk Team Portal Rule</field>
            <field name="model_id" ref="model_helpdesk_ticket_team" />
            <field name="domain_force">[('visibility', '=', 'portal')]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]" />
        </record>
        <!-- Internal users: cannot see private teams they are not members of -->
        <record id="helpdesk_ticket_team_private_rule" model="ir.rule">
            <field name="name">Helpdesk Team Private Rule</field>
            <field name="model_id" ref="model_helpdesk_ticket_team" />
            <field name="domain_force">['|',
                ('visibility', '!=', 'private'),
                ('user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_user_own'))]" />
        </record>
        <record id="helpdesk_ticket_rule_internal_user" model="ir.rule">
            <field name="name">Internal Tickets</field>
            <field name="model_id" ref="model_helpdesk_ticket" />
            <field name="domain_force">['|',
                ('create_uid', '=', user.id),
                ('user_id', '=', user.id)]</field>
            <field name="perm_create" eval="False" />
            <field name="perm_write" eval="False" />
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
        </record>
        <!-- Portal for helpdesk -->
        <record id="helpdesk_ticket_rule_portal" model="ir.rule">
            <field name="name">Portal Personal Tickets</field>
            <field name="model_id" ref="model_helpdesk_ticket" />
            <field name="domain_force">['|',
                ('partner_id', 'child_of', [user.commercial_partner_id.id]),
                ('message_partner_ids','child_of',[user.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]" />
        </record>
    </data>
</odoo>
