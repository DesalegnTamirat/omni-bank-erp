<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_helpdesk_api_key_wizard_form" model="ir.ui.view">
        <field name="name">helpdesk.api.key.wizard.form</field>
        <field name="model">helpdesk.api.key.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Helpdesk REST API Key" class="o_helpdesk_wizard">
                <field name="state" invisible="1" />
                
                <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                    <i class="fa fa-info-circle me-1" title="API Key Information" aria-label="API Key Information" />
                    Generate an authentication API key to allow external systems, mobile apps, or web portals to create and track tickets via the Helpdesk REST API.
                </div>

                <div class="alert alert-success" role="alert" invisible="state != 'generated'">
                    <i class="fa fa-check-circle me-1" title="API Key Generated" aria-label="API Key Generated" />
                    <strong>API Key Generated!</strong> Copy this key immediately. For security, it cannot be retrieved again in plaintext.
                </div>

                <group invisible="state != 'draft'">
                    <group>
                        <field name="user_id" options="{'no_create': True}" />
                        <field name="name" placeholder="e.g. Mobile Banking App, Core Banking, CRM Portal" />
                        <field name="expiration_days" />
                    </group>
                </group>

                <group invisible="state != 'generated'">
                    <field name="generated_key" widget="CopyClipboardChar" class="fw-bold fs-5 text-primary" />
                    <field name="endpoint_url" widget="CopyClipboardChar" />
                    <field name="curl_command" widget="text" class="font-monospace small bg-light p-2 rounded" />
                </group>

                <footer>
                    <button
                        name="action_generate_key"
                        type="object"
                        string="Generate API Key"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        invisible="state != 'draft'"
                    />
                    <button
                        string="Done"
                        class="btn-primary"
                        special="cancel"
                        invisible="state != 'generated'"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_api_key_wizard" model="ir.actions.act_window">
        <field name="name">Generate REST API Key</field>
        <field name="res_model">helpdesk.api.key.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
