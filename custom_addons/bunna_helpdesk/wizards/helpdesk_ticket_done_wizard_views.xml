<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_helpdesk_ticket_done_wizard_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.done.wizard.form</field>
        <field name="model">helpdesk.ticket.done.wizard</field>
        <field name="arch" type="xml">
            <form string="Resolve Ticket - Case Resolution" class="o_helpdesk_wizard">
                <sheet>
                    <field name="is_escalated" invisible="1" />
                    <div class="alert alert-success py-2 mb-3" role="alert" invisible="is_escalated">
                        <i class="fa fa-check-circle me-1" title="Resolution Notice" aria-label="Resolution Notice" />
                        <strong>Resolution Notice:</strong> Provide the <strong>Case Resolution</strong> detailing the reason for resolving the issue and actions taken to address it. The resolution can also be saved to the Knowledge Base.
                    </div>
                    <div class="alert alert-info py-2 mb-3" role="alert" invisible="not is_escalated">
                        <i class="fa fa-info-circle me-1" title="Escalation Resolution Notice" aria-label="Escalation Resolution Notice" />
                        <strong>Resolution Notice:</strong> Provide your <strong>Case Resolution</strong> detailing the findings, resolution reason, and actions taken to resolve this escalated ticket.
                    </div>
                    <group>
                        <group string="Ticket Information">
                            <field name="ticket_id" invisible="1" />
                            <field name="target_stage_id" invisible="1" />
                            <field name="ticket_number" string="Ticket #" />
                            <field name="ticket_name" string="Sub Service" />
                            <field name="current_stage_id" string="Current Stage" />
                        </group>
                        <group string="Customer Inquiry">
                            <field name="customer_request_details" string="Customer Inquiry" readonly="1" />
                        </group>
                    </group>
                    <group string="Case Resolution &amp; Knowledge Base">
                        <field
                            name="root_case"
                            string="Root Case"
                            required="1"
                            placeholder="Mandatory: Identified root cause or core category for this issue..."
                        />
                        <field
                            name="resolution"
                            string="Case Resolution"
                            required="1"
                            placeholder="Mandatory: Document the reason for resolving the issue, actions taken, and final solution..."
                        />
                        <field name="save_to_kb" string="Save to Knowledge Base" widget="boolean_toggle" />
                        <field
                            name="kb_title"
                            string="KB Article Title"
                            invisible="not save_to_kb"
                            placeholder="Defaults to Sub-Service title..."
                        />
                    </group>
                    <group string="Customer Notification (SMS / Email)">
                        <group>
                            <field name="notify_customer" widget="boolean_toggle" string="Notify Customer (ON/OFF)"/>
                        </group>
                        <group>
                            <field name="notification_channel" widget="selection" string="Notification Channel" invisible="not notify_customer"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_confirm_done"
                        type="object"
                        string="Mark as Resolved"
                        class="btn-success"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_ticket_done_wizard" model="ir.actions.act_window">
        <field name="name">Resolve Ticket - Case Resolution</field>
        <field name="res_model">helpdesk.ticket.done.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
