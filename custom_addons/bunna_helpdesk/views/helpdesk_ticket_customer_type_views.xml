<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Customer Type Search View -->
    <record id="view_helpdesk_ticket_customer_type_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.customer.type.search</field>
        <field name="model">helpdesk.ticket.customer.type</field>
        <field name="arch" type="xml">
            <search string="Customer Types">
                <field name="name" string="Customer Type" />
                <field name="code" />
                <filter string="Internal Staff / Units" name="internal_only" domain="[('is_internal', '=', True)]" />
                <separator />
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <!-- Customer Type List View -->
    <record id="view_helpdesk_ticket_customer_type_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.customer.type.list</field>
        <field name="model">helpdesk.ticket.customer.type</field>
        <field name="arch" type="xml">
            <list string="Customer Types" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="is_internal" widget="boolean_toggle" />
                <field name="description" optional="show" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Customer Type Form View -->
    <record id="view_helpdesk_ticket_customer_type_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.customer.type.form</field>
        <field name="model">helpdesk.ticket.customer.type</field>
        <field name="arch" type="xml">
            <form string="Customer Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" string="Customer Type Name" />
                        <h1>
                            <field name="name" placeholder="e.g. Bunna Account Holder, Staff / Internal Unit" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. external_existing, internal" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="is_internal" widget="boolean_toggle" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Description of this customer profile type..." nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Customer Type Kanban View -->
    <record id="view_helpdesk_ticket_customer_type_kanban" model="ir.ui.view">
        <field name="name">helpdesk.ticket.customer.type.kanban</field>
        <field name="model">helpdesk.ticket.customer.type</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="code" />
                <field name="is_internal" />
                <field name="description" />
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="badge text-bg-secondary font-monospace" t-if="record.code.value">
                                <field name="code" />
                            </span>
                            <span class="badge text-bg-primary" t-if="record.is_internal.raw_value">
                                <i class="fa fa-building me-1" />Internal Unit
                            </span>
                            <span class="badge text-bg-success" t-if="!record.is_internal.raw_value">
                                <i class="fa fa-globe me-1" />External Client
                            </span>
                        </div>
                        <field class="fw-bold fs-5" name="name" />
                        <div class="text-muted small mt-1 text-truncate" t-if="record.description.value">
                            <field name="description" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Customer Type Action -->
    <record id="action_helpdesk_ticket_customer_type" model="ir.actions.act_window">
        <field name="name">Customer Types</field>
        <field name="res_model">helpdesk.ticket.customer.type</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Customer Type
            </p>
            <p>
                Configure ticket client classifications such as Bunna Account Holders, Internal Units, Corporate/SME, or Non-Account Holders.
            </p>
        </field>
    </record>
</odoo>
