<?xml version="1.0" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <div class="oe_button_box" name="button_box">
                <button
                    context="{'search_default_open': True, 'default_partner_id': id}"
                    name="action_view_helpdesk_tickets"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-life-ring"
                    groups="bunna_helpdesk.group_helpdesk_user_own"
                >
                    <field invisible="True" name="helpdesk_ticket_active_count" />
                    <field invisible="True" name="helpdesk_ticket_count" />
                    <field name="helpdesk_ticket_count_string" widget="statinfo" />
                </button>
            </div>
            <xpath expr="//notebook" position="inside">
                <page string="Bunna Core Banking (CBS)" name="cbs_banking_profile">
                    <group>
                        <group string="Banking Identifiers &amp; Accounts">
                            <field name="account_number" />
                            <field name="cif_number" />
                            <field name="fayda_number" />
                            <field name="account_type" />
                            <field name="account_status" widget="badge"
                                decoration-success="account_status == 'active'"
                                decoration-danger="account_status in ('frozen', 'closed')"
                                decoration-warning="account_status == 'dormant'"
                            />
                        </group>
                        <group string="CBS Demographics &amp; Branch">
                            <field name="customer_type" />
                            <field name="age" />
                            <field name="district_name" />
                            <field name="branch_name" />
                            <field name="branch_id" />
                            <field name="customer_segment" />
                            <field name="preferred_language" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
