<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <!-- ── Actions ──────────────────────────────────────────────────────────── -->
    <record id="helpdesk_ticket_dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">helpdesk.ticket.team</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="helpdesk_ticket_kanban_view"/>
        <field name="search_view_id" eval="False"/>
        <field name="path">helpdesk-dashboard</field>
    </record>
    <record id="helpdesk_ticket_action" model="ir.actions.act_window">
        <field name="name">All Tickets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="context">{'default_order': 'create_date desc, id desc'}</field>
        <field name="path">all-helpdesk-tickets</field>
    </record>
    <record id="helpdesk_my_tickets_action" model="ir.actions.act_window">
        <field name="name">My Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="helpdesk_ticket_view_search"/>
        <field name="context">{'search_default_mytickets': 1}</field>
        <field name="domain">['|', '|', ('user_id', '=', uid), ('escalated_to_user_id', '=', uid), ('escalated_to_level_3_user_id', '=', uid)]</field>
        <field name="path">my-helpdesk-tickets</field>
    </record>
    <record id="helpdesk_ticket_reporting_action" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="path">helpdesk-report</field>
    </record>
    <record id="helpdesk_ticket_channel_action" model="ir.actions.act_window">
        <field name="name">Channels</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">helpdesk.ticket.channel</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="path">helpdesk-channels</field>
    </record>
    <record id="helpdesk_ticket_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">helpdesk.ticket.category</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="path">helpdesk-categories</field>
    </record>
    <record id="helpdesk_ticket_team_action" model="ir.actions.act_window">
        <field name="name">Responsible Operating Units</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">helpdesk.ticket.team</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_helpdesk_team_tree"/>
        <field name="context">{'create': False}</field>
        <field name="path">helpdesk-operating-units</field>
    </record>
    <record id="helpdesk_ticket_team_action_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_helpdesk_team_tree"/>
        <field name="act_window_id" ref="helpdesk_ticket_team_action"/>
    </record>
    <record id="helpdesk_ticket_team_action_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_helpdesk_team_kanban_config"/>
        <field name="act_window_id" ref="helpdesk_ticket_team_action"/>
    </record>
    <record id="helpdesk_ticket_team_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_helpdesk_team_form"/>
        <field name="act_window_id" ref="helpdesk_ticket_team_action"/>
    </record>
    <record id="helpdesk_ticket_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">helpdesk.ticket.stage</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="path">helpdesk-stages</field>
    </record>
    <record id="helpdesk_ticket_tag_action" model="ir.actions.act_window">
        <field name="name">Ticket Tags</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">helpdesk.ticket.tag</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="path">helpdesk-tags</field>
    </record>

    <record id="action_helpdesk_ticket_nbe_complaints" model="ir.actions.act_window">
        <field name="name">NBE Regulatory Complaints</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="domain">[('is_nbe_complaint', '=', True)]</field>
        <field name="context">{'default_case_type': 'complaint'}</field>
        <field name="path">nbe-complaints</field>
    </record>
    <record id="action_helpdesk_ticket_escalated" model="ir.actions.act_window">
        <field name="name">Escalated Tickets (2nd Level)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="domain">[('is_escalated', '=', True)]</field>
        <field name="path">escalated-tickets</field>
    </record>

    <!-- ── Menus ────────────────────────────────────────────────────────────── -->
    <menuitem
        id="helpdesk_ticket_main_menu"
        name="Helpdesk"
        sequence="16"
        web_icon="bunna_helpdesk,static/description/icon.png"
        groups="group_helpdesk_user_own"
    />
    <menuitem
        id="helpdesk_ticket_dashboard_menu"
        name="Dashboard"
        parent="helpdesk_ticket_main_menu"
        action="helpdesk_ticket_dashboard_action"
        sequence="1"
        groups="group_helpdesk_user_own"
    />
    <menuitem
        id="helpdesk_ticket_menu"
        name="Tickets"
        parent="helpdesk_ticket_main_menu"
        sequence="10"
        groups="group_helpdesk_user_own"
    />
    <menuitem
        id="helpdesk_own_ticket_menu"
        name="My Tickets"
        parent="helpdesk_ticket_menu"
        action="helpdesk_my_tickets_action"
        sequence="10"
        groups="group_helpdesk_user_own"
    />
    <!-- All Tickets: accessible to all Helpdesk users (record rules strictly filter tickets by operating unit privilege) -->
    <record id="helpdesk_all_ticket_menu" model="ir.ui.menu">
        <field name="name">All Tickets</field>
        <field name="parent_id" ref="helpdesk_ticket_menu" />
        <field name="action" ref="helpdesk_ticket_action" />
        <field name="sequence">20</field>
        <field name="group_ids" eval="[
            (6, 0, [
                ref('group_helpdesk_user'),
            ])
        ]" />
    </record>
    <menuitem
        id="helpdesk_nbe_complaints_menu"
        name="NBE Complaints"
        parent="helpdesk_ticket_menu"
        action="action_helpdesk_ticket_nbe_complaints"
        sequence="30"
        groups="group_helpdesk_user_own"
    />
    <menuitem
        id="helpdesk_escalated_ticket_menu"
        name="Escalated (2nd Level)"
        parent="helpdesk_ticket_menu"
        action="action_helpdesk_ticket_escalated"
        sequence="40"
        groups="group_helpdesk_user_own"
    />
    <menuitem
        id="helpdesk_escalation_popup_menu"
        name="Escalation Alerts"
        parent="helpdesk_ticket_menu"
        action="action_helpdesk_ticket_escalation_popup"
        sequence="45"
        groups="group_helpdesk_user_own"
    />

    <!-- ── Knowledge Base ────────────────────────────────────────────────────── -->
    <menuitem
        id="helpdesk_knowledge_menu"
        name="Knowledge Base"
        parent="helpdesk_ticket_main_menu"
        action="action_helpdesk_knowledge_article"
        sequence="20"
        groups="group_helpdesk_user_own"
    />

    <!-- ── Reporting ─────────────────────────────────────────────────────────── -->
    <menuitem
        id="helpdesk_ticket_reporting_menu"
        name="Reporting"
        parent="helpdesk_ticket_main_menu"
        sequence="25"
        groups="group_helpdesk_manager"
    />
    <menuitem
        id="helpdesk_ticket_reporting_analysis"
        name="Tickets"
        parent="helpdesk_ticket_reporting_menu"
        action="helpdesk_ticket_reporting_action"
        sequence="5"
    />
    <menuitem
        id="helpdesk_sla_analysis_menu"
        name="SLA Analysis"
        parent="helpdesk_ticket_reporting_menu"
        action="bunna_helpdesk.helpdesk_sla_analysis_action"
        sequence="10"
    />
    <menuitem
        id="helpdesk_satisfaction_analysis_menu"
        name="Satisfaction"
        parent="helpdesk_ticket_reporting_menu"
        action="bunna_helpdesk.helpdesk_satisfaction_analysis_action"
        sequence="15"
    />

    <!-- ── Configuration ──────────────────────────────────────────────────────── -->
    <menuitem
        id="helpdesk_ticket_config_main_menu"
        name="Configuration"
        parent="helpdesk_ticket_main_menu"
        sequence="35"
        groups="group_helpdesk_manager"
    />
    <menuitem
        id="helpdesk_config_settings_menu"
        name="Settings"
        parent="helpdesk_ticket_config_main_menu"
        action="action_helpdesk_mgmt_config_settings"
        sequence="1"
    />
    <menuitem
        id="helpdesk_ticket_channel_menu"
        name="Channels"
        parent="helpdesk_ticket_config_main_menu"
        action="helpdesk_ticket_channel_action"
        sequence="5"
    />
    <menuitem
        id="helpdesk_ticket_category_menu"
        name="Categories"
        parent="helpdesk_ticket_config_main_menu"
        action="helpdesk_ticket_category_action"
        sequence="15"
    />
    <menuitem
        id="helpdesk_ticket_stage_menu"
        name="Stages"
        parent="helpdesk_ticket_config_main_menu"
        action="helpdesk_ticket_stage_action"
        sequence="25"
    />
    <menuitem
        id="helpdesk_auto_close_policy_menu"
        name="Auto-Close Policy"
        parent="helpdesk_ticket_config_main_menu"
        action="action_helpdesk_policy_auto_close"
        sequence="28"
    />
    <menuitem
        id="helpdesk_ticket_team_menu"
        name="Responsible Operating Units"
        parent="helpdesk_ticket_config_main_menu"
        action="helpdesk_ticket_team_action"
        sequence="35"
    />
    <menuitem
        id="helpdesk_assignment_policy_menu"
        name="Ticket Assignment Policy"
        parent="helpdesk_ticket_config_main_menu"
        action="action_helpdesk_policy_assignment"
        sequence="38"
    />
    <menuitem
        id="helpdesk_ticket_tag_menu"
        name="communicated language"
        parent="helpdesk_ticket_config_main_menu"
        action="helpdesk_ticket_tag_action"
        sequence="45"
    />
    <menuitem
        id="helpdesk_duplicate_policy_menu"
        name="Duplicate Tracking"
        parent="helpdesk_ticket_config_main_menu"
        action="action_helpdesk_policy_duplicate"
        sequence="48"
    />
    <menuitem
        id="helpdesk_sla_menu"
        name="SLA Policies"
        parent="helpdesk_ticket_config_main_menu"
        action="bunna_helpdesk.helpdesk_sla_action"
        sequence="50"
    />

    <!-- ── Service Catalogue & OLA Configuration ──────────────────────────────── -->
    <menuitem
        id="helpdesk_catalogue_menu"
        name="Service Catalogue"
        parent="helpdesk_ticket_config_main_menu"
        sequence="55"
    />
    <menuitem
        id="helpdesk_service_menu"
        name="Services"
        parent="helpdesk_catalogue_menu"
        action="action_helpdesk_service"
        sequence="1"
    />
    <menuitem
        id="helpdesk_service_sub_category_menu"
        name="Sub Services"
        parent="helpdesk_catalogue_menu"
        action="action_helpdesk_service_sub_category"
        sequence="2"
    />
    <menuitem
        id="helpdesk_ola_menu"
        name="OLA Policies"
        parent="helpdesk_ticket_config_main_menu"
        action="action_helpdesk_ola"
        sequence="60"
    />
</odoo>
