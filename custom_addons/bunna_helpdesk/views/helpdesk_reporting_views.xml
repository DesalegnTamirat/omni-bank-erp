<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ── Ticket Graph View ─────────────────────────────────────────────────── -->
    <record id="helpdesk_ticket_view_graph" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.graph</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <graph string="Tickets Analysis" type="bar">
                <field name="team_id" type="row" />
                <field name="stage_id" type="col" />
                <field name="priority" type="col" />
            </graph>
        </field>
    </record>

    <!-- ── SLA Analysis pivot + graph ──────────────────────────────────────── -->
    <record id="helpdesk_sla_status_view_pivot" model="ir.ui.view">
        <field name="name">helpdesk.sla.status.view.pivot</field>
        <field name="model">helpdesk.sla.status</field>
        <field name="arch" type="xml">
            <pivot string="SLA Analysis">
                <field name="sla_id" type="row" />
                <field name="status" type="col" />
            </pivot>
        </field>
    </record>

    <record id="helpdesk_sla_status_view_graph" model="ir.ui.view">
        <field name="name">helpdesk.sla.status.view.graph</field>
        <field name="model">helpdesk.sla.status</field>
        <field name="arch" type="xml">
            <graph string="SLA Analysis" type="bar">
                <field name="sla_id" type="row" />
                <field name="status" type="col" />
            </graph>
        </field>
    </record>

    <record id="helpdesk_sla_status_view_list" model="ir.ui.view">
        <field name="name">helpdesk.sla.status.reporting.list</field>
        <field name="model">helpdesk.sla.status</field>
        <field name="priority" eval="1" />
        <field name="arch" type="xml">
            <list string="SLA Analysis" create="false" delete="false">
                <field name="ticket_id" />
                <field name="sla_id" />
                <field name="deadline" />
                <field name="reached_datetime" />
                <field
                    name="status"
                    widget="badge"
                    decoration-success="status == 'reached'"
                    decoration-warning="status == 'in_progress'"
                    decoration-danger="status == 'failed'"
                />
            </list>
        </field>
    </record>

    <record id="helpdesk_sla_analysis_action" model="ir.actions.act_window">
        <field name="name">SLA Analysis</field>
        <field name="res_model">helpdesk.sla.status</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="path">helpdesk-sla-analysis</field>
    </record>

    <!-- ── Rating / Satisfaction Analysis ───────────────────────────────────── -->
    <record id="helpdesk_rating_view_pivot" model="ir.ui.view">
        <field name="name">helpdesk.rating.view.pivot</field>
        <field name="model">rating.rating</field>
        <field name="arch" type="xml">
            <pivot string="Satisfaction Analysis">
                <field name="rating" type="row" />
                <field name="res_name" type="col" />
            </pivot>
        </field>
    </record>

    <record id="helpdesk_rating_view_graph" model="ir.ui.view">
        <field name="name">helpdesk.rating.view.graph</field>
        <field name="model">rating.rating</field>
        <field name="arch" type="xml">
            <graph string="Satisfaction Analysis" type="bar">
                <field name="rating" type="row" />
            </graph>
        </field>
    </record>

    <record id="helpdesk_satisfaction_analysis_action" model="ir.actions.act_window">
        <field name="name">Satisfaction Analysis</field>
        <field name="res_model">rating.rating</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('res_model', '=', 'helpdesk.ticket')]</field>
        <field name="path">helpdesk-satisfaction</field>
    </record>
</odoo>
