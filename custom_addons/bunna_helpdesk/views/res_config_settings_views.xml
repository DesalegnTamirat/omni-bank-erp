<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Helpdesk" string="Helpdesk" name="bunna_helpdesk" groups="bunna_helpdesk.group_helpdesk_manager">
                    
                    <block title="Bunna SMS Notifications" name="bunna_sms_notifications_block">
                        <setting string="Acceptance SMS Template" help="SMS text sent to customer when 'Acceptance SMS' button is clicked. Placeholders: {partner_name}, {first_name}, {number}, {name}, {team_name}, {bank_hotline}">
                            <field name="bunna_sms_acceptance_template" class="w-100" />
                        </setting>
                        <setting string="Done SMS Template" help="SMS text sent to customer when 'Done SMS' button is clicked. Placeholders: {partner_name}, {first_name}, {number}, {name}, {team_name}, {bank_hotline}">
                            <field name="bunna_sms_done_template" class="w-100" />
                        </setting>
                    </block>

                    
                    <block title="Bunna SMS Gateway" name="bunna_sms_gateway_block">
                        <setting string="SMS Gateway URL" help="URL of the SMS gateway. Username and password are taken from the cbs_integration table. If left empty, the endpoint of the cbs_integration row is used.">
                            <div class="content-group">
                                <div class="mt8">
                                    <label for="bunna_sms_endpoint" string="Gateway URL" class="col-lg-4 o_light_label" />
                                    <field name="bunna_sms_endpoint" placeholder="http://sms-gateway-host:port/send" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="bunna_sms_country_code" string="Default Country Code" class="col-lg-4 o_light_label" />
                                    <field name="bunna_sms_country_code" class="oe_inline" />
                                </div>
                            </div>
                        </setting>
                    </block>

                    
                    <block title="Bunna Notification Email Gateway (REST API)" name="bunna_email_gateway_block">
                        <setting string="Email Gateway URL" help="HTTP(S) endpoint URL for sending formatted customer emails (e.g. http://sms-gateway-host:8080/api/email/send). If left empty, uses the SMS gateway endpoint base with JWT token authentication.">
                            <div class="content-group">
                                <div class="mt8">
                                    <label for="bunna_email_endpoint" string="Gateway URL" class="col-lg-4 o_light_label" />
                                    <field name="bunna_email_endpoint" placeholder="http://sms-gateway-host:8080/api/email/send" class="oe_inline" />
                                </div>
                            </div>
                        </setting>
                    </block>

                    
                    <block title="Core Banking System (Finacle CBS)" name="cbs_integration_block">
                        <setting string="CBS Customer Endpoint" help="HTTP API endpoint URL for querying Finacle Core Banking customer profiles.">
                            <field name="cbs_endpoint" placeholder="https://cbs-host:port/customer" />
                        </setting>
                    </block>

                    
                    <block title="REST API &amp; External Integrations" name="helpdesk_rest_api_block">
                        <setting id="helpdesk_api_active_setting" string="Helpdesk REST API" help="Expose secure REST API endpoints (/api/v1/helpdesk/ticket/create) for external systems, mobile apps, and third-party integrations.">
                            <field name="helpdesk_api_active" string="Enable REST API" />
                            <div class="content-group" invisible="not helpdesk_api_active">
                                <div class="mt8">
                                    <button name="action_open_api_key_wizard" type="object" string="Generate API Key" class="btn-primary btn-sm me-2" icon="fa-key" />
                                    <span class="text-muted small">Generate a Bearer API Key with copyable curl command examples.</span>
                                </div>
                                <div class="mt16">
                                    <label for="helpdesk_api_master_key" string="Master API Key (Optional)" class="col-lg-4 o_light_label" />
                                    <field name="helpdesk_api_master_key" password="True" placeholder="Optional shared secret key for backend server integrations" class="oe_inline" />
                                </div>
                            </div>
                        </setting>
                    </block>

                    
                    <block title="Social Media &amp; Omnichannel Channels" name="helpdesk_social_channels">
                        
                        <setting id="helpdesk_telegram_bot_setting" string="Telegram Bot Integration" help="Automatically convert Telegram chats and issue reports into helpdesk tickets.">
                            <field name="telegram_bot_active" string="Enable Telegram Bot" />
                            <div class="content-group" invisible="not telegram_bot_active">
                                <div class="mt8">
                                    <label for="telegram_bot_token" string="Bot API Token" class="col-lg-4 o_light_label" />
                                    <field name="telegram_bot_token" password="True" placeholder="e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="telegram_team_id" string="Default Team" class="col-lg-4 o_light_label" />
                                    <field name="telegram_team_id" options="{'no_create': True}" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="telegram_default_case_type_id" string="Default Case Type" class="col-lg-4 o_light_label" />
                                    <field name="telegram_default_case_type_id" options="{'no_create': True}" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="telegram_cron_interval_number" string="Cron Polling Frequency" class="col-lg-4 o_light_label" />
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <field name="telegram_cron_interval_number" class="oe_inline text-center" style="max-width: 80px;" placeholder="4" />
                                        <field name="telegram_cron_interval_type" class="oe_inline" style="max-width: 120px;" />
                                        <span class="text-muted small">(Default: 4 hours from system schedule)</span>
                                    </div>
                                </div>
                                <div class="text-muted mt8 small">
                                    <i class="fa fa-info-circle text-info" title="Info" /> Webhook URL: <code>/helpdesk/telegram/webhook</code>
                                </div>
                                <div class="mt8 d-flex gap-2">
                                    <button name="action_fetch_telegram_messages" type="object" string="Fetch Telegram Messages Now" class="btn btn-secondary btn-sm" icon="fa-refresh" />
                                    <button name="action_register_telegram_webhook" type="object" string="Register Webhook" class="btn btn-link btn-sm" icon="fa-globe" />
                                </div>
                            </div>
                        </setting>

                        
                        <setting id="helpdesk_chatbot_setting" string="Website Chatbot &amp; Tidio Live Chat" help="Tickets created by the Bunna Bank website chatbot or Tidio widget get the channel 'AI Chatbot / Live Chat' and are routed to the team below.">
                            <div class="content-group">
                                <div class="mt8">
                                    <label for="chatbot_team_id" string="Default Team" class="col-lg-4 o_light_label" />
                                    <field name="chatbot_team_id" options="{'no_create': True}" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="chatbot_default_case_type_id" string="Default Case Type" class="col-lg-4 o_light_label" />
                                    <field name="chatbot_default_case_type_id" options="{'no_create': True}" class="oe_inline" />
                                </div>
                                <div class="mt16">
                                    <field name="chatbot_ticket_active" string="Enable public endpoint for Tidio &amp; external chatbots" />
                                </div>
                                <div class="mt8" invisible="not chatbot_ticket_active">
                                    <label for="chatbot_api_key" string="API Key (Optional)" class="col-lg-4 o_light_label" />
                                    <field name="chatbot_api_key" password="True" placeholder="Leave empty for open webhook" class="oe_inline" />
                                </div>
                                <div class="text-muted mt8 small" invisible="not chatbot_ticket_active">
                                    <div><i class="fa fa-info-circle text-info" title="Info" /> <strong>Tidio Webhook URL:</strong> <code>https://your-domain/helpdesk/tidio/webhook</code></div>
                                    <div class="mt-1"><i class="fa fa-code text-info" title="Endpoint" /> <strong>REST API Endpoint:</strong> <code>POST /helpdesk/chatbot/ticket</code></div>
                                </div>
                                <div class="mt8" invisible="not chatbot_ticket_active">
                                    <button name="action_simulate_chatbot_ticket" type="object" string="Test: Simulate Inbound Chatbot / Tidio Ticket" class="btn btn-secondary btn-sm" icon="fa-comments" />
                                </div>
                            </div>
                        </setting>

                        
                        <setting id="helpdesk_whatsapp_setting" string="WhatsApp Business (Meta Cloud API)" help="Receive inbound WhatsApp messages and auto-create helpdesk tickets with CBS profile resolution.">
                            <field name="whatsapp_active" string="Enable WhatsApp Business API" />
                            <div class="content-group" invisible="not whatsapp_active">
                                <div class="mt8">
                                    <label for="whatsapp_phone_number_id" string="Phone Number ID" class="col-lg-4 o_light_label" />
                                    <field name="whatsapp_phone_number_id" placeholder="e.g. 109876543210987" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="whatsapp_access_token" string="System Access Token" class="col-lg-4 o_light_label" />
                                    <field name="whatsapp_access_token" password="True" placeholder="EAAB..." class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="whatsapp_verify_token" string="Webhook Verify Token" class="col-lg-4 o_light_label" />
                                    <field name="whatsapp_verify_token" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="whatsapp_team_id" string="Default Team" class="col-lg-4 o_light_label" />
                                    <field name="whatsapp_team_id" options="{'no_create': True}" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="whatsapp_default_case_type_id" string="Default Case Type" class="col-lg-4 o_light_label" />
                                    <field name="whatsapp_default_case_type_id" options="{'no_create': True}" class="oe_inline" />
                                </div>
                                <div class="text-muted mt8 small">
                                    <i class="fa fa-info-circle text-info" title="Info" /> Webhook Callback URL: <code>/helpdesk/whatsapp/webhook</code>
                                </div>
                                <div class="mt8">
                                    <button name="action_simulate_whatsapp_ticket" type="object" string="Test: Simulate Inbound WhatsApp Message" class="btn btn-secondary btn-sm" icon="fa-whatsapp" />
                                </div>
                            </div>
                        </setting>

                        
                        <setting id="helpdesk_facebook_setting" string="Facebook Messenger Integration" help="Automatically convert Facebook Page direct messages into helpdesk tickets.">
                            <field name="facebook_active" string="Enable Facebook Messenger" />
                            <div class="content-group" invisible="not facebook_active">
                                <div class="mt8">
                                    <label for="facebook_page_id" string="Facebook Page ID" class="col-lg-4 o_light_label" />
                                    <field name="facebook_page_id" placeholder="e.g. 1029384756" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="facebook_page_access_token" string="Page Access Token" class="col-lg-4 o_light_label" />
                                    <field name="facebook_page_access_token" password="True" placeholder="EAAB..." class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="facebook_verify_token" string="Webhook Verify Token" class="col-lg-4 o_light_label" />
                                    <field name="facebook_verify_token" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="facebook_team_id" string="Default Team" class="col-lg-4 o_light_label" />
                                    <field name="facebook_team_id" options="{'no_create': True}" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <label for="facebook_default_case_type_id" string="Default Case Type" class="col-lg-4 o_light_label" />
                                    <field name="facebook_default_case_type_id" options="{'no_create': True}" class="oe_inline" />
                                </div>
                                <div class="text-muted mt8 small">
                                    <i class="fa fa-info-circle text-info" title="Info" /> Webhook Callback URL: <code>/helpdesk/facebook/webhook</code>
                                </div>
                                <div class="mt8">
                                    <button name="action_simulate_facebook_ticket" type="object" string="Test: Simulate Inbound Facebook Message" class="btn btn-secondary btn-sm" icon="fa-facebook" />
                                </div>
                            </div>
                        </setting>
                    </block>

                    
                    </app>
            </xpath>
        </field>
    </record>

    <record id="action_helpdesk_mgmt_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'bunna_helpdesk', 'bin_size': False}</field>
    </record>
</odoo>