<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Client Action for Bunna Payroll Process Dashboard -->
        <record id="action_bunna_payroll_dashboard" model="ir.actions.client">
            <field name="name">Payroll Process Dashboard</field>
            <field name="tag">bunna_hr_payroll.payroll_dashboard</field>
            <field name="target">current</field>
        </record>

        <!-- Top-Level Dashboard Menuitem (Placed as First Item under Payroll root) -->
        <menuitem id="menu_bunna_payroll_dashboard"
                  name="Dashboard"
                  parent="menu_hr_payroll_root"
                  action="action_bunna_payroll_dashboard"
                  sequence="1"
                  groups="bunna_hr_payroll.group_hr_payroll_user"/>

    </data>
</odoo>
