<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- default training venue -->
        <record id="venue_default_head_office" model="eds.venue">
            <field name="name">Head Office Training Hall</field>
            <field name="location">Bunna Bank Head Office</field>
            <field name="capacity">30</field>
            <field name="facilities">Projector, whiteboard, tables &amp; chairs, catering area</field>
        </record>

        <!-- default priority-rule weights - sum 100% -->
        <record id="rule_priority_strategic" model="eds.tna.priority.rule">
            <field name="sequence">10</field>
            <field name="name">Strategic Alignment</field>
            <field name="criteria">strategic_alignment</field>
            <field name="weight">25.0</field>
            <field name="description">How closely the need aligns with bank strategy and corporate objectives.</field>
        </record>
        <record id="rule_priority_regulatory" model="eds.tna.priority.rule">
            <field name="sequence">20</field>
            <field name="name">Regulatory / Compliance Requirement</field>
            <field name="criteria">regulatory</field>
            <field name="weight">20.0</field>
            <field name="description">Mandatory NBE / regulatory / compliance driven training.</field>
        </record>
        <record id="rule_priority_gap_severity" model="eds.tna.priority.rule">
            <field name="sequence">30</field>
            <field name="name">Gap Severity</field>
            <field name="criteria">gap_severity</field>
            <field name="weight">20.0</field>
            <field name="description">Severity of the competency gap behind the need.</field>
        </record>
        <record id="rule_priority_risk" model="eds.tna.priority.rule">
            <field name="sequence">40</field>
            <field name="name">Risk Level</field>
            <field name="criteria">risk_level</field>
            <field name="weight">15.0</field>
            <field name="description">Operational / audit / reputational risk exposure if unaddressed.</field>
        </record>
        <record id="rule_priority_tom" model="eds.tna.priority.rule">
            <field name="sequence">50</field>
            <field name="name">TOM Impact</field>
            <field name="criteria">tom_impact</field>
            <field name="weight">10.0</field>
            <field name="description">Impact on the Target Operating Model and digital transformation.</field>
        </record>
        <record id="rule_priority_future" model="eds.tna.priority.rule">
            <field name="sequence">60</field>
            <field name="name">Future Capability</field>
            <field name="criteria">future_capability</field>
            <field name="weight">10.0</field>
            <field name="description">Builds capability for future roles / succession readiness.</field>
        </record>

        <!-- Standard Level 1 Evaluation Instrument Seed -->
        <record id="inst_level1_standard" model="eds.evaluation.instrument">
            <field name="name">Standard Level 1 Participant Satisfaction Survey</field>
            <field name="instrument_type">level1</field>
            <field name="version">v1.0</field>
            <field name="state">published</field>
            <field name="notes">Standard 5-point feedback survey for classroom training programs.</field>
        </record>

        <!-- Official EDS-F-02 Level 1 Reaction Survey Questions (18 Items) -->
        <!-- A. Training Content -->
        <record id="inst_q1" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">10</field>
            <field name="name">Content was relevant to my job role</field>
            <field name="category">content</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q2" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">20</field>
            <field name="name">Content was well organized and easy to follow</field>
            <field name="category">content</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q3" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">30</field>
            <field name="name">Materials and handouts were useful</field>
            <field name="category">content</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q4" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">40</field>
            <field name="name">Practical exercises/case studies were effective</field>
            <field name="category">content</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q5" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">50</field>
            <field name="name">Duration was appropriate for the content</field>
            <field name="category">content</field>
            <field name="question_type">scale_1_5</field>
        </record>

        <!-- B. Trainer -->
        <record id="inst_q6" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">60</field>
            <field name="name">Showed strong knowledge of the subject</field>
            <field name="category">trainer</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q7" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">70</field>
            <field name="name">Explained concepts clearly</field>
            <field name="category">trainer</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q8" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">80</field>
            <field name="name">Encouraged participation and questions</field>
            <field name="category">trainer</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q9" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">90</field>
            <field name="name">Managed time well</field>
            <field name="category">trainer</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q10" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">100</field>
            <field name="name">Linked content to banking practice</field>
            <field name="category">trainer</field>
            <field name="question_type">scale_1_5</field>
        </record>

        <!-- C. Venue, Food & Logistics -->
        <record id="inst_q11" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">110</field>
            <field name="name">Training room (space, seating, temperature)</field>
            <field name="category">venue</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q12" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">120</field>
            <field name="name">Projector, sound and equipment</field>
            <field name="category">venue</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q13" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">130</field>
            <field name="name">Refreshments and lunch quality</field>
            <field name="category">venue</field>
            <field name="question_type">scale_1_5</field>
        </record>

        <!-- D. Objectives & Overall -->
        <record id="inst_q14" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">140</field>
            <field name="name">Stated objectives of the program were met</field>
            <field name="category">objective</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q15" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">150</field>
            <field name="name">I gained new knowledge/skills</field>
            <field name="category">impact</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q16" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">160</field>
            <field name="name">I will be able to apply this at work</field>
            <field name="category">impact</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q17" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">170</field>
            <field name="name">Overall rating of the program</field>
            <field name="category">impact</field>
            <field name="question_type">scale_1_5</field>
        </record>
        <record id="inst_q18" model="eds.evaluation.instrument.question">
            <field name="instrument_id" ref="inst_level1_standard"/>
            <field name="sequence">180</field>
            <field name="name">I would recommend this program to colleagues</field>
            <field name="category">impact</field>
            <field name="question_type">scale_1_5</field>
        </record>

        <!-- Default Certification Rules -->
        <record id="cert_rule_developmental" model="eds.certificate.rule">
            <field name="name">Developmental Program Policy (80% Att + 60% L2 Pass)</field>
            <field name="category">developmental</field>
            <field name="require_attendance">1</field>
            <field name="min_attendance_pct">80.0</field>
            <field name="require_level2_pass">1</field>
            <field name="min_level2_score">60.0</field>
            <field name="active">1</field>
        </record>

        <record id="cert_rule_technical" model="eds.certificate.rule">
            <field name="name">Technical &amp; Compliance Policy (80% Att + 70% L2 Pass)</field>
            <field name="category">technical_compliance</field>
            <field name="require_attendance">1</field>
            <field name="min_attendance_pct">80.0</field>
            <field name="require_level2_pass">1</field>
            <field name="min_level2_score">70.0</field>
            <field name="active">1</field>
        </record>
        <!-- Official Vendor Evaluation Criteria (7-Vendor Evaluation Matrix.xlsx) -->
        <record id="criteria_technical_quality" model="eds.evaluation.criteria">
            <field name="sequence">10</field>
            <field name="name">Technical Quality and Relevance</field>
            <field name="evaluation_type">technical</field>
            <field name="weight">30.0</field>
            <field name="description">Clarity of methodology, quality of curriculum refinement.</field>
        </record>
        <record id="criteria_firm_trainer_exp" model="eds.evaluation.criteria">
            <field name="sequence">20</field>
            <field name="name">Firm and Trainer Experience</field>
            <field name="evaluation_type">technical</field>
            <field name="weight">20.0</field>
            <field name="description">Relevant institutional experience, breadth of facilitator expertise across subject areas, and track record in similar assignments.</field>
        </record>
        <record id="criteria_delivery_scalability" model="eds.evaluation.criteria">
            <field name="sequence">30</field>
            <field name="name">Delivery &amp; Scalability Plan</field>
            <field name="evaluation_type">technical</field>
            <field name="weight">10.0</field>
            <field name="description">Feasibility and clarity of the proposed cohort and delivery schedule across multiple District Offices and Branches.</field>
        </record>
        <record id="criteria_demo_presentation" model="eds.evaluation.criteria">
            <field name="sequence">40</field>
            <field name="name">Demo Presentation</field>
            <field name="evaluation_type">technical</field>
            <field name="weight">10.0</field>
            <field name="description">Quality of the live demo delivered to the Training Evaluator Committee - facilitation skill, content quality, and demonstrated tiering across levels.</field>
        </record>
        <record id="criteria_financial_proposal" model="eds.evaluation.criteria">
            <field name="sequence">50</field>
            <field name="name">Financial Proposal</field>
            <field name="evaluation_type">financial</field>
            <field name="weight">30.0</field>
            <field name="description">Competitiveness, clarity, and completeness of the cost structure, including per-cohort pricing.</field>
        </record>
    </data>
</odoo>
