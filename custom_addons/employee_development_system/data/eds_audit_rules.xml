<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Audit trail (business rule §6 / plan §B.3): every attendance edit and
             every nomination state change is logged with User, Old/New value and
             Timestamp by the existing `audit_trail` module. The models carry the
             `_track_audit = True` intent marker; these ir.audit.rule records are
             what actually activate the ORM patch. -->

        <!-- Task 6: training nomination (immutability rule) -->
        <record id="audit_rule_eds_nomination" model="audit.rule">
            <field name="name">EDS Nominations</field>
            <field name="model_id" ref="employee_development_system.model_eds_nomination"/>
            <field name="log_create">True</field>
            <field name="log_write">True</field>
            <field name="log_unlink">True</field>
        </record>

        <!-- Task 7: session attendance (immutability rule) -->
        <record id="audit_rule_eds_session_attendance" model="audit.rule">
            <field name="name">EDS Session Attendance</field>
            <field name="model_id" ref="employee_development_system.model_eds_session_attendance"/>
            <field name="log_create">True</field>
            <field name="log_write">True</field>
            <field name="log_unlink">True</field>
        </record>

        <!-- Task 7: pre/post assessment scores (immutability rule) -->
        <record id="audit_rule_eds_assessment" model="audit.rule">
            <field name="name">EDS Assessments</field>
            <field name="model_id" ref="employee_development_system.model_eds_assessment"/>
            <field name="log_create">True</field>
            <field name="log_write">True</field>
            <field name="log_unlink">True</field>
        </record>

    </data>
</odoo>
