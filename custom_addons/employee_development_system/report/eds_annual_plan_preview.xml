<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_eds_annual_plan_preview_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="employee_development_system.report_eds_brand_layout">
                    <t t-set="summary" t-value="o._get_preview_summary()"/>
                    <div class="page" style="font-family: DejaVu Sans, Arial, sans-serif; font-size: 11px;">
                        <h2 style="color: #541718; margin-bottom: 4px;">Annual Learning &amp; Development Plan</h2>
                        <p><strong>Fiscal Year:</strong> <span t-field="o.fiscal_year"/>
                           &amp;nbsp;&amp;nbsp; <strong>Plan:</strong> <span t-field="o.name"/>
                           &amp;nbsp;&amp;nbsp; <strong>Status:</strong> <span t-field="o.state"/></p>
                        <table class="table table-sm table-bordered" style="width:100%; margin-top: 12px;">
                            <thead><tr>
                                <th>Plan Programs</th><th>Training Need Requests</th>
                                <th>Internal</th><th>Local External</th><th>International</th>
                            </tr></thead>
                            <tbody><tr>
                                <td t-esc="summary['program_count']"/>
                                <td t-esc="summary['request_count']"/>
                                <t t-foreach="summary['by_method']" t-as="group">
                                    <td t-esc="len(group['lines'])"/>
                                </t>
                            </tr></tbody>
                        </table>
                        <h4 style="color: #541718; margin-top: 18px;">Budget by Currency</h4>
                        <table class="table table-sm table-bordered" style="width:55%;">
                            <thead><tr><th>Currency</th><th style="text-align:right;">Total</th></tr></thead>
                            <tbody>
                                <t t-foreach="summary['currency_totals']" t-as="total">
                                    <tr><td t-esc="total[0].name"/>
                                        <td style="text-align:right;" t-esc="'{:,.2f}'.format(total[1])"/></tr>
                                </t>
                            </tbody>
                        </table>
                        <p><strong>Company-currency equivalent:</strong>
                            <span t-field="o.budget_total" t-options="{'widget':'monetary','display_currency':o.budget_currency_id}"/>
                        </p>
                        <t t-foreach="summary['by_method']" t-as="group">
                            <h4 style="color: #541718; margin-top: 18px;" t-esc="group['label']"/>
                            <table class="table table-sm table-bordered" style="width:100%;">
                                <thead><tr>
                                    <th>Course / Program</th><th>Quarter</th><th>Participants</th>
                                    <th>Days</th><th>Currency</th><th style="text-align:right;">Budget</th>
                                </tr></thead>
                                <tbody>
                                    <t t-foreach="group['lines']" t-as="line">
                                        <tr>
                                            <td t-esc="line.program_name or line.course_id.name"/>
                                            <td t-esc="dict(line._fields['quarter'].selection).get(line.quarter, '')"/>
                                            <td t-esc="line.planned_participants"/>
                                            <td t-esc="line.duration_days"/>
                                            <td t-esc="line.budget_currency_id.name"/>
                                            <td style="text-align:right;" t-esc="'{:,.2f}'.format(line.budget_allocated)"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <record id="action_report_eds_annual_plan_preview" model="ir.actions.report">
        <field name="name">Annual L&amp;D Plan Preview</field>
        <field name="model">eds.annual.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_development_system.report_eds_annual_plan_preview_document</field>
        <field name="report_file">employee_development_system.report_eds_annual_plan_preview_document</field>
        <field name="print_report_name">'Annual_LD_Plan_%s' % (object.fiscal_year)</field>
    </record>
</odoo>
