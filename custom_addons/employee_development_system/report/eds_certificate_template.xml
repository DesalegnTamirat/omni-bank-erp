<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_eds_certificate_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="is_preview" t-value="o._name != 'eds.certificate'"/>
                <t t-set="session" t-value="o if o._name == 'eds.session' else (o.session_id if o._name == 'eds.certificate' else False)"/>
                <t t-set="course" t-value="o if o._name == 'eds.course' else (o.course_id if o._name == 'eds.certificate' else o.course_id)"/>
                <t t-set="employee_name" t-value="o.employee_id.name if not is_preview else 'SAMPLE EMPLOYEE NAME'"/>
                <t t-set="course_name" t-value="(course and course.name) or (session and session.program_name) or 'Training Program'"/>
                <t t-set="dates_text" t-value="o.training_dates_text if not is_preview else ((str(session.date_start.date()) + ' to ' + str(session.date_end.date())) if session and session.date_start and session.date_end else 'TRAINING DATES')"/>
                <t t-set="certificate_title" t-value="o.certificate_title or (course and course.certificate_title) or 'CERTIFICATE OF PARTICIPATION'"/>
                <t t-set="body_template" t-value="o.certificate_body_text or (course and course.certificate_body_text) or 'For completing the training titled {course_name} conducted from {dates_text}.'"/>
                <t t-set="body_text" t-value="body_template.replace('{employee_name}', employee_name).replace('{course_name}', course_name).replace('{dates_text}', dates_text)"/>
                <t t-set="signatory_name" t-value="(o.signatory_name if not is_preview else o.certificate_signatory_name) or (course and course.certificate_signatory_name) or 'Director, PPDD'"/>
                <t t-set="signatory_title" t-value="(o.signatory_title if not is_preview else o.certificate_signatory_title) or (course and course.certificate_signatory_title) or 'Director, People Performance &amp; Development'"/>
                <div class="article" style="page-break-after: always; margin: 0; padding: 0; font-family: 'DejaVu Serif', 'Georgia', serif; background-color: #ffffff;">
                    <style>
                        @page {
                            size: landscape;
                            margin: 0mm;
                        }
                        .cert-wrapper {
                            position: relative;
                            width: 100%;
                            height: 245mm;
                            box-sizing: border-box;
                            text-align: center;
                            background-image: url('/employee_development_system/static/src/img/eds_certificate_bg.png');
                            background-size: 100% 100%;
                            background-position: center;
                            background-repeat: no-repeat;
                            padding: 30px 40px;
                        }
                        .cert-cno {
                            position: absolute;
                            top: 155px;
                            right: 65px;
                            font-family: 'DejaVu Sans', 'Arial', sans-serif;
                            font-size: 14px;
                            font-weight: bold;
                            color: #1a1a1a;
                        }
                        .cert-heading {
                            position: absolute;
                            top: 65px;
                            left: 22%;
                            width: 56%;
                            height: 135px;
                            padding: 70px 0 0;
                            box-sizing: border-box;
                            background: #f8f8fa;
                            color: #1e1e1e;
                            font-size: 19px;
                            font-weight: bold;
                            text-transform: uppercase;
                        }
                        .cert-subtitle {
                            margin-top: 175px;
                            font-size: 18px;
                            color: #2b2b2b;
                            font-style: italic;
                        }
                        .cert-recipient {
                            margin-top: 25px;
                            font-size: 28px;
                            font-weight: bold;
                            color: #721c24;
                            letter-spacing: 0.5px;
                        }
                        .cert-body {
                            margin-top: 25px;
                            font-size: 16px;
                            color: #333333;
                            line-height: 1.6;
                            padding: 0 70px;
                        }
                        .cert-signatures {
                            position: absolute;
                            bottom: 205px;
                            left: 0;
                            width: 100%;
                            padding: 0 75px;
                            box-sizing: border-box;
                        }
                        .sig-block-left {
                            float: left;
                            width: 250px;
                            text-align: left;
                        }
                        .sig-block-right {
                            float: right;
                            width: 270px;
                            text-align: left;
                        }
                        .sig-line {
                            border-top: 1px solid #444444;
                            margin-bottom: 8px;
                            width: 90%;
                        }
                        .sig-name {
                            font-family: 'DejaVu Sans', sans-serif;
                            font-size: 13px;
                            font-weight: bold;
                            color: #222222;
                        }
                        .sig-title {
                            font-family: 'DejaVu Sans', sans-serif;
                            font-size: 11px;
                            color: #555555;
                            margin-top: 2px;
                        }
                        .cert-verify-footer {
                            position: absolute;
                            bottom: 25px;
                            right: 40px;
                            font-family: 'DejaVu Sans', sans-serif;
                            font-size: 10px;
                            color: #ffffff;
                        }
                    </style>

                    <div class="cert-wrapper">
                        <div class="cert-heading"><span t-esc="certificate_title"/></div>
                        <!-- Certificate Number -->
                        <div class="cert-cno">
                            CNO: <span t-esc="o.code if not is_preview else 'PREVIEW'"/>
                        </div>

                        <!-- Subtitle -->
                        <div class="cert-subtitle">
                            This Certificate is proudly presented to
                        </div>

                        <!-- Participant Name -->
                        <div class="cert-recipient">
                            <span t-esc="employee_name"/>
                        </div>

                        <!-- Completion Statement -->
                        <div class="cert-body">
                            <span t-esc="body_text"/>
                        </div>

                        <!-- Signatures -->
                        <div class="cert-signatures">
                            <div class="sig-block-left">
                                <div class="sig-line"></div>
                                <div class="sig-name">Prepared by: <span t-esc="o.prepared_by_name if not is_preview else 'Talent Development Specialist'"/></div>
                                <div class="sig-title">[<span t-esc="o.prepared_by_title if not is_preview else 'Talent Development Specialist'"/>]</div>
                            </div>
                            <div class="sig-block-right">
                                <div class="sig-line"></div>
                                <div class="sig-name">Approved by: <span t-esc="signatory_name"/></div>
                                <div class="sig-title">[<span t-esc="signatory_title"/>]</div>
                            </div>
                        </div>

                        <!-- Verification Footer -->
                        <div class="cert-verify-footer" t-if="not is_preview and o.verification_token">
                            Verify: <span t-esc="o.verification_url"/>
                        </div>
                        <div class="cert-verify-footer" t-if="is_preview">PREVIEW — NOT VALID FOR CERTIFICATION</div>
                    </div>
                </div>
            </t>
        </t>
    </template>
    <template id="report_eds_course_certificate_preview">
        <t t-call="employee_development_system.report_eds_certificate_document"/>
    </template>
    <template id="report_eds_session_certificate_preview">
        <t t-call="employee_development_system.report_eds_certificate_document"/>
    </template>
</odoo>
