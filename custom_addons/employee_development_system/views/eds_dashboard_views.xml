<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_eds_dashboard_form" model="ir.ui.view">
            <field name="name">eds.dashboard.form</field>
            <field name="model">eds.dashboard</field>
            <field name="arch" type="xml">
                <form string="Employee Development Dashboard" create="false" edit="false" delete="false">
                    <sheet class="o_eds_dashboard">
                        <field name="is_admin" invisible="1"/>
                        <field name="is_manager" invisible="1"/>
                        <field name="is_employee" invisible="1"/>

                        <div class="eds-dashboard-header">
                            <div>
                                <span class="eds-eyebrow">Employee development</span>
                                <h1>Learning at a glance</h1>
                                <p class="eds-dashboard-meta">
                                    <field name="reporting_company" readonly="1"/>
                                    <span aria-hidden="true">·</span>
                                    Reporting year <field name="reporting_year" readonly="1"/>
                                </p>
                            </div>
                            <span class="eds-live-label" title="Dashboard counts refresh when opened">
                                <i class="fa fa-circle" aria-hidden="true"/> Updated when opened
                            </span>
                        </div>

                        <div invisible="not is_admin" class="eds-dashboard-section">
                            <div class="eds-section-heading">
                                <div>
                                    <span class="eds-eyebrow">L&amp;D overview</span>
                                    <h2>Demand, plans and delivery</h2>
                                </div>
                                <p>Plan figures use fiscal years starting in <field name="reporting_fiscal_year" readonly="1"/>.</p>
                            </div>
                            <div class="row g-3">
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <div class="eds-kpi-card">
                                        <span class="eds-kpi-icon" title="Training needs"><i class="fa fa-list-alt" aria-hidden="true"/></span>
                                        <span class="eds-kpi-label">Training needs received</span>
                                        <div class="eds-kpi-value"><field name="total_tna_entries" readonly="1"/></div>
                                        <p>Submitted for this year's TNA cycles</p>
                                        <button name="action_open_tna_entries" type="object"
                                                string="Review needs" class="btn eds-card-link"/>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <div class="eds-kpi-card">
                                        <span class="eds-kpi-icon" title="Approved plans"><i class="fa fa-calendar-check-o" aria-hidden="true"/></span>
                                        <span class="eds-kpi-label">Approved annual plans</span>
                                        <div class="eds-kpi-value"><field name="published_plans_count" readonly="1"/></div>
                                        <p>Published for this fiscal year</p>
                                        <button name="action_open_annual_plans" type="object"
                                                string="Open plans" class="btn eds-card-link"/>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <div class="eds-kpi-card">
                                        <span class="eds-kpi-icon" title="Current and upcoming sessions"><i class="fa fa-calendar" aria-hidden="true"/></span>
                                        <span class="eds-kpi-label">Current &amp; upcoming</span>
                                        <div class="eds-kpi-value"><field name="upcoming_sessions_count" readonly="1"/></div>
                                        <p>Sessions still in progress or ahead</p>
                                        <button name="action_open_sessions" type="object"
                                                string="Open sessions" class="btn eds-card-link"/>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <div class="eds-kpi-card">
                                        <span class="eds-kpi-icon" title="Completed sessions"><i class="fa fa-check-circle-o" aria-hidden="true"/></span>
                                        <span class="eds-kpi-label">Completed sessions</span>
                                        <div class="eds-kpi-value"><field name="completed_sessions_count" readonly="1"/></div>
                                        <p>Completed in this calendar year</p>
                                        <button name="action_open_completed_sessions" type="object"
                                                string="View completed" class="btn eds-card-link"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div invisible="not is_manager" class="eds-dashboard-section">
                            <div class="eds-section-heading">
                                <div>
                                    <span class="eds-eyebrow">Your team</span>
                                    <h2>What needs attention</h2>
                                </div>
                                <p><field name="team_members_count" readonly="1"/> direct reports</p>
                            </div>
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <div class="eds-kpi-card">
                                        <span class="eds-kpi-icon" title="Team training needs"><i class="fa fa-list-alt" aria-hidden="true"/></span>
                                        <span class="eds-kpi-label">Submitted training needs</span>
                                        <div class="eds-kpi-value"><field name="team_tna_submissions" readonly="1"/></div>
                                        <p>Direct-team and work-unit requests</p>
                                        <button name="action_open_tna_entries" type="object"
                                                string="Review team needs" class="btn eds-card-link"/>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="eds-kpi-card">
                                        <span class="eds-kpi-icon" title="Team invitations"><i class="fa fa-bell-o" aria-hidden="true"/></span>
                                        <span class="eds-kpi-label">Awaiting a response</span>
                                        <div class="eds-kpi-value"><field name="pending_team_nominations" readonly="1"/></div>
                                        <p>Open team invitations before the deadline</p>
                                        <button name="action_open_nominations" type="object"
                                                string="View invitations" class="btn eds-card-link"/>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="eds-kpi-card">
                                        <span class="eds-kpi-icon" title="Confirmed team places"><i class="fa fa-users" aria-hidden="true"/></span>
                                        <span class="eds-kpi-label">Confirmed training places</span>
                                        <div class="eds-kpi-value"><field name="team_confirmed_seats" readonly="1"/></div>
                                        <p>Accepted places in current or upcoming sessions</p>
                                        <button name="action_open_sessions" type="object"
                                                string="View training" class="btn eds-card-link"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div invisible="not is_employee" class="eds-dashboard-section">
                            <div class="eds-section-heading">
                                <div>
                                    <span class="eds-eyebrow">My learning</span>
                                    <h2>Your next steps</h2>
                                </div>
                                <p>Your activity for this reporting year</p>
                            </div>
                            <div class="row g-3">
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <div class="eds-kpi-card">
                                        <span class="eds-kpi-icon" title="My training needs"><i class="fa fa-list-alt" aria-hidden="true"/></span>
                                        <span class="eds-kpi-label">My training needs</span>
                                        <div class="eds-kpi-value"><field name="my_tna_needs_count" readonly="1"/></div>
                                        <p>Needs recorded in this year's cycles</p>
                                        <button name="action_open_tna_entries" type="object"
                                                string="Open my needs" class="btn eds-card-link"/>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <div class="eds-kpi-card">
                                        <span class="eds-kpi-icon" title="My invitations"><i class="fa fa-bell-o" aria-hidden="true"/></span>
                                        <span class="eds-kpi-label">Invitations to answer</span>
                                        <div class="eds-kpi-value"><field name="my_pending_invitations" readonly="1"/></div>
                                        <p>Respond before the invitation deadline</p>
                                        <button name="action_open_nominations" type="object"
                                                string="Respond now" class="btn eds-card-link"/>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <div class="eds-kpi-card">
                                        <span class="eds-kpi-icon" title="My confirmed training"><i class="fa fa-calendar" aria-hidden="true"/></span>
                                        <span class="eds-kpi-label">Confirmed training</span>
                                        <div class="eds-kpi-value"><field name="my_upcoming_sessions" readonly="1"/></div>
                                        <p>Accepted places in current or upcoming sessions</p>
                                        <button name="action_open_sessions" type="object"
                                                string="View my training" class="btn eds-card-link"/>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <div class="eds-kpi-card">
                                        <span class="eds-kpi-icon" title="My certificates"><i class="fa fa-certificate" aria-hidden="true"/></span>
                                        <span class="eds-kpi-label">Certificates issued</span>
                                        <div class="eds-kpi-value"><field name="my_certificates_count" readonly="1"/></div>
                                        <p>Issued to you this calendar year</p>
                                        <button name="action_open_certificates" type="object"
                                                string="View certificates" class="btn eds-card-link"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_eds_dashboard" model="ir.actions.server">
            <field name="name">EDS Dashboard</field>
            <field name="model_id" ref="model_eds_dashboard"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_dashboard()</field>
        </record>
    </data>
</odoo>
