<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Evaluation Instrument Views -->
    <record id="view_eds_evaluation_instrument_tree" model="ir.ui.view">
        <field name="name">eds.evaluation.instrument.tree</field>
        <field name="model">eds.evaluation.instrument</field>
        <field name="arch" type="xml">
            <list string="Evaluation Instruments">
                <field name="name"/>
                <field name="instrument_type"/>
                <field name="version"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'published'" decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="view_eds_evaluation_instrument_form" model="ir.ui.view">
        <field name="name">eds.evaluation.instrument.form</field>
        <field name="model">eds.evaluation.instrument</field>
        <field name="arch" type="xml">
            <form string="Evaluation Instrument">
                <header>
                    <button name="action_publish" string="Publish Instrument" type="object" class="oe_highlight" invisible="state != 'draft'"
                            groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_create_new_version" string="Create New Version" type="object" invisible="state != 'published'"
                            groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_archive" string="Archive" type="object" invisible="state == 'archived'"
                            groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Standard Kirkpatrick Level 1 Feedback"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="instrument_type" readonly="1" force_save="1"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="instrument_type != 'level1'">
                        Level 1 reaction ratings use five points. Choose Course, Vendor, or Hotel for each five-point rating question. Other response formats remain available for general feedback.
                    </div>
                    <div class="alert alert-info" role="status" invisible="instrument_type != 'level3'">
                        Level 3 questions assess the employee's behavior. Choose a five-point rating, ten-point rating, Yes/No, or open text; training service targets do not apply.
                    </div>
                    <notebook class="o_eds_notebook">
                        <page string="Questions">
                            <field name="question_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="question_type"/>
                                    <field name="target_area" column_invisible="parent.instrument_type != 'level1'" invisible="question_type != 'scale_1_5'"/>
                                    <field name="weight" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Instructions &amp; Description">
                            <field name="notes" placeholder="Enter instructions for respondents..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_evaluation_instrument" model="ir.actions.act_window">
        <field name="name">Level 1 Reaction Questions</field>
        <field name="res_model">eds.evaluation.instrument</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('instrument_type', '=', 'level1')]</field>
        <field name="context">{'default_instrument_type': 'level1'}</field>
    </record>

    <record id="action_eds_evaluation_level3_instrument" model="ir.actions.act_window">
        <field name="name">Level 3 Behavioral Questions</field>
        <field name="res_model">eds.evaluation.instrument</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('instrument_type', '=', 'level3')]</field>
        <field name="context">{'default_instrument_type': 'level3'}</field>
    </record>

    <!-- Level 1 Evaluation Views -->
    <record id="view_eds_evaluation_level1_tree" model="ir.ui.view">
        <field name="name">eds.evaluation.level1.tree</field>
        <field name="model">eds.evaluation.level1</field>
        <field name="arch" type="xml">
            <list string="Level 1 Feedback" create="false">
                <field name="session_id"/>
                <field name="course_id"/>
                <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="submitted_date"/>
                <field name="overall_score" widget="progressbar"/>
                <field name="recommend_to_others"/>
                <field name="report_sla_deadline" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'distributed'" decoration-success="state == 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="view_eds_evaluation_level1_form" model="ir.ui.view">
        <field name="name">eds.evaluation.level1.form</field>
        <field name="model">eds.evaluation.level1</field>
        <field name="arch" type="xml">
            <form string="Level 1 Participant Feedback" create="false">
                <header>
                    <button name="action_submit_feedback" string="Submit Feedback" type="object" class="oe_highlight" invisible="state != 'distributed'"
                            groups="employee_development_system.group_eds_employee"/>
                    <button name="action_print_form" string="Print Reaction Survey" type="object" icon="fa-print"
                            groups="employee_development_system.group_eds_employee"/>
                    <field name="state" widget="statusbar" statusbar_visible="distributed,submitted,consolidated"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="session_id" readonly="1"/>
                            <field name="course_id"/>
                            <field name="employee_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="submitted_date"/>
                            <field name="report_sla_deadline"/>
                            <field name="is_anonymous"/>
                            <field name="overall_score" widget="progressbar"/>
                            <field name="recommend_to_others"/>
                        </group>
                    </group>
                    <notebook class="o_eds_notebook">
                        <page string="Responses">
                            <button name="action_generate_questions" string="Generate Questions"
                                    type="object" class="btn-secondary mb-2"
                                    invisible="line_ids"/>
                            <field name="line_ids" readonly="state != 'distributed'" class="o_eds_response_list">
                                <list editable="bottom" create="false" delete="false" open_form_view="1">
                                    <field name="question_id" string="Question" readonly="1"/>
                                    <field name="target_area" string="Target" readonly="1" optional="hide"/>
                                    <field name="category" string="Category" readonly="1" optional="hide"/>
                                    <field name="question_type" string="Format" readonly="1" optional="show"/>
                                    <field name="rating_val" string="Rating Value" invisible="question_type not in ('scale_1_5', 'scale_1_10')"/>
                                    <field name="yes_no_val" string="Yes / No" invisible="question_type != 'yes_no'"/>
                                    <field name="score_pct" string="Score (%)" widget="progressbar" invisible="question_type == 'text'"/>
                                    <field name="text_val" string="Answer / Response" placeholder="Type your answer or feedback here..."/>
                                </list>
                            </field>
                        </page>
                        <page string="Sub-Scores &amp; Qualitative Feedback">
                            <group string="Category Scores">
                                <group>
                                    <field name="score_content" widget="progressbar"/>
                                    <field name="score_trainer" widget="progressbar"/>
                                </group>
                                <group>
                                    <field name="score_venue" widget="progressbar"/>
                                    <field name="score_objective" widget="progressbar"/>
                                </group>
                            </group>
                            <group string="Open Qualitative Feedback">
                                <field name="most_valuable_feedback" placeholder="What was most valuable about this program?"/>
                                <field name="improvement_suggestions" placeholder="What should be improved? Suggested future training topics?"/>
                            </group>
                        </page>
                        <page string="General Comments">
                            <field name="general_comments" placeholder="Additional feedback..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_eds_evaluation_level1_line_form" model="ir.ui.view">
        <field name="name">eds.evaluation.level1.line.form</field>
        <field name="model">eds.evaluation.level1.line</field>
        <field name="arch" type="xml">
            <form string="Question Response">
                <sheet>
                    <group>
                        <field name="question_id" readonly="1"/>
                        <field name="question_type" readonly="1"/>
                        <field name="category" readonly="1"/>
                        <field name="target_area" readonly="1"/>
                    </group>
                    <group string="Your Answer">
                        <field name="rating_val" invisible="question_type not in ('scale_1_5', 'scale_1_10')"/>
                        <field name="yes_no_val" invisible="question_type != 'yes_no'"/>
                        <field name="text_val" string="Answer / Response" placeholder="Type your answer or feedback here..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eds_evaluation_level1" model="ir.actions.act_window">
        <field name="name">Level 1 Participant Feedback</field>
        <field name="res_model">eds.evaluation.level1</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>
    <record id="action_eds_evaluation_level1_own" model="ir.actions.act_window">
        <field name="name">My Training Feedback</field>
        <field name="res_model">eds.evaluation.level1</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <!-- Level 2 Evaluation Views -->
    <record id="view_eds_evaluation_level2_tree" model="ir.ui.view">
        <field name="name">eds.evaluation.level2.tree</field>
        <field name="model">eds.evaluation.level2</field>
        <field name="arch" type="xml">
            <list string="Pre/Post Learning Results" create="false" delete="false">
                <field name="session_id"/>
                <field name="course_id"/>
                <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="display_max_score" string="Maximum Score"/>
                <field name="display_pre_score" string="Pre Score"/>
                <field name="display_post_score" string="Post Score"/>
                <field name="learning_gain" string="Change (pp)" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eds_evaluation_level2_form" model="ir.ui.view">
        <field name="name">eds.evaluation.level2.form</field>
        <field name="model">eds.evaluation.level2</field>
        <field name="arch" type="xml">
            <form string="Pre/Post Learning Result" create="false" edit="false" delete="false">
                <sheet>
                    <field name="score_entry_mode" invisible="1"/>
                    <group>
                        <group string="Session &amp; Trainee">
                            <field name="session_id"/>
                            <field name="course_id"/>
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}" context="{'eds_employee_select': True}"/>
                            <field name="state"/>
                        </group>
                        <group string="Pre/Post Values">
                            <field name="display_max_score" string="Maximum Score"/>
                            <field name="display_pre_score" string="Pre Score"/>
                            <field name="display_post_score" string="Post Score"/>
                        </group>
                    </group>
                    <group>
                        <group string="Learning Outcome">
                            <field name="learning_gain" string="Change (pp)"/>
                            <field name="gap_status" widget="badge" invisible="not score_entry_mode"/>
                            <field name="passing_score"/>
                            <field name="passed"/>
                            <field name="tna_gap_pending"/>
                        </group>
                        <group string="Remarks &amp; Signatories">
                            <field name="remarks"/>
                            <field name="trainer_assessor_name"/>
                            <field name="training_coordinator_name"/>
                            <field name="approved_by_tl_name"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_evaluation_level2" model="ir.actions.act_window">
        <field name="name">Level 2 Learning Evaluations</field>
        <field name="res_model">eds.evaluation.level2</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Level 3 Evaluation Views -->
    <record id="view_eds_evaluation_level3_tree" model="ir.ui.view">
        <field name="name">eds.evaluation.level3.tree</field>
        <field name="model">eds.evaluation.level3</field>
        <field name="arch" type="xml">
            <list string="Level 3 Behavioral Assessments" create="false">
                <field name="session_id"/>
                <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="manager_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="notification_at"/>
                <field name="due_date"/>
                <field name="behavior_score" widget="progressbar"/>
                <field name="status" widget="badge" decoration-warning="status == 'pending'" decoration-danger="status == 'overdue'" decoration-success="status == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_eds_evaluation_level3_form" model="ir.ui.view">
        <field name="name">eds.evaluation.level3.form</field>
        <field name="model">eds.evaluation.level3</field>
        <field name="arch" type="xml">
            <form string="Level 3 Behavioral Assessment" create="false">
                <header>
                    <button name="action_submit_level3" string="Submit Coach Assessment" type="object" class="oe_highlight" invisible="status == 'completed'"
                            groups="base.group_user"/>
                    <button name="action_print_form" string="Print Impact Form" type="object" icon="fa-print"
                            groups="employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,in_progress,completed,overdue"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="course_id"/>
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}" context="{'eds_employee_select': True}"/>
                            <field name="manager_id" string="Coach / Assessor" options="{'no_create': True, 'no_open': True}" context="{'eds_employee_select': True}"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="notification_at"/>
                            <field name="notification_sent_at"/>
                            <field name="completed_date"/>
                            <field name="behavior_score" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook class="o_eds_notebook">
                        <page string="Competency Observations">
                            <field name="line_ids">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="competency_id" readonly="1"/>
                                    <field name="behavior_description" readonly="1"/>
                                    <field name="frequency_rating"/>
                                    <field name="observed_level"/>
                                    <field name="score_pct" widget="progressbar"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Behavior Questions">
                            <field name="behavior_answer_ids">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="question_text" readonly="1"/>
                                    <field name="question_type" readonly="1"/>
                                    <field name="rating_5" invisible="question_type != 'scale_1_5'"/>
                                    <field name="rating_10" invisible="question_type != 'scale_1_10'"/>
                                    <field name="yes_no" invisible="question_type != 'yes_no'"/>
                                    <field name="text_answer" invisible="question_type != 'text'"/>
                                    <field name="answered" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observation Evidence">
                            <field name="observation_notes" placeholder="Enter detailed workplace behavior evidence..."/>
                        </page>
                        <page string="Behavioral Impact &amp; Sign-Off">
                            <group string="Impact Evaluation">
                                <group>
                                    <field name="evaluation_period"/>
                                    <field name="overall_result"/>
                                </group>
                                <group>
                                    <field name="business_impact_observed"/>
                                    <field name="recommended_support"/>
                                </group>
                            </group>
                            <group string="Sign-Off Details">
                                <group>
                                    <field name="sign_manager_name"/>
                                    <field name="sign_trainee_name"/>
                                </group>
                                <group>
                                    <field name="sign_officer_name"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_evaluation_level3" model="ir.actions.act_window">
        <field name="name">Level 3 Behavioral Assessments</field>
        <field name="res_model">eds.evaluation.level3</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_eds_evaluation_level3_assigned" model="ir.actions.act_window">
        <field name="name">My Assigned Behavior Reviews</field>
        <field name="res_model">eds.evaluation.level3</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('manager_id.user_id', '=', uid)]</field>
    </record>

    <!-- Level 4 Evaluation Views -->
    <record id="view_eds_evaluation_level4_tree" model="ir.ui.view">
        <field name="name">eds.evaluation.level4.tree</field>
        <field name="model">eds.evaluation.level4</field>
        <field name="arch" type="xml">
            <list string="Level 4 Total Session Impact &amp; ROI">
                <field name="name"/>
                <field name="session_id"/>
                <field name="course_id"/>
                <field name="measurement_date"/>
                <field name="participant_count" optional="show"/>
                <field name="completed_count" optional="show"/>
                <field name="total_program_cost"/>
                <field name="estimated_financial_benefit"/>
                <field name="roi_percentage"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eds_evaluation_level4_form" model="ir.ui.view">
        <field name="name">eds.evaluation.level4.form</field>
        <field name="model">eds.evaluation.level4</field>
        <field name="arch" type="xml">
            <form string="Level 4 Total Session Impact &amp; ROI">
                <header>
                    <button name="action_evaluate" string="Publish Impact Assessment" type="object" class="oe_highlight" invisible="state != 'draft'"
                            groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_print_form" string="Print Level 4 Report" type="object" icon="fa-print"
                            groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,evaluated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="status">
                        This review measures the total organizational impact of a training session. Enter aggregate KPIs, costs, benefits, and an overall conclusion; individual employee behavior belongs in Level 3.
                    </div>
                    <group>
                        <group string="Session Totals">
                            <field name="course_id"/>
                            <field name="session_id" domain="[('course_id', '=', course_id)]"/>
                            <field name="measurement_date"/>
                            <field name="participant_count" readonly="1"/>
                            <field name="completed_count" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Financial Impact">
                            <field name="total_program_cost"/>
                            <field name="estimated_financial_benefit"/>
                            <field name="roi_percentage"/>
                            <field name="evaluator_id"/>
                        </group>
                    </group>
                    <notebook class="o_eds_notebook">
                        <page string="Organizational Impact Measures">
                            <field name="kpi_ids">
                                <list editable="bottom">
                                    <field name="kpi_name" string="Impact Measure / KPI"/>
                                    <field name="baseline_value" string="Baseline"/>
                                    <field name="target_value" string="Target"/>
                                    <field name="achieved_value" string="Actual Result"/>
                                    <field name="improvement_pct"/>
                                </list>
                            </field>
                        </page>
                        <page string="Impact Summary">
                            <field name="impact_summary" placeholder="Executive summary of organizational performance improvement..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_evaluation_level4" model="ir.actions.act_window">
        <field name="name">Level 4 Impact &amp; ROI Assessments</field>
        <field name="res_model">eds.evaluation.level4</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
