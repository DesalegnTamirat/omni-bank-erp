<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eds_hotel_selection_list" model="ir.ui.view">
        <field name="name">eds.hotel.selection.list</field>
        <field name="model">eds.hotel.selection</field>
        <field name="arch" type="xml">
            <list string="Hotel Selections">
                <field name="name"/>
                <field name="source_type" widget="badge"/>
                <field name="annual_plan_id"/>
                <field name="unscheduled_request_id" optional="show"/>
                <field name="program_name"/>
                <field name="delivery_method" widget="badge"/>
                <field name="currency_id"/>
                <field name="awarded_venue_ids" widget="many2many_tags"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_eds_hotel_selection_form" model="ir.ui.view">
        <field name="name">eds.hotel.selection.form</field>
        <field name="model">eds.hotel.selection</field>
        <field name="arch" type="xml">
            <form string="Hotel / Venue Selection">
                <header>
                    <button name="action_start_evaluation" string="Start Evaluation" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">Compare and award training venues for this approved program or request. You can select Bank Internal Facilities or external Local / International Hotels. Multiple venues can be awarded to host sessions.</div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="source_type" readonly="state != 'draft'"/>
                            <field name="plan_line_id" options="{'no_create': True}"
                                   invisible="source_type != 'annual_plan'" readonly="state != 'draft'"/>
                            <field name="unscheduled_request_id" options="{'no_create': True}"
                                   invisible="source_type != 'unscheduled'" readonly="state != 'draft'"/>
                            <field name="annual_plan_id" readonly="1" invisible="not annual_plan_id"/>
                            <field name="program_name" readonly="1"/>
                            <field name="planned_delivery_method" readonly="1"/>
                            <field name="delivery_override" readonly="state != 'draft'"/>
                            <field name="delivery_method" readonly="state != 'draft' or not delivery_override"/>
                            <field name="delivery_change_reason" placeholder="Reason for venue change"
                                   required="delivery_override and delivery_method != planned_delivery_method"
                                   invisible="not delivery_override" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="currency_id" readonly="delivery_method != 'international' or state == 'awarded'" context="{'active_test': False}" options="{'no_create': True}"/>
                            <button name="%(action_eds_currency_quick_create)d" type="action" string="Add Currency" icon="fa-plus"
                                    invisible="delivery_method != 'international' or state == 'awarded'"/>
                            <field name="awarded_venue_ids" widget="many2many_tags" readonly="1" invisible="not awarded_venue_ids"/>
                            <field name="awarded_venue_id" readonly="1" invisible="not awarded_venue_id" string="Primary Venue"/>
                            <field name="notes"/>
                        </group>
                    </group>
                    <field name="bid_ids"
                           context="{'default_selection_id': id, 'default_currency_id': currency_id, 'default_venue_scope': 'international' if delivery_method == 'international' else 'local'}">
                        <list string="Hotel Bids" default_order="total_score desc, id desc">
                            <field name="create_date" column_invisible="True"/>
                            <field name="venue_scope" invisible="1"/>
                            <field name="is_internal_venue" column_invisible="True"/>
                            <field name="venue_id" options="{'no_create': True}"
                                   domain="[('active', '=', True), ('venue_type', '=', 'internal_hall')] if is_internal_venue else [('active', '=', True), ('venue_type', '!=', 'internal_hall'), ('location_scope', '=', venue_scope)]"
                                   readonly="status in ('awarded', 'rejected') or parent.state == 'awarded'"/>
                            <field name="price_quoted"
                                   readonly="status in ('awarded', 'rejected') or parent.state == 'awarded'"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="technical_score" string="Facility /10"
                                   readonly="status in ('awarded', 'rejected') or parent.state == 'awarded'"/>
                            <field name="total_score" readonly="1"/>
                            <field name="status" widget="badge" readonly="1"
                                   decoration-success="status == 'awarded'" decoration-danger="status == 'rejected'"/>
                        </list>
                        <form string="Hotel Bid &amp; Evaluation">
                            <header>
                                <button name="action_award" string="Award Hotel" type="object"
                                        class="oe_highlight" invisible="status == 'awarded' or not id"/>
                                <button name="action_reject" string="Reject" type="object"
                                        invisible="status == 'awarded' or not id"/>
                                <field name="status" widget="statusbar" readonly="1"
                                       statusbar_visible="pending,awarded,rejected"/>
                            </header>
                            <sheet>
                                <field name="create_date" invisible="1"/>
                                <field name="venue_scope" invisible="1"/>
                                <group>
                                    <group string="Hotel &amp; Quotation">
                                        <field name="is_internal_venue" widget="boolean_toggle" string="Bank Internal Venue"
                                               readonly="status in ('awarded', 'rejected') or parent.state == 'awarded'"/>
                                        <field name="venue_id" options="{'no_create': True}"
                                               domain="[('active', '=', True), ('venue_type', '=', 'internal_hall')] if is_internal_venue else [('active', '=', True), ('venue_type', '!=', 'internal_hall'), ('location_scope', '=', venue_scope)]"
                                               readonly="status in ('awarded', 'rejected') or parent.state == 'awarded'"/>
                                        <field name="price_quoted"
                                               readonly="status in ('awarded', 'rejected') or parent.state == 'awarded' or is_internal_venue"/>
                                        <field name="currency_id" readonly="venue_scope != 'international' or status in ('awarded', 'rejected') or parent.state == 'awarded' or is_internal_venue"
                                               context="{'active_test': False}" options="{'no_create': True}"/>
                                    </group>
                                    <group string="Evaluation Result">
                                        <field name="technical_score"
                                               readonly="status in ('awarded', 'rejected') or parent.state == 'awarded'"/>
                                        <field name="financial_score" readonly="1"/>
                                        <field name="total_score" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Award Documents &amp; Remarks">
                                    <group>
                                        <field name="award_attachment" filename="award_filename" widget="binary" options="{'accepted_file_extensions': '.pdf,image/*'}"/>
                                        <field name="award_filename" invisible="1"/>
                                        <field name="contract_attachment" filename="contract_filename" widget="binary" options="{'accepted_file_extensions': '.pdf,image/*'}"/>
                                        <field name="contract_filename" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="notes"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_eds_hotel_selection" model="ir.actions.act_window">
        <field name="name">Hotels</field>
        <field name="res_model">eds.hotel.selection</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_eds_local_hotel_selection" model="ir.actions.act_window">
        <field name="name">Local Hotel Selection</field>
        <field name="res_model">eds.hotel.selection</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('delivery_method','in',('internal','local_external'))]</field>
    </record>
    <record id="action_eds_international_hotel_selection" model="ir.actions.act_window">
        <field name="name">International Hotel Selection</field>
        <field name="res_model">eds.hotel.selection</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('delivery_method','=','international')]</field>
    </record>
</odoo>
