<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Certification Sponsorship Views -->
    <record id="view_eds_sponsorship_tree" model="ir.ui.view">
        <field name="name">eds.sponsorship.tree</field>
        <field name="model">eds.sponsorship</field>
        <field name="arch" type="xml">
            <list string="Bonded Sponsorships">
                <field name="name"/>
                <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="program_name"/>
                <field name="sponsorship_type"/>
                <field name="service_months"/>
                <field name="eligible" widget="boolean_toggle"/>
                <field name="approved_amount"/>
                <field name="outstanding_obligation"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-danger="state == 'breached'"/>
            </list>
        </field>
    </record>

    <record id="view_eds_sponsorship_form" model="ir.ui.view">
        <field name="name">eds.sponsorship.form</field>
        <field name="model">eds.sponsorship</field>
        <field name="arch" type="xml">
            <form string="Bonded Sponsorship">
                <header>
                    <button name="action_verify_eligibility" string="Verify Service Eligibility" type="object" class="oe_highlight" invisible="state != 'draft'" groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_approve" string="Approve Sponsorship" type="object" class="oe_highlight" invisible="state != 'eligibility_check'" groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_activate_bond" string="Activate Bond Agreement" type="object" class="oe_highlight" invisible="state != 'approved'" groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_mark_breached" string="Mark Bond Breached" type="object" class="btn-danger" invisible="state != 'active'" groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_complete_bond" string="Mark Bond Fulfilled" type="object" invisible="state != 'active'" groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_print_application_form" string="Print Application &amp; Matrix" type="object" icon="fa-print"
                            groups="employee_development_system.group_eds_employee,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,eligibility_check,approved,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" invisible="name == 'New'"/></h1>
                    </div>
                    <p class="text-muted">Funding tied to a signed service bond. Use Tuition Reimbursement for an employee's tuition reimbursement request.</p>
                    <group>
                        <group string="Employee &amp; Eligibility">
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}" context="{'eds_employee_select': True}"
                                   readonly="state != 'draft'"/>
                            <field name="sponsorship_type" readonly="state not in ('draft', 'eligibility_check')"/>
                            <field name="service_months"/>
                            <field name="eligible"/>
                        </group>
                        <group string="Sponsorship &amp; Bond Terms">
                            <field name="program_name" readonly="state not in ('draft', 'eligibility_check')"/>
                            <field name="currency_id" invisible="1" readonly="state not in ('draft', 'eligibility_check')"/>
                            <field name="approved_amount" readonly="state not in ('draft', 'eligibility_check')"/>
                            <field name="bond_duration_months" readonly="state not in ('draft', 'eligibility_check')"/>
                            <field name="bond_start_date" readonly="state not in ('draft', 'eligibility_check')"/>
                            <field name="bond_end_date" readonly="state not in ('draft', 'eligibility_check')"/>
                            <field name="outstanding_obligation"/>
                            <field name="recovery_policy" readonly="state not in ('draft', 'eligibility_check')"/>
                            <field name="breach_reason" invisible="state != 'breached'" readonly="1"/>
                            <field name="recovery_amount" invisible="state != 'breached'"/>
                        </group>
                    </group>
                    <notebook class="o_eds_notebook">
                        <page string="Application &amp; Scoring Matrix" name="application_matrix">
                            <group>
                                <group string="Educational Program Application">
                                    <field name="institution_name" readonly="state not in ('draft', 'eligibility_check')"/>
                                    <field name="field_of_study" readonly="state not in ('draft', 'eligibility_check')"/>
                                    <field name="application_date" readonly="state not in ('draft', 'eligibility_check')"/>
                                    <field name="admission_letter_attached" readonly="state not in ('draft', 'eligibility_check')"/>
                                </group>
                                <group string="Committee Matrix Scoring (100 Pts)">
                                    <field name="tenure_score" string="Service Score / 30" readonly="state not in ('draft', 'eligibility_check')"/>
                                    <div colspan="2" class="mb-2"
                                         invisible="state not in ('draft', 'eligibility_check')"
                                         groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin">
                                        <button name="action_refresh_pms_score" string="Fetch PMS Score" type="object"
                                                class="btn btn-secondary"/>
                                    </div>
                                    <field name="performance_score" string="PMS Score / 40"
                                           readonly="not pms_override or state not in ('draft', 'eligibility_check')"/>
                                    <field name="pms_override" string="Override PMS Score"
                                           readonly="state not in ('draft', 'eligibility_check')"/>
                                    <field name="pms_override_justification" string="Justification"
                                           invisible="not pms_override" required="pms_override"
                                           readonly="state not in ('draft', 'eligibility_check')"/>
                                    <field name="pms_score_available" invisible="1"/>
                                    <field name="pms_fetch_attempted" invisible="1"/>
                                    <field name="pms_source_label" invisible="1"/>
                                    <field name="pms_fetched_score" invisible="1"/>
                                    <field name="strategic_alignment_score" string="Strategic Score / 30"
                                           readonly="state not in ('draft', 'eligibility_check')"/>
                                    <field name="total_matrix_score" string="Total Score / 100" readonly="1"/>
                                    <field name="committee_decision" readonly="state not in ('draft', 'eligibility_check')"/>
                                    <field name="committee_chair_name" readonly="state not in ('draft', 'eligibility_check')"/>
                                    <field name="ppdd_director_name" readonly="state not in ('draft', 'eligibility_check')"/>
                                </group>
                            </group>
                        </page>
                        <page string="Signed Bond Document">
                            <group>
                                <field name="bond_agreement" filename="bond_filename" options="{'accepted_file_extensions': '.pdf,image/*'}" readonly="state != 'approved'"/>
                                <field name="bond_filename" invisible="1" readonly="state != 'approved'"/>
                            </group>
                        </page>
                        <page string="Repayment / Cost Recovery Lines">
                            <p class="text-muted">A bond breach creates a pending payroll instruction. Payroll handoff and processing are recorded separately; this screen does not deduct salary automatically.</p>
                            <field name="repayment_line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="schedule_type"/>
                                    <field name="waiver_authority"/>
                                    <field name="payload_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_sponsorship" model="ir.actions.act_window">
        <field name="name">Bonded Sponsorships</field>
        <field name="res_model">eds.sponsorship</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Staff Education Assistance Views -->
    <record id="view_eds_education_assistance_tree" model="ir.ui.view">
        <field name="name">eds.education.assistance.tree</field>
        <field name="model">eds.education.assistance</field>
        <field name="arch" type="xml">
            <list string="Tuition Reimbursement Requests">
                <field name="name"/>
                <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="program"/>
                <field name="institution"/>
                <field name="degree_level"/>
                <field name="tuition_amount"/>
                <field name="approved_amount"/>
                <field name="approval_state" widget="badge" decoration-success="approval_state == 'cpco_approved'"/>
                <field name="reimbursement_state" widget="badge" decoration-success="reimbursement_state == 'disbursed'"/>
            </list>
        </field>
    </record>

    <record id="view_eds_education_assistance_form" model="ir.ui.view">
        <field name="name">eds.education.assistance.form</field>
        <field name="model">eds.education.assistance</field>
        <field name="arch" type="xml">
            <form string="Tuition Reimbursement Request">
                <header>
                    <button name="action_submit" string="Submit Request" type="object" class="oe_highlight" invisible="approval_state != 'draft'"
                            groups="employee_development_system.group_eds_employee"/>
                    <button name="action_dept_approve" string="Dept Head Approve" type="object" class="oe_highlight" invisible="approval_state != 'submitted'" groups="employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_ppdd_validate" string="PPDD Validate" type="object" class="oe_highlight" invisible="approval_state != 'dept_approved'" groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_cpco_approve" string="CPCO Approve" type="object" class="oe_highlight" invisible="approval_state != 'ppdd_validated'" groups="employee_development_system.group_eds_cpco,employee_development_system.group_eds_admin"/>
                    <button name="action_disburse" string="Disburse Reimbursement" type="object" class="oe_highlight" invisible="approval_state != 'cpco_approved' or reimbursement_state == 'disbursed'" groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <field name="approval_state" widget="statusbar" statusbar_visible="draft,submitted,dept_approved,ppdd_validated,cpco_approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" invisible="name == 'New'"/></h1>
                    </div>
                    <p class="text-muted">Request reimbursement of tuition paid for study. Use Bonded Sponsorships for funding tied to a signed service bond.</p>
                    <group>
                        <group string="Applicant &amp; Program">
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}" context="{'eds_employee_select': True}"/>
                            <field name="program"/>
                            <field name="institution"/>
                            <field name="degree_level"/>
                        </group>
                        <group string="Financials &amp; Disbursement">
                            <field name="currency_id" invisible="1"/>
                            <field name="tuition_amount"/>
                            <field name="approved_amount"/>
                            <field name="reimbursement_state" readonly="1"/>
                        </group>
                    </group>
                    <notebook class="o_eds_notebook">
                        <page string="Academic Progress &amp; Documents">
                            <group>
                                <field name="academic_progress" placeholder="Enter transcript details &amp; GPA summary..."/>
                                <field name="proof_document" filename="proof_filename" options="{'accepted_file_extensions': '.pdf,image/*'}"/>
                                <field name="proof_filename" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_education_assistance" model="ir.actions.act_window">
        <field name="name">Tuition Reimbursement</field>
        <field name="res_model">eds.education.assistance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
