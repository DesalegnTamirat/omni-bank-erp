<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══════════════ TNA Priority Rule ══════════════ -->

        <record id="view_eds_tna_priority_rule_list" model="ir.ui.view">
            <field name="name">eds.tna.priority.rule.list</field>
            <field name="model">eds.tna.priority.rule</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="criteria"/>
                    <field name="weight"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_eds_tna_priority_rule_form" model="ir.ui.view">
            <field name="name">eds.tna.priority.rule.form</field>
            <field name="model">eds.tna.priority.rule</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="name"/>
                                <field name="criteria"/>
                            </group>
                            <group>
                                <field name="weight"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_eds_tna_priority_rule" model="ir.actions.act_window">
            <field name="name">Priority Rules</field>
            <field name="res_model">eds.tna.priority.rule</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ══════════════ TNA Consolidation ══════════════ -->

        <record id="view_eds_tna_consolidation_list" model="ir.ui.view">
            <field name="name">eds.tna.consolidation.list</field>
            <field name="model">eds.tna.consolidation</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="cycle_id"/>
                    <field name="work_unit_id"/>
                    <field name="department_id" optional="show"/>
                    <field name="entry_count"/>
                    <field name="duplicate_count"/>
                    <field name="non_training_count"/>
                    <field name="priority_score"/>
                    <field name="approval_deadline"/>
                    <field name="days_to_deadline" decoration-danger="deadline_breached"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_tna_consolidation_form" model="ir.ui.view">
            <field name="name">eds.tna.consolidation.form</field>
            <field name="model">eds.tna.consolidation</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_consolidate" string="Consolidate Needs"
                                type="object" class="oe_highlight" invisible="state != 'draft'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"
                                confirm="Re-gather needs for this consolidation? Existing flags will be refreshed."/>
                        <button name="action_compute_priority" string="Recompute Priority"
                                type="object" invisible="state in ('approved','locked')"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_submit_ppdd" string="Submit to PPDD Validation"
                                type="object" class="oe_highlight" invisible="state != 'draft'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_validate_ppdd" string="Validate (PPDD)"
                                type="object" class="oe_highlight" invisible="state != 'ppdd_validation'"
                                groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_director_review" string="Director PPDD Review"
                                type="object" class="oe_highlight" invisible="state != 'director_review'"
                                groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_cpco_endorsement" string="CPCO Endorsement"
                                type="object" class="oe_highlight" invisible="state != 'cpco_endorsement'"
                                groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_smc_approve" string="SMC Final Approval"
                                type="object" class="oe_highlight" invisible="state != 'smc_approval'"
                                groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_generate_courses_from_tna" string="Generate Course Proposals"
                                type="object" class="btn-success" invisible="state not in ('approved', 'locked')"
                                groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"
                                confirm="Synthesize approved TNA needs into Course Catalog proposals?"/>
                        <button name="action_lock" string="Lock Register"
                                type="object" invisible="state != 'approved'"
                                groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_unlock" string="Unlock (Change Request)"
                                type="object" invisible="state != 'locked'"
                                groups="employee_development_system.group_eds_admin"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,ppdd_validation,director_review,cpco_endorsement,smc_approval,approved,locked"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_all_entries" type="object" class="oe_stat_button" icon="fa-list-ol">
                                <field name="entry_count" string="All Needs" widget="statinfo"/>
                            </button>
                            <button name="action_view_flagged_entries" type="object" class="oe_stat_button" icon="fa-filter">
                                <field name="flagged_count" string="Flagged / Excluded" widget="statinfo"/>
                            </button>
                        </div>
                        <group>
                            <group string="Consolidation">
                                <field name="name" readonly="1"/>
                                <field name="cycle_id" readonly="state != 'draft'"/>
                                <field name="department_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                <field name="work_unit_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                <field name="priority_score"/>
                            </group>
                            <group string="Deadline &amp; Approval">
                                <field name="approval_deadline"/>
                                <field name="days_to_deadline"/>
                                <field name="deadline_breached"/>
                                <field name="approved_by_id"/>
                                <field name="approval_date"/>
                            </group>
                        </group>
                        <group string="Segregation of Duties ()">
                            <group>
                                <field name="validator_id" groups="employee_development_system.group_eds_officer"/>
                                <field name="reviewer_id"/>
                            </group>
                            <group>
                                <field name="endorser_id"/>
                                <field name="approver_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Training Needs">
                                <field name="entry_ids" readonly="state == 'locked'">
                                    <list>
                                        <field name="name"/>
                                        <field name="employee_id"/>
                                        <field name="work_unit_id"/>
                                        <field name="competency_id"/>
                                        <field name="delivery_mode"/>
                                        <field name="source"/>
                                        <field name="priority_score"/>
                                        <field name="is_duplicate" decoration-danger="is_duplicate"/>
                                        <field name="exclusion_type"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Duplicates &amp; Non-Training Review">
                                <div class="alert alert-info mb-3" role="alert">
                                    <i class="fa fa-info-circle me-1"/> <strong>Consolidated Screening &amp; Exclusion:</strong>
                                    All flagged duplicates, operational/process non-training items, and excluded requests are brought together into this single unified review list.
                                    Review each item once: exclude non-viable items with a justification, clear screening flags to retain legitimate training needs, or restore previously excluded items before final SMC approval.
                                </div>
                                <field name="flagged_entry_ids" readonly="1">
                                    <list create="0" delete="0">
                                        <field name="name"/>
                                        <field name="employee_id"/>
                                        <field name="proposed_program"/>
                                        <field name="competency_id"/>
                                        <field name="exclusion_type" widget="badge"
                                               decoration-warning="exclusion_type == 'duplicate'"
                                               decoration-info="exclusion_type in ('process', 'system', 'structural')"
                                               decoration-secondary="exclusion_type == 'other'"/>
                                        <field name="duplicate_of_id" optional="show"/>
                                        <field name="excluded_reason"/>
                                        <field name="is_duplicate" column_invisible="True"/>
                                        <field name="state" widget="badge"
                                               decoration-danger="state == 'excluded'"
                                               decoration-success="state in ('validated', 'approved')"
                                               decoration-info="state == 'submitted'"/>
                                        <button name="action_exclude" string="Exclude" type="object" icon="fa-ban"
                                                class="btn-sm btn-outline-danger" invisible="state == 'excluded'"
                                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                                        <button name="action_clear_screening_flags" string="Clear Flag" type="object" icon="fa-check"
                                                class="btn-sm btn-outline-primary" invisible="state == 'excluded' or (not is_duplicate and not exclusion_type)"
                                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                                        <button name="action_restore_from_exclusion" string="Restore / Reopen" type="object" icon="fa-undo"
                                                class="btn-sm btn-outline-success" invisible="state != 'excluded'"
                                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Approval History">
                                <field name="approval_history_ids" readonly="1">
                                    <list>
                                        <field name="state_from"/>
                                        <field name="state_to"/>
                                        <field name="user_id"/>
                                        <field name="comment"/>
                                        <field name="timestamp"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_eds_tna_consolidation_search" model="ir.ui.view">
            <field name="name">eds.tna.consolidation.search</field>
            <field name="model">eds.tna.consolidation</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="cycle_id"/>
                    <field name="work_unit_id"/>
                    <filter string="In Approval Chain" name="in_approval"
                            domain="[('state','in',('ppdd_validation','director_review','cpco_endorsement','smc_approval'))]"/>
                    <filter string="Deadline Breached" name="breached" domain="[('deadline_breached','=',True)]"/>
                    <filter string="Approved / Locked" name="finalized" domain="[('state','in',('approved','locked'))]"/>
                    <separator/>
                    <group name="group_by">
                        <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                        <filter string="Work Unit" name="group_unit" context="{'group_by':'work_unit_id'}"/>
                        <filter string="Cycle" name="group_cycle" context="{'group_by':'cycle_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_eds_tna_consolidation" model="ir.actions.act_window">
            <field name="name">TNA Consolidations</field>
            <field name="res_model">eds.tna.consolidation</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_tna_consolidation_search"/>
        </record>

    </data>
</odoo>
