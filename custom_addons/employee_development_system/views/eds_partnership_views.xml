<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eds_learning_partnership_tree" model="ir.ui.view">
        <field name="name">eds.learning.partnership.tree</field>
        <field name="model">eds.learning.partnership</field>
        <field name="arch" type="xml">
            <list string="Learning Partnerships &amp; MoUs">
                <field name="partner_name"/>
                <field name="partner_type" widget="badge"/>
                <field name="mou_reference"/>
                <field name="contact_person"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="performance_rating" widget="badge"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_eds_learning_partnership_form" model="ir.ui.view">
        <field name="name">eds.learning.partnership.form</field>
        <field name="model">eds.learning.partnership</field>
        <field name="arch" type="xml">
            <form string="Learning Partnership &amp; MoU">
                <header>
                    <button name="action_activate" string="Activate Partnership" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_expire" string="Mark Expired" type="object" invisible="state != 'active'"/>
                    <button name="action_terminate" string="Terminate Agreement" type="object" invisible="state in ('expired', 'terminated')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_name" placeholder="e.g. Ethiopian Institute of Financial Studies (EIFS)"/></h1>
                    </div>
                    <group>
                        <group string="Partner Profile &amp; MoU">
                            <field name="partner_type"/>
                            <field name="mou_reference"/>
                            <field name="country_id"/>
                            <field name="performance_rating"/>
                        </group>
                        <group string="Contact &amp; Validity">
                            <field name="contact_person"/>
                            <field name="contact_email"/>
                            <field name="contact_phone"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Partnership Scope &amp; Cooperation" name="scope">
                            <field name="scope_of_partnership" placeholder="Describe the educational, training, accreditation, or research cooperation areas..."/>
                        </page>
                        <page string="Signed MoU Attachment" name="attachment">
                            <group>
                                <field name="mou_document" filename="mou_document_name"/>
                                <field name="mou_document_name" invisible="1"/>
                            </group>
                        </page>
                        <page string="Notes &amp; Review" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_learning_partnership" model="ir.actions.act_window">
        <field name="name">Learning Partnerships &amp; MoUs</field>
        <field name="res_model">eds.learning.partnership</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
