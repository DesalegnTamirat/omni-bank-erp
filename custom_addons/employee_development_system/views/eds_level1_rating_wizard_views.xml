        <field name="name">Vendor Reporting</field>
        <field name="res_model">eds.rating.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_eds_rating_report_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_target_area': 'vendor', 'eds_rating_target': 'vendor'}</field>
    </record>
    <record id="action_eds_hotel_rating_wizard" model="ir.actions.act_window">
        <field name="name">Hotel Reporting</field>
        <field name="res_model">eds.rating.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_eds_rating_report_wizard_form"/>
