<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eds_rating_report_wizard_form" model="ir.ui.view">
        <field name="name">eds.rating.report.wizard.form</field>
        <field name="model">eds.rating.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Rating Report">
                <sheet>
                    <div class="alert alert-info" role="status">
                        Choose a period, then generate the ratings. Results show one row per
                        vendor, hotel, or course. Leave an entity filter empty to compare all
                        entities in that reporting area.
                    </div>
                    <group>
                        <group string="Reporting Scope">
                            <field name="target_area" readonly="1" force_save="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="provider_id" string="Vendor" invisible="target_area == 'hotel'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="venue_id" string="Hotel" invisible="target_area != 'hotel'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="course_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="Reporting Period">
                            <field name="fiscal_year"/>
                            <field name="period_kind"/>
                            <field name="period_index" invisible="period_kind == 'annual'"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Generate Report"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

