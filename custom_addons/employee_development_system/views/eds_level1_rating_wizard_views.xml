    <!-- Question averages are aggregated across submitted responses for one
         vendor, venue, or course. The form shows the contributing sessions. -->
    <record id="view_eds_rating_overview_question_list" model="ir.ui.view">
        <field name="name">eds.rating.overview.question.list</field>
        <field name="model">eds.rating.overview.question</field>
        <field name="arch" type="xml">
            <list string="Question Breakdown" create="false" edit="false" delete="false">
                <field name="question_text" string="Question"/>
                <field name="average_rating" string="Average (out of 5)"/>
                <field name="average_pct" string="Average (%)"/>
                <field name="satisfaction" widget="badge"
                       decoration-success="satisfaction == 'satisfactory'"
                       decoration-warning="satisfaction == 'neutral'"
                       decoration-danger="satisfaction == 'unsatisfactory'"/>
                <field name="response_count"/>
                <field name="respondent_count" optional="hide"/>
                <field name="session_count"/>
                <field name="last_session_date" optional="hide"/>
                <field name="source_question_count" optional="hide"/>
                <button name="action_open_session_sources" type="object"
                        string="Session Sources" icon="fa-list" class="btn-link"/>
            </list>
        </field>
    </record>
    <record id="view_eds_rating_overview_question_form" model="ir.ui.view">
        <field name="name">eds.rating.overview.question.form</field>
        <field name="model">eds.rating.overview.question</field>
        <field name="arch" type="xml">
            <form string="Question Breakdown" create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_session_sources" type="object"
                            string="View Session Sources" icon="fa-list"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        The average combines submitted five-point answers for this question.
                        Session sources below show where the question was asked and its
                        average answer in each session.
                    </div>
                    <group>
                        <group string="Question and Rated Entity">
                            <field name="question_text"/>
                            <field name="target_area"/>
                            <field name="provider_id" invisible="target_area != 'vendor'"/>
                            <field name="venue_id" invisible="target_area != 'hotel'"/>
                            <field name="course_id" invisible="target_area != 'course'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Average Answer">
                            <field name="average_rating" string="Average (out of 5)"/>
                            <field name="average_pct" string="Average (%)"/>
                            <field name="satisfaction" widget="badge"
                                   decoration-success="satisfaction == 'satisfactory'"
                                   decoration-warning="satisfaction == 'neutral'"
                                   decoration-danger="satisfaction == 'unsatisfactory'"/>
                            <field name="response_count"/>
                            <field name="respondent_count"/>
                            <field name="session_count"/>
                            <field name="source_question_count"/>
                        </group>
                    </group>
                    <field name="session_source_ids" readonly="1">
                        <list string="Question Sources by Session" create="false" edit="false" delete="false">
                            <field name="session_id" string="Source Session"/>
                            <field name="course_id"/>
                            <field name="session_date"/>
                            <field name="average_rating" string="Average (out of 5)"/>
                            <field name="average_pct" string="Average (%)"/>
                            <field name="response_count"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_eds_rating_overview_question_search" model="ir.ui.view">
        <field name="name">eds.rating.overview.question.search</field>
        <field name="model">eds.rating.overview.question</field>
        <field name="arch" type="xml">
            <search string="Find Questions">
                <field name="question_text"/>
                <field name="provider_id"/>
                <field name="venue_id"/>
                <field name="course_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="satisfactory" string="Satisfactory"
                        domain="[('satisfaction', '=', 'satisfactory')]"/>
                <filter name="unsatisfactory" string="Unsatisfactory"
                        domain="[('satisfaction', '=', 'unsatisfactory')]"/>
                <group name="group_by">
                    <filter name="group_question" string="Question"
                            context="{'group_by': 'question_text'}"/>
                    <filter name="group_result" string="Result"
                            context="{'group_by': 'satisfaction'}"/>
                    <filter name="group_provider" string="Vendor"
                            context="{'group_by': 'provider_id'}"/>
                    <filter name="group_hotel" string="Hotel / Venue"
                            context="{'group_by': 'venue_id'}"/>
                    <filter name="group_course" string="Course"
                            context="{'group_by': 'course_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_eds_rating_overview_question" model="ir.actions.act_window">
        <field name="name">Question Breakdown</field>
        <field name="res_model">eds.rating.overview.question</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_eds_rating_overview_question_list"/>
        <field name="search_view_id" ref="view_eds_rating_overview_question_search"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <record id="view_eds_rating_overview_question_session_list" model="ir.ui.view">
        <field name="name">eds.rating.overview.question.session.list</field>
        <field name="model">eds.rating.overview.question.session</field>
        <field name="arch" type="xml">
            <list string="Question Sources by Session" create="false" edit="false" delete="false">
                <field name="session_id" string="Source Session"/>
                <field name="session_date"/>
                <field name="course_id"/>
                <field name="question_text" optional="hide"/>
                <field name="average_rating" string="Average (out of 5)"/>
                <field name="average_pct" string="Average (%)"/>
                <field name="satisfaction" widget="badge"
                       decoration-success="satisfaction == 'satisfactory'"
                       decoration-warning="satisfaction == 'neutral'"
                       decoration-danger="satisfaction == 'unsatisfactory'"/>
                <field name="response_count"/>
                <field name="respondent_count"/>
                <button name="action_open_anonymous_answers" type="object"
                        string="Anonymous Answers" icon="fa-comments"
                        class="btn-link"/>
            </list>
        </field>
    </record>
    <record id="view_eds_rating_overview_question_session_form" model="ir.ui.view">
        <field name="name">eds.rating.overview.question.session.form</field>
        <field name="model">eds.rating.overview.question.session</field>
        <field name="arch" type="xml">
            <form string="Question Source Session" create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_anonymous_answers" type="object"
                            string="Anonymous Answers" icon="fa-comments"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Source">
                            <field name="session_id" string="Session"/>
                            <field name="session_date"/>
                            <field name="course_id"/>
                            <field name="provider_id" invisible="target_area != 'vendor'"/>
                            <field name="venue_id" invisible="target_area != 'hotel'"/>
                            <field name="target_area" invisible="1"/>
                            <field name="question_text"/>
                        </group>
                        <group string="Average Answer">
                            <field name="average_rating" string="Average (out of 5)"/>
                            <field name="average_pct" string="Average (%)"/>
                            <field name="satisfaction" widget="badge"
                                   decoration-success="satisfaction == 'satisfactory'"
                                   decoration-warning="satisfaction == 'neutral'"
                                   decoration-danger="satisfaction == 'unsatisfactory'"/>
                            <field name="response_count"/>
                            <field name="respondent_count"/>
                        </group>
                    </group>
                    <group string="Answer Distribution" col="5">
                        <field name="rating_1_count" string="1 / 5"/>
                        <field name="rating_2_count" string="2 / 5"/>
                        <field name="rating_3_count" string="3 / 5"/>
                        <field name="rating_4_count" string="4 / 5"/>
                        <field name="rating_5_count" string="5 / 5"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_eds_rating_overview_question_session_search" model="ir.ui.view">
        <field name="name">eds.rating.overview.question.session.search</field>
        <field name="model">eds.rating.overview.question.session</field>
        <field name="arch" type="xml">
            <search string="Find Question Sources">
                <field name="session_id"/>
                <field name="course_id"/>
                <field name="provider_id"/>
                <field name="venue_id"/>
                <field name="session_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <group name="group_by">
                    <filter name="group_session" string="Session"
                            context="{'group_by': 'session_id'}"/>
                    <filter name="group_course" string="Course"
                            context="{'group_by': 'course_id'}"/>
                    <filter name="group_month" string="Session Month"
                            context="{'group_by': 'session_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_eds_rating_overview_question_session" model="ir.actions.act_window">
        <field name="name">Question Sources by Session</field>
        <field name="res_model">eds.rating.overview.question.session</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_eds_rating_overview_question_session_list"/>
        <field name="search_view_id" ref="view_eds_rating_overview_question_session_search"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
