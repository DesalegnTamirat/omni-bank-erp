    <record id="view_eds_rating_overview_form" model="ir.ui.view">
        <field name="name">eds.rating.overview.form</field>
        <field name="model">eds.rating.overview</field>
        <field name="arch" type="xml">
            <form string="Rating Overview" create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_questions" type="object"
                            string="Question Breakdown" icon="fa-question-circle"
                            class="btn-primary"/>
                    <button name="action_open_sessions" type="object"
                            string="View Sessions and Filter by Course or Date"
                            icon="fa-list" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        This overview includes all recorded reaction ratings for this entity.
                        Open the question breakdown to see each average answer and the sessions
                        that contributed. Open sessions to filter by course, provider, venue, or date.
                    </div>
                    <group>
                        <group string="Rated Entity">
                            <field name="target_area"/>
                            <field name="provider_id" invisible="target_area != 'vendor'"/>
                            <field name="venue_id" invisible="target_area != 'hotel'"/>
                            <field name="course_id" invisible="target_area != 'course'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="last_session_date"/>
                        </group>
                        <group string="Rating">
                            <field name="average_rating"/>
                            <field name="average_pct"/>
                            <field name="satisfaction" widget="badge"
                                   decoration-success="satisfaction == 'satisfactory'"
                                   decoration-warning="satisfaction == 'neutral'"
                                   decoration-danger="satisfaction == 'unsatisfactory'"/>
                            <field name="response_count"/>
                            <field name="respondent_count"/>
                            <field name="session_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eds_vendor_rating_overview_search" model="ir.ui.view">
        <field name="name">eds.vendor.rating.overview.search</field>
        <field name="model">eds.rating.overview</field>
        <field name="arch" type="xml">
            <search string="Find Vendors">
                <field name="provider_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="rated" string="Rated" domain="[('response_count', '&gt;', 0)]"/>
                <filter name="unrated" string="No Ratings Yet" domain="[('response_count', '=', 0)]"/>
                <filter name="satisfactory" string="Satisfactory"
                        domain="[('satisfaction', '=', 'satisfactory')]"/>
                <group name="group_by">
                    <filter name="group_provider" string="Vendor"
                            context="{'group_by': 'provider_id'}"/>
                    <filter name="group_result" string="Result"
                            context="{'group_by': 'satisfaction'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
