    <record id="view_eds_rating_overview_session_form" model="ir.ui.view">
        <field name="name">eds.rating.overview.session.form</field>
        <field name="model">eds.rating.overview.session</field>
        <field name="arch" type="xml">
            <form string="Session Rating Detail" create="false" edit="false" delete="false">
