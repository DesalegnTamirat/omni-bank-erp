<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══════════════ Session Attendance (FREDS040) ══════════════ -->

        <record id="view_eds_session_attendance_list" model="ir.ui.view">
            <field name="name">eds.session.attendance.list</field>
            <field name="model">eds.session.attendance</field>
            <field name="arch" type="xml">
                <list string="Session Attendance" editable="bottom">
                    <field name="name" readonly="1"/>
                    <field name="session_id" options="{'no_create': True}"/>
                    <field name="employee_id" options="{'no_create': True}"/>
                    <field name="attendance_date"/>
                    <field name="attended"/>
                    <field name="hours_attended"/>
                    <field name="notes"/>
                    <field name="attendance_percentage" string="Program %"/>
                    <field name="meets_min_attendance" string="Meets 80%"/>
                </list>
            </field>
        </record>

        <record id="view_eds_session_attendance_search" model="ir.ui.view">
            <field name="name">eds.session.attendance.search</field>
            <field name="model">eds.session.attendance</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <field name="session_id"/>
                    <filter string="Attended" name="attended" domain="[('attended','=',True)]"/>
                    <filter string="Absent" name="absent" domain="[('attended','=',False)]"/>
                    <filter string="Below 80%" name="below" domain="[('meets_min_attendance','=',False)]"/>
                    <group name="group_by">
                        <filter string="Session" name="g_session" context="{'group_by':'session_id'}"/>
                        <filter string="Date" name="g_date" context="{'group_by':'attendance_date'}"/>
                        <filter string="Department" name="g_dept" context="{'group_by':'department_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_eds_session_attendance_form" model="ir.ui.view">
            <field name="name">eds.session.attendance.form</field>
            <field name="model">eds.session.attendance</field>
            <field name="arch" type="xml">
                <form string="Session Attendance">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="session_id" options="{'no_create': True}"/>
                                <field name="attendance_date"/>
                            </group>
                            <group>
                                <field name="employee_id" options="{'no_create': True}"/>
                                <field name="attended"/>
                                <field name="hours_attended"/>
                            </group>
                        </group>
                        <group string="Program Attendance (FREDS040)">
                            <field name="attendance_percentage" widget="progressbar"/>
                            <field name="meets_min_attendance"/>
                        </group>
                        <group string="Recording">
                            <field name="recorded_by"/>
                            <field name="notes"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_session_attendance" model="ir.actions.act_window">
            <field name="name">Attendance</field>
            <field name="res_model">eds.session.attendance</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_session_attendance_search"/>
        </record>

        <!-- ══════════════ Training Materials (FREDS045) ══════════════ -->

        <record id="view_eds_material_list" model="ir.ui.view">
            <field name="name">eds.material.list</field>
            <field name="model">eds.material</field>
            <field name="arch" type="xml">
                <list string="Training Materials">
                    <field name="name"/>
                    <field name="title"/>
                    <field name="course_id"/>
                    <field name="material_type"/>
                    <field name="version"/>
                    <field name="is_approved" string="Approved"/>
                    <field name="quality_state" widget="badge"/>
                    <field name="approval_state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_material_search" model="ir.ui.view">
            <field name="name">eds.material.search</field>
            <field name="model">eds.material</field>
            <field name="arch" type="xml">
                <search>
                    <field name="title"/>
                    <field name="course_id"/>
                    <filter string="Approved" name="approved" domain="[('is_approved','=',True)]"/>
                    <filter string="Pending Approval" name="pending" domain="[('is_approved','=',False)]"/>
                    <group name="group_by">
                        <filter string="Course" name="g_course" context="{'group_by':'course_id'}"/>
                        <filter string="Type" name="g_type" context="{'group_by':'material_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_eds_material_form" model="ir.ui.view">
            <field name="name">eds.material.form</field>
            <field name="model">eds.material</field>
            <field name="arch" type="xml">
                <form string="Training Material">
                    <header>
                        <button name="action_submit_quality_review" string="Submit for Quality Review"
                                type="object" class="oe_highlight" invisible="quality_state != 'draft'"/>
                        <button name="action_approve_quality" string="Approve Quality"
                                type="object" invisible="quality_state != 'in_review'"/>
                        <button name="action_submit_director_approval" string="Submit to Director PPDD"
                                type="object" invisible="quality_state != 'quality_approved' or approval_state == 'director_approved'"/>
                        <button name="action_director_approve" string="Director PPDD Approve"
                                type="object" class="oe_highlight" invisible="approval_state != 'submitted'"/>
                        <button name="action_reject" string="Reject" type="object"
                                invisible="quality_state in ('rejected',) or approval_state in ('rejected','director_approved')"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Material">
                                <field name="name" readonly="1"/>
                                <field name="title"/>
                                <field name="course_id" options="{'no_create': True}"/>
                                <field name="material_type"/>
                                <field name="version"/>
                            </group>
                            <group string="Approval (FREDS045)">
                                <field name="quality_state" widget="badge"/>
                                <field name="approval_state" widget="badge"/>
                                <field name="is_approved"/>
                            </group>
                        </group>
                        <group string="Document">
                            <field name="document" widget="binary" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group string="Review trail">
                            <group>
                                <field name="reviewed_by"/>
                                <field name="reviewed_date"/>
                            </group>
                            <group>
                                <field name="approved_by"/>
                                <field name="approved_date"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_material" model="ir.actions.act_window">
            <field name="name">Training Materials</field>
            <field name="res_model">eds.material</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_material_search"/>
        </record>

        <!-- ══════════════ Daily Feedback (FREDS040) ══════════════ -->

        <record id="view_eds_feedback_list" model="ir.ui.view">
            <field name="name">eds.feedback.list</field>
            <field name="model">eds.feedback</field>
            <field name="arch" type="xml">
                <list string="Daily Participant Feedback" editable="bottom">
                    <field name="session_id" options="{'no_create': True}"/>
                    <field name="employee_id" options="{'no_create': True}"/>
                    <field name="feedback_date"/>
                    <field name="day_number"/>
                    <field name="trainer_id"/>
                    <field name="rating" widget="badge"/>
                    <field name="topic"/>
                </list>
            </field>
        </record>

        <record id="view_eds_feedback_form" model="ir.ui.view">
            <field name="name">eds.feedback.form</field>
            <field name="model">eds.feedback</field>
            <field name="arch" type="xml">
                <form string="Daily Participant Feedback">
                    <sheet>
                        <group>
                            <group>
                                <field name="session_id" options="{'no_create': True}"/>
                                <field name="employee_id" options="{'no_create': True}"/>
                                <field name="feedback_date"/>
                                <field name="day_number"/>
                            </group>
                            <group>
                                <field name="trainer_id"/>
                                <field name="rating" widget="radio"/>
                                <field name="topic"/>
                            </group>
                        </group>
                        <group string="Comment">
                            <field name="comment"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_eds_feedback" model="ir.actions.act_window">
            <field name="name">Daily Feedback</field>
            <field name="res_model">eds.feedback</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ══════════════ Pre/Post Assessments (FREDS055 / FR-EDS-037) ══════════════ -->

        <record id="view_eds_assessment_list" model="ir.ui.view">
            <field name="name">eds.assessment.list</field>
            <field name="model">eds.assessment</field>
            <field name="arch" type="xml">
                <list string="Pre/Post Assessments" editable="bottom">
                    <field name="session_id" options="{'no_create': True}"/>
                    <field name="employee_id" options="{'no_create': True}"/>
                    <field name="assessment_type"/>
                    <field name="score"/>
                    <field name="threshold"/>
                    <field name="passed" string="Passed"/>
                    <field name="assessment_date"/>
                    <field name="uploaded_by"/>
                </list>
            </field>
        </record>

        <record id="view_eds_assessment_search" model="ir.ui.view">
            <field name="name">eds.assessment.search</field>
            <field name="model">eds.assessment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <field name="session_id"/>
                    <filter string="Pre" name="pre" domain="[('assessment_type','=','pre')]"/>
                    <filter string="Post" name="post" domain="[('assessment_type','=','post')]"/>
                    <filter string="Passed" name="passed" domain="[('passed','=',True)]"/>
                    <group name="group_by">
                        <filter string="Session" name="g_session" context="{'group_by':'session_id'}"/>
                        <filter string="Type" name="g_type" context="{'group_by':'assessment_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_eds_assessment_form" model="ir.ui.view">
            <field name="name">eds.assessment.form</field>
            <field name="model">eds.assessment</field>
            <field name="arch" type="xml">
                <form string="Pre/Post Assessment">
                    <sheet>
                        <group>
                            <group>
                                <field name="session_id" options="{'no_create': True}"/>
                                <field name="employee_id" options="{'no_create': True}"/>
                                <field name="assessment_type"/>
                                <field name="assessment_date"/>
                            </group>
                            <group>
                                <field name="score"/>
                                <field name="threshold" readonly="1"/>
                                <field name="passed" readonly="1"/>
                                <field name="uploaded_by"/>
                            </group>
                        </group>
                        <group string="Notes">
                            <field name="notes"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_assessment" model="ir.actions.act_window">
            <field name="name">Pre/Post Assessments</field>
            <field name="res_model">eds.assessment</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_assessment_search"/>
        </record>

        <!-- ══════════════ International Training (FREDS041) ══════════════ -->

        <record id="view_eds_international_training_list" model="ir.ui.view">
            <field name="name">eds.international.training.list</field>
            <field name="model">eds.international.training</field>
            <field name="arch" type="xml">
                <list string="International Training">
                    <field name="name"/>
                    <field name="session_id"/>
                    <field name="program_name"/>
                    <field name="country"/>
                    <field name="institution"/>
                    <field name="cost_estimate" string="Estimated Cost"/>
                    <field name="entitlement_valid" string="Entitlement"/>
                    <field name="approval_state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_international_training_form" model="ir.ui.view">
            <field name="name">eds.international.training.form</field>
            <field name="model">eds.international.training</field>
            <field name="arch" type="xml">
                <form string="International Training">
                    <header>
                        <button name="action_submit" string="Submit for Approval" type="object"
                                class="oe_highlight" invisible="approval_state != 'draft'"/>
                        <button name="action_approve" string="Approve" type="object"
                                class="oe_highlight" invisible="approval_state != 'submitted'"/>
                        <button name="action_complete" string="Complete" type="object"
                                invisible="approval_state != 'approved'"/>
                        <field name="approval_state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="alert alert-info" role="alert"
                             invisible="entitlement_valid or approval_state == 'draft'">
                            <field name="entitlement_issues" class="text-break"/>
                        </div>
                        <group>
                            <group string="Training">
                                <field name="name" readonly="1"/>
                                <field name="session_id" options="{'no_create': True}"/>
                                <field name="program_name" readonly="1"/>
                                <field name="country"/>
                                <field name="institution"/>
                            </group>
                            <group string="Cost &amp; Entitlement">
                                <field name="cost_estimate"/>
                                <field name="currency_id"/>
                                <field name="entitlement_valid"/>
                                <field name="travel_total" string="Travel Arrangements Total"/>
                            </group>
                        </group>
                        <group string="Scope / Objective">
                            <field name="description"/>
                        </group>
                        <notebook>
                            <page string="Travel Arrangements" name="travel">
                                <field name="travel_arrangements_ids">
                                    <list editable="bottom">
                                        <field name="arrangement_type"/>
                                        <field name="description"/>
                                        <field name="amount"/>
                                        <field name="status" widget="badge"/>
                                        <field name="attachment" filename="filename" widget="binary"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Reports &amp; Knowledge Sharing" name="reports">
                                <field name="reports_ids">
                                    <list editable="bottom">
                                        <field name="report_type"/>
                                        <field name="title"/>
                                        <field name="report_date"/>
                                        <field name="document" filename="filename" widget="binary"/>
                                    </list>
                                </field>
                                <group>
                                    <field name="post_training_report_count"/>
                                    <field name="knowledge_sharing_count"/>
                                </group>
                            </page>
                            <page string="Workplace Application" name="workplace">
                                <field name="workplace_application_tracking"/>
                                <field name="workplace_application_completed"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_international_training" model="ir.actions.act_window">
            <field name="name">International Training</field>
            <field name="res_model">eds.international.training</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
