<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══════════════ Venues ══════════════ -->

        <record id="view_eds_venue_list" model="ir.ui.view">
            <field name="name">eds.venue.list</field>
            <field name="model">eds.venue</field>
            <field name="arch" type="xml">
                <list string="Training Venues">
                    <field name="name"/>
                    <field name="location_scope" widget="badge"/>
                    <field name="country_id" optional="show"/>
                    <field name="location"/>
                    <field name="capacity"/>
                    <field name="facilities"/>
                    <field name="booking_count" string="Bookings"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_eds_venue_search" model="ir.ui.view">
            <field name="name">eds.venue.search</field>
            <field name="model">eds.venue</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="location"/>
                    <field name="location_scope"/>
                    <field name="country_id"/>
                    <filter string="Active" name="active" domain="[('active','=',True)]"/>
                </search>
            </field>
        </record>

        <record id="view_eds_venue_form" model="ir.ui.view">
            <field name="name">eds.venue.form</field>
            <field name="model">eds.venue</field>
            <field name="arch" type="xml">
                <form string="Training Venue">
                    <sheet>
                        <div class="oe_button_box">
                            <button class="oe_stat_button" type="object"
                                    name="action_view_bookings" icon="fa-calendar">
                                <div class="o_stat_info">
                                    <field name="booking_count" widget="statinfo" string="Bookings"/>
                                    <span class="o_stat_text">View venue bookings</span>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group string="Venue Details">
                                <field name="name"/>
                                <field name="venue_type" widget="badge"/>
                                <field name="location_scope"/>
                                <field name="country_id" invisible="location_scope != 'international'"
                                       required="location_scope == 'international'"/>
                                <field name="capacity"/>
                                <field name="city"/>
                                <field name="location"/>
                                <field name="active"/>
                            </group>
                            <group string="Contact &amp; Amenities">
                                <field name="contact_person"/>
                                <field name="contact_phone"/>
                                <field name="contact_email"/>
                                <field name="has_lodging"/>
                                <field name="has_catering"/>
                                <field name="address"/>
                            </group>
                        </group>
                        <group string="Facilities &amp; Equipment">
                            <field name="facilities" placeholder="Projector, sound system, WiFi, etc..."/>
                            <field name="notes"/>
                        </group>
                        <notebook class="o_eds_notebook">
                            <page string="Bookings" name="bookings">
                                <field name="booking_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="session_id"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Proposals &amp; Documents" name="documents">
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_venue" model="ir.actions.act_window">
            <field name="name">Venues</field>
            <field name="res_model">eds.venue</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_venue_search"/>
        </record>

        <!-- ══════════════ Venue Bookings ══════════════ -->

        <record id="view_eds_venue_booking_list" model="ir.ui.view">
            <field name="name">eds.venue.booking.list</field>
            <field name="model">eds.venue.booking</field>
            <field name="arch" type="xml">
                <list string="Venue Bookings">
                    <field name="name"/>
                    <field name="venue_id"/>
                    <field name="session_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_venue_booking_form" model="ir.ui.view">
            <field name="name">eds.venue.booking.form</field>
            <field name="model">eds.venue.booking</field>
            <field name="arch" type="xml">
                <form string="Venue Booking">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object"
                                class="oe_highlight" invisible="state != 'requested'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_cancel" string="Cancel Booking" type="object"
                                invisible="state == 'cancelled'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="venue_id"/>
                                <field name="session_id"/>
                            </group>
                            <group>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="notes"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_venue_booking" model="ir.actions.act_window">
            <field name="name">Venue Bookings</field>
            <field name="res_model">eds.venue.booking</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ══════════════ Batches / Cohorts ══════════════ -->

        <record id="view_eds_batch_list" model="ir.ui.view">
            <field name="name">eds.batch.list</field>
            <field name="model">eds.batch</field>
            <field name="arch" type="xml">
                <list string="Training Batches">
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="description"/>
                    <field name="max_capacity"/>
                    <field name="participant_target"/>
                    <field name="session_count" string="Sessions"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_batch_form" model="ir.ui.view">
            <field name="name">eds.batch.form</field>
            <field name="model">eds.batch</field>
            <field name="arch" type="xml">
                <form string="Training Batch">
                    <header>
                        <button name="action_plan" string="Plan" type="object"
                                class="oe_highlight" invisible="state != 'draft'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_activate" string="Activate" type="object"
                                class="oe_highlight" invisible="state != 'planned'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_close" string="Close" type="object"
                                invisible="state == 'closed'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="course_id"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="max_capacity"/>
                                <field name="participant_target"/>
                            </group>
                        </group>
                        <notebook class="o_eds_notebook">
                            <page string="Sessions" name="sessions">
                                <field name="session_ids">
                                    <list editable="bottom">
                                        <field name="name" readonly="1"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="venue_id"/>
                                        <field name="capacity"/>
                                        <field name="status" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_batch" model="ir.actions.act_window">
            <field name="name">Batches / Cohorts</field>
            <field name="res_model">eds.batch</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ══════════════ Sessions (-023, ...022) ══════════════ -->

        <record id="view_eds_session_list" model="ir.ui.view">
            <field name="name">eds.session.list</field>
            <field name="model">eds.session</field>
            <field name="arch" type="xml">
                <list string="Training Sessions">
                    <field name="name"/>
                    <field name="source_type" widget="badge"/>
                    <field name="approved_plan_id" optional="show"/>
                    <field name="unscheduled_request_id" optional="show"/>
                    <field name="course_id"/>
                    <field name="delivery_method"/>
                    <field name="batch_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="venue_id"/>
                    <field name="trainer_count" string="Trainers"/>
                    <field name="planned_participant_count"/>
                    <field name="enrolled_count"/>
                    <field name="pending_count"/>
                    <field name="capacity" optional="hide"/>
                    <field name="conflict_flag" decoration-danger="conflict_flag"/>
                    <field name="status" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_session_search" model="ir.ui.view">
            <field name="name">eds.session.search</field>
            <field name="model">eds.session</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="venue_id"/>
                    <field name="trainer_ids"/>
                    <field name="approved_plan_id"/>
                    <field name="unscheduled_request_id"/>
                    <field name="delivery_method"/>
                    <filter string="Scheduled" name="scheduled" domain="[('status','=','scheduled')]"/>
                    <filter string="Ongoing" name="ongoing" domain="[('status','=','ongoing')]"/>
                    <filter string="Completed" name="completed" domain="[('status','=','completed')]"/>
                    <filter string="Approved Plan" name="approved_plan" domain="[('plan_line_id.plan_id.state','in',('published','amended'))]"/>
                    <filter string="Internal" name="internal" domain="[('delivery_method','=','internal')]"/>
                    <filter string="Local External" name="local_external" domain="[('delivery_method','=','local_external')]"/>
                    <filter string="International" name="international" domain="[('delivery_method','=','international')]"/>
                    <filter string="Conflicts" name="conflicts" domain="[('conflict_flag','=',True)]"/>
                    <separator/>
                    <group name="group_by">
                        <filter string="Month" name="g_month"
                                context="{'group_by': 'date_start:month'}"/>
                        <filter string="Status" name="g_state" context="{'group_by':'status'}"/>
                        <filter string="Venue" name="g_venue" context="{'group_by':'venue_id'}"/>
                        <filter string="Course" name="g_course" context="{'group_by':'course_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_eds_session_form" model="ir.ui.view">
            <field name="name">eds.session.form</field>
            <field name="model">eds.session</field>
            <field name="arch" type="xml">
                <form string="Training Session">
                    <header>
                        <button name="action_refresh_suggested_employees" string="Refresh Suggested Employees" type="object"
                                invisible="not plan_line_id or status != 'draft'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_invite_selected" string="Invite Selected" type="object"
                                class="oe_highlight" invisible="status not in ('scheduled','rescheduled')"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_confirm" string="Confirm Schedule" type="object"
                                class="oe_highlight" invisible="status != 'draft'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_start" string="Start Session" type="object"
                                class="oe_highlight" invisible="status != 'scheduled'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_complete" string="Complete Session" type="object"
                                class="oe_highlight" invisible="status != 'ongoing'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_reschedule" string="Reschedule" type="object"
                                invisible="status not in ('scheduled','ongoing')"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_confirm_reschedule" string="Confirm Reschedule"
                                type="object" class="oe_highlight" invisible="status != 'rescheduled'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_print_all_certificates" string="Print All Certificates" type="object"
                                class="btn-primary" icon="fa-print" invisible="status != 'completed'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_cancel" string="Cancel Session" type="object"
                                invisible="status in ('cancelled','completed')"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <field name="enrolled_employee_ids" invisible="1"/>
                        <field name="omitted_suggestion_employee_ids" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <group>
                            <group string="Program">
                                <field name="name" readonly="1"/>
                                <field name="source_type" widget="radio" readonly="status != 'draft'"/>
                                <field name="approved_plan_id" options="{'no_create': True}"
                                       invisible="source_type != 'annual_plan'"
                                       required="source_type == 'annual_plan'"
                                       readonly="status != 'draft'"/>
                                <field name="unscheduled_request_id" options="{'no_create': True}"
                                       invisible="source_type != 'unscheduled'"
                                       required="source_type == 'unscheduled'"
                                       readonly="status != 'draft'"/>
                                <field name="plan_line_id" string="Approved Plan Program"
                                       options="{'no_create': True}"
                                       invisible="source_type != 'annual_plan'"
                                       required="source_type == 'annual_plan'"
                                       domain="[('plan_id', '=', approved_plan_id), ('course_id', '!=', False), ('is_addendum', '=', False)]"
                                       readonly="status != 'draft'"/>
                                <field name="course_id" string="Catalog Course" readonly="1"/>
                                <field name="planned_delivery_method" readonly="1"
                                       invisible="not plan_line_id or planned_delivery_method == delivery_method"/>
                                <field name="delivery_method" readonly="1"/>
                                <field name="internal_fallback" readonly="status != 'draft'"
                                       invisible="status != 'draft' or (not internal_fallback and (delivery_method == 'internal' or awarded_provider_id))"/>
                                <field name="internal_fallback_reason" placeholder="Reason for using internal delivery"
                                       required="internal_fallback" invisible="not internal_fallback"
                                       readonly="status != 'draft'"/>
                                <field name="batch_id" options="{'no_create': True}"/>
                            </group>
                            <group string="Schedule">
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="attendance_mode" readonly="status != 'draft'"/>
                                <field name="response_deadline"/>
                                <field name="start_time" widget="float_time"/>
                                <field name="duration_hours" widget="float_time"/>
                            </group>
                        </group>
                        <group col="2">
                            <group string="Venue &amp; Capacity">
                                <field name="awarded_venue_id" invisible="1"/>
                                <field name="venue_id" string="Hotel / Venue" options="{'no_create': True}"
                                       readonly="delivery_method != 'internal' or awarded_venue_id"/>
                                <field name="capacity"/>
                            </group>
                            <group string="Training Provider &amp; Trainers">
                                <field name="awarded_provider_id" string="Training Provider" readonly="1"
                                       invisible="delivery_method == 'internal'"/>
                                <field name="trainer_ids" widget="many2many_tags"
                                       readonly="status != 'draft'"
                                       domain="[('state','=','active'),('trainer_type','=','internal'),('tot_certified','=',True)] if delivery_method == 'internal' else [('state','=','active'),('trainer_type','=','external'),('external_provider_id','=',awarded_provider_id)]"/>
                                <field name="conflict_flag" readonly="1"/>
                            </group>
                        </group>
                        <group col="2">
                            <group string="Participants">
                                <field name="planned_participant_count" readonly="1"/>
                                <field name="enrolled_count" readonly="1"/>
                            </group>
                            <group string="Responses">
                                <field name="pending_count" readonly="1"/>
                                <field name="waitlist_count" readonly="1"/>
                            </group>
                        </group>
                        <group string="Notes">
                            <field name="notes"/>
                        </group>
                        <notebook class="o_eds_notebook">
                            <page string="Participants" name="participants">
                                <div class="alert alert-info" role="alert" invisible="status != 'draft'">Employees from the plan’s selected TNA cycles appear by priority score. Remove or deselect anyone who should not be invited. Confirming the schedule sends the selected employees the session details and response deadline.</div>
                                <div class="alert alert-info" role="alert" invisible="status == 'draft'">Scheduled participants stay on the roster. Add another employee and use Invite Selected to send their invitation; employees can reject their invitations.</div>
                                <field name="enrollment_ids" invisible="status != 'draft'" context="{'default_state': 'suggested', 'default_selected': True, 'eds_manual_roster': True}">
                                    <list editable="bottom" open_form_view="1" default_order="priority_score desc,source_count desc,id">
                                        <field name="selected" widget="boolean_toggle"/>
                                        <field name="employee_id" options="{'no_create': True}"/>
                                        <field name="priority_score" readonly="1" optional="show"/>
                                        <field name="source_count" readonly="1" optional="show"/>
                                        <field name="source_summary" readonly="1"/>
                                        <field name="state" widget="badge" readonly="1"/>
                                        <field name="replacement_employee_id" readonly="1" optional="hide"/>
                                        <field name="response_note" readonly="1" optional="hide"/>
                                    </list>
                                </field>
                                <field name="enrollment_ids" invisible="status == 'draft'" context="{'default_state': 'suggested', 'default_selected': True, 'eds_manual_roster': True}">
                                    <list editable="bottom" delete="false" open_form_view="1" default_order="priority_score desc,source_count desc,id">
                                        <field name="selected" widget="boolean_toggle" readonly="state != 'suggested'"/>
                                        <field name="employee_id" options="{'no_create': True}" readonly="state != 'suggested'"/>
                                        <field name="priority_score" readonly="1" optional="show"/>
                                        <field name="source_count" readonly="1" optional="show"/>
                                        <field name="source_summary" readonly="1"/>
                                        <field name="state" widget="badge" readonly="1"/>
                                        <field name="replacement_employee_id" readonly="1" optional="show"/>
                                        <field name="response_note" readonly="1" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Attendance &amp; Roster" name="attendance"
                                  groups="employee_development_system.group_eds_officer">
                                <div class="mb-2">
                                    <button name="action_export_attendance_xlsx" string="Export Attendance Excel" type="object"
                                            class="btn btn-primary btn-sm me-2" icon="fa-file-excel-o"
                                            groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                                    <button name="action_mark_all_attended" string="Mark All Attended" type="object"
                                            class="btn btn-success btn-sm me-2" icon="fa-check-circle"
                                            groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                                    <button name="action_open_attendance_import" string="Import Attendance Excel / CSV" type="object"
                                            class="btn btn-secondary btn-sm" icon="fa-upload"
                                            groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                                </div>
                                <field name="attendance_ids">
                                    <list editable="bottom">
                                        <field name="name" readonly="1"/>
                                        <field name="employee_id" domain="[('id', 'in', parent.enrolled_employee_ids)]" options="{'no_create': True}"/>
                                        <field name="attendance_date"/>
                                        <field name="attendance_slot"/>
                                        <field name="attended" widget="boolean_toggle"/>
                                        <field name="attendance_percentage" string="Program %"/>
                                        <field name="meets_min_attendance" widget="badge"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Certificate Customization" name="certificate_config">
                                <button name="action_preview_certificate" string="Preview Certificate PDF" type="object" icon="fa-file-pdf-o" class="btn-secondary"/>
                                <group>
                                    <group string="Certificate Wording">
                                        <field name="certificate_title"/>
                                        <field name="certificate_body_text" placeholder="Session-specific certificate statement... Use {employee_name}, {course_name}..."/>
                                    </group>
                                    <group string="Signatory Details">
                                        <field name="certificate_signatory_name" placeholder="Leave empty to use course default"/>
                                        <field name="certificate_signatory_title"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Daily Feedback" name="feedback">
                                <field name="feedback_ids">
                                    <list editable="bottom">
                                        <field name="employee_id" domain="[('id', 'in', parent.enrolled_employee_ids)]" options="{'no_create': True}"/>
                                        <field name="feedback_date"/>
                                        <field name="day_number"/>
                                        <field name="rating" widget="badge"/>
                                        <field name="topic"/>
                                        <field name="comment"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Pre-Assessment" name="pre_assessment"
                                  groups="employee_development_system.group_eds_officer">
                                <div class="alert alert-info" role="note">
                                    Add questions for this session, or load them from the published course instrument. Sending them to employees is optional. You can also record and grade question-by-question answers manually or import a completed template.
                                </div>
                                <div class="mb-2">
                                    <button name="action_seed_pre_assessment_questions" string="Load Course Questions" type="object"
                                            class="btn btn-secondary btn-sm me-2" icon="fa-copy"/>
                                    <button name="action_distribute_pre_assessment" string="Send Pre-Assessment to Employees" type="object"
                                            class="btn btn-primary btn-sm me-2" icon="fa-send"
                                            invisible="status not in ('scheduled', 'ongoing')"/>
                                    <button name="action_open_assessment_import" string="Export / Import Answers" type="object"
                                            context="{'default_assessment_type': 'pre'}"
                                            class="btn btn-secondary btn-sm" icon="fa-upload"/>
                                </div>
                                <field name="pre_assessment_question_ids"
                                       context="{'default_assessment_type': 'pre', 'default_session_id': id}">
                                    <list editable="bottom" default_order="sequence, id">
                                        <field name="sequence" widget="handle"/>
                                        <field name="question_text"/>
                                        <field name="max_points"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Post-Assessment" name="post_assessment"
                                  groups="employee_development_system.group_eds_officer">
                                <div class="alert alert-info" role="note">
                                    Post-assessment questions are separate from pre-assessment questions. Send them when ready, or record and grade completed answers directly.
                                </div>
                                <div class="mb-2">
                                    <button name="action_seed_post_assessment_questions" string="Load Course Questions" type="object"
                                            class="btn btn-secondary btn-sm me-2" icon="fa-copy"/>
                                    <button name="action_distribute_post_assessment" string="Send Post-Assessment to Employees" type="object"
                                            class="btn btn-primary btn-sm me-2" icon="fa-send"
                                            invisible="status not in ('ongoing', 'completed')"/>
                                    <button name="action_open_assessment_import" string="Export / Import Answers" type="object"
                                            context="{'default_assessment_type': 'post'}"
                                            class="btn btn-secondary btn-sm" icon="fa-upload"/>
                                </div>
                                <field name="post_assessment_question_ids"
                                       context="{'default_assessment_type': 'post', 'default_session_id': id}">
                                    <list editable="bottom" default_order="sequence, id">
                                        <field name="sequence" widget="handle"/>
                                        <field name="question_text"/>
                                        <field name="max_points"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Assessment Responses" name="assessments"
                                  groups="employee_development_system.group_eds_officer">
                                <button name="action_view_assessments" string="Open Assessment Records" type="object"
                                        class="btn btn-primary btn-sm mb-2" icon="fa-external-link"/>
                                <field name="assessment_ids" readonly="1">
                                    <list create="false" delete="false">
                                        <field name="employee_id"/>
                                        <field name="assessment_type"/>
                                        <field name="state" widget="badge"/>
                                        <field name="entry_method"/>
                                        <field name="score" readonly="1"/>
                                        <field name="passed"/>
                                        <field name="assessment_date"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Actual Costs" name="actual_costs"
                                  groups="employee_development_system.group_eds_officer">
                                <field name="cost_ids">
                                    <list editable="bottom">
                                        <field name="amount"/>
                                        <field name="delivery_method" column_invisible="True"/>
                                        <field name="currency_id" readonly="delivery_method != 'international'" context="{'active_test': False}"/>
                                        <field name="payment_state"/>
                                        <field name="payment_date"/>
                                        <field name="finance_reference"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_session" model="ir.actions.act_window">
            <field name="name">Training Sessions</field>
            <field name="res_model">eds.session</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_session_search"/>
        </record>

        <record id="view_eds_session_trainer_list" model="ir.ui.view">
            <field name="name">eds.session.trainer.list</field>
            <field name="model">eds.session</field>
            <field name="priority" eval="30"/>
            <field name="arch" type="xml">
                <list string="My Assigned Sessions" create="false" edit="false" delete="false">
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="venue_id"/>
                    <field name="status" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_session_trainer_form" model="ir.ui.view">
            <field name="name">eds.session.trainer.form</field>
            <field name="model">eds.session</field>
            <field name="priority" eval="30"/>
            <field name="arch" type="xml">
                <form string="Assigned Training Session" create="false" edit="false" delete="false">
                    <sheet>
                        <group>
                            <group string="Course">
                                <field name="name"/>
                                <field name="course_id"/>
                                <field name="delivery_method"/>
                                <field name="status" widget="badge"/>
                            </group>
                            <group string="Schedule">
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="start_time" widget="float_time"/>
                                <field name="duration_hours" widget="float_time"/>
                                <field name="venue_id"/>
                            </group>
                        </group>
                        <group string="Delivery Notes">
                            <field name="notes"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_eds_session_trainer_search" model="ir.ui.view">
            <field name="name">eds.session.trainer.search</field>
            <field name="model">eds.session</field>
            <field name="arch" type="xml">
                <search string="My Assigned Sessions">
                    <field name="name"/>
                    <field name="course_id"/>
                    <filter string="Scheduled" name="scheduled" domain="[('status', '=', 'scheduled')]"/>
                    <filter string="Ongoing" name="ongoing" domain="[('status', '=', 'ongoing')]"/>
                </search>
            </field>
        </record>

        <record id="action_eds_session_trainer" model="ir.actions.act_window">
            <field name="name">My Assigned Sessions</field>
            <field name="res_model">eds.session</field>
            <field name="view_mode">list,form</field>
            <field name="domain">['|', ('trainer_ids.employee_id.user_id', '=', uid), ('trainer_ids.external_partner_id.user_ids', 'in', [uid])]</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_session_trainer_search"/>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('employee_development_system.view_eds_session_trainer_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('employee_development_system.view_eds_session_trainer_form')})]"/>
        </record>

    </data>
</odoo>
