<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eds_internship_application_tree" model="ir.ui.view">
        <field name="name">eds.internship.application.tree</field>
        <field name="model">eds.internship.application</field>
        <field name="arch" type="xml">
            <list string="Internship Applications">
                <field name="name"/>
                <field name="is_internal" widget="boolean_toggle" string="Internal"/>
                <field name="applicant_name"/>
                <field name="employee_id" optional="hide"/>
                <field name="institution"/>
                <field name="field_of_study"/>
                <field name="submitted_date"/>
                <field name="work_unit_id"/>
                <field name="department_id" optional="show"/>
                <field name="supervisor_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'received'"
                       decoration-success="status == 'completed'"
                       decoration-warning="status == 'placed'"/>
            </list>
        </field>
    </record>

    <record id="view_eds_internship_application_form" model="ir.ui.view">
        <field name="name">eds.internship.application.form</field>
        <field name="model">eds.internship.application</field>
        <field name="arch" type="xml">
            <form string="Internship Application &amp; Placement">
                <header>
                    <field name="completion_due" invisible="1"/>
                    <field name="can_manage_host" invisible="1"/>
                    <field name="can_edit_work_unit" invisible="1"/>
                    <field name="can_manage_evaluation" invisible="1"/>
                    <field name="can_reject" invisible="1"/>
                    <button name="action_notify_units" string="Notify Host Work Unit" type="object" class="oe_highlight" invisible="status != 'received'"
                            groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_accept" string="Accept as Host" type="object" class="oe_highlight" invisible="status != 'notified'"
                            groups="employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_place" string="Place Intern" type="object" invisible="status != 'accepted'"
                            groups="employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_start" string="Confirm Intern Started" type="object" class="oe_highlight" invisible="status not in ['accepted', 'placed']"
                            groups="employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_complete" string="Complete Internship" type="object" class="oe_highlight" invisible="status != 'ongoing' or not completion_due"
                            groups="employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_reject" string="Reject with Reason" type="object" invisible="not can_reject"
                            groups="employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <field name="status" widget="statusbar" statusbar_visible="received,notified,accepted,placed,ongoing,completed,rejected" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" invisible="name == 'New'"/></h1>
                    </div>
                    <group>
                        <group string="Applicant Information">
                            <field name="is_internal" widget="boolean_toggle"/>
                            <field name="employee_id" invisible="not is_internal" required="is_internal"
                                   options="{'no_create': True, 'no_open': True}" context="{'eds_employee_select': True}"
                                   domain="[('department_id', '=', department_id)] if department_id else []"/>
                            <field name="applicant_name" readonly="is_internal or not can_edit_work_unit" force_save="1"/>
                            <field name="email" readonly="is_internal or not can_edit_work_unit" force_save="1"/>
                            <field name="phone" readonly="is_internal or not can_edit_work_unit" force_save="1"/>
                            <field name="institution" invisible="is_internal" required="not is_internal" readonly="not can_edit_work_unit"/>
                            <field name="field_of_study" invisible="is_internal" required="not is_internal" readonly="not can_edit_work_unit"/>
                            <field name="submitted_date" readonly="not can_edit_work_unit"/>
                        </group>
                        <group string="Placement &amp; Supervision">
                            <field name="department_id" options="{'no_create': True}" readonly="not can_edit_work_unit" force_save="1"/>
                            <field name="work_unit_id" options="{'no_create': True}" readonly="not can_edit_work_unit" force_save="1"/>
                            <field name="supervisor_id" options="{'no_create': True, 'no_open': True}" context="{'eds_employee_select': True}" readonly="not can_manage_host"/>
                            <field name="start_date" readonly="not can_manage_host"/>
                            <field name="end_date" readonly="not can_manage_host"/>
                            <field name="start_confirmed_on" readonly="1" invisible="not start_confirmed_on"/>
                            <field name="start_confirmed_by_id" readonly="1" invisible="not start_confirmed_on"/>
                        </group>
                    </group>
                    <group string="Host Decision" invisible="not can_reject and status != 'rejected'">
                        <field name="rejection_reason" placeholder="Explain why the host work unit cannot accept this application if rejecting."
                               readonly="status == 'rejected'"/>
                    </group>
                    <notebook class="o_eds_notebook">
                        <page string="Attachments" name="attachments">
                            <group>
                                <field name="scanned_application" filename="scanned_filename" string="Application / Attachment"
                                       options="{'accepted_file_extensions': '.pdf,image/*'}" readonly="not can_edit_work_unit"/>
                                <field name="scanned_filename" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_internship_application" model="ir.actions.act_window">
        <field name="name">Internship Applications</field>
        <field name="res_model">eds.internship.application</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
