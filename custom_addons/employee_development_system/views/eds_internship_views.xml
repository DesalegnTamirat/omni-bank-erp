<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eds_internship_application_tree" model="ir.ui.view">
        <field name="name">eds.internship.application.tree</field>
        <field name="model">eds.internship.application</field>
        <field name="arch" type="xml">
            <list string="Internship Applications">
                <field name="name"/>
                <field name="applicant_name"/>
                <field name="institution"/>
                <field name="field_of_study"/>
                <field name="submitted_date"/>
                <field name="work_unit_id"/>
                <field name="supervisor_id"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'received'"
                       decoration-success="status == 'completed'"
                       decoration-warning="status == 'placed'"/>
            </list>
        </field>
    </record>

    <record id="view_eds_internship_application_form" model="ir.ui.view">
        <field name="name">eds.internship.application.form</field>
        <field name="model">eds.internship.application</field>
        <field name="arch" type="xml">
            <form string="Internship Application &amp; Placement">
                <header>
                    <button name="action_notify_units" string="Notify Work Units" type="object" class="oe_highlight" invisible="status != 'received'"/>
                    <button name="action_accept" string="Accept Application" type="object" class="oe_highlight" invisible="status != 'notified'"/>
                    <button name="action_place" string="Place Intern" type="object" class="oe_highlight" invisible="status != 'accepted'"/>
                    <button name="action_start" string="Start Internship" type="object" class="oe_highlight" invisible="status != 'placed'"/>
                    <button name="action_complete" string="Complete Internship" type="object" class="oe_highlight" invisible="status != 'ongoing'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="status in ['completed', 'rejected']"/>
                    <field name="status" widget="statusbar" statusbar_visible="received,notified,accepted,placed,ongoing,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Applicant Information">
                            <field name="applicant_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="institution"/>
                            <field name="field_of_study"/>
                            <field name="submitted_date"/>
                        </group>
                        <group string="Placement &amp; Supervision">
                            <field name="work_unit_id"/>
                            <field name="supervisor_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scanned Application Letter">
                            <group>
                                <field name="scanned_application" filename="scanned_filename"/>
                                <field name="scanned_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="Periodic Evaluations">
                            <field name="evaluation_ids">
                                <list editable="bottom">
                                    <field name="period"/>
                                    <field name="date"/>
                                    <field name="rating"/>
                                    <field name="comments"/>
                                    <field name="evaluated_by"/>
                                </list>
                            </field>
                        </page>
                        <page string="Progress &amp; Outcome Report">
                            <group>
                                <field name="progress_notes" placeholder="Notes during placement..."/>
                                <field name="outcome_report" placeholder="Final performance &amp; completion summary..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_internship_application" model="ir.actions.act_window">
        <field name="name">Internship Applications</field>
        <field name="res_model">eds.internship.application</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
