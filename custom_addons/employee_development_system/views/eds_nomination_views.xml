<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══════════════ Nominations ══════════════ -->

        <record id="view_eds_nomination_list" model="ir.ui.view">
            <field name="name">eds.nomination.list</field>
            <field name="model">eds.nomination</field>
            <field name="arch" type="xml">
                <list string="Training Nominations" decoration-muted="state in ('rejected','withdrawn','declined')"
                      decoration-success="state == 'approved' and not waitlisted"
                      decoration-warning="waitlisted" decoration-info="state in ('submitted','line_manager_approved','lnd_approved')">
                    <field name="name"/>
                    <field name="session_id"/>
                    <field name="course_name" string="Program"/>
                    <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="department_id"/>
                    <field name="nomination_type" widget="badge"/>
                    <field name="nominated_by"/>
                    <field name="waitlisted"/>
                    <field name="waitlist_position"/>
                    <field name="employee_confirmed" widget="badge"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_nomination_search" model="ir.ui.view">
            <field name="name">eds.nomination.search</field>
            <field name="model">eds.nomination</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="employee_id" context="{'eds_employee_select': True}"/>
                    <field name="session_id"/>
                    <field name="tna_entry_id"/>
                    <filter string="Pending Approval" name="pending"
                            domain="[('state','in',('submitted','line_manager_approved','lnd_approved'))]"/>
                    <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                    <filter string="Waitlisted" name="waitlisted" domain="[('waitlisted','=',True)]"/>
                    <filter string="Needs Employee Confirmation" name="need_confirm"
                            domain="[('state','=','approved'),('employee_confirmed','=','pending')]"/>
                    <separator/>
                    <group name="group_by">
                        <filter string="Session" name="g_session" context="{'group_by':'session_id'}"/>
                        <filter string="State" name="g_state" context="{'group_by':'state'}"/>
                        <filter string="Nomination Type" name="g_type" context="{'group_by':'nomination_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_eds_nomination_form" model="ir.ui.view">
            <field name="name">eds.nomination.form</field>
            <field name="model">eds.nomination</field>
            <field name="arch" type="xml">
                <form string="Training Nomination">
                    <header>
                        <button name="action_submit" string="Submit for Approval" type="object"
                                class="oe_highlight" invisible="state != 'draft'"
                                groups="employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_line_manager_approve" string="Approve as Line Manager"
                                type="object" invisible="state != 'submitted'"
                                groups="employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_lnd_approve" string="Approve as L&amp;D" type="object"
                                class="oe_highlight" invisible="state not in ('submitted','line_manager_approved')"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_approve_budget_hr" string="Approve Budget/HR" type="object"
                                class="oe_highlight" invisible="state != 'lnd_approved' or not budget_hr_required"
                                groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_final_approve" string="Final Approve" type="object"
                                class="oe_highlight" invisible="state != 'lnd_approved'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_reject" string="Reject" type="object"
                                invisible="state not in ('submitted','line_manager_approved','lnd_approved')"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_withdraw" string="Withdraw" type="object"
                                invisible="state not in ('draft','submitted','line_manager_approved','lnd_approved','approved')"
                                groups="employee_development_system.group_eds_employee,employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_employee_accept" string="Accept Nomination" type="object"
                                class="oe_highlight"
                                invisible="state != 'approved' or employee_id.user_id != uid or employee_confirmed != 'pending'"
                                groups="employee_development_system.group_eds_employee"/>
                        <button name="action_employee_decline" string="Decline Nomination" type="object"
                                invisible="state != 'approved' or employee_id.user_id != uid or employee_confirmed != 'pending'"
                                groups="employee_development_system.group_eds_employee"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,line_manager_approved,lnd_approved,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box">
                            <button class="oe_stat_button" type="object"
                                    name="action_open_enrollment" icon="fa-user"
                                    invisible="not enrollment_id">
                                <div class="o_stat_info">
                                    <field name="waitlist_position" widget="statinfo" string="Waitlist Pos"/>
                                    <span class="o_stat_text">Enrollment seat</span>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group string="Nomination">
                                <field name="name" readonly="1" invisible="name == 'New'"/>
                                <field name="session_id"/>
                                <field name="course_name" readonly="1"/>
                                <field name="nomination_type"/>
                                <field name="tna_entry_id" invisible="nomination_type != 'tna_based'"/>
                                <field name="justification" invisible="nomination_type != 'ad_hoc'"/>
                            </group>
                            <group string="Employee">
                                <field name="employee_id" options="{'no_create': True, 'no_open': True}" context="{'eds_employee_select': True}"/>
                                <field name="job_position_id" readonly="1"/>
                                <field name="department_id" readonly="1"/>
                                <field name="work_unit_id" readonly="1"/>
                                <field name="nominated_by" readonly="1"/>
                            </group>
                        </group>
                        <group string="Capacity &amp; Waitlist">
                            <field name="waitlisted"/>
                            <field name="waitlist_position"/>
                            <field name="enrollment_id" readonly="1"/>
                        </group>
                        <notebook class="o_eds_notebook">
                            <page string="Approval Chain " name="approval">
                                <group>
                                    <group>
                                        <field name="line_manager_approved_by" readonly="1"/>
                                        <field name="lnd_approved_by" readonly="1"/>
                                        <field name="approved_by" readonly="1"/>
                                        <field name="approved_date" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="budget_hr_required"/>
                                        <field name="budget_hr_approved" readonly="1"/>
                                        <field name="budget_hr_approved_by" readonly="1"/>
                                        <field name="budget_hr_approval_date" readonly="1"/>
                                        <field name="rejected_reason" invisible="state != 'rejected'"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Employee Confirmation" name="confirmation">
                                <group>
                                    <group>
                                        <field name="employee_confirmed" readonly="1"/>
                                        <field name="confirmation_date" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="decline_reason" invisible="employee_confirmed != 'declined'"/>
                                        <field name="withdraw_reason" invisible="state != 'withdrawn'"/>
                                        <field name="withdrawn_by" readonly="1" invisible="state != 'withdrawn'"/>
                                        <field name="withdrawn_date" readonly="1" invisible="state != 'withdrawn'"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_nomination" model="ir.actions.act_window">
            <field name="name">Nominations</field>
            <field name="res_model">eds.nomination</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_nomination_search"/>
        </record>

        <!-- Employee-facing: My Nominations (accept / decline) -->
        <record id="action_eds_nomination_my" model="ir.actions.act_window">
            <field name="name">My Nominations</field>
            <field name="res_model">eds.nomination</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('employee_id.user_id', '=', uid)]</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_nomination_search"/>
            <field name="context">{'search_default_need_confirm': 1}</field>
        </record>

        <!-- ══════════════ Enrollments ══════════════ -->

        <record id="view_eds_enrollment_list" model="ir.ui.view">
            <field name="name">eds.enrollment.list</field>
            <field name="model">eds.enrollment</field>
            <field name="arch" type="xml">
                <list string="Session Participants" default_order="source_count desc, id desc">
                    <field name="name"/>
                    <field name="session_id"/>
                    <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="source_summary"/>
                    <field name="source_count"/>
                    <field name="work_unit_id"/>
                    <field name="department_id"/>
                    <field name="job_position_id"/>
                    <field name="replacement_employee_id" optional="hide" options="{'no_create': True, 'no_open': True}"/>
                    <field name="manager_replacement_decision" optional="hide"/>
                    <field name="waitlist_position"/>
                    <field name="enrolled_date"/>
                    <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-warning="state == 'incomplete'" decoration-danger="state == 'absent'"/>
                    <field name="lms_completion_state" optional="hide"/>
                    <field name="lms_certificate_state" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_eds_enrollment_search" model="ir.ui.view">
            <field name="name">eds.enrollment.search</field>
            <field name="model">eds.enrollment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="employee_id" context="{'eds_employee_select': True}"/>
                    <field name="session_id"/>
                    <field name="work_unit_id"/>
                    <field name="department_id"/>
                    <field name="job_position_id"/>
                    <filter string="Invited" name="invited" domain="[('state','=','invited')]"/>
                    <filter string="Suggested" name="suggested" domain="[('state','=','suggested')]"/>
                    <filter string="Declined" name="declined" domain="[('state','=','declined')]"/>
                    <filter string="Replaced" name="replaced" domain="[('state','=','replaced')]"/>
                    <filter string="Enrolled" name="enrolled" domain="[('state','=','enrolled')]"/>
                    <filter string="Waitlisted" name="waitlisted" domain="[('state','=','waitlisted')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                    <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                    <filter string="Absent" name="absent" domain="[('state','=','absent')]"/>
                    <separator/>
                    <group name="group_by">
                        <filter string="Session" name="g_session" context="{'group_by':'session_id'}"/>
                        <filter string="Status" name="g_state" context="{'group_by':'state'}"/>
                        <filter string="Work Unit" name="g_work_unit" context="{'group_by':'work_unit_id'}"/>
                        <filter string="Department" name="g_department" context="{'group_by':'department_id'}"/>
                        <filter string="Position" name="g_position" context="{'group_by':'job_position_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_eds_enrollment_form" model="ir.ui.view">
            <field name="name">eds.enrollment.form</field>
            <field name="model">eds.enrollment</field>
            <field name="arch" type="xml">
                <form string="Session Enrollment">
                    <header>
                        <field name="can_manage_replacement" invisible="1"/>
                        <button name="action_open_response" string="Respond to Invitation" type="object"
                                class="oe_highlight" invisible="state != 'invited'"/>
                        <button name="action_open_manager_replacement" string="Decide Replacement"
                                type="object" invisible="not can_manage_replacement"/>
                        <button name="action_open_materials" string="View Training Materials" type="object"
                                invisible="state not in ('enrolled','completed') or not session_id"/>
                        <button name="action_cancel" string="Cancel Enrollment" type="object"
                                invisible="state not in ('suggested','invited','enrolled','waitlisted')"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group string="Training Details">
                            <group>
                                <field name="course_id" readonly="1" options="{'no_open': True}"/>
                                <field name="training_provider_name" readonly="1"/>
                                <field name="venue_id" readonly="1" options="{'no_open': True}"/>
                                <field name="venue_location_details" readonly="1"
                                       invisible="not venue_location_details"/>
                            </group>
                            <group>
                                <field name="session_start" readonly="1"/>
                                <field name="session_end" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="session_id" readonly="id" options="{'no_open': True, 'no_create': True}"/>
                                <field name="employee_id" readonly="id" options="{'no_create': True, 'no_open': True}" context="{'eds_employee_select': True}"/>
                                <field name="selected" invisible="state != 'suggested'"/>
                                <field name="source_summary" readonly="1"/>
                                <field name="source_count" readonly="1"/>
                                <field name="work_unit_id" readonly="1"/>
                                <field name="department_id" readonly="1"/>
                                <field name="job_position_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="course_demand_employee_id" readonly="1"/>
                                <field name="replacement_employee_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                <field name="replaces_enrollment_id" readonly="1"/>
                                <field name="response_note" readonly="1"/>
                                <field name="response_date" readonly="1"/>
                                <field name="manager_replacement_decision" readonly="1"
                                       invisible="state not in ('declined','replaced')"/>
                                <field name="manager_replacement_decided_by_id" readonly="1"
                                       invisible="not manager_replacement_decided_at"/>
                                <field name="manager_replacement_decided_at" readonly="1"
                                       invisible="not manager_replacement_decided_at"/>
                                <field name="manager_replacement_note" readonly="1"
                                       invisible="not manager_replacement_note"/>
                                <field name="nomination_id" readonly="1" invisible="not nomination_id"/>
                                <field name="enrolled_date"/>
                                <field name="waitlist_position" invisible="state != 'waitlisted'"/>
                            </group>
                        </group>
                        <group string="Accepted Training Commitment" invisible="not commitment_accepted_at">
                            <field name="commitment_years_at_accept" readonly="1"/>
                            <field name="commitment_accepted_at" readonly="1"/>
                            <field name="commitment_terms_at_accept" readonly="1"/>
                        </group>
                        <group string="Linked Online Learning" invisible="not lms_enrollment_ref">
                            <field name="lms_enrollment_ref" readonly="1"/>
                            <field name="lms_completion_state" readonly="1"/>
                            <field name="lms_completion_date" readonly="1"/>
                            <field name="lms_certificate_state" readonly="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_enrollment" model="ir.actions.act_window">
            <field name="name">Session Participants</field>
            <field name="res_model">eds.enrollment</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_enrollment_search"/>
        </record>
        <record id="action_eds_enrollment_my" model="ir.actions.act_window">
            <field name="name">My Training Invitations</field>
            <field name="res_model">eds.enrollment</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_enrollment_search"/>
            <field name="domain">[('employee_id.user_id', '=', uid)]</field>
            <field name="context">{'search_default_invited': 1}</field>
        </record>

    </data>
</odoo>
