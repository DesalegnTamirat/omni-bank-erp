<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══════════════ Nominations (FREDS038, FR-EDS-024...030) ══════════════ -->

        <record id="view_eds_nomination_list" model="ir.ui.view">
            <field name="name">eds.nomination.list</field>
            <field name="model">eds.nomination</field>
            <field name="arch" type="xml">
                <list string="Training Nominations" decoration-muted="state in ('rejected','withdrawn','declined')"
                      decoration-success="state == 'approved' and not waitlisted"
                      decoration-warning="waitlisted" decoration-info="state in ('submitted','line_manager_approved','lnd_approved')">
                    <field name="name"/>
                    <field name="session_id"/>
                    <field name="course_name" string="Program"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="nomination_type" widget="badge"/>
                    <field name="nominated_by"/>
                    <field name="waitlisted"/>
                    <field name="waitlist_position"/>
                    <field name="employee_confirmed" widget="badge"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_nomination_search" model="ir.ui.view">
            <field name="name">eds.nomination.search</field>
            <field name="model">eds.nomination</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="session_id"/>
                    <field name="tna_entry_id"/>
                    <filter string="Pending Approval" name="pending"
                            domain="[('state','in',('submitted','line_manager_approved','lnd_approved'))]"/>
                    <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                    <filter string="Waitlisted" name="waitlisted" domain="[('waitlisted','=',True)]"/>
                    <filter string="Needs Employee Confirmation" name="need_confirm"
                            domain="[('state','=','approved'),('employee_confirmed','=','pending')]"/>
                    <separator/>
                    <group name="group_by">
                        <filter string="Session" name="g_session" context="{'group_by':'session_id'}"/>
                        <filter string="State" name="g_state" context="{'group_by':'state'}"/>
                        <filter string="Nomination Type" name="g_type" context="{'group_by':'nomination_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_eds_nomination_form" model="ir.ui.view">
            <field name="name">eds.nomination.form</field>
            <field name="model">eds.nomination</field>
            <field name="arch" type="xml">
                <form string="Training Nomination">
                    <header>
                        <button name="action_submit" string="Submit for Approval" type="object"
                                class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_line_manager_approve" string="Approve as Line Manager"
                                type="object" invisible="state != 'submitted'"/>
                        <button name="action_lnd_approve" string="Approve as L&amp;D" type="object"
                                class="oe_highlight" invisible="state not in ('submitted','line_manager_approved')"/>
                        <button name="action_approve_budget_hr" string="Approve Budget/HR" type="object"
                                class="oe_highlight" invisible="state != 'lnd_approved' or not budget_hr_required"/>
                        <button name="action_final_approve" string="Final Approve" type="object"
                                class="oe_highlight" invisible="state != 'lnd_approved'"/>
                        <button name="action_reject" string="Reject" type="object"
                                invisible="state not in ('submitted','line_manager_approved','lnd_approved')"/>
                        <button name="action_withdraw" string="Withdraw" type="object"
                                invisible="state not in ('draft','submitted','line_manager_approved','lnd_approved','approved')"/>
                        <button name="action_employee_accept" string="Accept Nomination" type="object"
                                class="oe_highlight"
                                invisible="state != 'approved' or employee_id.user_id != uid or employee_confirmed != 'pending'"/>
                        <button name="action_employee_decline" string="Decline Nomination" type="object"
                                invisible="state != 'approved' or employee_id.user_id != uid or employee_confirmed != 'pending'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,line_manager_approved,lnd_approved,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box">
                            <button class="oe_stat_button" type="object"
                                    name="action_open_enrollment" icon="fa-user"
                                    invisible="not enrollment_id">
                                <div class="o_stat_info">
                                    <field name="waitlist_position" widget="statinfo" string="Waitlist Pos"/>
                                    <span class="o_stat_text">Enrollment seat</span>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group string="Nomination">
                                <field name="name" readonly="1"/>
                                <field name="session_id"/>
                                <field name="course_name" readonly="1"/>
                                <field name="nomination_type"/>
                                <field name="tna_entry_id" invisible="nomination_type != 'tna_based'"/>
                                <field name="justification" invisible="nomination_type != 'ad_hoc'"/>
                            </group>
                            <group string="Employee">
                                <field name="employee_id"/>
                                <field name="job_position_id" readonly="1"/>
                                <field name="department_id" readonly="1"/>
                                <field name="work_unit_id" readonly="1"/>
                                <field name="nominated_by" readonly="1"/>
                            </group>
                        </group>
                        <group string="Capacity &amp; Waitlist (FR-EDS-027/028)">
                            <field name="waitlisted"/>
                            <field name="waitlist_position"/>
                            <field name="enrollment_id" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Approval Chain (FR-EDS-026)" name="approval">
                                <group>
                                    <group>
                                        <field name="line_manager_approved_by" readonly="1"/>
                                        <field name="lnd_approved_by" readonly="1"/>
                                        <field name="approved_by" readonly="1"/>
                                        <field name="approved_date" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="budget_hr_required"/>
                                        <field name="budget_hr_approved" readonly="1"/>
                                        <field name="budget_hr_approved_by" readonly="1"/>
                                        <field name="budget_hr_approval_date" readonly="1"/>
                                        <field name="rejected_reason" invisible="state != 'rejected'"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Employee Confirmation" name="confirmation">
                                <group>
                                    <group>
                                        <field name="employee_confirmed" readonly="1"/>
                                        <field name="confirmation_date" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="decline_reason" invisible="employee_confirmed != 'declined'"/>
                                        <field name="withdraw_reason" invisible="state != 'withdrawn'"/>
                                        <field name="withdrawn_by" readonly="1" invisible="state != 'withdrawn'"/>
                                        <field name="withdrawn_date" readonly="1" invisible="state != 'withdrawn'"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_nomination" model="ir.actions.act_window">
            <field name="name">Nominations</field>
            <field name="res_model">eds.nomination</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_nomination_search"/>
        </record>

        <!-- Employee-facing: My Nominations (accept / decline) -->
        <record id="action_eds_nomination_my" model="ir.actions.act_window">
            <field name="name">My Nominations</field>
            <field name="res_model">eds.nomination</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('employee_id.user_id', '=', uid)]</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_nomination_search"/>
            <field name="context">{'search_default_need_confirm': 1}</field>
        </record>

        <!-- ══════════════ Enrollments ══════════════ -->

        <record id="view_eds_enrollment_list" model="ir.ui.view">
            <field name="name">eds.enrollment.list</field>
            <field name="model">eds.enrollment</field>
            <field name="arch" type="xml">
                <list string="Session Enrollments">
                    <field name="name"/>
                    <field name="session_id"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="nomination_id"/>
                    <field name="waitlist_position"/>
                    <field name="enrolled_date"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_enrollment_search" model="ir.ui.view">
            <field name="name">eds.enrollment.search</field>
            <field name="model">eds.enrollment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="session_id"/>
                    <filter string="Enrolled" name="enrolled" domain="[('state','=','enrolled')]"/>
                    <filter string="Waitlisted" name="waitlisted" domain="[('state','=','waitlisted')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                    <separator/>
                    <group name="group_by">
                        <filter string="Session" name="g_session" context="{'group_by':'session_id'}"/>
                        <filter string="Status" name="g_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_eds_enrollment_form" model="ir.ui.view">
            <field name="name">eds.enrollment.form</field>
            <field name="model">eds.enrollment</field>
            <field name="arch" type="xml">
                <form string="Session Enrollment">
                    <header>
                        <button name="action_cancel" string="Cancel Enrollment" type="object"
                                invisible="state not in ('enrolled','waitlisted')"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="session_id"/>
                                <field name="employee_id"/>
                            </group>
                            <group>
                                <field name="nomination_id" readonly="1"/>
                                <field name="enrolled_date"/>
                                <field name="waitlist_position" invisible="state != 'waitlisted'"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_enrollment" model="ir.actions.act_window">
            <field name="name">Enrollments</field>
            <field name="res_model">eds.enrollment</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_enrollment_search"/>
        </record>

    </data>
</odoo>
