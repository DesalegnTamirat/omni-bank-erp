<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eds_meeting_minutes_form" model="ir.ui.view">
        <field name="name">eds.approval.minute.wizard.form</field>
        <field name="model">eds.approval.minute.wizard</field>
        <field name="arch" type="xml">
            <form string="Download Approval Minute">
                <sheet>
                    <group>
                        <field name="approval_type" required="1"/>
                        <field name="annual_plan_id" string="Approved Annual Plan"
                               invisible="approval_type != 'annual_plan'"
                               required="approval_type == 'annual_plan'"
                               domain="[('state', '=', 'published')]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="unscheduled_request_id" string="Approved Unscheduled Request"
                               invisible="approval_type != 'unscheduled_request'"
                               required="approval_type == 'unscheduled_request'"
                               domain="[('state', '=', 'approved')]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="vendor_selection_id" string="Awarded Training Provider Selection"
                               invisible="approval_type != 'vendor_selection'"
                               required="approval_type == 'vendor_selection'"
                               domain="[('state', '=', 'awarded')]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="hotel_selection_id" string="Awarded Hotel / Venue Selection"
                               invisible="approval_type != 'hotel_selection'"
                               required="approval_type == 'hotel_selection'"
                               domain="[('state', '=', 'awarded')]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="rfp_id" string="Awarded Request for Proposal"
                               invisible="approval_type != 'rfp'"
                               required="approval_type == 'rfp'"
                               domain="[('state', '=', 'awarded')]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="sponsorship_id" string="Approved Sponsorship"
                               invisible="approval_type != 'sponsorship'"
                               required="approval_type == 'sponsorship'"
                               domain="[('state', 'in', ['approved', 'active', 'completed', 'breached'])]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="tna_consolidation_id" string="Approved TNA Consolidation"
                               invisible="approval_type != 'tna_consolidation'"
                               required="approval_type == 'tna_consolidation'"
                               domain="[('state', 'in', ['approved', 'locked'])]"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_download" type="object" string="Download PDF"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eds_meeting_minutes" model="ir.actions.act_window">
        <field name="name">Approval Minutes</field>
        <field name="res_model">eds.approval.minute.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_eds_meeting_minutes_form"/>
        <field name="search_view_id" eval="False"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_eds_meeting_minutes" name="Approval Minutes"
              parent="menu_eds_reporting_root" action="action_eds_meeting_minutes"
              sequence="10" groups="employee_development_system.group_eds_officer"/>
</odoo>

