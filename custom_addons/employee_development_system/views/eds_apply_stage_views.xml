<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- OJT Assignment Views -->
    <record id="view_eds_ojt_assignment_list" model="ir.ui.view">
        <field name="name">eds.ojt.assignment.list</field>
        <field name="model">eds.ojt.assignment</field>
        <field name="arch" type="xml">
            <list string="OJT Assignments">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="assignment_type"/>
                <field name="supervisor_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eds_ojt_assignment_form" model="ir.ui.view">
        <field name="name">eds.ojt.assignment.form</field>
        <field name="model">eds.ojt.assignment</field>
        <field name="arch" type="xml">
            <form string="OJT Assignment">
                <header>
                    <button name="action_start" string="Start OJT" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_evaluate" string="Submit Evaluation" type="object" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_complete" string="Complete Assignment" type="object" class="btn-success" invisible="state != 'evaluated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,evaluated,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="assignment_type"/>
                            <field name="supervisor_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="competency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Progress &amp; Checklists">
                            <field name="progress_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="checklist_item"/>
                                    <field name="is_completed"/>
                                    <field name="supervisor_evaluation"/>
                                    <field name="comments"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes &amp; Objectives">
                            <field name="notes" placeholder="Detailed OJT objectives..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_ojt_assignment" model="ir.actions.act_window">
        <field name="name">OJT Assignments</field>
        <field name="res_model">eds.ojt.assignment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Coaching Plan Views -->
    <record id="view_eds_coaching_plan_list" model="ir.ui.view">
        <field name="name">eds.coaching.plan.list</field>
        <field name="model">eds.coaching.plan</field>
        <field name="arch" type="xml">
            <list string="Coaching Plans">
                <field name="name"/>
                <field name="coachee_id"/>
                <field name="coach_type"/>
                <field name="internal_coach_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eds_coaching_plan_form" model="ir.ui.view">
        <field name="name">eds.coaching.plan.form</field>
        <field name="model">eds.coaching.plan</field>
        <field name="arch" type="xml">
            <form string="Coaching Plan">
                <header>
                    <button name="action_activate" string="Activate Plan" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_complete" string="Complete Plan" type="object" class="btn-success" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="coachee_id"/>
                            <field name="coach_type"/>
                            <field name="internal_coach_id" invisible="coach_type != 'internal'"/>
                            <field name="external_coach_name" invisible="coach_type != 'external'"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Coaching Sessions">
                            <field name="session_ids">
                                <list editable="bottom">
                                    <field name="session_date"/>
                                    <field name="duration_hours"/>
                                    <field name="summary"/>
                                    <field name="progress_rating"/>
                                    <field name="next_session_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Objectives">
                            <field name="objectives" placeholder="Coaching goals and agreements..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_coaching_plan" model="ir.actions.act_window">
        <field name="name">Coaching Plans</field>
        <field name="res_model">eds.coaching.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Mentoring Program Views -->
