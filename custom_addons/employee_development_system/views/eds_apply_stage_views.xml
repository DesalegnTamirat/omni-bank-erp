    <record id="view_eds_mentoring_program_form" model="ir.ui.view">
        <field name="name">eds.mentoring.program.form</field>
        <field name="model">eds.mentoring.program</field>
        <field name="arch" type="xml">
            <form string="Mentoring Program">
                <header>
                    <button name="action_activate" string="Activate Program" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_complete" string="Complete Program" type="object" class="btn-success" invisible="state not in ('active', 'review')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,review,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="mentee_id"/>
                            <field name="mentor_type"/>
                            <field name="internal_mentor_id" invisible="mentor_type != 'internal'"/>
                            <field name="external_mentor_name" invisible="mentor_type != 'external'"/>
                        </group>
                        <group>
                            <field name="target_position_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Periodic Reviews">
                            <field name="review_ids">
                                <list editable="bottom">
                                    <field name="review_date"/>
                                    <field name="mentor_feedback"/>
                                    <field name="mentee_feedback"/>
                                    <field name="overall_rating"/>
                                </list>
                            </field>
                        </page>
                        <page string="Objectives">
                            <field name="objectives"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_mentoring_program" model="ir.actions.act_window">
        <field name="name">Mentoring Programs</field>
        <field name="res_model">eds.mentoring.program</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Induction Program Views -->
