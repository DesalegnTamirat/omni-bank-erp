                    <button name="action_start" string="Start Program" type="object" class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_complete" string="Complete Program" type="object" class="btn-success" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,completed"/>
