    <record id="action_eds_induction_program" model="ir.actions.act_window">
        <field name="name">Induction &amp; Onboarding</field>
        <field name="res_model">eds.induction.program</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Learning Event Views -->
    <record id="view_eds_learning_event_list" model="ir.ui.view">
        <field name="name">eds.learning.event.list</field>
        <field name="model">eds.learning.event</field>
        <field name="arch" type="xml">
            <list string="Learning Events">
                <field name="name"/>
                <field name="topic"/>
                <field name="initiator_type"/>
                <field name="event_type"/>
                <field name="start_datetime"/>
                <field name="location"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eds_learning_event_form" model="ir.ui.view">
        <field name="name">eds.learning.event.form</field>
        <field name="model">eds.learning.event</field>
        <field name="arch" type="xml">
            <form string="Learning Event">
                <header>
                    <button name="action_schedule" string="Schedule Event" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_conduct" string="Mark Conducted" type="object" class="btn-success" invisible="state != 'scheduled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,conducted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="topic"/>
                            <field name="initiator_type"/>
                            <field name="event_type"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="location"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Facilitators &amp; Attendees">
                            <group>
                                <field name="facilitator_ids" widget="many2many_tags"/>
                                <field name="attendee_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Outcomes &amp; Materials">
                            <field name="outcomes_summary" placeholder="Summary of event outcomes..."/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_learning_event" model="ir.actions.act_window">
        <field name="name">Learning Events &amp; Workshops</field>
        <field name="res_model">eds.learning.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Individual Development Plan (IDP) Views -->
    <record id="view_eds_individual_development_plan_list" model="ir.ui.view">
        <field name="name">eds.individual.development.plan.list</field>
        <field name="model">eds.individual.development.plan</field>
        <field name="arch" type="xml">
            <list string="Individual Development Plans">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="target_job_id"/>
                <field name="review_frequency"/>
                <field name="next_review_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eds_individual_development_plan_form" model="ir.ui.view">
        <field name="name">eds.individual.development.plan.form</field>
        <field name="model">eds.individual.development.plan</field>
        <field name="arch" type="xml">
            <form string="Individual Development Plan">
                <header>
                    <button name="action_submit" string="Submit for Review" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve IDP" type="object" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_start" string="Start Execution" type="object" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_complete" string="Mark Completed" type="object" class="btn-success" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="target_job_id"/>
                        </group>
                        <group>
                            <field name="pip_reference"/>
                            <field name="review_frequency"/>
                            <field name="next_review_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Development Milestones">
                            <field name="milestone_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="activity_type"/>
                                    <field name="target_date"/>
                                    <field name="status"/>
                                    <field name="completion_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Gaps &amp; Objectives">
                            <group>
                                <field name="competency_gap_notes"/>
                                <field name="career_objectives"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_individual_development_plan" model="ir.actions.act_window">
        <field name="name">Individual Development Plans (IDP)</field>
        <field name="res_model">eds.individual.development.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Self-Development Activity Views -->
    <record id="view_eds_self_development_activity_list" model="ir.ui.view">
        <field name="name">eds.self.development.activity.list</field>
        <field name="model">eds.self.development.activity</field>
        <field name="arch" type="xml">
            <list string="Self-Development Activities">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="activity_type"/>
                <field name="completion_date"/>
                <field name="hours_spent"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eds_self_development_activity_form" model="ir.ui.view">
        <field name="name">eds.self.development.activity.form</field>
        <field name="model">eds.self.development.activity</field>
        <field name="arch" type="xml">
            <form string="Self-Development Activity">
                <header>
                    <button name="action_submit" string="Submit Activity" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_verify" string="Verify &amp; Record" type="object" class="btn-success" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="activity_type"/>
                        </group>
                        <group>
                            <field name="completion_date"/>
                            <field name="hours_spent"/>
                            <field name="verified_by_id" invisible="state != 'verified'"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="evidence_file" filename="evidence_filename"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_self_development_activity" model="ir.actions.act_window">
        <field name="name">Self-Development Log</field>
        <field name="res_model">eds.self.development.activity</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Assessment Center Views -->
    <record id="view_eds_assessment_center_list" model="ir.ui.view">
        <field name="name">eds.assessment.center.list</field>
        <field name="model">eds.assessment.center</field>
        <field name="arch" type="xml">
            <list string="Assessment Centers">
                <field name="name"/>
                <field name="target_job_id"/>
                <field name="assessment_tool"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eds_assessment_center_form" model="ir.ui.view">
        <field name="name">eds.assessment.center.form</field>
        <field name="model">eds.assessment.center</field>
        <field name="arch" type="xml">
            <form string="Assessment Center">
                <header>
                    <button name="action_schedule" string="Schedule" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Sessions" type="object" class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_complete" string="Complete AC" type="object" class="btn-success" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="target_job_id"/>
                            <field name="assessment_tool"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="assessor_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sessions">
                            <field name="session_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="session_datetime"/>
                                    <field name="location"/>
                                </list>
                            </field>
                        </page>
                        <page string="Candidate Results (Confidential)">
                            <field name="result_ids">
                                <list editable="bottom">
                                    <field name="candidate_id"/>
                                    <field name="overall_score"/>
                                    <field name="recommendation"/>
                                    <field name="evaluation_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_assessment_center" model="ir.actions.act_window">
        <field name="name">Assessment Centers</field>
        <field name="res_model">eds.assessment.center</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
