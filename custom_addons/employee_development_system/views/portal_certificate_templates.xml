<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Portal: My Certificates -->
    <template id="portal_my_certificates_template" name="My Training Certificates">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <div class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h2 class="font-weight-bold" style="color: #721c24;">
                            <i class="fa fa-graduation-cap me-2"/> My Training Certificates
                        </h2>
                        <p class="text-muted mb-0">
                            Official certificates of participation issued by Bunna Bank People Performance &amp; Development Directorate (PPDD).
                        </p>
                    </div>
                    <span class="badge rounded-pill bg-danger fs-6 px-3 py-2" style="background-color: #721c24 !important;">
                        <t t-esc="len(certificates)"/> Certificate(s)
                    </span>
                </div>

                <t t-if="not certificates">
                    <div class="alert alert-info py-4 text-center rounded-3 shadow-sm" role="alert">
                        <i class="fa fa-info-circle fa-2x mb-2" style="color: #17a2b8;"/><br/>
                        <h5>No issued certificates found yet.</h5>
                        <p class="text-muted mb-0">
                            Certificates will appear here once your training sessions are completed and verified by the L&amp;D team.
                        </p>
                    </div>
                </t>

                <div class="row g-4" t-if="certificates">
                    <t t-foreach="certificates" t-as="cert">
                        <div class="col-md-6 col-lg-6">
                            <div class="card h-100 shadow-sm border-0" style="border-radius: 8px; overflow: hidden; transition: transform 0.2s;">
                                <!-- Certificate Image Preview -->
                                <div class="bg-light text-center p-2 border-bottom" style="position: relative;">
                                    <img t-if="cert.certificate_image"
                                         t-att-src="'/web/image/eds.certificate/' + str(cert.id) + '/certificate_image'"
                                         class="img-fluid rounded"
                                         alt="Certificate Preview"
                                         style="max-height: 260px; object-fit: contain; box-shadow: 0 2px 8px rgba(0,0,0,0.1);"/>
                                    <div t-if="not cert.certificate_image" class="py-5 text-muted">
                                        <i class="fa fa-file-picture-o fa-3x"/>
                                        <p class="mt-2">Preview generating...</p>
                                    </div>
                                    <span class="badge bg-dark position-absolute top-0 end-0 m-3 px-2 py-1 font-monospace" style="opacity: 0.85;">
                                        CNO: <t t-esc="cert.code"/>
                                    </span>
                                </div>

                                <!-- Card Details -->
                                <div class="card-body">
                                    <h5 class="card-title font-weight-bold mb-2" style="color: #721c24;">
                                        <t t-esc="cert.course_id.name or cert.session_id.program_name or 'Training Program'"/>
                                    </h5>
                                    <div class="text-muted small mb-3">
                                        <div><i class="fa fa-calendar-check-o me-1 text-secondary"/> <strong>Training Period:</strong> <t t-esc="cert.training_dates_text or 'N/A'"/></div>
                                        <div><i class="fa fa-certificate me-1 text-secondary"/> <strong>Issue Date:</strong> <span t-esc="cert.issue_date" t-options="{'widget': 'date'}"/></div>
                                        <div><i class="fa fa-user-secret me-1 text-secondary"/> <strong>Approved By:</strong> <t t-esc="cert.signatory_name"/> (<t t-esc="cert.signatory_title"/>)</div>
                                    </div>
                                </div>

                                <!-- Card Actions -->
                                <div class="card-footer bg-white border-top-0 pt-0 pb-3 d-flex justify-content-between align-items-center">
                                    <div class="btn-group">
                                        <a t-att-href="'/my/certificates/download/' + str(cert.id) + '/image'"
                                           class="btn btn-sm btn-outline-danger font-weight-bold"
                                           title="Download Certificate as PNG Image">
                                            <i class="fa fa-picture-o me-1"/> Download Image
                                        </a>
                                        <a t-att-href="'/my/certificates/download/' + str(cert.id) + '/pdf'"
                                           class="btn btn-sm btn-outline-info font-weight-bold"
                                           title="Download Certificate as PDF Document">
                                            <i class="fa fa-file-pdf-o me-1"/> Download PDF
                                        </a>
                                    </div>
                                    <a t-att-href="'/eds/certificate/verify/' + str(cert.verification_token)"
                                       target="_blank"
                                       class="btn btn-sm btn-link text-muted"
                                       title="View Online Public Verification Page">
                                        <i class="fa fa-shield me-1 text-success"/> Verify Online
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- Public Certificate Verification Page -->
    <template id="portal_certificate_verify_template" name="Bunna Bank Certificate Verification">
        <t t-call="web.layout">
            <t t-set="head">
                <title>Bunna Bank Certificate Verification</title>
                <link rel="stylesheet" href="/web/static/lib/bootstrap/css/bootstrap.css"/>
                <link rel="stylesheet" href="/web/static/lib/fontawesome/css/font-awesome.css"/>
            </t>
            <div class="container my-5" style="max-width: 900px;">
                <!-- Header Card -->
                <div class="card shadow-sm border-0 mb-4" style="border-radius: 10px; overflow: hidden;">
                    <div class="p-4 text-white d-flex justify-content-between align-items-center" style="background-color: #721c24;">
                        <div>
                            <h3 class="mb-1 font-weight-bold">ቡና ባንክ | BUNNA BANK S.C.</h3>
                            <div class="opacity-75 small">People Performance &amp; Development Directorate (PPDD)</div>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-light text-dark px-3 py-2 fs-6">Certificate Verification</span>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <!-- Search Box if needed -->
                        <form action="/eds/certificate/verify" method="GET" class="mb-4">
                            <div class="input-group">
                                <input type="text" name="cno" class="form-control form-control-lg"
                                       placeholder="Enter Certificate Number (e.g. CERT/2026/0001)..."
                                       t-att-value="token or ''"/>
                                <button class="btn btn-danger btn-lg" type="submit" style="background-color: #721c24;">
                                    <i class="fa fa-search me-1"/> Verify Certificate
                                </button>
                            </div>
                        </form>

                        <!-- State 1: Valid Certificate -->
                        <t t-if="is_valid">
                            <div class="alert alert-success d-flex align-items-center py-3 mb-4 rounded-3" role="alert">
                                <i class="fa fa-check-circle fa-2x text-success me-3"/>
                                <div>
                                    <h5 class="alert-heading mb-0 font-weight-bold">AUTHENTIC &amp; VERIFIED CERTIFICATE</h5>
                                    <div class="small">This certificate is genuine and officially issued by Bunna Bank S.C.</div>
                                </div>
                            </div>

                            <div class="row align-items-center mb-4">
                                <div class="col-md-7">
                                    <table class="table table-borderless table-sm mb-0">
                                        <tbody>
                                            <tr>
                                                <th class="text-muted" style="width: 35%;">Recipient:</th>
                                                <td class="fs-5 font-weight-bold" style="color: #721c24;"><t t-esc="cert.employee_id.name"/></td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Training Title:</th>
                                                <td class="font-weight-bold"><t t-esc="cert.course_id.name or cert.session_id.program_name"/></td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Certificate No (CNO):</th>
                                                <td><span class="badge bg-secondary font-monospace"><t t-esc="cert.code"/></span></td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Training Period:</th>
                                                <td><t t-esc="cert.training_dates_text"/></td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Issue Date:</th>
                                                <td><span t-esc="cert.issue_date" t-options="{'widget': 'date'}"/></td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Issuing Authority:</th>
                                                <td><t t-esc="cert.signatory_name"/> (<t t-esc="cert.signatory_title"/>)</td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Verification Status:</th>
                                                <td><span class="badge bg-success"><i class="fa fa-shield me-1"/> Active &amp; Valid</span></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-md-5 text-center" t-if="cert.certificate_image">
                                    <div class="p-2 border rounded shadow-sm bg-light">
                                        <img t-att-src="'/web/image/eds.certificate/' + str(cert.id) + '/certificate_image'"
                                             class="img-fluid rounded" alt="Certificate Image"/>
                                        <div class="mt-2">
                                            <a t-att-href="'/my/certificates/download/' + str(cert.id) + '/image'" class="btn btn-sm btn-outline-danger me-1">
                                                <i class="fa fa-picture-o"/> Download Image
                                            </a>
                                            <a t-att-href="'/my/certificates/download/' + str(cert.id) + '/pdf'" class="btn btn-sm btn-outline-info">
                                                <i class="fa fa-file-pdf-o"/> Download PDF
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- State 2: Void Certificate -->
                        <t t-if="is_void">
                            <div class="alert alert-danger d-flex align-items-center py-3 mb-0 rounded-3" role="alert">
                                <i class="fa fa-ban fa-2x text-danger me-3"/>
                                <div>
                                    <h5 class="alert-heading mb-0 font-weight-bold">CERTIFICATE REVOKED / VOIDED</h5>
                                    <div class="small">Certificate <strong t-esc="cert.code"/> has been officially revoked by Bunna Bank.</div>
                                </div>
                            </div>
                        </t>

                        <!-- State 3: Not Found -->
                        <t t-if="not found and token">
                            <div class="alert alert-warning text-center py-4 rounded-3" role="alert">
                                <i class="fa fa-exclamation-triangle fa-2x text-warning mb-2"/><br/>
                                <h5>Certificate Record Not Found</h5>
                                <p class="text-muted mb-0">
                                    No certificate matching verification token or number “<strong t-esc="token"/>” was found in the Bunna Bank records.
                                </p>
                            </div>
                        </t>
                    </div>

                    <div class="card-footer bg-light text-center text-muted small py-3">
                        Bunna Bank S.C. | Bank of the Visionaries! | People Performance &amp; Development Directorate
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
