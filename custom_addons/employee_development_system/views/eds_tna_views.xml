<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══════════════ TNA Cycle ══════════════ -->

        <record id="view_eds_tna_cycle_list" model="ir.ui.view">
            <field name="name">eds.tna.cycle.list</field>
            <field name="model">eds.tna.cycle</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="year"/>
                    <field name="start_date"/>
                    <field name="submission_end_date"/>
                    <field name="approval_deadline"/>
                    <field name="entry_count"/>
                    <field name="days_until_deadline" decoration-danger="days_until_deadline &gt;= 0 and days_until_deadline &lt;= 7"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_tna_cycle_form" model="ir.ui.view">
            <field name="name">eds.tna.cycle.form</field>
            <field name="model">eds.tna.cycle</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_start_collection" string="Start Collection"
                                type="object" class="oe_highlight" invisible="state != 'draft'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_open_pull_competency_gaps" string="Pull Closed Competency Gaps"
                                type="object" class="btn-primary" invisible="state not in ('draft', 'collecting')"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_open_pull_pms_gaps" string="Pull PMS Appraisal Gaps"
                                type="object" class="btn-secondary" invisible="state not in ('draft', 'collecting')"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_finish_collection" string="Finish Collection"
                                type="object" class="oe_highlight" invisible="state != 'collecting'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_submit_for_approval" string="Submit for Approval"
                                type="object" class="oe_highlight" invisible="state != 'consolidating'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="%(employee_development_system.action_eds_tna_consolidation_wizard)d"
                                string="Consolidate Needs" type="action" class="oe_highlight"
                                invisible="state not in ('collecting','consolidating','under_approval')"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_approve" string="Approve TNA"
                                type="object" class="oe_highlight" invisible="state != 'under_approval'"
                                groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_lock" string="Lock Approved TNA"
                                type="object" invisible="state != 'approved'"
                                groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_unlock" string="Unlock (Change Request)"
                                type="object" invisible="state != 'locked'"
                                groups="employee_development_system.group_eds_admin"/>
                        <field name="state" widget="statusbar"
                                statusbar_visible="draft,collecting,consolidating,under_approval,approved,locked"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" colspan="2">
                            <button class="oe_stat_button" icon="fa-list-ul">
                                <field name="entry_count" widget="statinfo" string="Total Needs"/>
                            </button>
                            <button class="oe_stat_button" icon="fa-bullseye">
                                <field name="competency_gap_count" widget="statinfo" string="Competency Gaps"/>
                            </button>
                            <button class="oe_stat_button" icon="fa-line-chart">
                                <field name="pms_gap_count" widget="statinfo" string="PMS Gaps"/>
                            </button>
                            <button name="%(employee_development_system.action_eds_tna_consolidation)d"
                                    type="action" class="oe_stat_button" icon="fa-archive"
                                    groups="employee_development_system.group_eds_officer">
                                <field name="consolidation_count" widget="statinfo" string="Consolidations"/>
                            </button>
                        </div>
                        <group>
                            <group string="Cycle">
                                <field name="name" readonly="1" invisible="name == 'New'"/>
                                <field name="year" readonly="state != 'draft'"/>
                                <field name="start_date" readonly="state != 'draft'"/>
                                <field name="submission_end_date" readonly="state not in ('draft', 'collecting')"/>
                            </group>
                            <group string="Deadlines &amp; Status">
                                <field name="approval_deadline" readonly="state in ('approved', 'locked')"/>
                                <field name="days_until_deadline"/>
                                <field name="entry_count"/>
                                <field name="approved_by_id"/>
                                <field name="approval_date"/>
                                <field name="responsible_team_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Training Needs">
                                <field name="entry_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="employee_id"/>
                                        <field name="work_unit_id"/>
                                        <field name="competency_id"/>
                                        <field name="delivery_mode"/>
                                        <field name="priority_score"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Methodology &amp; Notes">
                                <field name="methodology" placeholder="Describe the TNA methodology and responsible team..."/>
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_eds_tna_cycle_search" model="ir.ui.view">
            <field name="name">eds.tna.cycle.search</field>
            <field name="model">eds.tna.cycle</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="year"/>
                    <filter string="Open for Collection" name="open_collection" domain="[('state','=','collecting')]"/>
                    <filter string="Approved / Locked" name="approved_locked" domain="[('state','in',('approved','locked'))]"/>
                    <separator/>
                    <group name="group_by">
                        <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_eds_tna_cycle" model="ir.actions.act_window">
            <field name="name">TNA Cycles</field>
            <field name="res_model">eds.tna.cycle</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_tna_cycle_search"/>
        </record>

        <!-- ══════════════ TNA Entry ══════════════ -->

        <record id="view_eds_tna_entry_list" model="ir.ui.view">
            <field name="name">eds.tna.entry.list</field>
            <field name="model">eds.tna.entry</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="cycle_id"/>
                    <field name="employee_id"/>
                    <field name="work_unit_id"/>
                    <field name="course_id" optional="show"/>
                    <field name="proposed_program" optional="show"/>
                    <field name="target_audience" optional="show"/>
                    <field name="target_participant_count" optional="show"/>
                    <field name="competency_level" optional="show"/>
                    <field name="quarter" optional="show"/>
                    <field name="urgency" widget="badge"/>
                    <field name="competency_id" optional="show"/>
                    <field name="delivery_mode" widget="badge"/>
                    <field name="source"/>
                    <field name="priority_score"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_tna_entry_form" model="ir.ui.view">
            <field name="name">eds.tna.entry.form</field>
            <field name="model">eds.tna.entry</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_submit" string="Submit"
                                type="object" class="oe_highlight" invisible="state != 'draft'"
                                groups="employee_development_system.group_eds_employee,employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_validate" string="Validate"
                                type="object" class="oe_highlight" invisible="state not in ('submitted','validated')"
                                groups="employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_exclude" string="Exclude (Duplicate / Invalid)"
                                type="object" invisible="state not in ('submitted','validated')"
                                groups="employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_reopen_draft" string="Reopen as Draft"
                                type="object" invisible="state not in ('submitted','excluded')"
                                groups="employee_development_system.group_eds_line_manager,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_create_development_request" string="Create Development Request"
                                type="object" class="oe_highlight"
                                invisible="state not in ('approved','converted')"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,validated,approved,converted,excluded"/>
                    </header>
                    <sheet>
                        <div class="alert alert-warning mb-3" role="alert" invisible="state != 'excluded'">
                            <h5 class="alert-heading mb-1"><i class="fa fa-ban me-1"/> Excluded Training Need</h5>
                            <div><strong>Category: </strong><field name="exclusion_type" readonly="1" class="fw-bold"/></div>
                            <div><strong>Reason: </strong><field name="excluded_reason" readonly="1"/></div>
                        </div>
                        <group>
                            <group string="Course Selection &amp; Urgency">
                                <field name="is_custom_course" widget="boolean_toggle" readonly="state != 'draft'"/>
                                <field name="course_id" invisible="is_custom_course" readonly="state != 'draft'"
                                       domain="[('status', '=', 'active')]"
                                       options="{'no_create': True}" placeholder="Select from Course Catalog / Pool..."/>
                                <field name="custom_course_title" invisible="not is_custom_course" required="is_custom_course"
                                       placeholder="e.g. Advanced Branch AML Risk Controls" readonly="state != 'draft'"/>
                                <field name="custom_course_description" invisible="not is_custom_course"
                                       placeholder="Describe what the course is about and expected learning objectives..." readonly="state != 'draft'"/>
                                <field name="target_audience" readonly="state != 'draft'"/>
                                <field name="target_participant_count" readonly="state != 'draft'"/>
                                <field name="competency_level" readonly="state != 'draft'"/>
                                <field name="quarter" readonly="state != 'draft'"/>
                                <field name="urgency" readonly="state != 'draft'"/>
                                <field name="delivery_mode" readonly="state != 'draft'"/>
                                <field name="proposed_program" readonly="state != 'draft'" placeholder="Standardized program title (auto-populated)..."/>
                            </group>
                            <group string="Employee &amp; Organization">
                                <field name="name" readonly="1" invisible="name == 'New'"/>
                                <field name="cycle_id" readonly="state != 'draft'"/>
                                <field name="department_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                <field name="work_unit_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                <field name="job_position_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                <field name="employee_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                <field name="source" readonly="state != 'draft'"/>
                                <field name="competency_id" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <group>
                            <group string="Catalog Alignment &amp; Diagnostic Gaps">
                                <field name="course_match_status" widget="badge"/>
                                <field name="recommended_course_id" readonly="1"/>
                                <field name="competency_gap_level_diff" invisible="source != 'competency_gap'" readonly="state != 'draft'"/>
                                <field name="pms_kpi_reference" invisible="source != 'pms'" readonly="state != 'draft'"/>
                                <field name="pms_appraisal_score" invisible="source != 'pms'" readonly="state != 'draft'"/>
                                <button name="action_view_recommended_course" string="Open Mapped Catalog Course"
                                        type="object" class="btn-outline-primary" icon="fa-arrow-right"
                                        invisible="not recommended_course_id"/>
                            </group>
                            <group string="Business Justification &amp; Impact">
                                <field name="justification" placeholder="Explain the business need, competency gap, or regulatory requirement..." readonly="state != 'draft'"/>
                                <field name="exclusion_type" invisible="state != 'excluded' and not exclusion_type" readonly="state == 'excluded'"/>
                                <field name="excluded_reason" invisible="state != 'excluded' and not excluded_reason" readonly="state == 'excluded'"/>
                                <field name="converted_course_ref" invisible="state != 'converted'" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="L&amp;D Consolidation &amp; Priority Analysis" groups="employee_development_system.group_eds_officer">
                                <group>
                                    <group string="Consolidation Status &amp; Scheduling">
                                        <field name="priority_score" readonly="1"/>
                                        <field name="consolidation_id" readonly="1"/>
                                        <field name="is_duplicate" readonly="1"/>
                                        <field name="duplicate_of_id" readonly="1" invisible="not is_duplicate"/>
                                        <field name="exclusion_type" readonly="state == 'excluded'"/>
                                        <field name="hr_target_quarter" readonly="state in ('converted', 'excluded')"/>
                                        <field name="hr_target_delivery_date" readonly="state in ('converted', 'excluded')"/>
                                    </group>

                                    <group string="Priority Scoring Breakdown">
                                        <field name="score_strategic_alignment"/>
                                        <field name="score_tom_impact"/>
                                        <field name="score_gap_severity"/>
                                        <field name="score_risk_level"/>
                                        <field name="score_regulatory"/>
                                        <field name="score_future_capability"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Audit &amp; Validation Log">
                                <group>
                                    <group>
                                        <field name="submitted_by" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="validated_by" readonly="1"/>
                                        <field name="validation_date" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_eds_tna_entry_search" model="ir.ui.view">
            <field name="name">eds.tna.entry.search</field>
            <field name="model">eds.tna.entry</field>
            <field name="arch" type="xml">
                <search>
                    <field name="cycle_id"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="work_unit_id"/>
                    <field name="job_position_id"/>
                    <field name="competency_id"/>
                    <field name="delivery_mode"/>
                    <filter string="My Submissions" name="submitted_by_me" domain="['|', ('submitted_by','=',uid), ('employee_id.user_id', '=', uid)]"/>
                    <filter string="My Direct Reports" name="my_team" domain="['|', ('employee_id.parent_id.user_id', '=', uid), ('employee_id.coach_id.user_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Pending Validation" name="pending_validation" domain="[('state','=','submitted')]"/>
                    <filter string="Validated" name="validated" domain="[('state','=','validated')]"/>
                    <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                    <filter string="Excluded" name="excluded" domain="[('state','=','excluded')]"/>
                    <separator/>
                    <filter string="Competency Gaps" name="filter_competency" domain="[('source','=','competency_gap')]"/>
                    <filter string="Duplicates" name="filter_duplicates" domain="[('is_duplicate','=',True)]"/>
                    <filter string="Non-Training Items" name="filter_non_training" domain="[('exclusion_type','!=',False), ('exclusion_type','!=','duplicate')]"/>
                    <filter string="Screened &amp; Excluded" name="filter_flagged_excluded" domain="['|', '|', ('is_duplicate','=',True), ('exclusion_type','!=',False), ('state','=','excluded')]"/>
                    <group name="group_by">
                        <filter string="Department" name="group_department" context="{'group_by':'department_id'}"/>
                        <filter string="Work Unit" name="group_work_unit" context="{'group_by':'work_unit_id'}"/>
                        <filter string="Job Position" name="group_job" context="{'group_by':'job_position_id'}"/>
                        <filter string="Employee" name="group_employee" context="{'group_by':'employee_id'}"/>
                        <filter string="TNA Cycle" name="group_cycle" context="{'group_by':'cycle_id'}"/>
                        <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                        <filter string="Screening Category" name="group_exclusion" context="{'group_by':'exclusion_type'}"/>
                        <filter string="Delivery Mode" name="group_delivery" context="{'group_by':'delivery_mode'}"/>
                        <filter string="Source" name="group_source" context="{'group_by':'source'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action: All Training Needs (Unified bank-wide / team view governed by record rules) -->
        <record id="action_eds_tna_entry" model="ir.actions.act_window">
            <field name="name">All Training Needs</field>
            <field name="res_model">eds.tna.entry</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_tna_entry_search"/>
            <field name="context">{'search_default_group_department': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No training needs found.
                </p>
                <p>
                    Training needs are captured directly from individual staff submissions, work unit leaders submitting for their teams, or auto-pulled from closed Competency Assessment Cycles.
                </p>
            </field>
        </record>

        <!-- Action: My Training Needs (Employee Self-Service) -->
        <record id="action_eds_tna_entry_own" model="ir.actions.act_window">
            <field name="name">My Training Needs</field>
            <field name="res_model">eds.tna.entry</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_tna_entry_search"/>
            <field name="domain">['|', ('submitted_by', '=', uid), ('employee_id.user_id', '=', uid)]</field>
            <field name="context">{'default_submitted_by': uid}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Submit your training and development needs.
                </p>
            </field>
        </record>

    </data>
</odoo>
