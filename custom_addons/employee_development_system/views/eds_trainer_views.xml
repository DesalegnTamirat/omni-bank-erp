<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══════════════ Trainer Register ══════════════ -->

        <record id="view_eds_trainer_list" model="ir.ui.view">
            <field name="name">eds.trainer.list</field>
            <field name="model">eds.trainer</field>
            <field name="arch" type="xml">
                <list string="Trainer Register">
                    <field name="name"/>
                    <field name="trainer_type" widget="badge"/>
                    <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="external_provider_id"/>
                    <field name="tot_certified"/>
                    <field name="avg_rating" widget="progressbar"/>
                    <field name="next_review_date"/>
                    <field name="review_overdue" decoration-danger="review_overdue"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_eds_trainer_search" model="ir.ui.view">
            <field name="name">eds.trainer.search</field>
            <field name="model">eds.trainer</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="competency_ids"/>
                    <field name="employee_id" context="{'eds_employee_select': True}"/>
                    <field name="external_provider_id"/>
                    <filter string="ToT Certified" name="tot" domain="[('tot_certified','=',True)]"/>
                    <filter string="Review Overdue" name="overdue" domain="[('review_overdue','=',True)]"/>
                    <filter string="Active" name="active" domain="[('state','=','active')]"/>
                    <separator/>
                    <group name="group_by">
                        <filter string="Trainer Type" name="g_type" context="{'group_by':'trainer_type'}"/>
                        <filter string="Status" name="g_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_eds_trainer_form" model="ir.ui.view">
            <field name="name">eds.trainer.form</field>
            <field name="model">eds.trainer</field>
            <field name="arch" type="xml">
                <form string="Trainer Profile">
                    <header>
                        <button name="action_activate" string="Activate" type="object"
                                class="oe_highlight" invisible="state != 'inactive'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_deactivate" string="Deactivate" type="object"
                                invisible="state != 'active'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_mark_reviewed" string="Mark Reviewed" type="object"
                                invisible="state != 'active'"
                                groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <button name="action_print_profile" string="Print Trainer Profile" type="object" icon="fa-print"
                                groups="employee_development_system.group_eds_trainer,employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Trainer name"
                                       readonly="trainer_type == 'internal' and employee_id" force_save="1"/></h1>
                        </div>
                        <group>
                            <group string="Profile &amp; Contact">
                                <field name="trainer_type" widget="badge" readonly="1" force_save="1"/>
                                <field name="employee_id" invisible="trainer_type != 'internal'"
                                       required="trainer_type == 'internal'" options="{'no_create': True, 'no_open': True}" context="{'eds_employee_select': True}"/>
                                <field name="external_provider_id" string="Training Organization"
                                       invisible="trainer_type != 'external'" options="{'no_create': True}"/>
                                <field name="employee_job_position" invisible="trainer_type != 'internal'" readonly="1"/>
                                <field name="employee_phone" invisible="trainer_type != 'internal'" readonly="1"/>
                                <field name="employee_email" invisible="trainer_type != 'internal'" readonly="1"/>
                                <field name="job_title" string="Specialization" invisible="trainer_type != 'external'"/>
                                <field name="phone" invisible="trainer_type != 'external'"/>
                                <field name="email" invisible="trainer_type != 'external'"/>
                                <field name="address" invisible="trainer_type != 'external'"/>
                            </group>
                            <group string="Experience &amp; Review">
                                <field name="tot_certified" invisible="trainer_type != 'internal'"/>
                                <field name="trainer_experience_years"/>
                                <field name="banking_experience_years" invisible="trainer_type != 'external'"/>
                                <field name="institutions_worked_with" invisible="trainer_type != 'external'"/>
                                <field name="competency_ids" widget="many2many_tags"/>
                                <field name="avg_rating" readonly="1"/>
                                <field name="rating_count" readonly="1"/>
                                <field name="review_cycle_months"/>
                                <field name="last_review_date" readonly="1"/>
                                <field name="next_review_date" readonly="1"/>
                                <field name="review_overdue" readonly="1"/>
                            </group>
                        </group>
                        <notebook class="o_eds_notebook">
                            <page string="Qualifications" name="qualifications">
                                <group string="ToT Certifications">
                                    <field name="tot_certificate_ids" nolabel="1">
                                        <list>
                                            <field name="name"/>
                                            <field name="issued_by"/>
                                            <field name="issued_date"/>
                                            <field name="expiry_date"/>
                                            <field name="status" widget="badge"/>
                                            <field name="filename" string="File"/>
                                            <button name="action_preview_document" string="Preview" type="object"
                                                    icon="fa-eye" invisible="not filename"/>
                                            <button name="action_download_document" string="Download" type="object"
                                                    icon="fa-download" invisible="not filename"/>
                                        </list>
                                        <form string="ToT Certification">
                                            <header>
                                                <button name="action_preview_document" string="Preview" type="object"
                                                        invisible="not filename"/>
                                                <button name="action_download_document" string="Download" type="object"
                                                        invisible="not filename"/>
                                            </header>
                                            <sheet>
                                                <group>
                                                    <field name="name"/>
                                                    <field name="issued_by"/>
                                                    <field name="issued_date"/>
                                                    <field name="expiry_date"/>
                                                    <field name="status" readonly="1"/>
                                                    <field name="document" widget="binary" filename="filename"
                                                           options="{'accepted_file_extensions': '.pdf,image/*'}"/>
                                                    <field name="filename" invisible="1"/>
                                                </group>
                                            </sheet>
                                        </form>
                                    </field>
                                </group>
                                <group string="Education &amp; Other Certifications">
                                    <field name="education_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="degree_title"/>
                                            <field name="field_of_study"/>
                                            <field name="institution_name"/>
                                            <field name="year_obtained"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Certified Expertise">
                                    <field name="expertise_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="subject_domain"/>
                                            <field name="course_topics"/>
                                            <field name="target_level"/>
                                            <field name="years_experience"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page string="Schedule &amp; Reviews" name="schedule_reviews">
                                <group string="Availability">
                                    <field name="availability_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="date_start"/>
                                            <field name="date_end"/>
                                            <field name="state"/>
                                            <field name="note"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Performance Reviews">
                                    <field name="quarterly_review_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="period"/>
                                            <field name="review_date"/>
                                            <field name="reviewer_id"/>
                                            <field name="rating"/>
                                            <field name="strengths"/>
                                            <field name="improvements"/>
                                            <field name="action_plan"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page string="Participant Feedback" name="feedback"
                                  groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin">
                                <div class="alert alert-info" role="status">
                                    Record trainer feedback given outside the confidential Level 1 reaction survey.
                                </div>
                                <field name="feedback_ids">
                                    <list editable="bottom">
                                        <field name="eligible_session_ids" invisible="1"/>
                                        <field name="eligible_participant_ids" invisible="1"/>
                                        <field name="session_id" domain="[('id', 'in', eligible_session_ids)]"
                                               options="{'no_create': True}"/>
                                        <field name="participant_id" domain="[('id', 'in', eligible_participant_ids)]"
                                               options="{'no_create': True, 'no_open': True}" context="{'eds_employee_select': True}"/>
                                        <field name="date"/>
                                        <field name="source_kind" readonly="1"/>
                                        <field name="rating" readonly="source_kind == 'level1'"/>
                                        <field name="score_pct" readonly="1"/>
                                        <field name="comment"/>
                                    </list>
                                </field>
                                <group string="Daily Session Feedback (from Delivery)">
                                    <field name="daily_feedback_ids" nolabel="1" readonly="1">
                                        <list create="false" edit="false" delete="false">
                                            <field name="session_id"/>
                                            <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                                            <field name="feedback_date"/>
                                            <field name="rating"/>
                                            <field name="comment"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page string="Delivery History" name="delivery_hist">
                                <group string="EDS Sessions Assigned">
                                    <field name="session_ids" nolabel="1" readonly="1">
                                        <list create="false" edit="false" delete="false">
                                            <field name="name"/>
                                            <field name="course_id"/>
                                            <field name="date_start"/>
                                            <field name="status" widget="badge"/>
                                            <field name="enrolled_count"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Previous Training Outside EDS">
                                    <field name="delivery_history_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="program_title"/>
                                            <field name="client_organization"/>
                                            <field name="delivery_year"/>
                                            <field name="participant_count"/>
                                            <field name="participant_rating"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page string="Commercials" name="commercials" invisible="trainer_type != 'external'">
                                <group string="External Consultant Commercials">
                                    <group>
                                        <field name="daily_fee"/>
                                        <field name="hourly_fee"/>
                                        <field name="currency_id" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="tax_status"/>
                                        <field name="fee_validity_period"/>
                                    </group>
                                </group>
                                <group string="Declaration &amp; Approvals">
                                    <group>
                                        <field name="declaration_agreed"/>
                                    </group>
                                    <group>
                                        <field name="reviewed_by_officer"/>
                                        <field name="approved_by_tl"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_trainer" model="ir.actions.act_window">
            <field name="name">Trainer Register</field>
            <field name="res_model">eds.trainer</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_trainer_search"/>
        </record>
        <record id="action_eds_internal_trainer" model="ir.actions.act_window">
            <field name="name">Internal ToT Trainers</field>
            <field name="res_model">eds.trainer</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_trainer_search"/>
            <field name="domain">[('trainer_type','=','internal')]</field>
            <field name="context">{'default_trainer_type': 'internal'}</field>
        </record>
        <record id="action_eds_external_trainer" model="ir.actions.act_window">
            <field name="name">External Trainers</field>
            <field name="res_model">eds.trainer</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="employee_development_system.view_eds_trainer_search"/>
            <field name="domain">[('trainer_type','=','external')]</field>
            <field name="context">{'default_trainer_type': 'external'}</field>
        </record>

        <!-- ══════════════ External Provider Registry ══════════════ -->

        <record id="view_eds_external_provider_list" model="ir.ui.view">
            <field name="name">eds.external.provider.list</field>
            <field name="model">eds.external.provider</field>
            <field name="arch" type="xml">
                <list string="External Providers">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="provider_type" optional="show"/>
                    <field name="rate_per_session" optional="show"/>
                    <field name="currency_id" optional="show"/>
                    <field name="category" widget="badge"/>
                    <field name="country_id" optional="show"/>
                    <field name="city" optional="show"/>
                    <field name="accreditation"/>
                    <field name="pre_qualified" widget="boolean_toggle"/>
                    <field name="rating" widget="progressbar"/>
                    <field name="rating_count"/>
                </list>
            </field>
        </record>

        <record id="view_eds_external_provider_form" model="ir.ui.view">
            <field name="name">eds.external.provider.form</field>
            <field name="model">eds.external.provider</field>
            <field name="arch" type="xml">
                <form string="External Training Provider">
                    <sheet>
                        <group>
                            <group string="Provider">
                                <field name="code" readonly="1"/>
                                <field name="name" placeholder="Provider name"/>
                                <field name="category"/>
                                <field name="provider_type"/>
                                <field name="certificate_logo" widget="image" class="oe_avatar"/>
                            </group>
                            <group string="Location &amp; Pricing">
                                <field name="country_id" invisible="category != 'international'" placeholder="Select country"/>
                                <field name="city" placeholder="City name"/>
                                <field name="currency_id" readonly="category != 'international'" context="{'active_test': False}" options="{'no_create': True}"/>
                                <field name="rate_per_session" placeholder="0.00"/>
                                <field name="tax_id" placeholder="TIN or license number"/>
                            </group>
                        </group>
                        <group>
                            <group string="Contact &amp; Experience">
                                <field name="contact_name" placeholder="Contact person"/>
                                <field name="phone" placeholder="Phone number"/>
                                <field name="email" placeholder="Email address"/>
                                <field name="website" string="Website / Google Maps Link" widget="url"
                                       placeholder="https://www.google.com/maps/..."/>
                                <field name="years_of_experience"/>
                                <field name="active"/>
                            </group>
                            <group string="Qualification &amp; Rating">
                                <field name="accreditation" placeholder="Accreditation or license"/>
                                <field name="pre_qualified"/>
                                <field name="rating"/>
                                <field name="rating_count"/>
                            </group>
                        </group>
                        <group>
                            <group string="Specialization Domains">
                                <field name="specialization_areas" placeholder="Training subjects and areas"/>
                            </group>
                        </group>
                        <group string="Service Offerings &amp; Profile Summary">
                            <field name="service_offerings" placeholder="Services this provider offers"/>
                            <field name="notes" placeholder="Additional profile notes"/>
                        </group>
                        <notebook class="o_eds_notebook">
                            <page string="Profile Documents &amp; Certifications" name="documents">
                                <field name="attachment_ids" widget="many2many_binary" options="{'accepted_file_extensions': '.pdf,image/*'}"/>
                            </page>
                            <page string="Performance History" name="performance">
                                <field name="performance_history_ids">
                                    <list editable="bottom">
                                        <field name="evaluation_date"/>
                                        <field name="course_id"/>
                                        <field name="venue_name"/>
                                        <field name="service_quality"/>
                                        <field name="rating"/>
                                        <field name="issues_raised"/>
                                        <field name="corrective_actions"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Contracts" name="contracts">
                                <field name="contract_ids" readonly="1"/>
                            </page>
                            <page string="External Trainers" name="trainers">
                                <field name="trainer_ids" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eds_external_provider" model="ir.actions.act_window">
            <field name="name">External Providers</field>
            <field name="res_model">eds.external.provider</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
