<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Budget Management Views -->
    <record id="view_eds_budget_tree" model="ir.ui.view">
        <field name="name">eds.budget.tree</field>
        <field name="model">eds.budget</field>
        <field name="arch" type="xml">
            <list string="Annual L&amp;D Budgets">
                <field name="name"/>
                <field name="fiscal_year"/>
                <field name="category"/>
                <field name="total_estimated" sum="Total Estimated"/>
                <field name="allocated" sum="Total Approved"/>
                <field name="budget_variance" sum="Variance"/>
                <field name="committed"/>
                <field name="spent"/>
                <field name="remaining"/>
                <field name="utilization_pct" widget="progressbar"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-muted="state == 'locked'"/>
            </list>
        </field>
    </record>

    <record id="view_eds_budget_form" model="ir.ui.view">
        <field name="name">eds.budget.form</field>
        <field name="model">eds.budget</field>
        <field name="arch" type="xml">
            <form string="L&amp;D Budget Management">
                <header>
                    <button name="action_approve" string="Approve Budget" type="object" class="oe_highlight" invisible="state != 'draft'"
                            groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_lock" string="Lock Budget" type="object" invisible="state != 'approved'"
                            groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,locked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" invisible="name == 'New'"/></h1>
                    </div>
                    <group>
                        <group string="Budget Classification">
                            <field name="fiscal_year"/>
                            <field name="category"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Budget Allocation &amp; Variance">
                            <field name="allocated" string="Approved Budget (ETB)"/>
                            <field name="total_estimated" string="Estimated Total (Q1–Q4)"/>
                            <field name="budget_variance" string="Variance (Approved − Estimated)"/>
                            <field name="committed"/>
                            <field name="spent"/>
                            <field name="remaining"/>
                            <field name="utilization_pct" widget="progressbar"/>
                        </group>
                    </group>
                    <group string="Quarterly Allocation Plan (July – June)">
                        <group>
                            <field name="q1_allocated"/>
                            <field name="q2_allocated"/>
                        </group>
                        <group>
                            <field name="q3_allocated"/>
                            <field name="q4_allocated"/>
                            <field name="unallocated"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Program Budget Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="course_id"/>
                                    <field name="session_id"/>
                                    <field name="quarter"/>
                                    <field name="cost_type"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_budget" model="ir.actions.act_window">
        <field name="name">Annual L&amp;D Budgets</field>
        <field name="res_model">eds.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Strategic Learning Partner Views -->
    <record id="view_eds_learning_partner_tree" model="ir.ui.view">
        <field name="name">eds.learning.partner.tree</field>
        <field name="model">eds.learning.partner</field>
        <field name="arch" type="xml">
            <list string="Strategic Learning Partnerships">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="proposal_type"/>
                <field name="screening_score"/>
                <field name="is_eligible" widget="boolean_toggle"/>
                <field name="effective_date"/>
                <field name="renewal_alert_date"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'screened'"/>
            </list>
        </field>
    </record>

    <record id="view_eds_learning_partner_form" model="ir.ui.view">
        <field name="name">eds.learning.partner.form</field>
        <field name="model">eds.learning.partner</field>
        <field name="arch" type="xml">
            <form string="Strategic Learning Partnership &amp; MoU">
                <header>
                    <button name="action_screen" string="Screen (70% Gate)" type="object" class="oe_highlight" invisible="state != 'received'"
                            groups="employee_development_system.group_eds_officer,employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_ppdd_endorse" string="PPDD Endorse" type="object" class="oe_highlight" invisible="state != 'screened'"
                            groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_cpco_review" string="CPCO Review" type="object" class="oe_highlight" invisible="state != 'ppdd_endorsement'"
                            groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_ceo_approve" string="CEO Approve" type="object" class="oe_highlight" invisible="state != 'cpco_review'"
                            groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <button name="action_sign_mou" string="Activate MoU" type="object" class="oe_highlight" invisible="state != 'ceo_approval'"
                            groups="employee_development_system.group_eds_manager,employee_development_system.group_eds_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="received,screened,ppdd_endorsement,cpco_review,ceo_approval,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" invisible="name == 'New'"/></h1>
                    </div>
                    <group>
                        <group string="Partner Details">
                            <field name="partner_id"/>
                            <field name="proposal_type"/>
                            <field name="screening_score"/>
                            <field name="is_eligible"/>
                        </group>
                        <group string="MoU Agreement">
                            <field name="effective_date"/>
                            <field name="duration_years"/>
                            <field name="renewal_alert_date"/>
                            <field name="performance_rating"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Signed MoU Document">
                            <group>
                                <field name="mou_document" filename="mou_filename"/>
                                <field name="mou_filename" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eds_learning_partner" model="ir.actions.act_window">
        <field name="name">Strategic Learning Partnerships</field>
        <field name="res_model">eds.learning.partner</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
