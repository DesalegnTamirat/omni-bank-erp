<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_eds_attendance_import_form" model="ir.ui.view">
            <field name="name">eds.attendance.import.form</field>
            <field name="model">eds.attendance.import</field>
            <field name="arch" type="xml">
                <form string="Import Attendance Sheet">
                    <sheet>
                        <div class="alert alert-info" role="alert">
                            <span class="fa fa-info-circle me-1" title="Information" aria-hidden="true"/> <b>Branch / Classroom Attendance Bulk Ingestion:</b><br/>
                            Upload sign-in sheet in CSV format. Columns supported: <code>session_ref, employee_badge, attendance_date, attended, notes</code>.
                        </div>
                        <group>
                            <group>
                                <field name="csv_file" filename="filename"/>
                                <field name="filename" invisible="1"/>
                            </group>
                            <group>
                                <field name="session_id" placeholder="Optional fallback session"/>
                            </group>
                        </group>
                        <group string="Import Results" invisible="not result_log">
                            <field name="result_log" readonly="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_import_attendance" string="Upload &amp; Process Attendance" type="object" class="oe_highlight"/>
                        <button name="action_download_template" string="Download CSV Template" type="object" class="btn-secondary"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_eds_attendance_import" model="ir.actions.act_window">
            <field name="name">Import Attendance Sheet</field>
            <field name="res_model">eds.attendance.import</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
