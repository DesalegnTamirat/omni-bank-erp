<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_eds_assessment_import_form" model="ir.ui.view">
            <field name="name">eds.assessment.import.form</field>
            <field name="model">eds.assessment.import</field>
            <field name="arch" type="xml">
                <form string="Import or Export Pre/Post Assessment">
                    <sheet>
                        <div class="alert alert-info" role="alert">
                            <span class="fa fa-info-circle me-1" title="Information" aria-hidden="true"/>
                            Choose a session and Pre or Post, then download its CSV. The file contains one row per enrolled participant and question. Fill every <code>answer</code>; enter <code>awarded_points</code> for graded questions (including 0), or leave points blank to grade later. Uploading the same completed file updates the same assessments and answers.
                        </div>
                        <group>
                            <group>
                                <field name="session_id" options="{'no_create': True}"/>
                                <field name="assessment_type"/>
                                <field name="csv_file" filename="filename"/>
                                <field name="filename" invisible="1"/>
                            </group>
                            <group>
                                <field name="overwrite_employee_answers"/>
                                <field name="replace_legacy_score"/>
                                <field name="template_file" invisible="1"/>
                                <field name="template_filename" invisible="1"/>
                            </group>
                        </group>
                        <group string="Import Results" invisible="not result_log">
                            <field name="result_log" readonly="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_import_assessments" string="Import Answers &amp; Grades" type="object" class="oe_highlight" invisible="not csv_file"/>
                        <button name="action_download_template" string="Download Session CSV" type="object" class="btn-secondary"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_eds_assessment_import" model="ir.actions.act_window">
            <field name="name">Assessment CSV Import / Export</field>
            <field name="res_model">eds.assessment.import</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
