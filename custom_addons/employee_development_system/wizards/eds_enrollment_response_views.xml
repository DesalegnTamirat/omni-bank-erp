<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eds_enrollment_response_wizard" model="ir.ui.view">
        <field name="name">eds.enrollment.response.wizard.form</field>
        <field name="model">eds.enrollment.response.wizard</field>
        <field name="arch" type="xml">
            <form string="Respond to Training Invitation">
                <group>
                    <field name="enrollment_id"/>
                    <field name="response"/>
                    <field name="replacement_employee_id" invisible="response != 'replace'"
                           required="response == 'replace'" options="{'no_create': True}"/>
                    <field name="reason" invisible="response == 'accept'"
                           required="response in ('decline', 'replace')"/>
                </group>
                <footer>
                    <button name="action_submit" string="Submit Response" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
