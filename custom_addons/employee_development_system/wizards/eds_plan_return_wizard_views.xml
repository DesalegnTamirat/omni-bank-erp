<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_eds_plan_return_wizard_form" model="ir.ui.view">
            <field name="name">eds.plan.return.wizard.form</field>
            <field name="model">eds.plan.return.wizard</field>
            <field name="arch" type="xml">
                <form string="Return Annual L&amp;D Plan">
                    <sheet>
                        <group>
                            <field name="plan_id" invisible="1"/>
                            <field name="reason" required="1" placeholder="Write the justification or required corrections here..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm_return" string="Confirm Return" type="object" class="btn-warning"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
