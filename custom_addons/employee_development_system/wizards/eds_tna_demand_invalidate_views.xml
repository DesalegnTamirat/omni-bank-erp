<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eds_tna_demand_invalidate_wizard_form" model="ir.ui.view">
        <field name="name">eds.tna.demand.invalidate.wizard.form</field>
        <field name="model">eds.tna.demand.invalidate.wizard</field>
        <field name="arch" type="xml">
            <form string="Invalidate Course Candidates">
                <div class="alert alert-warning mb-3" role="alert">
                    These employees remain in the TNA evidence, but will no longer count for this course or appear as suggested session participants.
                </div>
                <group>
                    <field name="demand_ids" invisible="1"/>
                    <field name="employee_count" readonly="1"/>
                    <field name="reason" required="1" placeholder="Explain why these employees should not be considered for this course..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Invalidate Selected Employees" type="object" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
