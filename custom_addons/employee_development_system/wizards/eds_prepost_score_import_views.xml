<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_eds_prepost_score_import_form" model="ir.ui.view">
            <field name="name">eds.prepost.score.import.form</field>
            <field name="model">eds.prepost.score.import</field>
            <field name="arch" type="xml">
                <form string="Import Pre/Post Assessment Scores">
                    <sheet>
                        <div class="alert alert-info" role="alert">
                            <span class="fa fa-info-circle me-1" title="Information" aria-hidden="true"/> <b>Pre/Post Assessment Scores Bulk Ingestion:</b><br/>
                            Upload the exported session score roster (.xlsx or .csv) containing participant test marks. The wizard will update Pre-Test and Post-Test scores and compute learning gain automatically.
                        </div>
                        <group>
                            <group>
                                <field name="file" filename="filename"/>
                                <field name="filename" invisible="1"/>
                            </group>
                            <group>
                                <field name="session_id" readonly="1"/>
                            </group>
                        </group>
                        <group string="Import Results" invisible="not result_log">
                            <field name="result_log" readonly="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_import_scores" string="Upload &amp; Process Scores" type="object" class="oe_highlight"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_eds_prepost_score_import" model="ir.actions.act_window">
            <field name="name">Import Pre/Post Assessment Scores</field>
            <field name="res_model">eds.prepost.score.import</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
