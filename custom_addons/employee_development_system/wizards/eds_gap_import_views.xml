<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Competency Gaps Ingestion Wizard (100% zero-upload) -->
        <record id="view_eds_competency_gap_import_form" model="ir.ui.view">
            <field name="name">eds.competency.gap.import.form</field>
            <field name="model">eds.competency.gap.import</field>
            <field name="arch" type="xml">
                <form string="Pull Competency Gaps from Closed Assessment Cycle">
                    <div class="alert alert-info" role="alert">
                        <span class="fa fa-info-circle me-1" title="Information" aria-hidden="true"/>
                        <strong>Direct Competency Gap Ingestion:</strong> Select a finalized (closed) Competency Assessment Cycle. The system will automatically identify all employees with competency gaps and generate corresponding TNA entries with no file upload required.
                    </div>
                    <group>
                        <group>
                            <field name="cycle_id" readonly="1" options="{'no_open': True}"/>
                            <field name="competency_cycle_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="min_gap"/>
                        </group>
                        <group>
                            <field name="operating_unit_id" options="{'no_create': True}"/>
                            <field name="department_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div invisible="not result_log">
                        <group string="Ingestion Results">
                            <field name="result_log" nolabel="1" readonly="1" widget="text"/>
                        </group>
                    </div>
                    <footer>
                        <button name="action_pull_competency_gaps" string="Pull Competency Gaps"
                                type="object" class="btn-primary" invisible="result_log"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_eds_competency_gap_import" model="ir.actions.act_window">
            <field name="name">Pull Closed Competency Gaps</field>
            <field name="res_model">eds.competency.gap.import</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
