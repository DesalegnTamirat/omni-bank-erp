<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eds_unscheduled_reject_wizard_form" model="ir.ui.view">
        <field name="name">eds.unscheduled.reject.wizard.form</field>
        <field name="model">eds.unscheduled.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Unscheduled Training Request">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        Please state the reason for rejecting this unscheduled training request. The requester will be notified with your comments.
                    </div>
                    <group>
                        <field name="request_id" invisible="1"/>
                        <field name="rejected_reason" placeholder="Enter reason for rejection..." required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reject" string="Reject Request" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
