<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eds_prerequisite_warning_wizard" model="ir.ui.view">
        <field name="name">eds.prerequisite.warning.wizard.form</field>
        <field name="model">eds.prerequisite.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Prerequisite Warning">
                <div class="alert alert-warning" role="alert">
                    These employees have no recorded completion of the prerequisite courses below.
                    You may still send their invitations, or close this window to review the roster.
                </div>
                <field name="enrollment_ids" invisible="1"/>
                <field name="warning_text" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_send_anyway" string="Send Invitations Anyway"
                            type="object" class="btn-primary"/>
                    <button string="Review Roster" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
