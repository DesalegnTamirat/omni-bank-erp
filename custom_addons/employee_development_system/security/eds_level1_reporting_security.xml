    </record>
    <record id="rule_eds_rating_question_session_company" model="ir.rule">
        <field name="name">Rating question sources: allowed companies</field>
        <field name="model_id" ref="model_eds_rating_overview_question_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
