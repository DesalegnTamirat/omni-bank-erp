        <!-- TNA Entry: employee sees own submissions -->
        <record id="rule_eds_tna_entry_employee_own" model="ir.rule">
            <field name="name">Employee Own TNA Entries</field>
            <field name="model_id" ref="employee_development_system.model_eds_tna_entry"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('submitted_by', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

