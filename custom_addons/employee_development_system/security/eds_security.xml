        <record id="rule_eds_session_executive" model="ir.rule">
            <field name="name">Executive Company Sessions</field>
            <field name="model_id" ref="employee_development_system.model_eds_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_executive'))]"/>
        </record>
        <record id="rule_eds_batch_staff" model="ir.rule">
            <field name="name">Batches L&amp;D Only</field>
            <field name="model_id" ref="employee_development_system.model_eds_batch"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
        </record>
        <record id="rule_eds_venue_staff" model="ir.rule">
            <field name="name">Venues L&amp;D Only</field>
            <field name="model_id" ref="employee_development_system.model_eds_venue"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
        </record>
        <record id="rule_eds_venue_booking_staff" model="ir.rule">
            <field name="name">Venue Bookings L&amp;D Only</field>
            <field name="model_id" ref="employee_development_system.model_eds_venue_booking"/>
            <field name="domain_force">[('venue_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
        </record>
        <record id="rule_eds_unscheduled_request_staff" model="ir.rule">
            <field name="name">Unscheduled Requests L&amp;D Only</field>
            <field name="model_id" ref="employee_development_system.model_eds_unscheduled_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
        </record>

        <!-- multi-company rules (module convention) -->
        <record id="rule_eds_annual_plan_multi_company" model="ir.rule">
            <field name="name">Annual Plan Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_annual_plan"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_eds_annual_plan_line_multi_company" model="ir.rule">
            <field name="name">Annual Plan Line Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_annual_plan_line"/>
            <field name="domain_force">['|', ('plan_id.company_id', '=', False), ('plan_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_eds_session_multi_company" model="ir.rule">
            <field name="name">Session Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_session"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_eds_cost_multi_company" model="ir.rule">
            <field name="name">Session Costs Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_cost"/>
            <field name="domain_force">[('session_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_eds_batch_multi_company" model="ir.rule">
            <field name="name">Batch Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_batch"/>
