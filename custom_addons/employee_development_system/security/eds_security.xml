<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_eds" model="ir.module.category">
            <field name="name">Employee Development System</field>
            <field name="description">Employee Development System Access Control</field>
            <field name="sequence">27</field>
        </record>

        <!-- Privilege (Odoo 19) -->
        <record id="res_groups_privilege_eds" model="res.groups.privilege">
            <field name="name">Employee Development System</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="employee_development_system.module_category_eds"/>
        </record>

        <!-- Group: Employee -->
        <record id="group_eds_employee" model="res.groups">
            <field name="name">User / Employee</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="comment">Can submit self training needs and view own learning history.</field>
        </record>

        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_eds_employee'))]"/>
        </record>

        <!-- Group: Line Manager -->
        <record id="group_eds_line_manager" model="res.groups">
            <field name="name">Line Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="implied_ids" eval="[(4, ref('employee_development_system.group_eds_employee'))]"/>
            <field name="comment">Can nominate team members and approve their training needs .</field>
        </record>

        <!-- Group: Trainer -->
        <record id="group_eds_trainer" model="res.groups">
            <field name="name">Trainer / Facilitator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="comment">Session delivery, attendance and assessment scoring (segregated from nomination/approval).</field>
        </record>

        <!-- Group: L&D Officer -->
        <record id="group_eds_officer" model="res.groups">
            <field name="name">L&amp;D Officer</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="implied_ids" eval="[(4, ref('employee_development_system.group_eds_line_manager'))]"/>
            <field name="comment">TNA capture, scheduling, venues, budget lines and RFP processing.</field>
        </record>

        <!-- Group: L&D Manager -->
        <record id="group_eds_manager" model="res.groups">
            <field name="name">L&amp;D Manager / Team Leader</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="implied_ids" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
            <field name="comment">Curriculum approval, evaluations, reports and dashboard.</field>
        </record>

        <!-- Group: EDS Administrator -->
        <record id="group_eds_admin" model="res.groups">
            <field name="name">EDS Administrator</field>
            <field name="sequence">60</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="implied_ids" eval="[(4, ref('employee_development_system.group_eds_manager'))]"/>
            <field name="comment">Full access to EDS configuration, framework approval authority and integration jobs.</field>
        </record>

        <!-- Group: Executive (read-only dashboards/reports) -->
        <record id="group_eds_executive" model="res.groups">
            <field name="name">Executive (Read-Only)</field>
            <field name="sequence">70</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="comment">Read-only executive dashboards and learning analytics (CPCO / SMC).</field>
        </record>

    </data>

    <!-- Record Rules -->
