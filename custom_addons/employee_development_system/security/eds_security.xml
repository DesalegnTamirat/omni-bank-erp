<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_eds" model="ir.module.category">
            <field name="name">Employee Development System</field>
            <field name="description">Employee Development System Access Control</field>
            <field name="sequence">27</field>
        </record>

        <!-- Privilege (Odoo 19) -->
        <record id="res_groups_privilege_eds" model="res.groups.privilege">
            <field name="name">Employee Development System</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="employee_development_system.module_category_eds"/>
        </record>

        <!-- Group: Employee -->
        <record id="group_eds_employee" model="res.groups">
            <field name="name">User / Employee</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="comment">Can submit self training needs and view own learning history.</field>
        </record>

        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_eds_employee'))]"/>
        </record>

        <!-- Group: Line Manager -->
        <record id="group_eds_line_manager" model="res.groups">
            <field name="name">Line Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="implied_ids" eval="[(4, ref('employee_development_system.group_eds_employee'))]"/>
            <field name="comment">Can nominate team members and approve their training needs .</field>
        </record>

        <!-- Group: Trainer -->
        <record id="group_eds_trainer" model="res.groups">
            <field name="name">Trainer / Facilitator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="implied_ids" eval="[(4, ref('employee_development_system.group_eds_employee'))]"/>
            <field name="comment">Employee-level access to assigned training sessions only. Attendance and assessment recording belongs to L&amp;D staff.</field>
        </record>

        <!-- Group: L&D Officer -->
        <record id="group_eds_officer" model="res.groups">
            <field name="name">L&amp;D Officer</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="implied_ids" eval="[(4, ref('employee_development_system.group_eds_line_manager'))]"/>
            <field name="comment">TNA capture, scheduling, venues, budget lines and RFP processing.</field>
        </record>

        <!-- Group: L&D Manager -->
        <record id="group_eds_manager" model="res.groups">
            <field name="name">L&amp;D Manager</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="implied_ids" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
            <field name="comment">Curriculum approval, evaluations, reports and dashboard.</field>
        </record>

        <!-- Group: EDS Administrator -->
        <record id="group_eds_admin" model="res.groups">
            <field name="name">EDS Administrator</field>
            <field name="sequence">60</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="implied_ids" eval="[(4, ref('employee_development_system.group_eds_manager'))]"/>
            <field name="comment">Full access to EDS configuration, framework approval authority and integration jobs.</field>
        </record>

        <!-- EDS-wide roles are shared by every workflow addressed to these offices. -->
        <record id="group_eds_team_leader" model="res.groups">
            <field name="name">Team Leader</field>
            <field name="sequence">51</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="implied_ids" eval="[(4, ref('employee_development_system.group_eds_manager'))]"/>
            <field name="comment">Checks and acts on EDS work routed to the Team Leader.</field>
        </record>
        <record id="group_eds_director" model="res.groups">
            <field name="name">Director PPDD</field>
            <field name="sequence">52</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="implied_ids" eval="[(4, ref('employee_development_system.group_eds_manager'))]"/>
            <field name="comment">Reviews and acts on EDS work routed to the Director PPDD.</field>
        </record>
        <record id="group_eds_chief" model="res.groups">
            <field name="name">Chief</field>
            <field name="sequence">61</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="implied_ids" eval="[(6, 0, [ref('employee_development_system.group_eds_manager')])]"/>
            <field name="comment">Approves and acts on EDS work routed to the Chief.</field>
        </record>

        <!-- Group: Executive (read-only dashboards/reports) -->
        <record id="group_eds_executive" model="res.groups">
            <field name="name">Executive (Read-Only)</field>
            <field name="sequence">70</field>
            <field name="privilege_id" ref="employee_development_system.res_groups_privilege_eds"/>
            <field name="comment">Read-only executive dashboards and learning analytics (CPCO / SMC).</field>
        </record>

        <record id="rule_eds_manager_work_unit_employee_read" model="ir.rule">
            <field name="name">EDS Work Unit Leader Employee Directory</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">user.env['eds.hr.compat'].get_managed_employee_read_domain()</field>
            <field name="groups" eval="[(6, 0, [ref('group_eds_employee')])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_eds_level1_employee_own" model="ir.rule">
            <field name="name">EDS feedback: employee own</field>
            <field name="model_id" ref="model_eds_evaluation_level1"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_eds_employee'))]"/>
        </record>
        <record id="rule_eds_level1_staff" model="ir.rule">
            <field name="name">EDS feedback: L&amp;D staff</field>
            <field name="model_id" ref="model_eds_evaluation_level1"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_eds_officer'))]"/>
        </record>
        <record id="rule_eds_level1_line_employee_own" model="ir.rule">
            <field name="name">EDS feedback answers: employee own</field>
            <field name="model_id" ref="model_eds_evaluation_level1_line"/>
            <field name="domain_force">[('evaluation_id.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_eds_employee'))]"/>
        </record>
        <record id="rule_eds_level1_line_staff" model="ir.rule">
            <field name="name">EDS feedback answers: L&amp;D staff</field>
            <field name="model_id" ref="model_eds_evaluation_level1_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_eds_officer'))]"/>
        </record>
        <record id="rule_eds_level3_manager_own" model="ir.rule">
            <field name="name">EDS behavior review: assigned manager</field>
            <field name="model_id" ref="model_eds_evaluation_level3"/>
            <field name="domain_force">[('manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_eds_line_manager'))]"/>
        </record>
        <record id="rule_eds_level3_staff" model="ir.rule">
            <field name="name">EDS behavior review: L&amp;D staff</field>
            <field name="model_id" ref="model_eds_evaluation_level3"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_eds_officer'))]"/>
        </record>
        <record id="rule_eds_level3_line_manager_own" model="ir.rule">
            <field name="name">EDS behavior answers: assigned manager</field>
            <field name="model_id" ref="model_eds_evaluation_level3_line"/>
            <field name="domain_force">[('evaluation_id.manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_eds_line_manager'))]"/>
        </record>
        <record id="rule_eds_level3_line_staff" model="ir.rule">
            <field name="name">EDS behavior answers: L&amp;D staff</field>
            <field name="model_id" ref="model_eds_evaluation_level3_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_eds_officer'))]"/>
        </record>
    </data>

    <!-- Record Rules -->
    <data noupdate="0">

        <!-- TNA Entry: employee sees own submissions -->
        <record id="rule_eds_tna_entry_employee_own" model="ir.rule">
            <field name="name">Employee Own TNA Entries</field>
            <field name="model_id" ref="employee_development_system.model_eds_tna_entry"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('submitted_by', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- TNA Entry: line manager sees own team and reporting hierarchy -->
        <record id="rule_eds_tna_entry_line_manager_team" model="ir.rule">
            <field name="name">Line Manager Team TNA Entries</field>
            <field name="model_id" ref="employee_development_system.model_eds_tna_entry"/>
            <field name="domain_force">['|', '|', '|', ('employee_id.user_id', '=', user.id), ('submitted_by', '=', user.id), ('employee_id', 'child_of', [user.employee_id.id]), ('employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_line_manager'))]"/>
        </record>

        <!-- TNA Entry: staff (L&D officer/manager/admin) sees all entries -->
        <record id="rule_eds_tna_entry_staff" model="ir.rule">
            <field name="name">TNA Entry L&amp;D Staff</field>
            <field name="model_id" ref="employee_development_system.model_eds_tna_entry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
        </record>

        <!-- TNA Cycle: employees can read cycles open for requests and closed cycles. -->
        <record id="rule_eds_tna_cycle_employee" model="ir.rule">
            <field name="name">Employee Open and Closed TNA Cycles</field>
            <field name="model_id" ref="employee_development_system.model_eds_tna_cycle"/>
            <field name="domain_force">[('state', 'in', ('collecting', 'closed'))]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- TNA Cycle: staff (L&D officer/manager/admin) sees all cycles -->
        <record id="rule_eds_tna_cycle_staff" model="ir.rule">
            <field name="name">TNA Cycle L&amp;D Staff</field>
            <field name="model_id" ref="employee_development_system.model_eds_tna_cycle"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
        </record>

        <!-- Multi-company rules -->
        <record id="rule_eds_tna_cycle_multi_company" model="ir.rule">
            <field name="name">TNA Cycle Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_tna_cycle"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_eds_tna_entry_multi_company" model="ir.rule">
            <field name="name">TNA Entry Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_tna_entry"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- TNA Consolidation: officers/managers see all consolidations of their companies -->
        <record id="rule_eds_tna_consolidation_multi_company" model="ir.rule">
            <field name="name">TNA Consolidation Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_tna_consolidation"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Priority rules: visible to the L&D teams only (no rule for employees) -->
        <record id="rule_eds_tna_priority_rule_staff" model="ir.rule">
            <field name="name">Priority Rules L&amp;D Only</field>
            <field name="model_id" ref="employee_development_system.model_eds_tna_priority_rule"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
        </record>

        <!-- multi-company rules for course catalog, dev requests and curricula -->
        <record id="rule_eds_course_multi_company" model="ir.rule">
            <field name="name">Course Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_course"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_eds_course_dev_request_multi_company" model="ir.rule">
            <field name="name">Course Development Request Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_course_development_request"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_eds_curriculum_multi_company" model="ir.rule">
            <field name="name">Curriculum Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_curriculum"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- trainer register + provider registry visible to the L&amp;D teams only -->
        <record id="rule_eds_trainer_staff" model="ir.rule">
            <field name="name">Trainer Register L&amp;D Only</field>
            <field name="model_id" ref="employee_development_system.model_eds_trainer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
        </record>
        <record id="rule_eds_trainer_self" model="ir.rule">
            <field name="name">Trainer Own Profile</field>
            <field name="model_id" ref="employee_development_system.model_eds_trainer"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('external_partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_trainer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_eds_external_provider_staff" model="ir.rule">
            <field name="name">Provider Registry L&amp;D Only</field>
            <field name="model_id" ref="employee_development_system.model_eds_external_provider"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
        </record>

        <!-- multi-company rules for procurement documents -->
        <record id="rule_eds_venue_requirement_multi_company" model="ir.rule">
            <field name="name">Venue Requirement Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_venue_requirement"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_eds_rfp_multi_company" model="ir.rule">
            <field name="name">RFP Multi Company</field>
            <field name="model_id" ref="employee_development_system.model_eds_rfp"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_eds_vendor_proposal_rfp" model="ir.rule">
            <field name="name">Vendor Proposal RFP Scoped</field>
            <field name="model_id" ref="employee_development_system.model_eds_vendor_proposal"/>
            <field name="domain_force">[('rfp_id', '!=', False)]</field>
        </record>
        <record id="rule_eds_vendor_evaluation_rfp" model="ir.rule">
            <field name="name">Vendor Evaluation RFP Scoped</field>
            <field name="model_id" ref="employee_development_system.model_eds_vendor_evaluation"/>
            <field name="domain_force">[('rfp_id', '!=', False)]</field>
        </record>
        <record id="rule_eds_training_contract_provider" model="ir.rule">
            <field name="name">Training Contract Provider Scoped</field>
            <field name="model_id" ref="employee_development_system.model_eds_training_contract"/>
            <field name="domain_force">[('provider_id', '!=', False)]</field>
        </record>

        <!-- annual plan + sessions + venues are L&amp;D-team operational documents -->
        <record id="rule_eds_annual_plan_staff" model="ir.rule">
            <field name="name">Annual Plan L&amp;D Only</field>
            <field name="model_id" ref="employee_development_system.model_eds_annual_plan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
        </record>
        <record id="rule_eds_annual_plan_line_staff" model="ir.rule">
            <field name="name">Annual Plan Line L&amp;D Only</field>
            <field name="model_id" ref="employee_development_system.model_eds_annual_plan_line"/>
            <field name="domain_force">[('plan_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
        </record>
        <record id="rule_eds_session_staff" model="ir.rule">
            <field name="name">Sessions L&amp;D Only</field>
            <field name="model_id" ref="employee_development_system.model_eds_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_officer'))]"/>
        </record>
        <record id="rule_eds_session_employee_participant" model="ir.rule">
            <field name="name">Employee Sessions With Own Invitation</field>
            <field name="model_id" ref="employee_development_system.model_eds_session"/>
            <field name="domain_force">[('enrollment_ids.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_eds_session_assigned_trainer" model="ir.rule">
            <field name="name">Trainer Assigned Sessions</field>
            <field name="model_id" ref="employee_development_system.model_eds_session"/>
            <field name="domain_force">['|', ('trainer_ids.employee_id.user_id', '=', user.id), ('trainer_ids.external_partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_trainer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_eds_session_manager_participants" model="ir.rule">
            <field name="name">Manager Sessions With Team Invitation</field>
            <field name="model_id" ref="employee_development_system.model_eds_session"/>
            <field name="domain_force">['|', ('enrollment_ids.employee_id.parent_id.user_id', '=', user.id), ('enrollment_ids.employee_id.coach_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('employee_development_system.group_eds_line_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
