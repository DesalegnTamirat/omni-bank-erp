<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="1">
        <!-- ================================================================ -->
        <!-- Sequences                                                         -->
        <!-- ================================================================ -->
        <record id="sequence_hr_employee_probation" model="ir.sequence">
            <field name="name">Employee Probation sequence</field>
            <field name="code">hr.employee.probation</field>
            <field name="prefix">BB/PROB/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sequence_employee_transfer_request" model="ir.sequence">
            <field name="name">Employee Transfer Request sequence</field>
            <field name="code">employee.transfer.request</field>
            <field name="prefix">BB/TRF/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sequence_transfer_committee_minutes" model="ir.sequence">
            <field name="name">Transfer Committee Minutes sequence</field>
            <field name="code">transfer.committee.minutes</field>
            <field name="prefix">BB/TCM/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sequence_hr_onboarding_plan" model="ir.sequence">
            <field name="name">Onboarding Plan sequence</field>
            <field name="code">hr.onboarding.plan</field>
            <field name="prefix">BB/ONB/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ================================================================ -->
        <!-- Bunna Bank S.C. Official Probation Evaluation Criteria Seed Data  -->
        <!-- ================================================================ -->
        <record id="probation_criteria_quality_of_work" model="emp.probation.criteria">
            <field name="emp_evaluation_criteria">QUALITY OF WORK</field>
            <field name="description">Is work done accurately?</field>
            <field name="coefficient">5</field>
        </record>

        <record id="probation_criteria_dependability" model="emp.probation.criteria">
            <field name="emp_evaluation_criteria">DEPENDABILITY</field>
            <field name="description">Does he/she follow instructions properly?</field>
            <field name="coefficient">3</field>
        </record>

        <record id="probation_criteria_integrity" model="emp.probation.criteria">
            <field name="emp_evaluation_criteria">INTEGRITY</field>
            <field name="description">Is he/she trustworthy?</field>
            <field name="coefficient">3</field>
        </record>

        <record id="probation_criteria_punctuality" model="emp.probation.criteria">
            <field name="emp_evaluation_criteria">PUNCTUALITY</field>
            <field name="description">Is he/she regular on the job? And report to work on time?</field>
            <field name="coefficient">3</field>
        </record>

        <record id="probation_criteria_efficiency" model="emp.probation.criteria">
            <field name="emp_evaluation_criteria">EFFICIENCY</field>
            <field name="description">Is he/she confident on what he/she does? Does he/she adapt to new environment easily?</field>
            <field name="coefficient">4</field>
        </record>

        <record id="probation_criteria_cooperation" model="emp.probation.criteria">
            <field name="emp_evaluation_criteria">COOPERATION</field>
            <field name="description">Does he/she show willingness to help others?</field>
            <field name="coefficient">2</field>
        </record>
    </data>

    <data>
        <!-- ================================================================ -->
        <!-- Cron: Probation End Notification                                 -->
        <!-- ================================================================ -->
        <record id="ir_cron_probation_notify_supervisor" model="ir.cron">
            <field name="name">Recruitment: Notify Supervisors of Upcoming Probation End</field>
            <field name="model_id" ref="model_hr_employee_probation"/>
            <field name="state">code</field>
            <field name="code">model._cron_notify_upcoming_probation_end</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- ================================================================ -->
        <!-- Cron: Transfer Request Pending Expiry Check                      -->
        <!-- ================================================================ -->
        <record id="ir_cron_transfer_request_pending_expiry" model="ir.cron">
            <field name="name">Recruitment: Check Long-Pending Transfer Requests</field>
            <field name="model_id" ref="model_employee_transfer_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_pending_transfer_requests</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- ================================================================ -->
        <!-- Cron: Onboarding Delayed Milestones Escalation Check             -->
        <!-- ================================================================ -->
        <record id="ir_cron_onboarding_check_escalations" model="ir.cron">
            <field name="name">Recruitment: Check Onboarding Delayed Milestones Escalations</field>
            <field name="model_id" ref="model_hr_onboarding_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_onboarding_escalations</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
