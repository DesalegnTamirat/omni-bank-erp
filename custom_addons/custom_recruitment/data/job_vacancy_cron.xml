<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Auto-Close Expired Vacancies at Ethiopian Midnight (21:00 UTC = 00:00 EAT) ── -->
        <record id="ir_cron_auto_close_expired_vacancies" model="ir.cron">
            <field name="name">Recruitment: Auto-Close Expired Vacancies at Ethiopian Midnight</field>
            <field name="model_id" ref="model_job_vacancy"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_close_expired_vacancies()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=21, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
