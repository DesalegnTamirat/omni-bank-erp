<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Permanent Letter Report Action for Probation Management -->
    <record id="action_report_probation_permanent_letter" model="ir.actions.report">
        <field name="name">Permanent Employment Confirmation Letter</field>
        <field name="model">hr.employee.probation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_recruitment.report_probation_permanent_letter_document</field>
        <field name="report_file">custom_recruitment.report_probation_permanent_letter_document</field>
        <field name="print_report_name">'Permanent_Letter_' + (object.employee_id.name or object.name or 'Employee').replace(' ', '_')</field>
        <field name="binding_model_id" ref="model_hr_employee_probation"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_bunna_recruitment_letterhead"/>
    </record>

    <!-- Permanent Letter QWeb Template -->
    <template id="report_probation_permanent_letter_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <style type="text/css">
                        @page {
                            size: A4 portrait;
                            margin: 0;
                        }
                        html, body, body.container, body.o_body_pdf, .container, .container-fluid, .article {
                            margin: 0 !important;
                            padding: 0 !important;
                            width: 100% !important;
                            max-width: 100% !important;
                            min-width: 100% !important;
                            height: 100% !important;
                        }
                        .page {
                            margin: 0 !important;
                            padding: 0 !important;
                            width: 100% !important;
                        }
                        .header-table, .header-table tr, .header-table td,
                        .footer-layout-table, .footer-layout-table tr, .footer-layout-table td,
                        .footer-contact-table, .footer-contact-table tr, .footer-contact-table td {
                            border: none !important;
                            border-top: none !important;
                            border-bottom: none !important;
                            border-left: none !important;
                            border-right: none !important;
                            outline: none !important;
                            box-shadow: none !important;
                        }
                        .footer-fixed {
                            position: fixed;
                            bottom: 27pt;
                            left: 0px;
                            right: 0px;
                            width: 100%;
                            margin: 0;
                            padding: 0;
                            border: none !important;
                        }
                        <t t-out="o.get_barlow_font_faces()"/>
                    </style>

                    <div class="page" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" style="font-family: 'Barlow Medium', 'Barlow', Arial, sans-serif !important; color: #000000; font-size: 11pt; line-height: 1.45; width: 100%;">

                        <!-- Official Bunna Bank Letterhead Header Banner (Unstretched logo, full-bleed coffee brown bar #6d382d, zero borders) -->
                        <div style="padding-top: 26pt; margin-bottom: 20pt; width: 100%; border: 0 !important;">
                            <table class="header-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0; padding: 0;">
                                <tr style="border: 0 !important;">
                                    <td style="width: 155px; vertical-align: middle; text-align: left; padding: 0 0 0 24px; margin: 0; border: 0 !important;">
                                        <img t-att-src="o.get_experience_letter_logo_data_uri()" style="width: 130px; height: auto; display: block; object-fit: contain;" alt="Bunna Bank S.C."/>
                                    </td>
                                    <td style="vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <div style="background-color: #6d382d; height: 28px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Body Content Container (25.4mm = 1 inch left &amp; right margins) -->
                        <div style="padding-left: 25.4mm; padding-right: 25.4mm;">

                            <!-- Date &amp; Reference Numbers Header (Right Positioned, Left-Aligned Content) -->
                            <div style="text-align: right; margin-top: 0; margin-bottom: 14pt;">
                                <div style="display: inline-block; text-align: left; font-size: 11pt; line-height: 1.35; color: #000000;">
                                    <div><strong>Date: - </strong><span t-esc="o.outcome_date.strftime('%B %d, %Y') if o.outcome_date else context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y')"/></div>
                                    <div><strong>Ref. No: -</strong><span t-esc="o.permanent_letter_ref or o.name or ''"/></div>
                                    <t t-if="o.employee_id.identification_id">
                                        <div><strong>ID No: </strong><span t-esc="o.employee_id.identification_id"/></div>
                                    </t>
                                </div>
                            </div>

                            <!-- Recipient Block -->
                            <div style="margin-bottom: 12pt; font-size: 11pt; line-height: 1.35;">
                                <div><strong><span t-esc="o.get_permanent_letter_recipient_name_with_title()"/></strong></div>
                                <div><strong>Bunna Bank S.C.</strong></div>
                                <div><strong style="text-decoration: underline;"><span t-esc="o.get_permanent_letter_city()"/></strong></div>
                            </div>

                            <!-- Salutation -->
                            <div style="margin-bottom: 12pt; font-size: 11pt;">
                                <strong>Dear <span t-esc="o.get_permanent_letter_salutation_name()"/>,</strong>
                            </div>

                            <!-- Subject Header -->
                            <div style="text-align: center; margin-top: 8pt; margin-bottom: 14pt;">
                                <span style="font-size: 11.5pt; font-weight: bold; text-decoration: underline; color: #000000;">
                                    Subject: - Confirmation of Permanent Employment
                                </span>
                            </div>

                            <!-- Body Paragraphs -->
                            <div style="text-align: justify; font-size: 11pt; line-height: 1.55;">
                                <p style="margin-bottom: 12pt; text-align: justify;">
                                    It is to be recalled that, the Bank has employed you on <strong><span t-esc="o.probation_start_date.strftime('%B %d, %Y') if o.probation_start_date else ''"/></strong> as <strong><span t-esc="o.job_position_id.name if o.job_position_id else ''"/></strong> for a probation period of <strong><span t-esc="o.get_permanent_letter_duration_days()"/></strong> working days. We are pleased to inform you that, you have successfully completed your probation period on <strong><span t-esc="o.probation_end_date.strftime('%B %d, %Y') if o.probation_end_date else ''"/></strong> and have become a permanent staff member of Bunna Bank S.C.
                                </p>

                                <p style="margin-bottom: 14pt; text-align: justify;">
                                    Please note that your future progress in the Bank depends on your commitment to meet the Bank’s set objectives and your readiness to meet the demands of our customers.
                                </p>
                            </div>

                            <!-- Sign-off Block with Authorized Signature &amp; Official Stamp -->
                            <div style="font-size: 11pt; line-height: 1.35; margin-top: 14pt; margin-bottom: 10pt; page-break-inside: avoid;">
                                <div style="margin-bottom: 3px;">Sincerely yours,</div>
                                <t t-set="sig_data" t-value="o.get_letter_signature_data()"/>
                                <t t-if="sig_data.get('has_split')">
                                    <table style="border: none; border-collapse: collapse; margin-top: 4px; margin-bottom: 6px; padding: 0;">
                                        <tr style="border: none; background: transparent;">
                                            <t t-if="sig_data.get('stamp_position') == 'left'">
                                                <td style="border: none; padding: 0 16px 0 0; vertical-align: middle;">
                                                    <img t-if="sig_data.get('stamp_b64')" t-att-src="sig_data.get('stamp_b64')" alt="Official Rubber Stamp" style="width: 105px; height: 105px; object-fit: contain; display: block;"/>
                                                </td>
                                                <td style="border: none; padding: 0; vertical-align: middle;">
                                                    <img t-if="sig_data.get('signature_b64')" t-att-src="sig_data.get('signature_b64')" alt="Handwritten Signature" style="max-height: 75px; max-width: 220px; object-fit: contain; display: block;"/>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td style="border: none; padding: 0 16px 0 0; vertical-align: middle;">
                                                    <img t-if="sig_data.get('signature_b64')" t-att-src="sig_data.get('signature_b64')" alt="Handwritten Signature" style="max-height: 75px; max-width: 220px; object-fit: contain; display: block;"/>
                                                </td>
                                                <td style="border: none; padding: 0; vertical-align: middle;">
                                                    <img t-if="sig_data.get('stamp_b64')" t-att-src="sig_data.get('stamp_b64')" alt="Official Rubber Stamp" style="width: 105px; height: 105px; object-fit: contain; display: block;"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </table>
                                </t>
                                <t t-elif="sig_data.get('legacy_b64') or o.get_signature_stamp_base64()">
                                    <div style="margin-bottom: 6px;">
                                        <img t-att-src="sig_data.get('legacy_b64') or o.get_signature_stamp_base64()" alt="Authorized Signature &amp; Stamp" style="width: 250px; height: auto; max-height: 155px; object-fit: contain; display: block; margin-top: 4px; margin-bottom: 6px;"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div style="height: 35px;"></div>
                                </t>
                                <t t-set="disp_pml_name" t-value="sig_data.get('signatory_name') or o.get_signatory_name()"/>
                                <div t-if="disp_pml_name"><strong><t t-esc="disp_pml_name"/></strong></div>
                                <div><strong><t t-esc="sig_data.get('signatory_title') or o.get_signatory_title()"/></strong></div>
                                <div><strong><t t-esc="sig_data.get('signatory_company') or o.get_signatory_company()"/></strong></div>
                            </div>

                            <!-- CC Block -->
                            <div style="font-size: 9.5pt; line-height: 1.35; margin-top: 10pt; page-break-inside: avoid;">
                                <div><strong>CC:</strong></div>
                                <div style="padding-left: 15px;">
                                    <t t-foreach="o.get_permanent_letter_cc_lines()" t-as="cc_line">
                                        <div><t t-esc="cc_line"/></div>
                                    </t>
                                </div>
                            </div>

                        </div>

                        <!-- Official Bunna Bank Letterhead Footer (Exact parity with Experience Letter, zero borders, pinned to bottom) -->
                        <div class="footer-fixed">
                            <table class="footer-layout-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0; padding: 0;">
                                <tr style="border: 0 !important;">
                                    <!-- Left Olive Green Accent Bar -->
                                    <td style="width: 15%; vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <div style="background-color: #253315; height: 26px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                    <!-- Center Contact Info Table -->
                                    <td style="width: 70%; vertical-align: middle; padding: 0 18px; margin: 0; text-align: center; border: 0 !important;">
                                        <table class="footer-contact-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0 auto; font-size: 8pt; color: #6d382d; line-height: 1.4;">
                                            <tr style="border: 0 !important;">
                                                <td style="width: 34%; text-align: left; padding: 1px 0; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Tel</strong> +251 111 580 861 | 62
                                                </td>
                                                <td style="width: 36%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Email</strong> info@bunnabanksc.com
                                                </td>
                                                <td style="width: 30%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">P.O.Box</strong> 1743 code 1110
                                                </td>
                                            </tr>
                                            <tr style="border: 0 !important;">
                                                <td style="width: 34%; text-align: left; padding: 1px 0; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Fax</strong> +251 111 580 832 | 76
                                                </td>
                                                <td style="width: 36%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Website</strong> www.bunnabanksc.com
                                                </td>
                                                <td style="width: 30%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    Addis Ababa | Ethiopia
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <!-- Right Olive Green Accent Bar -->
                                    <td style="width: 15%; vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <div style="background-color: #253315; height: 26px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
