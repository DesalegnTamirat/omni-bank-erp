<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Promotion Letter Report Action -->
    <record id="action_report_internal_promotion_letter" model="ir.actions.report">
        <field name="name">Internal Promotion Letter</field>
        <field name="model">new.internal.recruitment.selected.candidates</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_recruitment.report_internal_promotion_letter_document</field>
        <field name="report_file">custom_recruitment.report_internal_promotion_letter_document</field>
        <field name="print_report_name">'Promotion_Letter_' + (object.emp_name.name or 'Employee').replace(' ', '_')</field>
        <field name="binding_model_id" ref="model_new_internal_recruitment_selected_candidates"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_bunna_recruitment_letterhead"/>
    </record>

    <!-- Promotion Letter Template -->
    <template id="report_internal_promotion_letter_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <style type="text/css">
                        @page {
                            size: A4 portrait;
                            margin: 0;
                        }
                        html, body, body.container, body.o_body_pdf, .container, .container-fluid, .article {
                            margin: 0 !important;
                            padding: 0 !important;
                            width: 100% !important;
                            max-width: 100% !important;
                            min-width: 100% !important;
                            height: 100% !important;
                        }
                        .page {
                            margin: 0 !important;
                            padding: 0 !important;
                            width: 100% !important;
                        }
                        .header-table, .header-table tr, .header-table td,
                        .footer-layout-table, .footer-layout-table tr, .footer-layout-table td,
                        .footer-contact-table, .footer-contact-table tr, .footer-contact-table td {
                            border: none !important;
                            border-top: none !important;
                            border-bottom: none !important;
                            border-left: none !important;
                            border-right: none !important;
                            outline: none !important;
                            box-shadow: none !important;
                        }
                        .footer-fixed {
                            position: fixed;
                            bottom: 27pt;
                            left: 0px;
                            right: 0px;
                            width: 100%;
                            margin: 0;
                            padding: 0;
                            border: none !important;
                        }
                        <t t-out="o.get_barlow_font_faces()"/>
                    </style>

                    <div class="page" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" style="font-family: 'Barlow Medium', 'Barlow', Arial, sans-serif !important; color: #000000; font-size: 11pt; line-height: 1.4; width: 100%;">

                        <!-- Official Bunna Bank Letterhead Header Banner (Unstretched logo, full-bleed coffee brown bar #6d382d, zero borders) -->
                        <div style="padding-top: 26pt; margin-bottom: 20pt; width: 100%; border: 0 !important;">
                            <table class="header-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0; padding: 0;">
                                <tr style="border: 0 !important;">
                                    <td style="width: 155px; vertical-align: middle; text-align: left; padding: 0 0 0 24px; margin: 0; border: 0 !important;">
                                        <t t-if="o.get_official_bunna_logo_base64()">
                                            <img t-att-src="'data:image/png;base64,%s' % o.get_official_bunna_logo_base64()" style="width: 130px; height: auto; display: block; object-fit: contain;" alt="Bunna Bank S.C."/>
                                        </t>
                                        <t t-else="">
                                            <img src="/custom_recruitment/static/src/img/bunna_bank_official_logo.png" style="width: 130px; height: auto; display: block; object-fit: contain;" alt="Bunna Bank S.C."/>
                                        </t>
                                    </td>
                                    <td style="vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <!-- Official Bunna Bank Coffee Brown Header Bar (#6d382d) -->
                                        <div style="background-color: #6d382d; height: 28px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Body Content Container (25.4mm = 1 inch left & right margins) -->
                        <div style="padding-left: 25.4mm; padding-right: 25.4mm;">

                            <!-- Date & Reference Numbers Header Table (Right Positioned, Left-Aligned Content, Clean borderless div) -->
                            <div style="text-align: right; margin-top: 0; margin-bottom: 12pt;">
                                <div style="display: inline-block; text-align: left; font-size: 11pt; line-height: 1.35; color: #000000;">
                                    <div><strong>Date: </strong><span t-esc="o.get_formatted_promotion_date()"/></div>
                                    <div><strong>Ref. No: </strong><span t-esc="o.promotion_ref_no or ('BB/POMD/0000/' + str(context_timestamp(datetime.datetime.now()).year))"/></div>
                                    <div><strong>ID. No: </strong><span t-esc="o.emp_name.identification_id or o.emp_name.barcode or (o.emp_name.id if o.emp_name else '')"/></div>
                                </div>
                            </div>

                            <!-- Recipient Block -->
                            <div style="margin-bottom: 10pt; font-size: 11.5pt; line-height: 1.35;">
                                <div><strong><span t-esc="o.get_salutation_label()"/> <span t-esc="o.emp_name.name if o.emp_name else '____________________'"/></strong></div>
                                <div><strong>Bunna Bank S.C</strong></div>
                                <div><strong style="text-decoration: underline;"><span t-esc="o.get_recipient_location()"/></strong></div>
                            </div>

                            <!-- Salutation -->
                            <div style="margin-bottom: 10pt; font-size: 11.5pt;">
                                <strong>Dear <span t-esc="o.get_salutation_first_name()"/>,</strong>
                            </div>

                            <!-- Subject -->
                            <div style="text-align: center; margin-top: 8pt; margin-bottom: 14pt;">
                                <span style="font-size: 12pt; font-weight: bold; text-decoration: underline; color: #000000;">
                                    Subject: – <t t-esc="o.get_letter_subject()"/>
                                </span>
                            </div>

                            <!-- Body Content -->
                            <div style="text-align: justify; font-size: 11pt; line-height: 1.45;">
                                
                                <!-- Paragraph 1: Position, Grade, Work Unit & Phrasing (Bold, Justified) -->
                                <p style="margin-bottom: 8pt; font-weight: bold; text-align: justify;">
                                    I am pleased to inform you that you are <t t-esc="o.get_letter_action_verb()"/> to the post of 
                                    <span t-esc="o.get_new_job_position_name() or '________________'"/> 
                                    Job Grade <span t-esc="o.get_new_job_grade_name() or '________'"/> 
                                    and assigned at <span t-esc="o.get_target_work_unit_name() or '________________'"/> 
                                    <t t-if="o.promotion_type == 'diff_unit'">
                                        effective the date you assume your new position.
                                    </t>
                                    <t t-else="">
                                        effective <span t-esc="o.get_formatted_promotion_date_body()"/>.
                                    </t>
                                </p>

                                <!-- Paragraph 2: Salary Figures & In Words (Bold, Justified) -->
                                <p style="margin-bottom: 8pt; font-weight: bold; text-align: justify;">
                                    Commencing the same date, your monthly salary is raised to Birr 
                                    <span t-esc="'{:,.2f}'.format(o.get_promoted_salary_figure()) if o.get_promoted_salary_figure() else '________'"/> 
                                    (<span t-esc="o.get_promoted_salary_in_words() or '________________'"/>) 
                                    and you are entitled to other benefits attached to the position as per the benefit Package.
                                </p>

                                <!-- Paragraph 3: RELEASE CLAUSE (Rendered ONLY for Different Work Unit / Assume, Bold, Justified) -->
                                <t t-if="o.promotion_type == 'diff_unit'">
                                    <p style="margin-bottom: 8pt; font-weight: bold; text-align: justify;">
                                        By copy of this letter, <span t-esc="o.get_current_work_unit_name() or '________________'"/> is advised to release <span t-esc="o.get_salutation_label()"/> <span t-esc="o.emp_name.name if o.emp_name else '________________'"/> and forward the necessary information to <span t-esc="o.get_release_clause_forward_targets()"/> and People Operation Management Directorate.
                                    </p>
                                </t>

                                <!-- Paragraph 4: Closing Encouragement (Regular weight) -->
                                <p style="margin-bottom: 10pt; font-weight: normal; text-align: justify;">
                                    I hope you will continue to exert maximum effort to discharge the duties and responsibilities bestowed upon you.
                                </p>
                            </div>

                            <!-- Sign-off Block with Authorized Signature & Official Stamp -->
                            <div style="font-size: 11pt; line-height: 1.35; margin-top: 10pt; margin-bottom: 8pt; page-break-inside: avoid;">
                                <div style="margin-bottom: 3px;">Sincerely yours,</div>
                                <t t-set="sig_data" t-value="o.get_letter_signature_data()"/>
                                <t t-if="sig_data.get('has_split')">
                                    <div style="margin-bottom: 6px;">
                                        <table style="border: none; border-collapse: collapse; margin-top: 4px; margin-bottom: 6px; padding: 0;">
                                            <tr style="border: none; background: transparent;">
                                                <t t-if="sig_data.get('stamp_position') == 'left'">
                                                    <td style="border: none; padding: 0 16px 0 0; vertical-align: middle;">
                                                        <img t-if="sig_data.get('stamp_b64')" t-att-src="sig_data.get('stamp_b64')" alt="Official Rubber Stamp" style="width: 105px; height: 105px; object-fit: contain; display: block;"/>
                                                    </td>
                                                    <td style="border: none; padding: 0; vertical-align: middle;">
                                                        <img t-if="sig_data.get('signature_b64')" t-att-src="sig_data.get('signature_b64')" alt="Handwritten Signature" style="max-height: 75px; max-width: 220px; object-fit: contain; display: block;"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td style="border: none; padding: 0 16px 0 0; vertical-align: middle;">
                                                        <img t-if="sig_data.get('signature_b64')" t-att-src="sig_data.get('signature_b64')" alt="Handwritten Signature" style="max-height: 75px; max-width: 220px; object-fit: contain; display: block;"/>
                                                    </td>
                                                    <td style="border: none; padding: 0; vertical-align: middle;">
                                                        <img t-if="sig_data.get('stamp_b64')" t-att-src="sig_data.get('stamp_b64')" alt="Official Rubber Stamp" style="width: 105px; height: 105px; object-fit: contain; display: block;"/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </table>
                                    </div>
                                </t>
                                <t t-elif="sig_data.get('legacy_b64') or o.get_signature_stamp_base64()">
                                    <div style="margin-bottom: 6px;">
                                        <img t-att-src="sig_data.get('legacy_b64') or o.get_signature_stamp_base64()" alt="Authorized Signature &amp; Stamp" style="width: 250px; height: auto; max-height: 155px; object-fit: contain; display: block; margin-top: 4px; margin-bottom: 6px;"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div style="height: 30px;"></div>
                                </t>
                                <t t-set="disp_prom_name" t-value="sig_data.get('signatory_name') or o.get_signatory_name()"/>
                                <t t-if="disp_prom_name">
                                    <div><strong><span t-esc="disp_prom_name"/></strong></div>
                                </t>
                                <div><strong><span t-esc="sig_data.get('signatory_title') or o.get_signatory_title()"/></strong></div>
                                <div><strong><span t-esc="sig_data.get('signatory_company') or o.get_signatory_company()"/></strong></div>
                            </div>

                            <!-- CC Block (Indented plain lines without bullets, matching Word templates) -->
                            <div style="font-size: 9.5pt; line-height: 1.28; margin-top: 6pt; page-break-inside: avoid;">
                                <div><strong>CC:</strong></div>
                                <div style="padding-left: 15px;">
                                    <t t-foreach="o.get_promotion_letter_cc_lines()" t-as="cc_line">
                                        <div><span t-esc="cc_line"/></div>
                                    </t>
                                    <div style="font-weight: bold; text-decoration: underline; margin-top: 1px;">Bunna Bank S.C</div>
                                </div>
                            </div>

                        </div>

                        <!-- Official Bunna Bank Letterhead Footer (Exact parity with Experience Letter, zero borders, pinned to bottom) -->
                        <div class="footer-fixed">
                            <table class="footer-layout-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0; padding: 0;">
                                <tr style="border: 0 !important;">
                                    <!-- Left Olive Green Accent Bar (Bleeds to 0px left edge) -->
                                    <td style="width: 15%; vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <div style="background-color: #253315; height: 26px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                    <!-- Center Contact Info Table (Centered between the two bars) -->
                                    <td style="width: 70%; vertical-align: middle; padding: 0 18px; margin: 0; text-align: center; border: 0 !important;">
                                        <table class="footer-contact-table" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: 0 !important; margin: 0 auto; font-size: 8pt; color: #6d382d; line-height: 1.4;">
                                            <tr style="border: 0 !important;">
                                                <td style="width: 34%; text-align: left; padding: 1px 0; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Tel</strong> +251 111 580 861 | 62
                                                </td>
                                                <td style="width: 36%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Email</strong> info@bunnabanksc.com
                                                </td>
                                                <td style="width: 30%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">P.O.Box</strong> 1743 code 1110
                                                </td>
                                            </tr>
                                            <tr style="border: 0 !important;">
                                                <td style="width: 34%; text-align: left; padding: 1px 0; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Fax</strong> +251 111 580 832 | 76
                                                </td>
                                                <td style="width: 36%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    <strong style="font-weight: bold;">Website</strong> www.bunnabanksc.com
                                                </td>
                                                <td style="width: 30%; text-align: left; padding: 1px 0 1px 12px; border: 0 !important; font-size: 8pt; color: #6d382d; white-space: nowrap;">
                                                    Addis Ababa | Ethiopia
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <!-- Right Olive Green Accent Bar (Bleeds to 100% right edge) -->
                                    <td style="width: 15%; vertical-align: middle; padding: 0; margin: 0; border: 0 !important;">
                                        <div style="background-color: #253315; height: 26px; width: 100%; margin: 0; padding: 0; border: 0 !important;"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
