<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <template id="report_transfer_minute_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Official Header with Bunna Bank Logo -->
                        <table style="width: 100%; margin-bottom: 16px; border-collapse: collapse;">
                            <tr>
                                <td style="width: 25%; vertical-align: middle; text-align: left;">
                                    <t t-if="o.get_official_bunna_logo_base64()">
                                        <img t-att-src="'data:image/png;base64,%s' % o.get_official_bunna_logo_base64()" style="max-height: 80px; max-width: 150px; height: auto;" alt="Bunna Bank S.C."/>
                                    </t>
                                    <t t-else="">
                                        <img src="/custom_recruitment/static/src/img/bunna_bank_official_logo.png" style="max-height: 80px; max-width: 150px; height: auto;" alt="Bunna Bank S.C."/>
                                    </t>
                                </td>
                                <td style="width: 75%; vertical-align: middle; text-align: center; padding-right: 80px;">
                                    <h4 style="font-weight: bold; color: #541718; margin: 0;">BUNNA BANK S.C.</h4>
                                    <h5 style="margin: 4px 0;"><strong>Transfer Committee Minutes</strong></h5>
                                    <h6 style="color: #666; margin: 0;"><span t-field="o.name"/></h6>
                                </td>
                            </tr>
                        </table>
                        <div style="background-color: #541718; height: 3px; width: 100%; margin-bottom: 16px;"></div>
                        <div class="row mt32">
                            <div class="col-6">
                                <strong>Target Vacancy:</strong>
                                <span t-field="o.target_vacancy_id.reference"/>
                                (<span t-field="o.target_vacancy_id.job_position.name"/>)
                            </div>
                            <div class="col-6">
                                <strong>Meeting Date:</strong>
                                <span t-field="o.meeting_date"/>
                            </div>
                        </div>
                        <br/>
                        <table class="table table-sm o_main_table" name="ranked_candidates">
                            <thead>
                                <tr>
                                    <th class="text-left"><span>Rank</span></th>
                                    <th class="text-left"><span>Employee</span></th>
                                    <th class="text-left"><span>App Date (20%)</span></th>
                                    <th class="text-left"><span>Experience (20%)</span></th>
                                    <th class="text-left"><span>Location Tenure (20%)</span></th>
                                    <th class="text-left"><span>PMS (30%)</span></th>
                                    <th class="text-left"><span>Supervisor Rec (10%)</span></th>
                                    <th class="text-left"><span>Discipline Deduction</span></th>
                                    <th class="text-left"><span>Final Score</span></th>
                                    <th class="text-left"><span>Decision</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.ranking_line_ids" t-as="line">
                                    <tr>
                                        <td><span t-esc="line.rank"/></td>
                                        <td><span t-field="line.employee_id.name"/></td>
                                        <td><span t-esc="'%.2f' % line.application_date_score"/></td>
                                        <td><span t-esc="'%.2f' % line.experience_score"/></td>
                                        <td><span t-esc="'%.2f' % line.service_location_score"/></td>
                                        <td><span t-esc="'%.2f' % line.pms_score"/></td>
                                        <td><span t-esc="'%.2f' % line.recommendation_score"/></td>
                                        <td><span t-esc="'%.2f' % line.discipline_deduction_percent"/></td>
                                        <td><span t-esc="'%.2f' % line.final_score"/></td>
                                        <td><span t-field="line.selection_decision"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <br/>
                        <div class="row mt32">
                            <div class="col-12">
                                <strong>Selection Decision / Committee Notes:</strong>
                                <p t-field="o.selection_decision"/>
                            </div>
                        </div>

                        <!-- Executive Approval & Stamp -->
                        <div class="row mt-4" style="page-break-inside: avoid;">
                            <div class="col-7"></div>
                            <div class="col-5 text-start" style="font-size: 13px;">
                                <div><strong>Approved by:</strong></div>
                                <t t-set="min_sig" t-value="env['recruitment.signatory.config'].get_active_signatory('committee_minute')"/>
                                <t t-set="min_b64" t-value="min_sig.get_signature_stamp_base64() if min_sig else env['recruitment.signatory.config'].get_active_signature_stamp_base64('committee_minute')"/>
                                <t t-if="min_b64">
                                    <div style="margin-top: 4px; margin-bottom: 2px;">
                                        <img t-att-src="min_b64" alt="Authorized Signature &amp; Stamp" style="max-height: 80px; max-width: 200px; object-fit: contain;"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div style="height: 45px;"></div>
                                </t>
                                <t t-if="min_sig and min_sig.signatory_name">
                                    <div><strong><span t-esc="min_sig.signatory_name"/></strong></div>
                                </t>
                                <div><strong><span t-esc="min_sig.signatory_title if min_sig and min_sig.signatory_title else 'Talent Management Directorate'"/></strong></div>
                                <div><strong><span t-esc="min_sig.signatory_company if min_sig and min_sig.signatory_company else 'Bunna Bank S.C.'"/></strong></div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_transfer_minute" model="ir.actions.report">
        <field name="name">Transfer Committee Minutes</field>
        <field name="model">transfer.committee.minutes</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_recruitment.report_transfer_minute_template</field>
        <field name="report_file">custom_recruitment.report_transfer_minute_template</field>
        <field name="binding_model_id" ref="model_transfer_committee_minutes"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
