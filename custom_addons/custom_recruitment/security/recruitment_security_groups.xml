<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ========================================================= -->
        <!-- RECRUITMENT ACCESS GROUPS (Merged into Human Resources)    -->
        <!-- Privilege: hr_recruitment.res_groups_privilege_recruitment -->
        <!-- Category:  base.module_category_human_resources           -->
        <!-- ========================================================= -->

        <!-- 1. User: Internal Employee Access (Transfer Requests & Self-Service) -->
        <record id="group_recruitment_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" eval="False"/>
            <field name="sequence">10</field>
            <field name="comment">Basic recruitment access: employees can view and manage their own transfer requests only.</field>
        </record>

        <!-- Base Internal User automatically gets basic recruitment transfer access -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('custom_recruitment.group_recruitment_user'))]"/>
        </record>

        <!-- 1b. Recruitment Approval Committee Member (Designated signers for Selection Minutes) -->
        <record id="group_recruitment_approval_committee" model="res.groups">
            <field name="name">Recruitment Approval Committee Member</field>
            <field name="sequence">12</field>
            <field name="comment">Employees appointed to a vacancy selection approval committee to review and digitally sign Selection Minutes.</field>
            <field name="implied_ids" eval="[(4, ref('custom_recruitment.group_recruitment_user'))]"/>
        </record>

        <!-- 2. Officer: Recruitment Officer (Screening, Shortlisting, Operations) -->
        <record id="group_recruitment_officer" model="res.groups">
            <field name="name">Officer</field>
            <field name="privilege_id" eval="False"/>
            <field name="sequence">15</field>
            <field name="comment">Officer-level access: can view and manage their own recruitment requests and transfer requests.</field>
            <field name="implied_ids" eval="[(4, ref('custom_recruitment.group_recruitment_user')), (4, ref('custom_recruitment.group_recruitment_approval_committee'))]"/>
        </record>

        <!-- Remove Interviewer from Recruitment privilege dropdown -->
        <record id="hr_recruitment.group_hr_recruitment_interviewer" model="res.groups">
            <field name="privilege_id" eval="False"/>
        </record>

        <!-- Clear "No" placeholder for Recruitment privilege -->
        <record id="hr_recruitment.res_groups_privilege_recruitment" model="res.groups.privilege">
            <field name="placeholder"></field>
        </record>

        <!-- Link standard Odoo Recruitment Officer to custom Recruitment Officer -->
        <record id="hr_recruitment.group_hr_recruitment_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('custom_recruitment.group_recruitment_officer'))]"/>
        </record>

        <!-- 3. HR Manager: Talent Acquisition Manager / Directorate Head -->
        <!-- Appears in the single Recruitment dropdown under HUMAN RESOURCES -->
        <record id="group_recruitment_manager" model="res.groups">
            <field name="name">HR Manager</field>
            <field name="privilege_id" ref="hr_recruitment.res_groups_privilege_recruitment"/>
            <field name="sequence">25</field>
            <field name="comment">Full operational access to recruitment: can read, create and edit all recruitment records but cannot delete.</field>
            <field name="implied_ids" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
        </record>

        <!-- 4. Administrator: Full Control & Configuration -->
        <record id="group_recruitment_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" eval="False"/>
            <field name="sequence">30</field>
            <field name="comment">Full control of the recruitment module, including delete.</field>
            <field name="implied_ids" eval="[(4, ref('custom_recruitment.group_recruitment_manager'))]"/>
        </record>

        <!-- Link standard Odoo Recruitment Administrator to custom Administrator -->
        <record id="hr_recruitment.group_hr_recruitment_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('custom_recruitment.group_recruitment_administrator'))]"/>
        </record>

    </data>
</odoo>