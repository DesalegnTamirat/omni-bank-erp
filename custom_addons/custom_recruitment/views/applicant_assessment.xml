<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="applicant_assessment_form" model="ir.ui.view">
        <field name="name">applicant.assessment.form</field>
        <field name="model">applicant.assessment</field>
        <field name="arch" type="xml">
            <form string="Applicant Assessment">
                <group colspan="2">
                    <group>
                        <field name="recruiting_position" readonly="1"/>
                        <field name="assessor_name" readonly="1"/>
                        <field name="assessment_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="applicant_name" readonly="1"/>
                        <field name="recruitment_type" readonly="1"/>
                    </group>
                    <group>
                        <!-- <field name="assessment_criteria" readonly="1"/> -->
<!--                        <field name="weight" />-->
                    </group>
                    <group>
                        <field name="marks_awarded"/>
                    </group>
                </group>
            </form>
        </field>
    </record>
    <record id="applicant_assessment_tree" model="ir.ui.view">
        <field name="name">applicant.assessment.tree</field>
        <field name="model">applicant.assessment</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="1" delete="1" multi_edit="1" string="Applicant Exam Assessment">
                <field name="vacancy_reference" readonly="1"/>
                <field name="recruiting_position" readonly="1"/>
                <field name="assessor_name" readonly="1"/>
                <field name="assessment_date" readonly="1"/>
                <field name="applicant_name" readonly="1"/>
                <field name="recruitment_type" readonly="1"/>
                <!-- <field name="assessment_criteria" readonly="1"/> -->
                <field name="candidate_attendance"/>
                <field name="marks_awarded"/>
            </list>
        </field>
    </record>
        <record id="applicant_assessment_tree_form" model="ir.actions.act_window">
        <field name="name">Exam Assessment</field>
        <field name="res_model">applicant.assessment</field>
        <field name="context">{}</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>