<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Parent recruitment menus declared EARLY because wizards/external_candidates.xml
             needs menu_external_recruitment to already exist as a parent when it loads.
             Full menu items that depend on actions/views declared later remain in
             views/menu_recruitment.xml. -->
        <record id="new_recruitment_menu" model="ir.ui.menu">
            <field name="name">Recruitments</field>
            <field name="parent_id" ref="hr_recruitment.menu_hr_recruitment_root"/>
            <field name="sequence" eval="3"/>
        </record>

        <record id="menu_internal_recruitment" model="ir.ui.menu">
            <field name="name">Recruitment Internal</field>
            <field name="parent_id" ref="new_recruitment_menu"/>
            <field name="sequence" eval="1"/>
        </record>

        <record id="menu_external_recruitment" model="ir.ui.menu">
            <field name="name">External Recruitment</field>
            <field name="parent_id" ref="new_recruitment_menu"/>
            <field name="sequence" eval="4"/>
        </record>

        <!-- ── Menu items ────────────────────────────────────────────────── -->
        <menuitem id="menu_candidate_scores"
                  name="Candidate Scores"
                  parent="new_recruitment_menu"
                  action="action_recruitment_candidate_score"
                  sequence="15"/>
        <menuitem id="menu_offer_letters"
                  name="Offer Letters"
                  parent="new_recruitment_menu"
                  action="action_recruitment_offer_letter"
                  sequence="16"/>
        <menuitem id="menu_application_windows"
                  name="Application Windows"
                  parent="menu_internal_recruitment"
                  action="action_recruitment_application_window"
                  sequence="9"/>
    </data>
</odoo>
