<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="applicant_shortlist_tree" model="ir.ui.view">
        <field name="name">applicant.shortlist.form</field>
        <field name="model">applicant.shortlist</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="1" delete="1" multi_edit="1" string="Applicant Shortlist">
                <field name="recruitment_reference"/>
                <field name="job_position"/>
                <field name="applicant_id"/>
                <field name="applicant_gender"/>
                <field name="educational_qualification"/>
                <field name="CGPA"/>
                <field name="years_of_experience"/>
                <field name="banking_experience"/>
                <field name="current_working"/>
                <field name="current_company"/>
                <field name="current_location"/>
                <field name="join_immediately"/>
                <field name="available_date"/>
                <field name="applicant_email"/>
                <field name="notify_candidate"/>

            </list>
        </field>
    </record>
        <record id="applicant_shortlist_form_tree" model="ir.actions.act_window">
        <field name="name">Applicant Shortlist</field>
        <field name="res_model">applicant.shortlist</field>
        <field name="context">{}</field>
        <field name="view_mode">list</field>
    </record>
