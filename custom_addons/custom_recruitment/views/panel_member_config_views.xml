<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View: Panel Member Configurations -->
    <record id="view_recruitment_panel_member_config_tree" model="ir.ui.view">
        <field name="name">recruitment.panel.member.config.list</field>
        <field name="model">recruitment.panel.member.config</field>
        <field name="arch" type="xml">
            <list string="Panel Member Configurations" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="scope"/>
                <field name="employee_count"/>
                <field name="job_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View: Panel Member Configuration -->
    <record id="view_recruitment_panel_member_config_form" model="ir.ui.view">
        <field name="name">recruitment.panel.member.config.form</field>
        <field name="model">recruitment.panel.member.config</field>
        <field name="arch" type="xml">
            <form string="Panel Member Configuration">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Configuration Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Authorized Interview Panel Members"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Scope &amp; Hierarchy">
                            <field name="scope"/>
                        </group>
                        <group string="Settings">
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert">
                        <strong>ℹ️ Interview Panel Configuration:</strong>
                        Employees and Job Positions added below will be the <strong>only eligible panel members</strong> selectable in the <em>Panel Members</em> tab across <strong>Internal</strong> and <strong>External</strong> Vacancies.
                    </div>

                    <notebook>
                        <page string="Eligible Employees" name="employees">
                            <field name="employee_ids" widget="many2many">
                                <list string="Allowed Panel Members">
                                    <field name="name" string="Employee Name"/>
                                    <field name="job_id" string="Job Position"/>
                                    <field name="department_id" string="Department"/>
                                    <field name="default_operating_unit_id" string="Work Unit / Branch"/>
                                    <field name="work_email" string="Email"/>
                                </list>
                            </field>
                        </page>
                        <page string="Eligible Job Positions (Optional)" name="job_positions">
                            <field name="job_ids" widget="many2many">
                                <list string="Allowed Job Positions">
                                    <field name="name" string="Job Position"/>
                                    <field name="department_id" string="Department"/>
                                    <field name="no_of_employee" string="Current Employees"/>
                                </list>
                            </field>
                            <p class="text-muted small mt-2">
                                <i>Note: All active employees holding any of the selected job positions above will also be eligible as panel members.</i>
                            </p>
                        </page>
                        <page string="Description &amp; Notes" name="notes">
                            <field name="note" placeholder="Internal remarks or appointment committee reference..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_recruitment_panel_member_config_search" model="ir.ui.view">
        <field name="name">recruitment.panel.member.config.search</field>
        <field name="model">recruitment.panel.member.config</field>
        <field name="arch" type="xml">
            <search string="Search Panel Member Configurations">
                <field name="name"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_scope" string="Scope" context="{'group_by': 'scope'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_recruitment_panel_member_config" model="ir.actions.act_window">
        <field name="name">Panel Members</field>
        <field name="res_model">recruitment.panel.member.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_recruitment_panel_member_config_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Authorized Interview Panel Members
            </p>
            <p>
                Add employees or job positions who are authorized to serve on interview assessment panels for internal and external job vacancies.
            </p>
        </field>
    </record>

    <!-- Menu items: Under Recruitment Configuration -->
    <menuitem id="menu_recruitment_panel_member_config"
              name="Panel Members"
              parent="hr_recruitment.menu_hr_recruitment_configuration"
              action="action_recruitment_panel_member_config"
              sequence="56"
              groups="group_recruitment_officer,group_recruitment_manager,group_recruitment_administrator,base.group_user"/>

    <menuitem id="menu_recruitment_panel_member_config_direct"
              name="Panel Members"
              parent="menu_recruitment_config_root"
              action="action_recruitment_panel_member_config"
              sequence="16"
              groups="group_recruitment_officer,group_recruitment_manager,group_recruitment_administrator,base.group_user"/>

</odoo>
