<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="employee_recruitment_available_form" model="ir.ui.view">
        <field name="name">employee.recruitment.available.form</field>
        <field name="model">employee.recruitment.available</field>
        <field name="arch" type="xml">
            <form string="Internal Job Position">
                <group colspan="2">
                    <group>
                        <field name="vacancy_reference"/>
                        <field name="recruitment_reference"/>
                        <field name="job_position"/>
                        <field name="employee_grade"/>

                    </group>
                     <group>
<!--                        <field name="operating_unit"/>-->
                        <field name="employee_category"/>
                         <field name="job_location"/>
                         <field name="last_date_to_apply"/>


                    </group>
                    <group>
<!--                        <field name="number_of_vacancies"/>-->
                        <field name="employee_applicant"/>
                          <field name="job_description"/>
						  <field name="application_status"/>


                    </group>
                    <group>
                        <field name="vacancy_announced_on"/>
						
                        <button name="apply" invisible="application_status in ['Applied', 'Replied', 'Selected for Promotion']" string="Apply Now" type="object" class="oe_highlight"/>
<!--                        <button name="accept_promotion"  invisible="application_status in [&apos;New&apos;, &apos;Applied&apos;, &apos;Replied&apos;]" string="Accept Promotion" type="object" class="oe_highlight"/>-->
<!--                        <button name="reject_promotion"  invisible="application_status in [&apos;New&apos;, &apos;Applied&apos;, &apos;Replied&apos;]" string="Reject Promotion" type="object" class="oe_highlight"/>-->
<!--                        <field name="rejection_reason"/>-->
                    </group>
                    <group>
                        <button name="accept_promotion" invisible="application_status in ['New', 'Applied', 'Replied']" string="Accept Promotion" type="object" class="oe_highlight"/>
                        <button name="reject_promotion" invisible="application_status in ['New', 'Applied', 'Replied']" string="Reject Promotion" type="object" class="oe_highlight"/>
                        <field name="rejection_reason" invisible="application_status in ['New', 'Applied', 'Replied']"/>
                    </group>


                </group>
                <group>
                        <notebook string="Vacancies">
                            <page string="Vacancies">
                                <field name="employee_vacancy_ids">
                                    <list string="Vacancies Available">
                                        <field name="operating_unit" width="20%"/>
                                        <field name="number_of_vacancies" width="20%"/>
                                        <field name="location_preference" width="20%"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                </group>

            </form>
        </field>
    </record>
    <record id="employee_recruitment_available_tree" model="ir.ui.view">
        <field name="name">employee.recruitment.available.tree</field>
        <field name="model">employee.recruitment.available</field>
        <field name="arch" type="xml">
            <list string="Internal Job Position">

<!--                <field name="operating_unit"/>-->
                <field name="job_location"/>
                <field name="job_position"/>
                <field name="employee_grade"/>
                <field name="employee_category"/>
<!--                <field name="type_of_employment"/>-->
                <field name="number_of_vacancies"/>
<!--                 <field name="employee_applicant"/>-->
                <field name="vacancy_announced_on"/>
                <field name="last_date_to_apply"/>
<!--                <field name="recruitment_end_date"/>-->
                <field name="job_description"/>
                <field name="application_reason"/>
<!--                <field name="allowance_difference"/>-->

<!--                <field name="active"  invisible="inactive == True"/>-->
<!--                <field name="inactive"  invisible="active == True"/>-->
            </list>
        </field>
    </record>
        <record id="internal_job_position_tree_form" model="ir.actions.act_window">
        <field name="name">Internal Job Position</field>
        <field name="res_model">employee.recruitment.available</field>
        <field name="context">{}</field>
        <field name="domain">[('employee_user_id', '=', uid)]</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- COMMENTED OUT: Parent menu 'hr.menu_hr_employee_user' doesn't exist in Odoo 19. Menu is defined in menu.xml -->
    <!-- <menuitem id="menu_internal_job_position" name="Internal Job Position" parent="hr.menu_hr_employee_user" action="internal_job_position_tree_form"/> -->
</odoo>