<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="internal_recruitment_eligible_employees_search_view" model="ir.ui.view">
        <field name="name">internal.recruitment.eligible.employees.search</field>
        <field name="model">internal.recruitment.eligible.employees</field>
        <field name="arch" type="xml">
            <search string="Search Eligible Employees">
                <field name="emp_name" string="Employee Name"/>
                <field name="emp_grade" string="Grade"/>
                <field name="emp_position" string="Position"/>
                <field name="current_work_unit" string="Work Unit / Location"/>
                <field name="current_department" string="Department"/>
                <separator/>
                <filter string="Selected" name="filter_selected" domain="[('select_flag', '=', True)]"/>
                <filter string="Not Selected" name="filter_unselected" domain="[('select_flag', '=', False)]"/>
                <group name="group_by">
                    <filter string="Selection Status" name="group_select" context="{'group_by': 'select_flag'}"/>
                    <filter string="Grade" name="group_grade" context="{'group_by': 'emp_grade'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'current_work_unit'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_internal_recruitment_eligible_employees" model="ir.actions.act_window">
        <field name="name">Internal Recruitment Eligible Employees</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">internal.recruitment.eligible.employees</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="internal_recruitment_eligible_employees_search_view"/>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create!!</p>
        </field>
    </record>

    <record id="internal_recruitment_eligible_employees_tree_view" model="ir.ui.view">
        <field name="name">internal.recruitment.eligible.employees.tree</field>
        <field name="model">internal.recruitment.eligible.employees</field>
        <field name="arch" type="xml">
            <list string="Internal Recruitment Eligible Employees" editable="top" limit="500" multi_edit="1">
                    <field name="emp_name"/>
                    <field name="select_flag"/>
                    <field name="app_date"/>
					<field name="emp_grade"/>
                    <field name="emp_position"/>
                    <field name="emp_category"/>
                    <field name="emp_type"/>
                    <field name="emp_gender"/>
                    <field name="current_work_unit"/>
					<field name="educational_qualification"/>
                    <field name="service_in_company"/>
                    <field name="relevant_experience"/>
                    <field name="employment_experience"/>
                    <field name="total_experience"/>
                    <field name="current_location_exp"/>
                    <field name="current_position_exp"/>
                    <field name="supervisory_experience"/>
                    <field name="last_promotion"/>
                    <field name="pms_score"/>
                    <field name="recommendation"/>
                    <field name="preferred_location"/>
                    <field name="written_warning"/>
                    <field name="demoted"/>
            </list>
        </field>
    </record>

