<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Action for External Recruitment Selected Candidates -->
    <record id="action_external_recruitment_selected_candidats" model="ir.actions.act_window">
        <field name="name">External Recruitment Selected Candidates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">external.recruitment.selected.candidates</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create External Selected Candidate Record!</p>
        </field>
    </record>

    <record id="exter_recruit_select_tree_view" model="ir.ui.view">
        <field name="name">external.recruitment.selected.candidates.tree</field>
        <field name="model">external.recruitment.selected.candidates</field>
        <field name="arch" type="xml">
            <list string="External Recruitment Selected Candidates" editable="bottom" delete="0">
                <field name="applicant_name"/>
                <field name="select_flag"/>
                <field name="applicant_email"/>
                <field name="preferred_location"/>
                <field name="written_exam_score"/>
                <field name="interview_score"/>
                <field name="weighted_score"/>
                <field name="selection_type"/>
                <field name="remarks"/>
            </list>
        </field>
    </record>

    <!-- Action for External Recruitment Process Selected -->
    <record id="action_external_recruitment_selected" model="ir.actions.act_window">
        <field name="name">External Recruitment Process Selected</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">external.recruitment.selected</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[('vacancy_reference', 'ilike', 'EXT')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create External Recruitment Selection Process!</p>
        </field>
    </record>

    <record id="external_recruitment_selected_tree_view" model="ir.ui.view">
        <field name="name">external.recruitment.selected.tree</field>
        <field name="model">external.recruitment.selected</field>
        <field name="arch" type="xml">
            <list string="External Recruitment Selected Candidates" delete="0">
                <field name="vacancy_reference"/>
                <field name="job_position"/>
                <field name="vacancy_announced_on"/>
                <field name="no_of_vacancies"/>
            </list>
        </field>
    </record>

    <record id="external_recruitment_selected_form_view" model="ir.ui.view">
        <field name="name">external.recruitment.selected.form</field>
        <field name="model">external.recruitment.selected</field>
        <field name="arch" type="xml">
            <form string="External Recruitment Selected Candidates" delete="0">
                <header>
                    <!-- Step 1: Written Exam Phase -->
                    <button name="notify_written_exam" invisible="exam_scheduled == 'Yes'" string="Notify Written Exam" type="object" class="btn-primary" icon="fa-paper-plane"/>
                    <button name="fetch_exam_score" invisible="exam_scores_fetched == True or exam_scheduled != 'Yes'" string="Fetch Exam Score" type="object" class="btn-secondary" icon="fa-file-text-o"/>

                    <!-- Step 2: Interview Phase -->
                    <button name="notify_interview_panel" invisible="panel_notified == True" string="Notify Interview Panel" type="object" class="btn-secondary" icon="fa-users"/>
                    <button name="action_open_reschedule_wizard" string="Reschedule Interview" type="object" class="btn-warning" icon="fa-clock-o" invisible="not show_reschedule_button"/>
                    <button name="notify_interview" invisible="interview_scheduled == 'Yes'" string="Notify Interview" type="object" class="btn-secondary" icon="fa-calendar"/>
                    <button name="fetch_interview_score" invisible="interview_scores_fetched == True or interview_scheduled != 'Yes'" string="Fetch Interview Score" type="object" class="btn-secondary" icon="fa-list-ol"/>

                    <!-- Step 3: Scoring & Ranking Phase -->
                    <button name="compute_weighted_score" invisible="scores_computed == True" string="Compute &amp; Rank Scores" type="object" class="btn-primary" icon="fa-calculator"/>

                    <!-- Step 4: Minute & Approval Phase -->
                    <button name="action_generate_minute" string="Generate Minute" type="object" class="btn-secondary" icon="fa-file-text-o"/>
                    <button name="action_open_digital_minute" string="Digital Selection Minute" type="object" class="btn-primary" icon="fa-pencil-square-o" help="Open or create the digital committee selection minute for digital signatures."/>

                    <!-- Step 5: Final Selection Notification -->
                    <button name="notify_selection" invisible="selection_notified == True" string="Notify Selection" type="object" class="btn-success" style="background-color: #4A2E1A; border-color: #4A2E1A; color: #ffffff;" icon="fa-trophy"/>
                    <field name="state" widget="statusbar" statusbar_visible="notify_approver,evaluate,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-users">
                            <field name="total_candidates_count" string="Applicants" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-check-circle" style="color: #4A2E1A;">
                            <field name="selected_candidates_count" string="Selected" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-clock-o" style="color: #e0a800;">
                            <field name="reserve_candidates_count" string="Reserve Pool" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-times-circle" style="color: #dc3545;">
                            <field name="disqualified_candidates_count" string="Disqualified" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="vacancy_reference" string="Vacancy Reference"/>
                        <h1>
                            <field name="vacancy_reference" placeholder="e.g. BB/EXT/26-27/00001" readonly="scores_computed == True"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Vacancy &amp; Evaluation Setup">
                            <field name="recruitment_reference" readonly="scores_computed == True"/>
                            <field name="job_position" readonly="scores_computed == True"/>
                            <field name="no_of_vacancies" readonly="scores_computed == True"/>
                            <field name="vacancy_announced_on" readonly="scores_computed == True"/>
                            <field name="written_exam_weight" widget="float" readonly="scores_computed == True"/>
                            <field name="interview_weight" widget="float" readonly="scores_computed == True"/>
                        </group>
                        <group string="Exam &amp; Interview Schedules">
                            <field name="written_exam_date" readonly="scores_computed == True"/>
                            <field name="exam_location" readonly="scores_computed == True"/>
                            <field name="exam_scheduled" widget="badge" decoration-success="exam_scheduled == 'Yes'" decoration-muted="exam_scheduled == 'No'"/>
                            <field name="interview_date" widget="datetime" readonly="scores_computed == True"/>
                            <field name="interview_location" readonly="scores_computed == True"/>
                            <field name="interview_scheduled" widget="badge" decoration-success="interview_scheduled == 'Yes'" decoration-muted="interview_scheduled == 'No'"/>
                        </group>
                    </group>

                    <!-- Consolidated Single Notebook Container -->
                    <notebook>
                        <page string="Eligible Applicants">
                            <field name="ext_rec_sel" readonly="scores_computed == True">
                                <list string="Eligible Applicants" editable="bottom" delete="0"
                                      decoration-success="selection_type == 'selected'"
                                      decoration-warning="selection_type == 'reserved'"
                                      decoration-danger="selection_type == 'rejected'">
                                    <field name="applicant_name" readonly="parent.exam_scores_fetched == True or parent.scores_computed == True"/>
                                    <field name="select_flag" readonly="parent.scores_computed == True"/>
                                    <field name="applicant_email" readonly="parent.scores_computed == True"/>
                                    <field name="preferred_location" readonly="parent.scores_computed == True"/>
                                    <field name="written_exam_score" widget="float" readonly="parent.exam_scores_fetched == True or parent.scores_computed == True"/>
                                    <field name="interview_score" widget="float" readonly="parent.interview_scores_fetched == True or parent.scores_computed == True"/>
                                    <field name="weighted_score" widget="float" bold="1" readonly="1"/>
                                    <field name="selection_type" readonly="parent.scores_computed == True"/>
                                    <field name="remarks" readonly="parent.scores_computed == True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Panel Members">
                            <field name="ext_rec_panel">
                                <list string="Panel Members" editable="bottom" delete="0">
                                    <field name="emp_name"/>
                                    <field name="selection_criteria"/>
                                    <field name="accepted"/>
                                    <field name="response_status"
                                           decoration-info="response_status == 'pending'"
                                           decoration-success="response_status == 'accepted'"
                                           decoration-danger="response_status == 'unavailable'"
                                           decoration-warning="response_status in ['reschedule_requested', 'delegation_requested']"/>
                                    <field name="delegate_employee_id" column_invisible="not parent.has_delegation_requests" optional="show"/>
                                    <field name="delegation_state" column_invisible="not parent.has_delegation_requests" optional="show"
                                           decoration-warning="delegation_state == 'pending_hr'"
                                           decoration-success="delegation_state == 'approved'"
                                           decoration-danger="delegation_state == 'rejected'"/>
                                    <field name="response_reason" optional="show"/>
                                    <button name="action_open_response_wizard" string="Respond" type="object" class="btn-sm btn-secondary" invisible="response_status != 'pending'"/>
                                    <button name="action_approve_delegation" string="Approve Delegation" type="object" class="btn-sm btn-success" invisible="delegation_state != 'pending_hr'"/>
                                    <button name="action_reject_delegation" string="Reject Delegation" type="object" class="btn-sm btn-danger" invisible="delegation_state != 'pending_hr'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval Committee Members">
                            <field name="recr_exter_selected_team_id">
                                <list string="Approval Members" editable="bottom" delete="0">
                                    <field name="role" width="20%"/>
                                    <field name="employee_name" width="20%"/>
                                    <field name="operating_unit" width="20%"/>
                                    <field name="status" width="20%"/>
                                    <field name="alternate_committee_member" width="20%"/>
                                    <field name="alter_operating_unit" width="20%"/>
                                    <field name="approve" width="20%"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>