<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="action_recruitment_skill" model="ir.actions.act_window">
        <field name="name">Recruitment Skills</field>
        <field name="res_model">recruitment.skill</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the skills you want to use for candidate suggestions and matching.</p>
        </field>
    </record>

    <record id="recruitment_skill_tree_view" model="ir.ui.view">
        <field name="name">recruitment.skill.list</field>
        <field name="model">recruitment.skill</field>
        <field name="arch" type="xml">
            <list string="Recruitment Skills">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="recruitment_skill_form_view" model="ir.ui.view">
        <field name="name">recruitment.skill.form</field>
        <field name="model">recruitment.skill</field>
        <field name="arch" type="xml">
            <form string="Recruitment Skill">
                <sheet>
                    <group>
                        <field name="name" placeholder="Type skill name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_recruitment_certification" model="ir.actions.act_window">
        <field name="name">Recruitment Certifications</field>
        <field name="res_model">recruitment.certification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the certifications you want to use for candidate suggestions and matching.</p>
        </field>
    </record>

    <record id="recruitment_certification_tree_view" model="ir.ui.view">
        <field name="name">recruitment.certification.list</field>
        <field name="model">recruitment.certification</field>
        <field name="arch" type="xml">
            <list string="Recruitment Certifications">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="recruitment_certification_form_view" model="ir.ui.view">
        <field name="name">recruitment.certification.form</field>
        <field name="model">recruitment.certification</field>
        <field name="arch" type="xml">
            <form string="Recruitment Certification">
                <sheet>
                    <group>
                        <field name="name" placeholder="Type certification name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
