<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Probation Criteria (lookup) ───────────────────────────────── -->
    <record id="action_emp_probation_criteria" model="ir.actions.act_window">
        <field name="name">Probation Criteria</field>
        <field name="res_model">emp.probation.criteria</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="emp_probation_criteria_tree" model="ir.ui.view">
        <field name="name">emp.probation.criteria.list</field>
        <field name="model">emp.probation.criteria</field>
        <field name="arch" type="xml">
            <list string="Probation Criteria" editable="bottom">
                <field name="emp_evaluation_criteria"/>
                <field name="coefficient"/>
            </list>
        </field>
    </record>

    <!-- ── Probation Assessment Form ─────────────────────────────────── -->
    <record id="action_probation_assessment_form" model="ir.actions.act_window">
        <field name="name">Probation Assessment Form</field>
        <field name="res_model">probation.assessment.form</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="probation_assessment_form_tree" model="ir.ui.view">
        <field name="name">probation.assessment.form.list</field>
        <field name="model">probation.assessment.form</field>
        <field name="arch" type="xml">
            <list string="Probation Assessment Forms">
                <field name="prob_sequence"/>
                <field name="name_of_probationer"/>
                <field name="position_title"/>
                <field name="place_of_assessment"/>
                <field name="employment_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="probation_assessment_form_view" model="ir.ui.view">
        <field name="name">probation.assessment.form.form</field>
        <field name="model">probation.assessment.form</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,notify,evaluate,confirm_permenancy,inform_in_charge"/>
                    <button name="notify_deligation" string="Notify HR" type="object"
                            class="oe_highlight"
                            invisible="state in ('notify','evaluate','confirm_permenancy','reject','terminate_contract','inform_in_charge')"/>
                    <button name="assess_evaluate" string="Evaluate" type="object"
                            class="oe_highlight"
                            invisible="state in ('draft','evaluate','confirm_permenancy','reject','terminate_contract','inform_in_charge')"/>
                    <button name="confirm_permenancy" string="Confirm Permanency" type="object"
                            class="oe_highlight"
                            invisible="state in ('draft','notify','confirm_permenancy','reject','terminate_contract','inform_in_charge')"/>
                    <button name="reject" string="Reject" type="object"
                            invisible="state in ('draft','notify','confirm_permenancy','reject','terminate_contract','inform_in_charge')"/>
                    <button name="terminate_contract" string="Terminate Contract" type="object"
                            invisible="state in ('draft','notify','evaluate','confirm_permenancy','terminate_contract','inform_in_charge')"/>
                    <button name="inform_in_charge" string="Inform TDD" type="object"
                            class="oe_highlight"
                            invisible="state in ('draft','notify','inform_in_charge')"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="prob_sequence" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name_of_probationer"/>
                            <field name="position_title"/>
                            <field name="place_of_assessment"/>
                            <field name="employment_date"/>
                            <field name="evaluation_period" readonly="1"/>
                            <field name="total"/>
                            <field name="status" invisible="1"/>
                        </group>
                        <group>
                            <field name="in_charge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evaluation Criteria">
                            <field name="pro_assess_form">
                                <list editable="bottom">
                                    <field name="evaluation_criteria"/>
                                    <field name="rating"/>
                                    <field name="coefficient"/>
                                    <field name="score"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval Team">
                            <field name="emp_prob_delig_team_id">
                                <list editable="bottom">
                                    <field name="employee_name"/>
                                    <field name="operating_unit"/>
                                    <field name="status"/>
                                    <field name="alternate_committee_member"/>
                                    <field name="alter_operating_unit"/>
                                    <field name="approve"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="assessment_comments" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Menu items ─────────────────────────────────────────────────── -->
    <menuitem id="menu_probation_root"
              name="Probation"
              parent="new_recruitment_menu"
              sequence="60"/>

    <menuitem id="menu_probation_assessment_form"
              name="Probation Assessment"
              parent="menu_probation_root"
              action="action_probation_assessment_form"
              sequence="1"/>

    <menuitem id="menu_probation_criteria"
              name="Probation Criteria"
              parent="menu_probation_root"
              action="action_emp_probation_criteria"
              sequence="2"/>
</odoo>
