<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Probation Criteria Master (Lookup Configuration) ──────────── -->
    <record id="action_emp_probation_criteria" model="ir.actions.act_window">
        <field name="name">Probation Evaluation Criteria</field>
        <field name="res_model">emp.probation.criteria</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define evaluation criteria and weighting coefficients!</p>
            <p>Configure evaluation criteria (e.g. Job Knowledge, Quality of Work, Attendance, Initiative) along with their respective score weighting coefficients used in Employee Probation Management.</p>
        </field>
    </record>

    <record id="emp_probation_criteria_tree" model="ir.ui.view">
        <field name="name">emp.probation.criteria.list</field>
        <field name="model">emp.probation.criteria</field>
        <field name="arch" type="xml">
            <list string="Probation Evaluation Criteria" editable="bottom">
                <field name="emp_evaluation_criteria"/>
                <field name="coefficient"/>
            </list>
        </field>
    </record>

    <!-- ── Configuration Menu ─────────────────────────────────────────── -->
    <menuitem id="menu_probation_criteria"
              name="Probation Evaluation Criteria"
              parent="hr_recruitment.menu_hr_recruitment_configuration"
              action="action_emp_probation_criteria"
              groups="group_recruitment_manager,group_recruitment_administrator"
              sequence="85"/>
</odoo>
