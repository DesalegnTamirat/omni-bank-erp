<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="blacklist_pool_tree" model="ir.ui.view">
        <field name="name">blacklist.pool.list</field>
        <field name="model">blacklist.pool</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="1" delete="1" multi_edit="1" string="Blacklist Pool">
                <header>
                    <button name="action_open_import_wizard" string="📤 Import Blacklist Excel/CSV" type="object" class="btn-primary"/>
                </header>
                <field name="candidate"/>
                <field name="national_id"/>
                <field name="gender"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="reason"/>
                <field name="blacklisted_date"/>
            </list>
        </field>
    </record>

    <record id="blacklist_pool_form_tree" model="ir.actions.act_window">
        <field name="name">Blacklist Pool</field>
        <field name="res_model">blacklist.pool</field>
        <field name="context">{}</field>
        <field name="view_mode">list</field>
    </record>
</odoo>