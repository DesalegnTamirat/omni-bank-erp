<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="recruitment_experience_tree" model="ir.ui.view">
        <field name="name">recruitment.experience.form</field>
        <field name="model">recruitment.experience</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="1" delete="1" multi_edit="1" string="Recruitment Experiences">
