    </record>
        <record id="recruitment_experience_form_tree" model="ir.actions.act_window">
        <field name="name">Recruitment Experiences</field>
        <field name="res_model">recruitment.experience</field>
        <field name="context">{}</field>
        <field name="view_mode">list</field>
    </record>



</odoo>