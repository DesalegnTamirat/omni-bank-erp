<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View -->
        <record id="ats_news_view_form" model="ir.ui.view">
            <field name="name">ats.news.form</field>
            <field name="model">ats.news</field>
            <field name="arch" type="xml">
                <form string="Recruitment News &amp; Announcement">
                    <header>
                        <button name="action_publish" string="Publish" type="object" class="btn-primary" invisible="state == 'published'"/>
                        <button name="action_set_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                        <button name="action_expire" string="Expire Post" type="object" invisible="state == 'expired'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,published,expired"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Featured" bg_color="text-bg-warning" invisible="not is_featured"/>
                        <div class="oe_title">
                            <label for="name" string="Post Title"/>
                            <h1>
                                <field name="name" placeholder="e.g., Bunna Bank Launches 2026 Management Trainee Recruitment"/>
                            </h1>
                        </div>
                        <group col="2">
                            <group string="Publishing Options">
                                <field name="post_type"/>
                                <field name="is_featured" widget="boolean_toggle"/>
                                <field name="author_id"/>
                            </group>
                            <group string="Dates &amp; Schedule">
                                <field name="publish_date"/>
                                <field name="expiry_date"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group string="Short Summary">
                            <field name="summary" placeholder="Brief intro to appear on news banners..." nolabel="1"/>
                        </group>
                        <notebook>
                            <page string="Article Content" name="content_page">
                                <field name="content" placeholder="Full announcement text..." widget="html"/>
                            </page>
                            <page string="Featured Image" name="image_page">
                                <field name="image" widget="image" class="oe_avatar"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="ats_news_view_tree" model="ir.ui.view">
            <field name="name">ats.news.list</field>
            <field name="model">ats.news</field>
            <field name="arch" type="xml">
                <list string="Recruitment News &amp; Posts">
                    <field name="name"/>
                    <field name="post_type"/>
                    <field name="publish_date"/>
                    <field name="expiry_date"/>
                    <field name="is_featured" widget="boolean_toggle"/>
                    <field name="state" widget="badge" decoration-success="state == 'published'" decoration-muted="state == 'draft'" decoration-danger="state == 'expired'"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="ats_news_view_search" model="ir.ui.view">
            <field name="name">ats.news.search</field>
            <field name="model">ats.news</field>
            <field name="arch" type="xml">
                <search string="Search News &amp; Posts">
                    <field name="name"/>
                    <field name="post_type"/>
                    <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                    <filter name="featured" string="Featured Posts" domain="[('is_featured', '=', True)]"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_ats_news" model="ir.actions.act_window">
            <field name="name">News &amp; Recruitment Posts</field>
            <field name="res_model">ats.news</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Recruitment News or Vacancy Announcement post.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_ats_news"
                  name="News &amp; Posts"
                  parent="menu_external_recruitment"
                  action="action_ats_news"
                  sequence="35"
                  groups="group_recruitment_officer,group_recruitment_manager,group_recruitment_administrator"/>

    </data>
</odoo>
