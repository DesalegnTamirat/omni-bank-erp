<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ================================================================ -->
    <!-- Employee Transfer Request – List View                             -->
    <!-- ================================================================ -->
    <record id="employee_transfer_request_list_view" model="ir.ui.view">
        <field name="name">employee.transfer.request.list</field>
        <field name="model">employee.transfer.request</field>
        <field name="arch" type="xml">
            <list string="Employee Transfer Requests"
                  decoration-danger="eligibility_status == 'ineligible'"
                  decoration-success="eligibility_status == 'eligible'"
                  decoration-muted="state in ('withdrawn','rejected','refused')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="current_job_grade_id"/>
                <field name="current_job_position_id"/>
                <field name="current_operating_unit_id"/>
                <field name="target_vacancy_id"/>
                <field name="target_job_grade_id"/>
                <field name="request_date"/>
                <field name="disciplinary_status"/>
                <field name="eligibility_status" widget="badge"
                       decoration-success="eligibility_status == 'eligible'"
                       decoration-danger="eligibility_status == 'ineligible'"/>
                <field name="transfer_suitability_score"/>
                <field name="is_exchange_transfer" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state in ('rejected','refused')"
                       decoration-warning="state == 'withdrawn'"
                       decoration-info="state in ('submitted','under_review')"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Employee Transfer Request – Search View                           -->
    <!-- ================================================================ -->
    <record id="employee_transfer_request_search_view" model="ir.ui.view">
        <field name="name">employee.transfer.request.search</field>
        <field name="model">employee.transfer.request</field>
        <field name="arch" type="xml">
            <search string="Search Transfer Requests">
                <field name="name" string="Reference"/>
                <field name="employee_id"/>
                <field name="target_vacancy_id"/>
                <field name="current_operating_unit_id" string="Current Branch"/>
                <field name="target_operating_unit_id" string="Target Branch"/>
                <field name="current_job_grade_id" string="Job Grade"/>
                <separator/>
                <filter name="filter_eligible" string="Eligible" domain="[('eligibility_status','=','eligible')]"/>
                <filter name="filter_ineligible" string="Ineligible" domain="[('eligibility_status','=','ineligible')]"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="filter_under_review" string="Under Review" domain="[('state','=','under_review')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <filter name="filter_withdrawn" string="Withdrawn" domain="[('state','=','withdrawn')]"/>
                <filter name="filter_refused" string="Refused by Employee" domain="[('state','=','refused')]"/>
                <separator/>
                <filter name="filter_exchange" string="Exchange Transfers" domain="[('is_exchange_transfer','=',True)]"/>
                <filter name="filter_flagged_hr" string="Flagged for HR" domain="[('is_flagged_for_hr','=',True)]"/>
                <separator/>
                <group name="group_by">
                    <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_grade" string="Job Grade" context="{'group_by': 'current_job_grade_id'}"/>
                    <filter name="group_by_target_ou" string="Target Branch" context="{'group_by': 'target_operating_unit_id'}"/>
                    <filter name="group_by_request_date" string="Request Date" context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Employee Transfer Request – Form View                             -->
    <!-- ================================================================ -->
    <record id="employee_transfer_request_form_view" model="ir.ui.view">
        <field name="name">employee.transfer.request.form</field>
        <field name="model">employee.transfer.request</field>
        <field name="arch" type="xml">
            <form string="Employee Transfer Request">
                <header>
                    <button name="action_submit" string="Submit Request" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start_review" string="Start Review" type="object"
                            class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="state != 'under_review'"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ('submitted', 'under_review')"/>
                    <button name="action_withdraw" string="Withdraw" type="object"
                            invisible="state not in ('draft', 'submitted', 'under_review')"/>
                    <button name="action_refuse_transfer" string="Refuse Transfer" type="object"
                            invisible="state != 'approved'"
                            confirm="Are you sure you wish to refuse this approved transfer? A 12-month ineligibility penalty will be applied and HR will be notified."/>
                    <!-- : Mutual Exchange Matching -->
                    <button name="action_find_exchange_matches" string="Find Exchange Match" type="object"
                            class="btn btn-secondary"
                            invisible="state not in ('submitted', 'under_review')"
                            help="Search for a mutual exchange transfer partner "/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Eligibility Alert Banner -->
                    <div class="alert alert-danger" role="alert"
                         invisible="eligibility_status != 'ineligible'">
                        <strong>⚠ Eligibility Issues:</strong>
                        <field name="ineligibility_reason" readonly="1"/>
                    </div>

                    <!-- Refusal Penalty Alert -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not ineligible_until_date">
                        <strong>⛔ Transfer Ineligibility Penalty:</strong>
                        This employee is ineligible to apply for transfers until
                        <field name="ineligible_until_date" readonly="1" class="oe_inline"/>.
                    </div>

                    <!-- Exchange Transfer Info Banner -->
                    <div class="alert alert-info" role="alert"
                         invisible="not is_exchange_transfer">
                        <strong>🔄 Mutual Exchange Transfer:</strong>
                        This request is part of a mutual exchange transfer arrangement /.
                    </div>

                    <group>
                        <!-- Left: Requesting Employee -->
                        <group string="Requesting Employee">
                            <field name="employee_id" readonly="1"/>
                            <field name="request_date" readonly="state != 'draft'"/>
                            <field name="current_job_position_id" readonly="1"/>
                            <field name="current_job_grade_id" readonly="1"/>
                            <field name="current_operating_unit_id" readonly="1"/>
                        </group>
                        <!-- Right: Service Dates & Eligibility -->
                        <group string="Service Tenure">
                            <field name="date_in_current_position" readonly="state != 'draft'"/>
                            <field name="date_in_current_location" readonly="state != 'draft'"/>
                            <field name="service_years_current_position" readonly="1"
                                   decoration-danger="service_years_current_position &lt; 1"/>
                            <field name="service_years_current_location" readonly="1"
                                   decoration-danger="service_years_current_location &lt; 1"/>
                            <field name="total_experience_years" readonly="1"/>
                            <field name="service_rule_ok" readonly="1" widget="boolean"/>
                        </group>
                    </group>

                    <group>
                        <!-- Left: Target Vacancy -->
                        <group string="Target Vacancy">
                            <field name="target_vacancy_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="target_job_position_id" readonly="1"/>
                            <field name="target_job_grade_id" readonly="1"/>
                            <field name="target_operating_unit_id" readonly="1"/>
                            <field name="grade_restriction_ok" readonly="1" widget="boolean"
                                   decoration-danger="not grade_restriction_ok"/>
                            <field name="eligibility_status" readonly="1" widget="badge"
                                   decoration-success="eligibility_status == 'eligible'"
                                   decoration-danger="eligibility_status == 'ineligible'"/>
                        </group>
                        <!-- Right: PMS & Ranking Inputs -->
                        <group string="Ranking Inputs ">
                            <field name="pms_score" readonly="state != 'draft'"
                                   decoration-danger="pms_score &lt; 75"
                                   help="Minimum 75.0% required for transfer eligibility"/>
                            <field name="total_experience_years" readonly="state != 'draft'"/>
                            <field name="supervisor_recommendation_score" readonly="state != 'draft'"
                                   help="Score from 0 to 100 given by the immediate supervisor (weighted 10% in final score)."/>
                            <field name="transfer_suitability_score" readonly="1"/>
                        </group>
                    </group>

                    <!-- Discipline Section -->
                    <group string="Disciplinary Status">
                        <group>
                            <field name="disciplinary_status" readonly="state != 'draft'"/>
                            <field name="discipline_deduction_percent" readonly="1"
                                   invisible="disciplinary_status == 'none'"/>
                        </group>
                        <group>
                            <field name="is_exchange_transfer" readonly="state != 'draft'"/>
                            <field name="exchange_partner_employee_id"
                                   invisible="not is_exchange_transfer"
                                   readonly="state != 'draft'"/>
                            <field name="exchange_partner_request_id"
                                   invisible="not is_exchange_transfer"
                                   readonly="1"/>
                            <field name="exchange_partner_disciplinary_status"
                                   invisible="not is_exchange_transfer"
                                   readonly="state != 'draft'"/>
                            <field name="exchange_transfer_ok" readonly="1"
                                   invisible="not is_exchange_transfer" widget="boolean"/>
                        </group>
                    </group>

                    <!-- Refusal Section (only visible when refused) -->
                    <group string="Refusal Details" invisible="state != 'refused'">
                        <group>
                            <field name="refusal_reason"
                                   readonly="state == 'refused'"
                                   placeholder="Enter reason for refusing the transfer..."/>
                            <field name="ineligible_until_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="is_flagged_for_hr" readonly="1"/>
                            <field name="hr_notified_on_refusal" readonly="1"/>
                        </group>
                    </group>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Action                                                            -->
    <!-- ================================================================ -->
    <record id="action_employee_transfer_request" model="ir.actions.act_window">
        <field name="name">Employee Transfer Requests</field>
        <field name="res_model">employee.transfer.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="employee_transfer_request_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Transfer Request!</p>
            <p>Employees can initiate transfer requests here. The system enforces eligibility rules
               including grade matching, minimum service tenure, PMS score thresholds, and discipline checks
               in accordance with the ERP BRD requirements
            </p>
        </field>
    </record>
</odoo>
