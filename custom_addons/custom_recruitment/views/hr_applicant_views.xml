<?xml version='1.0' encoding='UTF-8'?>

<odoo>
    <data>

        <record id="hr_applicant_new_line_view_form" model="ir.ui.view">
            <field name="name">hr.applicant.form.view</field>
            <field name="model">hr.applicant</field>
            <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
            <field name="arch" type="xml">
                <button name="archive_applicant" position="before">
                    <button name="create_contract" invisible="((application_type == 'Internal' or contract_created_new == True) or bunna_app_status == 'rejected')" string="Create Contract" type="object" class="oe_highlight"/>
                    <button name="promote_employee" string="Promote Employee" invisible="((application_type in 'External' or bunna_app_status == 'rejected') or prmt_emp in 'Yes')" type="object" class="oe_highlight"/>
                    <button name="action_applicant_send" invisible="application_type == 'Internal' or offer_letter_sent == True" string="Send Offer Letter" type="object" class="oe_highlight"/>
                    <button name="action_download_cv" string="Download CV" type="object" class="btn-secondary" icon="fa-download"/>
                </button>
                <xpath expr="//field[@name='email_from']" position="before">
                    <field name="candidate_score_id"/>
                    <field name="cv_attachment_id" readonly="1"/>
                    <field name="app_reference"/>
                    <!-- Cascaded from app_reference — locked once a vacancy
                         is selected, since these are derived values, not
                         independently editable fields. -->
                    <field name="application_type" readonly="app_reference != False"/>
                </xpath>
                <xpath expr="//form/sheet/group[1]" position="inside">
                    <group>
                        <field name="functions" invisible="1"/>
                        <field name="date_of_birth"/>
                        <field name="age"/>
                        <field name="place_of_birth"/>
                        <field name="gender"/>
                        <field name="worked_in_bunna_earlier"/>
                        <field name="current_company"/>
                        <field name="current_working_location"/>
                        <field name="working_status"/>
                        <field name="willing_to_join_immediately"/>
                        <field name="contract_created_new" invisible="1"/>
                        <field name="date_of_availability"/>
                        <field name="bunna_app_status"/>
                        <field name="prmt_emp" invisible="1"/>
                    </group>
                    <group>
                        <field name="internal_employee_id"/>
                        <field name="employee_work_unit"/>
                        <field name="employee_number"/>
                        <!-- job_grade_id removed — duplicated employee_grade below -->
                        <field name="employee_grade"/>
                        <field name="employee_position"/>
                        <field name="manager"/>
                        <field name="active_leave_status" string="Leave Status" readonly="1"
                               invisible="application_type != 'Internal'"/>
                        <field name="active_disciplinary_status" string="Discipline Warning Level" readonly="1"
                               invisible="application_type != 'Internal'"/>
                        <field name="promotion_date"/>
                        <field name="employment_start_date"/>
                        <field name="final_work_unit"/>
                        <!-- Both cascaded from app_reference — readonly once set -->
                        <field name="preferred_location" readonly="app_reference != False"/>
                        <field name="vacancy_reference" readonly="app_reference != False"/>
                        <field name="cc_workunits" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="job_offer_status"/>
                        <field name="rejection_reason"/>
                    </group>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="Education Qualification">
                        <field name="qualification_id">
                            <list editable="bottom">
                                <field name="qualification"/>
                                <field name="requirement"/>
                                <field name="response"/>
                            </list>
                        </field>
                    </page>
                    <page string="Experience">
                        <field name="experiance_id">
                            <list editable="bottom">
                                <field name="experience"/>
                                <field name="requirement"/>
                                <field name="response"/>
                            </list>
                        </field>
                    </page>
                    <page string="Competencies ">
                        <field name="competencies_id">
                            <list editable="bottom">
                                <field name="competencies"/>
                                <field name="requirement"/>
                                <field name="response"/>
                            </list>
                        </field>
                    </page>
                    <page string="Vacancies">
                        <field name="hr_new_department_ids">
                            <list editable="bottom">
                                <field name="work_unit"/>
                                <field name="number_of_vacancies"/>
                                <field name="response"/>
                            </list>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//form//sheet//field[@name='user_id']" position="replace">
                    <field name="user_id"/>
                    <field name="functions" invisible="1"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>