<?xml version='1.0' encoding='UTF-8'?>
<!--This XML file does not appear to have any style information associated with it. The document tree is shown below.--><odoo>
    <template id="portal_my_home_menu_bids" name="Portal layout : invoice menu entries" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'bid'" t-attf-class="breadcrumb-item #{'active ' if not job else ''}">
                <a t-if="job" t-attf-href="/my/job-acceptance?{{ keep_query }}">Job Acceptance</a>
                <t t-else="">Job</t>
            </li>
        </xpath>
    </template>
    <template id="portal_my_home_bid" name="Portal My Home : fee entries" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Job Acceptance</t>
                <t t-set="url" t-value="'/my/job-acceptance'"/>
            </t>
        </xpath>
    </template>
    <template id="job_acceptance_form" name="Job Acceptance">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Job Acceptance</t>
            </t>
            <div id="wrap">
                <div class="row">
                    <div class="col-lg-12 text-left mb16">
                        <table>
                            <tr>
                                <td>Applicant Name:</td>
                                <th style="color:#B8860B">
                                    <span t-field="data[0].partner_name"/>
                                </th>
                            </tr>
                            <tr>
                                <td>Applied For:</td>
                                <th style="color:#B8860B">
                                    <span t-field="data[0].job_id"/>
                                </th>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="oe_structure">
                    <div class="container">
                        <form role="form" action="/submit/job_acceptance_status" method="POST" enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token"/>
                            <input type="hidden" name="partner_name" t-att-value="data[0].partner_name"/>
                            <input type="hidden" name="job_id" t-att-value="data[0].job_id"/>
                            <div class="form-group">
                                <label for="partner_name" class="control-label">Applicant Name</label>
                                <select class="form-control" name="partner_name">
                                    <t t-foreach="data" t-as="record">
                                        <option t-att-value="record.partner_name">
                                            <span t-field="record.partner_name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="job_id" class="control-label">Applied for</label>
                                <select class="form-control" name="job_id">
                                    <t t-foreach="data" t-as="record">
                                        <option t-att-value="record.job_id">
                                            <span t-field="record.job_id"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="job_offer_status" class="control-label">Job Accepatance Status</label><br/>
                                <input type="radio" id="job_offer_status" name="job_offer_status" value="Accepted"/>
                                <label for="job_offer_status">Accept</label>
                                <br/>
                                <input type="radio" id="job_offer_status" name="job_offer_status" value="Rejected"/>
                                <label for="job_offer_status">Reject</label>
                                <br/>
                            </div>
                            <div class="form-group">
                                <label for="rejection_reason" class="control-label">Rejection Reason</label>
                                <input type="text" name="rejection_reason" t-att-value="rejection_reason" id="rejection_reason" class="form-control"/>
                            </div>
                            <div class="clearfix oe_login_buttons">
                                <button type="job_acceptance_submit" class="btn btn-primary pull-left">Submit
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="job_application_response" name="Job Acceptance Response">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container">
                    <h1>Thanks!</h1>
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="alert alert-success" role="status">Response has been Submitted Successfully.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="internal_offer_response_page" name="Internal Promotion &amp; Transfer Response">
        <t t-call="website.layout">
            <div id="wrap" class="py-5 bg-light">
                <div class="container" style="max-width: 750px;">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header text-white p-4" style="background-color: #4A2E1A;">
                            <div class="d-flex align-items-center">
                                <img src="/logo.png" alt="Bunna Bank" style="max-height: 40px;" class="me-3 bg-white p-1 rounded"/>
                                <div>
                                    <h4 class="mb-0 text-white">Bunna Bank S.C.</h4>
                                    <small class="text-white-50">Official Promotion &amp; Transfer Acceptance Portal</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <t t-if="error">
                                <div class="alert alert-danger" role="alert">
                                    <i class="fa fa-exclamation-triangle me-2"></i><span t-esc="error"/>
                                </div>
                            </t>
                            <t t-elif="success">
                                <div class="alert alert-success p-4 text-center rounded-3" role="alert">
                                    <h3 class="alert-heading text-success mb-2">Response Recorded!</h3>
                                    <p class="mb-0 fs-5"><span t-esc="success"/></p>
                                </div>
                            </t>
                            <t t-else="">
                                <h5 class="fw-bold mb-3" style="color: #4A2E1A;">
                                    <i class="fa fa-file-text-o me-2"></i>Offer &amp; Selection Notice
                                </h5>
                                <div class="table-responsive mb-4">
                                    <table class="table table-bordered bg-white">
                                        <tbody>
                                            <tr>
                                                <th class="bg-light w-35">Employee Name:</th>
                                                <td><strong t-esc="candidate_name"/></td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">Target Position / Offer:</th>
                                                <td><strong t-esc="job_title"/></td>
                                            </tr>
                                            <tr t-if="work_unit">
                                                <th class="bg-light">Work Unit / Branch:</th>
                                                <td><span t-esc="work_unit"/></td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">Current Acceptance Status:</th>
                                                <td>
                                                    <span t-if="acceptance_status == 'accepted'" class="badge bg-success fs-6">Accepted</span>
                                                    <span t-elif="acceptance_status == 'rejected'" class="badge bg-danger fs-6">Declined</span>
                                                    <span t-else="" class="badge bg-warning text-dark fs-6">Pending Response</span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <t t-if="acceptance_status in ('accepted', 'rejected')">
                                    <div class="alert alert-info" role="alert">
                                        <i class="fa fa-info-circle me-2"></i>You have already responded to this offer (Status: <strong t-esc="acceptance_status.capitalize()"/>). No further changes can be submitted online.
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="card p-3 mb-4 border-warning bg-warning-subtle">
                                        <p class="mb-0 text-dark">
                                            <strong>Please indicate your decision regarding this offer:</strong><br/>
                                            Selecting <strong>Accept Offer</strong> will confirm your agreement to take on the position. Selecting <strong>Decline Offer</strong> will allow you to record your reasons for declining.
                                        </p>
                                    </div>

                                    <form role="form" t-att-action="submit_url" method="POST">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Select Decision:</label>
                                            <div class="d-flex gap-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="decision" id="decision_accept" value="accept" checked="checked" onclick="document.getElementById('reason_box').style.display='none';"/>
                                                    <label class="form-check-label fw-bold text-success fs-5" for="decision_accept">
                                                        <i class="fa fa-check-circle me-1"></i>Accept Offer
                                                    </label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="decision" id="decision_decline" value="decline" onclick="document.getElementById('reason_box').style.display='block';"/>
                                                    <label class="form-check-label fw-bold text-danger fs-5" for="decision_decline">
                                                        <i class="fa fa-times-circle me-1"></i>Decline Offer
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                        <div id="reason_box" class="mb-4" style="display: none;">
                                            <label for="reason" class="form-label fw-bold text-danger">Rejection / Decline Reason (Required if declining):</label>
                                            <textarea name="reason" id="reason" rows="3" class="form-control" placeholder="State your reason for declining this offer..."></textarea>
                                        </div>

                                        <div class="d-grid gap-2">
                                            <button type="submit" class="btn btn-lg text-white fw-bold" style="background-color: #4A2E1A;">
                                                <i class="fa fa-paper-plane me-2"></i>Submit Decision
                                            </button>
                                        </div>
                                    </form>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>