<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internal_selection_decline_wizard_form" model="ir.ui.view">
        <field name="name">internal.selection.decline.wizard.form</field>
        <field name="model">internal.selection.decline.wizard</field>
        <field name="arch" type="xml">
            <form string="Decline Promotion / Transfer Offer">
                <div class="alert alert-warning" role="alert">
                    <strong>⚠️ Declining Offer:</strong> You are about to record a decline/rejection response for this promotion or transfer offer. Please provide a reason below.
                </div>
                <group>
                    <field name="candidate_id" invisible="1"/>
                    <field name="transfer_request_id" invisible="1"/>
                    <field name="transfer_letter_id" invisible="1"/>
                    <field name="rejection_reason" placeholder="Please enter the reason for declining this offer..." required="1"/>
                </group>
                <footer>
                    <button string="Confirm Decline" name="action_confirm_decline" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_internal_selection_decline_wizard" model="ir.actions.act_window">
        <field name="name">Decline Promotion / Transfer Offer</field>
        <field name="res_model">internal.selection.decline.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
