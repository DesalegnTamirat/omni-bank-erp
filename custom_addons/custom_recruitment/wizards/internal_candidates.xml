<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="internal_candidates_form" model="ir.ui.view">
        <field name="name">Shortlist Internal Candidates Wizard</field>
        <field name="model">internal.candidates</field>
        <field name="arch" type="xml">
            <form string="Internal Candidates">

                    <group>
                       <field name="job_id"/>
<!--                        <field name="fuel_rate"/>-->
                    </group>


                <footer>
                    <button name="shortlist_internal_candidates" string="Shortlist Internal Candidates" type="object" class="btn btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_internal_candidates_wizard" model="ir.actions.act_window">
        <field name="name">Shortlist Internal Candidates Wizard</field>
        <field name="res_model">internal.candidates</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="internal_candidates_form"/>
        <field name="target">new</field>
    </record>

</odoo>