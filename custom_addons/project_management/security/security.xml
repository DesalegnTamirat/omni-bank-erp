<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Project Management Privilege Group (displayed under Services in User settings) -->
        <record id="res_groups_privilege_pm" model="res.groups.privilege">
            <field name="name">Project Management</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="sequence">10</field>
        </record>

        <!-- 1. Initiative Lead (Feedback Line 95: View all projects and non-projects) -->
        <record id="group_pm_audit" model="res.groups">
            <field name="name">Initiative Lead</field>
            <field name="privilege_id" ref="res_groups_privilege_pm"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Executive oversight: View all projects, non-projects, initiatives, dashboards, and reports.</field>
        </record>

        <!-- 2. Task Manager (Feedback Line 94: Manage assigned tasks on given projects, view involved projects, reporting, non-project tasks) -->
        <record id="group_pm_user" model="res.groups">
            <field name="name">Task Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_pm"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Manage assigned tasks on given projects, view involved projects, reporting, and manage non-project tasks.</field>
        </record>

        <!-- 3. Project Manager (Feedback Line 93: Manage everything except configuration on self-projects) -->
        <record id="group_pm_project_manager" model="res.groups">
            <field name="name">Project Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_pm"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('project_management.group_pm_user'))]"/>
            <field name="comment">Manage everything except configuration on self-projects; access to dashboards, reporting, tasks, project tasks on self-projects.</field>
        </record>

        <!-- 4. Admin (Feedback Line 92: Admin everything) -->
        <record id="group_pm_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_pm"/>
            <field name="sequence">40</field>
            <field name="implied_ids" eval="[(4, ref('project_management.group_pm_project_manager'))]"/>
            <field name="comment">Full administrator access across all initiatives, projects, documents, tasks, and configurations.</field>
        </record>
    </data>
</odoo>
