<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Project Management Privilege Group (displayed under Services in User settings) -->
        <record id="res_groups_privilege_pm" model="res.groups.privilege">
            <field name="name">Project Management</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="sequence">10</field>
        </record>

        <!-- 1. Audit (Read-Only Visibility Across Entire System) -->
        <record id="group_pm_audit" model="res.groups">
            <field name="name">Audit (Read Only)</field>
            <field name="privilege_id" ref="res_groups_privilege_pm"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Read-only visibility across all initiatives, projects, deliverables, milestones, tasks, and reports.</field>
        </record>

        <!-- 2. Assignee (Team Member / Task Executor) -->
        <record id="group_pm_user" model="res.groups">
            <field name="name">Assignee</field>
            <field name="privilege_id" ref="res_groups_privilege_pm"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Access restricted to their own assigned tasks, subtasks, and progress logs.</field>
        </record>

        <!-- 3. Project Manager (Manages Own Projects) -->
        <record id="group_pm_project_manager" model="res.groups">
            <field name="name">Project Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_pm"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('project_management.group_pm_user'))]"/>
            <field name="comment">Full access to manage their own projects, deliverables, milestones, risks, and tasks.</field>
        </record>

        <!-- 4. Program Manager (Global PMO / Administrator) -->
        <record id="group_pm_manager" model="res.groups">
            <field name="name">Program Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_pm"/>
            <field name="sequence">40</field>
            <field name="implied_ids" eval="[(4, ref('project_management.group_pm_project_manager'))]"/>
            <field name="comment">Unrestricted access across all initiatives, projects, tasks, and configurations.</field>
        </record>
    </data>
</odoo>
