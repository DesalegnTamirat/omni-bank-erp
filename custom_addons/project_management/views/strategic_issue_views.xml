<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_strategic_issue_tree" model="ir.ui.view">
        <field name="name">pm.strategic.issue.list</field>
        <field name="model">pm.strategic.issue</field>
        <field name="arch" type="xml">
            <list string="Strategic Issues">
                <field name="code"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="objective_count" string="Aligned Objectives"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'in_progress'" decoration-success="state == 'achieved'"/>
            </list>
        </field>
    </record>

    <record id="view_pm_strategic_issue_form" model="ir.ui.view">
        <field name="name">pm.strategic.issue.form</field>
        <field name="model">pm.strategic.issue</field>
        <field name="arch" type="xml">
            <form string="Strategic Issue">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,achieved" options="{'clickable': True}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Strategic Issue Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Core Banking Platform Scalability &amp; Reliability"/>
                        </h1>
                        <span class="text-muted"><field name="code"/></span>
                    </div>

                    <group>
                        <group string="Timeline">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Strategic Alignment">
                            <field name="strategic_source_ids" widget="many2many_tags" placeholder="e.g. Board Strategy Directive, NBE Mandate"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Feedback Line 33: Aligned projects replaced with Aligned objectives -->
                        <page string="Aligned Strategic Objectives" name="aligned_objectives">
                            <field name="objective_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="strategic_source_ids" widget="many2many_tags"/>
                                    <field name="initiative_count" string="Initiatives Count"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>

                        <page string="Description &amp; Context" name="description">
                            <field name="description" placeholder="Provide background context, organizational pain points, and strategic intent..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_strategic_issue_search" model="ir.ui.view">
        <field name="name">pm.strategic.issue.search</field>
        <field name="model">pm.strategic.issue</field>
        <field name="arch" type="xml">
            <search string="Strategic Issues">
                <field name="name" string="Strategic Issue"/>
                <field name="code"/>
                <filter string="Active / In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Achieved" name="filter_achieved" domain="[('state', '=', 'achieved')]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pm_strategic_issue" model="ir.actions.act_window">
        <field name="name">Strategic Issues</field>
        <field name="res_model">pm.strategic.issue</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a new Strategic Issue
            </p>
            <p>
                Strategic issues serve as the high-level governance anchors addressed by Strategic Objectives.
            </p>
        </field>
    </record>
</odoo>
