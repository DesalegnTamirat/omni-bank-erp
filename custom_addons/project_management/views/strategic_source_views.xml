<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_strategic_source_form" model="ir.ui.view">
        <field name="name">pm.strategic.source.form</field>
        <field name="model">pm.strategic.source</field>
        <field name="arch" type="xml">
            <form string="Strategic Source">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Strategic Source Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. 2026 Executive Strategy Directive"/>
                        </h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <group string="Strategic Scope &amp; Context">
                        <field name="description" placeholder="Provide background on the source, mandate, or board resolution..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pm_strategic_source_tree" model="ir.ui.view">
        <field name="name">pm.strategic.source.list</field>
        <field name="model">pm.strategic.source</field>
        <field name="arch" type="xml">
            <list string="Strategic Sources" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_pm_strategic_source" model="ir.actions.act_window">
        <field name="name">Strategic Sources</field>
        <field name="res_model">pm.strategic.source</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
