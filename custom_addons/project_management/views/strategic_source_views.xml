<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_strategic_source_tree" model="ir.ui.view">
        <field name="name">pm.strategic.source.list</field>
        <field name="model">pm.strategic.source</field>
        <field name="arch" type="xml">
            <list string="Strategic Sources" editable="bottom">
                <field name="code" string="ID" readonly="1"/>
                <field name="name" string="Strategic Source"/>
                <field name="description" string="Description"/>
                <field name="active" string="Status" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_pm_strategic_source_form" model="ir.ui.view">
        <field name="name">pm.strategic.source.form</field>
        <field name="model">pm.strategic.source</field>
        <field name="arch" type="xml">
            <form string="Strategic Source">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Strategic Source"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" string="ID" readonly="1"/>
                            <field name="active" string="Status" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pm_strategic_source" model="ir.actions.act_window">
        <field name="name">Strategic Sources</field>
        <field name="res_model">pm.strategic.source</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
