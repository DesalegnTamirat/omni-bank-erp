    <menuitem id="menu_pm_config"
              name="Configuration"
              parent="menu_pm_root"
              groups="project_management.group_pm_manager"
              sequence="100"/>

    <!-- Feedback Line 87-88: Strategic Issues -->
    <menuitem id="menu_pm_config_strategic_issues"
