    <menuitem id="menu_pm_project_documents"
              name="Requirements &amp; Test Cases"
              parent="menu_pm_documentation_root"
              action="action_pm_project_document"
              sequence="10"/>

    <!-- Step 2: Test Execution & Results (Live Testing & Evaluation) -->
    <menuitem id="menu_pm_test_executions"
              name="Test Execution &amp; Results"
              parent="menu_pm_documentation_root"
              action="action_pm_test_execution"
              sequence="20"/>

