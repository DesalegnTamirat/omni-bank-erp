    <menuitem id="menu_pm_initiatives_root"
              name="Initiatives"
              parent="menu_pm_root"
              sequence="10"/>

    <menuitem id="menu_pm_initiatives_item"
              name="Initiatives"
              parent="menu_pm_initiatives_root"
