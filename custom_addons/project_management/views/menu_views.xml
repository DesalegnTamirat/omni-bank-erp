<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_pm_root"
              name="Project Management"
              sequence="10"
              web_icon="project_management,static/description/icon.png"/>

    <!-- 1. Feedback Line 26: Dashboards (renamed from Dashboard) -->
    <menuitem id="menu_pm_dashboards_root"
              name="Dashboards"
              parent="menu_pm_root"
              sequence="5"/>

    <menuitem id="menu_pm_project_dashboard"
              name="Project Dashboard"
              parent="menu_pm_dashboards_root"
