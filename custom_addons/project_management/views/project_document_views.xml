<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== 1. PROJECT DOCUMENTS ==================== -->
    <record id="view_pm_project_document_tree" model="ir.ui.view">
        <field name="name">pm.project.document.list</field>
        <field name="model">pm.project.document</field>
        <field name="arch" type="xml">
            <list string="Project Documents">
                <field name="name"/>
                <field name="document_type" widget="badge"/>
                <field name="project_id"/>
                <field name="milestone_id" optional="show"/>
                <field name="deliverable_id" optional="show"/>
                <field name="filename" string="File"/>
                <field name="date_uploaded"/>
                <field name="uploaded_by_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="view_pm_project_document_form" model="ir.ui.view">
        <field name="name">pm.project.document.form</field>
        <field name="model">pm.project.document</field>
        <field name="arch" type="xml">
            <form string="Project Document">
                <header>
                    <button name="action_download_template" string="Download Test Case Template" type="object" icon="fa-download" class="btn-secondary" title="Download formatted Excel template for test cases"/>
                </header>
                <sheet>
                    <field name="has_test_cases" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Document Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Core Banking System SRS Document"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Classification &amp; Association">
                            <field name="document_type"/>
                            <field name="project_id" options="{'no_create_edit': True}"/>
                            <field name="milestone_id" options="{'no_create_edit': True}" domain="[('project_id', '=', project_id)]"/>
                            <field name="deliverable_id" options="{'no_create_edit': True}" domain="milestone_id and [('milestone_id', '=', milestone_id)] or [('project_id', '=', project_id)]"/>
                        </group>
                        <group string="Attachment">
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="date_uploaded"/>
                            <field name="uploaded_by_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="📋 Test Cases Specification" name="test_cases" invisible="not has_test_cases">
                            <field name="test_case_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code" string="Test ID"/>
                                    <field name="name" string="Test Case Name"/>
                                    <field name="category" optional="show"/>
                                    <field name="severity" widget="badge"
                                           decoration-danger="severity in ['critical', 'high']"
                                           decoration-warning="severity == 'medium'"
                                           decoration-info="severity == 'low'"/>
                                    <field name="steps" optional="show"/>
                                    <field name="expected_result"/>
                                </list>
                            </field>
                        </page>
                        <page string="📝 Scope &amp; Description" name="scope_notes">
                            <field name="description" placeholder="Notes, document version details, or key specification remarks..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_project_document_search" model="ir.ui.view">
        <field name="name">pm.project.document.search</field>
        <field name="model">pm.project.document</field>
        <field name="arch" type="xml">
            <search string="Project Documents">
                <field name="name" string="Title / File"/>
                <field name="project_id"/>
                <field name="deliverable_id"/>
                <field name="document_type"/>
                <filter string="Requirements" name="filter_requirement" domain="[('document_type', '=', 'requirement')]"/>
                <filter string="Gap Analysis" name="filter_gap_analysis" domain="[('document_type', '=', 'gap_analysis')]"/>
                <group>
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Document Type" name="group_by_type" context="{'group_by': 'document_type'}"/>
                    <filter string="Deliverable" name="group_by_deliverable" context="{'group_by': 'deliverable_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pm_project_document" model="ir.actions.act_window">
        <field name="name">Project Documents</field>
        <field name="res_model">pm.project.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_project_document_search"/>
    </record>

    <!-- ==================== 2. TEST CASES ==================== -->
    <record id="view_pm_test_case_tree" model="ir.ui.view">
        <field name="name">pm.test.case.list</field>
        <field name="model">pm.test.case</field>
        <field name="arch" type="xml">
            <list string="Test Cases &amp; Results">
                <field name="code" string="ID"/>
                <field name="name" string="Test Case Name"/>
                <field name="project_id"/>
                <field name="milestone_id" optional="show"/>
                <field name="deliverable_id" optional="show"/>
                <field name="test_round"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'tested'"
                       decoration-info="status == 'not_tested'"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'pass'"
                       decoration-danger="result == 'fail'"
                       decoration-warning="result == 'indifferent'"/>
                <field name="test_date"/>
                <field name="remark" optional="show"/>
                <field name="evidence_filename" string="Evidence" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pm_test_case_form" model="ir.ui.view">
        <field name="name">pm.test.case.form</field>
        <field name="model">pm.test.case</field>
        <field name="arch" type="xml">
            <form string="Test Case">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Test Case Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. TC-01: Core Transaction Settlement Validation"/>
                        </h1>
                        <span class="text-muted"><field name="code"/></span>
                    </div>
                    <group>
                        <group string="Project &amp; Deliverable Association">
                            <field name="project_id" options="{'no_create_edit': True}"/>
                            <field name="milestone_id" options="{'no_create_edit': True}" domain="[('project_id', '=', project_id)]"/>
                            <field name="deliverable_id" options="{'no_create_edit': True}" domain="milestone_id and [('milestone_id', '=', milestone_id)] or [('project_id', '=', project_id)]"/>
                        </group>
                        <group string="Test Execution &amp; Results">
                            <field name="status" widget="badge"
                                   decoration-success="status == 'tested'"
                                   decoration-info="status == 'not_tested'"/>
                            <field name="test_round" placeholder="e.g. Round 1"/>
                            <field name="result" widget="badge"
                                   decoration-success="result == 'pass'"
                                   decoration-danger="result == 'fail'"
                                   decoration-warning="result == 'indifferent'"/>
                            <field name="test_date"/>
                        </group>
                    </group>
                    <group string="Scope Description &amp; Remark">
                        <field name="description" placeholder="Scope description, prerequisites, or test scenario details..."/>
                        <field name="remark" placeholder="Execution observations, defect remarks, or follow-up notes..."/>
                    </group>
                    <group string="Quality Evidence">
                        <field name="evidence_attachment" filename="evidence_filename"/>
                        <field name="evidence_filename" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_test_case_search" model="ir.ui.view">
        <field name="name">pm.test.case.search</field>
        <field name="model">pm.test.case</field>
        <field name="arch" type="xml">
            <search string="Test Cases">
                <field name="name" string="Test Case"/>
                <field name="project_id"/>
                <field name="milestone_id"/>
                <field name="deliverable_id"/>
                <field name="test_round"/>
                <filter string="Tested" name="filter_tested" domain="[('status', '=', 'tested')]"/>
                <filter string="Not Tested" name="filter_not_tested" domain="[('status', '=', 'not_tested')]"/>
                <separator/>
                <filter string="Pass" name="filter_pass" domain="[('result', '=', 'pass')]"/>
                <filter string="Fail" name="filter_fail" domain="[('result', '=', 'fail')]"/>
                <filter string="Indifferent" name="filter_indifferent" domain="[('result', '=', 'indifferent')]"/>
                <group>
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Milestone" name="group_by_milestone" context="{'group_by': 'milestone_id'}"/>
                    <filter string="Deliverable" name="group_by_deliverable" context="{'group_by': 'deliverable_id'}"/>
                    <filter string="Test Round" name="group_by_round" context="{'group_by': 'test_round'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Result" name="group_by_result" context="{'group_by': 'result'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pm_test_case" model="ir.actions.act_window">
        <field name="name">Test Cases &amp; Results</field>
        <field name="res_model">pm.test.case</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_test_case_search"/>
    </record>
</odoo>
