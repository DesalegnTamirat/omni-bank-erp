<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_deliverable_form" model="ir.ui.view">
        <field name="name">pm.deliverable.form</field>
        <field name="model">pm.deliverable</field>
        <field name="arch" type="xml">
            <form string="Deliverable">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Deliverable Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Frontend Development &amp; User Experience" readonly="state == 'completed'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Project &amp; Milestone">
                            <field name="project_id" options="{'no_create_edit': True}" readonly="state == 'completed'"/>
                            <field name="milestone_id" options="{'no_create_edit': True}" readonly="state == 'completed'"/>
                            <field name="code" readonly="state == 'completed'"/>
                            <field name="weight" readonly="state == 'completed'"/>
                        </group>
                        <group string="Timeline &amp; Progress">
                            <field name="date_start" readonly="state == 'completed'"/>
                            <field name="date_deadline" required="1" readonly="state == 'completed'"/>
                            <field name="progress_rate" widget="progressbar"/>
                            <field name="task_count"/>
                            <field name="closed_task_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scope &amp; Acceptance Criteria" name="description">
                            <field name="description" placeholder="Specify deliverables scope, acceptance criteria, and technical boundaries..." readonly="state == 'completed'"/>
                        </page>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids" context="{'default_project_id': project_id, 'default_deliverable_id': id, 'default_milestone_id': milestone_id, 'default_is_project_task': True}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="priority" widget="priority" optional="show"/>
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                    <field name="weight"/>
                                    <field name="date_start" optional="show"/>
                                    <field name="date_deadline" optional="show"/>
                                    <field name="allocated_hours" widget="float_time" optional="show"/>
                                    <field name="progress_rate" widget="progressbar"/>
                                    <field name="stage_id" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_deliverable_tree" model="ir.ui.view">
        <field name="name">pm.deliverable.list</field>
        <field name="model">pm.deliverable</field>
        <field name="arch" type="xml">
            <list string="Deliverables" decoration-muted="state == 'completed'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="project_id" optional="show"/>
                <field name="milestone_id" optional="show"/>
                <field name="weight" optional="show"/>
                <field name="date_start" optional="show"/>
                <field name="date_deadline" optional="show"/>
                <field name="task_count" optional="show"/>
                <field name="closed_task_count" optional="show"/>
                <field name="progress_rate" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'in_progress'"
                       decoration-danger="state == 'at_risk'"
                       decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_pm_deliverable_kanban" model="ir.ui.view">
        <field name="name">pm.deliverable.kanban</field>
        <field name="model">pm.deliverable</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="project_id"/>
                <field name="milestone_id"/>
                <field name="weight"/>
                <field name="date_deadline"/>
                <field name="progress_rate"/>
                <field name="state"/>
                <templates>
                    <t t-name="card" class="p-2 mb-2 shadow-sm rounded border bg-white">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <strong class="o_kanban_record_title text-dark">
                                <field name="name"/>
                            </strong>
                            <span class="badge bg-light text-dark border">
                                Weight: <field name="weight"/>
                            </span>
                        </div>
                        <div t-if="record.project_id.raw_value" class="text-muted small mb-1">
                            <i class="fa fa-folder-o me-1" title="Project"/> <field name="project_id"/>
                        </div>
                        <div t-if="record.milestone_id.raw_value" class="text-secondary small mb-1">
                            <i class="fa fa-flag-o me-1" title="Milestone"/> <field name="milestone_id"/>
                        </div>
                        <div class="mb-2">
                            <field name="progress_rate" widget="progressbar"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top small text-muted">
                            <div>
                                <i class="fa fa-clock-o me-1" title="Deadline"/> <field name="date_deadline"/>
                            </div>
                            <div>
                                <field name="task_count"/> Tasks
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_pm_deliverable_search" model="ir.ui.view">
        <field name="name">pm.deliverable.search</field>
        <field name="model">pm.deliverable</field>
        <field name="arch" type="xml">
            <search string="Search Deliverables">
                <field name="name" string="Deliverable"/>
                <field name="project_id"/>
                <field name="milestone_id"/>
                <filter name="open_deliverables" string="Open Deliverables" domain="[('state', 'in', ['draft', 'in_progress', 'at_risk'])]"/>
                <filter name="completed_deliverables" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_milestone" string="Milestone" context="{'group_by': 'milestone_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
                <searchpanel>
                    <field name="project_id" icon="fa-folder" enable_counters="1"/>
                    <field name="milestone_id" icon="fa-flag" enable_counters="1"/>
                    <field name="state" icon="fa-tasks" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_pm_deliverable" model="ir.actions.act_window">
        <field name="name">Deliverables</field>
        <field name="res_model">pm.deliverable</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_pm_deliverable_search"/>
        <field name="context">{'search_default_open_deliverables': 1, 'search_default_group_project': 1}</field>
    </record>
</odoo>
