<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_task_form" model="ir.ui.view">
        <field name="name">pm.task.form</field>
        <field name="model">pm.task</field>
        <field name="arch" type="xml">
            <form string="Task">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="d-flex align-items-center mb-1">
                            <field name="priority" widget="priority" class="me-2"/>
                            <label for="name" string="Task Title" class="oe_edit_only"/>
                        </div>
                        <h1>
                            <field name="name" placeholder="e.g. HR Domain Module Design &amp; Configuration" readonly="is_closed"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Project &amp; Work Breakdown" invisible="not is_project_task and not project_id">
                            <field name="is_project_task" invisible="1"/>
                            <field name="project_id" options="{'no_create_edit': True}" readonly="is_closed" required="is_project_task"/>
                            <field name="milestone_id" options="{'no_create_edit': True}" invisible="not project_id" readonly="is_closed"/>
                            <field name="deliverable_id" options="{'no_create_edit': True}" invisible="not project_id" readonly="is_closed"/>
                            <field name="weight" invisible="not project_id" readonly="is_closed"/>
                            <field name="customer_id" readonly="is_closed"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group string="Operational &amp; General Info" invisible="is_project_task or project_id">
                            <field name="customer_id" string="Sponsor / Requesting Unit" readonly="is_closed"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group string="Assignment &amp; Timeline">
                            <field name="user_ids" widget="many2many_avatar_user" groups="project_management.group_pm_project_manager,project_management.group_pm_manager" readonly="is_closed"/>
                            <field name="user_ids" widget="many2many_avatar_user" groups="!project_management.group_pm_project_manager" readonly="1"/>
                            <field name="date_start" readonly="is_closed"/>
                            <field name="date_deadline" groups="project_management.group_pm_project_manager,project_management.group_pm_manager" readonly="is_closed"/>
                            <field name="date_deadline" groups="!project_management.group_pm_project_manager" readonly="1"/>
                            <field name="deadline_status" invisible="not deadline_status"/>
                            <field name="allocated_hours" widget="float_time" groups="project_management.group_pm_project_manager,project_management.group_pm_manager" readonly="is_closed"/>
                            <field name="allocated_hours" widget="float_time" groups="!project_management.group_pm_project_manager" readonly="1"/>
                            <field name="effective_hours" widget="float_time" readonly="1"/>
                            <field name="progress_rate" widget="progressbar"/>
                        </group>
                    </group>
                    <div class="alert alert-danger mb-3" role="alert" invisible="not is_blocked">
                        <strong>&#9888; Blocked!</strong>
                        This task is waiting on prerequisite tasks to be completed before work can start.
                        See the <strong>Dependencies</strong> tab for details.
                    </div>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Add detailed specifications, instructions, or notes for this task..." readonly="is_closed"/>
                        </page>
                        <page string="Work &amp; Progress Logs" name="progress_logs">
                            <p class="text-muted small">Assigned team members can record their daily work and progress updates here.</p>
                            <field name="progress_log_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="hours_spent" widget="float_time"/>
                                    <field name="progress_percent" optional="hide"/>
                                    <field name="summary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sub-tasks / Timelines" name="subtasks">
                            <field name="subtask_ids" context="{'default_user_ids': user_ids}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="is_done" widget="boolean_toggle"/>
                                    <field name="name" readonly="parent.is_closed"/>
                                    <field name="weight" readonly="parent.is_closed"/>
                                    <field name="user_ids" widget="many2many_tags" readonly="parent.is_closed"/>
                                    <field name="date_start" readonly="parent.is_closed"/>
                                    <field name="date_deadline" readonly="parent.is_closed"/>
                                    <field name="allocated_hours" widget="float_time" readonly="parent.is_closed"/>
                                </list>
                            </field>
                        </page>
                        <page string="Dependencies (Blocked By)" name="dependencies">
                            <group>
                                <field name="blocked_by_ids" widget="many2many_tags" domain="[('id', '!=', id)]" placeholder="Select tasks that block this task..." readonly="is_closed"/>
                                <field name="blocking_ids" widget="many2many_tags" readonly="1"/>
                                <field name="is_blocked" widget="boolean_toggle" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_task_kanban" model="ir.ui.view">
        <field name="name">pm.task.kanban</field>
        <field name="model">pm.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="stage_id"/>
                <field name="project_id"/>
                <field name="milestone_id"/>
                <field name="deliverable_id"/>
                <field name="user_ids"/>
                <field name="priority"/>
                <field name="date_deadline"/>
                <field name="deadline_status"/>
                <field name="is_blocked"/>
                <field name="progress_rate"/>
                <field name="color"/>
                <templates>
                    <t t-name="card" class="p-2 mb-2 shadow-sm rounded border bg-white">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <strong class="o_kanban_record_title text-dark">
                                <field name="name"/>
                            </strong>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div t-if="record.project_id.raw_value" class="text-muted small mb-1">
                            <i class="fa fa-folder-o me-1" title="Project"/> <field name="project_id"/>
                        </div>
                        <div t-if="record.milestone_id.raw_value" class="text-secondary small mb-1">
                            <i class="fa fa-flag-o me-1" title="Milestone"/> <field name="milestone_id"/>
                        </div>
                        <div t-if="record.deliverable_id.raw_value" class="text-info small mb-1">
                            <i class="fa fa-cubes me-1" title="Deliverable"/> <field name="deliverable_id"/>
                        </div>
                        <div class="mb-2">
                            <field name="progress_rate" widget="progressbar"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top small">
                            <div>
                                <span t-if="record.is_blocked.raw_value" class="badge bg-danger text-white me-1">Blocked</span>
                                <span t-if="record.deadline_status.raw_value" class="text-muted">
                                    <i class="fa fa-clock-o me-1" title="Deadline"/> <field name="deadline_status"/>
                                </span>
                            </div>
                            <div>
                                <field name="user_ids" widget="many2many_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_pm_task_tree" model="ir.ui.view">
        <field name="name">pm.task.list</field>
        <field name="model">pm.task</field>
        <field name="arch" type="xml">
            <list string="Tasks" decoration-danger="is_blocked" decoration-muted="is_closed">
                <field name="sequence" widget="handle"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="name"/>
                <field name="project_id" optional="show"/>
                <field name="milestone_id" optional="hide"/>
                <field name="deliverable_id" optional="show"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
                <field name="weight" optional="show"/>
                <field name="date_start" optional="hide"/>
                <field name="date_deadline" optional="show"/>
                <field name="allocated_hours" widget="float_time" optional="show"/>
                <field name="effective_hours" widget="float_time" optional="show"/>
                <field name="progress_rate" widget="progressbar" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="stage_id" widget="badge"/>
                <field name="is_blocked" invisible="1"/>
                <field name="is_closed" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pm_task_calendar" model="ir.ui.view">
        <field name="name">pm.task.calendar</field>
        <field name="model">pm.task</field>
        <field name="arch" type="xml">
            <calendar string="Task Schedule" date_start="date_start" date_stop="date_deadline" color="user_ids" mode="month">
                <field name="name"/>
                <field name="project_id"/>
                <field name="stage_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_pm_task_search" model="ir.ui.view">
        <field name="name">pm.task.search</field>
        <field name="model">pm.task</field>
        <field name="arch" type="xml">
            <search string="Search Tasks">
                <field name="name" string="Task" filter_domain="[('name', 'ilike', self)]"/>
                <field name="project_id"/>
                <field name="milestone_id"/>
                <field name="deliverable_id"/>
                <field name="user_ids"/>
                <field name="tag_ids"/>
                <filter name="my_tasks" string="My Tasks" domain="[('user_ids', 'in', [uid])]"/>
                <filter name="open_tasks" string="Open Tasks" domain="[('is_closed', '=', False)]"/>
                <filter name="completed_tasks" string="Completed Tasks" domain="[('is_closed', '=', True)]"/>
                <separator/>
                <filter name="blocked_tasks" string="Blocked Tasks" domain="[('is_blocked', '=', True)]"/>
                <filter name="high_priority" string="High Priority" domain="[('priority', 'in', ['2', '3'])]"/>
                <group>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_milestone" string="Milestone" context="{'group_by': 'milestone_id'}"/>
                    <filter name="group_deliverable" string="Deliverable" context="{'group_by': 'deliverable_id'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                    <filter name="group_deadline" string="Deadline" context="{'group_by': 'date_deadline'}"/>
                </group>
                <searchpanel>
                    <field name="project_id" icon="fa-folder" enable_counters="1"/>
                    <field name="milestone_id" icon="fa-flag" enable_counters="1"/>
                    <field name="deliverable_id" icon="fa-cubes" enable_counters="1"/>
                    <field name="stage_id" icon="fa-tasks" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_pm_project_tasks" model="ir.actions.act_window">
        <field name="name">Project Tasks</field>
        <field name="res_model">pm.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_pm_task_search"/>
        <field name="domain">[('is_project_task', '=', True)]</field>
        <field name="context">{'default_is_project_task': True, 'search_default_open_tasks': 1, 'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a task linked to a Project!
            </p>
        </field>
    </record>

        <record id="view_pm_task_non_project_tree" model="ir.ui.view">
        <field name="name">pm.task.non.project.list</field>
        <field name="model">pm.task</field>
        <field name="arch" type="xml">
            <list string="Non-Project Tasks" decoration-danger="is_blocked" decoration-muted="is_closed">
                <field name="sequence" widget="handle"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="name"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
                <field name="customer_id" string="Sponsor / Unit" optional="show"/>
                <field name="date_start" optional="hide"/>
                <field name="date_deadline" optional="show"/>
                <field name="allocated_hours" widget="float_time" optional="show"/>
                <field name="effective_hours" widget="float_time" optional="show"/>
                <field name="progress_rate" widget="progressbar" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="stage_id" widget="badge"/>
                <field name="is_blocked" invisible="1"/>
                <field name="is_closed" invisible="1"/>
            </list>
        </field>
    </record>

<record id="action_pm_non_project_tasks" model="ir.actions.act_window">
        <field name="name">Non-Project Tasks</field>
        <field name="res_model">pm.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_pm_task_search"/>
        <field name="domain">[('is_project_task', '=', False)]</field>
        <field name="context">{'default_is_project_task': False, 'default_project_id': False, 'search_default_open_tasks': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a standalone / operational task!
            </p>
        </field>
    </record>

    <record id="action_pm_my_tasks" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">pm.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_pm_task_search"/>
        <field name="domain">[('user_ids', 'in', [uid])]</field>
        <field name="context">{'default_user_ids': [(4, uid)], 'search_default_open_tasks': 1}</field>
    </record>
</odoo>
