<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_tag_tree" model="ir.ui.view">
        <field name="name">pm.task.tag.list</field>
        <field name="model">pm.task.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_pm_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">pm.task.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>