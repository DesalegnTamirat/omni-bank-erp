<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_tag_tree" model="ir.ui.view">
        <field name="name">pm.task.tag.list</field>
        <field name="model">pm.task.tag</field>
        <field name="arch" type="xml">
            <list string="Project Types" editable="bottom">
                <field name="name" string="Project Type"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="view_pm_tag_form" model="ir.ui.view">
        <field name="name">pm.task.tag.form</field>
        <field name="model">pm.task.tag</field>
        <field name="arch" type="xml">
            <form string="Project Type">
                <sheet>
                    <group>
                        <field name="name" string="Project Type Name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pm_tag" model="ir.actions.act_window">
        <field name="name">Project Types</field>
        <field name="res_model">pm.task.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
