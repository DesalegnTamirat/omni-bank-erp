<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_milestone_form" model="ir.ui.view">
        <field name="name">pm.milestone.form</field>
        <field name="model">pm.milestone</field>
        <field name="arch" type="xml">
            <form string="Milestone">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Milestone Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Requirement Revalidation &amp; Current ERP Demo Session" readonly="state == 'completed'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Project &amp; Weight">
                            <field name="project_id" options="{'no_create_edit': True}" readonly="state == 'completed'"/>
                            <field name="weight" readonly="state == 'completed'"/>
                            <field name="deliverable_count"/>
                            <field name="task_count"/>
                            <field name="closed_task_count"/>
                        </group>
                        <group string="Timeline &amp; Progress">
                            <field name="date_start" readonly="state == 'completed'"/>
                            <field name="date_deadline" readonly="state == 'completed'"/>
                            <field name="progress_rate" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Deliverables" name="deliverables">
                            <field name="deliverable_ids" readonly="state == 'completed'" context="{'default_project_id': project_id, 'default_milestone_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="weight"/>
                                    <field name="date_start"/>
                                    <field name="date_deadline"/>
                                    <field name="task_count"/>
                                    <field name="closed_task_count"/>
                                    <field name="progress_rate" widget="progressbar"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'in_progress'" decoration-success="state == 'completed'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids" context="{'default_project_id': project_id, 'default_milestone_id': id, 'default_is_project_task': True}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="priority" widget="priority" optional="show"/>
                                    <field name="name"/>
                                    <field name="deliverable_id" domain="[('milestone_id', '=', parent.id)]" options="{'no_create_edit': True}"/>
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                    <field name="weight"/>
                                    <field name="date_start" optional="show"/>
                                    <field name="date_deadline" optional="show"/>
                                    <field name="allocated_hours" widget="float_time" optional="show"/>
                                    <field name="progress_rate" widget="progressbar"/>
                                    <field name="stage_id" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Milestone Scope &amp; Objectives" name="description">
                            <field name="description" placeholder="Specify milestone scope, targets, and exit criteria..." readonly="state == 'completed'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_milestone_tree" model="ir.ui.view">
        <field name="name">pm.milestone.list</field>
        <field name="model">pm.milestone</field>
        <field name="arch" type="xml">
            <list string="Milestones" decoration-muted="state == 'completed'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="project_id" optional="show"/>
                <field name="weight" optional="show"/>
                <field name="date_start" optional="show"/>
                <field name="date_deadline" optional="show"/>
                <field name="deliverable_count" optional="show"/>
                <field name="task_count" optional="show"/>
                <field name="closed_task_count" optional="show"/>
                <field name="progress_rate" widget="progressbar"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'in_progress'" decoration-danger="state == 'at_risk'" decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_pm_milestone_search" model="ir.ui.view">
        <field name="name">pm.milestone.search</field>
        <field name="model">pm.milestone</field>
        <field name="arch" type="xml">
            <search string="Search Milestones">
                <field name="name" string="Milestone"/>
                <field name="project_id"/>
                <filter name="open_milestones" string="Open Milestones" domain="[('state', 'in', ['draft', 'in_progress', 'at_risk'])]"/>
                <filter name="completed_milestones" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
                <searchpanel>
                    <field name="project_id" icon="fa-folder" enable_counters="1"/>
                    <field name="state" icon="fa-tasks" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_pm_milestone" model="ir.actions.act_window">
        <field name="name">Milestones</field>
        <field name="res_model">pm.milestone</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_milestone_search"/>
        <field name="context">{'search_default_open_milestones': 1, 'search_default_group_project': 1}</field>
    </record>
</odoo>
