<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_milestone_tree" model="ir.ui.view">
        <field name="name">pm.milestone.list</field>
        <field name="model">pm.milestone</field>
        <field name="arch" type="xml">
            <list string="Milestones">
                <field name="sequence" widget="handle"/>
                <field name="code" readonly="1" optional="show"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="weight"/>
                <field name="date_start" optional="show"/>
                <field name="date_deadline"/>
                <field name="deliverable_count"/>
                <field name="progress_rate" widget="progressbar"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'in_progress'" decoration-danger="state == 'at_risk'" decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_pm_milestone_form" model="ir.ui.view">
        <field name="name">pm.milestone.form</field>
        <field name="model">pm.milestone</field>
        <field name="arch" type="xml">
            <form string="Milestone">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h2>
                            <field name="code" readonly="1" class="text-muted"/>
                        </h2>
                        <label for="name" string="Milestone Name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Project &amp; Weight">
                            <field name="project_id" required="1" options="{'no_create_edit': True}"/>
                            <field name="weight"/>
                        </group>
                        <group string="Timeline &amp; Progress">
                            <field name="date_start"/>
                            <field name="date_deadline"/>
                            <field name="progress_rate" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- TAB 1: Deliverables -->
                        <page string="Deliverables / Major Activities" name="deliverables">
                            <field name="deliverable_ids" context="{'default_project_id': project_id, 'default_milestone_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Deliverable Title"/>
                                    <field name="weight"/>
                                    <field name="date_start"/>
                                    <field name="date_deadline"/>
                                    <field name="progress_rate" widget="progressbar"/>
                                    <field name="state" string="Status"/>
                                </list>
                            </field>
                        </page>
                        <!-- TAB 2: Tasks -->
                        <page string="Tasks" name="tasks">
                            <field name="task_ids" context="{'default_project_id': project_id, 'default_milestone_id': id, 'default_is_project_task': True}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Task Title"/>
                                    <field name="deliverable_id" domain="[('milestone_id', '=', parent.id)]" options="{'no_create_edit': True}"/>
                                    <field name="project_member_ids" column_invisible="True"/>
                                    <field name="user_ids" widget="many2many_avatar_user" domain="[('id', 'in', project_member_ids)]" options="{'no_create_edit': True}"/>
                                    <field name="weight"/>
                                    <field name="date_deadline"/>
                                    <field name="stage_id" widget="badge"/>
                                    <field name="progress_rate" widget="progressbar"/>
                                </list>
                            </field>
                        </page>
                        <!-- TAB 3: Sub-tasks -->
                        <page string="Sub-tasks" name="subtasks">
                            <field name="subtask_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Sub-task Title"/>
                                    <field name="task_id" domain="[('milestone_id', '=', parent.id)]" options="{'no_create_edit': True}"/>
                                    <field name="project_member_ids" column_invisible="True"/>
                                    <field name="user_ids" widget="many2many_avatar_user" domain="[('id', 'in', project_member_ids)]" options="{'no_create_edit': True}"/>
                                    <field name="date_start" optional="show"/>
                                    <field name="date_deadline"/>
                                    <field name="weight"/>
                                    <field name="is_done" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Test Cases &amp; Results" name="test_cases">
                            <field name="test_case_ids" context="{'default_project_id': project_id, 'default_milestone_id': id}">
                                <list editable="bottom">
                                    <field name="name" string="Test Case Name"/>
                                    <field name="deliverable_id" domain="[('milestone_id', '=', parent.id)]"/>
                                    <field name="test_round"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'tested'"
                                           decoration-info="status == 'not_tested'"/>
                                    <field name="result" widget="badge"
                                           decoration-success="result == 'pass'"
                                           decoration-danger="result == 'fail'"
                                           decoration-warning="result == 'indifferent'"/>
                                    <field name="test_date"/>
                                    <field name="remark"/>
                                    <field name="evidence_attachment" filename="evidence_filename" string="Evidence"/>
                                    <field name="evidence_filename" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Requirements &amp; Gap Analysis" name="documents">
                            <field name="document_ids" context="{'default_project_id': project_id, 'default_milestone_id': id}">
                                <list editable="bottom">
                                    <field name="name" string="Document Title"/>
                                    <field name="document_type"/>
                                    <field name="deliverable_id" domain="[('milestone_id', '=', parent.id)]"/>
                                    <field name="file" filename="filename" string="Attachment"/>
                                    <field name="filename" invisible="1"/>
                                    <field name="date_uploaded"/>
                                    <field name="uploaded_by_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_milestone_search" model="ir.ui.view">
        <field name="name">pm.milestone.search</field>
        <field name="model">pm.milestone</field>
        <field name="arch" type="xml">
            <search string="Milestones">
                <field name="name" string="Milestone Name"/>
                <field name="project_id"/>
                <separator/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="filter_at_risk" string="At Risk" domain="[('state', '=', 'at_risk')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pm_milestone" model="ir.actions.act_window">
        <field name="name">Milestones</field>
        <field name="res_model">pm.milestone</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_milestone_search"/>
    </record>

</odoo>
