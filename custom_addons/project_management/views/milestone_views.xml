<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_milestone_tree" model="ir.ui.view">
        <field name="name">pm.milestone.list</field>
        <field name="model">pm.milestone</field>
        <field name="arch" type="xml">
            <list string="Milestones">
                <field name="sequence" widget="handle"/>
                <field name="code" readonly="1" optional="show"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="weight"/>
                <field name="date_start" optional="show"/>
                <field name="date_deadline"/>
                <field name="deliverable_count"/>
                <field name="progress_rate" widget="progressbar"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'in_progress'" decoration-danger="state == 'at_risk'" decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_pm_milestone_form" model="ir.ui.view">
        <field name="name">pm.milestone.form</field>
        <field name="model">pm.milestone</field>
        <field name="arch" type="xml">
            <form string="Milestone">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="code" readonly="1" class="text-muted"/>
                        </h2>
                        <label for="name" string="Milestone Name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Project &amp; Weight">
                            <field name="project_id" required="1" options="{'no_create_edit': True}"/>
                            <field name="weight"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Timeline &amp; Progress">
                            <field name="date_start"/>
                            <field name="date_deadline"/>
                            <field name="progress_rate" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Deliverables / Major Activities" name="deliverables">
                            <field name="deliverable_ids" context="{'default_project_id': project_id, 'default_milestone_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Deliverable Title"/>
                                    <field name="weight"/>
                                    <field name="date_start"/>
                                    <field name="date_deadline"/>
                                    <field name="progress_rate" widget="progressbar"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_milestone" model="ir.actions.act_window">
        <field name="name">Milestones</field>
        <field name="res_model">pm.milestone</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_pm_milestone_search" model="ir.ui.view">
        <field name="name">pm.milestone.search</field>
        <field name="model">pm.milestone</field>
        <field name="arch" type="xml">
            <search string="Milestones">
                <field name="name" string="Milestone Name"/>
                <field name="project_id"/>
                <separator/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="filter_at_risk" string="At Risk" domain="[('state', '=', 'at_risk')]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
