<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_progress_update_tree" model="ir.ui.view">
        <field name="name">pm.project.progress.update.list</field>
        <field name="model">pm.project.progress.update</field>
        <field name="arch" type="xml">
            <list string="Progress Updates">
                <field name="name"/>
                <field name="project_id"/>
                <field name="report_type" widget="badge"/>
                <field name="report_date"/>
                <field name="manager_id"/>
                <field name="health_state" widget="badge" decoration-success="health_state in ('on_track', 'done')" decoration-warning="health_state == 'at_risk'" decoration-danger="health_state == 'off_track'"/>
                <field name="progress_rate" widget="progressbar"/>
                <field name="milestones_summary"/>
                <field name="deliverables_summary"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-primary="state == 'submitted'" decoration-success="state == 'reviewed'"/>
            </list>
        </field>
    </record>

    <record id="view_pm_progress_update_form" model="ir.ui.view">
        <field name="name">pm.project.progress.update.form</field>
        <field name="model">pm.project.progress.update</field>
        <field name="arch" type="xml">
            <form string="Project Progress Update">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_review" string="Mark as Reviewed" type="object" class="btn-success" invisible="state != 'submitted'"/>
                    <button name="action_refresh_from_project" string="Refresh from Project Data" type="object" icon="fa-refresh" invisible="state != 'draft'"/>
                    <button name="action_set_draft" string="Reopen as Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,reviewed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Report Title"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <!-- Executive Snapshot (Word Doc Paragraph 7-8: High Level Project Info) -->
                    <group>
                        <group string="Project &amp; Health Snapshot">
                            <field name="project_id" options="{'no_create_edit': True}"/>
                            <field name="health_state" widget="badge"
                                   decoration-success="health_state in ('on_track', 'done')"
                                   decoration-warning="health_state in ('planning', 'at_risk')"
                                   decoration-danger="health_state == 'off_track'"
                                   decoration-info="health_state == 'initiation'"
                                   decoration-secondary="health_state == 'on_hold'"/>
                            <field name="progress_rate" widget="progressbar"/>
                            <label for="date_from" string="Reporting Period"/>
                            <div class="d-flex align-items-center">
                                <field name="date_from" widget="date" class="oe_inline"/>
                                <span class="mx-2 text-muted fw-bold">&#10141;</span>
                                <field name="date_to" widget="date" class="oe_inline"/>
                            </div>
                        </group>
                        <group string="Governance &amp; Performance Rollup">
                            <field name="manager_id" widget="many2one_avatar_user"/>
                            <field name="report_date"/>
                            <field name="report_type"/>
                            <field name="milestones_summary"/>
                            <field name="deliverables_summary"/>
                            <label for="project_date_start" string="Project Timeline"/>
                            <div class="d-flex align-items-center">
                                <field name="project_date_start" widget="date" class="oe_inline"/>
                                <span class="mx-2 text-muted fw-bold">&#10141;</span>
                                <field name="project_date_end" widget="date" class="oe_inline"/>
                            </div>
                        </group>
                    </group>

                    <!-- Main Notebook (4 Primary Tabs from Word Doc Paragraph 9-13 + Preview) -->
                    <notebook>
                        <!-- Tab 1: Progress Update (Containing the 7 Sections requested by User) -->
                        <page string="Progress Update" name="progress_update">
                            <notebook>
                                <!-- Section 1: Project Information (with line - 1 column) -->
                                <page string="Project Information" name="section_project_info">
                                    <field name="info_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="name" string="Information Line"/>
                                        </list>
                                    </field>
                                </page>

                                <!-- Section 2: Executive Summary (just summary) -->
                                <page string="Executive Summary" name="section_executive_summary">
                                    <group>
                                        <field name="executive_summary" nolabel="1"/>
                                    </group>
                                </page>

                                <!-- Section 3: Overall Project Status (with line) -->
                                <page string="Overall Project Status" name="section_project_status">
                                    <field name="status_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="name" string="Parameter"/>
                                            <field name="value" string="Status / Value"/>
                                            <field name="health" string="Health" widget="badge"
                                                   decoration-success="health == 'on_track'"
                                                   decoration-warning="health == 'at_risk'"
                                                   decoration-danger="health == 'off_track'"
                                                   decoration-secondary="health == 'on_hold'"/>
                                            <field name="notes" string="Notes"/>
                                        </list>
                                    </field>
                                </page>

                                <!-- Section 4: Major Activities / Deliverables Reached (with line) -->
                                <page string="Major Activities/Deliverable Reached" name="section_deliverables_reached">
                                    <field name="deliverable_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="deliverable_id" string="Deliverable" options="{'no_create': True}"/>
                                            <field name="name" string="Deliverable / Activity Title"/>
                                            <field name="date_deadline" string="Deadline"/>
                                            <field name="progress_rate" widget="progressbar" string="Progress"/>
                                            <field name="state" widget="badge"
                                                   decoration-success="state == 'completed'"
                                                   decoration-warning="state == 'in_progress'"
                                                   decoration-danger="state in ('at_risk', 'cancelled')"
                                                   decoration-info="state == 'draft'"/>
                                            <field name="notes" string="Remark"/>
                                        </list>
                                    </field>
                                </page>

                                <!-- Section 5: Task / Activities Completed (with line) -->
                                <page string="Task/Activities Completed" name="section_tasks_completed">
                                    <field name="task_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="task_id" string="Task" options="{'no_create': True}"/>
                                            <field name="name" string="Task Title"/>
                                            <field name="user_id" widget="many2one_avatar_user" string="Assignee"/>
                                            <field name="date_deadline" string="Deadline"/>
                                            <field name="progress_rate" widget="progressbar" string="Progress"/>
                                            <field name="state" widget="badge"
                                                   decoration-success="state == 'done'"
                                                   decoration-warning="state == 'in_progress'"
                                                   decoration-danger="state == 'blocked'"
                                                   decoration-info="state == 'pending'"/>
                                            <field name="notes" string="Notes"/>
                                        </list>
                                    </field>
                                </page>

                                <!-- Section 6: Milestones (with line, delay color indicators) -->
                                <page string="Milestones" name="section_milestones">
                                    <field name="milestone_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="milestone_id" string="Milestone" options="{'no_create': True}"/>
                                            <field name="name" string="Milestone Phase"/>
                                            <field name="date_deadline" string="Due Date"/>
                                            <field name="date_reached" string="Reached On"/>
                                            <field name="is_reached" string="Reached"/>
                                            <field name="delay_status" string="Schedule Status" widget="badge"
                                                   decoration-success="delay_status == 'on_time'"
                                                   decoration-danger="delay_status in ('delayed', 'overdue')"
                                                   decoration-info="delay_status == 'pending'"/>
                                            <field name="progress_rate" widget="progressbar" string="Progress"/>
                                            <field name="status_note" string="Notes"/>
                                        </list>
                                    </field>
                                </page>

                                <!-- Section 7: Remark (just summary) -->
                                <page string="Remark" name="section_remark">
                                    <group>
                                        <field name="remark" nolabel="1"/>
                                    </group>
                                </page>
                            </notebook>
                        </page>

                        <!-- Tab 2: Identified Risks -->
                        <page string="Identified Risks" name="identified_risks">
                            <field name="risk_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="risk_id" string="Project Risk" options="{'no_create': True}"/>
                                    <field name="name" string="Risk Description"/>
                                    <field name="category" string="Category"/>
                                    <field name="severity" widget="badge"
                                           decoration-danger="severity in ('critical', 'high')"
                                           decoration-warning="severity == 'medium'"
                                           decoration-info="severity == 'low'"/>
                                    <field name="mitigation" string="Mitigation Strategy"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 3: Challenges -->
                        <page string="Challenges" name="challenges">
                            <field name="challenge_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name" string="Challenge Description"/>
                                    <field name="category" string="Category"/>
                                    <field name="impact" string="Impact"/>
                                    <field name="action_plan" string="Action Plan"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 4: Issues -->
                        <page string="Issues" name="issues">
                            <field name="issue_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name" string="Issue Description"/>
                                    <field name="severity" widget="badge"
                                           decoration-danger="severity in ('critical', 'high')"
                                           decoration-warning="severity == 'medium'"
                                           decoration-info="severity == 'low'"/>
                                    <field name="owner_id" widget="many2one_avatar_user" string="Owner"/>
                                    <field name="decision_needed" string="Decision / Action Needed"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'resolved'"
                                           decoration-warning="status == 'in_progress'"
                                           decoration-danger="status == 'open'"/>
                                </list>
                            </field>
                        </page>

                        <!-- Consolidated One-Page Preview (for easy reading without clicking tabs) -->
                        <page string="Consolidated Preview" name="consolidated_preview">
                            <field name="consolidated_preview_html" widget="html" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_project_progress_update" model="ir.actions.act_window">
        <field name="name">Progress Updates</field>
        <field name="res_model">pm.project.progress.update</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create consolidated one-page periodic progress updates (weekly, bi-weekly, monthly) for management and stakeholders.
            </p>
        </field>
    </record>

    <record id="view_pm_project_progress_update_search" model="ir.ui.view">
        <field name="name">pm.project.progress.update.search</field>
        <field name="model">pm.project.progress.update</field>
        <field name="arch" type="xml">
            <search string="Progress Updates">
                <field name="name" string="Report Title"/>
                <field name="project_id"/>
                <field name="manager_id"/>
                <field name="report_type"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_reviewed" string="Reviewed" domain="[('state', '=', 'reviewed')]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_report_type" string="Report Type" context="{'group_by': 'report_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_manager" string="Project Manager" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
