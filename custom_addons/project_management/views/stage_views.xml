<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_stage_tree" model="ir.ui.view">
        <field name="name">pm.task.stage.list</field>
        <field name="model">pm.task.stage</field>
        <field name="arch" type="xml">
            <list string="Task Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_closed"/>
                <field name="fold"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_pm_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">pm.task.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>