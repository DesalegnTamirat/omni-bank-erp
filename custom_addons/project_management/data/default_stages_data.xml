<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stage_to_do" model="pm.task.stage">
            <field name="name">To Do</field>
            <field name="sequence">10</field>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="stage_in_progress" model="pm.task.stage">
            <field name="name">In Progress</field>
            <field name="sequence">20</field>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="stage_blocked" model="pm.task.stage">
            <field name="name">Blocked</field>
            <field name="sequence">30</field>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="stage_completed" model="pm.task.stage">
            <field name="name">Completed</field>
            <field name="sequence">40</field>
            <field name="is_closed" eval="True"/>
        </record>

        <record id="tag_internal" model="pm.task.tag">
            <field name="name">Internal</field>
            <field name="color">4</field>
        </record>

        <record id="tag_external" model="pm.task.tag">
            <field name="name">External</field>
            <field name="color">1</field>
        </record>
    </data>
</odoo>
