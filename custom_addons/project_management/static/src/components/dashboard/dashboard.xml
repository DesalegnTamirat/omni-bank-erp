<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="project_management.ExecutiveDashboard">
        <div class="o_pm_executive_dashboard container-fluid py-4 px-4 overflow-auto h-100">
            <!-- 1. Bunna Bank Header & Filter Ribbon -->
            <div class="row align-items-center mb-4 o_bunna_header p-3 shadow-sm">
                <div class="col-md-5 mb-2 mb-md-0">
                    <div class="d-flex align-items-center">
                        <div class="p-2 rounded-3 me-3 bg-white text-dark shadow-sm">
                            <i class="fa fa-coffee fs-4" style="color: #541718;"/>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0 text-white d-flex align-items-center">
                                Bunna Bank | Project Management Executive Dashboard
                            </h5>
                            <span class="text-bunna-gold small">Strategic Portfolio Health, Milestone Velocity &amp; Resource Command Center</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="d-flex flex-wrap gap-2 justify-content-md-end align-items-center">
                        <!-- Initiative Filter -->
                        <div class="d-flex align-items-center">
                            <span class="me-1 small text-white fw-semibold">Initiative:</span>
                            <select class="form-select form-select-sm shadow-none" t-model="state.filters.initiative_id" t-on-change="onInitiativeChange">
                                <option value="">All Initiatives</option>
                                <t t-foreach="state.data.filters_data.initiatives" t-as="init" t-key="init.id">
                                    <option t-att-value="init.id" t-esc="init.name"/>
                                </t>
                            </select>
                        </div>
                        <!-- Project Filter (Cascades with Initiative) -->
                        <div class="d-flex align-items-center">
                            <span class="me-1 small text-white fw-semibold">Project:</span>
                            <select class="form-select form-select-sm shadow-none" t-model="state.filters.project_id" t-on-change="onProjectChange">
                                <option value="">All Projects</option>
                                <t t-if="!state.filters.initiative_id">
                                    <option value="non_project">Non-Project Tasks</option>
                                </t>
                                <t t-foreach="availableProjects" t-as="proj" t-key="proj.id">
                                    <option t-att-value="proj.id" t-esc="proj.name"/>
                                </t>
                            </select>
                        </div>
                        <!-- Task Filter -->
                        <div class="d-flex align-items-center">
                            <span class="me-1 small text-white fw-semibold">Task Filter:</span>
                            <select class="form-select form-select-sm shadow-none" t-model="state.filters.task_filter" t-on-change="onTaskFilterChange">
                                <option value="all">All Tasks</option>
                                <option value="open">Open Tasks</option>
                                <option value="completed">Completed Tasks</option>
                                <option value="blocked">Blocked Tasks</option>
                                <option value="overdue">Overdue Tasks</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. KPI Summary Cards Grid (7 Strategic Cards) -->
            <div class="row g-3 mb-4">
                <!-- Card 1: Strategic Initiatives -->
                <div class="col-xl col-md-4 col-sm-6">
                    <div class="card border-0 shadow-sm h-100 p-3 bg-white cursor-pointer border-bunna-maroon" t-on-click="() => this.openInitiatives()">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-muted small fw-semibold text-uppercase">Initiatives</div>
                                <h3 class="fw-bold my-1" style="color: #541718;" t-esc="state.data.kpi.total_initiatives"/>
                            </div>
                            <div class="p-2 rounded-circle bg-bunna-maroon-subtle">
                                <i class="fa fa-compass fs-5"/>
                            </div>
                        </div>
                        <div class="mt-2">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Portfolio Avg</span>
                                <span class="fw-bold" style="color: #541718;" t-esc="state.data.kpi.initiative_avg_progress + '%'"/>
                            </div>
                            <div class="progress" style="height: 5px;">
                                <div class="progress-bar progress-bar-maroon" t-att-style="'width: ' + state.data.kpi.initiative_avg_progress + '%'"/>
                            </div>
                            <div class="d-flex gap-1 mt-2">
                                <span class="badge badge-bunna-green cursor-pointer" style="font-size: 0.7rem;" t-on-click.stop="() => this.openActiveInitiatives()"><t t-esc="state.data.kpi.active_initiatives"/> Active</span>
                                <span class="badge badge-bunna-olive cursor-pointer" style="font-size: 0.7rem;" t-on-click.stop="() => this.openAchievedInitiatives()"><t t-esc="state.data.kpi.achieved_initiatives"/> Achieved</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Projects Portfolio -->
                <div class="col-xl col-md-4 col-sm-6">
                    <div class="card border-0 shadow-sm h-100 p-3 bg-white cursor-pointer border-bunna-green" t-on-click="() => this.openProjects()">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-muted small fw-semibold text-uppercase">Projects</div>
                                <h3 class="fw-bold my-1" style="color: #425727;" t-esc="state.data.kpi.total_projects"/>
                            </div>
                            <div class="p-2 rounded-circle bg-bunna-green-subtle">
                                <i class="fa fa-folder-open fs-5"/>
                            </div>
                        </div>
                        <div class="mt-2">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Execution Avg</span>
                                <span class="fw-bold" style="color: #425727;" t-esc="state.data.kpi.portfolio_progress + '%'"/>
                            </div>
                            <div class="progress" style="height: 5px;">
                                <div class="progress-bar progress-bar-bunna" t-att-style="'width: ' + state.data.kpi.portfolio_progress + '%'"/>
                            </div>
                            <div class="small text-muted mt-2">
                                <span>Total in Scope: </span><strong class="text-dark"><t t-esc="state.data.kpi.total_projects"/></strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Project Health Status -->
                <div class="col-xl col-md-4 col-sm-6">
                    <div class="card border-0 shadow-sm h-100 p-3 bg-white cursor-pointer border-bunna-green" t-on-click="() => this.openProjects([['health_state', '=', 'on_track']])">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-muted small fw-semibold text-uppercase">Health Status</div>
                                <h3 class="fw-bold my-1" style="color: #425727;"><t t-esc="state.data.kpi.health_counts.on_track"/> <span class="fs-6 fw-normal text-muted">On Track</span></h3>
                            </div>
                            <div class="p-2 rounded-circle bg-bunna-green-subtle">
                                <i class="fa fa-heartbeat fs-5"/>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-3 small">
                            <span class="badge badge-bunna-bronze cursor-pointer" t-on-click.stop="() => this.openProjects([['health_state', '=', 'at_risk']])"><t t-esc="state.data.kpi.health_counts.at_risk"/> At Risk</span>
                            <span class="badge badge-bunna-maroon cursor-pointer" t-on-click.stop="() => this.openProjects([['health_state', 'in', ['off_track', 'overdue']]])"><t t-esc="state.data.kpi.health_counts.overdue"/> Overdue</span>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Deliverables & Milestones -->
                <div class="col-xl col-md-4 col-sm-6">
                    <div class="card border-0 shadow-sm h-100 p-3 bg-white cursor-pointer border-bunna-olive" t-on-click="() => this.openDeliverables()">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-muted small fw-semibold text-uppercase">Deliverables</div>
                                <h3 class="fw-bold my-1" style="color: #726732;"><t t-esc="state.data.kpi.completed_deliverables"/> / <t t-esc="state.data.kpi.total_deliverables"/></h3>
                            </div>
                            <div class="p-2 rounded-circle bg-bunna-olive-subtle">
                                <i class="fa fa-cubes fs-5"/>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small cursor-pointer" t-on-click.stop="() => this.openMilestones()">
                            <span>Milestones: </span>
                            <strong class="text-dark"><t t-esc="state.data.kpi.completed_milestones"/>/<t t-esc="state.data.kpi.total_milestones"/> done</strong>
                        </div>
                    </div>
                </div>

                <!-- Card 5: Tasks Done -->
                <div class="col-xl col-md-4 col-sm-6">
                    <div class="card border-0 shadow-sm h-100 p-3 bg-white cursor-pointer border-bunna-navy" t-on-click="() => this.openTasks()">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-muted small fw-semibold text-uppercase">Tasks Done</div>
                                <h3 class="fw-bold my-1" style="color: #1D2B32;"><t t-esc="state.data.kpi.completed_tasks"/> / <t t-esc="state.data.kpi.total_tasks"/></h3>
                            </div>
                            <div class="p-2 rounded-circle bg-bunna-navy-subtle">
                                <i class="fa fa-tasks fs-5"/>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            <span class="badge badge-bunna-green cursor-pointer" t-on-click.stop="() => this.openOpenTasks()"><t t-esc="state.data.kpi.open_tasks"/> open</span>
                            <span class="badge badge-bunna-navy cursor-pointer ms-1" t-on-click.stop="() => this.openCompletedTasks()"><t t-esc="state.data.kpi.completed_tasks"/> done</span>
                        </div>
                    </div>
                </div>

                <!-- Card 6: Blocked Bottlenecks -->
                <div class="col-xl col-md-4 col-sm-6">
                    <div class="card border-0 shadow-sm h-100 p-3 bg-white cursor-pointer border-bunna-bronze" t-on-click="() => this.openBlockedTasks()">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-muted small fw-semibold text-uppercase">Blocked Tasks</div>
                                <h3 class="fw-bold my-1" style="color: #C17540;" t-esc="state.data.kpi.blocked_tasks"/>
                            </div>
                            <div class="p-2 rounded-circle bg-bunna-bronze-subtle">
                                <i class="fa fa-ban fs-5"/>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            <span t-if="state.data.kpi.blocked_tasks > 0" class="badge badge-bunna-maroon">Action Required</span>
                            <span t-else="" class="badge badge-bunna-green">Zero Blockers</span>
                        </div>
                    </div>
                </div>

                <!-- Card 7: Logged Hours vs Budget -->
                <div class="col-xl col-md-4 col-sm-6">
                    <div class="card border-0 shadow-sm h-100 p-3 bg-white cursor-pointer border-bunna-pine" t-on-click="() => this.openHoursLogged()">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-muted small fw-semibold text-uppercase">Hours Logged</div>
                                <h3 class="fw-bold my-1" style="color: #1E2917;" t-esc="state.data.kpi.total_logged_hours + 'h'"/>
                            </div>
                            <div class="p-2 rounded-circle bg-bunna-pine-subtle">
                                <i class="fa fa-clock-o fs-5"/>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            <span>Allocated: </span><strong class="text-dark"><t t-esc="state.data.kpi.total_allocated_hours + 'h'"/></strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. Analytical Charts Row (3-Column Layout) -->
            <div class="row g-3 mb-4">
                <!-- Chart 1: Stage Distribution -->
                <div class="col-lg-4 col-md-6">
                    <div class="card border-0 shadow-sm bg-white p-3 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="card-header-bunna mb-0">
                                <i class="fa fa-bar-chart me-2" style="color: #541718;"/> Tasks by Stage
                            </h6>
                            <span class="badge badge-bunna-maroon">Execution Pipeline</span>
                        </div>
                        <div style="height: 240px; position: relative;">
                            <canvas t-ref="stageChart"/>
                        </div>
                    </div>
                </div>

                <!-- Chart 2: Project Health Status -->
                <div class="col-lg-4 col-md-6">
                    <div class="card border-0 shadow-sm bg-white p-3 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="card-header-bunna mb-0">
                                <i class="fa fa-pie-chart me-2" style="color: #425727;"/> Project Health
                            </h6>
                            <span class="badge badge-bunna-green">Risk &amp; Delivery</span>
                        </div>
                        <div style="height: 240px; position: relative;">
                            <canvas t-ref="healthChart"/>
                        </div>
                    </div>
                </div>

                <!-- Chart 3: Resource Allocation & Workload -->
                <div class="col-lg-4 col-md-12">
                    <div class="card border-0 shadow-sm bg-white p-3 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="card-header-bunna mb-0">
                                <i class="fa fa-users me-2" style="color: #541718;"/> Resource Allocation &amp; Workload
                            </h6>
                            <span class="badge badge-bunna-maroon">Top Team Members</span>
                        </div>
                        <div style="height: 240px; position: relative;">
                            <canvas t-ref="workloadChart"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. Strategic Initiatives & Mandate Alignment (Dedicated Executive Section) -->
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm bg-white p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="card-header-bunna mb-0 d-flex align-items-center">
                                <i class="fa fa-compass me-2" style="color: #541718; font-size: 1.15rem;"/> Strategic Initiatives &amp; Transformation Programs
                            </h6>
                            <div class="d-flex gap-2">
                                <span class="badge badge-bunna-maroon">Corporate Alignment</span>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.78rem;" t-on-click="() => this.openInitiatives()">
                                    View All Initiatives <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 small">
                                <thead>
                                    <tr>
                                        <th>Ref Code</th>
                                        <th>Initiative Title</th>
                                        <th>Strategic Source</th>
                                        <th>Strategic Objective</th>
                                        <th>Strategic Sponsor</th>
                                        <th>Projects</th>
                                        <th>Timeline</th>
                                        <th style="width: 160px;">Progress</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="!state.data.tables.initiatives or state.data.tables.initiatives.length === 0">
                                        <tr>
                                            <td colspan="9" class="text-center text-muted py-4">
                                                <i class="fa fa-info-circle me-1"/> No initiatives match the selected filter.
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.data.tables.initiatives" t-as="init" t-key="init.id">
                                        <tr class="cursor-pointer" t-on-click="() => this.openInitiativeForm(init.id)">
                                            <td>
                                                <span class="badge bg-light text-dark border font-monospace" t-esc="init.code"/>
                                            </td>
                                            <td class="fw-semibold" style="color: #541718;" t-esc="init.name"/>
                                            <td>
                                                <span class="badge badge-bunna-maroon" t-esc="init.strategic_source"/>
                                            </td>
                                            <td>
                                                <span class="badge badge-bunna-olive" t-esc="init.strategic_objective"/>
                                            </td>
                                            <td class="text-muted" t-esc="init.owner_name"/>
                                            <td>
                                                <span class="badge bg-secondary rounded-pill" t-esc="init.project_count"/>
                                            </td>
                                            <td class="text-muted">
                                                <span t-esc="init.date_start"/> &#8594; <span t-esc="init.date_end"/>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-1">
                                                    <div class="progress flex-grow-1" style="height: 6px;">
                                                        <div class="progress-bar progress-bar-bunna" t-att-style="'width: ' + init.progress_rate + '%'"/>
                                                    </div>
                                                    <span class="small fw-semibold" t-esc="init.progress_rate + '%'"/>
                                                </div>
                                            </td>
                                            <td>
                                                <span t-att-class="init.state == 'achieved' ? 'badge badge-bunna-green' : (init.state == 'in_progress' ? 'badge badge-bunna-bronze' : 'badge bg-secondary')" t-esc="init.state"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. Operational Tables (Two Columns: Risks & Deadlines) -->
            <div class="row g-3">
                <!-- Table 1: Critical Risk Register & Blocked Tasks -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm bg-white p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="card-header-bunna mb-0">
                                <i class="fa fa-exclamation-triangle me-2" style="color: #C17540;"/> Critical Risk Register
                            </h6>
                            <span class="badge badge-bunna-bronze">Active Escalations</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 small">
                                <thead>
                                    <tr>
                                        <th>Risk Description</th>
                                        <th>Project</th>
                                        <th>Severity</th>
                                        <th>Mitigation</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="!state.data.tables.top_risks or state.data.tables.top_risks.length === 0">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-3">No high risks recorded.</td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.data.tables.top_risks" t-as="r" t-key="r.id">
                                        <tr class="cursor-pointer" t-on-click="() => this.openProjects()">
                                            <td class="fw-semibold text-dark" t-esc="r.name"/>
                                            <td class="text-muted" t-esc="r.project_name"/>
                                            <td>
                                                <span class="badge" t-att-class="r.severity >= 9 ? 'badge-bunna-maroon' : (r.severity >= 4 ? 'badge-bunna-bronze' : 'badge-bunna-green')" t-esc="r.severity"/>
                                            </td>
                                            <td class="text-truncate text-muted" style="max-width: 150px;" t-esc="r.mitigation"/>
                                            <td>
                                                <span class="badge" t-att-class="r.status == 'open' ? 'badge-bunna-bronze' : 'badge-bunna-green'" t-esc="r.status"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Table 1.2: Blocked Tasks & Bottlenecks -->
                    <div class="card border-0 shadow-sm bg-white p-3 mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="card-header-bunna mb-0">
                                <i class="fa fa-ban me-2" style="color: #C17540;"/> Blocked Tasks &amp; Bottlenecks
                            </h6>
                            <span class="badge badge-bunna-maroon">Action Required</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 small">
                                <thead>
                                    <tr>
                                        <th>Task</th>
                                        <th>Project</th>
                                        <th>Assignee</th>
                                        <th>Deadline</th>
                                        <th>Stage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="!state.data.tables.blocked_table or state.data.tables.blocked_table.length === 0">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-3">
                                                <i class="fa fa-check-circle text-success me-1"/> Zero Blockers — All tasks moving smoothly.
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.data.tables.blocked_table" t-as="b" t-key="b.id">
                                        <tr class="cursor-pointer" t-on-click="() => this.openTaskForm(b.id)">
                                            <td class="fw-semibold text-danger" t-esc="b.name"/>
                                            <td class="text-muted" t-esc="b.project_name"/>
                                            <td class="text-muted" t-esc="b.assignees"/>
                                            <td>
                                                <span t-att-class="b.is_overdue ? 'badge badge-bunna-maroon' : 'badge badge-bunna-bronze'" t-esc="b.date_deadline"/>
                                            </td>
                                            <td>
                                                <span class="badge bg-danger" t-esc="b.stage"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Table 2: Impending & Overdue Deadlines -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm bg-white p-3 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="card-header-bunna mb-0">
                                <i class="fa fa-clock-o me-2" style="color: #C17540;"/> Impending &amp; Overdue Deadlines
                            </h6>
                            <span class="badge badge-bunna-bronze">Action Timeline</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 small">
                                <thead>
                                    <tr>
                                        <th>Task</th>
                                        <th>Project</th>
                                        <th>Assignee</th>
                                        <th>Deadline</th>
                                        <th>Progress</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="!state.data.tables.deadline_table or state.data.tables.deadline_table.length === 0">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-3">No urgent or overdue tasks.</td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.data.tables.deadline_table" t-as="t" t-key="t.id">
                                        <tr class="cursor-pointer" t-on-click="() => this.openTaskForm(t.id)">
                                            <td class="fw-semibold" style="color: #425727;" t-esc="t.name"/>
                                            <td class="text-muted" t-esc="t.project_name"/>
                                            <td class="text-muted" t-esc="t.assignees"/>
                                            <td>
                                                <span t-att-class="t.is_overdue ? 'badge badge-bunna-maroon' : 'badge badge-bunna-bronze'" t-esc="t.date_deadline"/>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-1">
                                                    <div class="progress flex-grow-1" style="height: 5px;">
                                                        <div class="progress-bar progress-bar-bunna" t-att-style="'width: ' + t.progress_rate + '%'"/>
                                                    </div>
                                                    <span class="small text-muted" t-esc="t.progress_rate + '%'"/>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
