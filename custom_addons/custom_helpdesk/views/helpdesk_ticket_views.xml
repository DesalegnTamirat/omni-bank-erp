<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_helpdesk_ticket_form_inherit">
        <field name="name">helpdesk.ticket.form.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="custom_helpdesk.ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='parent_child']" position="after">
                <page string="Related Tickets">
                    <field name="related_ticket_ids" domain="[('id', '!=', id)]">
                        <list no_open="1">
                            <field name="create_date" />
                            <field name="number" />
                            <field name="name" />
                            <field name="partner_id" />
                            <button name="open_ticket" string="Open" type="object" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
