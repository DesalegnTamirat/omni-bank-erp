<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level Root Menu -->
    <menuitem
        id="helpdesk_ticket_main_menu"
        name="Helpdesk"
        web_icon="custom_helpdesk,static/description/icon.png"
        sequence="25"
    />

    <!-- Dashboard Menu -->
    <menuitem
        id="helpdesk_dashboard_menu"
        name="Dashboard"
        parent="helpdesk_ticket_main_menu"
        action="action_helpdesk_dashboard"
        sequence="1"
    />

    <!-- Tickets Parent Menu -->
    <menuitem
        id="helpdesk_ticket_menu"
        name="Tickets"
        parent="helpdesk_ticket_main_menu"
        sequence="10"
    />

    <!-- Action: All Tickets -->
    <record id="action_helpdesk_ticket_all" model="ir.actions.act_window">
        <field name="name">All Helpdesk Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
    <menuitem
        id="helpdesk_ticket_all_menu"
        name="All Tickets"
        parent="helpdesk_ticket_menu"
        action="action_helpdesk_ticket_all"
        sequence="10"
    />

    <!-- Action: My Tickets -->
    <record id="action_helpdesk_ticket_my" model="ir.actions.act_window">
        <field name="name">My Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>
    <menuitem
        id="helpdesk_ticket_my_menu"
        name="My Tickets"
        parent="helpdesk_ticket_menu"
        action="action_helpdesk_ticket_my"
        sequence="20"
    />

    <!-- Action: Unassigned Tickets -->
    <record id="action_helpdesk_ticket_unassigned" model="ir.actions.act_window">
        <field name="name">Unassigned Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('user_id', '=', False)]</field>
    </record>
    <menuitem
        id="helpdesk_ticket_unassigned_menu"
        name="Unassigned Tickets"
        parent="helpdesk_ticket_menu"
        action="action_helpdesk_ticket_unassigned"
        sequence="30"
    />

    <!-- Action: NBE Complaints -->
    <menuitem
        id="helpdesk_ticket_complaint_menu"
        name="NBE Complaints"
        parent="helpdesk_ticket_menu"
        action="action_helpdesk_ticket_complaints"
        sequence="40"
    />

    <!-- Action: Master Problems & Incidents -->
    <record id="action_helpdesk_ticket_problem" model="ir.actions.act_window">
        <field name="name">Master Problems &amp; Recurring Incidents</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_problem', '=', True)]</field>
    </record>
    <menuitem
        id="helpdesk_ticket_problem_menu"
        name="Master Problems"
        parent="helpdesk_ticket_menu"
        action="action_helpdesk_ticket_problem"
        sequence="50"
    />

    <!-- Queue Management Actions (BRD Requirement 7) -->
    <record id="action_helpdesk_queue_product" model="ir.actions.act_window">
        <field name="name">Operational Queue: By Product / Service</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_group_by_service_family': 1}</field>
    </record>
    <menuitem
        id="helpdesk_queue_product_menu"
        name="Queue: By Product / Service"
        parent="helpdesk_ticket_menu"
        action="action_helpdesk_queue_product"
        sequence="60"
    />

    <record id="action_helpdesk_queue_work_unit" model="ir.actions.act_window">
        <field name="name">Operational Queue: By Work Unit</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_group_by_work_unit': 1}</field>
    </record>
    <menuitem
        id="helpdesk_queue_work_unit_menu"
        name="Queue: By Work Unit (2nd Level)"
        parent="helpdesk_ticket_menu"
        action="action_helpdesk_queue_work_unit"
        sequence="70"
    />

    <record id="action_helpdesk_queue_language" model="ir.actions.act_window">
        <field name="name">Operational Queue: By Language</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_group_by_language': 1}</field>
    </record>
    <menuitem
        id="helpdesk_queue_language_menu"
        name="Queue: By Language"
        parent="helpdesk_ticket_menu"
        action="action_helpdesk_queue_language"
        sequence="80"
    />

    <!-- Knowledge Base Menu -->
    <menuitem
        id="helpdesk_knowledge_menu"
        name="Knowledge Base"
        parent="helpdesk_ticket_main_menu"
        action="action_helpdesk_knowledge_article"
        sequence="20"
    />

    <!-- Configuration Parent Menu -->
    <menuitem
        id="helpdesk_ticket_config_menu"
        name="Configuration"
        parent="helpdesk_ticket_main_menu"
        sequence="100"
    />

    <!-- Work Units Config -->
    <record id="action_helpdesk_work_units" model="ir.actions.act_window">
        <field name="name">Work Units &amp; Directorates</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
    <menuitem
        id="helpdesk_work_units_config_menu"
        name="Work Units &amp; Directorates"
        parent="helpdesk_ticket_config_menu"
        action="action_helpdesk_work_units"
        sequence="5"
    />

    <!-- Users & Security Profiles Config -->
    <record id="action_helpdesk_users" model="ir.actions.act_window">
        <field name="name">Users &amp; Security Profiles</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
    <menuitem
        id="helpdesk_users_config_menu"
        name="Users &amp; Security Profiles"
        parent="helpdesk_ticket_config_menu"
        action="action_helpdesk_users"
        sequence="8"
    />

    <!-- Service Families Config -->
    <menuitem
        id="helpdesk_service_family_config_menu"
        name="Service Families"
        parent="helpdesk_ticket_config_menu"
        action="action_helpdesk_service_family"
        sequence="10"
    />

    <!-- Categories Config -->
    <menuitem
        id="helpdesk_ticket_category_config_menu"
        name="Categories &amp; Sub-Services"
        parent="helpdesk_ticket_config_menu"
        action="action_helpdesk_ticket_category"
        sequence="20"
    />

    <!-- Teams Config -->
    <menuitem
        id="helpdesk_ticket_team_config_menu"
        name="Helpdesk Teams (1st/2nd Level)"
        parent="helpdesk_ticket_config_menu"
        action="action_helpdesk_ticket_team"
        sequence="30"
    />

    <!-- Stages Config -->
    <menuitem
        id="helpdesk_ticket_stage_config_menu"
        name="Ticket Stages"
        parent="helpdesk_ticket_config_menu"
        action="action_helpdesk_ticket_stage"
        sequence="40"
    />

    <!-- SLA Policies Config -->
    <menuitem
        id="helpdesk_sla_config_menu"
        name="SLA &amp; OLA Policies"
        parent="helpdesk_ticket_config_menu"
        action="action_helpdesk_sla_tree"
        sequence="50"
    />

    <!-- Channels Config -->
    <menuitem
        id="helpdesk_ticket_channel_config_menu"
        name="Channels"
        parent="helpdesk_ticket_config_menu"
        action="action_helpdesk_ticket_channel"
        sequence="60"
    />

    <!-- Tags Config -->
    <menuitem
        id="helpdesk_ticket_tag_config_menu"
        name="Tags"
        parent="helpdesk_ticket_config_menu"
        action="action_helpdesk_ticket_tag"
        sequence="70"
    />

    <!-- Ticket Types Config -->
    <menuitem
        id="helpdesk_ticket_type_config_menu"
        name="Ticket Types"
        parent="helpdesk_ticket_config_menu"
        action="action_helpdesk_ticket_type"
        sequence="80"
    />

    <!-- Contextual List Actions: Bulk Update & Merge (Requirements 27 & 28) -->
    <record id="action_server_merge_tickets" model="ir.actions.server">
        <field name="name">Merge Selected Duplicate Tickets</field>
        <field name="model_id" ref="custom_helpdesk.model_helpdesk_ticket"/>
        <field name="binding_model_id" ref="custom_helpdesk.model_helpdesk_ticket"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
records[:1].action_merge_tickets()
        </field>
    </record>

    <record id="action_server_bulk_escalate" model="ir.actions.server">
        <field name="name">Bulk Escalate to 2nd Level Work Unit</field>
        <field name="model_id" ref="custom_helpdesk.model_helpdesk_ticket"/>
        <field name="binding_model_id" ref="custom_helpdesk.model_helpdesk_ticket"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
for ticket in records:
    ticket.action_escalate()
        </field>
    </record>

    <record id="action_server_bulk_assign_to_me" model="ir.actions.server">
        <field name="name">Bulk Assign to Me</field>
        <field name="model_id" ref="custom_helpdesk.model_helpdesk_ticket"/>
        <field name="binding_model_id" ref="custom_helpdesk.model_helpdesk_ticket"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
records.write({'user_id': env.user.id, 'assigned_date': datetime.datetime.now()})
        </field>
    </record>
</odoo>
