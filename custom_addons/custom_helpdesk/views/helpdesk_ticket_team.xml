<odoo>
    <record id="view_helpdesk_ticket_team_type" model="ir.ui.view">
        <field name="name">helpdesk.ticket.team.type.form</field>
        <field name="model">helpdesk.ticket.team</field>
        <field name="inherit_id" ref="custom_helpdesk.view_helpdesk_team_form" />
        <field name="arch" type="xml">
            <field name="show_in_portal" position="after">
                <field name="type_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>
    <record id="action_helpdesk_ticket_team" model="ir.actions.act_window">
        <field name="name">Helpdesk Teams</field>
        <field name="res_model">helpdesk.ticket.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

