<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Service Family Form View -->
    <record id="view_helpdesk_service_family_form" model="ir.ui.view">
        <field name="name">helpdesk.service.family.form</field>
        <field name="model">helpdesk.service.family</field>
        <field name="arch" type="xml">
            <form string="Service Family">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Service Family Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Service family scope and details..."/>
                        </page>
                        <page string="Categories / Sub-Services" name="categories">
                            <field name="category_ids">
                                <list string="Categories">
                                    <field name="name"/>
                                    <field name="complete_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Service Family Tree View -->
    <record id="view_helpdesk_service_family_tree" model="ir.ui.view">
        <field name="name">helpdesk.service.family.list</field>
        <field name="model">helpdesk.service.family</field>
        <field name="arch" type="xml">
            <list string="Service Families">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Service Family Action -->
    <record id="action_helpdesk_service_family" model="ir.actions.act_window">
        <field name="name">Service Families</field>
        <field name="res_model">helpdesk.service.family</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
