<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- NBE Complaints Action -->
    <record id="action_helpdesk_ticket_complaints" model="ir.actions.act_window">
        <field name="name">NBE Customer Complaints</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_complaint', '=', True)]</field>
        <field name="context">{'default_is_complaint': True, 'default_case_type': 'complaint'}</field>
    </record>
</odoo>
