<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Ticket Sequence -->
    <record id="seq_helpdesk_ticket" model="ir.sequence">
        <field name="name">Helpdesk Ticket Sequence</field>
        <field name="code">helpdesk.ticket.sequence</field>
        <field name="prefix">TICK/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Seed Helpdesk Lifecycle Stages (BRD Requirement 10) -->
    <record id="stage_new" model="helpdesk.ticket.stage">
        <field name="name">New</field>
        <field name="sequence">10</field>
        <field name="unattended">True</field>
    </record>
    <record id="stage_assigned" model="helpdesk.ticket.stage">
        <field name="name">Assigned</field>
        <field name="sequence">20</field>
        <field name="unattended">False</field>
    </record>
    <record id="stage_in_progress" model="helpdesk.ticket.stage">
        <field name="name">In Progress</field>
        <field name="sequence">30</field>
        <field name="unattended">False</field>
    </record>
    <record id="stage_pending_customer" model="helpdesk.ticket.stage">
        <field name="name">Pending Customer</field>
        <field name="sequence">40</field>
        <field name="unattended">False</field>
    </record>
    <record id="stage_pending_third_party" model="helpdesk.ticket.stage">
        <field name="name">Pending Third Party</field>
        <field name="sequence">50</field>
        <field name="unattended">False</field>
    </record>
    <record id="stage_escalated" model="helpdesk.ticket.stage">
        <field name="name">Escalated to 2nd Level</field>
        <field name="sequence">60</field>
        <field name="unattended">False</field>
    </record>
    <record id="stage_resolved" model="helpdesk.ticket.stage">
        <field name="name">Resolved</field>
        <field name="sequence">70</field>
        <field name="closed">True</field>
    </record>
    <record id="stage_closed" model="helpdesk.ticket.stage">
        <field name="name">Closed</field>
        <field name="sequence">80</field>
        <field name="closed">True</field>
    </record>

    <!-- Cron Job: Automatic Escalation of Overdue/Expired SLA Tickets (BRD Requirement 9) -->
    <record id="ir_cron_sla_escalation" model="ir.cron">
        <field name="name">Automated Ticket SLA &amp; Overdue Escalation</field>
        <field name="active" eval="True" />
        <field name="model_id" ref="custom_helpdesk.model_helpdesk_ticket" />
        <field name="state">code</field>
        <field name="code">model._cron_check_sla_escalations()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')" />
    </record>

    <record id="ir_cron_close_inactive_tickets" model="ir.cron">
        <field name="name">Close Inactive Tickets</field>
        <field name="active" eval="True" />
        <field name="model_id" ref="custom_helpdesk.model_helpdesk_ticket_team" />
        <field name="state">code</field>
        <field name="code">
model.close_team_inactive_tickets()
        </field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(minutes=1)).strftime('%Y-%m-%d %H:%M:%S')"
        />
    </record>
    <record id="warning_inactive_ticket_template" model="mail.template">
        <field name="name">Helpdesk Inactivity Warning Ticket Notification Email</field>
        <field name="model_id" ref="custom_helpdesk.model_helpdesk_ticket" />
        <field name="email_from">{{object.company_id.partner_id.email}}</field>
        <field
            name="email_cc"
        >{{not object.partner_id and object.partner_email or ''}},</field>
        <field name="subject">The ticket {{object.number}} will be closed.</field>
        <field name="partner_to">{{object.partner_id.id}}</field>
        <field name="auto_delete" eval="False" />
        <field name="lang">{{object.partner_id.lang}}</field>
        <field name="body_html" type="html">
            <table
                border="0"
                width="100%"
                cellpadding="0"
                bgcolor="#ededed"
                style="padding: 20px; background-color: #ededed; border-collapse:separate;"
            >
                <tbody>
                    <!-- HEADER -->
                    <tr>
                        <td align="center" style="min-width: 590px;">
                            <table
                                width="590"
                                border="0"
                                cellpadding="0"
                                bgcolor="#875A7B"
                                style="min-width: 590px; background-color: rgb(135,90,123); padding: 20px; border-collapse:separate;"
                            >
                                <tr>
                                    <td valign="middle" align="right">
                                        <img
                                            t-att-src="'/logo.png?company=%s' % object.company_id.id"
                                            style="padding: 0px; margin: 0px; height: auto; width: 80px;"
                                            t-att-alt="'%s' % object.company_id.name"
                                        />
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <!-- CONTENT -->
                    <tr>
                        <td align="center" style="min-width: 590px;">
                            <table
                                width="590"
                                border="0"
                                cellpadding="0"
                                bgcolor="#ffffff"
                                style="min-width: 590px; background-color: rgb(255, 255, 255); padding: 20px; border-collapse:separate;"
                            >
                                <tbody>
                                    <td
                                        valign="top"
                                        style="font-family:Arial,Helvetica,sans-serif; color: #555; font-size: 14px;"
                                    >
                                        <p>Ticket with subject "<t
                                            t-out="object.display_name"
                                        />" will be closed in <t
                                            t-out="ctx.get('remaining_days')"
                                        /> days if it is not updated .</p>
                                    </td>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <!-- FOOTER -->
                    <tr>
                        <td align="center" style="min-width: 590px;">
                            <table
                                width="590"
                                border="0"
                                cellpadding="0"
                                bgcolor="#875A7B"
                                style="min-width: 590px; background-color: rgb(135,90,123); padding: 20px; border-collapse:separate;"
                            >
                                <tr>
                                    <td
                                        valign="middle"
                                        align="left"
                                        style="color: #fff; padding-top: 10px; padding-bottom: 10px; font-size: 12px;"
                                    >
                                        <t t-out="object.company_id.phone" />
                                    </td>
                                    <td
                                        valign="middle"
                                        align="left"
                                        style="color: #fff; padding-top: 10px; padding-bottom: 10px; font-size: 12px;"
                                    >
                                        <t t-out="object.company_id.email" />
                                    </td>
                                    <td
                                        valign="middle"
                                        align="left"
                                        style="color: #fff; padding-top: 10px; padding-bottom: 10px; font-size: 12px;"
                                    >
                                        <t t-out="object.company_id.website" />
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </field>
    </record>

    <!-- Bunna Bank Service Family Seed Data -->
    <record id="service_family_cbs" model="helpdesk.service.family">
        <field name="name">CBS Service</field>
        <field name="code">CBS</field>
        <field name="description">Conventional Core Banking System Products and Services</field>
    </record>
    <record id="service_family_dfs" model="helpdesk.service.family">
        <field name="name">Digital Financial Services</field>
        <field name="code">DFS</field>
        <field name="description">Digital Financial Services including ATM, Telebirr, A2A, DFS Loan &amp; Repayments</field>
    </record>
    <record id="service_family_dao" model="helpdesk.service.family">
        <field name="name">Digital Account Opening</field>
        <field name="code">DAO</field>
        <field name="description">Digital Account Opening and Verification Services</field>
    </record>
    <record id="service_family_dispute" model="helpdesk.service.family">
        <field name="name">Digital Transaction / Dispute Service</field>
        <field name="code">DISPUTE</field>
        <field name="description">On Us ATM Case, Off Us ATM Dispute, Mobile App &amp; USSD Transfer Cases</field>
    </record>
    <!-- Multi-Channel Seed Data (BRD Requirement 22) -->
    <record id="channel_phone" model="helpdesk.ticket.channel">
        <field name="name">Phone / Call Center</field>
    </record>
    <record id="channel_email" model="helpdesk.ticket.channel">
        <field name="name">Email Intake</field>
    </record>
    <record id="channel_web_portal" model="helpdesk.ticket.channel">
        <field name="name">Web Customer Portal</field>
    </record>
    <record id="channel_chatbot" model="helpdesk.ticket.channel">
        <field name="name">AI Chatbot</field>
    </record>
    <record id="channel_whatsapp" model="helpdesk.ticket.channel">
        <field name="name">WhatsApp Messaging</field>
    </record>
    <record id="channel_telegram" model="helpdesk.ticket.channel">
        <field name="name">Telegram Bot</field>
    </record>
    <record id="channel_facebook" model="helpdesk.ticket.channel">
        <field name="name">Facebook Messenger</field>
    </record>
    <record id="channel_instagram" model="helpdesk.ticket.channel">
        <field name="name">Instagram Direct</field>
    </record>
    <record id="channel_sms" model="helpdesk.ticket.channel">
        <field name="name">SMS Banking Service</field>
    </record>
    <record id="channel_mobile_banking" model="helpdesk.ticket.channel">
        <field name="name">Mobile Banking App</field>
    </record>
</odoo>
