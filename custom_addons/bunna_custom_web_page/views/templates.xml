<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>



        <record id="menu_jobs" model="website.menu">
            <field name="name">Jobs</field>
            <field name="url">/jobs</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" eval="51"/>
        </record>

        <record id="menu_courses" model="website.menu">
            <field name="name">Courses</field>
            <field name="url">/courses</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" eval="52"/>
        </record>

        <record id="menu_tender" model="website.menu">
            <field name="name">Tender</field>
            <field name="url">/tender</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" eval="53"/>
        </record>

        <record id="menu_policies" model="website.menu">
            <field name="name">Policies and Documents</field>
            <field name="url">/policies</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" eval="55"/>
        </record>

        <record id="menu_faqs" model="website.menu">
            <field name="name">FAQs</field>
            <field name="url">/faq</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" eval="56"/>
        </record>


        <template id="custom_header_logo" inherit_id="website.navbar_nav" name="Bunna Header Realignment">

            <!-- 1. Inject brand colors and fix link colors -->
            <xpath expr="//ul" position="before">

                <style>
                    /* Style the navbar and ensure all links are white */
                    .navbar { background-color: #1d2b32 !important; border-bottom: 3px solid #c17540; }
                    .navbar .nav-link, .navbar .dropdown-toggle { color: #ffffff !important; }

                    /* Hover/active state using the terracotta accent */
                    .navbar .nav-link:hover, .navbar .nav-link.active {
                    color: #c17540 !important;
                    }

                    /* Ensure the logo wrapper is properly padded */
                    .logo-container { padding: 5px; }
                </style>
            </xpath>

            <xpath expr="//ul" position="attributes">
                <attribute name="t-attf-class">#{'nav navbar-nav d-flex flex-row flex-nowrap align-items-center w-100' if request.env.user._is_public() else 'd-none'}</attribute>
            </xpath>

            <xpath expr="//ul" position="after">
                <style t-if="request.env.user._is_public()">
                    .o_searchbar_form, .o_wsale_products_searchbar_form, .o_search_nav_item,
                    a[href*='/search'], .o_nav_search_box, button[data-bs-target*='search'] { display: none !important; }
                    #top_menu a[href*='/contactus'], #top_menu a[href*='/contact_us'] { display: none !important; }
                </style>

                <!-- Hide phone number for ALL users (logged in AND logged out) -->
                <style>
                    .o_header_phone, a[href^='tel:'], .fa-phone { display: none !important; }
                </style>
            </xpath>


            <xpath expr="//ul" position="inside">
                <li t-if="request.env.user._is_public()" class="nav-item dropdown mx-2">
                    <!-- Changed text-dark to text-white for visibility -->
                    <a class="nav-link dropdown-toggle text-white fw-medium"
                       href="#"
                       id="empServicesDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false"
                       style="font-size: 16px; white-space: nowrap;">
                        Employee Service's
                    </a>
                    <ul class="dropdown-menu shadow border-0 p-3 mt-2"
                        aria-labelledby="empServicesDropdown"
                        style="min-width: 560px; border-radius: 4px;">
                        <style>
                            .emp-services-menu { display: flex; gap: 2rem; }
                            .emp-services-section h6 {
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            text-transform: uppercase;
                            color: #333;
                            border-bottom: 2px solid #009688;
                            padding-bottom: 6px;
                            margin-bottom: 10px;
                            }
                            .emp-services-section a {
                            display: block;
                            color: #009688;
                            font-size: 14px;
                            padding: 4px 0;
                            text-decoration: none;
                            }
                            .emp-services-section a:hover { text-decoration: underline; }
                        </style>
                        <li>
                            <div class="emp-services-menu">
                                <!-- SELF SERVICE -->
                                <div class="emp-services-section" style="min-width: 160px;">
                                    <h6>Self Service</h6>
                                    <a href="/odoo/payslips">View Payslip</a>
                                    <a href="/odoo/time-off">Request Leave</a>
                                </div>
                                <!-- SERVICE REQUEST -->
                                <div class="emp-services-section" style="min-width: 220px;">
                                    <h6>Service Request</h6>
                                    <a href="/odoo/employee-service-requests/new?sr_category=Others&amp;letter_name=Medical+Expense+Claim">Medical Expense Claim</a>
                                    <a href="/odoo/employee-service-requests/new?sr_category=Self+Service+Letter&amp;letter_name=Guarantee+Letter">Guarantee Letter Request</a>
                                    <a href="/odoo/employee-service-requests/new?sr_category=Self+Service+Letter&amp;letter_name=Support+Letter">Support Letter Request</a>
                                    <a href="/odoo/employee-service-requests/new?sr_category=Others&amp;letter_name=Marriage+Gift">Marriage Gift Request</a>
                                    <a href="/odoo/employee-service-requests/new?sr_category=Others&amp;letter_name=Transportation">Transportation</a>
                                    <a href="/odoo/employee-service-requests/new?sr_category=Others&amp;letter_name=Tuition+Fee">Tuition Fee Request</a>
                                </div>
                            </div>
                        </li>
                    </ul>
                </li>
            </xpath>
        </template>


        <template id="hello_page_template" name="Bunna Internal Portal">
            <t t-call="website.layout">
                <style>
                    /* Hero Welcome Section */
                    .hero-welcome {
                    background: #ffffff;
                    color: #4a1515;
                    padding: 4rem 0;
                    text-align: center;
                    border-bottom: 5px solid #b38b59;
                    }
                    .hero-welcome h1 { font-size: 3rem; font-weight: 800; }
                    .hero-welcome p { font-size: 1.25rem; opacity: 0.9; }


                </style>

                <div id="wrap">
                    <!-- Hero Welcome Header -->
                    <div class="hero-welcome">
                        <div class="container">
                            <h1 class="mb-3">Welcome to the Bunna Internal Portal</h1>
                            <p>Empowering our team with seamless ERP solutions. Hello, <span t-esc="user_name"/>.</p>
                        </div>
                    </div>

                    <div class="oe_structure py-5 bunna-gradient">
                        <div class="container mb-5">
                            <div class="row g-4">
                                <!-- Vision -->
                                <div class="col-md-6">
                                    <div class="p-5 bg-white rounded-4 h-100 shadow-sm border-start border-5 border-danger card-hover">
                                        <h2 class="fw-bold mb-3 bank-text"><i class="fa fa-eye me-2"></i> Our Vision</h2>
                                        <p class="text-muted fs-5 lh-base mb-0">To Be One of the Top Three Financial Services Provider in Ethiopia by the year 2030.</p>
                                    </div>
                                </div>
                                <!-- Mission -->
                                <div class="col-md-6">
                                    <div class="p-5 bg-white rounded-4 h-100 shadow-sm border-start border-5 border-danger card-hover">
                                        <h2 class="fw-bold mb-3 bank-text"><i class="fa fa-rocket me-2"></i> Our Mission</h2>
                                        <p class="text-muted fs-5 lh-base mb-0">To deliver platform-based financial services by collaborating with partners, elevating the value for stakeholders.</p>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <!-- Core Values Section -->
                        <div class="container mb-5">
                            <h2 class="text-center fw-bold mb-5 bank-text">Our Core Values</h2>
                            <div class="row g-4 justify-content-center">

                                <!-- Core Value 01 -->
                                <div class="col-lg-2 col-md-4">
                                    <div class="p-4 bg-white rounded-4 shadow-sm h-100 card-hover border-top border-4 border-danger">
                                        <h6 class="fw-bold text-uppercase bank-text mb-2">01 Winning</h6>
                                        <small class="text-muted">Striving for excellence and professionalism with an ethical competitive edge.</small>
                                    </div>
                                </div>

                                <!-- Core Value 02 -->
                                <div class="col-lg-2 col-md-4">
                                    <div class="p-4 bg-white rounded-4 shadow-sm h-100 card-hover border-top border-4 border-danger">
                                        <h6 class="fw-bold text-uppercase bank-text mb-2">02 Respect</h6>
                                        <small class="text-muted">Valuing contributions from customers, shareholders, and our community.</small>
                                    </div>
                                </div>

                                <!-- Core Value 03 -->
                                <div class="col-lg-2 col-md-4">
                                    <div class="p-4 bg-white rounded-4 shadow-sm h-100 card-hover border-top border-4 border-danger">
                                        <h6 class="fw-bold text-uppercase bank-text mb-2">03 Responsibility</h6>
                                        <small class="text-muted">Acting with purpose to balance stakeholder interests and fiscal duties.</small>
                                    </div>
                                </div>

                                <!-- Core Value 04 -->
                                <div class="col-lg-2 col-md-4">
                                    <div class="p-4 bg-white rounded-4 shadow-sm h-100 card-hover border-top border-4 border-danger">
                                        <h6 class="fw-bold text-uppercase bank-text mb-2">04 Collaboration</h6>
                                        <small class="text-muted">Supporting our customers, regulatory bodies, and society through collective care.</small>
                                    </div>
                                </div>

                                <!-- Core Value 05 -->
                                <div class="col-lg-2 col-md-4">
                                    <div class="p-4 bg-white rounded-4 shadow-sm h-100 card-hover border-top border-4 border-danger">
                                        <h6 class="fw-bold text-uppercase bank-text mb-2">05 Innovation</h6>
                                        <small class="text-muted">Relentlessly pursuing groundbreaking ideas to shape the future of banking.</small>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="jobs_coming_soon_template" name="Jobs Coming Soon">
