                                            <div class="accordion-body text-muted">
                                                Please contact the IT Helpdesk immediately via your internal dashboard or by calling the extension 9030. Provide your terminal ID and a screenshot of the error.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Q2 -->
                                    <div class="accordion-item shadow-sm">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q2">
                                                When will the Odoo 19 migration be complete?
                                            </button>
                                        </h2>
                                        <div id="q2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                            <div class="accordion-body text-muted">
                                                The migration is currently in the validation phase. We expect full implementation by the end of Q3 2026. Updates will be posted on the portal homepage.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Q3 -->
                                    <div class="accordion-item shadow-sm">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q3">
                                                How do I access my payroll documents?
                                            </button>
                                        </h2>
                                        <div id="q3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                            <div class="accordion-body text-muted">
                                                Payroll slips are available through the "Employee Services" dropdown in the main navigation menu under the dedicated HR portal link.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="custom_login_decor" inherit_id="web.login" name="Bunna Login Decor">
            <xpath expr="//form" position="before">
                <style>
                    /* 1. Center only the login content area — header/footer stay in normal flow */
                    main {
                    display: flex !important;
                    align-items: center !important;
                    justify-content: center !important;
                    min-height: calc(100vh - 64px - 220px) !important;
                    padding: 2rem 0 !important;
                    background: #f2f6f8 !important;
                    }

                    /* 2. Minimalist Card */
                    .oe_login_form {
                    background: #ffffff;
                    padding: 2rem !important;
                    border-radius: 1rem;
                    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
                    border-top: 4px solid #1d2b32;
                    max-width: 320px !important;
                    width: 100% !important;
                    }

                    /* 3. Refined Input Fields */
                    .oe_login_form input {
                    border: 1px solid #dee2e6 !important;
                    border-radius: 0.5rem !important;
                    padding: 0.7rem !important;
                    margin-bottom: 1rem !important;
                    background-color: #fcfcfc !important;
                    transition: border-color 0.3s ease;
                    }
                    .oe_login_form input:focus {
                    border-color: #1d2b32 !important;
                    box-shadow: 0 0 0 0.2rem rgba(29, 43, 50, 0.1) !important;
                    }

                    /* 3b. Fix password field + eye-toggle button alignment inside input-group */
                    .oe_login_form .input-group {
                    align-items: stretch !important;
                    }
                    .oe_login_form .input-group input {
                    border-top-right-radius: 0 !important;
                    border-bottom-right-radius: 0 !important;
                    border-right: none !important;
                    margin-bottom: 0 !important;
                    }
                    .oe_login_form .input-group .o_show_password {
                    border: 1px solid #dee2e6 !important;
                    border-left: none !important;
                    border-top-right-radius: 0.5rem !important;
                    border-bottom-right-radius: 0.5rem !important;
                    background-color: #fcfcfc !important;
                    padding: 0.7rem !important;
                    display: flex !important;
                    align-items: center !important;
                    }
                    .oe_login_form .input-group:focus-within .o_show_password {
                    border-color: #1d2b32 !important;
                    }
                    .oe_login_form input:focus {
                    border-color: #1d2b32 !important;
                    box-shadow: 0 0 0 0.2rem rgba(29, 43, 50, 0.1) !important;
                    }

                    /* 4. Primary Log In button */
                    .oe_login_form .oe_login_buttons > button.btn-primary {
                    background-color: #1d2b32 !important;
                    color: #ffffff !important;
                    border: none !important;
                    border-radius: 0.5rem !important;
                    padding: 0.7rem !important;
                    font-weight: 600;
                    width: 100%;
                    transition: background-color 0.3s ease;
                    }
                    .oe_login_form .oe_login_buttons > button.btn-primary:hover {
                    background-color: #c17540 !important;
                    }

                    /* 5. Cleanup: Remove Odoo defaults + superuser button */
                    .o_login_header, .o_logo, .oe_logo, .o_login_auth, .oe_login_passkey,
                    .o_login_passkey_section, div[class*='passkey'],
