<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bunna_pbms.PbmsDashboard">
        <div class="o_pbms_dashboard">
            <!-- Loading Spinner -->
            <div t-if="state.loading" class="d-flex justify-content-center align-items-center" style="height: 60vh;">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading Dashboard...</span>
                </div>
            </div>

            <div t-else="">
                <!-- HEADER BAR -->
                <div class="dashboard-header d-flex flex-wrap justify-content-between align-items-center p-3 mb-4 rounded-3 shadow-sm"
                     style="background: #541718; color: #FFFFFF;">
                    <div class="d-flex flex-column">
                        <h3 class="fw-bold mb-1 text-white">Planning &amp; Budget Dashboard</h3>
                        <span class="text-white-50 small">Real-time status, KPI summaries, and planning pipeline analytics</span>
                    </div>

                    <div class="d-flex align-items-center gap-3 mt-2 mt-md-0">
                        <!-- Cycle Dropdown -->
                        <div class="d-flex align-items-center gap-2 position-relative">
                            <label class="mb-0 fw-semibold text-white small">Cycle:</label>
                            <button type="button"
                                    class="pbms-custom-select d-flex align-items-center justify-content-between"
                                    t-on-click="toggleCycleDropdown">
                                <span class="text-truncate me-2" t-esc="getSelectedCycleName()"/>
                                <i class="fa fa-chevron-down small"/>
                            </button>
                            <div t-if="state.cycleDropdownOpen"
                                 class="pbms-dropdown-menu position-absolute end-0 mt-1 shadow-lg"
                                 style="top: 100%; min-width: 220px; z-index: 1050; max-height: 280px; overflow-y: auto;">
                                <t t-foreach="state.cycles" t-as="cycle" t-key="cycle.id">
                                    <button type="button"
                                            class="dropdown-item d-flex justify-content-between align-items-center py-2 px-3 border-0"
                                            t-att-class="{'active-item fw-bold': state.cycleId == cycle.id}"
                                            t-on-click="() => this.selectCycle(cycle.id)">
                                        <span t-esc="cycle.name"/>
                                        <span class="badge bg-secondary ms-2" t-esc="cycle.state"/>
                                    </button>
                                </t>
                            </div>
                        </div>

                        <!-- Plan Type Dropdown -->
                        <div class="d-flex align-items-center gap-2 position-relative">
                            <label class="mb-0 fw-semibold text-white small">Plan Type:</label>
                            <button type="button"
                                    class="pbms-custom-select d-flex align-items-center justify-content-between"
                                    t-on-click="togglePlanTypeDropdown">
                                <span class="text-truncate me-2" t-esc="getSelectedPlanTypeName()"/>
                                <i class="fa fa-chevron-down small"/>
                            </button>
                            <div t-if="state.planTypeDropdownOpen"
                                 class="pbms-dropdown-menu position-absolute end-0 mt-1 shadow-lg"
                                 style="top: 100%; min-width: 240px; z-index: 1050; max-height: 280px; overflow-y: auto;">
                                <t t-foreach="state.planTypes" t-as="plan" t-key="plan.id">
                                    <button type="button"
                                            class="dropdown-item py-2 px-3 border-0"
                                            t-att-class="{'active-item fw-bold': state.selectedModel == plan.id}"
                                            t-on-click="() => this.selectPlanType(plan.id)">
                                        <span t-esc="plan.name"/>
                                    </button>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4 KPI CARDS ROW -->
                <div class="row g-3 mb-4">
                    <!-- TOTAL SUBMISSIONS -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="kpi-card kpi-total h-100 p-3 rounded-3 shadow-sm text-white"
                             style="background: #541718; cursor: pointer;"
                             t-on-click="() => this.openKPIView()">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-uppercase fw-semibold small text-white-50" style="letter-spacing: 0.5px;">TOTAL SUBMISSIONS</span>
                                <div class="kpi-icon rounded-2 p-2 d-flex align-items-center justify-content-center"
                                     style="background: rgba(255,255,255,0.12); width: 36px; height: 36px;">
                                    <i class="fa fa-folder-open text-white"/>
                                </div>
                            </div>
                            <div class="fs-2 fw-bold text-white mb-3" t-esc="getTotalSubmissions()"/>
                            <div class="progress mb-2" style="height: 3px; background: rgba(255,255,255,0.2);">
                                <div class="progress-bar bg-white" style="width: 100%;"/>
                            </div>
                            <div class="d-flex justify-content-end align-items-center">
                                <span class="small text-white-50 text-decoration-none">Click to view all</span>
                            </div>
                        </div>
                    </div>

                    <!-- DRAFT -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="kpi-card kpi-draft h-100 p-3 rounded-3 shadow-sm text-white"
                             style="background: #1E2917; cursor: pointer;"
                             t-on-click="() => this.openKPIView('draft')">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-uppercase fw-semibold small text-white-50" style="letter-spacing: 0.5px;">DRAFT</span>
                                <div class="kpi-icon rounded-2 p-2 d-flex align-items-center justify-content-center"
                                     style="background: rgba(255,255,255,0.12); width: 36px; height: 36px;">
                                    <i class="fa fa-pencil-square-o text-white"/>
                                </div>
                            </div>
                            <div class="fs-2 fw-bold text-white mb-3" t-esc="getTotalByStatus('draft')"/>
                            <div class="progress mb-2" style="height: 3px; background: rgba(255,255,255,0.2);">
                                <div class="progress-bar bg-white"
                                     t-att-style="'width: ' + (getTotalSubmissions() ? (getTotalByStatus('draft') / getTotalSubmissions() * 100) : 0) + '%;'"/>
                            </div>
                            <div class="d-flex justify-content-end align-items-center">
                                <span class="small text-white-50 text-decoration-none">Click to view drafts</span>
                            </div>
                        </div>
                    </div>

                    <!-- IN REVIEW / SUBMITTED -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="kpi-card kpi-submitted h-100 p-3 rounded-3 shadow-sm text-white"
                             style="background: #C17540; cursor: pointer;"
                             t-on-click="() => this.openKPIView('in_review_or_submitted')">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-uppercase fw-semibold small text-white-50" style="letter-spacing: 0.5px;">IN REVIEW / SUBMITTED</span>
                                <div class="kpi-icon rounded-2 p-2 d-flex align-items-center justify-content-center"
                                     style="background: rgba(255,255,255,0.12); width: 36px; height: 36px;">
                                    <i class="fa fa-hourglass-half text-white"/>
                                </div>
                            </div>
                            <div class="fs-2 fw-bold text-white mb-3" t-esc="getTotalByStatus('in_review_or_submitted')"/>
                            <div class="progress mb-2" style="height: 3px; background: rgba(255,255,255,0.2);">
                                <div class="progress-bar bg-white"
                                     t-att-style="'width: ' + (getTotalSubmissions() ? (getTotalByStatus('in_review_or_submitted') / getTotalSubmissions() * 100) : 0) + '%;'"/>
                            </div>
                            <div class="d-flex justify-content-end align-items-center">
                                <span class="small text-white-50 text-decoration-none">Click to view active pipeline</span>
                            </div>
                        </div>
                    </div>

                    <!-- APPROVED -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="kpi-card kpi-approved h-100 p-3 rounded-3 shadow-sm text-white"
                             style="background: #425727; cursor: pointer;"
                             t-on-click="() => this.openKPIView('approved')">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-uppercase fw-semibold small text-white-50" style="letter-spacing: 0.5px;">APPROVED</span>
                                <div class="kpi-icon rounded-2 p-2 d-flex align-items-center justify-content-center"
                                     style="background: rgba(255,255,255,0.12); width: 36px; height: 36px;">
                                    <i class="fa fa-check text-white"/>
                                </div>
                            </div>
                            <div class="fs-2 fw-bold text-white mb-3" t-esc="getTotalByStatus('approved')"/>
                            <div class="progress mb-2" style="height: 3px; background: rgba(255,255,255,0.2);">
                                <div class="progress-bar bg-white"
                                     t-att-style="'width: ' + (getTotalSubmissions() ? (getTotalByStatus('approved') / getTotalSubmissions() * 100) : 0) + '%;'"/>
                            </div>
                            <div class="d-flex justify-content-end align-items-center">
                                <span class="small text-white-50 text-decoration-none">Click to view approved</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2 CHARTS ROW -->
                <div class="row g-3">
                    <!-- Left: Plan Distribution (Donut Chart) -->
                    <div class="col-12 col-lg-5 col-xl-4">
                        <div class="card shadow-sm border-0 rounded-3 bg-white">
                            <div class="card-body p-3">
                                <h6 class="fw-bold mb-3 text-dark">
                                    Plan Distribution <span class="fw-normal text-muted small">(Click segment to view)</span>
                                </h6>
                                <div class="position-relative w-100" style="height: 380px; max-height: 380px; overflow: hidden;">
                                    <canvas t-ref="chartCanvas" style="max-height: 380px;"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Status Distribution (Bar Chart) -->
                    <div class="col-12 col-lg-7 col-xl-8">
                        <div class="card shadow-sm border-0 rounded-3 bg-white">
                            <div class="card-body p-3">
                                <h6 class="fw-bold mb-3 text-dark">
                                    Status Distribution <span class="fw-normal text-muted small">(Click bar to view)</span>
                                </h6>
                                <div class="position-relative w-100" style="height: 380px; max-height: 380px; overflow: hidden;">
                                    <canvas t-ref="statusChartCanvas" style="max-height: 380px;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>