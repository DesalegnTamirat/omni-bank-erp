<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Deposit Plan Rules -->
    <record id="rule_deposit_own_unit" model="ir.rule">
        <field name="name">PBMS Deposit Plan: own unit(s) only</field>
        <field name="model_id" ref="model_pbms_deposit_plan"/>
        <field name="domain_force">[('org_unit_id', 'in', user.operating_unit_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_pbms_branch_user'))]"/>
    </record>

    <record id="rule_deposit_district" model="ir.rule">
        <field name="name">PBMS Deposit Plan: own district's branches</field>
        <field name="model_id" ref="model_pbms_deposit_plan"/>
        <field name="domain_force">['|', ('org_unit_id', 'in', user.operating_unit_ids.ids), ('org_unit_id.parent_unit', 'in', user.operating_unit_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_pbms_district_reviewer'))]"/>
    </record>

    <record id="rule_deposit_ho" model="ir.rule">
        <field name="name">PBMS Deposit Plan: bank-wide (Head Office / SPPMD)</field>
        <field name="model_id" ref="model_pbms_deposit_plan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pbms_ho_reviewer'))]"/>
    </record>

