    <!-- Exceptional Workforce Request Record Rules -->
    <record id="rule_exceptional_workforce_branch" model="ir.rule">
        <field name="name">Exceptional Workforce: own work unit</field>
        <field name="model_id" ref="model_pbms_exceptional_workforce_request"/>
        <field name="domain_force">
            ['|', '|',
             ('operating_unit_id', 'in', user.operating_unit_ids.ids),
             ('create_uid', '=', user.id),
