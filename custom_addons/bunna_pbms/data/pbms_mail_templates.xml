                                        Bunna Bank S.C. | Strategic Planning &amp; Performance Management Directorate (SPPMD)
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </field>
    </record>

    <!-- ======================================================= -->
    <!-- FR-WP-057: Budget Year Status Notification             -->
    <!-- ======================================================= -->
    <record id="mail_template_cycle_status_changed" model="mail.template">
        <field name="name">PBMS: Budget Year / Planning Cycle Status</field>
        <field name="model_id" ref="model_pbms_planning_cycle"/>
        <field name="subject">Planning Cycle Announcement: {{ object.name }} is now {{ dict(object._fields['state'].selection).get(object.state, object.state) }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; color: #333333;">
                <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; width: 100%;">
                    <tr>
                        <td align="center">
                            <table border="0" cellpadding="0" cellspacing="0" style="padding: 24px; background-color: #FFFFFF; width: 600px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                                <tr>
                                    <td style="padding-bottom: 20px; border-bottom: 2.5px solid #541718;">
                                        <h2 style="color: #541718; margin: 0; font-weight: 700;">Planning Cycle Status Update</h2>
                                        <p style="color: #425727; margin: 4px 0 0 0; font-size: 13px; font-weight: bold;">Plan &amp; Budget Management System</p>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 20px 0;">
                                        <p>Dear Work Unit Managers &amp; Planning Teams,</p>
                                        <p>The annual planning cycle <b><t t-out="object.name"/></b> (Period: <t t-out="object.date_start"/> to <t t-out="object.date_end"/>) has transitioned to status: <b><t t-out="dict(object._fields['state'].selection).get(object.state, object.state)"/></b>.</p>
                                        
                                        <table style="width: 100%; border-collapse: collapse; margin: 16px 0; background-color: #FAFAFA; border-radius: 6px;">
                                            <tr style="border-bottom: 1px solid #EEEEEE;">
                                                <td style="padding: 10px; font-weight: bold; width: 45%; color: #555555;">Planning Cycle:</td>
                                                <td style="padding: 10px; font-weight: bold; color: #541718;"><t t-out="object.name"/></td>
                                            </tr>
                                            <tr style="border-bottom: 1px solid #EEEEEE;">
                                                <td style="padding: 10px; font-weight: bold; color: #555555;">Branch Submission Deadline:</td>
                                                <td style="padding: 10px;"><t t-out="object.branch_deadline or 'To be announced'"/></td>
                                            </tr>
                                            <tr style="border-bottom: 1px solid #EEEEEE;">
                                                <td style="padding: 10px; font-weight: bold; color: #555555;">District Endorsement Deadline:</td>
                                                <td style="padding: 10px;"><t t-out="object.district_deadline or 'To be announced'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 10px; font-weight: bold; color: #555555;">Head Office Review Deadline:</td>
                                                <td style="padding: 10px;"><t t-out="object.head_office_deadline or 'To be announced'"/></td>
                                            </tr>
                                        </table>

                                        <div style="text-align: center; margin: 30px 0;">
                                            <a t-attf-href="/web#action=bunna_pbms.action_pbms_planning_request_form"
                                               style="background-color: #541718; color: #FFFFFF; padding: 12px 24px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">
                                                Go to Planning Workspace
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-top: 1px solid #EEEEEE; padding-top: 15px; font-size: 12px; color: #888888; text-align: center;">
                                        Bunna Bank S.C. | Strategic Planning &amp; Performance Management Directorate (SPPMD)
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </field>
    </record>

    <!-- ======================================================= -->
    <!-- FR-WP-058: Recruitment Commencement Notification       -->
    <!-- ======================================================= -->
    <record id="mail_template_recruitment_commencement" model="mail.template">
        <field name="name">PBMS: Recruitment Commencement Authorization</field>
        <field name="model_id" ref="model_pbms_planning_category"/>
        <field name="subject">Recruitment Authorization: Approved Workforce for {{ object.org_unit_id.display_name }} ({{ object.cycle_id.name }})</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; color: #333333;">
                <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; width: 100%;">
                    <tr>
                        <td align="center">
                            <table border="0" cellpadding="0" cellspacing="0" style="padding: 24px; background-color: #FFFFFF; width: 650px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                                <tr>
                                    <td style="padding-bottom: 20px; border-bottom: 2.5px solid #541718;">
                                        <h2 style="color: #541718; margin: 0; font-weight: 700;">Recruitment Commencement Authorization</h2>
                                        <p style="color: #425727; margin: 4px 0 0 0; font-size: 13px; font-weight: bold;">Human Resources &amp; Talent Acquisition | Bunna PBMS</p>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 20px 0;">
                                        <p>Dear HR Recruitment Team &amp; Work Unit Manager,</p>
                                        <p>Following final executive approval of the <b>Workforce Plan</b> for <b><t t-out="object.org_unit_id.display_name"/></b> in planning cycle <b><t t-out="object.cycle_id.name"/></b>, <b>recruitment and onboarding can now officially commence</b> for the approved positions detailed below.</p>
                                        
                                        <table style="width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 13px;">
                                            <thead>
                                                <tr style="background-color: #EDF3E8; color: #541718; border-bottom: 2px solid #C8DCB8;">
                                                    <th style="padding: 8px; text-align: left;">Position / Title</th>
                                                    <th style="padding: 8px; text-align: left;">Request Type</th>
                                                    <th style="padding: 8px; text-align: center;">Q1</th>
                                                    <th style="padding: 8px; text-align: center;">Q2</th>
                                                    <th style="padding: 8px; text-align: center;">Q3</th>
                                                    <th style="padding: 8px; text-align: center;">Q4</th>
                                                    <th style="padding: 8px; text-align: center;">Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="object.manpower_line_ids" t-as="line">
                                                    <tr style="border-bottom: 1px solid #EEEEEE;">
                                                        <td style="padding: 8px; font-weight: bold;">
                                                            <t t-out="line.job_id.name or line.new_job_title or 'N/A'"/>
                                                        </td>
                                                        <td style="padding: 8px; color: #555555;">
                                                            <t t-out="line.position_type_id.name or line.position_type or 'N/A'"/>
                                                        </td>
                                                        <td style="padding: 8px; text-align: center;"><t t-out="line.q1 or 0"/></td>
                                                        <td style="padding: 8px; text-align: center;"><t t-out="line.q2 or 0"/></td>
                                                        <td style="padding: 8px; text-align: center;"><t t-out="line.q3 or 0"/></td>
                                                        <td style="padding: 8px; text-align: center;"><t t-out="line.q4 or 0"/></td>
                                                        <td style="padding: 8px; text-align: center; font-weight: bold; color: #425727;"><t t-out="line.quantity or 0"/></td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>

                                        <p style="margin-top: 15px;">Total Approved Headcount: <b><t t-out="object.manpower_total_headcount or 0"/> Position(s)</b>.</p>
                                        <p>Human Resources may initiate job postings, sourcing, internal transfers, and candidate assessments according to the quarterly schedule.</p>

                                        <div style="text-align: center; margin: 25px 0;">
                                            <a t-attf-href="/web#id={{ object.id }}&amp;model=pbms.planning.category&amp;view_type=form"
                                               style="background-color: #425727; color: #FFFFFF; padding: 12px 24px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">
                                                View Approved Workforce Plan
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-top: 1px solid #EEEEEE; padding-top: 15px; font-size: 12px; color: #888888; text-align: center;">
                                        Bunna Bank S.C. | Strategic Planning &amp; Performance Management Directorate (SPPMD) &amp; HR
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </field>
    </record>

