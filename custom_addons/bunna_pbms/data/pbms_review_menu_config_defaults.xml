<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Default Review & Consolidation Menu Access Configuration rows.
        One row per sub-menu, with NO privileges configured by default
        (so behavior is unchanged until the admin explicitly sets privileges).
        noupdate="1" means these are only inserted on first install.
    -->

    <record id="review_menu_config_deposit" model="pbms.review.menu.config">
        <field name="sequence">10</field>
        <field name="menu_key">deposit</field>
        <field name="active">True</field>
        <field name="description">Controls visibility of "Deposit Mobilization" under Review &amp; Consolidation.</field>
