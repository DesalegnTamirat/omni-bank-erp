<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//th[@t-if=&quot;column.type === 'field'&quot;]" position="inside">
            <t t-if="column.name === 'is_selected'">
                <div class="o_automatch_select_all_cell d-flex align-items-center justify-content-center m-0 p-0 w-100 h-100">
                    <div class="o-checkbox form-check d-flex align-items-center justify-content-center m-0 p-0">
                        <input type="checkbox"
                               class="form-check-input cursor-pointer m-0"
                               title="Select All / Deselect All"
                               t-att-checked="isAutoMatchAllSelected(column) ? 'checked' : undefined"
                               t-on-click.stop="(ev) => this.toggleAutoMatchSelectAll(column, ev)"/>
                    </div>
                </div>
            </t>
        </xpath>
        <xpath expr="//th[@t-if=&quot;column.type === 'field'&quot;]//t[@t-if=&quot;column.hasLabel and column.widget !== 'handle'&quot;]" position="attributes">
            <attribute name="t-if">column.name !== 'is_selected' and column.hasLabel and column.widget !== 'handle'</attribute>
        </xpath>
    </t>

    <t t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="extension">
        <xpath expr="//Field[@name='column.name']" position="replace">
            <t t-elif="column.name === 'is_selected'">
                <div class="o_automatch_row_checkbox_cell d-flex align-items-center justify-content-center m-0 p-0 w-100 h-100"
                     t-on-click.stop="(ev) => this.toggleAutoMatchRecord(record, column, ev)">
                    <div class="o-checkbox form-check d-flex align-items-center justify-content-center m-0 p-0">
                        <input type="checkbox"
                               class="form-check-input cursor-pointer m-0"
                               t-att-checked="record.data.is_selected ? 'checked' : undefined"
                               t-on-click.stop="(ev) => this.toggleAutoMatchRecord(record, column, ev)"/>
                    </div>
                </div>
            </t>
            <Field t-else="" name="column.name" record="record" type="column.widget" class="getFieldClass(column)" fieldInfo="column" t-props="getFieldProps(record, column)"/>
        </xpath>
    </t>
</templates>
