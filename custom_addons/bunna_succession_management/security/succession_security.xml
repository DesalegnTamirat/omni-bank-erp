        <record id="rule_succession_candidate_invitation_user" model="ir.rule">
            <field name="name">Succession Candidate Invitation: Employee Own</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_candidate_invitation"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
