            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Candidate Eval Lines: Manager can evaluate their direct reports' lines -->
        <record id="rule_candidate_eval_line_line_manager" model="ir.rule">
            <field name="name">Coach / Manager / Assigned SPMC: Competency Eval Lines</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_candidate_eval_line"/>
            <field name="domain_force">['|', '|', '|', ('candidate_id.employee_id.user_id', '=', user.id), ('candidate_id.employee_id.parent_id.user_id', '=', user.id), ('candidate_id.employee_id.coach_id.user_id', '=', user.id), ('candidate_id.spmc_assigned_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_line_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Career Discussions: Manager can manage career discussions for their direct reports -->
        <record id="rule_succession_career_discussion_line_manager" model="ir.rule">
            <field name="name">Manager: Own Direct Reports' Career Discussions</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_career_discussion"/>
            <field name="domain_force">['|', '|', ('employee_id.parent_id.user_id', '=', user.id), ('employee_id.coach_id.user_id', '=', user.id), ('manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_line_manager'))]"/>
            <field name="perm_read" eval="True"/>
