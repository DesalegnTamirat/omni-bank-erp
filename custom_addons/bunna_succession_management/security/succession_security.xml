            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Career Discussions: PPDD / Admin full access -->
        <record id="rule_succession_career_discussion_ppdd" model="ir.rule">
            <field name="name">PPDD / Admin / SPMC: All Career Discussions</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_career_discussion"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_ppdd')), (4, ref('bunna_succession_management.group_succession_spmc')), (4, ref('bunna_succession_management.group_succession_admin'))]"/>
            <field name="perm_read" eval="True"/>
