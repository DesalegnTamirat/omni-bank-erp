        <record id="rule_succession_career_discussion_employee" model="ir.rule">
            <field name="name">Employee: Own Career Discussions</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_career_discussion"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Assessment Results: PPDD, SPMC, and Admins can read/write all results (mirrors candidate rule) -->
        <record id="rule_candidate_assessment_result_ppdd" model="ir.rule">
            <field name="name">PPDD / SPMC / Admin: All Candidate Assessment Results</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_candidate_assessment_result"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_ppdd')), (4, ref('bunna_succession_management.group_succession_spmc')), (4, ref('bunna_succession_management.group_succession_admin'))]"/>
        </record>

