<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- =====================================================
             MODULE CATEGORY
        ====================================================== -->
        <record id="module_category_succession" model="ir.module.category">
            <field name="name">Succession Management</field>
            <field name="description">Confidential Succession Management Access Control</field>
            <field name="sequence">28</field>
        </record>

        <record id="res_groups_privilege_succession" model="res.groups.privilege">
            <field name="name">Succession Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="bunna_succession_management.module_category_succession"/>
        </record>

        <!-- =====================================================
             SECURITY GROUPS
        ====================================================== -->


        <!-- Group 1: PPDD Officer -->
        <record id="group_succession_ppdd" model="res.groups">
            <field name="name">PPDD Officer</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="bunna_succession_management.res_groups_privilege_succession"/>
            <field name="implied_ids" eval="[(4, ref('hr_employee_custom.group_career_path_officer'))]"/>
            <field name="comment">
                PPDD Officers can manage critical positions, talent pools,
                nominate candidates, and run gap analyses. Cannot grant final SPMC approval.
            </field>
        </record>

        <!-- Group 1b: Manager (restricted — can only act on their direct reports' dev plans) -->
        <record id="group_succession_line_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">12</field>
            <field name="privilege_id" ref="bunna_succession_management.res_groups_privilege_succession"/>
            <field name="implied_ids" eval="[(4, ref('hr_employee_custom.group_career_path_manager'))]"/>
            <field name="comment">
                Managers can view and act on development plans for their direct reports:
                submit extension requests and mark plans as complete ahead of schedule.
                They cannot access candidate records, critical position registers, or assessment scores.
            </field>
        </record>

        <!-- Group 2: SPMC / Senior Management -->
        <record id="group_succession_spmc" model="res.groups">
            <field name="name">SPMC / Senior Management</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="bunna_succession_management.res_groups_privilege_succession"/>
            <field name="comment">
                SPMC / Senior Management users review talent pools, conduct candidate assessments,
                view development plans and career discussions, and approve successors.
            </field>
        </record>

        <!-- Group 3: Succession Administrator -->
        <record id="group_succession_admin" model="res.groups">
            <field name="name">Succession Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="bunna_succession_management.res_groups_privilege_succession"/>
            <field name="implied_ids" eval="[(4, ref('bunna_succession_management.group_succession_spmc')), (4, ref('bunna_succession_management.group_succession_ppdd'))]"/>
            <field name="comment">Full admin access including delete and configuration.</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>


    </data>

    <!-- =====================================================
         RECORD RULES
         All rules are strictly restricted to the succession groups.
         Standard employees (base.group_user) have NO rules defined here,
         which means they cannot read any succession records.
    ====================================================== -->
    <data noupdate="0">

        <!-- NOTE: Do NOT define global [(1, '=', 1)] rule on hr.employee here as it overrides
             bank-wide employee directory privacy for PPDD/SPMC users. Succession models use sudo()
             internally for candidate operations without compromising employee directory visibility. -->

        <!-- Permanently delete any legacy global employee rule -->
        <delete model="ir.rule" search="[('name', '=', 'PPDD: Read All HR Employees')]"/>

        <!-- Critical Positions: PPDD+ can read all -->
        <record id="rule_succession_critical_position_ppdd" model="ir.rule">
            <field name="name">PPDD: All Critical Positions</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_critical_position"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_ppdd')), (4, ref('bunna_succession_management.group_succession_spmc')), (4, ref('bunna_succession_management.group_succession_admin'))]"/>
        </record>

        <!-- Critical Positions: Employee can read critical positions (e.g. for invitations) -->
        <record id="rule_succession_critical_position_employee" model="ir.rule">
            <field name="name">Employee: Read Critical Positions</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_critical_position"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Candidates: PPDD+ can read all -->
        <record id="rule_succession_candidate_ppdd" model="ir.rule">
            <field name="name">PPDD: All Candidates</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_candidate"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_ppdd')), (4, ref('bunna_succession_management.group_succession_spmc')), (4, ref('bunna_succession_management.group_succession_admin'))]"/>
        </record>

        <!-- Candidate Gap Lines: PPDD+ -->
        <record id="rule_succession_candidate_gap_ppdd" model="ir.rule">
            <field name="name">PPDD: All Candidate Gap Lines</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_candidate_competency_gap"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_ppdd')), (4, ref('bunna_succession_management.group_succession_spmc')), (4, ref('bunna_succession_management.group_succession_admin'))]"/>
        </record>

        <!-- Development Plans: PPDD+ -->
        <record id="rule_succession_dev_plan_ppdd" model="ir.rule">
            <field name="name">PPDD / SPMC: All Development Plans</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_development_plan"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_ppdd')), (4, ref('bunna_succession_management.group_succession_spmc')), (4, ref('bunna_succession_management.group_succession_admin'))]"/>
        </record>

        <!-- Development Activities: PPDD+ -->
        <record id="rule_succession_dev_activity_ppdd" model="ir.rule">
            <field name="name">PPDD / Admin: All Development Activities</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_development_activity"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_ppdd')), (4, ref('bunna_succession_management.group_succession_spmc')), (4, ref('bunna_succession_management.group_succession_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Dev Plan Extension Log: PPDD / Admin -->
        <record id="rule_succession_dev_plan_ext_log_ppdd" model="ir.rule">
            <field name="name">PPDD / Admin: All Dev Plan Extension Logs</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_development_plan_extension_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_ppdd')), (4, ref('bunna_succession_management.group_succession_admin')), (4, ref('bunna_succession_management.group_succession_spmc'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Governance Log: PPDD+ -->
        <record id="rule_succession_gov_log_ppdd" model="ir.rule">
            <field name="name">PPDD / Admin: All Governance Logs</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_governance_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_ppdd')), (4, ref('bunna_succession_management.group_succession_spmc')), (4, ref('bunna_succession_management.group_succession_admin'))]"/>
        </record>

        <!-- Candidate Eval Lines: PPDD can read/write all -->
        <record id="rule_candidate_eval_line_ppdd" model="ir.rule">
            <field name="name">PPDD: All Candidate Eval Lines</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_candidate_eval_line"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_ppdd')), (4, ref('bunna_succession_management.group_succession_spmc')), (4, ref('bunna_succession_management.group_succession_admin'))]"/>
        </record>

        <!-- ─── MANAGER RECORD RULES ─────────────────────────────────────────
             Managers can ONLY see development plans where the candidate's
             employee has them as the direct manager (employee.parent_id.user_id = uid).
        ──────────────────────────────────────────────────────────────────────── -->

        <!-- Dev Plans: Manager sees and creates only their direct reports' plans -->
        <record id="rule_succession_dev_plan_line_manager" model="ir.rule">
            <field name="name">Manager: Own Direct Reports' Development Plans</field>
            <field name="model_id" ref="bunna_succession_management.model_succession_development_plan"/>
            <field name="domain_force">['|', ('employee_id.parent_id.user_id', '=', user.id), ('employee_id.coach_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('bunna_succession_management.group_succession_line_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
