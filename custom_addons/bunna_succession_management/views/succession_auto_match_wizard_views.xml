<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_succession_auto_match_wizard_form" model="ir.ui.view">
        <field name="name">succession.auto.match.wizard.form</field>
        <field name="model">succession.auto.match.wizard</field>
        <field name="arch" type="xml">
            <form string="Auto-Match Candidates">
                <sheet>
                    <group>
                        <field name="critical_position_id"/>
                        <field name="job_id"/>
                    </group>
                    <p class="text-muted">
                        The following employees have been automatically matched based on their latest approved competency assessments.
                    </p>
                    <field name="match_line_ids" readonly="1">
                        <list string="Matched Candidates" default_order="match_percent desc">
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="matched_competency_count"/>
                            <field name="required_competency_count"/>
                            <field name="match_percent" widget="progressbar"/>
                            <button name="action_nominate" type="object" string="Nominate" class="oe_highlight" icon="fa-user-plus"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>