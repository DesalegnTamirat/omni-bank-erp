<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_succession_plan_early_completion_wizard_form" model="ir.ui.view">
            <field name="name">succession.plan.early.completion.wizard.form</field>
            <field name="model">succession.plan.early.completion.wizard</field>
            <field name="arch" type="xml">
                <form string="Complete Plan Ahead of Schedule">
                    <sheet>
                        <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
                            <i class="fa fa-bolt fa-2x me-3 text-warning" title="Ahead of Schedule"/>
                            <div>
                                <strong>Accelerated Development Completion:</strong>
                                This action marks the succession development plan as completed prior to its scheduled end date.
                                You must document a substantive business justification.
                                This action can be submitted by the candidate's <strong>Manager</strong> or a <strong>PPDD Officer</strong>.
                            </div>
                        </div>

                        <group>
                            <group string="Candidate &amp; Plan Context">
                                <field name="plan_id" invisible="1"/>
                                <field name="employee_id"/>
                                <field name="candidate_id" invisible="1"/>
                                <field name="critical_position_id"/>
                            </group>
                            <group string="Timeline Acceleration">
                                <field name="plan_start_date"/>
                                <field name="planned_end_date"/>
                                <field name="actual_completion_date"/>
                                <field name="days_ahead" class="fw-bold text-success"/>
                            </group>
                        </group>

                        <group string="Justification">
                            <field name="justification"
                                   nolabel="1"
                                   required="1"
                                   placeholder="Detail why this candidate completed development ahead of schedule (e.g. accelerated competency mastery, prior experience, early certifications)..."
                                   style="min-height: 120px; width: 100%;"/>
                        </group>

                        <group string="Automated Succession Adjustments">
                            <field name="close_remaining_activities" widget="boolean_toggle"/>
                            <field name="update_candidate_readiness" widget="boolean_toggle"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm_early_completion"
                                string="Complete Ahead of Schedule"
                                type="object" class="btn btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
