<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- DEVELOPMENT PLAN LIST -->
        <record id="view_succession_dev_plan_list" model="ir.ui.view">
            <field name="name">succession.development.plan.list</field>
            <field name="model">succession.development.plan</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id" optional="show"/>
                    <field name="critical_position_id"/>
                    <field name="plan_year"/>
                    <field name="business_impact_score" optional="hide"/>
                    <field name="urgency_level" optional="hide"/>
                    <field name="target_readiness" widget="badge"/>
                    <field name="overall_progress" widget="progressbar"/>
                    <field name="activity_count"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'completed'"
                           decoration-info="state == 'active'"
                           decoration-warning="state == 'draft'"
                           decoration-muted="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <!-- DEVELOPMENT PLAN FORM -->
        <record id="view_succession_dev_plan_form" model="ir.ui.view">
            <field name="name">succession.development.plan.form</field>
            <field name="model">succession.development.plan</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_activate" string="Activate Plan"
                                type="object" class="oe_highlight"
                                invisible="state != 'draft'"
                                groups="bunna_succession_management.group_succession_ppdd"/>
                        <button name="action_complete" string="Mark Completed"
                                type="object" class="btn-success"
                                invisible="state != 'active'"
                                groups="bunna_succession_management.group_succession_ppdd"/>
                        <button name="action_cancel" string="Cancel"
                                type="object"
                                invisible="state in ('completed','cancelled')"
                                groups="bunna_succession_management.group_succession_ppdd"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,active,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-tasks" type="object" name="">
                                <div class="o_stat_info">
                                    <span class="o_stat_value"><field name="activity_count"/></span>
                                    <span class="o_stat_text">Activities</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Candidate Info">
                                <field name="candidate_id" readonly="state != 'draft'"/>
                                <field name="employee_id" readonly="1"/>
                                <field name="department_id" readonly="1"/>
                                <field name="critical_position_id" readonly="1"/>
                            </group>
                            <group string="Plan Details">
                                <field name="plan_year"/>
                                <field name="target_readiness"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="overall_progress" widget="progressbar"/>
                            </group>
                        </group>
                        <group string="Global Prioritization (FR-SDP-004)">
                            <group>
                                <field name="business_impact_score"/>
                                <field name="urgency_level"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Development Activities">
                                <field name="development_activity_ids">
                                    <list editable="bottom"
                                          decoration-success="status == 'completed'"
                                          decoration-muted="status == 'cancelled'">
                                        <field name="activity_description"/>
                                        <field name="activity_type"/>
                                        <field name="competency_id" optional="show"/>
                                        <field name="start_date"/>
                                        <field name="target_date"/>
                                        <field name="progress_percent" widget="progressbar"/>
                                        <field name="status" widget="badge"
                                               decoration-success="status == 'completed'"
                                               decoration-info="status == 'in_progress'"
                                               decoration-warning="status == 'planned'"
                                               decoration-muted="status == 'cancelled'"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes"
                                       placeholder="Development focus, key milestones, and expected outcomes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ANNUAL CONSOLIDATION PIVOT VIEW (FR-SDP-005) -->
        <record id="view_succession_dev_plan_pivot" model="ir.ui.view">
            <field name="name">succession.development.plan.pivot</field>
            <field name="model">succession.development.plan</field>
            <field name="arch" type="xml">
                <pivot string="Annual Development Consolidation">
                    <field name="plan_year" type="row"/>
                    <field name="department_id" type="row"/>
                    <field name="business_impact_score" type="measure"/>
                    <field name="activity_count" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- ANNUAL CONSOLIDATION GRAPH VIEW -->
        <record id="view_succession_dev_plan_graph" model="ir.ui.view">
            <field name="name">succession.development.plan.graph</field>
            <field name="model">succession.development.plan</field>
            <field name="arch" type="xml">
                <graph string="Development Plans by Department" type="bar">
                    <field name="department_id"/>
                    <field name="activity_count" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="action_succession_dev_plan" model="ir.actions.act_window">
            <field name="name">Successor Development Plans</field>
            <field name="res_model">succession.development.plan</field>
            <field name="view_mode">list,form,pivot,graph</field>
        </record>

    </data>
</odoo>
