<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View for Standalone Governance Policy -->
        <record id="view_succession_governance_policy_form" model="ir.ui.view">
            <field name="name">succession.governance.policy.form</field>
            <field name="model">succession.governance.policy</field>
            <field name="arch" type="xml">
                <form string="Governance &amp; Controls" create="false" delete="false">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        
                        <notebook>
                            <page string="Policy &amp; Governance Rules" name="policy_rules">
                                <group string="Succession Policy &amp; Approval Governance">
                                    <group string="Position &amp; Pipeline Controls">
                                        <field name="succ_require_spmc_approval" string="Require SPMC Approval for Positions"/>
                                        <field name="deployment_readiness_level_id" string="Deployment Readiness Requirement" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="invitation_expiry_days" string="Invitation Expiration Window (Days)"/>
                                    </group>
                                    <group string="Action Alerts &amp; Notifications">
                                        <field name="succ_alert_critical_no_successors" string="Alert PPDD When Zero Successors"/>
                                        <field name="succ_alert_idp_overdue" string="Alert When Development Activity Overdue"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Urgency Level" name="urgency_levels">
                                <div class="alert alert-info py-2 px-3 mb-3" role="alert">
                                    <i class="fa fa-info-circle me-1"/> Configure <strong>Urgency Levels</strong>. You can dynamically add, reorder, edit, or remove urgency levels below for use on Successor Development Plans.
                                </div>
                                <field name="urgency_rule_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name" string="Urgency Level Name"/>
                                        <field name="description"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- Server Action to open the Singleton Configuration record directly -->
        <record id="action_succession_governance_policy" model="ir.actions.server">
            <field name="name">Governance &amp; Controls</field>
            <field name="model_id" ref="model_succession_governance_policy"/>
            <field name="state">code</field>
            <field name="code">
policy = env['succession.governance.policy'].get_policy()
action = {
    'type': 'ir.actions.act_window',
    'name': 'Governance &amp; Controls',
    'res_model': 'succession.governance.policy',
    'res_id': policy.id,
    'view_mode': 'form',
    'context': {'active_test': False},
    'target': 'current',
}
            </field>
        </record>

    </data>
</odoo>
