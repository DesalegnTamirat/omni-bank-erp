                  groups="bunna_succession_management.group_succession_ppdd,bunna_succession_management.group_succession_spmc,bunna_succession_management.group_succession_admin,bunna_succession_management.group_succession_line_manager"/>

        <record id="action_succession_candidate_eval_manager" model="ir.actions.act_window">
            <field name="name">Candidate Assessments</field>
            <field name="res_model">succession.candidate</field>
            <field name="view_mode">list,form</field>
            <field name="domain">['|', ('assessment_status', '=', 'finalized'), ('state', 'in', ('nominated', 'assessed', 'approved', 'placed'))]</field>
            <field name="context">{'search_default_pending': 1, 'search_default_group_position': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No succession candidates currently assigned for assessment evaluation.
                </p>
                <p>
                    When candidates in your team are nominated for critical roles, they will appear here for your competency evaluation and sign-off.
                </p>
            </field>
        </record>

        <menuitem id="menu_succession_development_plans"
                  name="Development Plans"
