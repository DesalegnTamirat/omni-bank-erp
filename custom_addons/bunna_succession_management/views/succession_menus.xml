        <!-- ============================================================
             DEVELOPMENT ACTIVITIES CONFIGURATION
             Shows 3 major activities; sub-activities managed inside each form.
        ============================================================ -->
        <record id="action_succession_activity_category" model="ir.actions.act_window">
            <field name="name">Development Activities</field>
            <field name="res_model">succession.development.activity.category</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No development activities configured yet.
                </p>
                <p>
                    Configure the Major Development Activities:
                    Experiential Learning (70%), Exposure &amp; Social Learning (20%), and Education &amp; Formal Learning (10%).
                    Open each pillar to view and manage its sub-activities.
                </p>
            </field>
            <field name="context">{'active_test': False}</field>
        </record>

