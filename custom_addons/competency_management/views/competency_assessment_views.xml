<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Assessment Cycle Tree -->
        <record id="view_competency_assessment_cycle_list" model="ir.ui.view">
            <field name="name">competency.assessment.cycle.list</field>
            <field name="model">competency.assessment.cycle</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="period_start"/>
                    <field name="period_end"/>
                    <field name="assessment_deadline"/>
                    <field name="assessment_count"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Assessment Cycle Form -->
        <record id="view_competency_assessment_cycle_form" model="ir.ui.view">
            <field name="name">competency.assessment.cycle.form</field>
            <field name="model">competency.assessment.cycle</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_start" string="Start Cycle"
                                type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_notify_assessors" string="📢 Notify Employees to Fill Assessments"
                                type="object" class="btn-primary" invisible="state not in ('open','in_review') or pending_assessment_count == 0"/>
                        <button name="action_start_review" string="Start Review"
                                type="object" invisible="state != 'open'"/>
                        <button name="action_send_deadline_reminders" string="⚠️ Send Deadline Warning to Pending Assessors"
                                type="object" class="btn-warning" invisible="state not in ('open','in_review') or pending_assessment_count == 0"/>
                        <button name="action_close" string="Close Cycle"
                                type="object" invisible="state not in ('open','in_review')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,open,in_review,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_assessments" type="object" class="oe_stat_button" icon="fa-file-text-o">
                                <field name="assessment_count" widget="statinfo" string="Total Assessments"/>
                            </button>
                            <button name="action_view_pending_assessments" type="object" class="oe_stat_button" icon="fa-clock-o">
                                <field name="pending_assessment_count" widget="statinfo" string="Pending Drafts"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Cycle Name"/>
                            <h1><field name="name" placeholder="e.g. Annual Assessment 2026" readonly="state == 'closed'"/></h1>
                        </div>
                        <group>
                            <group string="Evaluation Timeline">
                                <field name="period_start" string="Evaluation Period Start" readonly="state == 'closed'"/>
                                <field name="period_end" string="Evaluation Period End" readonly="state == 'closed'"/>
                                <field name="assessment_deadline" string="Submission Deadline" readonly="state == 'closed'"/>
                            </group>
                            <group string="Cycle Submissions Progress">
                                <field name="pending_assessment_count" string="Pending Drafts"/>
                                <field name="submitted_assessment_count" string="Submitted / In Review"/>
                                <field name="assessment_count" string="Total Assessments"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Assessments">
                                <field name="assessment_ids" readonly="1">
                                    <list limit="20" create="false" edit="false" delete="false">
                                        <field name="name"/>
                                        <field name="employee_id"/>
                                        <field name="assessment_type"/>
                                        <field name="assessor_id"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes" placeholder="Enter cycle description or instructions..." readonly="state == 'closed'"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Assessment Cycle Search -->
        <record id="view_competency_assessment_cycle_search" model="ir.ui.view">
            <field name="name">competency.assessment.cycle.search</field>
            <field name="model">competency.assessment.cycle</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <filter string="Draft" name="state_draft" domain="[('state','=','draft')]"/>
                    <filter string="Open" name="state_open" domain="[('state','=','open')]"/>
                    <filter string="In Review" name="state_in_review" domain="[('state','=','in_review')]"/>
                    <filter string="Closed" name="state_closed" domain="[('state','=','closed')]"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                </search>
            </field>
        </record>

        <record id="action_competency_assessment_cycle" model="ir.actions.act_window">
            <field name="name">Assessment Cycles</field>
            <field name="res_model">competency.assessment.cycle</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_competency_assessment_cycle_search"/>
        </record>

        <!-- Assessment Tree (Readonly Reporting Overview for All Competency Assessments) -->
        <record id="view_competency_assessment_list" model="ir.ui.view">
            <field name="name">competency.assessment.list</field>
            <field name="model">competency.assessment</field>
            <field name="arch" type="xml">
                <list create="false" edit="false" delete="false">
                    <field name="name"/>
                    <field name="employee_id" options="{'no_open': True, 'no_create': True}"/>
                    <field name="job_id" string="Employee Job Position" optional="hide" options="{'no_open': True, 'no_create': True}"/>
                    <field name="grade_id" string="Employee Job Grade" optional="hide" options="{'no_open': True, 'no_create': True}"/>
                    <field name="cycle_id"/>
                    <field name="assessment_type"/>
                    <field name="assessor_id" options="{'no_open': True, 'no_create': True}"/>
                    <field name="assessor_job_id" string="Assessor Job Position" optional="hide" options="{'no_open': True, 'no_create': True}"/>
                    <field name="assessor_grade_id" string="Assessor Job Grade" optional="hide" options="{'no_open': True, 'no_create': True}"/>
                    <field name="average_gap"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Form view for competency.assessment.line popup -->
        <record id="view_competency_assessment_line_form" model="ir.ui.view">
            <field name="name">competency.assessment.line.form</field>
            <field name="model">competency.assessment.line</field>
            <field name="priority" eval="20"/>
            <field name="arch" type="xml">
                <form string="Competency Behavioral Guidance &amp; Rating">
                    <sheet>
                        <field name="is_primary_reporting_line" invisible="1"/>
                        <div class="oe_title" style="margin-bottom: 15px;">
                            <h1 style="color: #541718;"><field name="competency_id" readonly="1"/></h1>
                            <h4 class="text-muted"><field name="pillar" widget="badge" readonly="1"/></h4>
                        </div>
                        
                        <!-- Full-width Competency Definition Callout Container -->
                        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-left: 4px solid #541718; border-radius: 6px; padding: 14px 18px; margin-bottom: 20px; width: 100%;">
                            <div style="font-size: 11px; font-weight: 700; color: #726732; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
                                Competency Definition
                            </div>
                            <div style="font-size: 13.5px; color: #1d2b32; line-height: 1.6;">
                                <field name="competency_definition" readonly="1" nolabel="1"/>
                            </div>
                        </div>

                        <div style="margin-top: 15px; margin-bottom: 10px;">
                            <h3 style="color: #1d2b32; border-bottom: 2px solid #541718; padding-bottom: 5px;">
                                📖 Proficiency Level Behavioral Indicators (Levels 1 to 4)
                            </h3>
                            <p class="text-muted">Review the expected behaviors for each level below before selecting your current proficiency rating.</p>
                        </div>

                        <div style="background-color: #ffffff; padding: 15px; border-radius: 6px; border: 1px solid #dee2e6; margin-bottom: 20px;">
                            <div style="margin-bottom: 12px; padding: 12px 15px; background-color: #fcfbfa; border-left: 5px solid #726732; border-radius: 4px;">
                                <h4 style="color: #726732; margin-top: 0; margin-bottom: 6px;">🟡 Level 1 — Basic</h4>
                                <field name="indicator_level_1" readonly="1" nolabel="1"/>
                            </div>

                            <div style="margin-bottom: 12px; padding: 12px 15px; background-color: #f8f9fa; border-left: 5px solid #1d2b32; border-radius: 4px;">
                                <h4 style="color: #1d2b32; margin-top: 0; margin-bottom: 6px;">🔵 Level 2 — Intermediate</h4>
                                <field name="indicator_level_2" readonly="1" nolabel="1"/>
                            </div>

                            <div style="margin-bottom: 12px; padding: 12px 15px; background-color: #fdf8f5; border-left: 5px solid #c17540; border-radius: 4px;">
                                <h4 style="color: #c17540; margin-top: 0; margin-bottom: 6px;">🟠 Level 3 — Advanced</h4>
                                <field name="indicator_level_3" readonly="1" nolabel="1"/>
                            </div>

                            <div style="padding: 12px 15px; background-color: #faf4f5; border-left: 5px solid #541718; border-radius: 4px;">
                                <h4 style="color: #541718; margin-top: 0; margin-bottom: 6px;">🔴 Level 4 — Expert</h4>
                                <field name="indicator_level_4" readonly="1" nolabel="1"/>
                            </div>
                        </div>

                        <field name="is_deadline_passed" invisible="1"/>
                        <field name="state" invisible="1"/>
                        <field name="is_admin_user" invisible="1"/>
                        <field name="can_edit_ratings" invisible="1"/>



                        <!-- Deadline Warning Callout Banner in Modal View -->
                        <div class="alert alert-danger text-center" role="alert" invisible="not is_deadline_passed or state != 'draft' or is_admin_user">
                            <i class="fa fa-exclamation-triangle me-2"/> 
                            <strong>Deadline Passed:</strong> Rating inputs are read-only because the submission deadline for this cycle has passed.
                        </div>

                        <group string="Proficiency Rating &amp; Supporting Remarks" style="margin-top: 20px;">
                            <group>
                                <field name="required_level" readonly="1" invisible="state in ('draft', 'submitted', 'supervisor_review')"/>
                                <field name="current_level" string="Select Current Proficiency Level" required="1" readonly="not can_edit_ratings"/>
                                <field name="gap" readonly="1" invisible="state in ('draft', 'submitted', 'supervisor_review')"/>
                                <field name="achievement_status" widget="badge" readonly="1" invisible="state in ('draft', 'submitted', 'supervisor_review')"/>
                            </group>
                            <group>
                                <field name="comments" placeholder="Enter remarks or justification for your rating..." readonly="not can_edit_ratings"/>
                                <field name="evidence_attachment_ids" widget="many2many_binary" readonly="not can_edit_ratings"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Assessment Form (Interactive Rating & Reporting Display) -->
        <record id="view_competency_assessment_form" model="ir.ui.view">
            <field name="name">competency.assessment.form</field>
            <field name="model">competency.assessment</field>
            <field name="arch" type="xml">
                <form create="false" delete="false">
                    <header>
                        <button name="action_populate_competencies" string="Populate Competencies"
                                type="object" class="oe_highlight" invisible="state != 'draft' or (is_deadline_passed and not is_admin_or_officer) or not can_edit_ratings" icon="fa-list-ol"/>
                        <button name="action_submit" string="Submit"
                                type="object" class="oe_highlight" invisible="state != 'draft' or (is_deadline_passed and not is_admin_or_officer) or not can_edit_ratings"/>
                        <button name="action_submit" string="Admin Submit (Override Deadline)"
                                type="object" class="btn-warning" invisible="state != 'draft' or not is_deadline_passed or not is_admin_or_officer or is_override_active"/>
                        <button name="action_enable_override" string="Override Ratings"
                                type="object" class="btn-warning"
                                groups="competency_management.group_competency_admin,competency_management.group_competency_officer"
                                invisible="not can_override or is_override_active"
                                icon="fa-unlock"/>
                        <button name="action_disable_override" string="Lock Override"
                                type="object" class="btn-secondary"
                                groups="competency_management.group_competency_admin,competency_management.group_competency_officer"
                                invisible="not can_override or not is_override_active"
                                icon="fa-lock"/>
                        <field name="state" widget="statusbar"
                                statusbar_visible="draft,submitted"/>
                    </header>
                    <sheet>
                        <field name="is_deadline_passed" invisible="1"/>
                        <field name="cycle_deadline" invisible="1"/>
                        <field name="is_admin_user" invisible="1"/>
                        <field name="is_admin_or_officer" invisible="1"/>
                        <field name="is_override_active" invisible="1"/>
                        <field name="can_edit_ratings" invisible="1"/>
                        <field name="can_override" invisible="1"/>

                        <!-- Administrative Override Active Warning Alert Banner -->
                        <div class="alert alert-warning text-center" role="alert" invisible="not is_override_active">
                            <i class="fa fa-exclamation-triangle me-2"/> 
                            <strong>Administrative Override Active:</strong> Ratings editing is unlocked by HR/Administrator. All changes are recorded in the audit log. Click <strong>Lock Override</strong> when finished.
                        </div>



                        <!-- Deadline Passed Warning Alert Banner -->
                        <div class="alert alert-danger text-center" role="alert" invisible="not is_deadline_passed or state != 'draft' or is_override_active">
                            <i class="fa fa-exclamation-triangle me-2"/> 
                            <strong>Submission Deadline Passed:</strong> The submission deadline (<field name="cycle_deadline"/>) for this assessment cycle has passed. Standard submissions are closed. (Competency Administrators retain override permissions).
                        </div>

                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="cycle_id" readonly="1" force_save="1" domain="[('state', '=', 'open')]"/>
                                <field name="assessment_type" readonly="1" force_save="1"/>
                                <field name="employee_id" readonly="1" force_save="1" options="{'no_open': True, 'no_create': True}"/>
                            </group>
                            <group>
                                <field name="assessor_id" readonly="1" force_save="1" options="{'no_open': True, 'no_create': True}"/>
                                <field name="average_gap" invisible="state in ('draft', 'submitted', 'supervisor_review')"/>
                                <field name="is_locked"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Core Competencies" icon="fa-star" invisible="not core_line_ids">
                                <field name="core_line_ids" readonly="not can_edit_ratings">
                                    <list create="false" delete="false" editable="bottom" decoration-success="current_level != False" decoration-warning="not current_level">
                                        <field name="competency_definition" column_invisible="True"/>
                                        <field name="state" column_invisible="True"/>
                                        <field name="competency_id" readonly="1" string="Core Competency"/>
                                        <button name="action_open_guide" type="object" icon="fa-info-circle" title="View Behavioral Indicators &amp; Level Guidance" class="btn-link"/>
                                        <field name="required_level" readonly="1" column_invisible="parent.state in ('draft', 'submitted', 'supervisor_review')"/>
                                        <field name="current_level" required="1"/>
                                        <field name="gap" readonly="1" column_invisible="parent.state in ('draft', 'submitted', 'supervisor_review')"/>
                                        <field name="achievement_status" widget="badge" readonly="1" column_invisible="parent.state in ('draft', 'submitted', 'supervisor_review')"/>
                                        <field name="comments" string="Remarks / Comments"/>
                                        <field name="evidence_attachment_ids" widget="many2many_binary" string="Supporting Documents"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Leadership Competencies" icon="fa-users" invisible="not leadership_line_ids">
                                <field name="leadership_line_ids" readonly="not can_edit_ratings">
                                    <list create="false" delete="false" editable="bottom" decoration-success="current_level != False" decoration-warning="not current_level">
                                        <field name="competency_definition" column_invisible="True"/>
                                        <field name="state" column_invisible="True"/>
                                        <field name="competency_id" readonly="1" string="Leadership Competency"/>
                                        <button name="action_open_guide" type="object" icon="fa-info-circle" title="View Behavioral Indicators &amp; Level Guidance" class="btn-link"/>
                                        <field name="required_level" readonly="1" column_invisible="parent.state in ('draft', 'submitted', 'supervisor_review')"/>
                                        <field name="current_level" required="1"/>
                                        <field name="gap" readonly="1" column_invisible="parent.state in ('draft', 'submitted', 'supervisor_review')"/>
                                        <field name="achievement_status" widget="badge" readonly="1" column_invisible="parent.state in ('draft', 'submitted', 'supervisor_review')"/>
                                        <field name="comments" string="Remarks / Comments"/>
                                        <field name="evidence_attachment_ids" widget="many2many_binary" string="Supporting Documents"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Technical Competencies" icon="fa-cogs" invisible="not technical_line_ids">
                                <field name="technical_line_ids" readonly="not can_edit_ratings">
                                    <list create="false" delete="false" editable="bottom" decoration-success="current_level != False" decoration-warning="not current_level">
                                        <field name="competency_definition" column_invisible="True"/>
                                        <field name="state" column_invisible="True"/>
                                        <field name="competency_id" readonly="1" string="Technical Competency"/>
                                        <button name="action_open_guide" type="object" icon="fa-info-circle" title="View Behavioral Indicators &amp; Level Guidance" class="btn-link"/>
                                        <field name="required_level" readonly="1" column_invisible="parent.state in ('draft', 'submitted', 'supervisor_review')"/>
                                        <field name="current_level" required="1"/>
                                        <field name="gap" readonly="1" column_invisible="parent.state in ('draft', 'submitted', 'supervisor_review')"/>
                                        <field name="achievement_status" widget="badge" readonly="1" column_invisible="parent.state in ('draft', 'submitted', 'supervisor_review')"/>
                                        <field name="comments" string="Remarks / Comments"/>
                                        <field name="evidence_attachment_ids" widget="many2many_binary" string="Supporting Documents"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes" readonly="not can_edit_ratings"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Dedicated List View for My Competency Assessments (create="false") -->
        <record id="view_competency_assessment_my_list" model="ir.ui.view">
            <field name="name">competency.assessment.my.list</field>
            <field name="model">competency.assessment</field>
            <field name="arch" type="xml">
                <list create="false" delete="false">
                    <field name="name"/>
                    <field name="cycle_id"/>
                    <field name="assessment_type" widget="badge"/>
                    <field name="employee_id" string="Evaluatee (Employee Name)" options="{'no_open': True, 'no_create': True}"/>
                    <field name="job_id" string="Employee Job Position" optional="hide" options="{'no_open': True, 'no_create': True}"/>
                    <field name="grade_id" string="Employee Job Grade" optional="hide" options="{'no_open': True, 'no_create': True}"/>
                    <field name="department_id" optional="hide"/>
                    <field name="assessor_id" options="{'no_open': True, 'no_create': True}"/>
                    <field name="assessor_job_id" string="Assessor Job Position" optional="hide" options="{'no_open': True, 'no_create': True}"/>
                    <field name="assessor_grade_id" string="Assessor Job Grade" optional="hide" options="{'no_open': True, 'no_create': True}"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Assessment Search -->
        <record id="view_competency_assessment_search" model="ir.ui.view">
            <field name="name">competency.assessment.search</field>
            <field name="model">competency.assessment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="employee_id" context="{'competency_employee_select': True}"/>
                    <field name="cycle_id"/>
                    <field name="assessment_type"/>
                    <field name="assessor_id" context="{'competency_employee_select': True}"/>
                    <filter string="Current / Latest Cycle" name="filter_current_cycle" domain="[('cycle_id.is_open_or_latest', '=', True)]"/>
                    <separator/>
                    <filter string="Draft" name="state_draft" domain="[('state','=','draft')]"/>
                    <filter string="Submitted" name="state_submitted" domain="[('state','=','submitted')]"/>
                    <filter string="Approved" name="state_approved" domain="[('state','=','approved')]"/>
                    <separator/>
                    <filter string="Self Assessments" name="type_self" domain="[('assessment_type','=','self')]"/>
                    <filter string="Team Assessments" name="type_team" domain="[('assessment_type','=','team')]"/>
                    <filter string="Peer Assessments" name="type_peer" domain="[('assessment_type','=','peer')]"/>
                    <filter string="Subordinate Assessments" name="type_subordinate" domain="[('assessment_type','=','subordinate')]"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                    <group>
                        <filter string="Cycle" name="group_cycle" context="{'group_by':'cycle_id'}"/>
                        <filter string="Assessment Type" name="group_type" context="{'group_by':'assessment_type'}"/>
                        <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_competency_assessment" model="ir.actions.act_window">
            <field name="name">All Competency Assessments</field>
            <field name="res_model">competency.assessment</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="competency_management.view_competency_assessment_search"/>
            <field name="context">{'search_default_filter_current_cycle': 1, 'competency_employee_select': True}</field>
        </record>

        <record id="action_my_competency_assessment" model="ir.actions.act_window">
            <field name="name">My Competency Assessments</field>
            <field name="res_model">competency.assessment</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('assessor_id', '=', uid)]</field>
            <field name="view_id" ref="view_competency_assessment_my_list"/>
            <field name="search_view_id" ref="competency_management.view_competency_assessment_search"/>
            <field name="context">{'search_default_filter_current_cycle': 1, 'competency_employee_select': True}</field>
        </record>

        <!-- Dedicated Anonymized Employee Views for My Evaluations -->
        <record id="view_my_competency_evaluation_line_list" model="ir.ui.view">
            <field name="name">my.competency.evaluation.line.list</field>
            <field name="model">competency.assessment.line</field>
            <field name="arch" type="xml">
                <list string="My Competency Evaluation Results" create="false" edit="false" delete="false" default_order="cycle_id desc, id desc">
                    <field name="cycle_id"/>
                    <field name="employee_id" options="{'no_open': True, 'no_create': True}"/>
                    <field name="competency_id"/>
                    <field name="functional_domain"/>
                    <field name="pillar" widget="badge"/>
                    <field name="self_rating" string="Self Rating"/>
                    <field name="supervisor_avg" string="Supervisor Rating"/>
                    <field name="weighted_current_level" string="Weighted Level"/>
                    <field name="required_level"/>
                    <field name="gap"/>
                    <field name="tna_measure" widget="badge" decoration-danger="tna_measure == 'below'" decoration-success="tna_measure == 'meets'" decoration-info="tna_measure == 'exceeds'"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_my_competency_evaluation_line_form" model="ir.ui.view">
            <field name="name">my.competency.evaluation.line.form</field>
            <field name="model">competency.assessment.line</field>
            <field name="arch" type="xml">
                <form string="My Competency Evaluation Details" create="false" edit="false" delete="false">
                    <sheet>
                        <div class="oe_title" style="margin-bottom: 15px;">
                            <h1 style="color: #541718;"><field name="competency_id" readonly="1"/></h1>
                            <h4 class="text-muted"><field name="pillar" widget="badge" readonly="1"/></h4>
                        </div>

                        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-left: 4px solid #541718; border-radius: 6px; padding: 14px 18px; margin-bottom: 20px; width: 100%;">
                            <div style="font-size: 11px; font-weight: 700; color: #726732; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
                                Competency Definition
                            </div>
                            <div style="font-size: 13.5px; color: #1d2b32; line-height: 1.6;">
                                <field name="competency_definition" readonly="1" nolabel="1"/>
                            </div>
                        </div>

                        <group string="Evaluation Scores &amp; Matrix Performance">
                            <group string="Competency Ratings">
                                <field name="self_rating" string="Self Rating" readonly="1"/>
                                <field name="supervisor_avg" string="Supervisor Rating" readonly="1"/>
                                <field name="weighted_current_level" string="Weighted Current Level" readonly="1"/>
                            </group>
                            <group string="Matrix Performance &amp; Gap">
                                <field name="required_level" readonly="1"/>
                                <field name="gap" readonly="1"/>
                                <field name="tna_measure" widget="badge" readonly="1"/>
                                <field name="achievement_status" widget="badge" readonly="1"/>
                            </group>
                        </group>

                        <div class="mt-4 mb-3">
                            <h3 style="color: #1d2b32; border-bottom: 2px solid #541718; padding-bottom: 6px; font-size: 15px; font-weight: 700;">
                                📖 Behavioral Guide Indicators Across Proficiency Levels
                            </h3>
                            <field name="behavioral_guide_html" readonly="1" nolabel="1"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- My Competency Evaluation Results Action (Employee View) -->
        <record id="action_my_competency_evaluations" model="ir.actions.act_window">
            <field name="name">My Competency Evaluation Results</field>
            <field name="res_model">competency.assessment.line</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('employee_id.user_id', '=', uid), ('is_primary_reporting_line', '=', True)]</field>
            <field name="search_view_id" ref="view_competency_assessment_line_search"/>
            <field name="context">{'search_default_filter_current_cycle': 1, 'search_default_filter_primary_reporting': 1, 'create': False, 'edit': False, 'delete': False}</field>
        </record>

        <record id="act_my_evaluations_list" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_my_competency_evaluation_line_list"/>
            <field name="act_window_id" ref="action_my_competency_evaluations"/>
        </record>

        <record id="act_my_evaluations_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_my_competency_evaluation_line_form"/>
            <field name="act_window_id" ref="action_my_competency_evaluations"/>
        </record>

        <!-- Detailed Competency & TNA Analytics Views -->
        <record id="view_competency_assessment_line_report_list" model="ir.ui.view">
            <field name="name">competency.assessment.line.report.list</field>
            <field name="model">competency.assessment.line</field>
            <field name="arch" type="xml">
                <list string="Competency &amp; TNA Analytics Lines" create="false" edit="false" delete="false">
                    <field name="cycle_id"/>
                    <field name="employee_id" options="{'no_open': True, 'no_create': True}"/>
                    <field name="operating_unit_id"/>
                    <field name="department_id"/>
                    <field name="job_id"/>
                    <field name="grade_id"/>
                    <field name="competency_id"/>
                    <field name="functional_domain"/>
                    <field name="pillar" widget="badge"/>
                    <field name="self_rating" optional="show"/>
                    <field name="peer_avg" optional="show"/>
                    <field name="subordinate_avg" optional="show"/>
                    <field name="supervisor_avg" optional="show"/>
                    <field name="team_avg" optional="hide"/>
                    <field name="weighted_current_level" string="Weighted Current Level"/>
                    <field name="required_level"/>
                    <field name="gap"/>
                    <field name="tna_measure" widget="badge" decoration-danger="tna_measure == 'below'" decoration-success="tna_measure == 'meets'" decoration-info="tna_measure == 'exceeds'"/>
                    <field name="state" widget="badge"/>
                    <button name="action_view_360_breakdown" string="📊 Breakdown" type="object" class="btn-sm btn-outline-primary"/>
                </list>
            </field>
        </record>

        <!-- Dedicated Strictly Read-Only Form View for Reporting Lines -->
        <record id="view_competency_assessment_line_report_form" model="ir.ui.view">
            <field name="name">competency.assessment.line.report.form</field>
            <field name="model">competency.assessment.line</field>
            <field name="priority" eval="10"/>
            <field name="arch" type="xml">
                <form string="Competency Evaluation Line Details" create="false" edit="false" delete="false">
                    <header>
                        <button name="action_view_360_breakdown" string="🔍 View 360 Rater Score Breakdown"
                                type="object" class="oe_highlight"/>
                    </header>
                    <sheet>
                        <div class="oe_title" style="margin-bottom: 15px;">
                            <h1 style="color: #541718;"><field name="competency_id" readonly="1"/></h1>
                            <h4 class="text-muted"><field name="pillar" widget="badge" readonly="1"/></h4>
                        </div>

                        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-left: 4px solid #541718; border-radius: 6px; padding: 14px 18px; margin-bottom: 20px; width: 100%;">
                            <div style="font-size: 11px; font-weight: 700; color: #726732; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
                                Competency Definition
                            </div>
                            <div style="font-size: 13.5px; color: #1d2b32; line-height: 1.6;">
                                <field name="competency_definition" readonly="1" nolabel="1"/>
                            </div>
                        </div>

                        <group string="360° Rating Summary &amp; Matrix Achievement">
                            <group string="360° Multi-Rater Scores">
                                <field name="self_rating" readonly="1"/>
                                <field name="peer_avg" readonly="1"/>
                                <field name="subordinate_avg" readonly="1"/>
                                <field name="supervisor_avg" readonly="1"/>
                                <field name="team_avg" readonly="1"/>
                            </group>
                            <group string="Matrix Performance &amp; Gap">
                                <field name="required_level" readonly="1"/>
                                <field name="weighted_current_level" readonly="1"/>
                                <field name="gap" readonly="1"/>
                                <field name="tna_measure" widget="badge" readonly="1"/>
                                <field name="achievement_status" widget="badge" readonly="1"/>
                            </group>
                        </group>

                        <div class="mt-4 mb-3">
                            <h3 style="color: #1d2b32; border-bottom: 2px solid #541718; padding-bottom: 6px; font-size: 15px; font-weight: 700;">
                                📖 Behavioral Guide Indicators Across Proficiency Levels
                            </h3>
                            <field name="behavioral_guide_html" readonly="1" nolabel="1"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_competency_assessment_line_report_pivot" model="ir.ui.view">
            <field name="name">competency.assessment.line.report.pivot</field>
            <field name="model">competency.assessment.line</field>
            <field name="arch" type="xml">
                <pivot string="Competency &amp; TNA Analytics Pivot">
                    <field name="cycle_id" type="row"/>
                    <field name="department_id" type="row"/>
                    <field name="tna_measure" type="col"/>
                    <field name="gap" type="measure"/>
                    <field name="current_level_num" string="Avg Current Level" type="measure"/>
                    <field name="required_level_num" string="Avg Required Level" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_competency_assessment_line_report_graph" model="ir.ui.view">
            <field name="name">competency.assessment.line.report.graph</field>
            <field name="model">competency.assessment.line</field>
            <field name="arch" type="xml">
                <graph string="Competency &amp; TNA Analytics Graph" type="bar">
                    <field name="department_id"/>
                    <field name="tna_measure"/>
                    <field name="gap" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_competency_assessment_line_report_search" model="ir.ui.view">
            <field name="name">competency.assessment.line.report.search</field>
            <field name="model">competency.assessment.line</field>
            <field name="arch" type="xml">
                <search string="Search Competency &amp; TNA Analytics">
                    <field name="cycle_id"/>
                    <field name="employee_id" context="{'competency_employee_select': True}"/>
                    <field name="department_id"/>
                    <field name="operating_unit_id"/>
                    <field name="competency_id"/>
                    <field name="pillar"/>
                    <field name="tna_measure"/>
                    <field name="state"/>
                    <filter string="🎯 Consolidated 360 (1 Line / Competency)" name="filter_primary_reporting" domain="[('is_primary_reporting_line', '=', True)]"/>
                    <filter string="Approved Assessments" name="filter_approved" domain="[('state', 'in', ['approved', 'locked'])]"/>
                    <separator/>
                    <filter string="Core Pillar" name="filter_core" domain="[('pillar', '=', 'core')]"/>
                    <filter string="Leadership Pillar" name="filter_leadership" domain="[('pillar', '=', 'leadership')]"/>
                    <filter string="Technical Pillar" name="filter_technical" domain="[('pillar', '=', 'technical')]"/>
                    <separator/>
                    <filter string="🚨 Underqualified (Training Needed)" name="filter_below" domain="[('tna_measure', '=', 'below')]"/>
                    <filter string="✅ Fit / Qualified" name="filter_meets" domain="[('tna_measure', '=', 'meets')]"/>
                    <filter string="⭐ Overqualified" name="filter_exceeds" domain="[('tna_measure', '=', 'exceeds')]"/>
                    <group>
                        <filter string="Assessment Cycle" name="group_by_cycle" context="{'group_by': 'cycle_id'}"/>
                        <filter string="Operating Unit" name="group_by_ou" context="{'group_by': 'operating_unit_id'}"/>
                        <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                        <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Competency" name="group_by_competency" context="{'group_by': 'competency_id'}"/>
                        <filter string="Pillar" name="group_by_pillar" context="{'group_by': 'pillar'}"/>
                        <filter string="Fitness Status" name="group_by_tna" context="{'group_by': 'tna_measure'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_competency_tna_analytics_report" model="ir.actions.act_window">
            <field name="name">Competency &amp; TNA Assessment Line Report</field>
            <field name="res_model">competency.assessment.line</field>
            <field name="view_mode">list,graph,pivot,form</field>
            <field name="domain">[('is_primary_reporting_line', '=', True)]</field>
            <field name="context">{'search_default_filter_primary_reporting': 1, 'competency_employee_select': True, 'create': False, 'edit': False, 'delete': False}</field>
            <field name="search_view_id" ref="view_competency_assessment_line_report_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No competency assessment lines found for analysis.
                </p>
            </field>
        </record>

        <record id="act_tna_report_list" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_competency_assessment_line_report_list"/>
            <field name="act_window_id" ref="action_competency_tna_analytics_report"/>
        </record>

        <record id="act_tna_report_graph" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="view_competency_assessment_line_report_graph"/>
            <field name="act_window_id" ref="action_competency_tna_analytics_report"/>
        </record>

        <record id="act_tna_report_pivot" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="view_competency_assessment_line_report_pivot"/>
            <field name="act_window_id" ref="action_competency_tna_analytics_report"/>
        </record>

        <record id="act_tna_report_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="4"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_competency_assessment_line_report_form"/>
            <field name="act_window_id" ref="action_competency_tna_analytics_report"/>
        </record>

    </data>
</odoo>
