<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_competency_notification_list" model="ir.ui.view">
        <field name="name">competency.notification.list</field>
        <field name="model">competency.notification</field>
        <field name="arch" type="xml">
            <list string="My Competency Notifications" create="0" edit="0" delete="0" default_order="create_date desc">
                <field name="create_date" string="Received"/>
                <field name="cycle_id"/>
                <field name="summary"/>
                <field name="name" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_competency_notification_form" model="ir.ui.view">
        <field name="name">competency.notification.form</field>
        <field name="model">competency.notification</field>
        <field name="arch" type="xml">
            <form string="Competency Notification" create="0" edit="0" delete="0">
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <field name="create_date" string="Received"/>
                        <field name="cycle_id"/>
                    </group>
                    <field name="body" widget="html" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_competency_notification_search" model="ir.ui.view">
        <field name="name">competency.notification.search</field>
        <field name="model">competency.notification</field>
        <field name="arch" type="xml">
            <search string="Competency Notifications">
                <field name="name"/>
                <field name="summary"/>
                <field name="cycle_id"/>
                <group>
                    <filter name="group_cycle" string="Cycle" context="{'group_by': 'cycle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_my_competency_notifications" model="ir.actions.act_window">
        <field name="name">My Competency Notifications</field>
        <field name="res_model">competency.notification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
