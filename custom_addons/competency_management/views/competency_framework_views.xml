<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Framework Tree -->
        <record id="view_competency_framework_list" model="ir.ui.view">
            <field name="name">competency.framework.list</field>
            <field name="model">competency.framework</field>
            <field name="arch" type="xml">
                <list>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="version"/>
                    <field name="effective_date"/>
                    <field name="state" widget="badge"/>
                    <field name="approved_by_id"/>
                </list>
            </field>
        </record>

        <!-- Framework Form -->
        <record id="view_competency_framework_form" model="ir.ui.view">
            <field name="name">competency.framework.form</field>
            <field name="model">competency.framework</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_submit_for_approval" string="Submit for Approval"
                                type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_approve" string="Approve Framework"
                                type="object" class="oe_highlight" invisible="state != 'under_approval'"/>
                        <button name="action_create_new_version" string="Create New Version"
                                type="object" invisible="state != 'approved'"/>
                        <button name="action_retire" string="Retire Framework"
                                type="object" invisible="state == 'retired'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,under_approval,approved,retired"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="version"/>
                                <field name="effective_date"/>
                            </group>
                            <group>
                                <field name="approved_by_id"/>
                                <field name="approval_date"/>
                            </group>
                        </group>
                        <group string="Change Description" invisible="not change_description">
                            <field name="change_description"/>
                        </group>
                        <notebook>
                            <page string="Competencies">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="competency_id"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Approval History">
                                <field name="approval_history_ids" readonly="1">
                                    <list>
                                        <field name="action"/>
                                        <field name="user_id"/>
                                        <field name="create_date"/>
                                        <field name="comment"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_competency_framework_search" model="ir.ui.view">
            <field name="name">competency.framework.search</field>
            <field name="model">competency.framework</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <filter string="Approved" name="state_approved" domain="[('state','=','approved')]"/>
                    <filter string="Draft" name="state_draft" domain="[('state','=','draft')]"/>
                    <separator/>
                    <group name="group_by">
                        <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_competency_framework" model="ir.actions.act_window">
            <field name="name">Competency Frameworks</field>
            <field name="res_model">competency.framework</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="competency_management.view_competency_framework_search"/>
        </record>

    </data>
</odoo>
