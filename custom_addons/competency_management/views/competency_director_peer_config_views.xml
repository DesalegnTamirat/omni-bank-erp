<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Executive Peer Config Form View -->
        <record id="view_competency_director_peer_config_form" model="ir.ui.view">
            <field name="name">competency.director.peer.config.form</field>
            <field name="model">competency.director.peer.config</field>
            <field name="arch" type="xml">
                <form string="Executive Peer Configuration">
                    <header>
                        <button name="action_sync_cycle_peers"
                                string="Sync Peers with Open Cycle"
                                type="object"
                                class="btn-primary"
                                invisible="not has_open_cycle"
                                icon="fa-refresh"
                                groups="competency_management.group_competency_admin"/>
                    </header>
                    <sheet>
                        <field name="has_open_cycle" invisible="1"/>
                        <widget name="web_ribbon" title="Executive Leadership" bg_color="bg-info"/>
                        <div class="oe_title">
                            <h1>
                                <field name="director_id" domain="[('is_director_or_chief', '=', True), ('active', '=', True)]" options="{'no_open': True, 'no_create': True}" context="{'competency_employee_select': True, 'competency_peer_select': True}" placeholder="Select Director or Chief..."/>
                            </h1>
                        </div>
                        <group>
                            <group string="Executive Profile &amp; Position">
                                <field name="job_id" options="{'no_open': True}"/>
                                <field name="grade_id" options="{'no_open': True}"/>
                                <field name="department_id" options="{'no_open': True}"/>
                                <field name="operating_unit_id" options="{'no_open': True}"/>
                                <field name="coach_id" options="{'no_open': True}"/>
                            </group>
                            <group string="Additional Info">
                                <field name="notes" placeholder="Notes or justification for custom peer assignments..."/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Assigned 360° Peers" name="peers">
                                <field name="peer_ids" widget="many2many_tags" domain="[('is_director_or_chief', '=', True), ('active', '=', True)]" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" context="{'competency_employee_select': True, 'competency_peer_select': True}" placeholder="Select peer Directors or Chiefs..."/>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- Executive Peer Config List View -->
        <record id="view_competency_director_peer_config_list" model="ir.ui.view">
            <field name="name">competency.director.peer.config.list</field>
            <field name="model">competency.director.peer.config</field>
            <field name="arch" type="xml">
                <list string="Executive Peer Configurations">
                    <header>
                        <button name="action_generate_director_records"
                                string="Scan Executives (Chiefs &amp; Directors)"
                                type="object"
                                class="btn-primary"
                                icon="fa-users"
                                groups="competency_management.group_competency_admin"/>
                    </header>
                    <field name="has_open_cycle" column_invisible="True"/>
                    <field name="director_id" domain="[('is_director_or_chief', '=', True), ('active', '=', True)]" options="{'no_open': True, 'no_create': True}"/>
                    <field name="job_id" options="{'no_open': True}"/>
                    <field name="grade_id" options="{'no_open': True}"/>
                    <field name="department_id" options="{'no_open': True}"/>
                    <field name="operating_unit_id" options="{'no_open': True}"/>
                    <field name="coach_id" options="{'no_open': True}"/>
                    <field name="peer_count" string="Assigned Peers" widget="badge"/>
                    <field name="peer_ids" widget="many2many_tags" optional="hide"/>
                    <button name="action_sync_cycle_peers" string="Sync Peers" type="object"
                            class="btn-sm btn-outline-primary" icon="fa-refresh"
                            invisible="not has_open_cycle" groups="competency_management.group_competency_admin"/>
                </list>
            </field>
        </record>

        <!-- Executive Peer Config Search View -->
        <record id="view_competency_director_peer_config_search" model="ir.ui.view">
            <field name="name">competency.director.peer.config.search</field>
            <field name="model">competency.director.peer.config</field>
            <field name="arch" type="xml">
                <search string="Search Executive Peer Configurations">
                    <field name="director_id"/>
                    <field name="job_id"/>
                    <field name="grade_id"/>
                    <field name="department_id"/>
                    <field name="operating_unit_id"/>
                    <field name="coach_id"/>
                    <filter string="Job Position" name="group_job" context="{'group_by': 'job_id'}"/>
                    <filter string="Job Grade" name="group_grade" context="{'group_by': 'grade_id'}"/>
                    <filter string="Department" name="group_dept" context="{'group_by': 'department_id'}"/>
                    <filter string="Operating Unit" name="group_ou" context="{'group_by': 'operating_unit_id'}"/>
                    <filter string="Coach / Supervisor" name="group_coach" context="{'group_by': 'coach_id'}"/>
                </search>
            </field>
        </record>

        <!-- Executive Peer Config Window Action -->
        <record id="action_competency_director_peer_config" model="ir.actions.act_window">
            <field name="name">Executive Peer Configuration</field>
            <field name="res_model">competency.director.peer.config</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'competency_peer_select': True, 'competency_employee_select': True}</field>
            <field name="search_view_id" ref="view_competency_director_peer_config_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure custom 360-degree peers for Directors &amp; Chiefs!
                </p>
                <p>
                    Click "Scan Executives" to auto-discover all Directors and Chiefs in the bank, then assign peers sharing the executive's coach.
                </p>
            </field>
        </record>

        <!-- Server Action for Menu: Auto-populate and open Executive Peer Configuration -->
        <record id="action_competency_director_peer_config_server" model="ir.actions.server">
            <field name="name">Executive Peer Configuration</field>
            <field name="model_id" ref="model_competency_director_peer_config"/>
            <field name="state">code</field>
            <field name="code">
                action = model.action_open_director_peer_config()
            </field>
        </record>

    </data>
</odoo>
