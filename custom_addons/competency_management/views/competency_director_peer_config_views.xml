<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Director Peer Config Form View -->
        <record id="view_competency_director_peer_config_form" model="ir.ui.view">
            <field name="name">competency.director.peer.config.form</field>
            <field name="model">competency.director.peer.config</field>
            <field name="arch" type="xml">
                <form string="Director Peer Configuration">
                    <header>
                        <button name="action_sync_cycle_peers"
                                string="Sync Peers with Open Cycle"
                                type="object"
                                class="btn-primary"
                                invisible="not has_open_cycle"
                                icon="fa-refresh"
                                groups="competency_management.group_competency_admin"/>
                        <button name="action_generate_director_records"
                                string="Generate Director Records"
                                type="object"
                                class="btn-secondary"
                                groups="competency_management.group_competency_admin"/>
                    </header>
                    <sheet>
                        <field name="has_open_cycle" invisible="1"/>
                        <widget name="web_ribbon" title="Director Configuration" bg_color="bg-info"/>
                        <div class="oe_title">
                            <h1>
                                <field name="director_id" domain="[('is_director_or_chief', '=', True), ('active', '=', True)]" placeholder="Select Director or Chief..."/>
                            </h1>
                        </div>
                        <group>
                            <group string="Director Profile &amp; Position">
                                <field name="job_id"/>
                                <field name="grade_id"/>
                                <field name="department_id"/>
                                <field name="operating_unit_id"/>
                                <field name="coach_id"/>
                            </group>
                            <group string="Additional Info">
                                <field name="notes" placeholder="Notes or justification for custom peer assignments..."/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Assigned 360° Peers" name="peers">
                                <field name="candidate_peer_ids" invisible="1"/>
                                <field name="peer_ids" widget="many2many_tags" domain="[('id', 'in', candidate_peer_ids)]" options="{'no_create': True, 'no_create_edit': True}" placeholder="Select peer Directors or Chiefs..."/>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- Director Peer Config List View -->
        <record id="view_competency_director_peer_config_list" model="ir.ui.view">
            <field name="name">competency.director.peer.config.list</field>
            <field name="model">competency.director.peer.config</field>
            <field name="arch" type="xml">
                <list string="Director Peer Configurations">
                    <header>
                        <button name="action_generate_director_records"
                                string="Generate Director Records"
                                type="object"
                                class="btn-primary"
                                groups="competency_management.group_competency_admin"/>
                    </header>
                    <field name="has_open_cycle" column_invisible="True"/>
                    <field name="director_id" domain="[('is_director_or_chief', '=', True), ('active', '=', True)]"/>
                    <field name="job_id"/>
                    <field name="grade_id"/>
                    <field name="department_id"/>
                    <field name="operating_unit_id"/>
                    <field name="coach_id"/>
                    <field name="peer_ids" widget="many2many_tags"/>
                    <button name="action_sync_cycle_peers" string="Sync Peers" type="object"
                            class="btn-sm btn-outline-primary" icon="fa-refresh"
                            invisible="not has_open_cycle" groups="competency_management.group_competency_admin"/>
                </list>
            </field>
        </record>

        <!-- Director Peer Config Search View -->
        <record id="view_competency_director_peer_config_search" model="ir.ui.view">
            <field name="name">competency.director.peer.config.search</field>
            <field name="model">competency.director.peer.config</field>
            <field name="arch" type="xml">
                <search string="Search Director Peer Configurations">
                    <field name="director_id"/>
                    <field name="job_id"/>
                    <field name="grade_id"/>
                    <field name="department_id"/>
                    <field name="operating_unit_id"/>
                    <field name="coach_id"/>
                    <filter string="Job Position" name="group_job" context="{'group_by': 'job_id'}"/>
                    <filter string="Job Grade" name="group_grade" context="{'group_by': 'grade_id'}"/>
                    <filter string="Department" name="group_dept" context="{'group_by': 'department_id'}"/>
                    <filter string="Operating Unit" name="group_ou" context="{'group_by': 'operating_unit_id'}"/>
                    <filter string="Coach / Supervisor" name="group_coach" context="{'group_by': 'coach_id'}"/>
                </search>
            </field>
        </record>



        <!-- Director Peer Config Window Action -->
        <record id="action_competency_director_peer_config" model="ir.actions.act_window">
            <field name="name">Director Peer Configuration</field>
            <field name="res_model">competency.director.peer.config</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_competency_director_peer_config_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure custom 360-degree peers for Directors!
                </p>
                <p>
                    Click "Generate Director Records" to auto-discover all Directors in the bank, then assign peers sharing the Director's coach.
                </p>
            </field>
        </record>

        <!-- Server Action for Menu: Auto-populate and open Director Peer Configuration -->
        <record id="action_competency_director_peer_config_server" model="ir.actions.server">
            <field name="name">Director Peer Configuration</field>
            <field name="model_id" ref="model_competency_director_peer_config"/>
            <field name="state">code</field>
            <field name="code">
                action = model.action_open_director_peer_config()
            </field>
        </record>

    </data>
</odoo>
