<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Competency Cluster List View -->
        <record id="view_competency_cluster_list" model="ir.ui.view">
            <field name="name">competency.cluster.list</field>
            <field name="model">competency.cluster</field>
            <field name="arch" type="xml">
                <list>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="min_proficiency"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Competency Cluster Form View -->
        <record id="view_competency_cluster_form" model="ir.ui.view">
            <field name="name">competency.cluster.form</field>
            <field name="model">competency.cluster</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="min_proficiency"/>
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" placeholder="Describe the purpose of this competency cluster..."/>
                        </group>
                        <group string="Competencies in Cluster">
                            <field name="competency_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_competency_cluster" model="ir.actions.act_window">
            <field name="name">Competency Clusters</field>
            <field name="res_model">competency.cluster</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Server Action to trigger Matrix & Cluster Seeding -->
        <record id="action_trigger_matrix_seeding" model="ir.actions.server">
            <field name="name">Re-Seed Matrix Competencies &amp; Clusters</field>
            <field name="model_id" ref="model_competency_competency"/>
            <field name="state">code</field>
            <field name="code">
action = env['competency.competency'].action_seed_matrix_data()
            </field>
        </record>
    </data>
</odoo>
