                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- Detailed Competency Performance & Gap Matrix QWeb Template -->
        <template id="report_competency_detailed_matrix">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page" style="font-family: Arial, sans-serif; font-size: 12px; color: #1d2b32; padding: 10px;">
                            <div style="background-color: #541718; color: #FFFFFF; padding: 14px 18px; border-radius: 6px; margin-bottom: 16px; border-bottom: 4px solid #726732;">
                                <h2 style="margin: 0; font-size: 18px; font-weight: 700; color: #FFFFFF;">BUNNA BANK S.C.</h2>
                                <div style="font-size: 13px; font-weight: 500; color: #c17540; margin-top: 2px;">
                                    Detailed Competency Performance &amp; 360 Multi-Rater Gap Matrix
                                </div>
                            </div>
                            <t t-set="rows" t-value="doc._get_360_report_data_rows()"/>
                            <table style="width: 100%; border-collapse: collapse; font-size: 10px;">
                                <thead>
                                    <tr style="background-color: #541718; color: #ffffff;">
                                        <th style="padding: 5px; text-align: left;">Employee</th>
                                        <th style="padding: 5px; text-align: left;">Job Position</th>
                                        <th style="padding: 5px; text-align: left;">Competency</th>
                                        <th style="padding: 5px; text-align: center;">Self</th>
                                        <th style="padding: 5px; text-align: center;">Peer</th>
                                        <th style="padding: 5px; text-align: center;">Supervisor</th>
                                        <th style="padding: 5px; text-align: center;">Weighted</th>
                                        <th style="padding: 5px; text-align: center;">Required</th>
                                        <th style="padding: 5px; text-align: center;">Gap</th>
                                        <th style="padding: 5px; text-align: center;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="rows" t-as="r">
