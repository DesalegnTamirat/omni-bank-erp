                                            <td style="padding: 4px;"><t t-out="r['emp_name']"/></td>
                                            <td style="padding: 4px;"><t t-out="r['job_name']"/></td>
                                            <td style="padding: 4px;"><t t-out="r['competency_name']"/></td>
                                            <td style="padding: 4px; text-align: center;"><t t-out="r['self_rating']"/></td>
                                            <td style="padding: 4px; text-align: center;"><t t-out="r['peer_avg']"/></td>
                                            <td style="padding: 4px; text-align: center;"><t t-out="r['supervisor_avg']"/></td>
                                            <td style="padding: 4px; text-align: center; font-weight: 700;"><t t-out="r['weighted_rating']"/></td>
                                            <td style="padding: 4px; text-align: center;"><t t-out="r['required_level']"/></td>
                                            <td style="padding: 4px; text-align: center;"><t t-out="r['weighted_gap']"/></td>
                                            <td style="padding: 4px; text-align: center; font-weight: 600;"><t t-out="r['achievement_status']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

