<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_competency_management" model="ir.module.category">
            <field name="name">Competency Management</field>
            <field name="description">Competency Management System Access Control</field>
            <field name="sequence">26</field>
        </record>

        <!-- Privilege -->
        <record id="res_groups_privilege_competency" model="res.groups.privilege">
            <field name="name">Competency Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="competency_management.module_category_competency_management"/>
        </record>

        <!-- 1. Group: User / Employee (Default role for all employees) -->
        <record id="group_competency_employee" model="res.groups">
            <field name="name">User / Employee</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="competency_management.res_groups_privilege_competency"/>
            <field name="comment">Default role for all employees. Can view approved competency reference dictionary, own job position mapping, and complete assigned self-assessments.</field>
        </record>

        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_competency_employee'))]"/>
        </record>

        <!-- 2. Group: Supervisor / Manager (Coaches & Team Managers) -->
        <record id="group_competency_supervisor" model="res.groups">
            <field name="name">Supervisor / Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="competency_management.res_groups_privilege_competency"/>
            <field name="implied_ids" eval="[(4, ref('competency_management.group_competency_employee'))]"/>
            <field name="comment">Can view own job mapping and team job mappings, assess team members, and generate team reporting within assigned Operating Units.</field>
        </record>

        <!-- 3. Group: HR / People Solution Officer -->
        <record id="group_competency_officer" model="res.groups">
            <field name="name">HR / People Solution Officer</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="competency_management.res_groups_privilege_competency"/>
            <field name="implied_ids" eval="[(4, ref('competency_management.group_competency_supervisor'))]"/>
            <field name="comment">Can view all competencies and role mappings, draft/edit competencies and mappings for approval, manage cycles (extend deadline, start cycle), edit matrix configuration, and view all assessments.</field>
        </record>

        <!-- 4. Group: Competency Administrator (People Solution Director / Chief) -->
        <record id="group_competency_admin" model="res.groups">
            <field name="name">Competency Administrator</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="competency_management.res_groups_privilege_competency"/>
            <field name="implied_ids" eval="[(4, ref('competency_management.group_competency_officer'))]"/>
            <field name="comment">Full admin access: create assessment cycles, approve competency dictionary entries and job mappings, close cycles, and full system configuration.</field>
        </record>

    </data>

    <!-- Record Rules -->
    <data noupdate="0">

        <!-- Assessment: employee sees only own records where they are the assessor (self-assessment or assigned evaluations) -->
        <record id="rule_competency_assessment_employee_own" model="ir.rule">
            <field name="name">Employee Own Competency Assessments</field>
            <field name="model_id" ref="competency_management.model_competency_assessment"/>
            <field name="domain_force">[('assessor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Assessment: supervisor sees assessments of team members if and only if both employee and assessor are in team, and supervisor is not the evaluatee being assessed by someone else -->
        <record id="rule_competency_assessment_supervisor_team" model="ir.rule">
            <field name="name">Supervisor Team Competency Assessments</field>
            <field name="model_id" ref="competency_management.model_competency_assessment"/>
            <field name="domain_force">['&amp;', '&amp;', ('employee_id', 'in', user.team_employee_ids.ids), ('assessor_employee_id', 'in', user.team_employee_ids.ids), '|', ('employee_id', '!=', user.employee_id.id), ('assessor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Assessment: employees & supervisors can only write their own assigned assessments -->
        <record id="rule_competency_assessment_assessor_write" model="ir.rule">
            <field name="name">Assessor Competency Assessment Write</field>
            <field name="model_id" ref="competency_management.model_competency_assessment"/>
            <field name="domain_force">[('assessor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_employee')), (4, ref('competency_management.group_competency_supervisor'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Assessment: officer & admin see all assessments -->
        <record id="rule_competency_assessment_officer_all" model="ir.rule">
            <field name="name">Officer All Competency Assessments</field>
            <field name="model_id" ref="competency_management.model_competency_assessment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_officer'))]"/>
        </record>

        <!-- Assessment Cycles: officer & admin see all cycles -->
        <record id="rule_competency_assessment_cycle_officer_all" model="ir.rule">
            <field name="name">Officer All Assessment Cycles</field>
            <field name="model_id" ref="competency_management.model_competency_assessment_cycle"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_officer'))]"/>
        </record>

        <record id="rule_competency_assessment_cycle_employee_read" model="ir.rule">
            <field name="name">Employee All Assessment Cycles Read</field>
            <field name="model_id" ref="competency_management.model_competency_assessment_cycle"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR Employee Read Access for 360 Degree Competency Evaluations -->
        <record id="rule_hr_employee_competency_read" model="ir.rule">
            <field name="name">360 Competency Evaluation HR Employee Read Access</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('id', 'child_of', user.employee_id.id), ('id', 'in', user.env['competency.assessment'].search([('assessor_id', '=', user.id)]).mapped('employee_id').ids)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_employee')), (4, ref('competency_management.group_competency_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="active" eval="False"/>
        </record>

        <!-- Dashboard Snapshot: supervisor / manager sees own Operating Unit snapshots -->
        <record id="rule_competency_dashboard_snapshot_supervisor" model="ir.rule">
            <field name="name">Supervisor Operating Unit Dashboard Snapshots</field>
            <field name="model_id" ref="competency_management.model_competency_dashboard_snapshot"/>
            <field name="domain_force">['|', ('operating_unit_id', '=', False), '|', ('operating_unit_id', 'in', user.assigned_operating_unit_ids.ids), ('department_id.operating_unit_id', 'in', user.assigned_operating_unit_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_supervisor'))]"/>
        </record>

        <record id="rule_competency_dashboard_snapshot_officer" model="ir.rule">
            <field name="name">Officer All Dashboard Snapshots</field>
            <field name="model_id" ref="competency_management.model_competency_dashboard_snapshot"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_officer'))]"/>
        </record>

        <!-- Assessment lines: mirror parent assessment rules -->
        <record id="rule_competency_assessment_line_employee_own" model="ir.rule">
            <field name="name">Employee Own Assessment Lines Read</field>
            <field name="model_id" ref="competency_management.model_competency_assessment_line"/>
            <field name="domain_force">[('assessment_id.assessor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_competency_assessment_line_supervisor_team" model="ir.rule">
            <field name="name">Supervisor Team Assessment Lines Read</field>
            <field name="model_id" ref="competency_management.model_competency_assessment_line"/>
            <field name="domain_force">['&amp;', '&amp;', ('assessment_id.employee_id', 'in', user.team_employee_ids.ids), ('assessment_id.assessor_employee_id', 'in', user.team_employee_ids.ids), '|', ('assessment_id.employee_id', '!=', user.employee_id.id), ('assessment_id.assessor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_competency_assessment_line_assessor_write" model="ir.rule">
            <field name="name">Assessor Assessment Lines Write</field>
            <field name="model_id" ref="competency_management.model_competency_assessment_line"/>
            <field name="domain_force">[('assessment_id.assessor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_employee')), (4, ref('competency_management.group_competency_supervisor'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_competency_assessment_line_officer_all" model="ir.rule">
            <field name="name">Officer All Assessment Lines</field>
            <field name="model_id" ref="competency_management.model_competency_assessment_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_officer'))]"/>
        </record>

        <!-- Multi-company rules for assessment -->
        <record id="rule_competency_assessment_multi_company" model="ir.rule">
            <field name="name">Competency Assessment Multi Company</field>
            <field name="model_id" ref="competency_management.model_competency_assessment"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Competency Dictionary Record Rules -->
        <record id="rule_competency_competency_employee_approved_active" model="ir.rule">
            <field name="name">Employee Approved Active Competencies Only</field>
            <field name="model_id" ref="competency_management.model_competency_competency"/>
            <field name="domain_force">[('state', '=', 'approved'), ('status', '=', 'active')]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_competency_competency_officer_all" model="ir.rule">
            <field name="name">Officer All Competencies</field>
            <field name="model_id" ref="competency_management.model_competency_competency"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_officer'))]"/>
        </record>

        <!-- Role-Competency Mapping Record Rules -->
        <record id="rule_competency_role_mapping_employee_own" model="ir.rule">
            <field name="name">Employee Scoped Role Mappings</field>
            <field name="model_id" ref="competency_management.model_competency_role_mapping"/>
            <field name="domain_force">[('job_position_id', 'in', user.allowed_role_mapping_job_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_competency_role_mapping_supervisor_team" model="ir.rule">
            <field name="name">Supervisor Scoped Role Mappings</field>
            <field name="model_id" ref="competency_management.model_competency_role_mapping"/>
            <field name="domain_force">[('job_position_id', 'in', user.allowed_role_mapping_job_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_competency_role_mapping_supervisor_own" model="ir.rule">
            <field name="name">Supervisor Own Scoped Role Mappings</field>
            <field name="model_id" ref="competency_management.model_competency_role_mapping"/>
            <field name="domain_force">[('job_position_id', 'in', user.allowed_role_mapping_job_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_competency_role_mapping_officer_all" model="ir.rule">
            <field name="name">Officer All Competency Role Mappings</field>
            <field name="model_id" ref="competency_management.model_competency_role_mapping"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_officer'))]"/>
        </record>

        <record id="rule_competency_role_mapping_admin_all" model="ir.rule">
            <field name="name">Admin All Competency Role Mappings</field>
            <field name="model_id" ref="competency_management.model_competency_role_mapping"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_admin'))]"/>
        </record>

        <!-- Role-Competency Mapping Line Record Rules -->
        <record id="rule_competency_role_mapping_line_employee" model="ir.rule">
            <field name="name">Employee Scoped Competency Role Mapping Lines</field>
            <field name="model_id" ref="competency_management.model_competency_role_mapping_line"/>
            <field name="domain_force">[('mapping_id.job_position_id', 'in', user.allowed_role_mapping_job_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_competency_role_mapping_line_officer_all" model="ir.rule">
            <field name="name">Officer All Competency Role Mapping Lines</field>
            <field name="model_id" ref="competency_management.model_competency_role_mapping_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('competency_management.group_competency_officer'))]"/>
        </record>
    </data>
</odoo>
