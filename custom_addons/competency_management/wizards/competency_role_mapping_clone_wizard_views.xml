<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_competency_role_mapping_clone_wizard_form" model="ir.ui.view">
            <field name="name">competency.role.mapping.clone.wizard.form</field>
            <field name="model">competency.role.mapping.clone.wizard</field>
            <field name="arch" type="xml">
                <form string="Clone &amp; Adapt Role Competency Mapping">
                    <sheet>
                        <group>
                            <field name="source_mapping_id"/>
                            <field name="target_version"/>
                            <field name="copy_lines"/>
                        </group>
                        <group string="Select Target Similar Job Positions">
                            <field name="target_job_ids" widget="many2many_tags" placeholder="Select job positions..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_clone_and_adapt" string="Clone &amp; Adapt Mappings" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_competency_role_mapping_clone_wizard" model="ir.actions.act_window">
            <field name="name">Clone &amp; Adapt Role Mapping</field>
            <field name="res_model">competency.role.mapping.clone.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
