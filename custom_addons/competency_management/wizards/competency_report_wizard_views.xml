<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View matching corporate Reference UI for Competency Reports & Analytics -->
        <record id="view_competency_report_wizard_form" model="ir.ui.view">
            <field name="name">competency.report.wizard.form</field>
            <field name="model">competency.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Competency Reports &amp; Analytics (Excel / PDF)">
                    <sheet>
                        <field name="is_dept_readonly" invisible="1"/>
                        <field name="is_ou_readonly" invisible="1"/>
                        <field name="is_emp_readonly" invisible="1"/>
                        <field name="is_status_readonly" invisible="1"/>
                        <field name="competency_domain" invisible="1"/>
                        <field name="operating_unit_domain" invisible="1"/>
                        <field name="employee_domain" invisible="1"/>

                        <div style="background-color: #e0f2fe; color: #0369a1; padding: 14px 18px; border-radius: 6px; margin-bottom: 18px; border: 1px solid #bae6fd;">
                            <div style="font-size: 13px; font-weight: 500;">
                                📊 <strong>Multi-Rater Reporting &amp; Capability Analytics:</strong> Generate high-definition Excel spreadsheets (.xlsx) and printable PDF reports with corporate matrix ratings, variance indices, and capability gap analysis across all organizational units.
                            </div>
                        </div>

                        <group col="2">
                            <group string="Report Configuration">
                                <field name="report_type" widget="radio"/>
                                <field name="export_format" widget="radio"/>
                                <field name="cycle_id" options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <group string="Evaluation &amp; Status Filters">
                                <field name="achievement_status" string="Proficiency Filter" readonly="is_status_readonly"/>
                                <field name="stage_filter" string="Assessment Stage"/>
                                <field name="required_level" string="Required Proficiency Levels"/>
                                <field name="current_level" string="Current Rating Level"/>
                                <field name="pillar" string="Competency Pillars / Categories"/>
                                <field name="competency_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Select Competencies..." domain="competency_domain"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Organizational Filters" name="org_filters">
                                <group>
                                    <field name="department_ids" widget="many2many_tags" options="{'no_create': True}" readonly="is_dept_readonly" placeholder="All Departments"/>
                                    <field name="operating_unit_ids" widget="many2many_tags" options="{'no_create': True}" readonly="is_ou_readonly" placeholder="All Workunits / Branches" domain="operating_unit_domain"/>
                                    <field name="job_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="All Job Roles / Positions"/>
                                    <field name="grade_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="All Job Grades"/>
                                    <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}" readonly="is_emp_readonly" placeholder="All Employees" domain="employee_domain"/>
                                </group>
                            </page>
                        </notebook>

                    </sheet>
                    <footer>
                        <button name="action_generate_report" string="Generate Report" type="object" class="btn-primary" style="background-color: #541718; border-color: #541718; color: #FFFFFF; font-weight: 600; padding: 6px 18px;"/>
                        <button name="action_apply_filter" string="🔍 View Filtered Tree" type="object" class="btn-secondary" style="font-weight: 600;"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Window Action for Report Wizard -->
        <record id="action_competency_report_wizard" model="ir.actions.act_window">
            <field name="name">Competency Reports &amp; Analytics (Excel / PDF)</field>
            <field name="res_model">competency.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Form View for 360 Rater Breakdown Popup Modal -->
        <record id="view_competency_rater_breakdown_wizard_form" model="ir.ui.view">
            <field name="name">competency.rater.breakdown.wizard.form</field>
            <field name="model">competency.rater.breakdown.wizard</field>
            <field name="arch" type="xml">
                <form string="360° Rater Score Breakdown &amp; Audit Trail" create="false" edit="false" delete="false">
                    <sheet>
                        <div class="oe_title" style="margin-bottom: 12px;">
                            <h1 style="color: #541718;"><field name="competency_id" readonly="1"/></h1>
                            <h4><field name="employee_id" readonly="1"/> &amp;mdash; <field name="job_id" readonly="1"/> (<field name="department_id" readonly="1"/>)</h4>
                        </div>

                        <!-- Full Competency Definition Callout Container -->
                        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-left: 4px solid #541718; border-radius: 6px; padding: 12px 16px; margin-bottom: 16px;">
                            <div style="font-size: 11px; font-weight: 700; color: #726732; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">
                                Competency Definition
                            </div>
                            <div style="font-size: 13px; color: #1d2b32; line-height: 1.5;">
                                <field name="competency_definition" readonly="1" nolabel="1"/>
                            </div>
                        </div>

                        <group string="360° Consolidated Averages Summary">
                            <group>
                                <field name="self_rating" readonly="1"/>
                                <field name="peer_avg" readonly="1"/>
                                <field name="subordinate_avg" readonly="1"/>
                            </group>
                            <group>
                                <field name="supervisor_avg" readonly="1"/>
                                <field name="team_avg" readonly="1"/>
                                <field name="weighted_current_level" style="font-weight: bold; color: #541718;" readonly="1"/>
                            </group>
                        </group>

                        <div style="margin-top: 15px; margin-bottom: 10px;">
                            <h3 style="color: #1d2b32; border-bottom: 2px solid #541718; padding-bottom: 4px;">
                                👥 Individual Rater Evaluations &amp; Score Audit List
                            </h3>
                            <p class="text-muted">Exact breakdown of all raters who submitted evaluations for this employee.</p>
                        </div>

                        <field name="rater_line_ids" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="assessor_name" string="Rater Name"/>
                                <field name="rater_type" widget="badge"/>
                                <field name="rating_level_str" string="Assessed Level"/>
                                <field name="assessment_name" string="Assessment Ref"/>
                                <field name="assessment_state" widget="badge" string="Status"/>
                                <field name="comments" string="Remarks / Justification"/>
                            </list>
                        </field>
                    </sheet>
                    <footer>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
