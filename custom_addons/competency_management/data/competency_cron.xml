<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Daily Cron: Pending Assessment Reminders -->
        <record id="cron_pending_assessment_reminders" model="ir.cron">
            <field name="name">Competency Management: Pending Assessment Reminders</field>
            <field name="model_id" ref="model_competency_assessment"/>
            <field name="state">code</field>
            <field name="code">model._cron_pending_assessment_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Daily Cron: Data Quality & Governance Audit (FR-DQ-COM-001..003) -->
        <record id="cron_competency_data_quality_audit" model="ir.cron">
            <field name="name">Competency Management: Data Quality &amp; Governance Audit</field>
            <field name="model_id" ref="model_competency_data_validator"/>
            <field name="state">code</field>
            <field name="code">model._cron_validate_competency_data_quality()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Daily Cron: Take Dashboard Cycle Trend Snapshot (FR-RPT-010) -->
        <record id="cron_take_competency_dashboard_snapshot" model="ir.cron">
            <field name="name">Competency Management: Take Dashboard Cycle Trend Snapshot</field>
            <field name="model_id" ref="model_competency_dashboard_snapshot"/>
            <field name="state">code</field>
            <field name="code">model._cron_take_dashboard_snapshot()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Weekly Cron: Scheduled Report Distribution (FR-RPT-008) -->
        <record id="cron_send_scheduled_competency_reports" model="ir.cron">
            <field name="name">Competency Management: Scheduled Report Distribution</field>
            <field name="model_id" ref="model_competency_dashboard"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_scheduled_competency_reports()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
