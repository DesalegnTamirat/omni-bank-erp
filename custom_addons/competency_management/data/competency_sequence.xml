<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for Competency Assessment -->
        <record id="seq_competency_assessment" model="ir.sequence">
            <field name="name">Competency Assessment Sequence</field>
            <field name="code">competency.assessment</field>
            <field name="prefix">CMP-A/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Competency IDP -->
        <record id="seq_competency_idp" model="ir.sequence">
            <field name="name">Competency IDP Sequence</field>
            <field name="code">competency.idp</field>
            <field name="prefix">IDP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
