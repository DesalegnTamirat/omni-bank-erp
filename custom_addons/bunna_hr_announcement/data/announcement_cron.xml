<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_purge_announcement_visits" model="ir.cron">
            <field name="name">Announcements: delete old visitor records</field>
            <field name="model_id" ref="model_bunna_announcement_view_daily"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_visits()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_purge_announcement_throttle" model="ir.cron">
            <field name="name">Announcements: delete old anti-spam counters</field>
            <field name="model_id" ref="model_bunna_announcement_throttle"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_throttle()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
